+
+bool HaikuSharedMicrophone::addSource(HaikuAudioCaptureSource& source)
+{
+    if (!m_connection) {
+        auto input = haikuMediaInputWithId(B_MEDIA_RAW_AUDIO, m_persistentId);
+        if (!input)
+            return false;
+        media_format format;
+        format.type = B_MEDIA_RAW_AUDIO;
+        format.u.raw_audio = media_raw_audio_format::wildcard;
+        String error;
+        // Destroying the connection waits for its handler, so it never
+        // outlives this object.
+        m_connection = HaikuCaptureConnection::connect(input->node, format, [this](const void* data, size_t bytes, const media_format& format, bigtime_t) {
+            samplesReceived(data, bytes, format);
+        }, error);
+        if (!m_connection) {
+            fprintf(stderr, "Summit: microphone \"%s\": %s\n", m_label.utf8().legacyCStringPointer(), error.utf8().legacyCStringPointer());
+            return false;
+        }
+    }
+    Locker locker { m_lock };
+    m_sources.append({ ThreadSafeWeakPtr { source }, &source });
+    return true;
+}
+
+void HaikuSharedMicrophone::removeSource(HaikuAudioCaptureSource& source)
+{
+    {
+        Locker locker { m_lock };
+        m_sources.removeFirstMatching([&](auto& entry) {
+            return entry.identity == &source;
+        });
+    }
+    if (!hasSources())
+        m_connection = nullptr;
+}
+
+void HaikuSharedMicrophone::samplesReceived(const void* data, size_t bytes, const media_format& format)
+{
+    auto& audio = format.u.raw_audio;
+    unsigned channels = audio.channel_count;
+    double rate = audio.frame_rate;
+    if (!channels || rate <= 0)
+        return;
+
+    size_t sampleSize = audio.format & media_raw_audio_format::B_AUDIO_SIZE_MASK;
+    if (!sampleSize)
+        return;
+    size_t frames = bytes / sampleSize / channels;
+    if (!frames)
+        return;
+    size_t sampleCount = frames * channels;
+    m_samples.resize(sampleCount);
+
+    switch (audio.format) {
+    case media_raw_audio_format::B_AUDIO_FLOAT: {
+        auto* in = static_cast<const float*>(data);
+        for (size_t i = 0; i < sampleCount; ++i)
+            m_samples[i] = in[i];
+        break;
+    }
+    case media_raw_audio_format::B_AUDIO_INT: {
+        auto* in = static_cast<const int32_t*>(data);
+        for (size_t i = 0; i < sampleCount; ++i)
+            m_samples[i] = in[i] / 2147483648.0f;
+        break;
+    }
+    case media_raw_audio_format::B_AUDIO_SHORT: {
+        auto* in = static_cast<const int16_t*>(data);
+        for (size_t i = 0; i < sampleCount; ++i)
+            m_samples[i] = in[i] / 32768.0f;
+        break;
+    }
+    case media_raw_audio_format::B_AUDIO_CHAR: {
+        auto* in = static_cast<const int8_t*>(data);
+        for (size_t i = 0; i < sampleCount; ++i)
+            m_samples[i] = in[i] / 128.0f;
+        break;
+    }
+    case media_raw_audio_format::B_AUDIO_UCHAR: {
+        auto* in = static_cast<const uint8_t*>(data);
+        for (size_t i = 0; i < sampleCount; ++i)
+            m_samples[i] = (int(in[i]) - 128) / 128.0f;
+        break;
+    }
+    default:
+        return;
+    }
+
+    Locker locker { m_lock };
+    Vector<std::pair<RefPtr<HaikuAudioCaptureSource>, bool>, 4> takers;
+    bool anyProcessed = false;
+    bool anyUnprocessed = false;
+    for (auto& entry : m_sources) {
+        RefPtr source = entry.source.get();
+        if (!source || !source->isProducingData())
+            continue;
+        bool processed = source->wantsVoiceProcessing();
+        (processed ? anyProcessed : anyUnprocessed) = true;
+        takers.append({ WTF::move(source), processed });
+    }
+
+    // Voice processing keeps the state of one stream: the samples go through
+    // it once, whatever the number of sources that want it.
+    if (!anyProcessed || rate != std::floor(rate) || std::fmod(rate, 100)) {
+        m_pending.clear();
+        for (auto& [source, processed] : takers)
+            source->samplesReceived(m_samples.span(), channels, rate);
+        return;
+    }
+
+    // Voice processing takes 10 ms at a time.
+    m_pending.append(m_samples.span());
+    size_t chunk = static_cast<size_t>(rate / 100) * channels;
+    size_t offset = 0;
+    while (m_pending.size() - offset >= chunk) {
+        auto samples = m_pending.mutableSpan().subspan(offset, chunk);
+        if (anyUnprocessed) {
+            m_unprocessed.clear();
+            m_unprocessed.append(samples);
+        }
+        HaikuVoiceProcessing::singleton().processCapture(samples, channels, static_cast<unsigned>(rate), true, true, true);
+        for (auto& [source, processed] : takers)
+            source->samplesReceived(processed ? std::span<const float> { samples } : std::span<const float> { m_unprocessed.span() }, channels, rate);
+        offset += chunk;
+    }
+    if (offset)
+        m_pending.removeAt(0, offset);
+}
