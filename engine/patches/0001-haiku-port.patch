+void WebExtensionContext::tabsDetectLanguage(WebPageProxyIdentifier webPageProxyIdentifier, std::optional<WebExtensionTabIdentifier> tabIdentifier, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completionHandler)
+{
+    // The language the page declares: <html lang>, else a Content-Language
+    // <meta>; without either, the one the browser's detector finds reliably
+    // in the page's text, as Chrome does ("und" when it finds none).
+    static constexpr auto apiName = "tabs.detectLanguage()"_s;
+    RefPtr tab = getTab(webPageProxyIdentifier, tabIdentifier, IncludeExtensionViews::Yes);
+    RefPtr page = tab ? tab->nativePage() : nullptr;
+    if (!tab || !page) {
+        completionHandler(toWebExtensionError(apiName, nullString(), "tab not found"_s));
+        return;
+    }
+    if (!tab->extensionHasPermission() && !hasPermission(tab->url(), tab.get())) {
+        completionHandler(toWebExtensionError(apiName, nullString(), "this extension does not have access to this tab"_s));
+        return;
+    }
+    // "L" and the declared language, or "T" and the start of the text.
+    auto source = IPC::TransferString::create(String { "(() => { const lang = document.documentElement && document.documentElement.lang; if (lang) return 'L' + lang; const meta = document.querySelector('meta[http-equiv=\"content-language\" i]'); if (meta && meta.content) return 'L' + meta.content; return 'T' + (document.body ? document.body.innerText : '').slice(0, 20000); })()"_s });
+    if (!source) {
+        completionHandler(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+        return;
+    }
+    RunJavaScriptParameters parameters { WTF::move(*source), JSC::SourceTaintedOrigin::Untainted, URL { },
+        WebCore::RunAsAsyncFunction::No, std::nullopt, WebCore::ForceUserGesture::No, WebCore::RemoveTransientActivation::No };
+    Ref world = API::ContentWorld::createNamelessWorld({ ContentWorldOption::DisableLegacyBuiltinOverrides });
+    page->runJavaScriptInFrameInScriptWorld(WTF::move(parameters), std::nullopt, world, true, [this, protectedThis = Ref { *this }, completionHandler = WTF::move(completionHandler)](auto&& result) mutable {
+        String language;
+        if (result) {
+            auto root = result->map().find(result->root());
+            if (root != result->map().end()) {
+                if (auto* string = std::get_if<String>(&root->value))
+                    language = *string;
+            }
+        }
+        if (language.startsWith('T')) {
+            auto text = language.substring(1);
+            if (text.trim(isASCIIWhitespace<char16_t>).isEmpty()) {
+                completionHandler("und"_s);
+                return;
+            }
+            i18nDetectLanguageHaiku(text, [completionHandler = WTF::move(completionHandler)](std::expected<String, WebExtensionError>&& detected) mutable {
+                String language = "und"_s;
+                RefPtr object = detected ? JSON::Value::parseJSON(*detected) : nullptr;
+                RefPtr answer = object ? object->asObject() : nullptr;
+                RefPtr languages = answer && answer->getBoolean("isReliable"_s).value_or(false) ? answer->getArray("languages"_s) : nullptr;
+                RefPtr first = languages && languages->length() ? languages->get(0)->asObject() : nullptr;
+                if (first && !first->getString("language"_s).isEmpty())
+                    language = first->getString("language"_s);
+                completionHandler(WTF::move(language));
+            });
+            return;
+        }
+        language = language.substring(1);
+        // "en-AU, en" lists more than one: the first is the main language.
+        language = language.left(language.find(',')).trim(isASCIIWhitespace<char16_t>);
+        bool isTag = !language.isEmpty() && language.length() <= 35;
+        for (unsigned i = 0; isTag && i < language.length(); ++i)
+            isTag = isASCIIAlphanumeric(language[i]) || language[i] == '-';
+        if (!isTag)
+            language = "und"_s;
+        completionHandler(WTF::move(language));
+    });
+}
