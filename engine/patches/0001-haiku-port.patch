+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "JSWebExtensionAPIUserScripts.h"
+#include "WebExtensionAPIObject.h"
+#include <wtf/JSONValues.h>
+
+namespace WebKit {
+
+// chrome.userScripts. User scripts are registered scripts whose identifiers
+// carry webExtensionUserScriptPrefix, so they share the scripting messages,
+// the store and the injection of scripting.registerContentScripts().
+class WebExtensionAPIUserScripts : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPIUserScripts, userScripts, userScripts);
+
+public:
+    void registerScripts(RefPtr<JSON::Value> scripts, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void updateScripts(RefPtr<JSON::Value> scripts, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void unregisterScripts(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getScripts(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+
+    void configureWorld(RefPtr<JSON::Value> properties, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void resetWorldConfiguration(const String& worldId, Ref<WebExtensionCallbackHandler>&&);
+    void getWorldConfigurations(Ref<WebExtensionCallbackHandler>&&);
+
+private:
+    // World configurations (csp, messaging) are kept for getWorldConfigurations();
+    // user scripts run in the content script world, which already has messaging.
+    HashMap<String, Ref<JSON::Object>> m_worldConfigurations;
+};
+
+} // namespace WebKit
+
+SPECIALIZE_TYPE_TRAITS_WEB_EXTENSION(WebExtensionAPIUserScripts, userScripts);
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
