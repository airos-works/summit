+    // without any is 260 KB to look through.
+    size_t size = bytes.size();
+    const unsigned char* data = bytes.data();
+    size_t index = 0;
+    for (; index + sizeof(uint64_t) <= size; index += sizeof(uint64_t)) {
+        uint64_t word;
+        memcpy(&word, data + index, sizeof(word));
+        if (word)
