+std::optional<size_t> InlineContent::textBoxIndexForOffset(const Layout::Box& layoutBox, unsigned offset) const
+{
+    auto first = firstBoxIndexForLayoutBox(layoutBox);
+    if (!first || !offset)
+        return first;
+
+    auto& boxes = m_displayContent.boxes;
+    constexpr size_t indexStride = 64;
+    if (boxes.size() < 2 * indexStride || boxes[*first].isLastForLayoutBox()
+        || offset <= boxes[*first].text().end())
+        return first;
+
+    // This index is only used for text whose visual and logical orders agree.
+    // Keep one entry per 64 boxes, and share the layout cache's invalidation
+    // lifetime. Long text fields otherwise scan all preceding lines many times
+    // for every key press, even when layout itself is incremental.
+    if (!m_textOffsetIndexCache)
+        m_textOffsetIndexCache = makeUnique<TextOffsetIndexCache>();
+    auto& indexes = m_textOffsetIndexCache->ensure(layoutBox, [&] {
+        Vector<size_t> indexes;
+        size_t count = 0;
+        for (size_t i = *first; i < boxes.size(); ++i) {
+            auto& box = boxes[i];
+            if (&box.layoutBox() != &layoutBox)
+                continue;
+            ASSERT(box.isTextOrSoftLineBreak());
+            if (!(count++ % indexStride))
+                indexes.append(i);
+            if (box.isLastForLayoutBox())
