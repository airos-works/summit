+status_t BWebKitView::LoadForm(const char* url, const char* formData)
+{
+    if (m_status != B_OK)
+        return m_status;
+    if (!url || !formData || strlen(url) > 65536 || strlen(formData) > 1024 * 1024
+        || (strncasecmp(url, "https://", 8) && strncasecmp(url, "http://", 7)))
+        return B_BAD_VALUE;
+    BMessage message(viewLoadHaiku);
+    if (message.AddString("url", url) != B_OK || message.AddString("formData", formData) != B_OK)
+        return B_NO_MEMORY;
+    ++m_state->findRequestIdentifier;
+    ++m_state->nativeDropRequest;
+    dispatchViewMessageHaiku(m_state, std::move(message));
+    return B_OK;
