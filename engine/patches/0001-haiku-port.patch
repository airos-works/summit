+#include "config.h"
+#include "WebExtensionMenuItem.h"
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+#include "WebExtensionContext.h"
+#include "WebExtensionMenuItemParameters.h"
