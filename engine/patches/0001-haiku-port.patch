+
+    std::optional<WebExtensionTabIdentifier> tab;
+    if (!parseOptionalTabIdentifier(tabID, tab, exception))
+        return;
+    RefPtr object = zoomSettings ? zoomSettings->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), "zoomSettings"_s, "an object is expected"_s);
+        return;
+    }
+    auto mode = object->getString("mode"_s);
+    auto scope = object->getString("scope"_s);
+    if ((!mode.isNull() && mode != "automatic"_s) || (!scope.isNull() && scope != "per-origin"_s)) {
+        callback->reportError("tabs.setZoomSettings(): Summit's zoom is always 'automatic' and 'per-origin'."_s);
+        return;
+    }
+    callback->call();
+}
