+// Call on the BApplication thread before creating any modern web views.
+WK_EXPORT status_t BWebKitInitialize();
+// Query on the application thread while draining close operations. Keep the
+// application loop alive until native windows and popup workers finish. After
+// observing false, queue one final application turn to drain completions that
+// native UI has already submitted.
+WK_EXPORT bool BWebKitHasPendingNativeUI();
+// After releasing the last context, keep the application loop running while
+// helper launches finish. Exiting during load_image() strands suspended teams.
+// Query on the application thread, alongside BWebKitHasPendingNativeUI().
+WK_EXPORT bool BWebKitHasPendingProcessLaunches();
+// Frame buffer pixels per logical pixel of the screen (2 on 4K monitors at
+// 200%). Bitmaps this many times their logical size, drawn into a logical
+// rectangle, reach the screen pixel for pixel. Any thread; cached for a second.
+WK_EXPORT float BWebKitDisplayScale();
+// Spell checking of editable text in every page, with Hunspell
+// (libhunspell-1.7.so.0, loaded when needed). languages: dictionary names in
+// order of preference, separated by commas ("en_US,de_DE"); the first one
+// found is used, then any en_US. Dictionaries (NAME.aff and NAME.dic) come
+// from dictionaryDirectory, then the user's and the system's data/hunspell
+// directories. wordListPath: a UTF-8 file, one word a line, that learned
+// words are added to (may be null). Callable from any thread; pages already
+// shown are checked again.
+WK_EXPORT void BWebKitSetSpellChecking(bool enabled, const char* languages, const char* dictionaryDirectory, const char* wordListPath);
+// Page/field language selects an installed dictionary by default; pass false
+// to keep an explicit user choice. The configured list remains the fallback.
+WK_EXPORT void BWebKitSetSpellChecking(bool enabled, const char* languages, const char* dictionaryDirectory, const char* wordListPath, bool usePageLanguage);
+// The fallback dictionary ("" when none was found or checking is off).
+WK_EXPORT const char* BWebKitSpellCheckingLanguage();
+
+enum : uint32 {
+    B_WEBKIT_SPELLING_REPLACE = 0,
+    B_WEBKIT_SPELLING_IGNORE = 1,
+    B_WEBKIT_SPELLING_LEARN = 2
+};
+
+// How long BWebKitView::AnswerAuthentication's name and password are kept:
+// for the request that asked only, or for the rest of the session (the
+// context's website data), when the engine also sends them unasked to the
+// same server and realm.
+enum : uint32 {
+    B_WEBKIT_CREDENTIAL_FOR_REQUEST = 0,
+    B_WEBKIT_CREDENTIAL_FOR_SESSION = 1
+};
+
+enum : uint32 {
+    // A server (or the proxy) asks for a name and password: HTTP Basic,
+    // Digest or NTLM authentication (401 or 407), sent only to views that
+    // asked for it (SetAuthenticationRequests). Fields: "view",
+    // "identifier" (uint64), "url" (the request's, without credentials),
+    // "host", "port" (int32), "realm" (the server's own text, may be empty),
+    // "scheme" ("basic", "digest" or "ntlm"), "secure" (bool: the name and
+    // password travel over https), "proxy" (bool), "previous_failures"
+    // (int32: names and passwords this request had refused) and "user" (the
+    // name last tried, when known). The request waits until
+    // AnswerAuthentication or CancelAuthentication. When it no longer waits
+    // (the page started another navigation, closed or crashed), a notice
+    // with "identifier" and "withdrawn" (true) follows.
+    B_WEBKIT_AUTHENTICATION_REQUESTED = 'waut',
+    // The page requests a native fullscreen transition. Fields: "view",
+    // "fullscreen" (bool), "request" (uint64). Change the window on its looper,
+    // then call CompleteFullScreenRequest. A zero request only restores the
+    // window (page closed, crashed or a host failed to answer). Unanswered
+    // requests fail after five seconds. Only the active view should be accepted.
+    B_WEBKIT_FULLSCREEN_REQUESTED = 'wful',
+    // A page's passkey request (navigator.credentials.get or create) reached
+    // the browser's own WebAuthn coordinator, which has no authenticator and
+    // answered NotAllowedError: no extension (1Password...) took it. Not sent
+    // for conditional-mediation requests, which pages make at load.
+    // "view", "create" (bool).
+    B_WEBKIT_WEBAUTHN_UNHANDLED = 'wwau',
+    // A page navigated to a scheme no page can show: "view", "url",
+    // "source_url" (the page's address), "committed_url", and bools
+    // "user_gesture", "main_frame", "redirect" and "trusted". The load was
+    // ignored; the browser can offer an approved web or native handler.
+    // Trusted: a click asked for it, or a main-frame load the host started
+    // (LoadURL) and its redirects ended there (an OAuth callback). Others
+    // are main-frame navigations a script made by itself (ask every time)
+    // or frames without a gesture (refused: say so at most).
+    B_WEBKIT_SCHEME_OPEN_REQUESTED = 'wsch',
+    // registerProtocolHandler / unregisterProtocolHandler: "view", "scheme",
+    // "url" (validated same-origin HTTP(S) template), "source_url", "remove".
+    B_WEBKIT_SCHEME_REGISTRATION = 'wsrg',
+    // State snapshots may include connectionCertificate (BMessage) for the
+    // committed HTTPS main resource: url, host, subject, issuer, names and
+    // sha256 (strings), validFrom/validUntil (epoch seconds, doubles), verified,
+    // exception and mixedContent (bools), and problem (string).
+    // They also say whether the page plays sound: "playingAudio" and
+    // "audioMuted" (bools, SetAudioMuted), and "keepScreenAwake" (bool):
+    // the page asks for the screen to stay on (a video with sound playing
+    // where it can be seen, or a screen wake lock). While a page the user
+    // can see asks, keep the screen blanker away, for example by putting
+    // the pointer where it already is every 20 s (set_mouse_position).
+    B_WEBKIT_STATE_CHANGED = 'wsta',
+    // State snapshots include "softwareRendering" (bool): the web process
+    // selected CPU rendering because graphics acceleration is unavailable.
+    // The page's web process is gone. A second notice follows with "reason":
+    // "crash", "memory" (over its memory limit), "cpu", "stopped"
+    // (TerminateWebProcess), "unresponsive", or "exited". The view keeps the
+    // last picture until the host shows something else or reloads.
+    B_WEBKIT_PROCESS_EXITED = 'wpex',
+    // The page's web process stopped answering input ("responsive" false)
+    // or answers again (true). Field "view".
+    B_WEBKIT_RESPONSIVENESS_CHANGED = 'wrsp',
+    B_WEBKIT_FIND_RESULT = 'wfin',
+    B_WEBKIT_CLOSE_REQUESTED = 'wclr',
+    B_WEBKIT_CLOSE_CANCELLED = 'wclc',
+    B_WEBKIT_CLOSE_PROMPT = 'wclp',
+    B_WEBKIT_CLOSE_COMMITTED = 'wclb',
+    // An extension page navigated its view to a web page, which only an ordinary
+    // view can display. Fields: "view" (messenger), "url" (string). The navigation
+    // was not started; the host is expected to show the URL in a web view instead.
+    B_WEBKIT_EXTERNAL_NAVIGATION_REQUESTED = 'wexn',
+    // The main frame's favicon was loaded. Fields: "view" (messenger), "url"
+    // (the page the icon belongs to), "iconURL", "mimeType" (may be empty) and
+    // "data" (B_RAW_TYPE, the undecoded icon file, at most 1 MiB).
+    B_WEBKIT_ICON_LOADED = 'wico',
+    // The user asked for a context menu on the page (secondary button) and the
+    // page did not cancel it. The host shows its own menu. Fields: "view",
+    // "where" (BPoint, view coordinates), "main_frame" (bool), and when present
+    // "frame_url", "selected_text", "link_url", "link_label", "link_title",
+    // "link_filename", "image_url", "image_filename", "media_url" (strings),
+    // "editable", "selected", "downloadable_media" (bool). On a misspelt
+    // word in editable text: "misspelled" (bool) and repeated
+    // "spelling_guess" strings (PerformSpellingCommand). Extensions' own
+    // items (menus API) that apply come as repeated "extension" messages:
+    // "name" and repeated "item" messages with "title", "enabled",
+    // "checkable", "checked", and either "token" (uint64, for
+    // PerformContextMenuExtensionItem), nested "item"s (a submenu) or
+    // "separator".
+    B_WEBKIT_CONTEXT_MENU = 'wctx',
+    // While that menu is open, an extension rebuilt its items (menus.refresh):
+    // fields "view" and the "extension" messages, as for B_WEBKIT_CONTEXT_MENU;
+    // the host replaces the menu's extension items with them. Call
+    // ContextMenuClosed() when the menu closes (menus.onHidden).
+    B_WEBKIT_CONTEXT_MENU_EXTENSIONS = 'wcme',
+    // A page asked for a new page: window.open(), or a link or form with a
+    // target. Fields: "view" (the opener), "identifier" (uint64), "url" (may be
+    // about:blank), "popup" (bool: the page asked for a sized pop-up window),
+    // "user_gesture" (bool), "modifiers" and "button" (native bits of the click,
+    // if any), optional "width"/"height" and "x"/"y" (floats, screen units).
+    // Answer exactly once: create a view with the identifier (the engine then
+    // loads the page itself; do not call LoadURL) or call DeclineNewPage().
+    // The opener's script waits until then.
+    B_WEBKIT_NEW_PAGE_REQUESTED = 'wnpg',
+    // A middle click or Command-click on a link. The page did not navigate.
+    // Fields: "view", "url", "modifiers", "button" (native bits).
+    B_WEBKIT_LINK_OPEN_REQUESTED = 'wlop',
+    // The pointer moved on to or off a link. Fields: "view", "url" (empty when
+    // it left the link), optional "title".
+    B_WEBKIT_LINK_HOVERED = 'wlhv',
+    // The page called window.print(). Fields: "view", "main_frame" (bool),
+    // "frame_identifier", "generation" (uint64, requesting frame/load).
+    B_WEBKIT_PRINT_REQUESTED = 'wprq',
+    // The answer to DrawPagesForPrinting: "identifier" (uint64), "pageCount"
+    // (int32, every page of the layout), "first" (int32), and either "pdf"
+    // (B_RAW_TYPE, a PDF document of the pages asked for) or repeated "page"
+    // (B_RAW_TYPE, 32-bit B_RGB32 rows of "width" x "height" pixels, int32).
+    // "error" (string) when nothing could be drawn.
+    B_WEBKIT_PRINT_PAGES = 'wprp',
+    // Picture in Picture (EnterPictureInPicture), sent to its target: a
+    // frame of the video, "page" (uint64), "width", "height" (int32),
+    // "pixels" (B_RAW_TYPE, B_RGB32 rows), "paused" (bool), "time" and
+    // "duration" (double, seconds; duration NaN before the video's metadata,
+    // infinite for a live stream), "volume" (double, 0-1) and "muted"
+    // (bool). Frames come at most 30 a second, when the picture, time,
+    // paused, volume or muted changed (and for half a second after a seek).
+    // When the video went away (removed, or the page closed or navigated)
+    // or was not found, "page" only.
+    B_WEBKIT_PICTURE_IN_PICTURE_FRAME = 'wpif',
+    B_WEBKIT_PICTURE_IN_PICTURE_ENDED = 'wpie'
+};
+
+// Navigation and input are queued to the application thread. Notifications are
+// sent to the supplied messenger with a "view" messenger and page state fields.
+class WK_EXPORT BWebKitView : public BView {
+public:
+    BWebKitView(BRect, const char* name, BMessenger notificationTarget,
+        uint32 resizingMode = B_FOLLOW_ALL, std::shared_ptr<BWebKitContext> = nullptr);
+    // Shows the page of a B_WEBKIT_NEW_PAGE_REQUESTED notification. If the
+    // request is no longer pending, the view starts empty.
+    BWebKitView(BRect, const char* name, BMessenger notificationTarget, uint64 newPageRequest,
+        uint32 resizingMode = B_FOLLOW_ALL, std::shared_ptr<BWebKitContext> = nullptr);
+    // Initial settings use SetPageSettings' fields and validation, applied
+    // before the web process is initialized or an opened page is accepted.
+    // Invalid settings make InitCheck fail and decline an opened-page request.
+    BWebKitView(BRect, const char* name, BMessenger notificationTarget, const BMessage& initialSettings,
+        uint32 resizingMode = B_FOLLOW_ALL, std::shared_ptr<BWebKitContext> = nullptr);
+    BWebKitView(BRect, const char* name, BMessenger notificationTarget, uint64 newPageRequest,
+        const BMessage& initialSettings, uint32 resizingMode = B_FOLLOW_ALL, std::shared_ptr<BWebKitContext> = nullptr);
+    // Refuses a B_WEBKIT_NEW_PAGE_REQUESTED notification; window.open() then
+    // returns null. Callable from any thread.
+    static void DeclineNewPage(uint64 newPageRequest);
+    // Runs an extension item chosen from the last B_WEBKIT_CONTEXT_MENU, as
+    // a user action. Tokens of older menus are ignored. Any thread.
+    static void PerformContextMenuExtensionItem(uint64 token);
+    // The host closed the menu of the last B_WEBKIT_CONTEXT_MENU, chosen or not.
+    void ContextMenuClosed();
+    ~BWebKitView() override;
+    status_t InitCheck() const;
+    void LoadURL(const char*);
+    // Navigate with application/x-www-form-urlencoded POST data, for a saved
+    // search shortcut. HTTP(S) only, at most 1 MiB of UTF-8/escaped form data.
+    // An empty body is still a POST. Callable from any thread.
+    status_t LoadForm(const char* url, const char* formData);
+    // Explicit user activation of a saved javascript: bookmark on the current
+    // HTTP(S) or file document. The host must exclude its privileged pages.
+    // Both processes reject a changed document; this never starts a load for
+    // a script with no string completion. Replies use B_WEBKIT_JAVASCRIPT_RESULT.
+    void RunBookmarklet(const char* url, BMessenger reply, uint64 identifier, uint64 expectedGeneration);
+    // After explicit user approval of a certificate failure reported in
+    // B_WEBKIT_STATE_CHANGED, trust that exact host/leaf certificate for this
+    // view's context session and retry its failed URL. expectedGeneration is
+    // the notification's loadGeneration. The engine checks it when applying
+    // the decision: navigation, Stop(), closure or an already handled failure
+    // makes an old approval ineffective. No caller-supplied host or certificate
+    // is trusted. Callable from any thread.
+    void ContinueAfterCertificateError(uint64 expectedGeneration);
+    // Queue an explicit download of a valid URL without changing this page.
+    // Uses this view's context, configured download directory and listener.
+    void DownloadURL(const char*);
+    // Opens a connection to the server of an https URL the user is likely to
+    // load soon (DNS, TCP and TLS), so that load's first request goes out at
+    // once. Nothing is sent to the server. Any thread.
+    void Preconnect(const char*);
+    // A navigation to a new site is likely soon (the user is typing an
+    // address): makes sure a spare web process is ready for it, since a site
+    // gets a process of its own and starting one takes a moment. Nothing
+    // when one is ready. Any thread.
+    void PrewarmProcess();
+    void GoBack();
+    void GoForward();
+    void Reload();
+    // Reloads without the cache (Shift-reload; tabs.reload({bypassCache})).
+    void ReloadFromOrigin();
+    void Stop();
+    void CompleteFullScreenRequest(uint64 request, bool accepted);
+    // The host's Escape key or tab switch: ask the DOM fullscreen manager to exit.
+    void ExitFullScreen();
+    // Asks beforeunload handlers before notifying CLOSE_REQUESTED or
+    // CLOSE_CANCELLED. Keep the view alive until the resulting notification.
+    // Repeated requests while waiting for a decision are ignored.
+    void RequestClose();
+    // Withdraw a completed provisional approval when a window quit is cancelled.
+    // Does not reset a close decision that is still pending in the WebProcess.
+    void ResetCloseRequest();
+    // Retain all native views until CLOSE_COMMITTED returns identifier and
+    // closed. On main, validate all approvals against observed navigation and
+    // close every engine page together; a failed validation closes none.
+    static void CommitClose(const std::vector<BWebKitView*>&, BMessenger target, uint64 identifier);
+    // The result contains view, query, identifier, error, and found on success.
+    // A newer request, explicit navigation or HideFindUI cancels older replies.
+    void FindString(const char*, bool forward = true, bool caseSensitive = false, bool wrapSelection = true);
+    void HideFindUI();
+    void IncreaseZoomFactor(bool textOnly = false);
+    void DecreaseZoomFactor(bool textOnly = false);
+    void ResetZoomFactor();
+    // Accepts B_CUT, B_COPY, B_PASTE, B_SELECT_ALL, B_UNDO and B_REDO.
+    void ExecuteEditCommand(uint32);
+    // For the word of the last context menu that reported "misspelled":
+    // replace it with word (B_WEBKIT_SPELLING_REPLACE), accept it in every
+    // page until the browser quits (IGNORE), or add it to the word list
+    // (LEARN, see BWebKitSetSpellChecking).
+    void PerformSpellingCommand(uint32 command, const char* word = nullptr);
+    // Silences every sound of the page (its media keep playing).
+    void SetAudioMuted(bool);
+    // Sends the view's notifications to target from now on: the view was
+    // moved to another window (RemoveSelf, then AddChild there). A state
+    // notification follows.
+    void SetNotificationTarget(BMessenger target);
+    // Lays the main frame out for paper of paperWidth x paperHeight points
+    // with margins (left, top, right and bottom of the rectangle, points) at
+    // scale (1 = as other browsers print), and draws pages [first, first +
+    // count): as a PDF when rasterScale is 0, else as pictures of rasterScale
+    // pixels a point, with or without backgrounds. Answers
+    // B_WEBKIT_PRINT_PAGES to reply. Any thread.
+    void DrawPagesForPrinting(BMessenger reply, uint64 identifier, float paperWidth, float paperHeight,
+        BRect margins, float scale, uint32 first, uint32 count, float rasterScale, bool backgrounds);
+    // As above, for the frame from B_WEBKIT_PRINT_REQUESTED (0 = main frame).
+    // Reject a changed load generation (0 = current generation).
+    void DrawFramePagesForPrinting(BMessenger reply, uint64 identifier, uint64 frameIdentifier, uint64 expectedGeneration,
+        float paperWidth, float paperHeight, BRect margins, float scale, uint32 first, uint32 count, float rasterScale, bool backgrounds);
+    // Picture in Picture: the page's <video data-summit-pip="token"> (a
+    // number; in any frame) sends its pictures, fitted into size, to target.
+    // The video gets enterpictureinpicture and, when it ends,
+    // leavepictureinpicture events. Commands, as the user's own action:
+    // "play", "pause", "toggle"; "seek:<seconds>" (to that time) and
+    // "skip:<seconds>" (forward, or back when negative), both kept within the
+    // video's seekable range; "volume:<0-1>"; "mute" and "unmute". Anything
+    // else, or a number that does not parse or is not finite, is ignored.
+    void EnterPictureInPicture(const char* token, BMessenger target, BSize size);
+    void SetPictureInPictureSize(BSize size);
+    void PictureInPictureCommand(const char* command);
+    void ExitPictureInPicture();
+    // Ends the page's web process, for a page that stopped responding. The
+    // view then gets B_WEBKIT_PROCESS_EXITED with reason "stopped"; Reload
+    // starts a new process.
+    void TerminateWebProcess();
+
+    // Embedding: see WebKitEmbedding.h. Scripts run in the pages' own world.
+    void AddUserScript(const char* source, bool atDocumentStart = true, bool allFrames = true);
+    void RemoveAllUserScripts();
+    // A style sheet applied, as the user's, to every page of the views that
+    // share this view's configuration (Summit's windows do): a user
+    // preference such as overriding the pages' colours. It replaces the one
+    // set before; null or empty removes it. Any thread.
+    void SetUserStyleSheet(const char* source);
+    // Offers window.webkit.messageHandlers.<name> to the view's pages; their
+    // messages reach target as B_WEBKIT_SCRIPT_MESSAGE.
+    void AddScriptMessageHandler(const char* name, BMessenger target);
+    void RemoveScriptMessageHandler(const char* name);
+    // Resolves the page's postMessage() promise with reply, a string the page
+    // receives unchanged, or rejects it with error when that is not null.
+    // Any thread; unknown and answered tokens are ignored.
+    static void ReplyToScriptMessage(uint64 replyToken, const char* reply, const char* error = nullptr);
+    // Runs source in the main frame and sends B_WEBKIT_JAVASCRIPT_RESULT to
+    // reply. As an async function, source is a function body whose returned
+    // promise is awaited.
+    void EvaluateJavaScript(const char* source, BMessenger reply, uint64 identifier, bool asAsyncFunction = false);
+    // Browser-owned document inspection, in a fresh isolated world. Does not
+    // grant or consume user activation. Fails if expectedGeneration is stale;
+    // replies also include "generation". Website globals/prototype overrides
+    // are not visible. Source is a synchronous script returning a value.
+    void EvaluateJavaScriptIsolated(const char* source, BMessenger reply, uint64 identifier, uint64 expectedGeneration);
+    // keepWorld retains one private content world for this view. Repeated
+    // calls in the same document can retain DOM references (for example to
+    // restore translated text). A new document has new globals. The world
+    // is never shared with another view or the website, and closes with the
+    // view. Generation and user-activation rules are the same as above.
+    void EvaluateJavaScriptIsolated(const char* source, BMessenger reply, uint64 identifier, uint64 expectedGeneration, bool keepWorld);
+    // An empty string restores the engine's own user agent.
+    void SetCustomUserAgent(const char*);
+    // Apply only the supplied settings to this view, preserving other pages'
+    // preferences, including an opener's. Fields (one value each):
+    // standardFont, serifFont, sansSerifFont, fixedFont (nonempty UTF-8 strings),
+    // standardFontSize, fixedFontSize (int32 CSS pixels, 1..512),
+    // javascriptEnabled (bool), userAgent (UTF-8 string; empty restores the
+    // engine default), minimumFontSize (int32 CSS pixels, 0..72; 0 is none),
+    // caretBrowsing (bool: a movable caret in page text), reducedMotion and
+    // increasedContrast (bool: pages match prefers-reduced-motion: reduce and
+    // prefers-contrast: more; false leaves the system's answer, none on
+    // Haiku). Unknown fields, wrong types and invalid values reject
+    // the whole update. B_OK means queued; a closed view ignores it. Any thread.
+    // Disabling JavaScript affects page scripts; host inspection remains available.
+    status_t SetPageSettings(const BMessage&);
+    // The view's pages load URLs of scheme through target, once per scheme and
+    // view, and never for schemes the engine loads itself (http, file...).
+    void SetURLSchemeHandler(const char* scheme, BMessenger target, uint32 flags = 0);
+    // Answers a B_WEBKIT_URL_SCHEME_REQUEST whole. headers holds repeated
+    // "name"/"value" strings; a null mimeType is guessed from the URL.
+    // Any thread; stale identifiers are ignored.
+    static void RespondToURLSchemeRequest(uint64 identifier, int32 status, const char* mimeType,
+        const BMessage* headers, const void* data, size_t size);
+    static void FailURLSchemeRequest(uint64 identifier, const char* description = nullptr);
+    // Sends B_WEBKIT_AUTHENTICATION_REQUESTED for the view's HTTP
+    // authentication challenges. Off by default: the page then gets the
+    // server's own 401 or 407 response, as without a name and password.
+    void SetAuthenticationRequests(bool enabled);
+    // Answers B_WEBKIT_AUTHENTICATION_REQUESTED with a name and password
+    // (persistence: B_WEBKIT_CREDENTIAL_*). A null name continues without
+    // signing in: the page gets the server's own response. Any thread;
+    // unknown, withdrawn and answered identifiers are ignored.
+    static void AnswerAuthentication(uint64 identifier, const char* name, const char* password,
+        uint32 persistence = B_WEBKIT_CREDENTIAL_FOR_SESSION);
+    // Stops the request that asked: its load fails as cancelled.
+    static void CancelAuthentication(uint64 identifier);
+    // How a beforeunload handler that asks to stay is answered; notifications
+    // (B_WEBKIT_BEFORE_UNLOAD_PREVENTED) go to target.
+    void SetBeforeUnloadBehavior(uint32 behavior, BMessenger target = BMessenger());
+    // Page zoom as a factor (1 is 100%), as Electron's setZoomFactor.
+    void SetZoomFactor(double factor);
+    // The cookies of this view's website data (its BWebKitContext), including
+    // HttpOnly ones: for the URL, or all when url is null or empty. Answered
+    // with B_WEBKIT_COOKIES to reply.
+    void GetCookies(const char* url, BMessenger reply, uint64 identifier);
+    // A cookie as the fields of B_WEBKIT_COOKIES; B_WEBKIT_COOKIES_CHANGED.
+    void SetCookie(const BMessage& cookie, BMessenger reply, uint64 identifier);
+    // Cookies of the URL (every cookie when url is empty), only those named
+    // name when it is not empty; B_WEBKIT_COOKIES_CHANGED.
+    void DeleteCookies(const char* url, const char* name, BMessenger reply, uint64 identifier);
+    // B_WEBKIT_DATA_* of the view's website data, of all time;
+    // B_WEBKIT_WEBSITE_DATA_REMOVED.
+    void RemoveWebsiteData(uint32 types, BMessenger reply, uint64 identifier);
+    // Call from BDirectWindow::DirectConnected() of a window made with
+    // B_DIRECT_DEVICE_PIXELS. Its web views then have their pages copied
+    // straight into the screen by the GPU wherever they are visible, instead
+    // of read back from the GPU and drawn by app_server. Any thread; returns
+    // once nothing more lands where the window no longer is. A null info, or
+    // a window that is not told the screen's density, presents as before.
+    static void WindowDirectConnected(BWindow* window, const direct_buffer_info* info);
+
+    // For a host's debugging tools (WebKitDiagnostics.h): how the view
+    // presents its page, as JSON: size, screen origin and scale, visibility,
+    // whether frames go straight into the screen, the last frame (identifier,
+    // size in device pixels), the page's web process, identifiers, address
+    // and load state. Any thread; WebKit's main thread is given at most
+    // timeout for its part, and the report says when it did not answer.
+    std::string Diagnostics(bigtime_t timeout = 2000000) const;
+    // A copy of the last frame presented to the view (what Draw() shows, in
+    // device pixels), or null. Frames put straight into the screen are not
+    // kept. The caller owns the bitmap. Any thread.
+    BBitmap* CopyPresentedFrame() const;
+
+    void AttachedToWindow() override;
+    void DetachedFromWindow() override;
+    void FrameResized(float, float) override;
+    void FrameMoved(BPoint) override;
+    void WindowActivated(bool) override;
+    void MakeFocus(bool = true) override;
+    void Show() override;
+    void Hide() override;
+    void Draw(BRect) override;
+    void KeyDown(const char*, int32) override;
+    void KeyUp(const char*, int32) override;
+    void MouseDown(BPoint) override;
+    void MouseUp(BPoint) override;
+    void MouseMoved(BPoint, uint32, const BMessage*) override;
+    void MessageReceived(BMessage*) override;
+
+private:
+    friend class BWebKitContext;
+    friend class BWebKitInspectorSession;
+    friend class WebKit::ExtensionActionPopupHaiku;
+    BWebKitView(BRect, const char*, std::shared_ptr<WebKit::WebViewStateHaiku>);
+    void UpdateGeometry();
+    void SendInput(const BMessage&, BPoint = BPoint());
+    void StartDrag(const BMessage&);
+    void FinishDrag(uint32 operation, BPoint screenPoint);
+    // Offers native text, images, URLs and files to the page.
+    void SendDrag(const BMessage& drag, BPoint, const char* phase);
+    void SendCommand(uint32, const char* = nullptr);
+    void ChangeZoomFactor(int32 direction, bool textOnly);
+    std::shared_ptr<WebKit::WebViewStateHaiku> m_state;
+    std::unique_ptr<BCursor> m_cursor;
+    std::unique_ptr<WebKit::JavaScriptDialogHostHaiku> m_dialogHost;
+    status_t m_status { B_NO_INIT };
+    bool m_failedViewCloseNotified { false };
+};
