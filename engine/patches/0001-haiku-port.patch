+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include "HIDReportDescriptorHaiku.h"
+#include <OS.h>
+#include <atomic>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace WebKit::HIDHaiku {
+
+// One HID interface of a USB device: what WebHID calls a device.
+struct Interface {
+    // These two fields never cross the renderer IPC boundary.
+    std::string path;
+    std::string identity;
+    uint8_t number { 0 };
+    uint16_t vendorId { 0 };
+    uint16_t productId { 0 };
+    std::string product;
+    Descriptor descriptor;
+};
+
+// Lists the HID interfaces a web page may be offered (see eligible()). The
+// report descriptors of devices already seen are cached. Call on a worker.
+std::vector<Interface> enumerateInterfaces();
+
+enum class Error { None, NotFound, Security, InvalidState, Network, NotSupported, Abort };
+
+// An open HID interface. A device thread owns the raw USB handle. It keeps an
+// interrupt transfer pending for input reports and interrupts it to send
+// output and feature reports: Haiku's raw USB driver holds the device for the
+// whole of a transfer, so they could not otherwise be sent while waiting.
+class Connection final {
+public:
+    using Completion = std::function<void(Error, std::vector<uint8_t>&&)>;
+    // Called on the device thread. An empty report with gone=true means the
+    // device has gone away and nothing more will be read.
+    using InputHandler = std::function<void(uint8_t reportId, std::vector<uint8_t>&&, bool gone)>;
+
+    // Blocking: call on a worker. Verifies that the interface is still the one
+    // approved.
+    static std::shared_ptr<Connection> open(const Interface& approved, InputHandler&&, Error&);
+    ~Connection();
+
+    // Completions are called on the device thread, in order, each exactly once.
+    void sendReport(uint8_t reportId, std::vector<uint8_t>&&, Completion&&);
+    void sendFeatureReport(uint8_t reportId, std::vector<uint8_t>&&, Completion&&);
+    void receiveFeatureReport(uint8_t reportId, Completion&&);
+    // Safe from any thread except the device thread. Returns at once: pending
+    // operations complete with Error::Abort and the device thread exits.
+    void close();
+
+    struct State;
+
+private:
+    explicit Connection(std::shared_ptr<State>);
+    void enqueue(int kind, uint8_t reportId, std::vector<uint8_t>&&, Completion&&);
+    std::shared_ptr<State> m_state;
+};
+
+} // namespace WebKit::HIDHaiku
diff --git a/Source/WebKit/UIProcess/haiku/usb/HIDReportDescriptorHaiku.h b/Source/WebKit/UIProcess/haiku/usb/HIDReportDescriptorHaiku.h
