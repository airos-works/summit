+    {
+        std::lock_guard guard(m_state->mutex);
+        return m_state->view;
+    }
+#if ENABLE(CUSTOM_PROTOCOL_HANDLERS)
+    void protocolHandlerRequested(const String&, const URL&, bool) override;
+#endif
