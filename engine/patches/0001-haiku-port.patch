diff --git a/Source/WebCore/platform/image-decoders/jpegxr/JPEGXRCodec.cpp b/Source/WebCore/platform/image-decoders/jpegxr/JPEGXRCodec.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cafe20c89ef6b39e706c4ea72a6aeef61c9e53a2
--- /dev/null
+++ b/Source/WebCore/platform/image-decoders/jpegxr/JPEGXRCodec.cpp
@@ -0,0 +1,223 @@
+// Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause
+#ifndef SUMMIT_CODEC_STANDALONE
+#include "config.h"
+#endif
+#include "JPEGXRCodec.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <new>
+#ifndef __ANSI__
+#define __ANSI__
+#endif
+#ifndef DISABLE_PERF_MEASUREMENT
+#define DISABLE_PERF_MEASUREMENT
+#endif
+#include <JXRGlue.h>
+#undef min
+#undef max
+
+namespace WebCore {
+namespace {
+constexpr size_t maximumBytes = 256 * 1024 * 1024;
+// Validate TIFF-style directory payloads before the reference library can
+// allocate a metadata field from its declared count. Codec extents are checked
+// again once the library has interpreted the directory.
+bool validDirectory(std::span<const uint8_t> bytes)
+{
+    auto u16 = [&](size_t p) -> uint16_t { return bytes[p] | (bytes[p + 1] << 8); };
+    auto u32 = [&](size_t p) -> uint32_t { return u16(p) | (static_cast<uint32_t>(u16(p + 2)) << 16); };
+    const size_t directory = u32(4);
+    if (directory < 8 || directory > bytes.size() - 2) return false;
+    const size_t entries = u16(directory);
+    if (!entries || entries > 4096 || entries * 12 + 6 > bytes.size() - directory) return false;
+    static constexpr unsigned typeSizes[] = {0, 1, 1, 2, 4, 8, 1, 1, 2, 4, 8, 4, 8};
+    for (size_t i = 0; i < entries; ++i) {
+        const size_t entry = directory + 2 + i * 12;
+        const unsigned type = u16(entry + 2);
+        if (!type || type >= std::size(typeSizes)) return false;
+        const uint64_t size = static_cast<uint64_t>(u32(entry + 4)) * typeSizes[type];
+        if (size > 16 * 1024 * 1024) return false;
+        if (size > 4) {
+            const size_t offset = u32(entry + 8);
+            if (offset > bytes.size() || size > bytes.size() - offset) return false;
+        }
+    }
+    return true;
+}
+struct XRStream {
+    WMPStream stream { };
+    std::vector<uint8_t> output;
+    std::span<const uint8_t> input;
+    bool allowPadding = false;
+    size_t position = 0;
+    bool failed = false;
+    static XRStream& self(WMPStream* stream) { return *static_cast<XRStream*>(stream->state.pvObj); }
+    explicit XRStream(std::span<const uint8_t> bytes = {}) : input(bytes)
+    {
+        stream.state.pvObj = this;
+        stream.Close = [](WMPStream** value) -> ERR { *value = nullptr; return WMP_errSuccess; };
+        stream.EOS = [](WMPStream* value) -> Bool { auto& s = self(value); return s.position >= (s.input.empty() ? s.output.size() : s.input.size()); };
+        stream.Read = [](WMPStream* value, void* output, size_t length) -> ERR {
+            auto& s = self(value);
+            const std::span<const uint8_t> bytes = s.input.empty() ? std::span<const uint8_t>(s.output) : s.input;
+            if (s.position > bytes.size() + (s.allowPadding ? 8192 : 0)) { s.failed = true; return WMP_errFileIO; }
+            const size_t available = s.position < bytes.size() ? std::min(length, bytes.size() - s.position) : 0;
+            if (available < length && (!s.allowPadding || length > 8192)) {
+                s.failed = true; return WMP_errFileIO;
+            }
+            if (available) std::memcpy(output, bytes.data() + s.position, available);
+            // The bitstream reader fills fixed-size packets past the last
+            // byte. Container metadata reads remain strict, and declared
+            // image/alpha extents are checked before enabling this padding.
+            if (available < length) std::memset(static_cast<uint8_t*>(output) + available, 0, length - available);
+            s.position += available;
+            return WMP_errSuccess;
+        };
+        stream.Write = [](WMPStream* value, const void* bytes, size_t length) -> ERR {
+            auto& s = self(value);
+            if (!s.input.empty()) { s.failed = true; return WMP_errFileIO; }
+            if (s.position > maximumBytes || length > maximumBytes - s.position) {
+                s.failed = true; return WMP_errBufferOverflow;
+            }
+#if defined(__cpp_exceptions)
+            try {
+#endif
+                if (s.position + length > s.output.size()) s.output.resize(s.position + length);
+#if defined(__cpp_exceptions)
+            } catch (const std::bad_alloc&) { s.failed = true; return WMP_errOutOfMemory; }
+#endif
+            std::memcpy(s.output.data() + s.position, bytes, length);
+            s.position += length;
+            return WMP_errSuccess;
+        };
+        stream.SetPos = [](WMPStream* value, size_t position) -> ERR {
+            auto& s = self(value);
+            const size_t limit = s.input.empty() ? maximumBytes : s.input.size() + (s.allowPadding ? 8192 : 0);
+            if (position > limit) { s.failed = true; return WMP_errBufferOverflow; }
+            s.position = position;
+            return WMP_errSuccess;
+        };
+        stream.GetPos = [](WMPStream* value, size_t* position) -> ERR {
+            *position = self(value).position;
+            return WMP_errSuccess;
+        };
+    }
+};
+struct DecoderDeleter {
+    void operator()(PKImageDecode* decoder) const { decoder->Release(&decoder); }
+};
+struct EncoderDeleter {
+    void operator()(PKImageEncode* encoder) const { encoder->Release(&encoder); }
+};
+}
+std::optional<JPEGXRImage> decodeJPEGXR(std::span<const uint8_t> bytes, bool onlySize)
+{
+    if (bytes.size() < 8 || bytes.size() > maximumBytes || bytes[0] != 'I' || bytes[1] != 'I'
+        || bytes[2] != 0xbc || bytes[3] != 1 || !validDirectory(bytes))
+        return {};
+    XRStream stream(bytes);
+    PKImageDecode* raw = nullptr;
+    if (PKImageDecode_Create_WMP(&raw) != WMP_errSuccess || !raw)
+        return {};
+    std::unique_ptr<PKImageDecode, DecoderDeleter> decoder(raw);
+    if (decoder->Initialize(decoder.get(), &stream.stream) != WMP_errSuccess || stream.failed)
+        return {};
+    auto extentValid = [&](uint32_t offset, uint32_t length) {
+        return length > 0 && static_cast<uint64_t>(offset) + length <= bytes.size();
+    };
+    const auto& extents = decoder->WMP.wmiDEMisc;
+    if (!extentValid(extents.uImageOffset, extents.uImageByteCount)
+        || (extents.uAlphaByteCount && !extentValid(extents.uAlphaOffset, extents.uAlphaByteCount)))
+        return {};
+    int32_t width = 0, height = 0;
+    if (decoder->GetSize(decoder.get(), &width, &height) != WMP_errSuccess || width <= 0 || height <= 0
+        || width > 16384 || height > 16384 || static_cast<uint64_t>(width) * height > maximumBytes / 4)
+        return {};
+    JPEGXRImage result;
+    result.width = width;
+    result.height = height;
+    PKPixelInfo original { };
+    original.pGUIDPixFmt = &decoder->guidPixFormat;
+    if (PixelFormatLookup(&original, LOOKUP_FORWARD) != WMP_errSuccess)
+        return {};
+    result.hasAlpha = original.grBit & PK_pixfmtHasAlpha;
+    if (onlySize)
+        return result;
+    PKPixelInfo format { };
+    format.pGUIDPixFmt = &GUID_PKPixelFormat32bppRGBA;
+    if (PixelFormatLookup(&format, LOOKUP_FORWARD) != WMP_errSuccess)
+        return {};
+    auto& info = decoder->WMP.wmiI;
+    info.cfColorFormat = format.cfColorFormat;
+    info.bdBitDepth = format.bdBitDepth;
+    info.cBitsPerUnit = format.cbitUnit;
+    info.bRGB = TRUE;
+    info.cThumbnailWidth = info.cWidth;
+    info.cThumbnailHeight = info.cHeight;
+    info.cROILeftX = info.cROITopY = 0;
+    info.cROIWidth = info.cWidth;
+    info.cROIHeight = info.cHeight;
+    decoder->WMP.wmiSCP.uAlphaMode = result.hasAlpha ? 2 : 0;
+    decoder->WMP.wmiSCP.sbSubband = SB_ALL;
+    result.pixels.resize(static_cast<size_t>(width) * height * 4);
+    stream.allowPadding = true;
+    PKRect rect {0, 0, width, height};
+    if (decoder->Copy(decoder.get(), &rect, result.pixels.data(), width * 4) != WMP_errSuccess || stream.failed)
+        return {};
+    if (!result.hasAlpha)
+        for (size_t i = 3; i < result.pixels.size(); i += 4) result.pixels[i] = 255;
+    else if (original.grBit & PK_pixfmtPreMul) {
+        for (size_t i = 0; i < result.pixels.size(); i += 4) {
+            const unsigned alpha = result.pixels[i + 3];
+            for (unsigned c = 0; c < 3; ++c)
+                result.pixels[i + c] = alpha ? std::min(255u, (result.pixels[i + c] * 255u + alpha / 2) / alpha) : 0;
+        }
+    }
+    U32 profileSize = 0;
+    if (decoder->GetColorContext(decoder.get(), nullptr, &profileSize) == WMP_errSuccess
+        && profileSize && profileSize <= 4 * 1024 * 1024) {
+        result.colorProfile.resize(profileSize);
+        stream.allowPadding = false;
+        if (decoder->GetColorContext(decoder.get(), result.colorProfile.data(), &profileSize) != WMP_errSuccess || stream.failed)
+            result.colorProfile.clear();
+    }
+    return result;
+}
+std::vector<uint8_t> encodeJPEGXR(std::span<const uint8_t> pixels, unsigned width, unsigned height,
+    unsigned stride, std::optional<double> quality)
+{
+    if (!width || !height || width > 16384 || height > 16384 || static_cast<uint64_t>(width) * height > maximumBytes / 4
+        || stride < static_cast<uint64_t>(width) * 4 || static_cast<uint64_t>(height - 1) * stride + width * 4 > pixels.size())
+        return {};
+    XRStream stream;
+    PKImageEncode* raw = nullptr;
+    if (PKImageEncode_Create_WMP(&raw) != WMP_errSuccess || !raw)
+        return {};
+    raw->pStream = &stream.stream; // Release also closes the stream after failed initialization.
+    std::unique_ptr<PKImageEncode, EncoderDeleter> encoder(raw);
+    CWMIStrCodecParam options { };
+    options.cfColorFormat = YUV_444;
+    options.bdBitDepth = BD_LONG;
+    options.bfBitstreamFormat = FREQUENCY;
+    options.bProgressiveMode = TRUE;
+    options.olOverlap = OL_NONE;
+    options.sbSubband = SB_ALL;
+    options.uAlphaMode = 3; // Interleaved alpha; no temporary file for a second plane.
+    options.uiDefaultQPIndex = 1; // Lossless by default, also for quality == 1.
+    options.uiDefaultQPIndexAlpha = 1;
+    if (quality && std::isfinite(*quality) && *quality >= 0 && *quality < 1) {
+        options.uiDefaultQPIndex = static_cast<U8>(1 + std::lround((1 - *quality) * 70));
+        options.olOverlap = OL_ONE;
+    }
+    if (encoder->Initialize(encoder.get(), &stream.stream, &options, sizeof(options)) != WMP_errSuccess
+        || encoder->SetPixelFormat(encoder.get(), GUID_PKPixelFormat32bppRGBA) != WMP_errSuccess
+        || encoder->SetSize(encoder.get(), width, height) != WMP_errSuccess
+        || encoder->SetResolution(encoder.get(), 96, 96) != WMP_errSuccess
+        || encoder->WritePixels(encoder.get(), height, const_cast<uint8_t*>(pixels.data()), stride) != WMP_errSuccess
+        || encoder->Terminate(encoder.get()) != WMP_errSuccess || stream.failed)
+        return {};
+    return std::move(stream.output);
+}
+}
