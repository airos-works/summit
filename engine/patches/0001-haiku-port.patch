+void BWebKitView::RunBookmarklet(const char* source, BMessenger reply, uint64 identifier, uint64 expectedGeneration)
+{
+    BMessage message(B_WEBKIT_JAVASCRIPT_RESULT);
+    message.AddUInt64("identifier", identifier);
+    message.AddUInt64("generation", expectedGeneration);
+    if (m_status != B_OK || !source || strlen(source) > 65536 || strncasecmp(source, "javascript:", 11)) {
+        message.AddString("error", "Invalid bookmarklet");
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        return;
+    }
+    RunLoop::mainSingleton().dispatch([state = m_state, source = copyTextHaiku(source), reply, message = WTF::move(message), expectedGeneration]() mutable {
+        message.AddMessenger("view", viewOfStateHaiku(state));
+        RefPtr page = pageHaiku(state);
+        RefPtr frame = page ? page->mainFrame() : nullptr;
+        URL url { stringHaiku(source) };
+        if (!page || !frame || !page->hasRunningProcess() || !expectedGeneration
+            || state->load.generation != expectedGeneration || state->load.pending || !state->documentIdentifier
+            || !url.protocolIsJavaScript()) {
+            message.AddString("error", "The document changed or is still loading");
+            reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            return;
+        }
+        Ref process = frame->process();
+        process->sendWithAsyncReply(Messages::WebPage::RunBookmarkletHaiku(url, *state->documentIdentifier),
+            [reply, message = WTF::move(message)](String&& error) mutable {
+                if (!error.isEmpty()) addStringHaiku(message, "error", error);
+                else message.AddBool("result", true);
+                reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            }, page->webPageIDInProcess(process));
+    });
+}
+
+void BWebKitView::EvaluateJavaScript(const char* source, BMessenger reply, uint64 identifier, bool asAsyncFunction)
+{
+    auto fail = [&](const char* error) {
+        BMessage message(B_WEBKIT_JAVASCRIPT_RESULT);
+        message.AddUInt64("identifier", identifier);
+        message.AddString("error", error);
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    };
+    if (m_status != B_OK) {
+        fail("The view has no page");
+        return;
+    }
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, source = copyTextHaiku(source), reply, identifier, asAsyncFunction] {
+        BMessage message(B_WEBKIT_JAVASCRIPT_RESULT);
+        message.AddMessenger("view", viewOfStateHaiku(state));
+        message.AddUInt64("identifier", identifier);
+        auto* page = pageHaiku(state);
+        auto string = page ? IPC::TransferString::create(stringHaiku(source)) : std::nullopt;
+        if (!string) {
+            message.AddString("error", page ? "Out of memory" : "The view is closed");
+            reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            return;
+        }
+        WebKit::RunJavaScriptParameters parameters {
+            WTF::move(*string),
+            JSC::SourceTaintedOrigin::Untainted,
+            // The browser's own script, not the page's: without an address
+            // WebCore names it after the document, so the inspector listed
+            // it as one of the page's scripts and breakpoints on the page's
+            // address bound into it.
+            URL { "user-script:summit"_s },
+            asAsyncFunction ? RunAsAsyncFunction::Yes : RunAsAsyncFunction::No,
+            // An async function needs an (empty) argument list: ScriptController
+            // iterates it unconditionally, as callAsyncJavaScript passes one.
+            asAsyncFunction ? std::optional { Vector<std::pair<String, JavaScriptEvaluationResult>> { } } : std::nullopt,
+            ForceUserGesture::Yes,
+            RemoveTransientActivation::Yes
+        };
+        page->runJavaScriptInMainFrame(WTF::move(parameters), true, [message = WTF::move(message), reply](auto&& result) mutable {
+            if (result)
+                addScriptValueHaiku(message, WTF::move(*result), "result", "result_type");
+            else if (!result.error())
+                message.AddString("error", "The script returned a value that cannot be passed back");
+            else {
+                auto& details = *result.error();
+                StringBuilder builder;
+                if (!details.sourceURL.isEmpty()) {
+                    builder.append(details.sourceURL);
+                    if (details.lineNumber > 0)
+                        builder.append(':', details.lineNumber);
+                    builder.append(": "_s);
+                }
+                builder.append(details.message);
+                addStringHaiku(message, "error", builder.toString());
+            }
+            reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        });
+    });
+}
+
+void BWebKitView::EvaluateJavaScriptIsolated(const char* source, BMessenger reply, uint64 identifier, uint64 expectedGeneration)
+{
+    EvaluateJavaScriptIsolated(source, reply, identifier, expectedGeneration, false);
+}
+
+void BWebKitView::EvaluateJavaScriptIsolated(const char* source, BMessenger reply, uint64 identifier, uint64 expectedGeneration, bool keepWorld)
+{
+    if (m_status != B_OK) {
+        BMessage message(B_WEBKIT_JAVASCRIPT_RESULT);
+        message.AddUInt64("identifier", identifier);
+        message.AddString("error", "The view has no page");
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        return;
+    }
+    RunLoop::mainSingleton().dispatch([state = m_state, source = copyTextHaiku(source), reply, identifier, expectedGeneration, keepWorld] {
+        BMessage message(B_WEBKIT_JAVASCRIPT_RESULT);
+        message.AddMessenger("view", viewOfStateHaiku(state));
+        message.AddUInt64("identifier", identifier);
+        message.AddUInt64("generation", expectedGeneration);
+        auto* page = pageHaiku(state);
+        if (!page || state->load.generation != expectedGeneration || state->load.pending) {
+            message.AddString("error", "The document changed");
+            reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            return;
+        }
+        auto string = IPC::TransferString::create(stringHaiku(source));
+        if (!string) {
+            message.AddString("error", "Out of memory");
+            reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            return;
+        }
+        auto world = [&]() -> Ref<API::ContentWorld> {
+            if (!keepWorld)
+                return API::ContentWorld::createNamelessWorld({ ContentWorldOption::DisableLegacyBuiltinOverrides });
+            if (!state->inspectionWorld)
+                state->inspectionWorld = API::ContentWorld::createNamelessWorld({ ContentWorldOption::DisableLegacyBuiltinOverrides });
+            return *state->inspectionWorld;
+        }();
+        WebKit::RunJavaScriptParameters parameters { WTF::move(*string), JSC::SourceTaintedOrigin::Untainted, URL { "user-script:summit"_s },
+            RunAsAsyncFunction::No, std::nullopt, ForceUserGesture::No, RemoveTransientActivation::No };
+        page->runJavaScriptInFrameInScriptWorld(WTF::move(parameters), std::nullopt, world, true,
+            [state, world, message = WTF::move(message), reply, expectedGeneration](auto&& result) mutable {
+                if (state->closed || state->load.generation != expectedGeneration || state->load.pending)
+                    message.AddString("error", "The document changed");
+                else if (result)
+                    addScriptValueHaiku(message, WTF::move(*result), "result", "result_type");
+                else
+                    message.AddString("error", "Could not inspect this document");
+                reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            });
+    });
+}
