+// WebCodecs' AudioData: the samples in the format the page gave (so a copy
+// in that format is exact), converted when another format is asked for.
+class PlatformRawAudioDataHaiku final : public PlatformRawAudioData {
+public:
+    static Ref<PlatformRawAudioDataHaiku> create(Ref<SharedBuffer>&& data, AudioSampleFormat format, float sampleRate, int64_t timestamp, size_t numberOfFrames, size_t numberOfChannels)
+    {
+        return adoptRef(*new PlatformRawAudioDataHaiku(WTF::move(data), format, sampleRate, timestamp, numberOfFrames, numberOfChannels));
+    }
+
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::Haiku; }
+    AudioSampleFormat format() const final { return m_format; }
+    size_t sampleRate() const final { return m_sampleRate; }
+    size_t numberOfChannels() const final { return m_numberOfChannels; }
+    size_t numberOfFrames() const final { return m_numberOfFrames; }
+    std::optional<uint64_t> duration() const final;
+    int64_t timestamp() const final { return m_timestamp; }
+    size_t memoryCost() const final { return m_data->size(); }
+
+    std::span<const uint8_t> bytes() const { return m_data->span(); }
+
+private:
+    PlatformRawAudioDataHaiku(Ref<SharedBuffer>&& data, AudioSampleFormat format, float sampleRate, int64_t timestamp, size_t numberOfFrames, size_t numberOfChannels)
+        : m_data(WTF::move(data))
+        , m_format(format)
+        , m_sampleRate(sampleRate)
+        , m_timestamp(timestamp)
+        , m_numberOfFrames(numberOfFrames)
+        , m_numberOfChannels(numberOfChannels)
+    {
+    }
+
+    const Ref<SharedBuffer> m_data;
+    const AudioSampleFormat m_format;
+    const size_t m_sampleRate;
+    const int64_t m_timestamp;
+    const size_t m_numberOfFrames;
+    const size_t m_numberOfChannels;
+};
