+void WebExtensionContext::i18nDetectLanguageHaiku(const String& text, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    static constexpr auto apiName = "i18n.detectLanguage()"_s;
+    // The detector reads at most 64 KiB; the host keeps the text's start.
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    if (message.AddUInt32("command", B_WEBKIT_BROWSER_DETECT_LANGUAGE) != B_OK
+        || message.AddString("text", text.left(65536).utf8().legacyCStringPointer()) != B_OK) {
+        completion(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+        return;
+    }
+    sendNativeBrowserQueryHaiku(WTF::move(message), apiName, WTF::move(completion));
+}
