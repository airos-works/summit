+static const HashSet<String>& mseTypes()
+{
+    static NeverDestroyed types = [] {
+        HashSet<String> result { "video/mp4"_s, "audio/mp4"_s, "audio/aac"_s, "audio/mpeg"_s
+#if USE(LIBWEBRTC)
+            , "video/webm"_s, "audio/webm"_s
+#endif
