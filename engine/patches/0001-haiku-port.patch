+// Summit has no tab groups (WebExtensionAPITabGroups): no tab can be put in
+// one, and every tab is already out of one.
+void WebExtensionAPITabs::group(RefPtr<JSON::Value> options, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!options || !options->asObject()) {
+        exception = toErrorString(nullString(), "options"_s, "an object is expected"_s);
+        return;
+    }
+    callback->reportError("Summit has no tab groups."_s);
+}
