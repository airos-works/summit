+void Pasteboard::writeString(const String& type, const String& data)
+{
+    if (m_forDragAndDrop) {
+        m_dragData.writeString(type, data);
+        return;
+    }
+    if (be_clipboard->Lock()) {
+        bool result = false;
+        BMessage* bdata = be_clipboard->Data();
+
+        if (bdata) {
+            UTF8CString typeUTF8 = type.utf8();
+            bdata->RemoveName(typeUTF8.legacyCStringPointer());
+
+            UTF8CString dataUTF8 = data.utf8();
+            if (bdata->AddData(typeUTF8.legacyCStringPointer(), B_MIME_TYPE,
+                    dataUTF8.data(), dataUTF8.length()) == B_OK)
+                result = true;
+        }
+
+        if (result)
+            be_clipboard->Commit();
+        else
+            be_clipboard->Revert();
+        be_clipboard->Unlock();
+    }
+}
