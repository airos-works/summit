+bool Module::load()
+{
+    if (m_module >= 0)
+        return true;
+    m_module = load_add_on(m_path.utf8().legacyCStringPointer());
+    return m_module >= 0;
+}
+
+void Module::unload()
+{
+    auto module = std::exchange(m_module, -1);
+    if (module >= 0)
+        unload_add_on(module);
+}
