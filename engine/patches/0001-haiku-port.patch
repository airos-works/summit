+void BWebKitContext::NotifyBookmarksChanged(const char* event, const char* identifier, const char* json)
+{
+    if (m_status != B_OK || !event || !identifier || !json)
+        return;
+    std::optional<WebKit::WebExtensionEventListenerType> type;
+    if (!strcmp(event, "created"))
+        type = WebKit::WebExtensionEventListenerType::BookmarksOnCreated;
+    else if (!strcmp(event, "removed"))
+        type = WebKit::WebExtensionEventListenerType::BookmarksOnRemoved;
+    else if (!strcmp(event, "changed"))
+        type = WebKit::WebExtensionEventListenerType::BookmarksOnChanged;
+    else if (!strcmp(event, "moved"))
+        type = WebKit::WebExtensionEventListenerType::BookmarksOnMoved;
+    if (!type)
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([context = m_context, type = *type, identifier = String::fromUTF8(identifier).isolatedCopy(), json = String::fromUTF8(json).isolatedCopy()] {
+        Ref controller = context->extensionController();
+        controller->didChangeBookmarksHaiku(type, identifier, json);
+    });
+}
