+void WebExtensionContext::tabsDuplicate(WebExtensionTabIdentifier tabIdentifier, const WebExtensionTabParameters& parameters, CompletionHandler<void(std::expected<std::optional<WebExtensionTabParameters>, WebExtensionError>&&)>&& completionHandler)
+{
+    // A new tab at the same address, after the original and opened by it.
+    // Summit's tabs cannot copy another tab's back/forward list.
+    RefPtr tab = getTab(tabIdentifier);
+    if (!tab) {
+        completionHandler(toWebExtensionError("tabs.duplicate()"_s, nullString(), "tab not found"_s));
+        return;
+    }
+    RefPtr window = tab->window();
+    WebExtensionTabParameters creation;
+    creation.url = tab->url();
+    if (window)
+        creation.windowIdentifier = window->identifier();
+    creation.index = parameters.index.value_or(tab->index() + 1);
+    creation.active = parameters.active.value_or(true);
+    creation.parentTabIdentifier = tab->identifier();
+    tabsCreate(std::nullopt, creation, WTF::move(completionHandler));
+}
