+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WEB_BLUETOOTH)
+#include "BluetoothSessionHaiku.h"
+#include <Messenger.h>
+#include <functional>
+#include <wtf/CompletionHandler.h>
+#include <wtf/HashMap.h>
+#include <wtf/JSONValues.h>
+#include <wtf/WorkQueue.h>
+#include <wtf/text/StringHash.h>
+
+namespace WebKit {
+class SitePermissionsHaiku;
+class WebBluetoothBrokerHaiku final : public std::enable_shared_from_this<WebBluetoothBrokerHaiku> {
+public:
+    using Completion = CompletionHandler<void(String&&, Vector<uint8_t>&&)>;
+    static std::shared_ptr<WebBluetoothBrokerHaiku> create(std::shared_ptr<SitePermissionsHaiku>);
+    ~WebBluetoothBrokerHaiku();
+    void request(uint64_t page, const String& owner, const String& origin, const BMessenger&,
+        const String& arguments, Vector<uint8_t>&&, std::function<bool()>&& isCurrent, Completion&&);
+    void cancelPage(uint64_t);
+    void shutdown();
+private:
+    explicit WebBluetoothBrokerHaiku(std::shared_ptr<SitePermissionsHaiku>);
+    struct Connection;
+    struct Grant {
+        String origin;
+        BluetoothHaiku::Device device;
+        std::set<WebCore::BluetoothHaiku::UUID> services;
+        String owner;
+        uint64_t page { 0 };
+        std::shared_ptr<Connection> connection;
+        unsigned pending { 0 };
+    };
+    struct Scan { uint64_t page; std::shared_ptr<std::atomic<bool>> cancelled; BMessenger view; };
+    void choose(uint64_t, const String&, const String&, const BMessenger&, Ref<JSON::Object>&&,
+        std::function<bool()>&&, Completion&&);
+    void closeGrant(Grant&);
+    const std::shared_ptr<SitePermissionsHaiku> m_permissions;
+    const Ref<WorkQueue> m_scanQueue;
+    HashMap<String, std::unique_ptr<Grant>> m_grants;
+    HashMap<uint64_t, Scan> m_scans;
+    uint64_t m_nextScan { 0 };
+    unsigned m_pendingAvailability { 0 };
+    bool m_shutdown { false };
+};
+}
+#endif
