+void SourceBufferPrivateHaiku::configureParser(const ContentType& type)
+{
+    auto container = type.containerType().convertToASCIILowercase();
+    m_parserNeedsEndFlush = false;
+    if (container == "video/mp2t"_s) {
+        m_mpegTSParser = std::make_unique<SummitMPEGTS::Parser>();
+        m_mpegTSParser->onInitSegment = [this](SummitMP4::InitSegment&& segment) { didParseInitializationSegment(WTF::move(segment)); };
+        m_mpegTSParser->onSample = [this](SummitMP4::Sample&& sample) { didParseSample(WTF::move(sample)); };
+    } else
+        m_mpegTSParser = nullptr;
+    if (container == "audio/aac"_s || container == "audio/mpeg"_s) {
+        m_mpegAudioParser = std::make_unique<SummitMPEGAudio::Parser>(container == "audio/aac"_s
+            ? SummitMPEGAudio::Parser::Format::ADTS : SummitMPEGAudio::Parser::Format::MPEG);
+        m_mpegAudioParser->onInitSegment = [this](SummitMP4::InitSegment&& segment) { didParseInitializationSegment(WTF::move(segment)); };
+        m_mpegAudioParser->onSample = [this](SummitMP4::Sample&& sample) { didParseSample(WTF::move(sample)); };
+    } else
+        m_mpegAudioParser = nullptr;
+#if USE(LIBWEBRTC)
+    if (container == "video/webm"_s || container == "audio/webm"_s) {
+        m_webmParser = std::make_unique<SummitWebM::Parser>();
+        m_webmParser->onInitSegment = [this](SummitMP4::InitSegment&& segment) { didParseInitializationSegment(WTF::move(segment)); };
+        m_webmParser->onSample = [this](SummitMP4::Sample&& sample) { didParseSample(WTF::move(sample)); };
+    } else
+        m_webmParser = nullptr;
+#endif
+}
