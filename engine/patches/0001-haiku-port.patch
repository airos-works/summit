+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "WebHIDBrokerHaiku.h"
+#include "SitePermissionsHaiku.h"
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/HexNumber.h>
+#include <wtf/UUID.h>
+#include <wtf/text/MakeString.h>
+#include <unordered_map>
+
+namespace WebKit {
+using namespace HIDHaiku;
+
+// Main-thread ownership spans normal and private browsing contexts.
+static auto& openInterfaces()
+{
+    static NeverDestroyed<std::unordered_map<std::string, std::weak_ptr<Connection>>> interfaces;
+    return interfaces.get();
+}
+static std::string interfaceKey(const Interface& device)
+{
+    return device.path + '#' + std::to_string(device.number);
+}
+static String hidError(ASCIILiteral name, ASCIILiteral message)
+{
+    auto object = JSON::Object::create();
+    object->setString("error"_s, name);
+    object->setString("message"_s, message);
+    return object->toJSONString();
+}
+static ASCIILiteral errorName(Error error)
+{
+    switch (error) {
+    case Error::None: return ""_s;
+    case Error::NotFound: return "NotFoundError"_s;
+    case Error::Security: return "SecurityError"_s;
+    case Error::InvalidState: return "InvalidStateError"_s;
+    case Error::Network: return "NetworkError"_s;
+    case Error::NotSupported: return "NotAllowedError"_s;
+    case Error::Abort: return "AbortError"_s;
+    }
+    return "NetworkError"_s;
+}
+static String fromUTF8(const std::string& string)
+{
+    return String::fromUTF8ReplacingInvalidSequences(std::span(reinterpret_cast<const char8_t*>(string.data()), string.size()));
+}
+
+static ASCIILiteral unitSystem(uint8_t value)
+{
+    switch (value) {
+    case 0: return "none"_s;
+    case 1: return "si-linear"_s;
+    case 2: return "si-rotation"_s;
+    case 3: return "english-linear"_s;
+    case 4: return "english-rotation"_s;
+    case 15: return "vendor-defined"_s;
+    default: return "reserved"_s;
+    }
+}
+
+static Ref<JSON::Array> reportsJSON(const std::vector<Report>& reports)
+{
+    auto result = JSON::Array::create();
+    for (auto& report : reports) {
+        auto object = JSON::Object::create();
+        object->setInteger("reportId"_s, report.id);
+        auto items = JSON::Array::create();
+        for (auto& item : report.items) {
+            auto value = JSON::Object::create();
+            value->setBoolean("isAbsolute"_s, item.isAbsolute);
+            value->setBoolean("isArray"_s, item.isArray);
+            value->setBoolean("isBufferedBytes"_s, item.isBufferedBytes);
+            value->setBoolean("isConstant"_s, item.isConstant);
+            value->setBoolean("isLinear"_s, item.isLinear);
+            value->setBoolean("isRange"_s, item.isRange);
+            value->setBoolean("isVolatile"_s, item.isVolatile);
+            value->setBoolean("hasNull"_s, item.hasNull);
+            value->setBoolean("hasPreferredState"_s, item.hasPreferredState);
+            value->setBoolean("wrap"_s, item.wrap);
+            auto usages = JSON::Array::create();
+            for (auto usage : item.usages)
+                usages->pushDouble(usage);
+            value->setArray("usages"_s, WTF::move(usages));
+            value->setDouble("usageMinimum"_s, item.usageMinimum);
+            value->setDouble("usageMaximum"_s, item.usageMaximum);
+            value->setInteger("reportSize"_s, item.reportSize);
+            value->setInteger("reportCount"_s, item.reportCount);
+            value->setInteger("unitExponent"_s, item.unitExponent);
+            value->setString("unitSystem"_s, unitSystem(item.unitSystem));
+            static constexpr ASCIILiteral factors[] = {
+                "unitFactorLengthExponent"_s, "unitFactorMassExponent"_s, "unitFactorTimeExponent"_s,
+                "unitFactorTemperatureExponent"_s, "unitFactorCurrentExponent"_s, "unitFactorLuminousIntensityExponent"_s,
+            };
+            for (unsigned i = 0; i < 6; ++i)
+                value->setInteger(factors[i], item.unitFactors[i]);
+            value->setInteger("logicalMinimum"_s, item.logicalMinimum);
+            value->setInteger("logicalMaximum"_s, item.logicalMaximum);
+            value->setInteger("physicalMinimum"_s, item.physicalMinimum);
+            value->setInteger("physicalMaximum"_s, item.physicalMaximum);
+            value->setArray("strings"_s, JSON::Array::create());
+            items->pushObject(WTF::move(value));
+        }
+        object->setArray("items"_s, WTF::move(items));
+        result->pushObject(WTF::move(object));
+    }
+    return result;
+}
+
+static Ref<JSON::Array> collectionsJSON(const std::vector<Collection>& collections)
+{
+    auto result = JSON::Array::create();
+    for (auto& collection : collections) {
+        auto object = JSON::Object::create();
+        object->setInteger("usagePage"_s, collection.usagePage);
+        object->setInteger("usage"_s, collection.usage);
+        object->setInteger("type"_s, collection.type);
+        object->setArray("children"_s, collectionsJSON(collection.children));
+        object->setArray("inputReports"_s, reportsJSON(collection.inputReports));
+        object->setArray("outputReports"_s, reportsJSON(collection.outputReports));
+        object->setArray("featureReports"_s, reportsJSON(collection.featureReports));
+        result->pushObject(WTF::move(object));
+    }
+    return result;
+}
+
+static Ref<JSON::Object> deviceJSON(const Interface& device, const String& token)
+{
+    auto object = JSON::Object::create();
+    object->setString("id"_s, token);
+    object->setInteger("vendorId"_s, device.vendorId);
+    object->setInteger("productId"_s, device.productId);
+    object->setString("productName"_s, fromUTF8(device.product));
+    object->setArray("collections"_s, collectionsJSON(device.descriptor.collections));
+    return object;
+}
+
+struct Filter {
+    std::optional<uint16_t> vendorId;
+    std::optional<uint16_t> productId;
+    std::optional<uint16_t> usagePage;
+    std::optional<uint16_t> usage;
+};
+
+static std::optional<Vector<Filter>> readFilters(const JSON::Object& arguments, ASCIILiteral key)
+{
+    auto array = arguments.getArray(key);
+    if (!array || array->length() > 64)
+        return std::nullopt;
+    Vector<Filter> result;
+    for (auto& value : *array) {
+        auto object = value->asObject();
+        if (!object)
+            return std::nullopt;
+        Filter filter;
+        bool valid = true;
+        auto number = [&](ASCIILiteral key, std::optional<uint16_t>& target) {
+            if (!object->getValue(key))
+                return;
+            auto value = object->getInteger(key);
+            if (!value || *value < 0 || *value > 65535)
+                valid = false;
+            else
+                target = *value;
+        };
+        number("vendorId"_s, filter.vendorId);
+        number("productId"_s, filter.productId);
+        number("usagePage"_s, filter.usagePage);
+        number("usage"_s, filter.usage);
+        if (!valid || (filter.productId && !filter.vendorId) || (filter.usage && !filter.usagePage))
+            return std::nullopt;
+        result.append(filter);
+    }
+    return result;
+}
+
+static bool matches(const Interface& device, const Filter& filter)
+{
+    if ((filter.vendorId && *filter.vendorId != device.vendorId) || (filter.productId && *filter.productId != device.productId))
+        return false;
+    if (!filter.usagePage)
+        return true;
+    return std::any_of(device.descriptor.collections.begin(), device.descriptor.collections.end(), [&](auto& collection) {
+        return collection.usagePage == *filter.usagePage && (!filter.usage || collection.usage == *filter.usage);
+    });
+}
+
+static bool sameInterface(const Interface& a, const Interface& b)
+{
+    return a.path == b.path && a.identity == b.identity && a.number == b.number;
+}
+
+std::shared_ptr<WebHIDBrokerHaiku> WebHIDBrokerHaiku::create(std::shared_ptr<SitePermissionsHaiku> permissions, Ref<WorkQueue>&& queue)
+{
+    return std::shared_ptr<WebHIDBrokerHaiku>(new WebHIDBrokerHaiku(std::move(permissions), WTF::move(queue)));
+}
+WebHIDBrokerHaiku::WebHIDBrokerHaiku(std::shared_ptr<SitePermissionsHaiku> permissions, Ref<WorkQueue>&& queue)
+    : m_permissions(std::move(permissions)), m_queue(WTF::move(queue)) { }
+WebHIDBrokerHaiku::~WebHIDBrokerHaiku() { shutdown(); }
+
+void WebHIDBrokerHaiku::enumerate(const String& origin, const BMessenger& view, Ref<JSON::Object>&& args,
+    std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    bool choosing = args->getString("operation"_s) == "requestDevice"_s;
+    if (!choosing && std::none_of(m_grants.begin(), m_grants.end(), [&](auto& grant) { return grant.value->origin == origin; })) {
+        // An unapproved origin learns nothing from probing the bus.
+        completion("{\"devices\":[]}"_s, { });
+        return;
+    }
+    auto include = choosing ? readFilters(args, "filters"_s) : std::optional { Vector<Filter> { } };
+    auto exclude = choosing ? readFilters(args, "exclusionFilters"_s) : std::optional { Vector<Filter> { } };
+    if (!include || !exclude) {
+        completion(hidError("TypeError"_s, "Invalid HID device filter"_s), { });
+        return;
+    }
+    if (m_enumerations >= 4) {
+        completion(hidError("InvalidStateError"_s, "A HID enumeration is already pending"_s), { });
+        return;
+    }
+    ++m_enumerations;
+    m_queue->dispatch([self = shared_from_this(), origin = origin.isolatedCopy(), view, choosing, include = WTF::move(*include),
+        exclude = WTF::move(*exclude), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+        auto devices = enumerateInterfaces();
+        std::erase_if(devices, [&](auto& device) {
+            return (!include.isEmpty() && std::none_of(include.begin(), include.end(), [&](auto& filter) { return matches(device, filter); }))
+                || std::any_of(exclude.begin(), exclude.end(), [&](auto& filter) { return matches(device, filter); });
+        });
+        RunLoop::mainSingleton().dispatch([self, origin = origin.isolatedCopy(), view, choosing, devices = std::move(devices),
+            isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            --self->m_enumerations;
+            if (self->m_shutdown || !isCurrent()) {
+                completion(hidError("AbortError"_s, "The HID document was closed"_s), { });
+                return;
+            }
+            if (!choosing) {
+                auto result = JSON::Object::create();
+                auto list = JSON::Array::create();
+                for (auto& grant : self->m_grants) {
+                    if (grant.value->origin != origin)
+                        continue;
+                    auto found = std::find_if(devices.begin(), devices.end(), [&](auto& device) { return sameInterface(device, grant.value->device); });
+                    if (found != devices.end())
+                        list->pushObject(deviceJSON(*found, grant.key));
+                    else if (!grant.value->gone) {
+                        grant.value->gone = true;
+                        self->closeGrant(*grant.value);
+                    }
+                }
+                result->setArray("devices"_s, WTF::move(list));
+                completion(result->toJSONString(), { });
+                return;
+            }
+            // Offer physical devices; a choice grants each of their matching
+            // interfaces, as other browsers do.
+            std::vector<std::vector<Interface>> groups;
+            for (auto& device : devices) {
+                auto group = std::find_if(groups.begin(), groups.end(), [&](auto& group) {
+                    return group.front().path == device.path && group.front().identity == device.identity;
+                });
+                if (group == groups.end())
+                    groups.push_back({ device });
+                else
+                    group->push_back(device);
+            }
+            if (groups.empty()) {
+                completion(hidError("NotFoundError"_s, "No eligible HID device matches these filters"_s), { });
+                return;
+            }
+            Vector<std::pair<String, String>> choices;
+            Vector<String> tokens;
+            for (auto& group : groups) {
+                auto token = WTF::UUID::createVersion4().toString();
+                auto& first = group.front();
+                auto label = first.product.empty() ? makeString("HID device "_s, hex(first.vendorId, 4), ':', hex(first.productId, 4))
+                    : fromUTF8(first.product);
+                // Never let device strings insert new lines in the permission UI.
+                label = makeStringByReplacingAll(makeStringByReplacingAll(label, '\n', ' '), '\r', ' ');
+                choices.append({ token, label });
+                tokens.append(token);
+            }
+            self->m_permissions->requestUSB(origin, view, WTF::move(choices),
+                [self, origin, groups = std::move(groups), tokens = WTF::move(tokens), isCurrent = std::move(isCurrent),
+                    completion = WTF::move(completion)](bool allowed, const String& selected) mutable {
+                    if (self->m_shutdown || !isCurrent()) {
+                        completion(hidError("AbortError"_s, "The HID document was closed"_s), { });
+                        return;
+                    }
+                    auto index = tokens.find(selected);
+                    if (!allowed || index == notFound || index >= groups.size()) {
+                        // WebHID resolves with no devices when nothing is chosen.
+                        completion("{\"devices\":[]}"_s, { });
+                        return;
+                    }
+                    auto result = JSON::Object::create();
+                    auto list = JSON::Array::create();
+                    for (auto& device : groups[index]) {
+                        String token;
+                        for (auto& grant : self->m_grants) {
+                            if (grant.value->origin == origin && sameInterface(grant.value->device, device)) {
+                                token = grant.key;
+                                grant.value->gone = false;
+                                break;
+                            }
+                        }
+                        if (token.isEmpty()) {
+                            if (self->m_grants.size() >= 256) {
+                                completion(hidError("NotAllowedError"_s, "Too many HID device grants"_s), { });
+                                return;
+                            }
+                            token = WTF::UUID::createVersion4().toString();
+                            auto grant = std::make_unique<Grant>();
+                            grant->origin = origin;
+                            grant->device = device;
+                            self->m_grants.add(token, WTF::move(grant));
+                        }
+                        list->pushObject(deviceJSON(device, token));
+                    }
+                    result->setArray("devices"_s, WTF::move(list));
+                    completion(result->toJSONString(), { });
+                }, "hid"_s);
+        });
+    });
+}
+
+void WebHIDBrokerHaiku::request(uint64_t page, const String& owner, const String& origin, const BMessenger& view,
+    Ref<JSON::Object>&& args, Vector<uint8_t>&& bytes, std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown || !isCurrent()) {
+        completion(hidError("AbortError"_s, "The HID document was closed"_s), { });
+        return;
+    }
+    auto op = args->getString("operation"_s);
+    if (op == "getDevices"_s || op == "requestDevice"_s) {
+        if (!bytes.isEmpty()) {
+            completion(hidError("TypeError"_s, "Invalid HID enumeration"_s), { });
+            return;
+        }
+        enumerate(origin, view, WTF::move(args), std::move(isCurrent), WTF::move(completion));
+        return;
+    }
+    auto token = args->getString("id"_s);
+    auto found = m_grants.find(token);
+    if (found == m_grants.end() || found->value->origin != origin) {
+        completion(hidError("SecurityError"_s, "This origin has no grant for the HID device"_s), { });
+        return;
+    }
+    auto& grant = *found->value;
+    if (op == "forget"_s) {
+        if (grant.connection && grant.owner != owner) {
+            completion(hidError("InvalidStateError"_s, "The HID device is in use"_s), { });
+            return;
+        }
+        closeGrant(grant);
+        m_grants.remove(found);
+        completion("{}"_s, { });
+        return;
+    }
+    if (op == "open"_s) {
+        open(token, grant, owner, page, WTF::move(completion));
+        return;
+    }
+    if ((grant.connection || grant.opening) && grant.owner != owner) {
+        completion(hidError("InvalidStateError"_s, "Another document is using this HID device"_s), { });
+        return;
+    }
+    if (op == "close"_s) {
+        closeGrant(grant);
+        completion("{}"_s, { });
+        return;
+    }
+    if (!grant.connection) {
+        completion(hidError("InvalidStateError"_s, "The HID device is not open"_s), { });
+        return;
+    }
+    if (op == "receive"_s) {
+        receive(grant, WTF::move(completion));
+        return;
+    }
+    auto reportId = args->getInteger("reportId"_s);
+    if (!reportId || *reportId < 0 || *reportId > 255 || bytes.size() > 65536) {
+        completion(hidError("TypeError"_s, "Invalid HID report"_s), { });
+        return;
+    }
+    if (grant.pending >= 64) {
+        completion(hidError("InvalidStateError"_s, "Too many HID operations are pending"_s), { });
+        return;
+    }
+    auto shared = std::make_shared<Completion>(WTF::move(completion));
+    auto done = [weak = weak_from_this(), connectionId = grant.connectionId, shared](Error error, std::vector<uint8_t>&& data) {
+        RunLoop::mainSingleton().dispatch([weak, connectionId, shared, error, data = std::move(data)]() mutable {
+            auto self = weak.lock();
+            if (self) {
+                for (auto& grant : self->m_grants) {
+                    if (grant.value->connectionId == connectionId && grant.value->pending)
+                        --grant.value->pending;
+                }
+            }
+            if (error != Error::None) {
+                (*shared)(hidError(errorName(error), error == Error::NotSupported
+                    ? "The device does not support this HID report"_s : "The HID report could not be transferred"_s), { });
+                return;
+            }
+            (*shared)("{}"_s, Vector<uint8_t>(std::span<const uint8_t>(data)));
+        });
+    };
+    ++grant.pending;
+    if (op == "sendReport"_s)
+        grant.connection->sendReport(*reportId, std::vector<uint8_t>(bytes.begin(), bytes.end()), std::move(done));
+    else if (op == "sendFeatureReport"_s)
+        grant.connection->sendFeatureReport(*reportId, std::vector<uint8_t>(bytes.begin(), bytes.end()), std::move(done));
+    else if (op == "receiveFeatureReport"_s && bytes.isEmpty())
+        grant.connection->receiveFeatureReport(*reportId, std::move(done));
+    else {
+        --grant.pending;
+        (*shared)(hidError("TypeError"_s, "Invalid HID operation"_s), { });
+    }
+}
+
+void WebHIDBrokerHaiku::open(const String& token, Grant& grant, const String& owner, uint64_t page, Completion&& completion)
+{
+    if (grant.gone) {
+        completion(hidError("NotFoundError"_s, "The HID device is no longer connected"_s), { });
+        return;
+    }
+    if ((grant.connection || grant.opening) && grant.owner != owner) {
+        completion(hidError("InvalidStateError"_s, "Another document is using this HID device"_s), { });
+        return;
+    }
+    if (grant.connection || grant.opening) {
+        // open() on an open device resolves; another document may not share it.
+        completion(grant.connection ? "{}"_s : hidError("InvalidStateError"_s, "The HID device is being opened"_s), { });
+        return;
+    }
+    auto key = interfaceKey(grant.device);
+    if (auto existing = openInterfaces().find(key); existing != openInterfaces().end() && !existing->second.expired()) {
+        completion(hidError("InvalidStateError"_s, "Another page is using this HID device"_s), { });
+        return;
+    }
+    grant.opening = true;
+    grant.owner = owner;
+    grant.page = page;
+    grant.connectionId = ++m_lastId;
+    auto connectionId = grant.connectionId;
+    Connection::InputHandler input = [weak = weak_from_this(), connectionId](uint8_t reportId, std::vector<uint8_t>&& data, bool gone) {
+        RunLoop::mainSingleton().dispatch([weak, connectionId, reportId, data = std::move(data), gone]() mutable {
+            if (auto self = weak.lock())
+                self->input(connectionId, reportId, Vector<uint8_t>(std::span<const uint8_t>(data)), gone);
+        });
+    };
+    m_queue->dispatch([self = shared_from_this(), token = token.isolatedCopy(), device = grant.device, connectionId,
+        input = std::move(input), completion = WTF::move(completion)]() mutable {
+        Error error;
+        auto connection = Connection::open(device, std::move(input), error);
+        RunLoop::mainSingleton().dispatch([self, token = token.isolatedCopy(), connectionId, connection = std::move(connection), error,
+            completion = WTF::move(completion)]() mutable {
+            auto found = self->m_grants.find(token);
+            if (self->m_shutdown || found == self->m_grants.end() || found->value->connectionId != connectionId || !found->value->opening) {
+                if (connection)
+                    connection->close();
+                completion(hidError("AbortError"_s, "The HID device was closed"_s), { });
+                return;
+            }
+            auto& grant = *found->value;
+            grant.opening = false;
+            if (!connection) {
+                grant.owner = { };
+                grant.page = 0;
+                completion(hidError(errorName(error), "The HID device could not be opened"_s), { });
+                return;
+            }
+            grant.connection = std::move(connection);
+            openInterfaces()[interfaceKey(grant.device)] = grant.connection;
+            completion("{}"_s, { });
+        });
+    });
+}
+
+void WebHIDBrokerHaiku::receive(Grant& grant, Completion&& completion)
+{
+    if (grant.waiting)
+        answerWaiting(grant);
+    grant.waiting = makeUnique<Completion>(WTF::move(completion));
+    grant.waitingId = ++m_lastId;
+    if (!grant.reports.isEmpty() || grant.gone) {
+        answerWaiting(grant);
+        return;
+    }
+    // Answer an idle wait now and then, so that a page that went away without
+    // closing the device does not keep a request here for ever.
+    RunLoop::mainSingleton().dispatchAfter(2_s, [weak = weak_from_this(), connectionId = grant.connectionId, waitingId = grant.waitingId] {
+        auto self = weak.lock();
+        if (!self)
+            return;
+        for (auto& grant : self->m_grants) {
+            if (grant.value->connectionId == connectionId && grant.value->waiting && grant.value->waitingId == waitingId)
+                self->answerWaiting(*grant.value);
+        }
+    });
+}
+
+void WebHIDBrokerHaiku::answerWaiting(Grant& grant)
+{
+    auto waiting = std::exchange(grant.waiting, nullptr);
+    if (!waiting)
+        return;
+    if (grant.reports.isEmpty() && grant.gone) {
+        (*waiting)(hidError("NotFoundError"_s, "The HID device is no longer connected"_s), { });
+        return;
+    }
+    auto result = JSON::Object::create();
+    auto list = JSON::Array::create();
+    Vector<uint8_t> bytes;
+    while (!grant.reports.isEmpty() && list->length() < 64 && bytes.size() < 65536) {
+        auto report = grant.reports.takeFirst();
+        grant.reportBytes -= report.second.size();
+        auto item = JSON::Object::create();
+        item->setInteger("reportId"_s, report.first);
+        item->setInteger("length"_s, report.second.size());
+        list->pushObject(WTF::move(item));
+        bytes.appendVector(report.second);
+    }
+    result->setArray("reports"_s, WTF::move(list));
+    (*waiting)(result->toJSONString(), WTF::move(bytes));
+}
+
+void WebHIDBrokerHaiku::input(uint64_t connectionId, uint8_t reportId, Vector<uint8_t>&& data, bool gone)
+{
+    ASSERT(RunLoop::isMain());
+    for (auto& entry : m_grants) {
+        auto& grant = *entry.value;
+        if (grant.connectionId != connectionId || !grant.connection)
+            continue;
+        if (gone)
+            grant.gone = true;
+        else {
+            // A page that stops reading loses its oldest reports.
+            while (!grant.reports.isEmpty() && (grant.reports.size() >= 1024 || grant.reportBytes + data.size() > 1024 * 1024)) {
+                grant.reportBytes -= grant.reports.first().second.size();
+                grant.reports.removeFirst();
+            }
+            grant.reportBytes += data.size();
+            grant.reports.append({ reportId, WTF::move(data) });
+        }
+        if (grant.waiting)
+            answerWaiting(grant);
+        return;
+    }
+}
+
+void WebHIDBrokerHaiku::closeGrant(Grant& grant)
+{
+    if (auto connection = std::exchange(grant.connection, nullptr)) {
+        auto key = interfaceKey(grant.device);
+        if (auto found = openInterfaces().find(key); found != openInterfaces().end() && found->second.lock() == connection)
+            openInterfaces().erase(found);
+        connection->close();
+    }
+    // Answers that arrive from the device thread no longer match a grant.
+    grant.connectionId = ++m_lastId;
+    grant.opening = false;
+    grant.owner = { };
+    grant.page = 0;
+    grant.pending = 0;
+    grant.reports.clear();
+    grant.reportBytes = 0;
+    if (auto waiting = std::exchange(grant.waiting, nullptr))
+        (*waiting)(hidError("InvalidStateError"_s, "The HID device was closed"_s), { });
+}
+
+void WebHIDBrokerHaiku::cancelPage(uint64_t page)
+{
+    ASSERT(RunLoop::isMain());
+    for (auto& grant : m_grants) {
+        if (grant.value->page == page)
+            closeGrant(*grant.value);
+    }
+}
+
+void WebHIDBrokerHaiku::shutdown()
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown)
+        return;
+    m_shutdown = true;
+    for (auto& grant : m_grants)
+        closeGrant(*grant.value);
+    m_grants.clear();
+}
+} // namespace WebKit
+#endif
