diff --git a/Tools/haiku/mimefix.sh b/Tools/haiku/mimefix.sh
new file mode 100644
index 0000000000000000000000000000000000000000..499a2552dca452464d987d3d125d043d7d078eab
--- /dev/null
+++ b/Tools/haiku/mimefix.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+# This script fixes some known issues with MIME type detection in Haiku. The MIME sniffer does not
+# always make the best guess on the type of files, and the test suite relies on the types being
+# correct. So, let's fix them!
+
+TESTS="LayoutTests/webgl/1.0.3/resources/webgl_test_files/conformance/*/*.html LayoutTests/css3/filters/regions-expanding.html LayoutTests/editing/caret/*.html"
+
+rmattr BEOS:TYPE $TESTS
+addattr -t mime BEOS:TYPE text/html $TESTS
diff --git a/Tools/haiku/webkit-buildloop.sh b/Tools/haiku/webkit-buildloop.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a72ad7445e65c071177074b49499bab7534921e6
--- /dev/null
+++ b/Tools/haiku/webkit-buildloop.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+
+cd /path/to/working/dir
+
+function build_webkit {
+	rm -r JavaScriptCore/DerivedSources
+	rm -r WebCore/DerivedSources
+	rm -r WebKitBuild
+	/bin/sh WebKitTools/haiku/make-generated-sources.sh > logs/buildlog_$1.log 2>&1
+	NDEBUG=1 jam -qj3 WebPositive >> logs/buildlog_$1.log 2>&1
+	if [ $? == 0 ]
+	then
+		cp WebKitBuild/Release/JavaScriptCore/libjavascriptcore.so package/WebPositive/lib
+		cp WebKitBuild/Release/WebCore/libwebcore.so package/WebPositive/lib
+		cp WebKitBuild/Release/WebKit/libwebkit.so package/WebPositive/lib
+		cp WebKitBuild/Release/WebKit/WebPositive package/WebPositive
+		cd package
+		zip -r WebPositive.zip WebPositive
+		cd ..
+		cp package/WebPositive.zip /Source/trac/webkit/htdocs/nightlies/WebPositive-r$1.zip
+		generate-index.sh /target/dir/nightlies http://base.url/
+	fi
+	cp logs/buildlog_$1.log /target/dir/buildlogs/buildlog_$1.txt
+	generate-index.sh /target/dir/buildlogs http://base.url/
+}
+
+while true
+do
+	oldRevision=$(svn info | grep Revision | cut -d" " -f 2)
+	svn update > /dev/null 2>&1
+	newRevision=$(svn info | grep Revision | cut -d" " -f 2)
+	if [ $oldRevision != $newRevision ]
+	then
+		build_webkit $newRevision
+	fi
+
+	sleep 60
+done
