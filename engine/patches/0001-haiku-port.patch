@@ -0,0 +1,252 @@
+#include "config.h"
+#if ENABLE(PDFJS)
+#include "PDFPrintingHaiku.h"
+
+#include "PrintInfo.h"
+#include <JavaScriptCore/JSLock.h>
+#include <WebCore/CommonVM.h>
+#include <WebCore/DOMWrapperWorld.h>
