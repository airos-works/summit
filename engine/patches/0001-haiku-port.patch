+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include "MPEGAudioParserHaiku.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace SummitMPEGAudio {
+namespace {
+constexpr size_t maximumBufferedBytes = 64 * 1024;
+constexpr size_t maximumFreeFrameBytes = 16 * 1024;
+
+uint32_t headerAt(const uint8_t* data)
+{
+    return uint32_t(data[0]) << 24 | uint32_t(data[1]) << 16 | uint32_t(data[2]) << 8 | data[3];
+}
+
+bool validMPEGHeader(uint32_t header)
+{
+    return (header & 0xffe00000) == 0xffe00000 && ((header >> 19) & 3) != 1
+        && ((header >> 17) & 3) && ((header >> 12) & 15) != 15 && ((header >> 10) & 3) != 3;
+}
+
+bool sameFreeFormat(uint32_t a, uint32_t b)
+{
+    return validMPEGHeader(b) && !((b >> 12) & 15) && !((a ^ b) & 0xfffe0c00);
+}
+}
+
+bool Parser::append(const uint8_t* bytes, size_t size)
+{
+    if (m_failed || (!bytes && size))
+        return false;
+    do {
+        if (m_offset) {
+            m_buffer.erase(m_buffer.begin(), m_buffer.begin() + m_offset);
+            m_offset = 0;
+        }
+        size_t count = std::min(size, maximumBufferedBytes - m_buffer.size());
+        if (count) {
+            m_buffer.insert(m_buffer.end(), bytes, bytes + count);
+            bytes += count;
+            size -= count;
+        }
+        Result result;
+        do {
+            result = parseOne();
+        } while (result == Result::Complete);
+        if (result == Result::Error || (m_buffer.size() == maximumBufferedBytes && !m_offset)) {
+            m_failed = true;
+            m_buffer.clear();
+            m_offset = 0;
+            return false;
+        }
+    } while (size);
+    return true;
+}
+
+void Parser::reset()
+{
+    m_buffer.clear();
+    m_offset = 0;
+    m_skipBytes = 0;
+    m_failed = false;
+    m_nextTimestamp = 0;
+    m_freeFormatFrameSize = 0;
+    // Keep the committed initialization, as SourceBuffer.abort() requires.
+}
+
+Parser::Result Parser::parseOne()
+{
+    size_t available = m_buffer.size() - m_offset;
+    if (m_skipBytes) {
+        size_t count = std::min<uint64_t>(m_skipBytes, available);
+        m_skipBytes -= count;
+        m_offset += count;
+        return count ? Result::Complete : Result::NeedMore;
+    }
+    if (available < 4)
+        return Result::NeedMore;
+    const auto* data = m_buffer.data() + m_offset;
+    if (!std::memcmp(data, "ID3", 3)) {
+        if (available < 10)
+            return Result::NeedMore;
+        if (data[3] < 2 || data[3] > 4 || data[4] == 255 || ((data[6] | data[7] | data[8] | data[9]) & 0x80))
+            return Result::Error;
+        m_skipBytes = (uint32_t(data[6]) << 21) | (uint32_t(data[7]) << 14) | (uint32_t(data[8]) << 7) | data[9];
+        if (data[3] == 4 && (data[5] & 0x10))
+            m_skipBytes += 10; // ID3v2.4 footer is outside the declared body.
+        m_offset += 10;
+        return Result::Complete;
+    }
+    if (!std::memcmp(data, "TAG", 3)) {
+        m_skipBytes = 128;
+        return Result::Complete;
+    }
+    if (!std::memcmp(data, "ICY ", 4)) {
+        static constexpr uint8_t end[] { '\r', '\n', '\r', '\n' };
+        auto* found = std::search(data + 4, data + available, std::begin(end), std::end(end));
+        if (found == data + available)
+            return Result::NeedMore;
+        m_offset += found - data + sizeof(end);
+        return Result::Complete;
+    }
+    SummitMP4::TrackInfo info;
+    info.id = 1;
+    info.kind = SummitMP4::TrackInfo::Kind::Audio;
+    info.packetTimedAudio = true;
+    size_t frameSize = 0;
+    uint32_t duration = 0;
+    auto result = m_format == Format::ADTS ? parseADTS(info, frameSize, duration) : parseMPEG(info, frameSize, duration);
+    if (result != Result::Complete)
+        return result;
+    // Low-rate Layer III frames can depend on several earlier bit reservoirs.
+    info.seekPreRoll = info.codec == "mp3" ? 500000000 : 80000000;
+    if (available < frameSize)
+        return Result::NeedMore;
+    __int128 timestamp = m_haveInit && info.timescale != m_track.timescale
+        ? __int128(m_nextTimestamp) * info.timescale / m_track.timescale : m_nextTimestamp;
+    if (timestamp > INT64_MAX - duration)
+        return Result::Error;
+    m_nextTimestamp = static_cast<int64_t>(timestamp);
+    emit(std::move(info), frameSize, duration);
+    m_offset += frameSize;
+    return Result::Complete;
+}
+
+Parser::Result Parser::parseADTS(SummitMP4::TrackInfo& info, size_t& frameSize, uint32_t& duration)
+{
+    size_t available = m_buffer.size() - m_offset;
+    const auto* data = m_buffer.data() + m_offset;
+    if (available < 7)
+        return Result::NeedMore;
+    if (data[0] != 255 || (data[1] & 0xf6) != 0xf0)
+        return Result::Error;
+    static constexpr uint32_t rates[] { 96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350 };
+    unsigned profile = (data[2] >> 6) + 1;
+    unsigned frequencyIndex = (data[2] >> 2) & 15;
+    unsigned channelConfig = ((data[2] & 1) << 2) | (data[3] >> 6);
+    // Channel configuration zero needs a Program Config Element in the AAC
+    // payload; do not guess its layout. Reserved/SSR profiles aren't claimed.
+    if (profile != 2 || frequencyIndex >= std::size(rates) || !channelConfig)
+        return Result::Error;
+    frameSize = ((data[3] & 3) << 11) | (data[4] << 3) | (data[5] >> 5);
+    size_t headerSize = data[1] & 1 ? 7 : 9;
+    if (frameSize <= headerSize)
+        return Result::Error;
+    duration = 1024 * ((data[6] & 3) + 1);
+    info.codec = "mp4a";
+    info.objectTypeIndication = data[1] & 8 ? 0x67 : 0x40;
+    info.sampleRate = info.timescale = rates[frequencyIndex];
+    info.channels = channelConfig == 7 ? 8 : channelConfig;
+    info.codecConfig = { uint8_t((profile << 3) | (frequencyIndex >> 1)), uint8_t((frequencyIndex << 7) | (channelConfig << 3)) };
+    return Result::Complete;
+}
+
+Parser::Result Parser::parseMPEG(SummitMP4::TrackInfo& info, size_t& frameSize, uint32_t& duration)
+{
+    const auto* data = m_buffer.data() + m_offset;
+    size_t available = m_buffer.size() - m_offset;
+    uint32_t header = headerAt(data);
+    if (!validMPEGHeader(header))
+        return Result::Error;
+    unsigned version = (header >> 19) & 3;
+    unsigned layer = 4 - ((header >> 17) & 3);
+    unsigned bitrateIndex = (header >> 12) & 15;
+    unsigned padding = (header >> 9) & 1;
+    static constexpr uint32_t baseRates[] { 44100, 48000, 32000 };
+    uint32_t rate = baseRates[(header >> 10) & 3] >> (version == 3 ? 0 : version == 2 ? 1 : 2);
+    static constexpr unsigned mpeg1Rates[3][15] {
+        { 0, 32, 64, 96, 128, 160, 192, 224, 256, 288, 320, 352, 384, 416, 448 },
+        { 0, 32, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384 },
+        { 0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320 }
+    };
+    static constexpr unsigned lowRateLayer1[] { 0, 32, 48, 56, 64, 80, 96, 112, 128, 144, 160, 176, 192, 224, 256 };
+    static constexpr unsigned lowRateLayer23[] { 0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160 };
+    unsigned bitrate = version == 3 ? mpeg1Rates[layer - 1][bitrateIndex] : layer == 1 ? lowRateLayer1[bitrateIndex] : lowRateLayer23[bitrateIndex];
+    size_t paddingBytes = layer == 1 ? padding * 4 : padding;
+    if (bitrate) {
+        if (layer == 1)
+            frameSize = (12 * bitrate * 1000 / rate) * 4 + paddingBytes;
+        else
+            frameSize = (layer == 3 && version != 3 ? 72 : 144) * bitrate * 1000 / rate + paddingBytes;
+        m_freeFormatFrameSize = 0;
+    } else {
+        if (!sameFreeFormat(m_freeFormatHeader, header))
+            m_freeFormatFrameSize = 0;
+        if (!m_freeFormatFrameSize) {
+            // Infer a free-format frame's size only after three matching
+            // headers, so a sync-like payload sequence cannot split a frame.
+            for (size_t offset = 4; offset + 4 <= available && offset <= maximumFreeFrameBytes; ++offset) {
+                uint32_t next = headerAt(data + offset);
+                if (!sameFreeFormat(header, next) || offset <= paddingBytes)
+                    continue;
+                size_t nextPadding = ((next >> 9) & 1) * (layer == 1 ? 4 : 1);
+                size_t third = offset * 2 - paddingBytes + nextPadding;
+                if (third + 4 > available)
+                    return Result::NeedMore;
+                if (!sameFreeFormat(header, headerAt(data + third)))
+                    continue;
+                m_freeFormatFrameSize = offset - paddingBytes;
+                m_freeFormatHeader = header;
+                break;
+            }
+            if (!m_freeFormatFrameSize)
+                return available >= maximumFreeFrameBytes * 2 + 4 ? Result::Error : Result::NeedMore;
+        }
+        frameSize = m_freeFormatFrameSize + paddingBytes;
+    }
+    if (frameSize < 4 || frameSize > maximumFreeFrameBytes)
+        return Result::Error;
+    duration = layer == 1 ? 384 : layer == 3 && version != 3 ? 576 : 1152;
+    info.codec = layer == 1 ? "mp1" : layer == 2 ? "mp2" : "mp3";
+    info.sampleRate = info.timescale = rate;
+    info.channels = ((header >> 6) & 3) == 3 ? 1 : 2;
+    return Result::Complete;
+}
+
+void Parser::emit(SummitMP4::TrackInfo&& info, size_t frameSize, uint32_t duration)
+{
+    if (!m_haveInit || info.codec != m_track.codec || info.sampleRate != m_track.sampleRate
+        || info.channels != m_track.channels || info.codecConfig != m_track.codecConfig || info.objectTypeIndication != m_track.objectTypeIndication) {
+        m_track = std::move(info);
+        m_haveInit = true;
+        SummitMP4::InitSegment init;
+        init.movieTimescale = m_track.timescale;
+        init.tracks.push_back(m_track);
+        if (onInitSegment)
+            onInitSegment(std::move(init));
+    }
+    SummitMP4::Sample sample;
+    sample.trackID = 1;
+    sample.isSync = true;
+    sample.decodeTime = sample.presentationTime = m_nextTimestamp;
+    sample.duration = duration;
+    sample.data.assign(m_buffer.begin() + m_offset, m_buffer.begin() + m_offset + frameSize);
+    m_nextTimestamp += duration;
+    if (onSample)
+        onSample(std::move(sample));
+}
+
+} // namespace SummitMPEGAudio
