@@ -0,0 +1,332 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+// A HID report descriptor parser for WebHID (HID 1.11, section 6.2.2). It has
+// no platform dependencies so that it can be tested on its own. Descriptors
+// come from devices: every count and depth is bounded.
+
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace WebKit::HIDHaiku {
+
+struct ReportItem {
+    bool isAbsolute { true };
+    bool isArray { false };
+    bool isBufferedBytes { false };
+    bool isConstant { false };
+    bool isLinear { true };
+    bool isRange { false };
+    bool isVolatile { false };
+    bool hasNull { false };
+    bool hasPreferredState { true };
+    bool wrap { false };
+    std::vector<uint32_t> usages;
+    uint32_t usageMinimum { 0 };
+    uint32_t usageMaximum { 0 };
+    uint16_t reportSize { 0 };
+    uint16_t reportCount { 0 };
+    int8_t unitExponent { 0 };
+    uint8_t unitSystem { 0 };
+    // Length, mass, time, temperature, current, luminous intensity.
+    int8_t unitFactors[6] { };
+    int32_t logicalMinimum { 0 };
+    int32_t logicalMaximum { 0 };
+    int32_t physicalMinimum { 0 };
+    int32_t physicalMaximum { 0 };
+};
+
+struct Report {
+    uint8_t id { 0 };
+    std::vector<ReportItem> items;
+};
+
+struct Collection {
+    uint16_t usagePage { 0 };
+    uint16_t usage { 0 };
+    uint8_t type { 0 };
+    std::vector<Collection> children;
+    std::vector<Report> inputReports;
+    std::vector<Report> outputReports;
+    std::vector<Report> featureReports;
+};
+
+enum class ReportType : uint8_t { Input, Output, Feature };
+
+struct Descriptor {
+    // The top-level collections.
+    std::vector<Collection> collections;
+    bool usesReportIds { false };
+    // Report lengths in bits, by type and report ID.
+    std::map<std::pair<ReportType, uint8_t>, uint32_t> reportBits;
+
+    // Bytes of a report without its report ID prefix, or nullopt if the
+    // descriptor does not define it.
+    std::optional<size_t> reportLength(ReportType type, uint8_t id) const
+    {
+        auto found = reportBits.find({ type, id });
+        if (found == reportBits.end())
+            return std::nullopt;
+        return (found->second + 7) / 8;
+    }
+    size_t maximumReportLength(ReportType type) const
+    {
+        size_t result = 0;
+        for (auto& [key, bits] : reportBits) {
+            if (key.first == type)
+                result = std::max<size_t>(result, (bits + 7) / 8);
+        }
+        return result;
+    }
+};
+
+namespace Detail {
+
+constexpr unsigned maximumDepth = 32;
+constexpr unsigned maximumItems = 8192;
+constexpr unsigned maximumUsages = 1024;
+constexpr unsigned maximumGlobalStack = 16;
+constexpr uint32_t maximumReportBits = 65536 * 8;
+
+struct GlobalState {
+    uint16_t usagePage { 0 };
+    int32_t logicalMinimum { 0 };
+    int32_t logicalMaximum { 0 };
+    int32_t physicalMinimum { 0 };
+    int32_t physicalMaximum { 0 };
+    int8_t unitExponent { 0 };
+    uint32_t unit { 0 };
+    uint16_t reportSize { 0 };
+    uint8_t reportId { 0 };
+    uint16_t reportCount { 0 };
+};
+
+struct LocalState {
+    std::vector<uint32_t> usages;
+    std::optional<uint32_t> usageMinimum;
+    std::optional<uint32_t> usageMaximum;
+};
+
+inline uint32_t unsignedValue(std::span<const uint8_t> data)
+{
+    uint32_t value = 0;
+    for (size_t i = 0; i < data.size(); ++i)
+        value |= uint32_t(data[i]) << (8 * i);
+    return value;
+}
+
+inline int32_t signedValue(std::span<const uint8_t> data)
+{
+    uint32_t value = unsignedValue(data);
+    switch (data.size()) {
+    case 1: return int8_t(value);
+    case 2: return int16_t(value);
+    case 4: return int32_t(value);
+    default: return 0;
+    }
+}
+
+inline uint32_t extendedUsage(std::span<const uint8_t> data, uint16_t page)
+{
+    uint32_t value = unsignedValue(data);
+    // A four-byte usage carries its own usage page.
+    return data.size() == 4 ? value : (uint32_t(page) << 16) | (value & 0xffff);
+}
+
+inline int8_t nibble(uint32_t value, unsigned index)
+{
+    int8_t result = (value >> (index * 4)) & 15;
+    return result > 7 ? result - 16 : result;
+}
+
+inline void addReport(std::vector<Report>& reports, uint8_t id, ReportItem&& item)
+{
+    auto found = std::find_if(reports.begin(), reports.end(), [&](auto& report) { return report.id == id; });
+    if (found == reports.end()) {
+        reports.push_back({ id, { } });
+        found = reports.end() - 1;
+    }
+    found->items.push_back(std::move(item));
+}
+
+} // namespace Detail
+
+inline std::optional<Descriptor> parseReportDescriptor(std::span<const uint8_t> bytes)
+{
+    using namespace Detail;
+    if (bytes.empty() || bytes.size() > 65536)
+        return std::nullopt;
+    Descriptor descriptor;
+    GlobalState global;
+    std::vector<GlobalState> globalStack;
+    LocalState local;
+    // The innermost open collection is the last; the outermost the first.
+    std::vector<Collection> open;
+    unsigned items = 0;
+    size_t position = 0;
+    while (position < bytes.size()) {
+        if (++items > maximumItems)
+            return std::nullopt;
+        uint8_t prefix = bytes[position++];
+        if (prefix == 0xfe) {
+            // A long item: no long item tags are defined, skip its data.
+            if (position + 2 > bytes.size())
+                return std::nullopt;
+            size_t size = bytes[position];
+            position += 2 + size;
+            if (position > bytes.size())
+                return std::nullopt;
+            continue;
+        }
+        static constexpr size_t sizes[] = { 0, 1, 2, 4 };
+        size_t size = sizes[prefix & 3];
+        if (position + size > bytes.size())
+            return std::nullopt;
+        auto data = bytes.subspan(position, size);
+        position += size;
+        uint8_t type = (prefix >> 2) & 3;
+        uint8_t tag = prefix >> 4;
+        if (type == 0) {
+            // Main items.
+            if (tag == 0x8 || tag == 0x9 || tag == 0xb) {
+                if (open.empty())
+                    return std::nullopt;
+                uint32_t flags = unsignedValue(data);
+                ReportItem item;
+                item.isConstant = flags & 1;
+                item.isArray = !(flags & 2);
+                item.isAbsolute = !(flags & 4);
+                item.wrap = flags & 8;
+                item.isLinear = !(flags & 16);
+                item.hasPreferredState = !(flags & 32);
+                item.hasNull = flags & 64;
+                item.isVolatile = tag != 0x8 && (flags & 128);
+                item.isBufferedBytes = flags & 256;
+                if (local.usageMinimum && local.usageMaximum) {
+                    item.isRange = true;
+                    item.usageMinimum = *local.usageMinimum;
+                    item.usageMaximum = *local.usageMaximum;
+                } else
+                    item.usages = local.usages;
+                item.reportSize = global.reportSize;
+                item.reportCount = global.reportCount;
+                item.unitExponent = global.unitExponent;
+                item.unitSystem = global.unit & 15;
+                for (unsigned i = 0; i < 6; ++i)
+                    item.unitFactors[i] = nibble(global.unit, i + 1);
+                item.logicalMinimum = global.logicalMinimum;
+                item.logicalMaximum = global.logicalMaximum;
+                item.physicalMinimum = global.physicalMinimum;
+                item.physicalMaximum = global.physicalMaximum;
+                auto reportType = tag == 0x8 ? ReportType::Input : tag == 0x9 ? ReportType::Output : ReportType::Feature;
+                auto& bits = descriptor.reportBits[{ reportType, global.reportId }];
+                bits += uint32_t(global.reportSize) * global.reportCount;
+                if (bits > maximumReportBits)
+                    return std::nullopt;
+                auto& collection = open.back();
+                auto& reports = reportType == ReportType::Input ? collection.inputReports
+                    : reportType == ReportType::Output ? collection.outputReports : collection.featureReports;
+                addReport(reports, global.reportId, std::move(item));
+            } else if (tag == 0xa) {
+                if (open.size() >= maximumDepth)
+                    return std::nullopt;
+                Collection collection;
+                uint32_t usage = !local.usages.empty() ? local.usages.front()
+                    : local.usageMinimum ? *local.usageMinimum : uint32_t(global.usagePage) << 16;
+                collection.usagePage = usage >> 16;
+                collection.usage = usage & 0xffff;
+                collection.type = unsignedValue(data);
+                open.push_back(std::move(collection));
+            } else if (tag == 0xc) {
+                if (open.empty())
+                    return std::nullopt;
+                auto collection = std::move(open.back());
+                open.pop_back();
+                if (open.empty())
+                    descriptor.collections.push_back(std::move(collection));
+                else
+                    open.back().children.push_back(std::move(collection));
+            }
+            local = { };
+        } else if (type == 1) {
+            // Global items.
+            switch (tag) {
+            case 0x0: global.usagePage = unsignedValue(data); break;
+            case 0x1: global.logicalMinimum = signedValue(data); break;
+            case 0x2: global.logicalMaximum = signedValue(data); break;
+            case 0x3: global.physicalMinimum = signedValue(data); break;
+            case 0x4: global.physicalMaximum = signedValue(data); break;
+            case 0x5: global.unitExponent = nibble(unsignedValue(data), 0); break;
+            case 0x6: global.unit = unsignedValue(data); break;
+            case 0x7: global.reportSize = std::min<uint32_t>(unsignedValue(data), 0xffff); break;
+            case 0x8:
+                global.reportId = unsignedValue(data);
+                if (!global.reportId)
+                    return std::nullopt;
+                descriptor.usesReportIds = true;
+                break;
+            case 0x9: global.reportCount = std::min<uint32_t>(unsignedValue(data), 0xffff); break;
+            case 0xa:
+                if (globalStack.size() >= maximumGlobalStack)
+                    return std::nullopt;
+                globalStack.push_back(global);
+                break;
+            case 0xb:
+                if (globalStack.empty())
+                    return std::nullopt;
+                global = globalStack.back();
+                globalStack.pop_back();
+                break;
+            default: break;
+            }
+        } else if (type == 2) {
+            // Local items. Designators, strings and delimiters are not exposed.
+            switch (tag) {
+            case 0x0:
+                if (local.usages.size() >= maximumUsages)
+                    return std::nullopt;
+                local.usages.push_back(extendedUsage(data, global.usagePage));
+                break;
+            case 0x1: local.usageMinimum = extendedUsage(data, global.usagePage); break;
+            case 0x2: local.usageMaximum = extendedUsage(data, global.usagePage); break;
+            default: break;
+            }
+        } else
+            return std::nullopt;
+    }
+    // Tolerate a missing final End Collection, as other hosts do.
+    while (!open.empty()) {
+        auto collection = std::move(open.back());
+        open.pop_back();
+        if (open.empty())
+            descriptor.collections.push_back(std::move(collection));
+        else
+            open.back().children.push_back(std::move(collection));
+    }
+    if (descriptor.collections.empty())
+        return std::nullopt;
+    return descriptor;
+}
+
+// Whether a web page may use this interface. Keyboards, pointers and
+// security keys are protected by WebHID. Haiku's usb_hid driver also reads
+// every interface it has a protocol handler for (generic desktop, keyboard,
+// consumer and digitizer collections) and the raw USB driver cannot reserve
+// an interface against it: input reports would be split between the two.
+inline bool protectedUsagePage(uint16_t page)
+{
+    return page == 0x01 || page == 0x07 || page == 0x0c || page == 0x0d || page == 0xf1d0;
+}
+
+inline bool eligible(const Descriptor& descriptor)
+{
+    return !descriptor.collections.empty() && std::none_of(descriptor.collections.begin(), descriptor.collections.end(),
+        [](auto& collection) { return protectedUsagePage(collection.usagePage); });
+}
+
+} // namespace WebKit::HIDHaiku
