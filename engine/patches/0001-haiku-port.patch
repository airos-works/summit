+void MediaPlayerPrivateHaikuMSE::load(const String& source)
+{
+    Ref protectedThis { *this };
+    cancelLoad();
+    m_dash = nullptr;
+    m_mediaSourcePrivate = nullptr;
+    m_dashConfigurations = { };
+    m_dashReadyState = MediaPlayer::ReadyState::HaveNothing;
+    m_dashAnnouncedMetadata = false;
+    m_dashReportedEnd = 0;
+    m_dashSeekableStart = m_dashSeekableEnd = -1;
+    m_naturalSize = { };
+    m_announcedFirstFrame = false;
+    RefPtr player = m_player.get();
+    if (!player) return;
+    m_dashLoader = DashResourceLoaderHaiku::create(player->mediaResourceLoader(), [weakThis = WeakPtr { *this }](uint64_t identifier, bool success, auto&& data, auto&& url, double elapsed) {
+        RefPtr self = weakThis.get();
+        if (!self || !self->m_dash) return;
+        if (success) self->m_dash->complete(identifier, WTF::move(data), url, elapsed);
+        else self->m_dash->failed(identifier);
+    });
+    SummitDASH::Player::Hooks hooks;
+    hooks.request = [this](uint64_t id, const auto& resource, size_t limit) { m_dashLoader->request(id, resource, limit); };
+    hooks.cancel = [this](uint64_t id) { if (m_dashLoader) m_dashLoader->cancel(id); };
+    hooks.supports = [](const SummitDASH::Representation& representation) {
+        if (representation.mimeType.empty()) return false;
+#if !ENABLE(ENCRYPTED_MEDIA)
+        if (representation.encrypted) return false;
+#endif
+        auto type = representation.mimeType + "; codecs=\"" + representation.codecs + "\"";
+        MediaEngineSupportParameters parameters { .platformType = PlatformMediaDecodingType::MediaSource,
+            .type = ContentType { String::fromUTF8(type.c_str()) } };
+        return supportsType(parameters) != MediaPlayer::SupportsType::IsNotSupported;
+    };
+#if ENABLE(ENCRYPTED_MEDIA)
+    hooks.protectionSystemHeaders = [this](std::vector<uint8_t>&& headers) { initializationDataEncountered(WTF::move(headers)); };
+#endif
+    hooks.canEnqueue = [this](unsigned track) { return track ? audioRenderer().isReadyForMore() : videoRenderer().isReadyForMore(); };
+    hooks.enqueue = [this](unsigned track, const auto& configuration, auto&& sample, double offset) {
+        enqueueDashSample(track, configuration, WTF::move(sample), offset);
+    };
+    hooks.endTrack = [this](unsigned track) { if (track) audioRenderer().setEndOfStream(); else videoRenderer().setEndOfStream(); };
+    hooks.reset = [this](double position) { dashReset(position); };
+    hooks.changed = [this] { dashChanged(); };
+    hooks.error = [this](const std::string& error, bool network) {
+        MSE_TRACE("DASH failed: %s\n", error.c_str());
+        m_clock.stop();
+        if (m_audioRenderer) m_audioRenderer->setPlaying(false);
+        if (auto promise = std::exchange(m_seekPromise, std::nullopt)) promise->reject(network ? PlatformMediaError::NetworkError : PlatformMediaError::ParsingError);
+        m_pendingSeek.reset();
+        setNetworkState(network ? MediaPlayer::NetworkState::NetworkError : MediaPlayer::NetworkState::FormatError);
+        dashChanged();
+    };
+    m_dash = std::make_unique<SummitDASH::Player>(WTF::move(hooks));
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    m_dash->start(source.utf8().legacyCStringPointer(), WallTime::now().secondsSinceEpoch().value(), MonotonicTime::now().secondsSinceEpoch().value());
+    updatePlaybackState();
+}
+
+void MediaPlayerPrivateHaikuMSE::dashReset(double position)
+{
+    m_clock.stop();
+    m_clock.set(toMicroseconds(MediaTime::createWithDouble(position)));
+    m_dashDecodeTarget = position;
+    if (m_dash && !m_dash->isLive() && position >= m_dash->duration())
+        m_dashDecodeTarget = std::max(0.0, m_dash->duration() - 0.001);
+    if (m_videoRenderer) m_videoRenderer->flush();
+    if (m_audioRenderer) { m_audioRenderer->setPlaying(false); m_audioRenderer->flush(); }
+    m_reachedEnd = false;
+    m_prerollStartedAt = { };
+}
+
+void MediaPlayerPrivateHaikuMSE::enqueueDashSample(unsigned track, const SummitMP4::TrackInfo& info, SummitMP4::Sample&& sample, double offset)
+{
+    auto& configuration = m_dashConfigurations[track];
+    if (!configuration || !sameDecoding(configuration->info, info)) {
+        configuration = HaikuTrackConfiguration::create(info);
+        MSE_TRACE("DASH configuration %s %ux%u %u Hz\n", info.codec.c_str(), info.width, info.height, info.sampleRate);
+    }
+    auto presentation = MediaTime(sample.presentationTime, info.timescale) + MediaTime::createWithDouble(offset);
+    auto decode = MediaTime(sample.decodeTime, info.timescale) + MediaTime::createWithDouble(offset);
+    auto duration = MediaTime(sample.duration, info.timescale);
+    auto flags = sample.isSync ? MediaSample::IsSync : MediaSample::None;
+    if (!track && (presentation + duration).toDouble() <= m_dashDecodeTarget) flags = static_cast<MediaSample::SampleFlags>(flags | MediaSample::IsNonDisplaying);
+    auto nativeSample = MediaSampleHaiku::create(HaikuSampleData::create(WTF::move(sample.data), WTF::move(sample.encryption)), Ref { *configuration },
+        sample.trackID, presentation, decode, duration, flags);
+    if (track) audioRenderer().enqueue(WTF::move(nativeSample));
+    else videoRenderer().enqueue(WTF::move(nativeSample));
+}
+
+void MediaPlayerPrivateHaikuMSE::dashChanged()
+{
+    if (!m_dash) return;
+    Ref protectedThis { *this };
+    RefPtr player = m_player.get();
+    if (!player) return;
+    if (m_dash->hasMetadata() && !m_dashAnnouncedMetadata) {
+        m_dashAnnouncedMetadata = true;
+        player->characteristicChanged();
+    }
+    updateDuration(MediaTime::createWithDouble(m_dash->duration()));
+    auto ready = MediaPlayer::ReadyState::HaveNothing;
+    if (m_dash->hasMetadata() && !m_dash->isStopped()) {
+        ready = MediaPlayer::ReadyState::HaveMetadata;
+        if (m_dash->hasCurrentData() && (!hasVideo() || (m_videoRenderer && m_videoRenderer->hasFrameSinceFlush()))) {
+            auto available = m_dash->bufferedEnd() - currentTime().toDouble();
+            ready = m_dash->hasEnded() || available >= 3 ? MediaPlayer::ReadyState::HaveEnoughData
+                : available >= 0.1 ? MediaPlayer::ReadyState::HaveFutureData : MediaPlayer::ReadyState::HaveCurrentData;
+            if (m_pendingSeek) {
+                auto time = m_pendingSeek->time;
+                m_pendingSeek.reset();
+                if (auto promise = std::exchange(m_seekPromise, std::nullopt)) promise->resolve(time);
+            }
+        }
+    }
+    if (m_dashReadyState != ready) { m_dashReadyState = ready; player->readyStateChanged(); }
+    if (m_dashReportedEnd != m_dash->bufferedEnd()) { m_dashReportedEnd = m_dash->bufferedEnd(); m_dashLoadingProgress = true; }
+    if (m_dashSeekableStart != m_dash->seekableStart() || m_dashSeekableEnd != m_dash->seekableEnd()) {
+        m_dashSeekableStart = m_dash->seekableStart(); m_dashSeekableEnd = m_dash->seekableEnd();
+        player->seekableTimeRangesChanged();
+    }
+    if (m_dash->hasEnded()) setNetworkState(MediaPlayer::NetworkState::Loaded);
+    updatePlaybackState();
+}
+
+void MediaPlayerPrivateHaikuMSE::load(const URL&, const LoadOptions&, MediaSourcePrivateClient& client)
+{
+    MSE_TRACE("load player=%p\n", this);
+    if (m_dash) { cancelLoad(); m_dash = nullptr; m_dashLoader = nullptr; }
+    if (RefPtr mediaSourcePrivate = dynamicDowncast<MediaSourcePrivateHaiku>(client.mediaSourcePrivate())) {
+        mediaSourcePrivate->setPlayer(this);
+        m_mediaSourcePrivate = WTF::move(mediaSourcePrivate);
+        client.reOpen();
+    } else
+        m_mediaSourcePrivate = MediaSourcePrivateHaiku::create(*this, client);
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+}
+
+void MediaPlayerPrivateHaikuMSE::cancelLoad()
+{
+    if (m_dash) {
+        m_dash->stop();
+        if (m_videoRenderer) m_videoRenderer->flush();
+        if (m_audioRenderer) m_audioRenderer->flush();
+        m_pendingSeek.reset();
+        if (auto promise = std::exchange(m_seekPromise, std::nullopt)) promise->reject(PlatformMediaError::Cancelled);
+    }
+    m_playbackTimer.stop();
+    m_clock.stop();
