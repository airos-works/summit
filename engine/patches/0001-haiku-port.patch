--- /dev/null
+++ b/Source/WebKit/UIProcess/API/haiku/WebKitView.cpp
@@ -0,0 +1,1467 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "WebKitView.h"
+#include <Path.h>
+#include <Directory.h>
+#include <File.h>
+#include <NodeInfo.h>
+#include <String.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <cerrno>
+#include <unistd.h>
+#include <Entry.h>
+
