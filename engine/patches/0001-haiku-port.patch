@@ -0,0 +1,50 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "JSWebExtensionAPIBookmarksHaiku.h"
+#include "WebExtensionAPIEvent.h"
+#include "WebExtensionAPIObject.h"
+#include <wtf/JSONValues.h>
+
+namespace WebKit {
+
+// chrome.bookmarks. Every call becomes one BookmarksQueryHaiku message, which
+// the UI process forwards to the host browser as a BOOKMARKS browser command;
+// the host answers with JSON (BWebKitContext::RespondToBrowserCommandWithData).
+class WebExtensionAPIBookmarksHaiku : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPIBookmarksHaiku, bookmarksHaiku, bookmarks);
+
+public:
+    void get(const String& idOrIdListJSON, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getChildren(const String& id, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getRecent(double numberOfItems, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getTree(Ref<WebExtensionCallbackHandler>&&);
+    void getSubTree(const String& id, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void search(const String& queryJSON, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void create(RefPtr<JSON::Value> bookmark, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void move(const String& id, RefPtr<JSON::Value> destination, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void update(const String& id, RefPtr<JSON::Value> changes, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void remove(const String& id, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void removeTree(const String& id, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+
+    WebExtensionAPIEvent& onCreated();
+    WebExtensionAPIEvent& onRemoved();
+    WebExtensionAPIEvent& onChanged();
+    WebExtensionAPIEvent& onMoved();
+
+private:
+    void query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&&);
+
+    RefPtr<WebExtensionAPIEvent> m_onCreated;
+    RefPtr<WebExtensionAPIEvent> m_onRemoved;
+    RefPtr<WebExtensionAPIEvent> m_onChanged;
+    RefPtr<WebExtensionAPIEvent> m_onMoved;
+};
+
+} // namespace WebKit
+
+SPECIALIZE_TYPE_TRAITS_WEB_EXTENSION(WebExtensionAPIBookmarksHaiku, bookmarksHaiku);
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
diff --git a/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBrowsingData.cpp b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBrowsingData.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bfcdd883e69b354fb2e1524b9ee87d979f280f67
--- /dev/null
+++ b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBrowsingData.cpp
@@ -0,0 +1,139 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPIBrowsingData.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+#include <wtf/URL.h>
+
+namespace WebKit {
+
+// Chrome's DataTypeSet, and Firefox's extra member.
+static constexpr std::array dataTypes { "appcache"_s, "cache"_s, "cacheStorage"_s, "cookies"_s, "downloads"_s, "fileSystems"_s,
+    "formData"_s, "history"_s, "indexedDB"_s, "localStorage"_s, "passwords"_s, "pluginData"_s, "serverBoundCertificates"_s,
+    "serviceWorkers"_s, "webSQL"_s };
+
+// The hosts of a list of origins (Chrome) or host names (Firefox).
+static RefPtr<JSON::Array> hostList(const JSON::Object& options, ASCIILiteral key, bool origins, String& exception)
+{
+    RefPtr value = options.getValue(key);
+    if (!value)
+        return nullptr;
+    RefPtr array = value->asArray();
+    if (!array || !array->length()) {
+        exception = toErrorString(nullString(), key, "a non-empty array of strings is expected"_s);
+        return nullptr;
+    }
+    Ref hosts = JSON::Array::create();
+    for (auto& item : *array) {
+        auto text = item->asString();
+        String host = origins ? URL { text }.host().toString() : text;
+        if (host.isEmpty() || (origins && !URL { text }.protocolIsInHTTPFamily())) {
+            exception = toErrorString(nullString(), key, origins ? "it must contain http or https origins"_s : "it must contain host names"_s);
+            return nullptr;
+        }
+        hosts->pushString(host.convertToASCIILowercase());
+    }
+    return hosts;
+}
+
+void WebExtensionAPIBrowsingData::remove(RefPtr<JSON::Value> options, RefPtr<JSON::Value> dataToRemove, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = dataToRemove ? dataToRemove->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), "dataToRemove"_s, "an object is expected"_s);
+        return;
+    }
+    Ref types = JSON::Array::create();
+    for (auto& [key, value] : *object) {
+        if (std::ranges::find(dataTypes, key) == dataTypes.end()) {
+            exception = toErrorString(nullString(), "dataToRemove"_s, "it has an unknown data type"_s);
+            return;
+        }
+        if (value->asBoolean().value_or(false))
+            types->pushString(key);
+    }
+    removeTypes(WTF::move(options), WTF::move(types), WTF::move(callback), exception);
+}
+
+void WebExtensionAPIBrowsingData::removeType(RefPtr<JSON::Value> options, ASCIILiteral type, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    Ref types = JSON::Array::create();
+    types->pushString(type);
+    removeTypes(WTF::move(options), WTF::move(types), WTF::move(callback), exception);
+}
+
+void WebExtensionAPIBrowsingData::removeTypes(RefPtr<JSON::Value> options, Ref<JSON::Array>&& types, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = options ? options->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), "options"_s, "an object is expected"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    double since = 0;
+    if (RefPtr value = object->getValue("since"_s)) {
+        auto number = value->asDouble();
+        if (!number || !std::isfinite(*number) || *number < 0) {
+            exception = toErrorString(nullString(), "since"_s, "a non-negative number is expected"_s);
+            return;
+        }
+        since = *number;
+    }
+    arguments->setDouble("since"_s, since);
+    RefPtr origins = hostList(*object, "origins"_s, true, exception);
+    if (!exception.isEmpty())
+        return;
+    RefPtr hostnames = hostList(*object, "hostnames"_s, false, exception);
+    if (!exception.isEmpty())
+        return;
+    RefPtr excluded = hostList(*object, "excludeOrigins"_s, true, exception);
+    if (!exception.isEmpty())
+        return;
+    if (excluded && (origins || hostnames)) {
+        exception = toErrorString(nullString(), "options"_s, "'origins' and 'excludeOrigins' cannot both be given"_s);
+        return;
+    }
+    if (origins && hostnames) {
+        for (auto& host : *hostnames)
+            origins->pushValue(host.copyRef());
+    }
+    if (RefPtr hosts = origins ? origins : hostnames)
+        arguments->setArray("hosts"_s, hosts.releaseNonNull());
+    if (excluded)
+        arguments->setArray("excludeHosts"_s, excluded.releaseNonNull());
+    arguments->setArray("types"_s, WTF::move(types));
+    query("remove"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBrowsingData::settings(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    query("settings"_s, JSON::Object::create(), WTF::move(callback));
+}
+
+void WebExtensionAPIBrowsingData::query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::BrowsingDataQueryHaiku(method, arguments->toJSONString()),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isEmpty() || *result == "null"_s) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
