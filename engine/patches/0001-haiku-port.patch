+static void* backBufferMappingHaiku(area_id source)
+{
+    static NeverDestroyed<std::mutex> lock;
+    static NeverDestroyed<HashMap<area_id, void*>> mappings;
+    if (source < 0 || backBufferImportFailedHaiku)
+        return nullptr;
