diff --git a/Source/WebKit/Shared/haiku/DirectPresentHaiku.h b/Source/WebKit/Shared/haiku/DirectPresentHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..ccf742682b96c829d26b231a37510f661d61ee08
--- /dev/null
+++ b/Source/WebKit/Shared/haiku/DirectPresentHaiku.h
@@ -0,0 +1,55 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <OS.h>
+#include <atomic>
+#include <cstdint>
+
+namespace WebKit {
+
+// A page presented straight into the screen. A window with
+// B_DIRECT_DEVICE_PIXELS learns where it is on the screen in frame buffer
+// pixels and which parts of it are visible; the web process then copies each
+// composited frame there with the GPU (Summit's Mesa patch 06) instead of
+// reading it back for app_server to copy twice more. At 200 percent that read
+// was about 10 ms of every frame.
+//
+// One page of memory per web view, made by the UI process and cloned by the
+// web process. The UI process changes it holding `lock`, and waits there
+// until the GPU has finished every copy already made, so nothing lands in a
+// rectangle the window no longer owns; the web process presents holding the
+// same lock.
+struct DirectPresentStateHaiku {
+    static constexpr uint32_t magicValue = 0x53445052; // 'SDPR'
+    static constexpr uint32_t maximumRects = 200;
+
+    uint32_t magic;
+    sem_id lock;
+
+    // Written by the UI process.
+    uint32_t generation; // a new value whenever anything below changes
+    uint32_t enabled;
+    // The page's top left pixel, in the frame buffer.
+    int32_t originX;
+    int32_t originY;
+    uint32_t frontBytesPerRow;
+    // app_server's own copy of the screen, which the copies must keep current.
+    area_id backArea;
+    uint32_t backBytesPerRow;
+    uint32_t backWidth;
+    uint32_t backHeight;
+    // The page's visible parts: left, top, right, bottom in frame buffer
+    // pixels, both edges included.
+    uint32_t rectCount;
+    int32_t rects[maximumRects * 4];
+
+    // Written by the web process.
+    std::atomic<int32_t> inFlight; // copies the GPU has not finished
+    std::atomic<uint32_t> presentedGeneration;
+    std::atomic<uint32_t> presents;
+};
+
+static_assert(sizeof(DirectPresentStateHaiku) <= B_PAGE_SIZE);
+static_assert(std::atomic<int32_t>::is_always_lock_free && std::atomic<uint32_t>::is_always_lock_free);
+
+} // namespace WebKit
diff --git a/Source/WebKit/Shared/haiku/DownloadFilenameHaiku.h b/Source/WebKit/Shared/haiku/DownloadFilenameHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..ffd9b2ccd7a6dbd801ac9eb70f934a2b7e2945bf
--- /dev/null
+++ b/Source/WebKit/Shared/haiku/DownloadFilenameHaiku.h
@@ -0,0 +1,51 @@
+/*
+ * Copyright (c) 2026 KunanyiOS contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <StorageDefs.h>
+#include <String.h>
+#include <algorithm>
+
+namespace WebKit {
+
+inline BString sanitizedDownloadFilename(const BString& suggested)
+{
+    BString name = suggested;
+    int32 separator = std::max(name.FindLast('/'), name.FindLast('\\'));
+    if (separator >= 0)
+        name.Remove(0, separator + 1);
+    for (int32 i = 0; i < name.Length(); ++i) {
+        unsigned char byte = name.ByteAt(i);
+        if (byte < 32 || byte == 127)
+            name.SetByteAt(i, '_');
+    }
+    name.Trim();
+
+    // Leave room for a collision counter, and never split a UTF-8 character.
+    constexpr int32 maximumLength = B_FILE_NAME_LENGTH - 1 - 12;
+    if (name.Length() > maximumLength) {
+        int32 length = maximumLength;
+        while (length && (static_cast<unsigned char>(name.ByteAt(length)) & 0xc0) == 0x80)
+            --length;
+        name.Truncate(length);
+    }
+    if (name.IsEmpty() || name == "." || name == "..")
+        return BString("Download");
+    return name;
+}
+
+inline BString downloadFilenameWithCounter(const BString& sanitizedName, uint32 counter)
+{
+    BString base = sanitizedName;
+    BString extension;
+    int32 extensionStart = base.FindLast('.');
+    if (extensionStart > 0)
+        base.MoveInto(extension, extensionStart, base.Length() - extensionStart);
+    base << "-" << counter;
+    return base.Append(extension);
+}
+
+} // namespace WebKit
