index 0000000000000000000000000000000000000000..8bb3904715f57aafec27fd7d4fa3c441788957d7
--- /dev/null
+++ b/Source/WebCore/platform/graphics/haiku/DashPlaybackHaiku.h
@@ -0,0 +1,80 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "DashManifestHaiku.h"
+#include "FragmentedMP4ParserHaiku.h"
+#include <array>
+#include <deque>
+#include <functional>
+#include <map>
+#include <memory>
+
+namespace SummitDASH {
+// Main-thread state machine. The native adapter uses WebCore media resources
+// for transport and the existing Media Kit renderers for sample delivery.
+// Transport callbacks must be asynchronous; no callback may destroy Player.
+class Player {
+public:
+    struct Hooks {
+        std::function<void(uint64_t, const Resource&, size_t)> request;
+        std::function<void(uint64_t)> cancel;
+        std::function<bool(const Representation&)> supports;
+        std::function<bool(unsigned)> canEnqueue;
+        std::function<void(unsigned, const SummitMP4::TrackInfo&, SummitMP4::Sample&&, double)> enqueue;
+        std::function<void(unsigned)> endTrack;
+        std::function<void(double)> reset;
+        std::function<void()> changed;
+        std::function<void(const std::string&, bool)> error;
+        std::function<void(std::vector<uint8_t>&&)> protectionSystemHeaders { };
+    };
+    explicit Player(Hooks);
+    ~Player();
+    void start(const std::string& url, double nowUTC, double monotonicTime);
+    void stop();
+    void seek(double time);
+    void tick(double mediaTime, double monotonicTime);
+    void complete(uint64_t request, std::vector<uint8_t>, const std::string& finalURL, double elapsedSeconds);
+    void failed(uint64_t request);
+    bool isStopped() const { return m_stopped; }
+    bool hasMetadata() const { return bool(m_manifest); }
+    bool hasVideo() const { return m_tracks[0].enabled; }
+    bool hasAudio() const { return m_tracks[1].enabled; }
+    bool isLive() const { return m_manifest && m_manifest->dynamic; }
+    bool hasEnded() const;
+    bool hasCurrentData() const;
+    double duration() const;
+    double seekableStart() const;
+    double seekableEnd() const;
+    double bufferedStart() const;
+    double bufferedEnd() const;
+    double initialTime() const { return m_initialTime; }
+    uint64_t selectedBandwidth() const { return m_tracks[0].representation ? m_tracks[0].representation->bandwidth : 0; }
+private:
+    struct Packet { std::shared_ptr<const SummitMP4::TrackInfo> configuration; SummitMP4::Sample sample; double offset; };
+    struct Track {
+        bool enabled {false}, initialized {false}, ended {false}, parseFailed {false}, haveData {false};
+        uint64_t request {0}, catalogVersion {0};
+        double nextTime {0}, bufferedStart {0}, bufferedEnd {0};
+        std::shared_ptr<const Representation> representation;
+        std::shared_ptr<const SummitMP4::TrackInfo> configuration;
+        SummitMP4::Parser parser;
+        std::deque<Packet> packets;
+    };
+    enum class RequestKind { Manifest, Initialization, Media };
+    struct Request { RequestKind kind; unsigned track; std::shared_ptr<const Representation> representation; Segment segment; };
+    void pump();
+    void loadManifest();
+    void fail(const std::string&, bool network = false);
+    const Representation* select(unsigned track, double position) const;
+    const Segment* segment(const Representation&, double position) const;
+    void requestTrack(unsigned, RequestKind, const Segment* = nullptr);
+    void resetTracks(double);
+    Hooks m_hooks;
+    std::array<Track, 2> m_tracks;
+    std::optional<Manifest> m_manifest;
+    std::map<uint64_t, Request> m_requests;
+    std::string m_url;
+    uint64_t m_identifier {0}, m_manifestRequest {0}, m_catalogVersion {0};
+    double m_now {0}, m_startUTC {0}, m_startMono {0}, m_nextRefresh {0}, m_position {0}, m_initialTime {0}, m_bandwidth {0};
+    bool m_stopped {true}, m_pumping {false};
+};
+}
diff --git a/Source/WebCore/platform/graphics/haiku/DashResourceLoaderHaiku.cpp b/Source/WebCore/platform/graphics/haiku/DashResourceLoaderHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f3c9c4e415df627894aa9d7af36e44f5e8cb7e1f
--- /dev/null
+++ b/Source/WebCore/platform/graphics/haiku/DashResourceLoaderHaiku.cpp
@@ -0,0 +1,154 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(MEDIA_SOURCE)
+#include "DashResourceLoaderHaiku.h"
+#include "ParsedContentRange.h"
+#include "ResourceRequest.h"
+#include "ResourceResponse.h"
+#include "SecurityOrigin.h"
+#include "OriginAccessPatterns.h"
+#include <limits>
+#include <wtf/MonotonicTime.h>
+#include <wtf/RunLoop.h>
+#include <wtf/text/CString.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+static bool dashNetworkURL(const URL& url)
+{
+    return url.isValid() && url.protocolIsInHTTPFamily() && url.user().isEmpty() && url.password().isEmpty();
+}
+class DashResourceClientHaiku final : public PlatformMediaResourceClient {
+public:
+    using Completion = Function<void(bool, std::vector<uint8_t>&&, std::string&&, double)>;
+    using SecurityResponse = Function<void(const URL&, bool, bool)>;
+    static Ref<DashResourceClientHaiku> create(std::optional<SummitDASH::ByteRange> range, size_t limit, SecurityResponse&& securityResponse, Completion&& completion)
+    { return adoptRef(*new DashResourceClientHaiku(range, limit, WTF::move(securityResponse), WTF::move(completion))); }
+    void responseReceived(PlatformMediaResource& resource, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completion) final
+    {
+        bool valid = dashNetworkURL(response.url()) && response.httpStatusCode() == (m_range ? 206 : 200);
+        if (m_range) {
+            ParsedContentRange range(response.httpHeaderField(HTTPHeaderName::ContentRange));
+            valid &= range.isValid() && range.firstBytePosition() >= 0 && range.lastBytePosition() >= 0
+                && uint64_t(range.firstBytePosition()) == m_range->first && uint64_t(range.lastBytePosition()) == m_range->last;
+        }
+        auto length = response.expectedContentLength();
+        valid &= length <= 0 || uint64_t(length) <= m_limit;
+        if (m_range && length >= 0) valid &= uint64_t(length) == m_range->last - m_range->first + 1;
+        if (valid) {
+            m_securityResponse(response.url(), resource.didPassAccessControlCheck(), response.tainting() == ResourceResponse::Tainting::Opaque);
+            m_receivedResponse = true;
+            auto url = response.url().string().utf8();
+            m_finalURL.assign(url.legacyCStringPointer(), url.length());
+        }
+        completion(valid ? ShouldContinuePolicyCheck::Yes : ShouldContinuePolicyCheck::No);
+        if (!valid) finish(false);
+    }
+    void redirectReceived(PlatformMediaResource&, ResourceRequest&& request, const ResourceResponse&, CompletionHandler<void(ResourceRequest&&)>&& completion) final
+    {
+        if (!dashNetworkURL(request.url())) { completion(ResourceRequest { }); finish(false); return; }
+        if (m_range) request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, m_range->first, '-', m_range->last));
+        completion(WTF::move(request));
+    }
+    bool shouldCacheResponse(PlatformMediaResource&, const ResourceResponse&) final { return false; }
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& buffer) final
+    {
+        if (!m_completion) return;
+        if (!m_receivedResponse || buffer.size() > m_limit - m_data.size()) { finish(false); return; }
+        buffer.forEachSegment([&](std::span<const uint8_t> bytes) { m_data.insert(m_data.end(), bytes.begin(), bytes.end()); });
+    }
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final { finish(false); }
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final { finish(false); }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final
+    { finish(m_receivedResponse && (!m_range || m_data.size() == m_range->last - m_range->first + 1)); }
+private:
+    DashResourceClientHaiku(std::optional<SummitDASH::ByteRange> range, size_t limit, SecurityResponse&& securityResponse, Completion&& completion)
+        : m_range(range), m_limit(limit), m_securityResponse(WTF::move(securityResponse)), m_completion(WTF::move(completion)), m_started(MonotonicTime::now()) { }
+    void finish(bool success)
+    {
+        if (auto completion = std::exchange(m_completion, nullptr)) {
+            auto elapsed = (MonotonicTime::now() - m_started).seconds();
+            RunLoop::mainSingleton().dispatch([completion = WTF::move(completion), success, data = WTF::move(m_data), url = WTF::move(m_finalURL), elapsed]() mutable {
+                completion(success, WTF::move(data), WTF::move(url), elapsed);
+            });
+        }
+    }
+    std::optional<SummitDASH::ByteRange> m_range;
+    size_t m_limit;
+    SecurityResponse m_securityResponse;
+    Completion m_completion;
+    MonotonicTime m_started;
+    std::vector<uint8_t> m_data;
+    std::string m_finalURL;
+    bool m_receivedResponse {false};
+};
+
+DashResourceLoaderHaiku::DashResourceLoaderHaiku(Ref<PlatformMediaResourceLoader>&& loader, Completion&& completion)
+    : m_loader(WTF::move(loader)), m_completion(WTF::move(completion)) { }
+DashResourceLoaderHaiku::~DashResourceLoaderHaiku() { cancelAll(); }
+void DashResourceLoaderHaiku::request(uint64_t identifier, const SummitDASH::Resource& input, size_t limit)
+{
+    cancel(identifier);
+    URL url { String::fromUTF8(input.url.c_str()) };
+    bool valid = dashNetworkURL(url) && limit && limit <= 64 * 1024 * 1024;
+    if (input.range) valid &= input.range->last >= input.range->first && input.range->last < uint64_t(std::numeric_limits<int64_t>::max())
+        && input.range->last - input.range->first < limit;
+    RefPtr<PlatformMediaResource> resource;
+    if (valid) {
+        ResourceRequest request { WTF::move(url) };
+        request.setTimeoutInterval(30);
+        if (input.range) request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, input.range->first, '-', input.range->last));
+        resource = m_loader->requestResource(WTF::move(request), PlatformMediaResourceLoader::DisallowCaching);
+    }
+    m_resources.set(identifier, resource);
+    if (!resource) {
+        RunLoop::mainSingleton().dispatch([weakThis = WeakPtr { *this }, identifier] {
+            if (RefPtr protectedThis = weakThis.get()) protectedThis->completed(identifier, false, { }, { }, 0);
+        });
+        return;
+    }
+    resource->setClient(DashResourceClientHaiku::create(input.range, limit,
+        [weakThis = WeakPtr { *this }](const URL& url, bool passedCORS, bool opaque) {
+            if (RefPtr loader = weakThis.get()) {
+                auto origin = SecurityOrigin::create(url);
+                if (!passedCORS && !loader->m_nonCORSOrigins.contains(origin->data())) {
+                    if (loader->m_nonCORSOrigins.size() < 64)
+                        loader->m_nonCORSOrigins.add(origin->data());
+                    else
+                        loader->m_hasOpaqueResponse = true;
+                }
+                loader->m_hasOpaqueResponse |= opaque;
+                loader->m_hasInsecureResource |= !origin->isPotentiallyTrustworthy();
+            }
+        }, [weakThis = WeakPtr { *this }, identifier](bool success, auto&& data, auto&& url, double elapsed) {
+        if (RefPtr protectedThis = weakThis.get()) protectedThis->completed(identifier, success, WTF::move(data), WTF::move(url), elapsed);
+    }));
+}
+bool DashResourceLoaderHaiku::isCrossOrigin(const SecurityOrigin& origin) const
+{
+    if (m_hasOpaqueResponse)
+        return true;
+    for (auto& resourceOrigin : m_nonCORSOrigins) {
+        if (!origin.canRequest(URL { resourceOrigin.toString() }, OriginAccessPatternsForWebProcess::singleton()))
+            return true;
+    }
+    return false;
+}
+void DashResourceLoaderHaiku::completed(uint64_t identifier, bool success, std::vector<uint8_t>&& data, std::string&& url, double elapsed)
+{
+    if (!m_resources.contains(identifier)) return;
+    cancel(identifier);
+    m_completion(identifier, success, WTF::move(data), WTF::move(url), elapsed);
+}
+void DashResourceLoaderHaiku::cancel(uint64_t identifier)
+{
+    if (auto resource = m_resources.take(identifier)) { resource->setClient(nullptr); resource->shutdown(); }
+}
+void DashResourceLoaderHaiku::cancelAll()
+{
+    auto resources = std::exchange(m_resources, { });
+    for (auto& resource : resources.values()) if (resource) { resource->setClient(nullptr); resource->shutdown(); }
+}
+}
+
+#endif // ENABLE(MEDIA_SOURCE)
