@@ -0,0 +1,186 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "BrowserCommandBrokerHaiku.h"
+
+#include "WebKitContext.h"
+#include <algorithm>
+#include <limits>
+
+namespace WebKit {
+
+std::shared_ptr<BrowserCommandBrokerHaiku> BrowserCommandBrokerHaiku::create(bigtime_t timeout)
+{
+    ASSERT(RunLoop::isMain());
+    return std::shared_ptr<BrowserCommandBrokerHaiku>(new BrowserCommandBrokerHaiku(timeout));
+}
+
+BrowserCommandBrokerHaiku::BrowserCommandBrokerHaiku(bigtime_t timeout)
+    : m_timer(RunLoop::mainSingleton(), "BrowserCommandBrokerHaiku"_s, [this] { pump(); })
+    , m_timeout(std::clamp<bigtime_t>(timeout, 100000, 120000000))
+{
+}
+
+BrowserCommandBrokerHaiku::~BrowserCommandBrokerHaiku()
+{
+    shutdown();
+}
+
+status_t BrowserCommandBrokerHaiku::setListener(const BMessenger& listener)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown)
+        return B_CANCELED;
+    // Tab and window changes are trusted browser UI, never another team.
+    if (listener.IsValid() && !listener.IsTargetLocal())
+        return B_NOT_ALLOWED;
+    if (listener == m_listener)
+        return B_OK;
+    // The previous host can no longer answer; do not leave its callers waiting
+    // for the deadline, and never replay a command to a different listener.
+    auto requests = std::exchange(m_requests, { });
+    for (auto& request : requests)
+        complete(WTF::move(request), { B_CANCELED, { }, { } }, true);
+    m_listener = listener;
+    pump();
+    return B_OK;
+}
+
+void BrowserCommandBrokerHaiku::dispatch(Completion&& completion, Result&& result)
+{
+    RunLoop::mainSingleton().dispatch([completion = WTF::move(completion), result = WTF::move(result)]() mutable {
+        completion(WTF::move(result));
+    });
+}
+
+uint64_t BrowserCommandBrokerHaiku::request(uint64_t owner, BMessage&& message, Completion&& completion)
+{
+    ASSERT(RunLoop::isMain());
+    status_t error = B_OK;
+    if (m_shutdown)
+        error = B_CANCELED;
+    else if (!m_listener.IsValid())
+        error = B_NO_INIT;
+    else if (m_requests.size() >= 256 || m_nextIdentifier == std::numeric_limits<uint64_t>::max())
+        error = B_BUSY;
+    else if (!owner || message.what != B_WEBKIT_BROWSER_COMMAND || message.HasUInt64("identifier") || message.HasInt64("deadline"))
+        error = B_BAD_VALUE;
+    if (error != B_OK) {
+        dispatch(WTF::move(completion), { error, { }, { } });
+        return 0;
+    }
+
+    auto identifier = m_nextIdentifier++;
+    auto deadline = system_time() + m_timeout;
+    error = message.AddUInt64("identifier", identifier);
+    if (error == B_OK)
+        error = message.AddInt64("deadline", deadline);
+    if (error != B_OK) {
+        dispatch(WTF::move(completion), { error, { }, { } });
+        return 0;
+    }
+    m_requests.append(std::make_unique<Request>(Request { owner, identifier, WTF::move(message), WTF::move(completion), deadline }));
+    pump();
+    return identifier;
+}
+
+void BrowserCommandBrokerHaiku::complete(std::unique_ptr<Request> request, Result&& result, bool notifyHost)
+{
+    if (notifyHost && request->delivered && m_listener.IsValid()) {
+        // Advisory only: the host also received the absolute deadline, and its
+        // late response is already inert because the identifier is forgotten.
+        BMessage message(B_WEBKIT_BROWSER_COMMAND_CANCELLED);
+        if (message.AddUInt64("identifier", request->identifier) == B_OK)
+            m_listener.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+    dispatch(WTF::move(request->completion), WTF::move(result));
+}
+
+void BrowserCommandBrokerHaiku::pump()
+{
+    ASSERT(RunLoop::isMain());
+    auto now = system_time();
+    Vector<std::unique_ptr<Request>> finished;
+    Vector<status_t> errors;
+    for (size_t index = 0; index < m_requests.size();) {
+        auto& request = *m_requests[index];
+        status_t error = B_OK;
+        if (now >= request.deadline)
+            error = B_TIMED_OUT;
+        else if (!m_listener.IsValid())
+            error = B_BAD_PORT_ID;
+        else if (!request.delivered) {
+            if (!request.deliveryDeadline)
+                request.deliveryDeadline = std::min(now + 1000000, request.deadline);
+            // Never block the WebKit main thread on a busy host looper.
+            auto status = m_listener.SendMessage(&request.message, static_cast<BHandler*>(nullptr), 0);
+            if (status == B_OK)
+                request.delivered = true;
+            else if ((status != B_WOULD_BLOCK && status != B_TIMED_OUT) || now >= request.deliveryDeadline)
+                error = status;
+        }
+        if (error == B_OK) {
+            ++index;
+            continue;
+        }
+        finished.append(WTF::move(m_requests[index]));
+        errors.append(error);
+        m_requests.removeAt(index);
+    }
+    for (size_t index = 0; index < finished.size(); ++index)
+        complete(WTF::move(finished[index]), { errors[index], { }, { } }, errors[index] == B_TIMED_OUT);
+    if (m_requests.isEmpty())
+        m_timer.stop();
+    else if (!m_timer.isActive())
+        m_timer.startRepeating(100_ms);
+}
+
+void BrowserCommandBrokerHaiku::respond(uint64_t identifier, Result&& result)
+{
+    ASSERT(RunLoop::isMain());
+    auto index = m_requests.findIf([&](auto& request) { return request->identifier == identifier; });
+    if (index == notFound || !m_requests[index]->delivered)
+        return;
+    auto request = WTF::move(m_requests[index]);
+    m_requests.removeAt(index);
+    if (system_time() >= request->deadline)
+        result = { B_TIMED_OUT, { }, { } };
+    complete(WTF::move(request), WTF::move(result), false);
+    pump();
+}
+
+void BrowserCommandBrokerHaiku::cancelOwner(uint64_t owner)
+{
+    ASSERT(RunLoop::isMain());
+    Vector<std::unique_ptr<Request>> cancelled;
+    for (size_t index = 0; index < m_requests.size();) {
+        if (m_requests[index]->owner != owner) {
+            ++index;
+            continue;
+        }
+        cancelled.append(WTF::move(m_requests[index]));
+        m_requests.removeAt(index);
+    }
+    for (auto& request : cancelled)
+        complete(WTF::move(request), { B_CANCELED, { }, { } }, true);
+    pump();
+}
+
+void BrowserCommandBrokerHaiku::cancelAll()
+{
+    ASSERT(RunLoop::isMain());
+    auto requests = std::exchange(m_requests, { });
+    m_timer.stop();
+    for (auto& request : requests)
+        complete(WTF::move(request), { B_CANCELED, { }, { } }, true);
+}
+
+void BrowserCommandBrokerHaiku::shutdown()
+{
+    ASSERT(RunLoop::isMain());
+    m_shutdown = true;
+    cancelAll();
+    m_listener = BMessenger();
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/BrowserCommandBrokerHaiku.h b/Source/WebKit/UIProcess/haiku/BrowserCommandBrokerHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..00672589a5ae1fd82ae159dca56f9a01d2ac8534
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/BrowserCommandBrokerHaiku.h
@@ -0,0 +1,76 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include "WebPageProxyIdentifier.h"
+#include <Message.h>
+#include <Messenger.h>
+#include <memory>
+#include <wtf/CompletionHandler.h>
+#include <wtf/RunLoop.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+
+// Main RunLoop only. Extensions ask the host browser to change its own tab and
+// window model through this broker; the engine never opens, closes, selects or
+// navigates a host tab by itself. Every request completes exactly once and
+// always asynchronously: with the host's answer, or with an error when there is
+// no listener, delivery fails, the deadline passes or the owner is cancelled.
+class BrowserCommandBrokerHaiku final {
+public:
+    struct Result {
+        status_t status { B_ERROR };
+        // Optional host-supplied explanation for a failure.
+        String error;
+        // Pages of the views the host created for this command, in host order.
+        Vector<WebPageProxyIdentifier> createdPages;
+        // What a query answers with (RespondToBrowserCommandWithData): JSON.
+        String data;
+    };
+    using Completion = CompletionHandler<void(Result&&)>;
+
+    static std::shared_ptr<BrowserCommandBrokerHaiku> create(bigtime_t timeout = 30000000);
+    ~BrowserCommandBrokerHaiku();
+
+    // Only local targets are accepted. Replacing or clearing the listener
+    // fails the requests that were addressed to the previous one.
+    status_t setListener(const BMessenger&);
+    bool hasListener() const { return m_listener.IsValid(); }
+
+    // owner identifies one extension load and is never sent to the host. The
+    // broker adds identifier and deadline to the message before delivery.
+    // Returns the request identifier, or zero when it failed immediately.
+    uint64_t request(uint64_t owner, BMessage&&, Completion&&);
+    // Stale, duplicate and unknown identifiers are ignored.
+    void respond(uint64_t identifier, Result&&);
+    void cancelOwner(uint64_t owner);
+    void cancelAll();
+    void shutdown();
+    bool hasPendingRequests() const { return !m_requests.isEmpty(); }
+
+private:
+    explicit BrowserCommandBrokerHaiku(bigtime_t);
+    struct Request {
+        uint64_t owner;
+        uint64_t identifier;
+        BMessage message;
+        Completion completion;
+        bigtime_t deadline;
+        bigtime_t deliveryDeadline { 0 };
+        bool delivered { false };
+    };
+    void pump();
+    void complete(std::unique_ptr<Request>, Result&&, bool notifyHost);
+    static void dispatch(Completion&&, Result&&);
+
+    BMessenger m_listener;
+    Vector<std::unique_ptr<Request>> m_requests;
+    RunLoop::Timer m_timer;
+    const bigtime_t m_timeout;
+    uint64_t m_nextIdentifier { 1 };
+    bool m_shutdown { false };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.cpp b/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b0f81b9a731fded3d31dd6912e985e0e5c5635d5
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.cpp
@@ -0,0 +1,214 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "BrowserTabRegistryHaiku.h"
+
+#include <wtf/HashSet.h>
+#include <wtf/MainThread.h>
+
+namespace WebKit {
+
+void BrowserTabRegistryHaiku::publish(Vector<Window>&& windows, std::optional<uint64_t> focusedWindow)
+{
+    bool changed = focusedWindow != m_focusedWindow || windows.size() != m_windows.size();
+    for (size_t i = 0; !changed && i < windows.size(); ++i) {
+        auto& oldWindow = m_windows[i];
+        auto& newWindow = windows[i];
+        changed = oldWindow.identifier != newWindow.identifier || oldWindow.messenger != newWindow.messenger
+            || oldWindow.pages != newWindow.pages || oldWindow.activePage != newWindow.activePage;
+    }
+    if (!changed)
+        return;
+    Snapshot before { WTF::move(m_windows), m_focusedWindow };
+    m_windows = WTF::move(windows);
+    m_focusedWindow = focusedWindow;
+    // Copy both the callback and new state so a nested update or unregister
+    // cannot invalidate the arguments of the current callback.
+    if (auto observer = m_observer) {
+        Snapshot after { m_windows, m_focusedWindow };
+        observer(before, after);
+    }
+}
+
+std::expected<uint64_t, status_t> BrowserTabRegistryHaiku::update(const BMessenger& messenger, const Vector<WebPageProxyIdentifier>& pages,
+    std::optional<WebPageProxyIdentifier> activePage, bool focused)
+{
+    ASSERT(isMainThread());
+    HashSet<WebPageProxyIdentifier> incomingPages;
+    for (auto page : pages) {
+        if (!incomingPages.add(page).isNewEntry)
+            return makeUnexpected(B_BAD_VALUE);
+    }
+    if (activePage && !incomingPages.contains(*activePage))
+        return makeUnexpected(B_BAD_VALUE);
+    auto existing = m_windows.findIf([&](auto& window) { return window.messenger == messenger; });
+    if (pages.isEmpty()) {
+        if (existing == notFound)
+            return uint64_t { 0 };
+        auto identifier = m_windows[existing].identifier;
+        auto windows = m_windows;
+        windows.removeAt(existing);
+        publish(WTF::move(windows), m_focusedWindow == identifier ? std::nullopt : m_focusedWindow);
+        return identifier;
+    }
+    if (!messenger.IsValid())
+        return makeUnexpected(B_BAD_VALUE);
+    if (existing == notFound && m_nextWindowIdentifier == std::numeric_limits<uint64_t>::max())
+        return makeUnexpected(B_ERROR);
+
+    auto identifier = existing != notFound ? m_windows[existing].identifier : m_nextWindowIdentifier++;
+    // Validate first, then publish a complete replacement. A move may affect
+    // several windows, but observers only see the final ownership and order.
+    auto windows = m_windows;
+    for (auto& window : windows) {
+        if (window.identifier == identifier)
+            continue;
+        window.pages.removeAllMatching([&](auto page) { return incomingPages.contains(page); });
+        if (window.activePage && !window.pages.contains(*window.activePage))
+            window.activePage = std::nullopt;
+    }
+    windows.removeAllMatching([](auto& window) { return window.pages.isEmpty(); });
+    auto index = windows.findIf([&](auto& window) { return window.identifier == identifier; });
+    Window replacement { identifier, messenger, pages, activePage };
+    if (index == notFound) {
+        windows.append(WTF::move(replacement));
+        index = windows.size() - 1;
+    } else
+        windows[index] = WTF::move(replacement);
+    auto focusedWindow = m_focusedWindow;
+    if (focused) {
+        focusedWindow = identifier;
+        if (index) {
+            auto window = WTF::move(windows[index]);
+            windows.removeAt(index);
+            windows.insert(0, WTF::move(window));
+        }
+    } else if (focusedWindow == identifier)
+        focusedWindow = std::nullopt;
+    if (focusedWindow && !windows.containsIf([&](auto& window) { return window.identifier == *focusedWindow; }))
+        focusedWindow = std::nullopt;
+    publish(WTF::move(windows), focusedWindow);
+    return identifier;
+}
+
+void BrowserTabRegistryHaiku::setFrame(const BMessenger& window, BRect frame)
+{
+    ASSERT(isMainThread());
+    if (auto previous = this->frame(window); previous && *previous == frame)
+        return;
+    // Forget closed windows' frames.
+    m_frames.removeAllMatching([&](auto& entry) { return entry.first == window || !entry.first.IsValid(); });
+    m_frames.append({ window, frame });
+    if (!m_frameObserver)
+        return;
+    for (auto& registered : m_windows) {
+        if (registered.messenger == window) {
+            m_frameObserver(registered.identifier);
+            break;
+        }
+    }
+}
+
+void BrowserTabRegistryHaiku::setActionAnchor(const BMessenger& window, const String& extension, BRect button)
+{
+    ASSERT(isMainThread());
+    // Forget closed windows' anchors.
+    m_actionAnchors.removeAllMatching([&](auto& entry) {
+        return (entry.window == window && entry.extension == extension) || !entry.window.IsValid();
+    });
+    if (button.IsValid())
+        m_actionAnchors.append({ window, extension, button });
+}
+
+std::optional<BRect> BrowserTabRegistryHaiku::actionAnchor(const BMessenger& window, const String& extension) const
+{
+    ASSERT(isMainThread());
+    for (auto& anchor : m_actionAnchors) {
+        if (anchor.window == window && anchor.extension == extension)
+            return anchor.button;
+    }
+    return std::nullopt;
+}
+
+std::optional<BRect> BrowserTabRegistryHaiku::frame(const BMessenger& window) const
+{
+    ASSERT(isMainThread());
+    for (auto& entry : m_frames) {
+        if (entry.first == window)
+            return entry.second;
+    }
+    return std::nullopt;
+}
+
+void BrowserTabRegistryHaiku::setPinned(WebPageProxyIdentifier identifier, bool pinned)
+{
+    ASSERT(isMainThread());
+    if (pinned == isPinned(identifier))
+        return;
+    if (pinned)
+        m_pinnedPages.append(identifier);
+    else
+        m_pinnedPages.removeFirst(identifier);
+    if (m_pinnedObserver)
+        m_pinnedObserver(identifier);
+}
+
+void BrowserTabRegistryHaiku::removePage(WebPageProxyIdentifier identifier)
+{
+    ASSERT(isMainThread());
+    m_pinnedPages.removeFirst(identifier);
+    m_discardedPages.remove(identifier);
+    m_readerPages.remove(identifier);
+    auto windows = m_windows;
+    for (auto& window : windows) {
+        window.pages.removeFirst(identifier);
+        if (window.activePage == identifier)
+            window.activePage = std::nullopt;
+    }
+    windows.removeAllMatching([](auto& window) { return window.pages.isEmpty(); });
+    auto focusedWindow = m_focusedWindow;
+    if (focusedWindow && !windows.containsIf([&](auto& window) { return window.identifier == *focusedWindow; }))
+        focusedWindow = std::nullopt;
+    publish(WTF::move(windows), focusedWindow);
+}
+
+void BrowserTabRegistryHaiku::clear()
+{
+    ASSERT(isMainThread());
+    publish({ }, std::nullopt);
+    // Do not recycle IDs: a retained extension window must stay invalid.
+}
+
+Vector<BrowserTabRegistryHaiku::Window> BrowserTabRegistryHaiku::windows() const
+{
+    ASSERT(isMainThread());
+    return m_windows;
+}
+
+std::optional<BrowserTabRegistryHaiku::Window> BrowserTabRegistryHaiku::window(uint64_t identifier) const
+{
+    ASSERT(isMainThread());
+    auto index = m_windows.findIf([&](auto& window) { return window.identifier == identifier; });
+    if (index == notFound)
+        return std::nullopt;
+    return m_windows[index];
+}
+
+std::optional<BrowserTabRegistryHaiku::Tab> BrowserTabRegistryHaiku::tab(WebPageProxyIdentifier identifier) const
+{
+    ASSERT(isMainThread());
+    for (auto& window : m_windows) {
+        auto index = window.pages.find(identifier);
+        if (index != notFound)
+            return Tab { window.identifier, index, window.activePage == identifier };
+    }
+    return std::nullopt;
+}
+
+std::optional<uint64_t> BrowserTabRegistryHaiku::focusedWindow() const
+{
+    ASSERT(isMainThread());
+    return m_focusedWindow;
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.h b/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..d822f95988aae563c52ec5fa97c604f432369a88
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/BrowserTabRegistryHaiku.h
@@ -0,0 +1,124 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include "WebPageProxyIdentifier.h"
+#include <Messenger.h>
+#include <Rect.h>
+#include <functional>
+#include <SupportDefs.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+
+// Main-thread metadata only. The native SDK validates page ownership before
+// updating this profile's registry; WebKit retains ownership of the pages.
+class BrowserTabRegistryHaiku {
+public:
+    struct Window {
+        uint64_t identifier;
+        BMessenger messenger;
+        Vector<WebPageProxyIdentifier> pages;
+        std::optional<WebPageProxyIdentifier> activePage;
+    };
+    struct Tab {
+        uint64_t windowIdentifier;
+        size_t index;
+        bool active;
+    };
+
+    struct Snapshot {
+        Vector<Window> windows;
+        std::optional<uint64_t> focusedWindow;
+    };
+    using Observer = std::function<void(const Snapshot& before, const Snapshot& after)>;
+    // Observers see committed, independent snapshots and may unregister while
+    // running. Setting an observer does not synthesize creation events.
+    void setObserver(Observer observer) { m_observer = WTF::move(observer); }
+
+    // An empty page list removes the window. Moving a page removes it from its
+    // previous window. Focused windows move to the front of the window order.
+    std::expected<uint64_t, status_t> update(const BMessenger&, const Vector<WebPageProxyIdentifier>&,
+        std::optional<WebPageProxyIdentifier> activePage, bool focused);
+    void removePage(WebPageProxyIdentifier);
+    void clear();
+
+    // The browser's pinned tabs. A page leaves the set when it closes.
+    // The pinned observer hears of each change.
+    using PinnedObserver = std::function<void(WebPageProxyIdentifier)>;
+    void setPinnedObserver(PinnedObserver observer) { m_pinnedObserver = WTF::move(observer); }
+    void setPinned(WebPageProxyIdentifier, bool pinned);
+    bool isPinned(WebPageProxyIdentifier identifier) const { return m_pinnedPages.contains(identifier); }
+    // The browser's unloaded tabs (Tab.discarded), which load when selected,
+    // with the address and title they show until then.
+    struct DiscardedTab {
+        String url, title;
+    };
+    void setDiscarded(WebPageProxyIdentifier identifier, std::optional<DiscardedTab> discarded)
+    {
+        if (discarded)
+            m_discardedPages.set(identifier, WTF::move(*discarded));
+        else
+            m_discardedPages.remove(identifier);
+    }
+    bool isDiscarded(WebPageProxyIdentifier identifier) const { return m_discardedPages.contains(identifier); }
+    // Whether the browser can show a tab's page in Reader view, and does.
+    struct ReaderState {
+        bool available = false, active = false;
+    };
+    // Whether the state changed.
+    bool setReader(WebPageProxyIdentifier identifier, ReaderState state)
+    {
+        auto old = reader(identifier);
+        if (old.available == state.available && old.active == state.active)
+            return false;
+        if (!state.available && !state.active)
+            m_readerPages.remove(identifier);
+        else
+            m_readerPages.set(identifier, state);
+        return true;
+    }
+    ReaderState reader(WebPageProxyIdentifier identifier) const { return m_readerPages.getOptional(identifier).value_or(ReaderState { }); }
+    const DiscardedTab* discardedTab(WebPageProxyIdentifier identifier) const
+    {
+        auto entry = m_discardedPages.find(identifier);
+        return entry == m_discardedPages.end() ? nullptr : &entry->value;
+    }
+    // Window frames (screen coordinates) as the browser reports them. The
+    // frame observer hears of each registered window whose frame changed.
+    using FrameObserver = std::function<void(uint64_t windowIdentifier)>;
+    void setFrameObserver(FrameObserver observer) { m_frameObserver = WTF::move(observer); }
+    void setFrame(const BMessenger& window, BRect frame);
+    std::optional<BRect> frame(const BMessenger& window) const;
+    // The button (screen coordinates) an extension's action popup in a window
+    // opens under; an invalid rect forgets it.
+    void setActionAnchor(const BMessenger& window, const String& extension, BRect button);
+    std::optional<BRect> actionAnchor(const BMessenger& window, const String& extension) const;
+
+    Vector<Window> windows() const;
+    std::optional<Window> window(uint64_t) const;
+    std::optional<Tab> tab(WebPageProxyIdentifier) const;
+    std::optional<uint64_t> focusedWindow() const;
+
+private:
+    void publish(Vector<Window>&&, std::optional<uint64_t> focusedWindow);
+    Observer m_observer;
+    PinnedObserver m_pinnedObserver;
+    Vector<WebPageProxyIdentifier> m_pinnedPages;
+    HashMap<WebPageProxyIdentifier, DiscardedTab> m_discardedPages;
+    HashMap<WebPageProxyIdentifier, ReaderState> m_readerPages;
+    Vector<std::pair<BMessenger, BRect>> m_frames;
+    struct ActionAnchor {
+        BMessenger window;
+        String extension;
+        BRect button;
+    };
+    Vector<ActionAnchor> m_actionAnchors;
+    FrameObserver m_frameObserver;
+    Vector<Window> m_windows;
+    std::optional<uint64_t> m_focusedWindow;
+    uint64_t m_nextWindowIdentifier { 1 };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/DateTimeValueHaiku.h b/Source/WebKit/UIProcess/haiku/DateTimeValueHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..d932c8a5a257ad6f3b7ebaa63ceb669c0f845903
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/DateTimeValueHaiku.h
@@ -0,0 +1,82 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <WebCore/DateComponents.h>
+#include <WebCore/StepRange.h>
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <string>
+#include <vector>
+#include <wtf/text/CString.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+// Value-only parsing and constraint checks. These helpers do not access a
+// document, page, locale, or chooser client and may run on the native looper.
+struct DateTimeValueHaiku {
+    using Type = WebCore::DateComponentsType;
+    Type type { Type::Invalid };
+    std::string current;
+    std::vector<std::string> suggestions;
+    double minimum { 0 }, maximum { 0 }, step { 1 }, stepBase { 0 };
+
+    std::optional<WebCore::DateComponents> parse(const std::string& text) const
+    {
+        if (text.size() > 64) return std::nullopt;
+        auto value = String::fromUTF8(text);
+        using D = WebCore::DateComponents;
+        switch (type) {
+        case Type::Date: return D::fromParsingDate(value);
+        case Type::Month: return D::fromParsingMonth(value);
+        case Type::Week: return D::fromParsingWeek(value);
+        case Type::Time: return D::fromParsingTime(value);
+        case Type::DateTimeLocal: return D::fromParsingDateTimeLocal(value);
+        default: return std::nullopt;
+        }
+    }
+    static std::string text(const WebCore::DateComponents& value)
+    {
+        auto bytes = value.toString().utf8();
+        return { bytes.legacyCStringPointer(), bytes.length() };
+    }
+    double number(const WebCore::DateComponents& value) const
+    {
+        return type == Type::Month ? value.monthsSinceEpoch() : value.millisecondsSinceEpoch();
+    }
+    const char* format() const
+    {
+        switch (type) {
+        case Type::Date: return "YYYY-MM-DD";
+        case Type::Month: return "YYYY-MM";
+        case Type::Week: return "YYYY-Www (ISO week)";
+        case Type::Time: return "HH:mm, optionally :ss or :ss.sss";
+        case Type::DateTimeLocal: return "YYYY-MM-DDTHH:mm, optionally :ss or :ss.sss";
+        default: return "";
+        }
+    }
+    // Empty values remain possible even for required inputs, like typing in
+    // the field; the form retains responsibility for required validation.
+    std::string error(const std::string& value) const
+    {
+        if (value.empty()) return { };
+        if (!std::isfinite(minimum) || !std::isfinite(maximum) || !std::isfinite(stepBase)
+            || !std::isfinite(step) || step <= 0) return "This field has invalid constraints.";
+        auto components = parse(value);
+        if (!components) return std::string("Use ") + format() + ".";
+        const auto numeric = number(*components);
+        if (!std::isfinite(numeric)) return "This value is outside the supported calendar.";
+        bool outside = numeric < minimum || numeric > maximum;
+        if (type == Type::Time && minimum > maximum)
+            outside = numeric < minimum && numeric > maximum;
+        if (outside) return "This value is outside the field's allowed range.";
+        // Reuse the same decimal step arithmetic as the HTML controls.
+        using namespace WebCore;
+        StepRange range(Decimal::fromDouble(stepBase), RangeLimitations::Valid,
+            Decimal::fromDouble(std::min(minimum, maximum)), Decimal::fromDouble(std::max(minimum, maximum)),
+            Decimal::fromDouble(step), { 1, 0, 1, StepRange::StepValueShouldBe::ScaledInteger });
+        if (range.stepMismatch(Decimal::fromDouble(numeric)))
+            return "This value does not match the field's allowed interval.";
+        return { };
+    }
+};
+}
diff --git a/Source/WebKit/UIProcess/haiku/DirectPresentTargetHaiku.h b/Source/WebKit/UIProcess/haiku/DirectPresentTargetHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..4bacf045a2c597f0e182667aa572dc93db80b21b
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/DirectPresentTargetHaiku.h
@@ -0,0 +1,150 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include "DirectPresentHaiku.h"
+#include <OS.h>
+#include <Region.h>
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <vector>
+
+namespace WebKit {
+
+// The UI process end of DirectPresentStateHaiku, one per web view: where the
+// view's page goes on the screen. See DirectPresentHaiku.h.
+class DirectPresentTargetHaiku {
+public:
+    struct Target {
+        bool enabled { false };
+        int32_t originX { 0 };
+        int32_t originY { 0 };
+        uint32_t frontBytesPerRow { 0 };
+        area_id backArea { -1 };
+        uint32_t backBytesPerRow { 0 };
+        uint32_t backWidth { 0 };
+        uint32_t backHeight { 0 };
+        std::vector<clipping_rect> rects;
+
+        bool operator==(const Target& other) const
+        {
+            if (enabled != other.enabled)
+                return false;
+            if (!enabled)
+                return true;
+            if (originX != other.originX || originY != other.originY || frontBytesPerRow != other.frontBytesPerRow
+                || backArea != other.backArea || backBytesPerRow != other.backBytesPerRow || backWidth != other.backWidth
+                || backHeight != other.backHeight || rects.size() != other.rects.size())
+                return false;
+            for (size_t i = 0; i < rects.size(); ++i) {
+                if (rects[i].left != other.rects[i].left || rects[i].top != other.rects[i].top
+                    || rects[i].right != other.rects[i].right || rects[i].bottom != other.rects[i].bottom)
+                    return false;
+            }
+            return true;
+        }
+    };
+
+    static std::shared_ptr<DirectPresentTargetHaiku> create()
+    {
+        auto target = std::shared_ptr<DirectPresentTargetHaiku>(new DirectPresentTargetHaiku);
+        return target->m_state ? target : nullptr;
+    }
+
+    ~DirectPresentTargetHaiku()
+    {
+        if (m_state)
+            delete_sem(m_state->lock);
+        if (m_area >= 0)
+            delete_area(m_area);
+    }
+
+    area_id area() const { return m_area; }
+    bool enabled() const { return m_enabled.load(std::memory_order_relaxed); }
+
+    // Any thread; the callers take turns (WebKitView.cpp's direct lock).
+    // Returns whether anything changed; a changed target needs the page
+    // presented again in full. Returns once the GPU has finished every copy
+    // made for the previous target, which a window that is being covered or
+    // moved needs before app_server goes on, or at the deadline, whichever
+    // comes first: app_server gives DirectConnected() half a second and then
+    // kills the application, with its pages' copies still under way (that
+    // hung the X399). Past the deadline an old copy can at worst land on what
+    // now covers the window.
+    bool update(const Target& target, bigtime_t deadline)
+    {
+        if (target == m_current)
+            return false;
+        bigtime_t lockWait = std::clamp<bigtime_t>(deadline - system_time(), 0, 30000);
+        bool locked = acquire_sem_etc(m_state->lock, 1, B_RELATIVE_TIMEOUT, lockWait) == B_OK;
+        m_state->enabled = target.enabled;
+        m_state->originX = target.originX;
+        m_state->originY = target.originY;
+        m_state->frontBytesPerRow = target.frontBytesPerRow;
+        m_state->backArea = target.backArea;
+        m_state->backBytesPerRow = target.backBytesPerRow;
+        m_state->backWidth = target.backWidth;
+        m_state->backHeight = target.backHeight;
+        uint32_t count = std::min<size_t>(target.rects.size(), DirectPresentStateHaiku::maximumRects);
+        for (uint32_t i = 0; i < count; ++i) {
+            m_state->rects[i * 4] = target.rects[i].left;
+            m_state->rects[i * 4 + 1] = target.rects[i].top;
+            m_state->rects[i * 4 + 2] = target.rects[i].right;
+            m_state->rects[i * 4 + 3] = target.rects[i].bottom;
+        }
+        m_state->rectCount = count;
+        m_state->generation++;
+        // Holding the lock keeps new copies from starting while the old ones finish.
+        deadline = std::min(deadline, system_time() + 60000);
+        while (m_state->inFlight.load() > 0 && system_time() < deadline)
+            snooze(100);
+        if (locked)
+            release_sem(m_state->lock);
+        m_current = target;
+        m_enabled = target.enabled;
+        return true;
+    }
+
+    // Any thread. Something other than the page has drawn into its place on
+    // the screen (app_server, from its own copy): the next frame goes there in
+    // full rather than only what changed.
+    void invalidate()
+    {
+        bool locked = acquire_sem_etc(m_state->lock, 1, B_RELATIVE_TIMEOUT, 30000) == B_OK;
+        m_state->generation++;
+        if (locked)
+            release_sem(m_state->lock);
+    }
+
+private:
+    DirectPresentTargetHaiku()
+    {
+        void* address = nullptr;
+        m_area = create_area("direct present target", &address, B_ANY_ADDRESS, B_PAGE_SIZE, B_NO_LOCK,
+            B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA);
+        if (m_area < 0)
+            return;
+        sem_id lock = create_sem(1, "direct present lock");
+        if (lock < 0) {
+            delete_area(m_area);
+            m_area = -1;
+            return;
+        }
+        std::memset(address, 0, B_PAGE_SIZE);
+        m_state = new (address) DirectPresentStateHaiku;
+        m_state->magic = DirectPresentStateHaiku::magicValue;
+        m_state->lock = lock;
+        m_state->backArea = -1;
+    }
+
+    area_id m_area { -1 };
+    DirectPresentStateHaiku* m_state { nullptr };
+    std::mutex m_mutex;
+    Target m_current;
+    std::atomic<bool> m_enabled { false };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.cpp b/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..48085e4c0aa01054425859cd40ad8b8322c618c4
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.cpp
@@ -0,0 +1,758 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "DownloadRegistryHaiku.h"
+
+#include "APIDownloadClient.h"
+#include "DownloadFilenameHaiku.h"
+#include "DownloadProxy.h"
+#include "WebKitContext.h"
+#include <Message.h>
+#include <WebCore/HTTPHeaderNames.h>
+#include <WebCore/ParsedContentRange.h>
+#include <WebCore/ResourceError.h>
+#include <WebCore/ResourceResponse.h>
+#include <cerrno>
+#include <cstdlib>
+#include <limits>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <utility>
+#include <wtf/FileSystem.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/RunLoop.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/text/CString.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringToIntegerConversion.h>
+
+namespace WebKit {
+
+// A separate client for every registered proxy makes late terminal callbacks
+// harmless without keeping an ever-growing set of completed download IDs.
+class DownloadClientHaiku final : public API::DownloadClient {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(DownloadClientHaiku);
+public:
+    explicit DownloadClientHaiku(std::weak_ptr<DownloadRegistryHaiku> registry)
+        : m_registry(std::move(registry)) { }
+
+private:
+    void decideDestinationWithSuggestedFilename(DownloadProxy& download, const WebCore::ResourceResponse& response, const String& filename, CompletionHandler<void(AllowOverwrite, String)>&& completion) override
+    {
+        if (!m_terminal) {
+            if (auto registry = m_registry.lock())
+                return registry->decideDestination(download, response, filename, WTF::move(completion));
+        }
+        completion(AllowOverwrite::No, { });
+    }
+
+    void didCreateDestination(DownloadProxy& download, const String& path) override
+    {
+        if (!m_terminal) {
+            if (auto registry = m_registry.lock())
+                registry->didCreateDestination(download, path);
+        }
+    }
+
+    void didReceiveData(DownloadProxy& download, uint64_t bytes, uint64_t, uint64_t) override
+    {
+        if (!m_terminal) {
+            if (auto registry = m_registry.lock())
+                registry->didReceiveData(download, bytes);
+        }
+    }
+
+    void didFinish(DownloadProxy& download) override
+    {
+        if (std::exchange(m_terminal, true))
+            return;
+        if (auto registry = m_registry.lock())
+            registry->didFinish(download);
+    }
+
+    void didFail(DownloadProxy& download, const WebCore::ResourceError& error, API::Data*) override
+    {
+        if (std::exchange(m_terminal, true))
+            return;
+        if (auto registry = m_registry.lock())
+            registry->didFail(download, error);
+    }
+
+    void processDidCrash(DownloadProxy& download) override
+    {
+        // A finish received after cancel was issued deliberately retains the
+        // registry entry until the cancel reply. Invalidation must release that
+        // entry even though a previous terminal callback set m_terminal.
+        m_terminal = true;
+        if (auto registry = m_registry.lock())
+            registry->processDidCrash(download);
+    }
+
+    const std::weak_ptr<DownloadRegistryHaiku> m_registry;
+    bool m_terminal { false };
+};
+
+// WebProcessPool installs this client when it constructs each DownloadProxy.
+// DidStart precedes response/redirect/data IPC in PendingDownload. Registering
+// here also covers downloads whose originating page has already gone away.
+class DownloadBootstrapClientHaiku final : public API::DownloadClient {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(DownloadBootstrapClientHaiku);
+public:
+    explicit DownloadBootstrapClientHaiku(std::weak_ptr<DownloadRegistryHaiku> registry)
+        : m_registry(std::move(registry)) { }
+
+private:
+    void legacyDidStart(DownloadProxy& download) override
+    {
+        if (auto registry = m_registry.lock())
+            registry->registerDownload(download);
+        else
+            download.cancel([](API::Data*) { });
+    }
+
+    void didFail(DownloadProxy& download, const WebCore::ResourceError& error, API::Data* data) override
+    {
+        if (auto registry = m_registry.lock()) {
+            registry->registerDownload(download);
+            download.client().didFail(download, error, data);
+        }
+    }
+
+    void processDidCrash(DownloadProxy& download) override
+    {
+        if (auto registry = m_registry.lock()) {
+            registry->registerDownload(download);
+            download.client().processDidCrash(download);
+        }
+    }
+
+    const std::weak_ptr<DownloadRegistryHaiku> m_registry;
+};
+
+// What If-Range can name: a strong ETag (a weak one never matches a range),
+// else the Last-Modified date.
+static String validatorOf(const WebCore::ResourceResponse& response)
+{
+    auto etag = response.httpHeaderField(WebCore::HTTPHeaderName::ETag).trim(isASCIIWhitespace<char16_t>);
+    if (!etag.isEmpty() && !etag.startsWith("W/"_s))
+        return etag;
+    return response.httpHeaderField(WebCore::HTTPHeaderName::LastModified).trim(isASCIIWhitespace<char16_t>);
+}
+
+static bool acceptsByteRanges(const WebCore::ResourceResponse& response)
+{
+    if (response.httpStatusCode() == 206)
+        return true;
+    for (auto unit : response.httpHeaderField(WebCore::HTTPHeaderName::AcceptRanges).split(',')) {
+        if (equalLettersIgnoringASCIICase(unit.trim(isASCIIWhitespace<char16_t>), "bytes"_s))
+            return true;
+    }
+    return false;
+}
+
+// The size a 416 answer gives ("Content-Range: bytes */1234").
+static std::optional<uint64_t> unsatisfiedRangeLength(const WebCore::ResourceResponse& response)
+{
+    auto value = response.httpHeaderField(WebCore::HTTPHeaderName::ContentRange).trim(isASCIIWhitespace<char16_t>);
+    if (!value.startsWith("bytes */"_s))
+        return std::nullopt;
+    return parseInteger<uint64_t>(StringView(value).substring(8));
+}
+
+struct DownloadRegistryHaiku::Entry {
+    explicit Entry(DownloadProxy& proxy, const BMessenger& listener, const String& directory)
+        : download(proxy), target(listener), directory(directory) { }
+
+    Ref<DownloadProxy> download;
+    const BMessenger target;
+    const String directory;
+    BMessenger view;
+    String requestedFilename;
+    String destination;
+    String responseURL;
+    String mimeType;
+    uint64_t currentSize { 0 };
+    int64_t expectedSize { -1 };
+    // The network process created the destination, or the host gave it (a
+    // resumed download): it is removed unless kept for resuming.
+    bool ownsFile { false };
+    bool keepFile { false };
+    bool partial { false };
+    std::optional<Resume> resume;
+    std::optional<uint64_t> resumedFrom;
+    uint64_t continues { 0 };
+    Destination choice { Destination::Unique };
+    // The engine's question while the host chooses a destination.
+    CompletionHandler<void(AllowOverwrite, String)> pendingDestination;
+    bool restarted { false };
+    bool answered { false };
+    String validator;
+    bool acceptsRanges { false };
+    MonotonicTime lastProgress;
+    bool cancelling { false };
+    bool cancelIssued { false };
+    uint32_t cancelResult { B_WEBKIT_DOWNLOAD_CANCELLED };
+    int32_t cancelError { B_CANCELED };
+    String cancelDomain { "HaikuDownload"_s };
+    String cancelDescription;
+};
