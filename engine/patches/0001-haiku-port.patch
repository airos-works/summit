+// Where the monitors' scans are, for the presents into the frame buffer on
+// AMD's GPUs (#82). Nothing timed those copies: one made while the scan
+// passed through the page showed the top of one frame and the bottom of the
+// next, and while the page scrolled the line between them flickered across
+// it (haiku#39: programs cannot get an output's blanks from app_server).
+// amdgpu_drm's KMS node answers any program, though: each CRTC's place in
+// the frame buffer, its timing, and when its last vertical blank ended,
+// exact to a line, so where its scan is at any moment. A present starts its
+// copy only where the copy will be done before the scan reaches the rows it
+// writes, else it waits until the scan has just left them; the copy, a GPU
+// blit many times faster than the scan, then stays ahead of it, as
+// app_server's own copies do (its vertical blank flush).
+// SUMMIT_DIRECT_PRESENT_SCAN_TIMING=0 turns it off; SUMMIT_SCAN_MARGIN_US is
+// the time a copy may take to start (300 by default), on top of how long the
+// last copies took.
+class ScanTimingHaiku {
+    WTF_MAKE_NONCOPYABLE(ScanTimingHaiku);
+public:
+    // Null where presents are not timed.
+    static ScanTimingHaiku* singleton()
+    {
+        static ScanTimingHaiku* timing = [] () -> ScanTimingHaiku* {
+            const char* value = getenv("SUMMIT_DIRECT_PRESENT_SCAN_TIMING");
+            if (value ? !strcmp(value, "0") : !usesRadvHaiku())
+                return nullptr;
+            int device = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+            if (device < 0) {
+                std::fprintf(stderr, "Summit direct present: no KMS node (%s); presents are not timed to the scan\n", strerror(errno));
+                return nullptr;
+            }
+            // Opened while no one held the display (app_server starting), the
+            // node would make this process its master.
+            ioctl(device, linuxIoctl(0, 0x1f, 0));
+            auto* timing = new ScanTimingHaiku(device);
+            if (const char* margin = getenv("SUMMIT_SCAN_MARGIN_US"))
+                timing->m_startMicros = std::clamp(atoi(margin), 0, 8000);
+            return timing;
+        }();
+        return timing;
+    }
+
+    // Until a copy into the rectangle (frame buffer pixels, edges included)
+    // that takes copyMicros can be made out of the way of the scan of the
+    // monitor showing most of it. Returns how long it waited (microseconds).
+    bigtime_t waitUntilClear(int32_t left, int32_t top, int32_t right, int32_t bottom, bigtime_t copyMicros)
+    {
+        std::optional<Crtc> best;
+        {
+            std::lock_guard guard(m_lock);
+            if (m_failed)
+                return 0;
+            if (system_time() - m_refreshed > 1000000)
+                refresh();
+            int64_t bestArea = 0;
+            for (auto& crtc : m_crtcs) {
+                int64_t width = std::min(right + 1, crtc.x + crtc.width) - std::max(left, crtc.x);
+                int64_t height = std::min(bottom + 1, crtc.y + crtc.height) - std::max(top, crtc.y);
+                if (width > 0 && height > 0 && width * height > bestArea) {
+                    bestArea = width * height;
+                    best = crtc;
+                }
+            }
+        }
+        if (!best)
+            return 0;
+        const double first = std::max(0, top - best->y);
+        const double end = std::min(best->height, bottom + 1 - best->y);
+        if (first >= end)
+            return 0;
+
+        DrmWaitVBlank query { };
+        query.request.type = vblankRelative | ((best->index << 1) & 0x3e);
+        query.request.sequence = 0;
+        if (ioctl(m_device, linuxIoctl(3, 0x3a, sizeof(DrmWaitVBlank)), &query) != 0) {
+            std::lock_guard guard(m_lock);
+            if (++m_errors == 10) {
+                m_failed = true;
+                std::fprintf(stderr, "Summit direct present: the KMS node gives no blank times (%s); presents are not timed to the scan\n", strerror(errno));
+            }
+            return 0;
+        }
+        const bigtime_t scanStart = bigtime_t(query.reply.tvalSeconds) * 1000000 + query.reply.tvalMicroseconds;
+        const double lineMicros = double(best->htotal) * 1000 / best->clock;
+        const bigtime_t now = system_time();
+        // The scan's row now: negative while the blank before row 0 lasts.
+        double line = std::fmod((now - scanStart) / lineMicros, double(best->vtotal));
+        if (line < 0)
+            line += best->vtotal;
+        if (line >= best->height)
+            line -= best->vtotal;
+        const double margin = (m_startMicros + copyMicros) / lineMicros;
+        // Rows still to scan before the scan reaches the first of them.
+        const double ahead = line < first ? first - line : best->vtotal - line + first;
+        if ((line < first || line >= end) && ahead >= margin)
+            return 0;
+        // A page too tall for the blank (one filling the screen) is copied
+        // from there all the same: the copy is faster than the scan.
+        const double toEnd = line < end ? end - line : best->vtotal - line + end;
+        const bigtime_t wait = static_cast<bigtime_t>(toEnd * lineMicros) + 1;
+        snooze(wait);
+        return wait;
+    }
+
+private:
+    explicit ScanTimingHaiku(int device)
+        : m_device(device)
+    {
+    }
+
+    // Linux's ioctl numbers, which amdgpu_drm decodes (Haiku's BSD macros
+    // encode them differently).
+    static constexpr unsigned long linuxIoctl(unsigned direction, unsigned number, size_t size)
+    {
+        return (static_cast<unsigned long>(direction) << 30) | (size << 16) | ('d' << 8) | number;
+    }
+
+    // Linux's DRM structures (uapi drm.h, drm_mode.h).
+    static constexpr uint32_t vblankRelative = 0x1;
+    union DrmWaitVBlank {
+        struct {
+            uint32_t type;
+            uint32_t sequence;
+            unsigned long signal;
+        } request;
+        struct {
+            uint32_t type;
+            uint32_t sequence;
+            long tvalSeconds;
+            long tvalMicroseconds;
+        } reply;
+    };
+    struct DrmCardResources {
+        uint64_t framebuffers, crtcs, connectors, encoders;
+        uint32_t framebufferCount, crtcCount, connectorCount, encoderCount;
+        uint32_t minimumWidth, maximumWidth, minimumHeight, maximumHeight;
+    };
+    struct DrmModeInfo {
+        uint32_t clock;
+        uint16_t hdisplay, hsyncStart, hsyncEnd, htotal, hskew;
+        uint16_t vdisplay, vsyncStart, vsyncEnd, vtotal, vscan;
+        uint32_t vrefresh, flags, type;
+        char name[32];
+    };
+    struct DrmCrtc {
+        uint64_t connectors;
+        uint32_t connectorCount, crtcID, framebufferID, x, y, gammaSize, modeValid;
+        DrmModeInfo mode;
+    };
+    static_assert(sizeof(DrmCardResources) == 64 && sizeof(DrmModeInfo) == 68 && sizeof(DrmCrtc) == 104);
+
+    // A monitor being scanned out: its part of the frame buffer and timing.
+    struct Crtc {
+        uint32_t index;
+        int32_t x, y, width, height;
+        uint32_t clock, htotal, vtotal;
+    };
+
+    // The CRTCs as they are now; once a second, for a changed layout or mode.
+    void refresh()
+    {
+        m_refreshed = system_time();
+        m_crtcs.clear();
+        DrmCardResources counts { };
+        if (ioctl(m_device, linuxIoctl(3, 0xa0, sizeof(DrmCardResources)), &counts) != 0)
+            return;
+        uint32_t ids[32] = { };
+        DrmCardResources resources { };
+        resources.crtcCount = std::min<uint32_t>(counts.crtcCount, 32);
+        resources.crtcs = reinterpret_cast<uintptr_t>(ids);
+        if (ioctl(m_device, linuxIoctl(3, 0xa0, sizeof(DrmCardResources)), &resources) != 0)
+            return;
+        for (uint32_t i = 0; i < std::min<uint32_t>(resources.crtcCount, 32); ++i) {
+            DrmCrtc crtc { };
+            crtc.crtcID = ids[i];
+            if (ioctl(m_device, linuxIoctl(3, 0xa1, sizeof(DrmCrtc)), &crtc) != 0 || !crtc.modeValid
+                || !crtc.mode.clock || !crtc.mode.htotal || crtc.mode.vtotal <= crtc.mode.vdisplay || !crtc.mode.vdisplay)
+                continue;
+            m_crtcs.append({ i, static_cast<int32_t>(crtc.x), static_cast<int32_t>(crtc.y), crtc.mode.hdisplay, crtc.mode.vdisplay,
+                crtc.mode.clock, crtc.mode.htotal, crtc.mode.vtotal });
+        }
+    }
+
+    int m_device;
+    int m_startMicros { 300 };
+    std::mutex m_lock;
+    Vector<Crtc, 4> m_crtcs;
+    bigtime_t m_refreshed { 0 };
+    unsigned m_errors { 0 };
+    bool m_failed { false };
+};
+
+// Copies composited frames straight into the screen where the UI process
+// says the page is (DirectPresentHaiku.h), through Summit's private Mesa
+// (patch 06, summit_haiku_present_framebuffer in libEGL_mesa). Compositing
+// thread, apart from the destructor.
+class DirectPresenterHaiku {
+    WTF_MAKE_NONCOPYABLE(DirectPresenterHaiku);
+public:
+    // Whether this process's libEGL_mesa has Summit's present entry points.
+    static bool canPresent() { return functions().present != nullptr; }
+
+    static std::unique_ptr<DirectPresenterHaiku> create(area_id source)
+    {
+        std::unique_ptr<DirectPresenterHaiku> presenter(new DirectPresenterHaiku);
+        void* address = nullptr;
+        presenter->m_clone = clone_area("direct present target", &address, B_ANY_ADDRESS, B_READ_AREA | B_WRITE_AREA, source);
+        if (presenter->m_clone < 0)
+            return nullptr;
+        presenter->m_state = static_cast<DirectPresentStateHaiku*>(address);
+        if (presenter->m_state->magic != DirectPresentStateHaiku::magicValue)
+            return nullptr;
+        return presenter;
+    }
+
+    ~DirectPresenterHaiku()
+    {
+        // The GPU's completion callbacks write into the shared state.
+        if (m_presentedAny && functions().waitIdle)
+            functions().waitIdle();
+        // The last presenter of the process lets Mesa give up the frame buffer
+        // and app_server's copy while nothing is in flight: the driver tearing
+        // those imports down with a copy still running has hung the machine,
+        // and a process that ends with them held tears them down that way.
+        if (!--liveCount() && functions().release)
+            functions().release();
+        if (m_clone >= 0)
+            delete_area(m_clone);
+    }
+
+    bool wanted() const { return m_state->enabled && functions().present; }
+    // Whether presents also write app_server's copy of the screen (one that
+    // cannot write it fails, and that frame is read back).
+    bool writesAppServerCopy() const { return m_backBits; }
+
+    // With the frame's framebuffer object bound for drawing. damage is what
+    // changed since the screen last got a frame, in the frame's pixels.
+    bool present(unsigned framebuffer, const IntSize& frameSize, const Vector<IntRect, 1>& damage)
+    {
+        auto present = functions().present;
+        if (!present || !m_state->enabled)
+            return false;
+        // Timed to the scan (ScanTimingHaiku): the frame's drawing is finished
+        // first, so that the copy runs when it is submitted, at a moment
+        // chosen for it. The target is read without the lock: only the
+        // moment depends on it.
+        bigtime_t scanWait = 0;
+        if (auto* timing = ScanTimingHaiku::singleton()) {
+            if (auto bounds = boundsForTiming(damage)) {
+                glFinish();
+                scanWait = timing->waitUntilClear((*bounds)[0], (*bounds)[1], (*bounds)[2], (*bounds)[3], m_completion.copyMicros());
+            }
+        }
+        // The UI process holds the lock only while it changes the target.
+        const bigtime_t lockStart = system_time();
+        if (acquire_sem_etc(m_state->lock, 1, B_RELATIVE_TIMEOUT, 20000) != B_OK)
+            return false;
+        const bigtime_t locked = system_time();
+        auto release = makeScopeExit([this] { release_sem(m_state->lock); });
+        if (!m_state->enabled)
+            return false;
+
+        if (m_state->backArea != m_backSource) {
+            m_backSource = m_state->backArea;
+            m_backBits = backBufferMappingHaiku(m_backSource);
+        }
+
+        // A changed place is presented in full: the screen holds nothing of
+        // the page in a part that has just become visible. So is a new
+        // presenter's first frame: the state is the view's, and the process
+        // that presented into it last (before a navigation to another site,
+        // say) showed another page.
+        bool full = !m_presentedAny || m_state->generation != m_state->presentedGeneration.load();
+        uint32_t visibleCount = std::min(m_state->rectCount, DirectPresentStateHaiku::maximumRects);
+        m_rects.clear();
+        // Damage from several frames may repeat the same video rectangle.
+        // Each copy region is real GPU work; unite them before clipping so
+        // every changed pixel is copied only once per visible rectangle.
+        static const bool coalescesDamage = [] {
+            const char* value = getenv("SUMMIT_DIRECT_COALESCE_DAMAGE");
+            return !value || strcmp(value, "0");
+        }();
+        Vector<IntRect, 1> damageRects;
+        if (!full && coalescesDamage) {
+            Region changed;
+            for (auto& rect : damage)
+                changed.unite(rect);
+            damageRects = changed.rects();
+        } else
+            damageRects = damage;
+        for (uint32_t i = 0; i < visibleCount; ++i) {
+            const int32_t* visible = m_state->rects + i * 4;
+            if (full) {
+                m_rects.append({ visible[0], visible[1], visible[2], visible[3] });
+                continue;
+            }
+            for (auto& rect : damageRects) {
+                int32_t left = std::max(visible[0], m_state->originX + rect.x());
+                int32_t top = std::max(visible[1], m_state->originY + rect.y());
+                int32_t right = std::min(visible[2], m_state->originX + rect.maxX() - 1);
+                int32_t bottom = std::min(visible[3], m_state->originY + rect.maxY() - 1);
+                if (left <= right && top <= bottom)
+                    m_rects.append({ left, top, right, bottom });
+            }
+        }
+        // Mesa takes 256 rectangles; past that, each visible one whole.
+        if (m_rects.size() > 256) {
+            m_rects.clear();
+            for (uint32_t i = 0; i < visibleCount; ++i) {
+                const int32_t* visible = m_state->rects + i * 4;
+                m_rects.append({ visible[0], visible[1], visible[2], visible[3] });
+            }
+        }
+
+        SummitHaikuPresent request { };
+        request.version = 1;
+        request.originX = m_state->originX;
+        request.originY = m_state->originY;
+        request.rectCount = m_rects.size();
+        request.rects = m_rects.isEmpty() ? nullptr : &m_rects[0][0];
+        request.frontBytesPerRow = m_state->frontBytesPerRow;
+        if (m_backBits) {
+            request.backBits = m_backBits;
+            request.backBytesPerRow = m_state->backBytesPerRow;
+            request.backWidth = m_state->backWidth;
+            request.backHeight = m_state->backHeight;
+        }
+        request.framesInFlight = 2;
+        request.completed = [](void* cookie) { static_cast<Completion*>(cookie)->completed(); };
+        m_completion.inFlight = &m_state->inFlight;
+        m_completion.submitted = system_time();
+        request.cookie = &m_completion;
+        m_state->inFlight.fetch_add(1);
+        const bigtime_t presentStart = system_time();
+        int result = present(framebuffer, &request);
+        // -4: the driver could not import app_server's copy (an amdgpu
+        // without userptr, say), and Mesa would try again, and fail, every
+        // frame. This frame and every later one go to the screen without it,
+        // and frames through app_server keep that copy current instead.
+        if (result == -4 && m_backBits) {
+            backBufferImportFailedHaiku = true;
+            m_backBits = nullptr;
+            request.backBits = nullptr;
+            request.backBytesPerRow = 0;
+            request.backWidth = 0;
+            request.backHeight = 0;
+            std::fprintf(stderr, "Summit direct present: app_server's copy could not be imported (-4); presenting without it\n");
+            result = present(framebuffer, &request);
+        }
+        // SUMMIT_DIRECT_PRESENT_TRACE: where a slow present waited, the
+        // UI process's lock or the presents still in flight.
+        if (directPresentTraceHaiku() && system_time() - lockStart > 15000)
+            std::fprintf(stderr, "Summit direct present: slow, lock %.1f ms, present %.1f ms, %zu rectangles\n",
+                (locked - lockStart) / 1000.0, (system_time() - locked) / 1000.0, m_rects.size());
+        // -5: what changed is outside the screen; the frame is presented all the same.
+        if (result == -5) {
+            m_state->inFlight.fetch_sub(1);
+            result = 0;
+        } else if (result) {
+            m_state->inFlight.fetch_sub(1);
+            if (std::exchange(m_lastFailure, result) != result)
+                std::fprintf(stderr, "Summit direct present: not presented (%d), reading frames back\n", result);
+            return false;
+        }
+        if (std::exchange(m_lastFailure, 0) || !m_presentedAny)
+            std::fprintf(stderr, "Summit direct present: presenting %dx%d frames into the screen at %d,%d\n",
+                frameSize.width(), frameSize.height(), m_state->originX, m_state->originY);
+        if (full && directPresentTraceHaiku()) {
+            double pixels = 0;
+            for (auto& rect : m_rects)
+                pixels += double(rect[2] - rect[0] + 1) * (rect[3] - rect[1] + 1);
+            std::fprintf(stderr, "Summit direct present: in full, generation %u, %zu rectangles, %.2f Mpx\n",
+                m_state->generation, m_rects.size(), pixels / 1e6);
+        }
+        m_presentedAny = true;
+        m_state->presentedGeneration = m_state->generation;
+        m_state->presents.fetch_add(1);
+        traceScanTiming(scanWait, presentStart);
+        if (PresentStageStatsHaiku::enabled()) {
+            static NeverDestroyed<PresentStageStatsHaiku> copied("pixels presented directly (web)");
+            double pixels = 0;
+            for (auto& rect : m_rects)
+                pixels += double(rect[2] - rect[0] + 1) * (rect[3] - rect[1] + 1);
+            copied.get().add(0, pixels / 1e6);
+        }
+        return true;
+    }
+
+private:
+    DirectPresenterHaiku() { ++liveCount(); }
+
+    // What a present is going to write, as one rectangle: the visible parts
+    // of the page that changed (all of them for a present in full).
+    std::optional<std::array<int32_t, 4>> boundsForTiming(const Vector<IntRect, 1>& damage) const
+    {
+        const bool full = !m_presentedAny || m_state->generation != m_state->presentedGeneration.load();
+        const uint32_t visibleCount = std::min(m_state->rectCount, DirectPresentStateHaiku::maximumRects);
+        std::optional<std::array<int32_t, 4>> bounds;
+        auto add = [&](int32_t left, int32_t top, int32_t right, int32_t bottom) {
+            if (left > right || top > bottom)
+                return;
+            if (!bounds) {
+                bounds = std::array<int32_t, 4> { left, top, right, bottom };
+                return;
+            }
+            auto& united = *bounds;
+            united = { std::min(united[0], left), std::min(united[1], top), std::max(united[2], right), std::max(united[3], bottom) };
+        };
+        for (uint32_t i = 0; i < visibleCount; ++i) {
+            const int32_t* visible = m_state->rects + i * 4;
+            if (full) {
+                add(visible[0], visible[1], visible[2], visible[3]);
+                continue;
+            }
+            for (auto& rect : damage) {
+                add(std::max(visible[0], m_state->originX + rect.x()), std::max(visible[1], m_state->originY + rect.y()),
+                    std::min(visible[2], m_state->originX + rect.maxX() - 1), std::min(visible[3], m_state->originY + rect.maxY() - 1));
+            }
+        }
+        return bounds;
+    }
+
+    // SUMMIT_DIRECT_PRESENT_TRACE: how long presents waited for the scan and
+    // how long their copies took, every 5 seconds. The copy is waited for
+    // here (only while tracing) to time it.
+    void traceScanTiming(bigtime_t scanWait, bigtime_t presented)
+    {
+        if (!directPresentTraceHaiku() || !ScanTimingHaiku::singleton())
+            return;
+        if (functions().waitIdle)
+            functions().waitIdle();
+        static std::mutex lock;
+        static bigtime_t since = 0, waitTotal = 0, waitLongest = 0, copyTotal = 0, copyLongest = 0;
+        static unsigned presents = 0, waited = 0;
+        std::lock_guard guard(lock);
+        const bigtime_t now = system_time();
+        if (!since)
+            since = now;
+        ++presents;
+        waited += scanWait > 0;
+        waitTotal += scanWait;
+        waitLongest = std::max(waitLongest, scanWait);
+        copyTotal += now - presented;
+        copyLongest = std::max(copyLongest, now - presented);
+        if (now - since < 5000000)
+            return;
+        std::fprintf(stderr, "Summit direct present: %u presents, %u waited for the scan (%.2f ms on average, longest %.2f ms), copies %.2f ms on average, longest %.2f ms\n",
+            presents, waited, waited ? waitTotal / 1000.0 / waited : 0.0, waitLongest / 1000.0, copyTotal / 1000.0 / presents, copyLongest / 1000.0);
+        since = now;
+        presents = waited = 0;
+        waitTotal = waitLongest = copyTotal = copyLongest = 0;
+    }
+    // Presenters alive in this process; compositing threads and the main one.
+    static std::atomic<int>& liveCount()
+    {
+        static std::atomic<int> count { 0 };
+        return count;
+    }
+
+    // Mirrors struct summit_haiku_present in Mesa's zink_haiku_present.h.
+    struct SummitHaikuPresent {
+        uint32_t version;
+        int32_t originX, originY;
+        uint32_t rectCount;
+        const int32_t* rects;
+        uint32_t frontBytesPerRow;
+        void* backBits;
+        uint32_t backBytesPerRow;
+        uint32_t backWidth, backHeight;
+        uint32_t framesInFlight;
+        void (*completed)(void*);
+        void* cookie;
+    };
+    struct Functions {
+        int (*present)(unsigned, const SummitHaikuPresent*) { nullptr };
+        void (*waitIdle)() { nullptr };
+        void (*release)() { nullptr };
+    };
+    // Found in the loaded libEGL_mesa: EGL's own dispatch never sees them.
+    static const Functions& functions()
+    {
+        static Functions found = [] {
+            Functions result;
+            const char* value = std::getenv("SUMMIT_DIRECT_PRESENT");
+            if (value && !std::strcmp(value, "0"))
+                return result;
+            image_info info;
+            int32 cookie = 0;
+            while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) == B_OK) {
+                if (!std::strstr(info.name, "libEGL_mesa"))
+                    continue;
+                void* present = nullptr;
+                void* waitIdle = nullptr;
+                if (get_image_symbol(info.id, "summit_haiku_present_framebuffer", B_SYMBOL_TYPE_TEXT, &present) == B_OK
+                    && get_image_symbol(info.id, "summit_haiku_present_wait_idle", B_SYMBOL_TYPE_TEXT, &waitIdle) == B_OK) {
+                    void* release = nullptr;
+                    // Without a way to let go of the imports, presenting into
+                    // app_server's copy at all is not safe (see the destructor).
+                    if (get_image_symbol(info.id, "summit_haiku_present_release", B_SYMBOL_TYPE_TEXT, &release) == B_OK) {
+                        result.present = reinterpret_cast<int (*)(unsigned, const SummitHaikuPresent*)>(present);
+                        result.waitIdle = reinterpret_cast<void (*)()>(waitIdle);
+                        result.release = reinterpret_cast<void (*)()>(release);
+                    }
+                }
+                break;
+            }
+            if (!result.present)
+                std::fprintf(stderr, "Summit direct present: libEGL_mesa has no summit_haiku_present_* (an older Mesa); frames are read back\n");
+            return result;
+        }();
+        return found;
+    }
+
+    // When the GPU finished the copies, on Mesa's thread: how long they take
+    // (the larger of the last one and a slowly falling estimate).
+    struct Completion {
+        std::atomic<int32_t>* inFlight { nullptr };
+        std::atomic<bigtime_t> submitted { 0 };
+        std::atomic<bigtime_t> estimate { 1000 };
+        void completed()
+        {
+            const bigtime_t took = std::clamp<bigtime_t>(system_time() - submitted.load(), 0, 8000);
+            estimate = std::max(took, estimate.load() * 15 / 16);
+            inFlight->fetch_sub(1);
+        }
+        bigtime_t copyMicros() const { return estimate.load(); }
+    };
+
+    area_id m_clone { -1 };
+    DirectPresentStateHaiku* m_state { nullptr };
+    Completion m_completion;
+    area_id m_backSource { -1 };
+    void* m_backBits { nullptr };
+    Vector<std::array<int32_t, 4>> m_rects;
+    int m_lastFailure { 0 };
+    bool m_presentedAny { false };
+};
+
+static bool directPresentTraceHaiku()
+{
+    static const bool enabled = [] {
+        const char* value = getenv("SUMMIT_DIRECT_PRESENT_TRACE");
+        return value && !strcmp(value, "1");
+    }();
+    return enabled;
+}
+
+void AcceleratedSurface::setDirectPresentTarget(int32_t area)
+{
+    // A target this process cannot present into (a Mesa without Summit's
+    // present entry points, such as the Raspberry Pi's) is declined with a
+    // DirectFrame for target 0, which no render target has. Until then the
+    // browser holds every FrameDone until app_server has drawn the frame and
+    // offers the target again each second: on the Pi that held scrolling to
+    // 7 frames a second.
+    if (area >= 0 && !DirectPresenterHaiku::canPresent()) {
+        m_directPresenter = nullptr;
+        WebProcess::singleton().parentProcessConnection()->send(Messages::AcceleratedBackingStore::DirectFrame(0), surfaceID());
+        return;
+    }
+    m_directPresenter = area >= 0 ? DirectPresenterHaiku::create(area) : nullptr;
+    if (directPresentTraceHaiku())
+        std::fprintf(stderr, "Summit direct present: surface %llu target area %d: %s, wanted %d\n", static_cast<unsigned long long>(surfaceID()),
+            static_cast<int>(area), m_directPresenter ? "presenter" : "none", m_directPresenter && m_directPresenter->wanted());
+}
+
+void AcceleratedSurface::redisplayDirect()
 {
+    if (m_redisplayHandlerHaiku)
+        m_redisplayHandlerHaiku();
 }
 
+// A page that stops changing gets its last frame through app_server
+// (didRenderFrame()). Where every direct present writes app_server's copy
+// too, that waits until the page has really stopped: it is looked at again
+// while the page goes on changing.
+void AcceleratedSurface::scheduleLastFrameThroughAppServerHaiku(Seconds delay)
+{
+    if (!m_compositingRunLoop)
+        return;
+    m_compositingRunLoop->dispatchAfter(delay, [weakThis = ThreadSafeWeakPtr { *this }] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis || !protectedThis->m_directPagesPendingHaiku || !protectedThis->m_redisplayHandlerHaiku)
+            return;
+        auto quietFor = MonotonicTime::now() - protectedThis->m_lastChangedDirectFrameHaiku;
+        if (protectedThis->m_directPresenter && protectedThis->m_directPresenter->writesAppServerCopy() && quietFor < 250_ms) {
+            protectedThis->scheduleLastFrameThroughAppServerHaiku(300_ms - quietFor);
+            return;
+        }
+        protectedThis->m_lastFrameThroughAppServerRequestedHaiku = true;
+        protectedThis->m_redisplayHandlerHaiku();
+    });
+}
