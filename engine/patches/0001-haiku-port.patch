+void WebView::setCursor(const Cursor& cursor)
+{
+    // BCursor::Archive and BCursor(BMessage*) are unimplemented, even for
+    // system cursors. Send the keyword or actual pixels to the view instead.
+    BMessage message(viewCursorHaiku);
+    message.AddUInt32("cursor_type", static_cast<uint32>(cursor.type()));
+    if (cursor.type() == Cursor::Type::Custom) {
+        RefPtr image = cursor.image();
+        float scale = 1;
+#if ENABLE(MOUSE_CURSOR_SCALE)
+        scale = cursor.imageScaleFactor();
+#endif
+        // The image scale belongs to image-set()/SVG rasterization. The hot
+        // spot is already in CSS coordinates (as in CursorMac). BCursor takes
+        // logical pixels; air/OS app_server scales both the bitmap and hot spot
+        // for the display. Multiplying by deviceScaleFactor here doubles that.
+        if (image && std::isfinite(scale) && scale > 0) {
+            FloatSize size = image->size() / scale;
+            // Match WebCore's 128 CSS pixel cursor limit and bound allocations
+            // independently of the untrusted cursor arriving over process IPC.
+            if (std::isfinite(size.width()) && std::isfinite(size.height())
+                && size.width() > 0 && size.height() > 0 && size.width() <= 128 && size.height() <= 128) {
+                IntSize pixelsSize = expandedIntSize(size);
+                RefPtr buffer = ImageBuffer::create(FloatSize(pixelsSize), RenderingMode::Unaccelerated,
+                    RenderingPurpose::DOM, 1, ColorSpace::SRGB(), PixelFormat::BGRA8);
+                if (buffer) {
+                    buffer->context().drawImage(*image, ConcreteObjectSize::fixed(image->size()),
+                        FloatRect { FloatPoint { }, size });
+                    // app_server blends cursor channels as premultiplied data.
+                    auto pixels = buffer->getPixelBuffer({ AlphaPremultiplication::Premultiplied,
+                        PixelFormat::BGRA8, ColorSpace::SRGB() }, IntRect { IntPoint { }, pixelsSize });
+                    if (pixels && pixels->bytes().size() == static_cast<size_t>(pixelsSize.width() * pixelsSize.height() * 4)) {
+                        message.AddInt32("width", pixelsSize.width());
+                        message.AddInt32("height", pixelsSize.height());
+                        message.AddPoint("hotspot", BPoint(std::clamp(cursor.hotSpot().x(), 0, pixelsSize.width() - 1),
+                            std::clamp(cursor.hotSpot().y(), 0, pixelsSize.height() - 1)));
+                        message.AddData("pixels", B_RAW_TYPE, pixels->bytes().data(), pixels->bytes().size());
+                    }
+                }
+            }
+        }
+    }
+    sendToView(message);
+}
