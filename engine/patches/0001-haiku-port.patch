+template<typename Wrapper> static JSC::JSValue cachedDataView(JSC::JSGlobalObject& global, const Wrapper& wrapper)
+{
+    auto scope = DECLARE_THROW_SCOPE(global.vm());
+    return cachedPropertyValue(scope, global, wrapper, wrapper.wrapped().cachedValue(), [&](JSC::ThrowScope&) {
+        return toJS<IDLNullable<IDLDataView>>(global, *wrapper.realm(), wrapper.wrapped().value());
+    });
+}
+JSC::JSValue JSBluetoothRemoteGATTCharacteristic::value(JSC::JSGlobalObject& global) const { return cachedDataView(global, *this); }
+JSC::JSValue JSBluetoothRemoteGATTDescriptor::value(JSC::JSGlobalObject& global) const { return cachedDataView(global, *this); }
+template<typename Visitor> void JSBluetoothRemoteGATTCharacteristic::visitAdditionalChildrenInGCThread(Visitor& visitor) { wrapped().cachedValue().visitInGCThread(visitor); }
+template<typename Visitor> void JSBluetoothRemoteGATTDescriptor::visitAdditionalChildrenInGCThread(Visitor& visitor) { wrapped().cachedValue().visitInGCThread(visitor); }
+DEFINE_VISIT_ADDITIONAL_CHILDREN_IN_GC_THREAD(JSBluetoothRemoteGATTCharacteristic);
+DEFINE_VISIT_ADDITIONAL_CHILDREN_IN_GC_THREAD(JSBluetoothRemoteGATTDescriptor);
+template<typename T, typename Wrapper> static void resolveValue(T& object, Ref<DeferredPromise>&& promise)
+{
+    promise->resolveWithCallback([&](JSDOMGlobalObject& global) {
+        auto value = toJS<IDLInterface<T>>(global, global, object);
+        auto* wrapper = dynamicDowncast<Wrapper>(value);
+        return wrapper ? cachedDataView(global, *wrapper) : JSC::jsNull();
+    });
+}
+void BluetoothRemoteGATTCharacteristic::setValue(Vector<uint8_t>&& bytes)
+{ m_value = JSC::DataView::create(JSC::ArrayBuffer::create(bytes.span())); m_cachedValue.clear(); }
+void BluetoothRemoteGATTCharacteristic::readValue(Ref<DeferredPromise>&& promise)
+{
+    m_service->device().perform(m_service->generation(), arguments("read"_s), { }, [self = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&& bytes, auto) mutable {
+        if (result.hasException()) { promise->reject(result.releaseException()); return; }
+        self->setValue(WTF::move(bytes));
+        // Resolve with the same cached DataView exposed by .value, including
+        // when a listener reads that property during the value-change event.
+        resolveValue<BluetoothRemoteGATTCharacteristic, JSBluetoothRemoteGATTCharacteristic>(self, WTF::move(promise));
+        self->dispatchEvent(Event::create(eventNames().characteristicvaluechangedEvent, Event::CanBubble::Yes, Event::IsCancelable::No));
+    });
+}
+void BluetoothRemoteGATTCharacteristic::write(BufferSource&& value, bool response, DOMPromiseDeferred<void>&& promise)
+{
+    if (value.byteLength() > 512) { promise.reject(ExceptionCode::InvalidModificationError, "Bluetooth attributes are limited to 512 bytes"_s); return; }
+    auto args = arguments("write"_s); args->setBoolean("response"_s, response);
+    m_service->device().perform(m_service->generation(), WTF::move(args), Vector<uint8_t>(value.span()), [self = Ref { *this }, value = Vector<uint8_t>(value.span()), promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        self->setValue(WTF::move(value)); promise.resolve();
+    });
+}
+void BluetoothRemoteGATTCharacteristic::writeValue(BufferSource&& value, DOMPromiseDeferred<void>&& promise) { write(WTF::move(value), m_properties->write(), WTF::move(promise)); }
+void BluetoothRemoteGATTCharacteristic::writeValueWithResponse(BufferSource&& value, DOMPromiseDeferred<void>&& promise) { write(WTF::move(value), true, WTF::move(promise)); }
+void BluetoothRemoteGATTCharacteristic::writeValueWithoutResponse(BufferSource&& value, DOMPromiseDeferred<void>&& promise) { write(WTF::move(value), false, WTF::move(promise)); }
+void BluetoothRemoteGATTCharacteristic::setNotifications(bool enabled, DOMPromiseDeferred<IDLInterface<BluetoothRemoteGATTCharacteristic>>&& promise)
+{
+    auto args = arguments("notifications"_s); args->setBoolean("enable"_s, enabled);
+    m_service->device().perform(m_service->generation(), WTF::move(args), { }, [self = Ref { *this }, enabled, promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        self->m_notifying = enabled; promise.resolve(self.copyRef());
+    });
+}
+void BluetoothRemoteGATTCharacteristic::startNotifications(DOMPromiseDeferred<IDLInterface<BluetoothRemoteGATTCharacteristic>>&& promise) { setNotifications(true, WTF::move(promise)); }
+void BluetoothRemoteGATTCharacteristic::stopNotifications(DOMPromiseDeferred<IDLInterface<BluetoothRemoteGATTCharacteristic>>&& promise) { setNotifications(false, WTF::move(promise)); }
+void BluetoothRemoteGATTCharacteristic::notification(Vector<uint8_t>&& bytes)
+{
+    if (!m_notifying || !m_service->device().connected()) return;
+    setValue(WTF::move(bytes)); dispatchEvent(Event::create(eventNames().characteristicvaluechangedEvent, Event::CanBubble::Yes, Event::IsCancelable::No));
+}
+void BluetoothRemoteGATTCharacteristic::dispatchEvent(Event& event)
+{
+    Ref protectedThis { *this }; RefPtr bluetooth = m_service->device().bluetooth();
+    if (bluetooth) EventDispatcher::dispatchEvent(std::initializer_list<EventTarget*> { this, m_service.ptr(), &m_service->device(), bluetooth.get() }, event);
+    else EventDispatcher::dispatchEvent(std::initializer_list<EventTarget*> { this, m_service.ptr(), &m_service->device() }, event);
+}
+
+BluetoothRemoteGATTDescriptor::BluetoothRemoteGATTDescriptor(BluetoothRemoteGATTCharacteristic& characteristic, Ref<JSON::Object>&& data)
+    : m_characteristic(characteristic), m_uuid(data->getString("uuid"_s)), m_handle(data->getInteger("handle"_s).value_or(0)) { }
+Ref<JSON::Object> BluetoothRemoteGATTDescriptor::arguments(ASCIILiteral operation) const
+{
+    auto args = m_characteristic->service().device().arguments(operation); args->setInteger("handle"_s, m_handle); args->setBoolean("descriptor"_s, true); return args;
+}
+void BluetoothRemoteGATTDescriptor::setValue(Vector<uint8_t>&& bytes)
+{ m_value = JSC::DataView::create(JSC::ArrayBuffer::create(bytes.span())); m_cachedValue.clear(); }
+void BluetoothRemoteGATTDescriptor::readValue(Ref<DeferredPromise>&& promise)
+{
+    auto& service = m_characteristic->service();
+    service.device().perform(service.generation(), arguments("read"_s), { }, [self = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&& bytes, auto) mutable {
+        if (result.hasException()) { promise->reject(result.releaseException()); return; }
+        self->setValue(WTF::move(bytes));
+        resolveValue<BluetoothRemoteGATTDescriptor, JSBluetoothRemoteGATTDescriptor>(self, WTF::move(promise));
+    });
+}
+void BluetoothRemoteGATTDescriptor::writeValue(BufferSource&& value, DOMPromiseDeferred<void>&& promise)
+{
+    if (value.byteLength() > 512) { promise.reject(ExceptionCode::InvalidModificationError, "Bluetooth attributes are limited to 512 bytes"_s); return; }
+    auto& service = m_characteristic->service(); auto args = arguments("write"_s); args->setBoolean("response"_s, true);
+    service.device().perform(service.generation(), WTF::move(args), Vector<uint8_t>(value.span()), [self = Ref { *this }, value = Vector<uint8_t>(value.span()), promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        self->setValue(WTF::move(value)); promise.resolve();
+    });
+}
