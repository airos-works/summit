+static std::optional<Path> intersectHitRegionPath(const Path& source, const AffineTransform& transform, CanvasFillRule rule, const Path* clippingPath, const IntSize& size)
+{
+    Path mapped = source;
+    mapped.transform(transform);
+    SkPath filled = *mapped.platformPath();
+    filled.setFillType(rule == CanvasFillRule::Evenodd ? SkPathFillType::kEvenOdd : SkPathFillType::kWinding);
+    SkPath clip = clippingPath ? *clippingPath->platformPath() : SkPath::Rect(SkRect::MakeWH(size.width(), size.height()));
+    SkRect first, second;
+    if (filled.isRect(&first) && clip.isRect(&second)) {
+        if (!first.intersect(second))
+            return Path { };
+        return Path { PathSkia::create(SkPath::Rect(first)) };
+    }
+    auto result = Op(filled, clip, kIntersect_SkPathOp);
+    if (!result)
+        return std::nullopt;
+    return Path { PathSkia::create(WTF::move(*result)) };
+}
+
+Ref<CanvasHitRegionClip> CanvasHitRegionClip::create(const Path& path, const AffineTransform& transform, CanvasFillRule rule, RefPtr<CanvasHitRegionClip>&& previous, const IntSize& size)
+{
+    return adoptRef(*new CanvasHitRegionClip(path, transform, rule, WTF::move(previous), size));
+}
+
+CanvasHitRegionClip::CanvasHitRegionClip(const Path& path, const AffineTransform& transform, CanvasFillRule rule, RefPtr<CanvasHitRegionClip>&& previous, const IntSize& size)
+    : m_path(path)
+    , m_transform(transform)
+    , m_previous(WTF::move(previous))
+    , m_rule(rule)
+{
+    // Bound both retained geometry and recursive resolution for code that
+    // keeps clipping without save/restore or ever using a hit region.
+    static constexpr unsigned maximumDeferredClips = 16;
+    if (m_previous) {
+        if (m_previous->m_depth >= maximumDeferredClips)
+            m_previous->resolvedPath(size);
+        m_depth = m_previous->m_depth + 1;
+    }
+}
+
+const Path& CanvasHitRegionClip::resolvedPath(const IntSize& size)
+{
+    if (!m_resolved) {
+        const Path* previousPath = m_previous ? &m_previous->resolvedPath(size) : nullptr;
+        m_path = intersectHitRegionPath(m_path, m_transform, m_rule, previousPath, size).value_or(Path { });
+        m_previous = nullptr;
+        m_depth = 1;
+        m_resolved = true;
+    }
+    return m_path;
+}
+
+std::optional<Path> CanvasRenderingContext2DBase::clippedHitRegionPath(const Path& source, CanvasFillRule rule) const
+{
+    if (!hasInvertibleTransform())
+        return std::nullopt;
+    auto size = canvasBase().size();
+    const Path* clip = state().hitRegionClip ? &state().hitRegionClip->resolvedPath(size) : nullptr;
+    return intersectHitRegionPath(source, state().transform, rule, clip, size);
+}
