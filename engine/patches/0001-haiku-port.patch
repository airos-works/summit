+std::expected<Vector<WebExtensionRegisteredScriptParameters>, String> parseWebExtensionRegisteredScripts(const Vector<Ref<JSON::Object>>& scripts, WebExtensionRegisteredScriptParseMode mode)
+{
+    Vector<WebExtensionRegisteredScriptParameters> result;
+    for (auto& script : scripts) {
+        auto invalid = [](ASCIILiteral key, ASCIILiteral message) {
+            return makeUnexpected(makeString("Invalid '"_s, key, "': "_s, message));
+        };
+        for (auto key : { "id"_s, "runAt"_s, "cssOrigin"_s, "world"_s }) {
+            if (RefPtr value = script->getValue(key); value && value->type() != JSON::Value::Type::String)
+                return invalid(key, "expected a string"_s);
+        }
+        for (auto key : { "allFrames"_s, "matchOriginAsFallback"_s, "persistAcrossSessions"_s }) {
+            if (RefPtr value = script->getValue(key); value && value->type() != JSON::Value::Type::Boolean)
+                return invalid(key, "expected a boolean"_s);
+        }
+        for (auto key : { "css"_s, "js"_s, "matches"_s, "excludeMatches"_s }) {
+            RefPtr value = script->getValue(key);
+            if (!value)
+                continue;
+            RefPtr array = value->asArray();
+            if (!array)
+                return invalid(key, "expected an array of strings"_s);
+            for (auto& item : *array) {
+                if (item->type() != JSON::Value::Type::String)
+                    return invalid(key, "expected an array of strings"_s);
+            }
+        }
+
+        WebExtensionRegisteredScriptParameters parameters;
+        parameters.identifier = script->getString("id"_s);
+        if (parameters.identifier.isEmpty())
+            return invalid("id"_s, "it must not be empty"_s);
+        if (parameters.identifier[0] == '_')
+            return invalid("id"_s, "it must not start with '_'"_s);
+
+        auto strings = [&](ASCIILiteral key) -> std::optional<Vector<String>> {
+            RefPtr array = script->getArray(key);
+            if (!array)
+                return std::nullopt;
+            Vector<String> items;
+            for (auto& item : *array)
+                items.append(item->asString());
+            return items;
+        };
+        parameters.css = strings("css"_s);
+        parameters.js = strings("js"_s);
+        parameters.matchPatterns = strings("matches"_s);
+        parameters.excludeMatchPatterns = strings("excludeMatches"_s);
+
+        bool registration = mode == WebExtensionRegisteredScriptParseMode::Registration;
+        if (registration && (!parameters.matchPatterns || parameters.matchPatterns->isEmpty()))
+            return invalid("matches"_s, "it must specify at least one match pattern"_s);
+        if (parameters.matchPatterns && parameters.matchPatterns->isEmpty())
+            return invalid("matches"_s, "it must not be empty"_s);
+        if (registration && (!parameters.js || parameters.js->isEmpty()) && (!parameters.css || parameters.css->isEmpty()))
+            return invalid("details"_s, "it must specify at least one 'css' or 'js' file"_s);
+
+        if (script->getValue("runAt"_s)) {
+            auto value = script->getString("runAt"_s);
+            if (value == "document_start"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentStart;
+            else if (value == "document_end"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentEnd;
+            else if (value == "document_idle"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentIdle;
+            else
+                return invalid("runAt"_s, "it must specify either 'document_start', 'document_end', or 'document_idle'"_s);
+        }
+        if (script->getValue("cssOrigin"_s)) {
+            auto value = script->getString("cssOrigin"_s);
+            if (equalIgnoringASCIICase(value, "user"_s))
+                parameters.styleLevel = WebCore::UserStyleLevel::User;
+            else if (equalIgnoringASCIICase(value, "author"_s))
+                parameters.styleLevel = WebCore::UserStyleLevel::Author;
+            else
+                return invalid("cssOrigin"_s, "it must specify either 'author' or 'user'"_s);
+        }
+        if (script->getValue("world"_s)) {
+            auto value = script->getString("world"_s);
+            if (equalIgnoringASCIICase(value, "main"_s))
+                parameters.world = WebExtensionContentWorldType::Main;
+            else if (equalIgnoringASCIICase(value, "isolated"_s))
+                parameters.world = WebExtensionContentWorldType::ContentScript;
+            else
+                return invalid("world"_s, "it must specify either 'isolated' or 'main'"_s);
+        }
+        parameters.allFrames = script->getBoolean("allFrames"_s);
+        if (auto matchParent = script->getBoolean("matchOriginAsFallback"_s))
+            parameters.matchParentFrame = *matchParent ? WebCore::UserContentMatchParentFrame::ForOpaqueOrigins : WebCore::UserContentMatchParentFrame::Never;
+        parameters.persistent = script->getBoolean("persistAcrossSessions"_s);
+        if (registration && !parameters.persistent)
+            parameters.persistent = true;
+        result.append(WTF::move(parameters));
+    }
+    return result;
+}
+
+#if PLATFORM(HAIKU)
+std::expected<Vector<WebExtensionRegisteredScriptParameters>, String> parseWebExtensionUserScripts(const Vector<Ref<JSON::Object>>& scripts, WebExtensionRegisteredScriptParseMode mode, WebExtensionUserScriptIdentifiers identifiers)
+{
+    // Inline code is held by the browser process and stored with the script.
+    static constexpr size_t maximumCodeLength = 32 * 1024 * 1024;
+    Vector<WebExtensionRegisteredScriptParameters> result;
+    for (auto& script : scripts) {
+        auto invalid = [](ASCIILiteral key, ASCIILiteral message) {
+            return makeUnexpected(makeString("Invalid '"_s, key, "': "_s, message));
+        };
+        for (auto key : { "id"_s, "runAt"_s, "world"_s, "worldId"_s }) {
+            if (RefPtr value = script->getValue(key); value && value->type() != JSON::Value::Type::String)
+                return invalid(key, "expected a string"_s);
+        }
+        if (RefPtr value = script->getValue("allFrames"_s); value && value->type() != JSON::Value::Type::Boolean)
+            return invalid("allFrames"_s, "expected a boolean"_s);
+
+        auto strings = [&](ASCIILiteral key) -> std::expected<std::optional<Vector<String>>, String> {
+            RefPtr value = script->getValue(key);
+            if (!value)
+                return std::optional<Vector<String>> { };
+            RefPtr array = value->asArray();
+            if (!array)
+                return invalid(key, "expected an array of strings"_s);
+            Vector<String> items;
+            for (auto& item : *array) {
+                if (item->type() != JSON::Value::Type::String)
+                    return invalid(key, "expected an array of strings"_s);
+                items.append(item->asString());
+            }
+            return std::optional { WTF::move(items) };
+        };
+
+        WebExtensionRegisteredScriptParameters parameters;
+        auto identifier = script->getString("id"_s);
+        if (identifiers == WebExtensionUserScriptIdentifiers::Stored) {
+            if (!isWebExtensionUserScriptIdentifier(identifier) || identifier.length() == webExtensionUserScriptPrefix.length())
+                return invalid("id"_s, "it is not a stored user script"_s);
+            parameters.identifier = identifier;
+        } else {
+            if (identifier.isEmpty())
+                return invalid("id"_s, "it must not be empty"_s);
+            if (identifier[0] == '_')
+                return invalid("id"_s, "it must not start with '_'"_s);
+            parameters.identifier = makeString(webExtensionUserScriptPrefix, identifier);
+        }
+
+        for (auto [key, target] : { std::pair { "matches"_s, &parameters.matchPatterns }, std::pair { "excludeMatches"_s, &parameters.excludeMatchPatterns },
+            std::pair { "includeGlobs"_s, &parameters.includeGlobs }, std::pair { "excludeGlobs"_s, &parameters.excludeGlobs } }) {
+            auto value = strings(key);
+            if (!value)
+                return makeUnexpected(value.error());
+            *target = WTF::move(*value);
+        }
+
+        if (RefPtr value = script->getValue("js"_s)) {
+            RefPtr array = value->asArray();
+            if (!array)
+                return invalid("js"_s, "expected an array of script sources"_s);
+            Vector<std::pair<String, String>> sources;
+            size_t length = 0;
+            for (auto& item : *array) {
+                RefPtr source = item->asObject();
+                if (!source)
+                    return invalid("js"_s, "expected an array of script sources"_s);
+                RefPtr file = source->getValue("file"_s);
+                RefPtr code = source->getValue("code"_s);
+                if (!file == !code)
+                    return invalid("js"_s, "each source must have exactly one of 'file' and 'code'"_s);
+                if ((file && file->type() != JSON::Value::Type::String) || (code && code->type() != JSON::Value::Type::String))
+                    return invalid("js"_s, "'file' and 'code' must be strings"_s);
+                auto text = (file ? file : code)->asString();
+                if (file && text.isEmpty())
+                    return invalid("js"_s, "a 'file' must not be empty"_s);
+                length += text.length();
+                if (length > maximumCodeLength)
+                    return invalid("js"_s, "the scripts are too long"_s);
+                sources.append(file ? std::pair { text, String { } } : std::pair { String { }, text });
+            }
+            parameters.userScriptSources = WTF::move(sources);
+        }
+
+        bool registration = mode == WebExtensionRegisteredScriptParseMode::Registration;
+        if (registration && (!parameters.matchPatterns || parameters.matchPatterns->isEmpty()))
+            return invalid("matches"_s, "it must specify at least one match pattern"_s);
+        if (registration && (!parameters.userScriptSources || parameters.userScriptSources->isEmpty()))
+            return invalid("js"_s, "it must specify at least one script source"_s);
+        if (parameters.userScriptSources && parameters.userScriptSources->isEmpty())
+            return invalid("js"_s, "it must not be empty"_s);
+
+        if (script->getValue("runAt"_s)) {
+            auto value = script->getString("runAt"_s);
+            if (value == "document_start"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentStart;
+            else if (value == "document_end"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentEnd;
+            else if (value == "document_idle"_s)
+                parameters.injectionTime = WebExtension::InjectionTime::DocumentIdle;
+            else
+                return invalid("runAt"_s, "it must specify either 'document_start', 'document_end', or 'document_idle'"_s);
+        }
+        // The USER_SCRIPT world is the extension's content script world here:
+        // Tampermonkey listens to runtime.onMessage beside onUserScriptMessage.
+        if (script->getValue("world"_s)) {
+            auto value = script->getString("world"_s);
+            if (value == "MAIN"_s)
+                parameters.world = WebExtensionContentWorldType::Main;
+            else if (value == "USER_SCRIPT"_s)
+                parameters.world = WebExtensionContentWorldType::ContentScript;
+            else
+                return invalid("world"_s, "it must specify either 'USER_SCRIPT' or 'MAIN'"_s);
+        } else if (registration)
+            parameters.world = WebExtensionContentWorldType::ContentScript;
+        parameters.allFrames = script->getBoolean("allFrames"_s);
+        parameters.persistent = true;
+        result.append(WTF::move(parameters));
+    }
+    return result;
+}
+
+Ref<JSON::Object> webExtensionUserScriptJSON(const WebExtensionRegisteredScriptParameters& parameters, WebExtensionUserScriptIdentifiers identifiers)
+{
+    Ref object = JSON::Object::create();
+    object->setString("id"_s, identifiers == WebExtensionUserScriptIdentifiers::Stored ? parameters.identifier
+        : parameters.identifier.substring(webExtensionUserScriptPrefix.length()));
+    auto strings = [&](ASCIILiteral key, const std::optional<Vector<String>>& values) {
+        if (!values)
+            return;
+        Ref array = JSON::Array::create();
+        for (auto& value : *values)
+            array->pushString(value);
+        object->setArray(key, WTF::move(array));
+    };
+    strings("matches"_s, parameters.matchPatterns);
+    strings("excludeMatches"_s, parameters.excludeMatchPatterns);
+    strings("includeGlobs"_s, parameters.includeGlobs);
+    strings("excludeGlobs"_s, parameters.excludeGlobs);
+    if (parameters.userScriptSources) {
+        Ref array = JSON::Array::create();
+        for (auto& [file, code] : *parameters.userScriptSources) {
+            Ref source = JSON::Object::create();
+            if (!file.isEmpty())
+                source->setString("file"_s, file);
+            else
+                source->setString("code"_s, code);
+            array->pushObject(WTF::move(source));
+        }
+        object->setArray("js"_s, WTF::move(array));
+    }
+    if (parameters.injectionTime) {
+        switch (*parameters.injectionTime) {
+        case WebExtension::InjectionTime::DocumentStart: object->setString("runAt"_s, "document_start"_s); break;
+        case WebExtension::InjectionTime::DocumentEnd: object->setString("runAt"_s, "document_end"_s); break;
+        case WebExtension::InjectionTime::DocumentIdle: object->setString("runAt"_s, "document_idle"_s); break;
+        }
+    }
+    if (parameters.allFrames)
+        object->setBoolean("allFrames"_s, *parameters.allFrames);
+    object->setString("world"_s, parameters.world == WebExtensionContentWorldType::Main ? "MAIN"_s : "USER_SCRIPT"_s);
+    return object;
+}
+#endif
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS)
