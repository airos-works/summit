+// Only the web's own string types: the clipboard also holds BBitmap archives
+// and application-private fields, and images reach pages as files.
+Vector<String> Pasteboard::typesForLegacyUnsafeBindings()
+{
+    Vector<String> result;
+    if (m_forDragAndDrop) {
+        m_dragData.forEachPlatformString([&](const String& type, const String&) { result.append(type); });
+        return result;
+    }
+
+    if (be_clipboard->Lock()) {
+        BMessage* data = be_clipboard->Data();
+
+        if (data) {
+            char* name;
+            uint32 type;
+            int32 count;
+
+            for (int32 i = 0; data->GetInfo(B_MIME_TYPE, i, &name, &type, &count) == B_OK; i++) {
+                if (!strncmp(name, "text/", 5) || !strncmp(name, "application/", 12))
+                    result.append(String::fromUTF8(name));
+            }
+        }
+
+        be_clipboard->Unlock();
+    }
+
+    return result;
+}
+
+Vector<String> Pasteboard::typesSafeForBindings(const String& origin)
+{
+    if (!m_forDragAndDrop)
+        return typesForLegacyUnsafeBindings();
+    OrderedHashSet<String> types;
+    if (m_dragData.origin() == origin) {
+        m_dragData.forEachCustomString([&](const String& type, const String&) { types.add(type); });
+    }
+    m_dragData.forEachPlatformString([&](const String& type, const String&) {
+        if (type == "text/plain"_s || type == "text/html"_s || type == "text/uri-list"_s)
+            types.add(type);
+    });
+    return copyToVector(types);
+}
+
+void Pasteboard::writeCustomData(const WTF::Vector<PasteboardCustomData>& data, WebCore::PasteboardWriteType)
+{
+    if (m_forDragAndDrop && !data.isEmpty()) {
+        const auto& custom = data[0];
+        m_dragData.setOrigin(custom.origin());
+        custom.forEachPlatformStringOrBuffer([&](const String& type, const auto& value) {
+            WTF::switchOn(value, [&](const String& text) { m_dragData.writeString(type, text); },
+                [&](const Ref<SharedBuffer>& buffer) { m_dragData.writeData(type, buffer.copyRef()); });
+        });
+        custom.forEachCustomString([&](const String& type, const String& value) { m_dragData.writeStringInCustomData(type, value); });
+        return;
+    }
+    if (!data.isEmpty()) {
+		const auto& customData = data[0];
+		customData.forEachPlatformString([this] (auto& type, auto& string) {
+			writeString(type, string);
+		});
+	}
+}
+
+// Files for DataTransfer.files: the files of a drop, or the clipboard's
+// image (a pasted screenshot becomes image.png).
+void Pasteboard::read(WebCore::PasteboardFileReader& reader, std::optional<unsigned long> index)
+{
+    if (m_forDragAndDrop) {
+        for (size_t i = 0; i < m_dragFileNames.size(); ++i) {
+            if (!index || *index == i)
+                reader.readFilename(m_dragFileNames[i]);
+        }
+        if (!index || *index == m_dragFileNames.size()) {
+            if (auto image = readDragImage(m_dragData); image.data && reader.shouldReadBuffer(image.type))
+                reader.readBuffer(fileNameForImageType(image.type), image.type, image.data.releaseNonNull());
+        }
+        return;
+    }
+    if (index && *index)
+        return;
+    ClipboardImage image;
+    {
+        AutoClipboardLocker locker(be_clipboard);
+        if (!locker.isLocked())
+            return;
+        image = readClipboardImage(be_clipboard->Data());
+    }
+    if (image.data && reader.shouldReadBuffer(image.type))
+        reader.readBuffer(fileNameForImageType(image.type), image.type, image.data.releaseNonNull());
+}
