+static bool presentTraceHaiku()
+{
+    static const bool enabled = [] {
+        const char* value = std::getenv("SUMMIT_SWAPCHAIN_TRACE");
+        return value && *value && std::strcmp(value, "0");
+    }();
+    return enabled;
+}
+
+// Window thread, from Draw(): app_server ends this update by copying its own
+// copy of the screen over the updated part, page and all, and that copy is
+// older than the screen wherever frames went in directly. The page is
+// presented again in full once app_server has finished (the message is
+// handled after the update ends).
+static void noteDirectExposureHaiku(BWebKitView& view, const std::shared_ptr<WebKit::WebViewStateHaiku>& state)
+{
+    if (state->directExposurePending.exchange(true))
+        return;
+    BLooper* looper = view.Looper();
+    if (!looper || looper->PostMessage(WebKit::viewDirectExposedHaiku, &view) != B_OK)
+        state->directExposurePending = false;
+}
+
+void BWebKitView::Draw(BRect update)
+{
+    UpdateGeometry();
+    bool direct = false;
+    if (m_state->presentedDirectly.load()) {
+        std::lock_guard guard(m_state->mutex);
+        direct = m_state->directTarget && m_state->directTarget->enabled();
+    }
+    // When the GPU puts the page on the screen itself, the bitmap is older
+    // than the screen. It is drawn all the same: app_server asked for this
+    // part again because its own copy of the screen holds something else
+    // there now (a window that has moved away), and at the end of the update
+    // it copies that copy onto the screen and keeps it for screenshots and
+    // for the next time it redraws. The page then goes into the screen again
+    // in full (noteDirectExposureHaiku()).
+    // A frame that goes into the screen directly while this one is drawn may
+    // land before it, and then this older one covers it.
+    uint32_t directFramesBefore = m_state->directFrames.load();
+    auto frame = m_state->presenter.snapshot();
+    if (presentTraceHaiku())
+        std::fprintf(stderr, "Summit view %p draw [%.0f,%.0f %.0fx%.0f] frame=%llu view=%dx%d hidden=%d\n", this, update.left, update.top,
+            update.Width() + 1, update.Height() + 1, frame ? static_cast<unsigned long long>(frame->identifier) : 0ULL,
+            frame ? frame->viewSize.width() : 0, frame ? frame->viewSize.height() : 0, IsHidden() ? 1 : 0);
+    PushState();
+    SetDrawingMode(B_OP_COPY);
+    BRect destination;
+    if (frame)
+        destination = BRect(0, 0, frame->viewSize.width() - 1, frame->viewSize.height() - 1);
+    // The frame is opaque, so only what it does not cover needs the base colour.
+    // A window that is being enlarged shows it until the next frame arrives.
+    if (!frame || !destination.Contains(update)) {
+        SetHighColor(255, 255, 255, 255);
+        FillRect(update);
+    }
+    if (frame) {
+        // Copy only the invalidated part. app_server charges per pixel, and a
+        // scroll or a small animation touches much less than the whole window.
+        BRect visible = update & destination;
+        if (visible.IsValid()) {
+            float scale = frame->scale > 0 ? frame->scale : 1;
+            BRect bounds = frame->image->Bounds();
+            if (scale > 1 && devicePixelBitmapsHaiku() && std::fabs(scale - displayScaleFactorHaiku()) < 0.001f) {
+                // The frame's pixels are the screen's: at 125, 150 and 175
+                // percent a logical pixel is one buffer pixel in some places and
+                // two in others, and app_server scaled the frame to fit, softly
+                // and at times a pixel off. They go one to one from the buffer
+                // pixel the update starts on, which app_server finds as
+                // floor(x * scale) in screen coordinates; the page's first pixel
+                // is the view's.
+                BPoint origin = ConvertToScreen(BPoint(0, 0));
+                auto bufferPixel = [scale](float coordinate) { return std::floor(coordinate * scale + 0.001f); };
+                float left = bufferPixel(origin.x), top = bufferPixel(origin.y);
+                BRect source(bufferPixel(origin.x + visible.left) - left, bufferPixel(origin.y + visible.top) - top,
+                    bufferPixel(origin.x + visible.right + 1) - left - 1, bufferPixel(origin.y + visible.bottom + 1) - top - 1);
+                source = source & bounds;
+                if (source.IsValid())
+                    DrawBitmap(frame->image.get(), source, visible, devicePixelBitmapHaiku);
+            } else {
+                // A frame of another scale (the desktop's changed) is scaled.
+                BRect source(visible.left * scale, visible.top * scale,
+                    (visible.right + 1) * scale - 1, (visible.bottom + 1) * scale - 1);
+                source = source & bounds;
+                if (source.IsValid())
+                    DrawBitmap(frame->image.get(), source, visible);
+            }
+        }
+    }
+    PopState();
+    if (direct) {
+        noteDirectExposureHaiku(*this, m_state);
+        return;
+    }
+    bigtime_t drawStart = PresentStageStatsHaiku::enabled() ? system_time() : 0;
+    Sync();
+    if (m_state->directFrames.load() != directFramesBefore)
+        noteDirectExposureHaiku(*this, m_state);
+    if (drawStart && frame) {
+        static PresentStageStatsHaiku draw("draw (app_server)");
+        BRect drawn = update & destination;
+        float scale = frame->scale > 0 ? frame->scale : 1;
+        draw.add(system_time() - drawStart, drawn.IsValid() ? (drawn.Width() + 1) * (drawn.Height() + 1) * scale * scale / 1e6 : 0);
+    }
+    if (frame && m_status == B_OK) {
+        if (webExtensionTimingEnabledHaiku() && Name() && !std::strcmp(Name(), "extension-popup-content"))
+            SUMMIT_EXTENSION_TIMING("popup frame %" PRIu64 " drawn (%dx%d)", static_cast<uint64_t>(frame->identifier), frame->viewSize.width(), frame->viewSize.height());
+        BMessage message(viewPresentedHaiku);
+        message.AddUInt64("identifier", frame->identifier);
+        dispatchViewMessageHaiku(m_state, std::move(message));
+    }
+}
+
+void BWebKitView::SendInput(const BMessage& event, BPoint position)
+{
+    if (m_status != B_OK || !Window())
+        return;
+    UpdateGeometry();
+    BMessage message(viewInputHaiku);
+    // SUMMIT_INPUT_DELAY_TRACE: when it left the window thread.
+    message.AddInt64("summit:sentAt", system_time());
+    BMessage native(event);
+    int32 modifierState;
+    if (native.FindInt32("modifiers", &modifierState) != B_OK)
+        native.AddInt32("modifiers", modifiers());
+    message.AddMessage("event", &native);
+    message.AddPoint("local", position);
+    message.AddPoint("screen", ConvertToScreen(position));
+    dispatchViewMessageHaiku(m_state, std::move(message));
+}
+
+void BWebKitView::KeyDown(const char* bytes, int32 length)
+{
+    if (Window() && Window()->CurrentMessage())
+        SendInput(*Window()->CurrentMessage());
+    else
+        BView::KeyDown(bytes, length);
+}
+
+void BWebKitView::KeyUp(const char* bytes, int32 length)
+{
+    if (Window() && Window()->CurrentMessage())
+        SendInput(*Window()->CurrentMessage());
+    else
+        BView::KeyUp(bytes, length);
+}
+
+void BWebKitView::MouseDown(BPoint point)
+{
+    ++m_state->nativeDropRequest;
+    MakeFocus();
+    SetMouseEventMask(B_POINTER_EVENTS, B_NO_POINTER_HISTORY);
+    if (Window() && Window()->CurrentMessage())
+        SendInput(*Window()->CurrentMessage(), point);
+}
+
+void BWebKitView::MouseUp(BPoint point)
+{
+    if (m_state->sourceDragActive)
+        return;
+    if (Window() && Window()->CurrentMessage())
+        SendInput(*Window()->CurrentMessage(), point);
+}
+
+static bool hasDirectDragDataHaiku(const BMessage& message)
+{
+    if (message.HasRef("refs") || message.HasData("org.webkit.drag-data", B_RAW_TYPE))
+        return true;
+    for (auto* type : { "text/plain", "text/html", "text/uri-list", "image/png", "image/jpeg", "image/gif", "image/webp" }) {
+        if (message.HasData(type, B_MIME_TYPE))
+            return true;
+    }
+    return false;
+}
+
+// A native image editor can offer formats without including any bytes yet.
+static const char* negotiatedDragTypeHaiku(const BMessage& message)
+{
+    for (auto* preferred : { "image/png", "image/jpeg", "image/gif", "image/webp", "text/html", "text/uri-list", "text/plain" }) {
+        const char* offered = nullptr;
+        for (int32 index = 0; message.FindString("be:types", index, &offered) == B_OK; ++index) {
+            if (!strcmp(preferred, offered))
+                return preferred;
+        }
+    }
+    return nullptr;
+}
+
+static bool isPageDragHaiku(const BMessage& message)
+{
+    return hasDirectDragDataHaiku(message) || negotiatedDragTypeHaiku(message);
+}
+
+static uint64 dragSessionHaiku(const BMessage& message)
+{
+    BMessage origin;
+    return message.FindMessage("be:originator-data", &origin) == B_OK ? origin.GetUInt64("webkit:session", 0) : 0;
+}
+
+void BWebKitView::StartDrag(const BMessage& source)
+{
+    if (!Window() || m_state->closed)
+        return;
+    BPoint point;
+    uint32 buttons = 0;
+    GetMouse(&point, &buttons, false);
+    if (auto* trace = std::getenv("SUMMIT_DRAG_TRACE"); trace && *trace == '1')
+        fprintf(stderr, "Summit drag: native source start, buttons %u, bytes %zd\n", buttons, source.FlattenedSize());
+    if (m_state->sourceDragActive)
+        FinishDrag(0, ConvertToScreen(point));
+    static std::atomic<uint64_t> nextSession { 1 };
+    m_state->sourceDragSession = nextSession.fetch_add(1);
+    m_state->sourceDragActive = true;
+    m_state->sourceDragPending = false;
+    m_state->sourceDragReleasedAt = 0;
+    m_state->sourceDragData = std::make_unique<BMessage>(source);
+    if (!(buttons & B_PRIMARY_MOUSE_BUTTON)) {
+        FinishDrag(0, ConvertToScreen(point));
+        return;
+    }
+
+    BMessage drag(source);
+    drag.what = B_SIMPLE_DATA;
+    drag.RemoveName("preview");
+    drag.RemoveName("width");
+    drag.RemoveName("height");
+    drag.RemoveName("stride");
+    drag.RemoveName("hotspot");
+    BMessage origin;
+    origin.AddUInt64("webkit:session", m_state->sourceDragSession);
+    drag.AddMessage("be:originator-data", &origin);
+    drag.AddInt32("be:actions", B_COPY_TARGET);
+    const void* bytes = nullptr;
+    ssize_t length = 0;
+    const bool image = drag.HasData("image/png", B_MIME_TYPE);
+    drag.AddString("be:clip_name", image ? "Image.png" : "Text clipping");
+    for (auto* type : { "image/png", "text/plain", "text/html" }) {
+        if (drag.HasData(type, B_MIME_TYPE)) {
+            drag.AddString("be:types", type);
+            drag.AddString("be:filetypes", type);
+            drag.AddString("be:type_descriptions", type);
+        }
+    }
+    if (drag.HasString("be:filetypes"))
+        drag.AddString("be:types", B_FILE_MIME_TYPE);
+    if (drag.FindData("text/uri-list", B_MIME_TYPE, &bytes, &length) == B_OK && length > 0) {
+        std::string url(static_cast<const char*>(bytes), length);
+        auto newline = url.find_first_of("\r\n");
+        if (newline != std::string::npos)
+            url.resize(newline);
+        if (!url.empty() && url[0] != '#')
+            drag.AddString("summit:url", url.c_str());
+    }
+
+    std::unique_ptr<BBitmap> bitmap;
+    int32 width = source.GetInt32("width", 0), height = source.GetInt32("height", 0), stride = source.GetInt32("stride", 0);
+    if (width > 0 && width <= 2048 && height > 0 && height <= 2048 && stride >= width * 4 && stride <= 16384
+        && source.FindData("preview", B_RAW_TYPE, &bytes, &length) == B_OK && length == stride * height) {
+        bitmap = std::make_unique<BBitmap>(BRect(0, 0, width - 1, height - 1), B_RGBA32);
+        if (bitmap->InitCheck() != B_OK || bitmap->ImportBits(bytes, length, stride, 0, B_RGBA32) != B_OK)
+            bitmap = nullptr;
+    }
+    m_state->sourceDragData->RemoveName("preview");
+    BPoint hotspot = source.GetPoint("hotspot", BPoint());
+    if (!std::isfinite(hotspot.x) || !std::isfinite(hotspot.y))
+        hotspot = BPoint();
+    SetMouseEventMask(B_POINTER_EVENTS, B_NO_POINTER_HISTORY);
+    if (bitmap)
+        DragMessage(&drag, bitmap.release(), B_OP_ALPHA, hotspot);
+    else
+        DragMessage(&drag, BRect(point.x - 8, point.y - 8, point.x + 8, point.y + 8));
+    dispatchViewMessageHaiku(m_state, BMessage(viewDragStartedHaiku));
+    BMessage tick(viewNativeDragTickHaiku);
+    tick.AddUInt64("session", m_state->sourceDragSession);
+    m_state->sourceDragTimer = std::make_unique<BMessageRunner>(BMessenger(this), &tick, 50000);
+}
+
+void BWebKitView::FinishDrag(uint32 operation, BPoint screenPoint)
+{
+    if (!m_state->sourceDragActive)
+        return;
+    if (auto* trace = std::getenv("SUMMIT_DRAG_TRACE"); trace && *trace == '1')
+        fprintf(stderr, "Summit drag: native source end, operation %u\n", operation);
+    m_state->sourceDragActive = false;
+    m_state->sourceDragPending = false;
+    m_state->sourceDragTimer = nullptr;
+    BMessage ended(viewDragEndedHaiku);
+    ended.AddPoint("screen", screenPoint);
+    ended.AddPoint("local", ConvertFromScreen(screenPoint));
+    auto allowed = m_state->sourceDragData ? m_state->sourceDragData->GetUInt32("operations", 0) : 0;
+    ended.AddUInt32("operation", operation & allowed);
+    dispatchViewMessageHaiku(m_state, std::move(ended));
+}
+
+void BWebKitView::MouseMoved(BPoint point, uint32 transit, const BMessage* dragMessage)
+{
+    if (dragMessage && isPageDragHaiku(*dragMessage)) {
+        if (transit == B_EXITED_VIEW || transit == B_OUTSIDE_VIEW) {
+            if (m_state->dragActive)
+                SendDrag(*dragMessage, point, "exited");
+        } else {
+            if (!m_state->dragActive)
+                ++m_state->nativeDropRequest;
+            SendDrag(*dragMessage, point, m_state->dragActive ? "updated" : "entered");
+        }
+        return;
+    }
+    if (m_state->dragActive)
+        SendDrag(BMessage(), point, "exited");
+    if (!m_state->sourceDragActive && Window() && Window()->CurrentMessage())
+        SendInput(*Window()->CurrentMessage(), point);
+}
+
+void BWebKitView::SendDrag(const BMessage& drag, BPoint point, const char* phase)
+{
+    if (m_status != B_OK || !Window())
+        return;
+    if (auto* trace = std::getenv("SUMMIT_DRAG_TRACE"); trace && *trace == '1' && strcmp(phase, "updated"))
+        fprintf(stderr, "Summit drag: destination %s\n", phase);
+    const bool entering = !strcmp(phase, "entered") || !strcmp(phase, "drop");
+    m_state->dragActive = !strcmp(phase, "entered") || !strcmp(phase, "updated");
+    UpdateGeometry();
+    BMessage message(viewDragHaiku);
+    message.AddString("phase", phase);
+    message.AddPoint("local", point);
+    message.AddPoint("screen", ConvertToScreen(point));
+    message.AddBool("copy", modifiers() & B_CONTROL_KEY);
+    if (entering) {
+        entry_ref ref;
+        for (int32 index = 0; drag.FindRef("refs", index, &ref) == B_OK; ++index) {
+            BEntry entry(&ref, true);
+            BPath path;
+            if (entry.GetPath(&path) == B_OK)
+                message.AddString("path", path.Path());
+        }
+        if (!hasDirectDragDataHaiku(drag)) {
+            if (auto* type = negotiatedDragTypeHaiku(drag))
+                message.AddString("offeredType", type);
+        }
+        const void* data = nullptr;
+        ssize_t length = 0;
+        if (drag.FindData("org.webkit.drag-data", B_RAW_TYPE, &data, &length) == B_OK && length > 0 && length <= 1024 * 1024)
+            message.AddData("org.webkit.drag-data", B_RAW_TYPE, data, length);
+        for (auto* type : { "text/plain", "text/html", "text/uri-list", "image/png", "image/jpeg", "image/gif", "image/webp" }) {
+            if (drag.FindData(type, B_MIME_TYPE, &data, &length) == B_OK && length >= 0 && length <= 16 * 1024 * 1024)
+                message.AddData(type, B_MIME_TYPE, data, length);
+        }
+        message.AddUInt32("operations", drag.GetUInt32("operations", 1 | 2 | 4));
+    }
+    if (!strcmp(phase, "drop")) {
+        MakeFocus();
+        auto session = dragSessionHaiku(drag);
+        message.AddUInt64("session", session);
+        message.AddMessenger("source", drag.ReturnAddress());
+        if (session) {
+            BMessage pending(viewNativeDragPendingHaiku);
+            pending.AddUInt64("session", session);
+            drag.ReturnAddress().SendMessage(&pending, static_cast<BHandler*>(nullptr), 0);
+        }
+    }
+    dispatchViewMessageHaiku(m_state, std::move(message));
+}
+
+// Tracker creates an empty clipping file and replies with its directory/name.
+// Refuse paths and existing nonempty files; never follow a symlink supplied as
+// the negotiated filename. Native applications can also request MIME bytes.
+static bool exportDragHaiku(BMessage& request, const BMessage& data)
+{
+    const char* type = request.GetString("be:filetypes", request.GetString("be:types", ""));
+    if (strcmp(type, "image/png") && strcmp(type, "text/plain") && strcmp(type, "text/html"))
+        return false;
+    const void* bytes = nullptr;
+    ssize_t length = 0;
+    if (data.FindData(type, B_MIME_TYPE, &bytes, &length) != B_OK || length < 0)
+        return false;
+    entry_ref directory;
+    const char* name = nullptr;
+    if (request.FindRef("directory", &directory) == B_OK && request.FindString("name", &name) == B_OK) {
+        if (!name || !*name || !strcmp(name, ".") || !strcmp(name, "..") || strchr(name, '/') || strlen(name) >= B_FILE_NAME_LENGTH)
+            return false;
+        BPath path(&directory);
+        if (path.InitCheck() != B_OK || path.Append(name) != B_OK)
+            return false;
+        int descriptor = open(path.Path(), O_WRONLY | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
+        if (descriptor < 0)
+            return false;
+        struct stat info;
+        bool success = fstat(descriptor, &info) == 0 && S_ISREG(info.st_mode) && !info.st_size;
+        size_t written = 0;
+        while (success && written < static_cast<size_t>(length)) {
+            auto count = write(descriptor, static_cast<const uint8_t*>(bytes) + written, length - written);
+            if (count <= 0) {
+                if (count < 0 && errno == EINTR)
+                    continue;
+                success = false;
+            } else
+                written += count;
+        }
+        close(descriptor);
+        if (success) {
+            BNode node(path.Path());
+            BNodeInfo(&node).SetType(type);
+        }
+        return success;
+    }
+    BMessage reply(B_MIME_DATA);
+    reply.AddData(type, B_MIME_TYPE, bytes, length);
+    return request.SendReply(&reply) == B_OK;
+}
+
+void BWebKitView::MessageReceived(BMessage* message)
+{
+    if (message->WasDropped() && isPageDragHaiku(*message)) {
+        auto requestID = ++m_state->nativeDropRequest;
+        if (!hasDirectDragDataHaiku(*message)) {
+            if (auto* type = negotiatedDragTypeHaiku(*message)) {
+                BMessage request(B_COPY_TARGET);
+                request.AddString("be:types", type);
+                request.AddUInt64("webkit:drop-request", requestID);
+                request.AddPoint("webkit:drop-screen", message->DropPoint());
+                BMessage origin;
+                if (message->FindMessage("be:originator-data", &origin) == B_OK)
+                    request.AddMessage("be:originator-data", &origin);
+                // Reply asynchronously: encoding a large image must not block
+                // the native window. BMessage::Previous carries our request.
+                m_state->dragActive = false;
+                if (message->SendReply(&request, this, 0) == B_OK) {
+                    BMessage timeout(viewNegotiatedDropTimeoutHaiku);
+                    timeout.AddUInt64("request", requestID);
+                    BMessageRunner::StartSending(BMessenger(this), &timeout, 5000000, 1);
+                } else
+                    SendDrag(BMessage(), ConvertFromScreen(message->DropPoint()), "exited");
+                return;
+            }
+        }
+        SendDrag(*message, ConvertFromScreen(message->DropPoint()), "drop");
+        return;
+    }
+    switch (message->what) {
+    case B_MIME_DATA: {
+        const BMessage* request = message->Previous();
+        auto requestID = request ? request->GetUInt64("webkit:drop-request", 0) : 0;
+        if (!requestID || requestID != m_state->nativeDropRequest || m_state->closed
+            || request->what != B_COPY_TARGET || !negotiatedDragTypeHaiku(*request))
+            return;
+        ++m_state->nativeDropRequest;
+        const char* type = request->GetString("be:types", "");
+        BPoint point = ConvertFromScreen(request->GetPoint("webkit:drop-screen", BPoint()));
+        const void* bytes = nullptr;
+        ssize_t length = 0;
+        const ssize_t limit = !strncmp(type, "image/", 6) ? 16 * 1024 * 1024 : 1024 * 1024;
+        if (message->FindData(type, B_MIME_TYPE, &bytes, &length) != B_OK || length < 0 || length > limit) {
+            SendDrag(BMessage(), point, "exited");
+            return;
+        }
+        BMessage data;
+        data.AddData(type, B_MIME_TYPE, bytes, length);
+        data.AddUInt32("operations", 1); // Native negotiated copy.
+        SendDrag(data, point, "drop");
+        return;
+    }
+    case viewNegotiatedDropTimeoutHaiku:
+        if (message->GetUInt64("request", 0) == m_state->nativeDropRequest) {
+            ++m_state->nativeDropRequest;
+            SendDrag(BMessage(), BPoint(), "exited");
+        }
+        return;
+    case viewStartDragHaiku:
+        StartDrag(*message);
+        return;
+    case viewNativeDragPendingHaiku:
+        if (m_state->sourceDragActive && message->GetUInt64("session", 0) == m_state->sourceDragSession)
+            m_state->sourceDragPending = true;
+        return;
+    case viewNativeDragReplyHaiku:
+        if (message->GetUInt64("session", 0) == m_state->sourceDragSession)
+            FinishDrag(message->GetUInt32("operation", 0), message->GetPoint("screen", ConvertToScreen(BPoint())));
+        return;
+    case viewNativeDragTickHaiku: {
+        if (!m_state->sourceDragActive || message->GetUInt64("session", 0) != m_state->sourceDragSession)
+            return;
+        BPoint point;
+        uint32 buttons = 0;
+        GetMouse(&point, &buttons, false);
+        if (buttons)
+            return;
+        if (!m_state->sourceDragReleasedAt)
+            m_state->sourceDragReleasedAt = system_time();
+        // Native mouse-up precedes delivery of the drop message. Give the
+        // target time to acknowledge it, and wait for WebKit's async result.
+        bigtime_t timeout = m_state->sourceDragPending ? 10000000 : 750000;
+        if (system_time() - m_state->sourceDragReleasedAt >= timeout)
+            FinishDrag(0, ConvertToScreen(point));
+        return;
+    }
+    case B_COPY_TARGET: {
+        if (!m_state->sourceDragData || dragSessionHaiku(*message) != m_state->sourceDragSession)
+            return;
+        bool accepted = exportDragHaiku(*message, *m_state->sourceDragData);
+        BPoint point;
+        uint32 buttons = 0;
+        GetMouse(&point, &buttons, false);
+        FinishDrag(accepted ? 1 : 0, ConvertToScreen(point));
+        return;
+    }
+    case B_REPLY:
+        if (dragSessionHaiku(*message) && dragSessionHaiku(*message) == m_state->sourceDragSession) {
+            BPoint point;
+            uint32 buttons = 0;
+            GetMouse(&point, &buttons, false);
+            FinishDrag(message->GetInt32("be:action", 0) == B_COPY_TARGET ? 1 : 0, ConvertToScreen(point));
+            return;
+        }
+        BView::MessageReceived(message);
+        return;
+    case viewRetryCloseHaiku:
+        RequestClose();
+        return;
+    case viewDismissDataListHaiku:
+        SendCommand(viewDismissDataListHaiku);
+        return;
+    case viewWindowVisibilityHaiku:
+        if (Window())
+            m_state->onCurrentWorkspace = windowOnCurrentWorkspaceHaiku(*Window());
+        UpdateGeometry();
+        return;
+    case javaScriptDialogShowHaiku:
+        if (!m_dialogHost)
+            m_dialogHost = std::make_unique<JavaScriptDialogHostHaiku>(m_state->dialogs);
+        m_dialogHost->show(*message, Window(), BMessenger(this), Window() && !Window()->IsHidden() && !IsHidden());
+        return;
+    case javaScriptDialogClosedHaiku: {
+        uint64 identifier;
+        if (m_dialogHost && message->FindUInt64("identifier", &identifier) == B_OK)
+            m_dialogHost->didClose(identifier, Window(), BMessenger(this), Window() && !Window()->IsHidden() && !IsHidden());
+        return;
+    }
+    case javaScriptDialogsCancelHaiku:
+        if (m_dialogHost)
+            m_dialogHost->cancelAll();
+        return;
+    case B_CUT: case B_COPY: case B_PASTE: case B_SELECT_ALL: case B_UNDO: case B_REDO:
+        ExecuteEditCommand(message->what);
+        return;
+    case WebKit::viewDirectExposedHaiku: {
+        m_state->directExposurePending = false;
+        // app_server handles the end of the update before this.
+        Sync();
+        std::shared_ptr<WebKit::DirectPresentTargetHaiku> target;
+        {
+            std::lock_guard guard(m_state->mutex);
+            target = m_state->directTarget;
+        }
+        if (target && target->enabled()) {
+            target->invalidate();
+            dispatchViewMessageHaiku(m_state, BMessage(WebKit::viewDirectRedisplayHaiku));
+        }
+        return;
+    }
+    case viewFrameHaiku: {
+        if (presentTraceHaiku())
+            std::fprintf(stderr, "Summit view %p frame message damage=%d window=%p hidden=%d\n", this,
+                static_cast<int>(message->CountNames(B_RECT_TYPE)), Window(), IsHidden() ? 1 : 0);
+        // The web process put this frame into the screen itself.
+        if (message->GetBool("direct", false)) {
+            dropWindowsWithoutDaemonHaiku();
+            return;
+        }
+        // A frame names what changed; without that it replaces everything.
+        BRect damage;
+        if (message->FindRect("damage", &damage) != B_OK) {
+            Invalidate();
+            return;
+        }
+        for (int32 index = 0; message->FindRect("damage", index, &damage) == B_OK; ++index)
+            Invalidate(damage);
+        return;
+    }
+    case viewTooltipHaiku:
+        SetToolTip(message->FindString("text"));
+        return;
+    case viewCursorHaiku: {
+        auto type = static_cast<WebCore::Cursor::Type>(message->GetUInt32("cursor_type", 0));
+        std::unique_ptr<BCursor> cursor;
+        if (type == WebCore::Cursor::Type::Custom) {
+            const int32 width = message->GetInt32("width", 0);
+            const int32 height = message->GetInt32("height", 0);
+            BPoint hotspot;
+            const void* pixels = nullptr;
+            ssize_t length = 0;
+            if (width > 0 && width <= 128 && height > 0 && height <= 128
+                && message->FindPoint("hotspot", &hotspot) == B_OK
+                && std::isfinite(hotspot.x) && std::isfinite(hotspot.y)
+                && hotspot.x >= 0 && hotspot.x < width && hotspot.y >= 0 && hotspot.y < height
+                && message->FindData("pixels", B_RAW_TYPE, &pixels, &length) == B_OK
+                && length == width * height * 4) {
+                BBitmap bitmap(BRect(0, 0, width - 1, height - 1), B_RGBA32);
+                if (bitmap.InitCheck() == B_OK && bitmap.ImportBits(pixels, length, width * 4, 0, B_RGBA32) == B_OK)
+                    cursor = std::make_unique<BCursor>(&bitmap, hotspot);
+            }
+        } else if (type > WebCore::Cursor::Type::Invalid && type < WebCore::Cursor::Type::Custom) {
+            // Copying retains the native cursor token. Never archive it.
+            if (auto* native = WebCore::Cursor::fromType(type).platformCursor())
+                cursor = std::make_unique<BCursor>(*native);
+        }
+        if (!cursor || cursor->InitCheck() != B_OK)
+            cursor = std::make_unique<BCursor>(B_CURSOR_ID_SYSTEM_DEFAULT);
+        m_cursor = std::move(cursor);
+        SetViewCursor(m_cursor.get());
+        return;
+    }
+    case B_MOUSE_WHEEL_CHANGED: {
+        // app_server applies a wheel notch wherever the pointer is, so that is
+        // where the page receives it. A caller that synthesizes the message can
+        // name the point instead, which is how scrolling is measured without
+        // taking the pointer away from whoever is using the machine.
+        BPoint point;
+        uint32 buttons;
+        if (message->FindPoint("summit:view_where", &point) != B_OK)
+            GetMouse(&point, &buttons, false);
+        SendInput(*message, point);
+        return;
+    }
+    case B_UNMAPPED_KEY_DOWN:
+    case B_UNMAPPED_KEY_UP:
+        SendInput(*message);
+        return;
+    default:
+        BView::MessageReceived(message);
+    }
+}
