+class BMediaTrack;
+
+namespace WebCore {
+
+// BMediaTrack::SeekToTime() and SeekToFrame() as they are, except for a track
+// the media kit gave no decoder (its chosen add-on failed to set up, as the
+// air/OS images' NVDEC add-on does for H.264 on a machine without a GeForce):
+// the media kit refuses to move such a track (B_NO_INIT), although it still
+// reads its chunks for SubstituteVideoDecoderHaiku. That track is moved
+// through its extractor, as BMediaTrack's own seek does before it tells the
+// decoder, and keeps its CurrentFrame() and CurrentTime(). `flags` takes the
+// B_MEDIA_SEEK_CLOSEST_* direction.
+status_t seekTrackToTimeHaiku(BMediaTrack&, bigtime_t* time, int32 flags = 0);
+status_t seekTrackToFrameHaiku(BMediaTrack&, int64* frame, int32 flags = 0);
+
