+#include <wtf/text/StringHash.h>
+
+namespace WebCore {
+// navigator.hid. Requests go to the browser process's WebUSB broker, which
+// owns the devices ("api": "hid").
+class HID final : public RefCounted<HID>, public EventTarget, public ActiveDOMObject {
+    WTF_MAKE_TZONE_ALLOCATED(HID);
+public:
+    static Ref<HID> create(Document&);
+    ~HID();
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+    USING_CAN_MAKE_WEAKPTR(EventTarget);
+    ScriptExecutionContext* scriptExecutionContext() const final { return ActiveDOMObject::scriptExecutionContext(); }
+    void getDevices(DOMPromiseDeferred<IDLSequence<IDLInterface<HIDDevice>>>&&);
+    void requestDevice(HIDDeviceRequestOptions&&, DOMPromiseDeferred<IDLSequence<IDLInterface<HIDDevice>>>&&);
+    using Completion = CompletionHandler<void(ExceptionOr<Ref<JSON::Object>>&&, Vector<uint8_t>&&)>;
+    static void perform(Document*, Ref<JSON::Object>&&, Vector<uint8_t>&&, Completion&&);
+private:
+    explicit HID(Document&);
+    EventTargetInterfaceType eventTargetInterface() const final { return EventTargetInterfaceType::HID; }
+    void refEventTarget() final { ref(); }
+    void derefEventTarget() final { deref(); }
+    void stop() final;
+    void suspend(ReasonForSuspension) final;
+    void resume() final;
+    void eventListenersDidChange() final;
+    bool virtualHasPendingActivity() const final;
+    void pollDevices();
+    Ref<HIDDevice> device(Ref<JSON::Object>&&);
+    Vector<Ref<HIDDevice>> devices(const JSON::Object&);
+    Document* document() const;
+    Timer m_pollTimer;
+    HashMap<String, Ref<HIDDevice>> m_devices;
+    HashSet<String> m_connected;
+    bool m_polling { false };
+    bool m_stopped { false };
+};
+} // namespace WebCore
+SPECIALIZE_TYPE_TRAITS_EVENTTARGET(HID)
+#endif
