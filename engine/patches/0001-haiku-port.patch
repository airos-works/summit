@@ -0,0 +1,40 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace SummitDASH {
+struct ByteRange { uint64_t first {0}, last {0}; };
+struct Resource { std::string url; std::optional<ByteRange> range; };
+struct Segment {
+    Resource resource;
+    double start {0}, duration {0}; // Presentation seconds, including period start.
+    uint64_t number {0}, time {0};
+};
+struct Representation {
+    std::string id, adaptationID, codecs, mimeType, language;
+    bool audio {false}, video {false}, encrypted {false};
+    uint64_t bandwidth {0};
+    unsigned width {0}, height {0};
+    double periodStart {0}, presentationTimeOffset {0};
+    Resource initialization;
+    std::vector<Segment> segments;
+};
+struct Period {
+    std::string id;
+    double start {0}, duration {0};
+    std::vector<Representation> representations;
+};
+struct Manifest {
+    bool dynamic {false};
+    double duration {0}, updatePeriod {5}, timeShiftBufferDepth {120}, liveEdge {0};
+    std::vector<Period> periods;
+};
+// Network URLs only; libxml external entities and DTDs are refused. The
+// caller supplies the final response URL and UTC seconds for live manifests.
+std::optional<Manifest> parseManifest(std::string_view xml, const std::string& responseURL,
+    double nowUTC, std::string& error);
+}
diff --git a/Source/WebCore/platform/graphics/haiku/DashPlaybackHaiku.cpp b/Source/WebCore/platform/graphics/haiku/DashPlaybackHaiku.cpp
