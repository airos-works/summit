+
+void PlatformRawAudioData::copyTo(std::span<uint8_t> destination, AudioSampleFormat format, size_t planeIndex, std::optional<size_t> frameOffset, std::optional<size_t>, unsigned long copyElementCount)
+{
+    // computeCopyElementCount (WebCodecsAudioDataAlgorithms) checks the arguments.
+    auto& audio = downcast<PlatformRawAudioDataHaiku>(*this);
+    auto sourceFormat = audio.format();
+    auto bytes = audio.bytes();
+    size_t channels = numberOfChannels();
+    size_t frames = numberOfFrames();
+    size_t offset = std::min(frameOffset.value_or(0), frames);
+    size_t sampleSize = computeBytesPerSample(sourceFormat);
+    bool sourceInterleaved = isAudioSampleFormatInterleaved(sourceFormat);
+
+    // The same samples: a copy (planar and interleaved mono are the same).
+    if (sourceFormat == format || (audioSampleElementFormat(sourceFormat) == audioSampleElementFormat(format) && channels == 1)) {
+        size_t frameSize = sourceInterleaved ? sampleSize * channels : sampleSize;
+        size_t start = (sourceInterleaved ? 0 : planeIndex * frames * sampleSize) + offset * frameSize;
+        size_t length = copyElementCount * sampleSize;
+        RELEASE_ASSERT(start + length <= bytes.size() && length <= destination.size());
+        memcpySpan(destination, bytes.subspan(start, length));
+        return;
+    }
+
+    auto convert = [&](PlaneData planes) {
+        if (isAudioSampleFormatInterleaved(format)) {
+            copyToInterleaved(WTF::move(planes), destination, format, copyElementCount);
+            return;
+        }
+        WTF::switchOn(audioElementSpan(format, destination), [&]<typename D>(std::span<D> target) {
+            switchOn(planes, [&](auto& source) {
+                if (planeIndex >= source.size() || source[planeIndex].size() < copyElementCount || target.size() < copyElementCount)
+                    return;
+                for (size_t i = 0; i < copyElementCount; ++i)
+                    target[i] = convertAudioSample<D>(source[planeIndex][i]);
+            });
+        });
+    };
+
+    // The source's planes from the offset on; interleaved samples are
+    // separated first.
+    auto mutableBytes = unsafeMakeSpan(const_cast<uint8_t*>(bytes.data()), bytes.size());
+    WTF::switchOn(audioElementSpan(sourceFormat, mutableBytes), [&]<typename S>(std::span<S> samples) {
+        size_t count = frames - offset;
+        Vector<Vector<S>> separated;
+        Vector<std::span<S>> planes;
+        if (sourceInterleaved) {
+            separated.resize(channels);
+            for (size_t channel = 0; channel < channels; ++channel) {
+                separated[channel].resize(count);
+                for (size_t frame = 0; frame < count; ++frame)
+                    separated[channel][frame] = samples[(offset + frame) * channels + channel];
+                planes.append(separated[channel].mutableSpan());
+            }
+        } else {
+            for (size_t channel = 0; channel < channels; ++channel)
+                planes.append(samples.subspan(channel * frames + offset, count));
+        }
+        convert(PlaneData { WTF::move(planes) });
+    });
+}
