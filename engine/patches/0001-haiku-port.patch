+#include "config.h"
+#include "MainThreadSharedTimer.h"
+
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+
+namespace WebCore {
+
+// The main run loop keeps timer deadlines inside the process. A BMessageRunner
+// here cost several synchronous registrar messages for every DOM timer.
+static RunLoop::Timer& sharedTimer()
+{
+    static NeverDestroyed<RunLoop::Timer> timer(RunLoop::mainSingleton(), "MainThreadSharedTimer"_s, [] {
+        MainThreadSharedTimer::singleton().fired();
+    });
+    return timer;
+}
+
+void MainThreadSharedTimer::stop()
+{
+    sharedTimer().stop();
+}
+
+void MainThreadSharedTimer::setFireInterval(WTF::Seconds interval)
+{
+    sharedTimer().startOneShot(interval);
+}
+
+void MainThreadSharedTimer::invalidate()
+{
+}
