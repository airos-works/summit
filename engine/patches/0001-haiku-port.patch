+#if ENABLE(CUSTOM_PROTOCOL_HANDLERS)
+void WebView::protocolHandlerRequested(const String& scheme, const URL& url, bool remove)
+{
+    if (!m_page || m_state->closed)
+        return;
+    BMessage message(B_WEBKIT_SCHEME_REGISTRATION);
+    message.AddString("scheme", scheme.utf8().legacyCStringPointer());
+    message.AddString("url", url.string().utf8().legacyCStringPointer());
+    message.AddString("source_url", m_page->pageLoadState().activeURL().string().utf8().legacyCStringPointer());
+    message.AddBool("remove", remove);
+    sendToHostHaiku(m_state, message);
+}
