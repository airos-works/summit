+// A browser command for a namespace answered by the browser (history,
+// bookmarks, search, browsingData): the permission is the namespace's name.
+// Null when the method is unknown, the permission is missing or memory ran out.
+static std::optional<BMessage> nativeNamespaceQueryHaiku(WebExtensionContext& context, uint32_t command, ASCIILiteral namespaceName,
+    std::span<const ASCIILiteral> methods, const String& method, const String& argumentsJSON, const String& apiName,
+    CompletionHandler<void(std::expected<String, WebExtensionError>&&)>& completion)
+{
+    if (std::ranges::find(methods, method) == methods.end() || !context.hasPermission(String { namespaceName })) {
+        completion(toWebExtensionError(apiName, nullString(), "permission denied"_s));
+        return std::nullopt;
+    }
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    if (message.AddUInt32("command", command) != B_OK
+        || message.AddString("method", method.utf8().legacyCStringPointer()) != B_OK
+        || message.AddString("arguments", argumentsJSON.utf8().legacyCStringPointer()) != B_OK) {
+        completion(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+        return std::nullopt;
+    }
+    return message;
+}
