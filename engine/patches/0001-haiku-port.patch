--- /dev/null
+++ b/Source/WebCore/platform/bluetooth/haiku/BluetoothTestTransportHaiku.h
@@ -0,0 +1,111 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "BluetoothATTClientHaiku.h"
+#include <algorithm>
+#include <map>
+namespace WebCore::BluetoothHaiku {
+// Deterministic ATT peer for native end-to-end tests. Selected only by the
+// host's explicit test environment, never by a document or a physical address.
+class TestTransport final : public ATTTransport {
+public:
+    TestTransport()
+        : m_attributes {
+            { 1, { 0x2800, { 0x0f, 0x18 } } },
+            { 2, { 0x2803, { 0x1e, 3, 0, 0x19, 0x2a } } },
+            { 3, { 0x2a19, { 88 } } },
+            { 4, { 0x2902, { 0, 0 } } },
+            { 5, { 0x2901, { 'B', 'a', 't', 't', 'e', 'r', 'y' } } },
+            { 6, { 0x2803, { 2, 7, 0, 0x25, 0x2a } } },
+            { 7, { 0x2a25, { 'p', 'r', 'i', 'v', 'a', 't', 'e' } } },
+            { 8, { 0x2802, { 11, 0, 20, 0, 0x0a, 0x18 } } },
+            { 11, { 0x2800, { 0x0a, 0x18 } } },
+            { 12, { 0x2803, { 2, 13, 0, 0x29, 0x2a } } },
+            { 13, { 0x2a29, { 'S', 'u', 'm', 'm', 'i', 't' } } },
+            { 21, { 0x2800, { 0x12, 0x18 } } },
+            { 31, { 0x2800, { 1, 0x18 } } },
+            { 32, { 0x2803, { 0x20, 33, 0, 5, 0x2a } } },
+            { 33, { 0x2a05, { 1, 0, 0xff, 0xff } } },
+            { 34, { 0x2902, { 0, 0 } } }
+        } { }
+    ATTResult send(std::span<const uint8_t> packet) final
+    {
+        if (packet.empty() || packet.size() > 23) return { ATTError::Protocol };
+        auto word = [&](size_t i) -> uint16_t { return i + 1 < packet.size() ? uint16_t(packet[i]) | uint16_t(packet[i + 1]) << 8 : 0; };
+        auto handle = word(1);
+        auto error = [&](uint8_t value) { m_replies.push_back({ 1, packet[0], uint8_t(handle), uint8_t(handle >> 8), value }); };
+        auto appendWord = [](auto& bytes, uint16_t value) { bytes.push_back(uint8_t(value)); bytes.push_back(uint8_t(value >> 8)); };
+        auto attribute = m_attributes.find(handle);
+        switch (packet[0]) {
+        case 0x10: case 0x08: case 0x04: {
+            if (packet.size() != (packet[0] == 0x04 ? 5u : 7u)) return { ATTError::Protocol };
+            uint16_t end = word(3), type = word(5);
+            if (packet[0] == 0x10 && type != 0x2800) { error(0x10); break; }
+            std::vector<uint8_t> reply { uint8_t(packet[0] + 1), uint8_t(packet[0] == 0x04 ? 1 : 0) };
+            size_t itemSize = 0;
+            for (auto it = m_attributes.lower_bound(handle); it != m_attributes.end() && it->first <= end; ++it) {
+                if (packet[0] != 0x04 && it->second.type != type) continue;
+                std::vector<uint8_t> item; appendWord(item, it->first);
+                if (packet[0] == 0x04) appendWord(item, it->second.type);
+                else {
+                    if (packet[0] == 0x10) appendWord(item, it->first == 1 ? 10 : it->first == 11 ? 20 : it->first == 21 ? 30 : 40);
+                    item.insert(item.end(), it->second.value.begin(), it->second.value.end());
+                }
+                if (reply.size() + item.size() > 23 || (itemSize && itemSize != item.size())) break;
+                itemSize = item.size(); reply.insert(reply.end(), item.begin(), item.end());
+            }
+            if (reply.size() == 2) error(0x0a);
+            else { if (packet[0] != 0x04) reply[1] = uint8_t(itemSize); m_replies.push_back(std::move(reply)); }
+            break;
+        }
+        case 0x0a: case 0x0c: {
+            if (attribute == m_attributes.end()) { error(1); break; }
+            auto& value = attribute->second.value; size_t offset = packet[0] == 0x0c ? word(3) : 0;
+            if (offset > value.size()) { error(7); break; }
+            std::vector<uint8_t> reply { uint8_t(packet[0] + 1) };
+            reply.insert(reply.end(), value.begin() + offset, value.begin() + std::min(offset + 22, value.size()));
+            m_replies.push_back(std::move(reply)); break;
+        }
+        case 0x12: case 0x52:
+            if (attribute == m_attributes.end()) { if (packet[0] == 0x12) error(1); break; }
+            attribute->second.value.assign(packet.begin() + 3, packet.end());
+            if (packet[0] == 0x12) m_replies.push_back({ 0x13 });
+            changed(handle); break;
+        case 0x16: {
+            if (attribute == m_attributes.end()) { error(1); break; }
+            if ((m_preparedHandle && m_preparedHandle != handle) || word(3) != m_prepared.size()) { error(7); break; }
+            m_preparedHandle = handle; m_prepared.insert(m_prepared.end(), packet.begin() + 5, packet.end());
+            std::vector<uint8_t> echo(packet.begin(), packet.end()); echo[0] = 0x17; m_replies.push_back(std::move(echo)); break;
+        }
+        case 0x18:
+            m_replies.push_back({ 0x19 });
+            if (packet.size() == 2 && packet[1] && m_preparedHandle) { m_attributes[m_preparedHandle].value = m_prepared; changed(m_preparedHandle); }
+            m_preparedHandle = 0; m_prepared.clear(); break;
+        case 0x1e: break;
+        default: error(6); break;
+        }
+        return { };
+    }
+    ATTResult receive(std::vector<uint8_t>& packet, unsigned) final
+    {
+        if (m_replies.empty()) return { ATTError::Timeout };
+        packet = std::move(m_replies.front()); m_replies.pop_front(); return { };
+    }
+private:
+    void changed(uint16_t handle)
+    {
+        auto& value = m_attributes[3].value;
+        if (handle == 3 && value == std::vector<uint8_t> { 254 } && m_attributes[34].value == std::vector<uint8_t> { 2, 0 })
+            m_replies.push_back({ 0x1d, 33, 0, 1, 0, 0xff, 0xff });
+        else if ((handle == 3 || handle == 4) && m_attributes[4].value == std::vector<uint8_t> { 1, 0 }) {
+            std::vector<uint8_t> notification { 0x1b, 3, 0 };
+            notification.insert(notification.end(), value.begin(), value.begin() + std::min<size_t>(20, value.size()));
+            m_replies.push_back(std::move(notification));
+        }
+    }
+    struct Attribute { uint16_t type; std::vector<uint8_t> value; };
+    std::map<uint16_t, Attribute> m_attributes;
+    std::deque<std::vector<uint8_t>> m_replies;
+    uint16_t m_preparedHandle { 0 };
+    std::vector<uint8_t> m_prepared;
+};
+}
diff --git a/Source/WebCore/platform/bluetooth/haiku/BluetoothTypesHaiku.cpp b/Source/WebCore/platform/bluetooth/haiku/BluetoothTypesHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1253a8be40c918acc0079bd164a8eb065eeeb239
--- /dev/null
+++ b/Source/WebCore/platform/bluetooth/haiku/BluetoothTypesHaiku.cpp
@@ -0,0 +1,122 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "BluetoothTypesHaiku.h"
+#include <algorithm>
+#include <cstdio>
+
+namespace WebCore::BluetoothHaiku {
+UUID UUID::alias(uint32_t value)
+{
+    UUID result { { uint8_t(value >> 24), uint8_t(value >> 16), uint8_t(value >> 8), uint8_t(value), 0, 0, 0x10, 0, 0x80, 0, 0, 0x80, 0x5f, 0x9b, 0x34, 0xfb } };
+    return result;
+}
+std::optional<UUID> UUID::parse(std::string_view text)
+{
+    if (text.size() != 36) return {};
+    UUID result;
+    auto digit = [](char c) -> int { if (c >= '0' && c <= '9') return c - '0'; if (c >= 'a' && c <= 'f') return c - 'a' + 10; if (c >= 'A' && c <= 'F') return c - 'A' + 10; return -1; };
+    size_t index = 0;
+    for (size_t i = 0; i < text.size();) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) { if (text[i++] != '-') return {}; continue; }
+        int high = digit(text[i++]), low = digit(text[i++]);
+        if (high < 0 || low < 0) return {};
+        result.bytes[index++] = (high << 4) | low;
+    }
+    return result;
+}
+std::optional<UUID> UUID::fromWire(std::span<const uint8_t> bytes)
+{
+    if (bytes.size() == 2) return alias(bytes[0] | uint32_t(bytes[1]) << 8);
+    if (bytes.size() == 4) return alias(bytes[0] | uint32_t(bytes[1]) << 8 | uint32_t(bytes[2]) << 16 | uint32_t(bytes[3]) << 24);
+    if (bytes.size() != 16) return {};
+    UUID result; std::reverse_copy(bytes.begin(), bytes.end(), result.bytes.begin()); return result;
+}
+std::string UUID::string() const
+{
+    static constexpr char digits[] = "0123456789abcdef";
+    std::string result; result.reserve(36);
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        if (i == 4 || i == 6 || i == 8 || i == 10) result += '-';
+        result += digits[bytes[i] >> 4]; result += digits[bytes[i] & 15];
+    }
+    return result;
+}
+
+#include "BluetoothUUIDNamesHaiku.inc"
+std::optional<UUID> namedUUID(UUIDKind kind, std::string_view name)
+{
+    if (auto uuid = UUID::parse(name)) return uuid->string() == name ? uuid : std::nullopt;
+    for (const auto& entry : uuidNames) if (entry.kind == kind && entry.name == name) return UUID::alias(entry.value);
+    return {};
+}
+bool blocked(const UUID& uuid, Access access)
+{
+    for (auto value : {0x1812, 0xfffd, 0xfff9, 0xfde2, 0x2a03, 0x2a25}) if (uuid == UUID::alias(value)) return true;
+    for (auto text : {"00001530-1212-efde-1523-785feabcd123", "f000ffc0-0451-4000-b000-000000000000", "00060000-0000-1000-8000-00805f9b34fb"}) if (uuid == *UUID::parse(text)) return true;
+    return access == Access::Write && (uuid == UUID::alias(0x2a02) || uuid == UUID::alias(0x2902) || uuid == UUID::alias(0x2903));
+}
+bool Advertisement::append(std::span<const uint8_t> bytes)
+{
+    if (bytes.size() > 1650) return false;
+    // Commit only complete packets; a malformed length cannot preserve partial
+    // filter fields that were not present in a valid advertisement.
+    Advertisement updated = *this;
+    while (!bytes.empty()) {
+        size_t length = bytes.front(); bytes = bytes.subspan(1);
+        if (!length) break;
+        if (length > bytes.size()) return false;
+        uint8_t type = bytes.front(); auto data = bytes.subspan(1, length - 1); bytes = bytes.subspan(length);
+        if ((type == 8 || type == 9) && !data.empty() && (type == 9 || !updated.completeName)) {
+            updated.name.assign(reinterpret_cast<const char*>(data.data()), data.size()); updated.completeName = type == 9;
+        } else if (type >= 2 && type <= 7) {
+            size_t width = type <= 3 ? 2 : type <= 5 ? 4 : 16;
+            if (data.size() % width) return false;
+            while (!data.empty()) { updated.services.insert(*UUID::fromWire(data.first(width))); data = data.subspan(width); }
+        } else if (type == 0xff && data.size() >= 2) {
+            uint16_t company = data[0] | uint16_t(data[1]) << 8;
+            // Web Bluetooth registry: iBeacon proximity data is excluded.
+            if (company != 0x004c || data.size() < 3 || data[2] != 0x02)
+                updated.manufacturerData[company] = { data.begin() + 2, data.end() };
+            else
+                updated.manufacturerData.erase(company);
+        } else if (type == 0x16 || type == 0x20 || type == 0x21) {
+            size_t width = type == 0x16 ? 2 : type == 0x20 ? 4 : 16;
+            if (data.size() < width) return false;
+            auto uuid = *UUID::fromWire(data.first(width));
+            if (!blocked(uuid)) updated.serviceData[uuid] = { data.begin() + width, data.end() };
+        }
+        if (updated.services.size() > 128 || updated.manufacturerData.size() > 64 || updated.serviceData.size() > 128) return false;
+    }
+    *this = std::move(updated); return true;
+}
+bool DataFilter::valid() const { return prefix.size() <= 512 && (mask.empty() || mask.size() == prefix.size()); }
+bool DataFilter::matches(std::span<const uint8_t> value) const
+{
+    if (!valid() || value.size() < prefix.size()) return false;
+    for (size_t i = 0; i < prefix.size(); ++i) { uint8_t bitMask = mask.empty() ? 0xff : mask[i]; if ((value[i] & bitMask) != (prefix[i] & bitMask)) return false; }
+    return true;
+}
+bool Filter::valid() const
+{
+    if (!name && !namePrefix && services.empty() && manufacturerData.empty() && serviceData.empty()) return false;
+    if ((name && name->size() > 248) || (namePrefix && (namePrefix->empty() || namePrefix->size() > 248)) || services.size() > 128 || manufacturerData.size() > 64 || serviceData.size() > 128) return false;
+    for (auto& service : services) if (blocked(service)) return false;
+    for (auto& [_, filter] : manufacturerData) if (!filter.valid()) return false;
+    for (auto& [uuid, filter] : serviceData) if (blocked(uuid) || !filter.valid()) return false;
+    return true;
+}
+bool Filter::matches(const Advertisement& advertisement) const
+{
+    if (!valid()) return false;
+    if (name && *name != advertisement.name) return false;
+    if (namePrefix && !advertisement.name.starts_with(*namePrefix)) return false;
+    for (auto& uuid : services) if (!advertisement.services.contains(uuid)) return false;
+    for (auto& [company, filter] : manufacturerData) { auto item = advertisement.manufacturerData.find(company); if (item == advertisement.manufacturerData.end() || !filter.matches(item->second)) return false; }
+    for (auto& [uuid, filter] : serviceData) { auto item = advertisement.serviceData.find(uuid); if (item == advertisement.serviceData.end() || !filter.matches(item->second)) return false; }
+    return true;
+}
+bool matches(const Advertisement& advertisement, const std::vector<Filter>& include, const std::vector<Filter>& exclude)
+{
+    return advertisement.connectable && (include.empty() || std::ranges::any_of(include, [&](auto& filter) { return filter.matches(advertisement); }))
+        && !std::ranges::any_of(exclude, [&](auto& filter) { return filter.matches(advertisement); });
+}
+}
