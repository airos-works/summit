+#if ENABLE(CANVAS_HIT_REGIONS)
+String HTMLCanvasElement::hitRegionAtAbsolutePoint(const FloatPoint& point) const
+{
+    RefPtr context = dynamicDowncast<CanvasRenderingContext2D>(m_context.get());
+    CheckedPtr renderer = dynamicDowncast<RenderHTMLCanvas>(this->renderer());
+    if (!context || !context->hasHitRegions() || !renderer || !width() || !height())
+        return { };
+    auto local = renderer->absoluteToLocal(point, MapCoordinatesMode::UseTransforms);
+    FloatRect content { renderer->replacedContentRect() };
+    if (content.isEmpty() || !content.contains(local))
+        return { };
+    return context->hitRegionAtPoint({ (local.x() - content.x()) * width() / content.width(),
+        (local.y() - content.y()) * height() / content.height() });
+}
+#endif
