+    ++state->nativeDropRequest;
+    if (state->closeRequestApproved || state->closeRequestPending) {
+        state->closeApprovalInvalidated = true;
+        state->closeRequestApproved = false;
+        if (RefPtr client = state->client)
+            client->notifyState();
+    }
+}
