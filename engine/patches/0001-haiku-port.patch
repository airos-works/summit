+String MediaPlayerPrivateHaikuMSE::engineDescription() const
+{
+    // JSON for the browser's debugging tools (WebProcessDiagnosticsHaiku.cpp).
+    auto object = JSON::Object::create();
+    object->setString("engine"_s, m_dash ? "Haiku MSE (DASH)"_s : "Haiku MSE"_s);
+    auto size = naturalSize();
+    object->setInteger("naturalWidth"_s, static_cast<int>(size.width()));
+    object->setInteger("naturalHeight"_s, static_cast<int>(size.height()));
+    object->setBoolean("paused"_s, m_paused);
+    object->setBoolean("stalled"_s, m_stalled);
+    if (m_videoRenderer) {
+        auto decoder = m_videoRenderer->decoderInfo();
+        auto video = JSON::Object::create();
+        video->setString("decoder"_s, String::fromUTF8(decoder.name.c_str()));
+        video->setString("decoderShortName"_s, String::fromUTF8(decoder.shortName.c_str()));
+        video->setBoolean("namedAddOn"_s, decoder.namedAddOn);
+        video->setInteger("decoderStatus"_s, decoder.status);
+        video->setInteger("decodedWidth"_s, decoder.size.width());
+        video->setInteger("decodedHeight"_s, decoder.size.height());
+        video->setInteger("decoderSetups"_s, decoder.setups);
+        video->setDouble("lastSetupMs"_s, decoder.setupMs);
+        video->setInteger("presentedFrames"_s, m_videoRenderer->presentedFrames());
+        video->setInteger("droppedFrames"_s, m_videoRenderer->droppedFrames());
+        video->setInteger("unshownFrames"_s, m_videoRenderer->unshownFrames());
+        object->setObject("video"_s, WTF::move(video));
+    }
+    object->setBoolean("audio"_s, !!m_audioRenderer);
+    if (m_dash)
+        object->setDouble("dashSelectedBandwidth"_s, m_dash->selectedBandwidth());
+    return object->toJSONString();
+}
