+void BWebKitView::DrawPagesForPrinting(BMessenger reply, uint64 identifier, float paperWidth, float paperHeight,
+    BRect margins, float scale, uint32 first, uint32 count, float rasterScale, bool backgrounds)
+{
+    DrawFramePagesForPrinting(reply, identifier, 0, 0, paperWidth, paperHeight, margins, scale, first, count, rasterScale, backgrounds);
+}
+
+void BWebKitView::DrawFramePagesForPrinting(BMessenger reply, uint64 identifier, uint64 frameIdentifier, uint64 expectedGeneration,
+    float paperWidth, float paperHeight, BRect margins, float scale, uint32 first, uint32 count, float rasterScale, bool backgrounds)
+{
+    auto fail = [reply, identifier](const char* error) mutable {
+        BMessage message(B_WEBKIT_PRINT_PAGES);
+        message.AddUInt64("identifier", identifier);
+        message.AddString("error", error);
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    };
+    if (m_status != B_OK || !count || !(paperWidth > 0) || !(paperHeight > 0) || !(scale > 0)
+        || !std::isfinite(paperWidth) || !std::isfinite(paperHeight) || !std::isfinite(scale) || !std::isfinite(rasterScale)
+        || !std::isfinite(margins.left) || !std::isfinite(margins.top) || !std::isfinite(margins.right) || !std::isfinite(margins.bottom)
+        || (frameIdentifier && !FrameIdentifier::isValidIdentifier(frameIdentifier))) {
+        fail("The page cannot be printed");
+        return;
+    }
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, reply, identifier, frameIdentifier, expectedGeneration, paperWidth, paperHeight, margins, scale, first, count, rasterScale, backgrounds, fail]() mutable {
+        auto* page = pageHaiku(state);
+        RefPtr frame = frameIdentifier ? WebFrameProxy::webFrame(FrameIdentifier { frameIdentifier }) : (page ? page->mainFrame() : nullptr);
+        if (!page || !frame || frame->page() != page || !page->hasRunningProcess() || state->load.pending
+            || (expectedGeneration && state->load.generation != expectedGeneration)) {
+            fail("The page cannot be printed");
+            return;
+        }
+        const auto generation = state->load.generation;
+        // Points to CSS pixels: the web process lays pages out in pixels.
+        constexpr float pixelsPerPoint = 96.0f / 72.0f;
+        const float left = std::max(0.0f, margins.left), top = std::max(0.0f, margins.top);
+        const float right = std::max(0.0f, margins.right), bottom = std::max(0.0f, margins.bottom);
+        PrintInfo info;
+        info.pageSetupScaleFactor = scale;
+        info.availablePaperWidth = std::max(36.0f, paperWidth - left - right) * pixelsPerPoint / scale;
+        info.availablePaperHeight = std::max(36.0f, paperHeight - top - bottom) * pixelsPerPoint / scale;
+        info.margin = WebCore::FloatBoxExtent(top * pixelsPerPoint / scale, right * pixelsPerPoint / scale,
+            bottom * pixelsPerPoint / scale, left * pixelsPerPoint / scale);
+        Ref process = frame->process();
+        process->sendWithAsyncReply(Messages::WebPage::DrawPagesForPrintingHaiku(frame->frameID(), info, first, count, rasterScale, backgrounds),
+            [state, generation, reply, identifier, first, rasterScale, fail](std::optional<WebCore::SharedMemory::Handle>&& handle, uint32_t pageCount, WebCore::IntSize size) mutable {
+                if (state->closed || state->load.pending || state->load.generation != generation) {
+                    fail("The document changed while printing");
+                    return;
+                }
+                RefPtr memory = handle ? WebCore::SharedMemory::map(WTF::move(*handle), WebCore::SharedMemory::Protection::ReadOnly) : nullptr;
+                if (!memory) {
+                    if (pageCount && first >= pageCount) {
+                        BMessage message(B_WEBKIT_PRINT_PAGES);
+                        message.AddUInt64("identifier", identifier);
+                        message.AddInt32("pageCount", pageCount);
+                        message.AddInt32("first", first);
+                        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+                        return;
+                    }
+                    fail("The page could not be drawn for printing");
+                    return;
+                }
+                BMessage message(B_WEBKIT_PRINT_PAGES);
+                message.AddUInt64("identifier", identifier);
+                message.AddInt32("pageCount", pageCount);
+                message.AddInt32("first", first);
+                auto bytes = memory->span();
+                if (rasterScale <= 0)
+                    message.AddData("pdf", B_RAW_TYPE, bytes.data(), bytes.size(), false);
+                else {
+                    const size_t pageBytes = static_cast<size_t>(size.width()) * size.height() * 4;
+                    message.AddInt32("width", size.width());
+                    message.AddInt32("height", size.height());
+                    for (size_t offset = 0; pageBytes && offset + pageBytes <= bytes.size(); offset += pageBytes)
+                        message.AddData("page", B_RAW_TYPE, bytes.data() + offset, pageBytes, false);
+                }
+                reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            }, page->webPageIDInProcess(process));
+    });
+}
+
+void BWebKitView::EnterPictureInPicture(const char* token, BMessenger target, BSize size)
+{
+    if (m_status != B_OK || !token)
+        return;
+    BMessage carrier;
+    carrier.AddMessenger("target", target);
+    std::string flattened(carrier.FlattenedSize(), '\0');
+    if (carrier.Flatten(flattened.data(), flattened.size()) != B_OK)
+        return;
+    static constexpr char digits[] = "0123456789abcdef";
+    std::string hex;
+    for (unsigned char byte : flattened) {
+        hex += digits[byte >> 4];
+        hex += digits[byte & 15];
+    }
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, token = copyTextHaiku(token), hex = std::move(hex), size]() mutable {
+        if (auto* page = pageHaiku(state); page && page->hasRunningProcess())
+            protect(page->legacyMainFrameProcess())->send(Messages::WebPage::EnterPictureInPictureHaiku(stringHaiku(token), stringHaiku(hex),
+                WebCore::IntSize(std::lround(size.width), std::lround(size.height))), page->webPageIDInMainFrameProcess());
+    });
+}
+
+void BWebKitView::SetPictureInPictureSize(BSize size)
+{
+    if (m_status != B_OK)
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, size] {
+        if (auto* page = pageHaiku(state); page && page->hasRunningProcess())
+            protect(page->legacyMainFrameProcess())->send(Messages::WebPage::SetPictureInPictureSizeHaiku(
+                WebCore::IntSize(std::lround(size.width), std::lround(size.height))), page->webPageIDInMainFrameProcess());
+    });
+}
+
+void BWebKitView::PictureInPictureCommand(const char* command)
+{
+    if (m_status != B_OK || !command)
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, command = copyTextHaiku(command)] {
+        if (auto* page = pageHaiku(state); page && page->hasRunningProcess())
+            protect(page->legacyMainFrameProcess())->send(Messages::WebPage::PictureInPictureCommandHaiku(stringHaiku(command)), page->webPageIDInMainFrameProcess());
+    });
+}
+
+void BWebKitView::ExitPictureInPicture()
+{
+    if (m_status != B_OK)
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state] {
+        if (auto* page = pageHaiku(state); page && page->hasRunningProcess())
+            protect(page->legacyMainFrameProcess())->send(Messages::WebPage::ExitPictureInPictureHaiku(), page->webPageIDInMainFrameProcess());
+    });
