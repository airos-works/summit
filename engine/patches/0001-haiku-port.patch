+    auto directory = controller ? controller->nativeDownloads().directory() : String();
+    if (directory.isEmpty()) {
+        completionHandler(toWebExtensionError(apiName, nullString(), "the browser has no download directory configured"_s));
+        return;
+    }
+    if (auto result = openFolder(directory); !result) {
+        completionHandler(toWebExtensionError(apiName, nullString(), result.error()));
+        return;
+    }
+    completionHandler({ });
+}
+
+// The file's Tracker icon as a PNG data: URL.
+static std::expected<String, String> fileIconURL(const String& path, int size)
+{
+    BNode node(path.utf8().legacyCStringPointer());
+    BNodeInfo info(&node);
+    if (node.InitCheck() != B_OK || info.InitCheck() != B_OK)
+        return makeUnexpected("The downloaded file no longer exists"_s);
+    auto* bitmap = new BBitmap(BRect(0, 0, size - 1, size - 1), B_RGBA32);
+    if (bitmap->InitCheck() != B_OK || info.GetTrackerIcon(bitmap, static_cast<icon_size>(size)) != B_OK) {
+        delete bitmap;
+        return makeUnexpected("The file has no icon"_s);
+    }
+    BBitmapStream stream(bitmap);
+    BMallocIO png;
+    auto* roster = BTranslatorRoster::Default();
+    auto status = roster ? roster->Translate(&stream, nullptr, nullptr, &png, B_PNG_FORMAT) : B_NO_INIT;
+    stream.DetachBitmap(&bitmap);
+    delete bitmap;
+    if (status != B_OK || !png.BufferLength())
+        return makeUnexpected("The icon could not be encoded"_s);
+    std::span bytes { static_cast<const uint8_t*>(png.Buffer()), png.BufferLength() };
+    return makeString("data:image/png;base64,"_s, base64EncodeToString(bytes));
+}
