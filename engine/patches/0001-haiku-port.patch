+namespace WebKit {
+struct WebDataListSuggestionsDropdownHaiku::CompletionState {
+    // Accessed only on the WebKit main loop.
+    Function<void(std::optional<std::string>, uint64_t)> callback;
+};
+Ref<WebDataListSuggestionsDropdownHaiku> WebDataListSuggestionsDropdownHaiku::create(WebPageProxy& page, std::shared_ptr<WebViewStateHaiku> state)
+{
+    return adoptRef(*new WebDataListSuggestionsDropdownHaiku(page, std::move(state)));
+}
+WebDataListSuggestionsDropdownHaiku::WebDataListSuggestionsDropdownHaiku(WebPageProxy& page, std::shared_ptr<WebViewStateHaiku> state)
+    : WebDataListSuggestionsDropdown(page), m_state(std::move(state)) { }
+WebDataListSuggestionsDropdownHaiku::~WebDataListSuggestionsDropdownHaiku() { invalidate(); }
+void WebDataListSuggestionsDropdownHaiku::invalidate()
+{
+    ASSERT(RunLoop::isMain());
+    if (m_completion) m_completion->callback = nullptr;
+    m_completion = nullptr;
+    m_native = nullptr;
+    m_values.clear();
+}
+void WebDataListSuggestionsDropdownHaiku::close()
+{
+    Ref protectedThis { *this };
+    invalidate();
+    WebDataListSuggestionsDropdown::close();
+}
+void WebDataListSuggestionsDropdownHaiku::platformShow(WebCore::DataListSuggestionInformation&& information)
+{
+    ASSERT(RunLoop::isMain());
+    auto state = m_state.lock();
+    if (!m_page || !state || state->closed || information.suggestions.isEmpty()) { close(); return; }
+    WebViewGeometryHaiku geometry;
+    BMessenger view;
+    { std::lock_guard lock(state->mutex); geometry = state->geometry; view = state->view; }
+    if (!geometry.attached || !geometry.visible || !geometry.focused || !geometry.active) { close(); return; }
+    const auto& rect = information.elementRect;
+    // Both the field rect and native screen origin are logical coordinates.
+    BRect anchor(geometry.screenOrigin.x() + rect.x(), geometry.screenOrigin.y() + rect.y(),
+        geometry.screenOrigin.x() + static_cast<double>(rect.maxX()), geometry.screenOrigin.y() + static_cast<double>(rect.maxY()));
+    std::vector<NativeDataListSuggestionsHaiku::Item> items;
+    auto copy = [](const String& value) { auto bytes = value.utf8(); return std::string(bytes.legacyCStringPointer(), bytes.length()); };
+    m_values.clear();
+    for (auto& suggestion : information.suggestions) {
+        auto value = copy(suggestion.value);
+        m_values.push_back(value);
+        items.push_back({ std::move(value), copy(suggestion.label) });
+    }
+    bool start = !m_native;
+    if (start) {
+        m_completion = std::make_shared<CompletionState>();
+        m_completion->callback = [this](std::optional<std::string> value, uint64_t generation) { complete(std::move(value), generation); };
+        m_native = std::make_unique<NativeDataListSuggestionsHaiku>(view,
+            [completion = m_completion](std::optional<std::string> value, uint64_t generation) {
+                RunLoop::mainSingleton().dispatch([completion, value = std::move(value), generation]() mutable {
+                    if (auto callback = std::exchange(completion->callback, nullptr)) callback(std::move(value), generation);
+                });
+            });
+    }
+    m_native->update(std::move(items), anchor, ++m_generation);
+    if (start && m_native->start() != B_OK) close();
+}
+void WebDataListSuggestionsDropdownHaiku::handleKeydownWithIdentifier(const String& key)
+{
+    if (!m_native) return;
+    using Key = NativeDataListSuggestionsHaiku::Key;
+    if (key == "Up"_s) m_native->key(Key::Up);
+    else if (key == "Down"_s) m_native->key(Key::Down);
+    else if (key == "Enter"_s) m_native->key(Key::Enter);
+    else if (key == "U+001B"_s) close();
+}
+void WebDataListSuggestionsDropdownHaiku::complete(std::optional<std::string> value, uint64_t generation)
+{
+    ASSERT(RunLoop::isMain());
+    Ref protectedThis { *this };
+    auto state = m_state.lock();
+    if (value && generation == m_generation && state && !state->closed
+        && std::find(m_values.begin(), m_values.end(), *value) != m_values.end()) {
+        bool available;
+        { std::lock_guard lock(state->mutex); const auto& g = state->geometry; available = g.attached && g.visible && g.focused && g.active; }
+        if (available) {
+            if (RefPtr page = m_page.get()) page->didSelectOption(String::fromUTF8(*value), m_targetFrameID);
+        }
+    }
+    close();
+}
+}
