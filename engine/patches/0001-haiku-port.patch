+// One media element's CDM. Decoder threads only receive a copied, currently
+// usable key; they cannot retain a session's mutable key-store entries.
+class HaikuCencDecryptionContext final : public ThreadSafeRefCounted<HaikuCencDecryptionContext> {
+public:
+    static Ref<HaikuCencDecryptionContext> create() { return adoptRef(*new HaikuCencDecryptionContext); }
+    void setProxy(RefPtr<CDMProxyHaiku>&& proxy)
+    {
+        Locker locker { m_lock };
+        m_proxy = WTF::move(proxy);
+    }
+    std::optional<std::array<uint8_t, 16>> key(const std::array<uint8_t, 16>& id) const
+    {
+        Locker locker { m_lock };
+        return m_proxy ? m_proxy->key(id) : std::nullopt;
+    }
+private:
+    mutable Lock m_lock;
+    RefPtr<CDMProxyHaiku> m_proxy WTF_GUARDED_BY_LOCK(m_lock);
+};
+#endif
