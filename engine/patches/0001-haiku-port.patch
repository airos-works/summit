+    auto data = json ? String::fromUTF8(json).isolatedCopy() : String();
+    auto description = error ? String::fromUTF8(error).isolatedCopy() : String();
+    WTF::RunLoop::mainSingleton().dispatch([context = m_context, identifier, status, data = WTF::move(data), description = WTF::move(description)]() mutable {
+        if (auto commands = context->browserCommands())
+            commands->respond(identifier, WebKit::BrowserCommandBrokerHaiku::Result { status, WTF::move(description), { }, WTF::move(data) });
+    });
+}
