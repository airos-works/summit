@@ -0,0 +1,44 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "BluetoothATTClientHaiku.h"
+#include <atomic>
+#include <memory>
+
+namespace WebKit::BluetoothHaiku {
+using namespace WebCore::BluetoothHaiku;
+struct Device {
+    std::array<uint8_t, 6> address {};
+    uint8_t addressType { 0 };
+    int32_t adapter { -1 };
+    Advertisement advertisement;
+    bool samePeer(const Device& other) const { return address == other.address && addressType == other.addressType; }
+};
+enum class NativeError { None, Unavailable, Busy, Aborted, Timeout, Network };
+bool available();
+NativeError scan(std::vector<Device>&, const std::atomic<bool>& cancelled, unsigned milliseconds = 8000);
+
+// All methods except abort()/connected() run on one connection's worker queue.
+// The server owns the LE link; this client can cancel only its own listener.
+class Session final : public ATTTransport {
+public:
+    explicit Session(Device);
+    ~Session() override;
+    NativeError connect();
+    void disconnect();
+    void abort() { m_aborted = true; }
+    bool connected() const;
+    ATTResult send(std::span<const uint8_t>) override;
+    ATTResult receive(std::vector<uint8_t>&, unsigned timeoutMilliseconds) override;
+    bool confirmsIndications() const override { return true; }
+    ATTClient& client() { return m_client; }
+private:
+    struct State;
+    Device m_device;
+    std::unique_ptr<State> m_state;
+    std::atomic<bool> m_aborted { false };
+    std::atomic<bool> m_connected { false };
+    int m_socket { -1 };
+    ATTClient m_client;
+    std::unique_ptr<ATTTransport> m_testTransport;
+};
+}
