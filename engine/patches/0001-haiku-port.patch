+void WebDateTimePickerHaiku::platformShowDateTimePicker(WebCore::DateTimeChooserParameters&& params)
+{
+    ASSERT(RunLoop::isMain());
+    invalidate();
+    auto state = m_state.lock();
+    if (!m_page || !state || state->closed) { endPicker(); return; }
+    WebViewGeometryHaiku geometry;
+    { std::lock_guard lock(state->mutex); geometry = state->geometry; }
+    if (!geometry.attached || !geometry.visible) { endPicker(); return; }
+    DateTimeValueHaiku model;
+    using Type = DateTimeValueHaiku::Type;
+    using namespace WebCore::InputTypeNames;
+    if (params.type == date()) model.type = Type::Date;
+    else if (params.type == month()) model.type = Type::Month;
+    else if (params.type == week()) model.type = Type::Week;
+    else if (params.type == WebCore::InputTypeNames::time()) model.type = Type::Time;
+    else if (params.type == datetimelocal()) model.type = Type::DateTimeLocal;
+    else { endPicker(); return; }
+    if (!std::isfinite(params.minimum) || !std::isfinite(params.maximum) || !std::isfinite(params.step)
+        || params.step <= 0 || !std::isfinite(params.stepBase)) { endPicker(); return; }
+    auto copy = [](const String& value) { auto bytes = value.utf8(); return std::string(bytes.legacyCStringPointer(), bytes.length()); };
+    model.current = copy(params.currentValue);
+    model.minimum = params.minimum; model.maximum = params.maximum;
+    model.step = params.step; model.stepBase = params.stepBase;
+    for (auto& suggestion : params.suggestionValues) {
+        if (model.suggestions.size() == 20) break;
+        if (suggestion.length() <= 64) model.suggestions.push_back(copy(suggestion));
+    }
+    const auto& rect = params.anchorRectInMainFrameView;
+    BRect anchor(geometry.screenOrigin.x() + rect.x(), geometry.screenOrigin.y() + rect.y(),
+        geometry.screenOrigin.x() + static_cast<double>(rect.maxX()), geometry.screenOrigin.y() + static_cast<double>(rect.maxY()));
+    if (!anchor.IsValid() || !std::isfinite(anchor.left) || !std::isfinite(anchor.top)
+        || !std::isfinite(anchor.right) || !std::isfinite(anchor.bottom)) { endPicker(); return; }
+    m_completion = std::make_shared<CompletionState>();
+    m_completion->callback = [this, model](std::optional<std::string> value) {
+        // A native result must still belong to this chooser and satisfy the
+        // original HTML constraints when it reaches the engine thread.
+        if (value && !model.error(*value).empty()) value = std::nullopt;
+        complete(std::move(value));
+    };
+    m_native = std::make_unique<NativeDateTimePickerHaiku>(std::move(model), anchor,
+        [completion = m_completion](std::optional<std::string> value) {
+            RunLoop::mainSingleton().dispatch([completion, value = std::move(value)]() mutable {
+                if (auto callback = std::exchange(completion->callback, nullptr)) callback(std::move(value));
+            });
+        });
+}
+void WebDateTimePickerHaiku::complete(std::optional<std::string> value)
+{
+    ASSERT(RunLoop::isMain());
+    Ref protectedThis { *this };
+    auto state = m_state.lock();
+    if (value && state && !state->closed) {
+        bool visible;
+        { std::lock_guard lock(state->mutex); visible = state->geometry.visible; }
+        if (visible) {
+            if (RefPtr page = m_page.get()) page->didChooseDate(String::fromUTF8(*value));
+        }
+    }
+    endPicker();
+}
+}
