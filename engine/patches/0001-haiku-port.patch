@@ -0,0 +1,828 @@
+/*
+ * Copyright (C) 2010 Stephan Aßmus <superstippi@gmx.de>
+ *
+ * All rights reserved. Distributed under the terms of the MIT License.
+ */
+
+#include "DownloadProgressView.h"
+
+#include <stdio.h>
+
+#include <Alert.h>
+#include <Application.h>
+#include <Bitmap.h>
+#include <Button.h>
+#include <Catalog.h>
+#include <Clipboard.h>
+#include <Directory.h>
