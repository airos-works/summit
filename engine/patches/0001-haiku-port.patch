+        return fData->frame->editor().canCut() || fData->frame->editor().canDHTMLCut();
+
+    return false;
+}
+
+bool BWebFrame::CanPaste() const
+{
+    if (fData->frame && fData->frame->view())
+        return fData->frame->editor().canEdit() || fData->frame->editor().canDHTMLPaste();
+
+    return false;
+}
