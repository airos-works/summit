+// Copyright (C) 2026 Summit contributors. BSD-2-Clause.
+#include "config.h"
+#include "CDMProxyHaiku.h"
+#if ENABLE(ENCRYPTED_MEDIA)
+#include <wtf/NeverDestroyed.h>
+#include <algorithm>
+namespace WebCore {
+std::optional<std::array<uint8_t, 16>> CDMProxyHaiku::key(const std::array<uint8_t, 16>& id) const
+{
+    auto value = keyValueIfAvailable(Vector<uint8_t> { std::span { id } });
+    if (!value) return std::nullopt;
+    const auto* bytes = std::get_if<Vector<uint8_t>>(&*value);
+    if (!bytes || bytes->size() != 16) return std::nullopt;
+    std::array<uint8_t, 16> result;
+    std::copy(bytes->begin(), bytes->end(), result.begin());
+    return result;
+}
+class CDMProxyFactoryHaiku final : public CDMProxyFactory {
+    RefPtr<CDMProxy> createCDMProxy(const String&) final { return CDMProxyHaiku::create(); }
+    bool supportsKeySystem(const String& name) final { return name == "org.w3.clearkey"_s; }
+};
+Vector<CDMProxyFactory*> CDMProxyFactory::platformRegisterFactories()
+{
+    static NeverDestroyed<CDMProxyFactoryHaiku> factory;
+    return { &factory.get() };
+}
+} // namespace WebCore
+#endif
