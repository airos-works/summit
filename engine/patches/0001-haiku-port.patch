+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include <wtf/TimeZone.h>
+
+// ICU first: Haiku's TimeZone.h declares namespace icu unless ICU has set
+// U_ICU_NAMESPACE already, and the engine's ICU then cannot alias it.
+#include <unicode/ucal.h>
+
+#include <Application.h>
+#include <LocaleRoster.h>
+#include <Message.h>
+#include <MessageFilter.h>
+#include <TimeZone.h>
+#include <mutex>
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+namespace WTF {
+
+// ICU finds the host time zone in TZ or the /etc/localtime link. Haiku has
+// neither: the zone is in the locale settings, and the kernel and libroot get
+// it from there. The engine's own ICU fell back to UTC, so every page showed
+// UTC times (Slack's message times were 11 hours off in Hobart). The zone of
+// the settings becomes ICU's default zone, which JSC reads on Haiku
+// (JSDateMath.cpp), and follows B_LOCALE_CHANGED: the Time preferences
+// broadcast it with the new zone.
+
+static Lock timeZoneLock;
+
+static String& currentTimeZone() WTF_REQUIRES_LOCK(timeZoneLock)
+{
+    static NeverDestroyed<String> timeZone;
+    return timeZone.get();
+}
+
+// True when ICU had another zone.
+static bool applyTimeZone(const char* identifier)
+{
+    if (!identifier || !*identifier)
+        return false;
+    String timeZone = String::fromUTF8(identifier);
+    Locker locker { timeZoneLock };
+    if (timeZone == currentTimeZone())
+        return false;
+    // The identifiers are ASCII; ICU wants them terminated.
+    Vector<char16_t, 32> characters;
+    for (const char* character = identifier; *character; ++character)
+        characters.append(static_cast<unsigned char>(*character));
+    characters.append(0);
+    UErrorCode status = U_ZERO_ERROR;
+    ucal_setDefaultTimeZone(characters.span().data(), &status);
+    if (U_FAILURE(status))
+        return false;
+    currentTimeZone() = WTF::move(timeZone);
+    return true;
+}
+
+static bool applySettingsTimeZone()
+{
+    BLocaleRoster* roster = BLocaleRoster::Default();
+    BTimeZone timeZone;
+    roster->Refresh();
+    return roster->GetDefaultTimeZone(&timeZone) == B_OK && applyTimeZone(timeZone.ID().String());
+}
+
+static filter_result localeDidChange(BMessage* message, BHandler**, BMessageFilter*)
+{
+    // A language change comes without the zone.
+    const char* identifier = nullptr;
+    bool changed = message->FindString("timezone", &identifier) == B_OK
+        ? applyTimeZone(identifier) : applySettingsTimeZone();
+    if (changed)
+        timeZoneDidChange();
+    return B_DISPATCH_MESSAGE;
+}
+
+void listenForTimeZoneChangeNotifications()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        applySettingsTimeZone();
+        // The network process has no BApplication.
+        if (be_app && be_app->Lock()) {
+            be_app->AddCommonFilter(new BMessageFilter(B_LOCALE_CHANGED, localeDidChange));
+            be_app->Unlock();
+        }
+    });
+}
+
+} // namespace WTF
