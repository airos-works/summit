+
+inline const char* editingCommandHaiku(const WebCore::PlatformKeyboardEvent& event, bool characterEvent)
+{
+    if (event.altKey() || event.metaKey())
+        return nullptr;
+    bool control = event.controlKey();
+    bool shift = event.shiftKey();
+    unsigned key = event.windowsVirtualKeyCode();
+    if (characterEvent) {
+        if (event.text().isEmpty() || control)
+            return nullptr;
+        switch (event.text()[0]) {
+        case '\t': return shift ? "InsertBacktab" : "InsertTab";
+        case '\r':
+        case '\n': return shift ? "InsertLineBreak" : "InsertNewline";
+        default: return nullptr;
+        }
+    }
+    switch (key) {
+    case VK_LEFT:
+        return control ? (shift ? "MoveWordLeftAndModifySelection" : "MoveWordLeft")
+            : (shift ? "MoveLeftAndModifySelection" : "MoveLeft");
+    case VK_RIGHT:
+        return control ? (shift ? "MoveWordRightAndModifySelection" : "MoveWordRight")
+            : (shift ? "MoveRightAndModifySelection" : "MoveRight");
+    case VK_UP:
+        return control ? (shift ? "MoveParagraphBackwardAndModifySelection" : "MoveToBeginningOfParagraph")
+            : (shift ? "MoveUpAndModifySelection" : "MoveUp");
+    case VK_DOWN:
+        return control ? (shift ? "MoveParagraphForwardAndModifySelection" : "MoveToEndOfParagraph")
+            : (shift ? "MoveDownAndModifySelection" : "MoveDown");
+    case VK_HOME:
+        return control ? (shift ? "MoveToBeginningOfDocumentAndModifySelection" : "MoveToBeginningOfDocument")
+            : (shift ? "MoveToBeginningOfLineAndModifySelection" : "MoveToBeginningOfLine");
+    case VK_END:
+        return control ? (shift ? "MoveToEndOfDocumentAndModifySelection" : "MoveToEndOfDocument")
+            : (shift ? "MoveToEndOfLineAndModifySelection" : "MoveToEndOfLine");
+    case VK_PRIOR: return shift ? "MovePageUpAndModifySelection" : "MovePageUp";
+    case VK_NEXT: return shift ? "MovePageDownAndModifySelection" : "MovePageDown";
+    case VK_BACK: return control ? "DeleteWordBackward" : "DeleteBackward";
+    case VK_DELETE: return control ? "DeleteWordForward" : "DeleteForward";
+    case VK_TAB: return control ? nullptr : (shift ? "InsertBacktab" : "InsertTab");
+    case VK_RETURN: return control ? nullptr : (shift ? "InsertLineBreak" : "InsertNewline");
+    case VK_ESCAPE: return control || shift ? nullptr : "Cancel";
+    default: break;
+    }
+    if (!control)
+        return nullptr;
+    if (key == VK_Z)
+        return shift ? "Redo" : "Undo";
+    if (shift)
+        return nullptr;
+    switch (key) {
+    case VK_A: return "SelectAll";
+    case VK_B: return "ToggleBold";
+    case VK_C: return "Copy";
+    case VK_I: return "ToggleItalic";
+    case VK_V: return "Paste";
+    case VK_X: return "Cut";
+    case VK_Y: return "Redo";
+    default: return nullptr;
+    }
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/Shared/haiku/NativeWebEventsHaiku.cpp b/Source/WebKit/Shared/haiku/NativeWebEventsHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8f2c1c6acdb7f6d0dbdc3474d2bbe68a414276b5
--- /dev/null
+++ b/Source/WebKit/Shared/haiku/NativeWebEventsHaiku.cpp
@@ -0,0 +1,183 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "NativeWebKeyboardEvent.h"
+#include "NativeWebMouseEvent.h"
+#include "NativeWebWheelEvent.h"
+
+#include <InterfaceDefs.h>
+#include <String.h>
+#include <View.h>
+#include <WebCore/PlatformKeyboardEvent.h>
+#include <WebCore/Scrollbar.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(NativeWebKeyboardEvent);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(NativeWebMouseEvent);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(NativeWebWheelEvent);
+
+static OptionSet<WebEventModifier> eventModifiers(const BMessage& message)
+{
+    auto native = message.FindInt32("modifiers");
+    OptionSet<WebEventModifier> result;
+    if (native & B_SHIFT_KEY)
+        result.add(WebEventModifier::ShiftKey);
+    // Match WebCore's Haiku mapping: the native Command key provides the web
+    // Control shortcuts, while native Control provides the web Alt modifier.
+    if (native & B_COMMAND_KEY)
+        result.add(WebEventModifier::ControlKey);
+    if (native & B_CONTROL_KEY)
+        result.add(WebEventModifier::AltKey);
+    if (native & B_OPTION_KEY)
+        result.add(WebEventModifier::MetaKey);
+    if (native & B_CAPS_LOCK)
+        result.add(WebEventModifier::CapsLockKey);
+    return result;
+}
+
+static WebEventData makeEventDataHaiku(const BMessage& message, WebEventType type)
+{
+    int64 when = 0;
+    message.FindInt64("when", &when);
+    return { type, eventModifiers(message), when > 0 ? MonotonicTime::fromRawSeconds(when / 1000000.0) : MonotonicTime::now() };
+}
+
+static bool validPosition(BPoint position)
+{
+    return std::isfinite(position.x) && std::isfinite(position.y)
+        && std::abs(position.x) < 1e7f && std::abs(position.y) < 1e7f;
+}
+
+RefPtr<NativeWebKeyboardEvent> NativeWebKeyboardEvent::create(const BMessage& message)
+{
+    bool keyDown = message.what == B_KEY_DOWN || message.what == B_UNMAPPED_KEY_DOWN;
+    if (!keyDown && message.what != B_KEY_UP && message.what != B_UNMAPPED_KEY_UP)
+        return nullptr;
+    BString bytes = message.FindString("bytes");
+    auto keyCode = message.FindInt32("key");
+    WebKeyboardEventData keyboard;
+    keyboard.text = String::fromUTF8(std::span<const char> { bytes.String(), static_cast<size_t>(bytes.Length()) });
+    if (keyboard.text.isNull() && bytes.Length())
+        return nullptr;
+    keyboard.unmodifiedText = keyboard.text;
+    keyboard.key = PlatformKeyboardEvent::KeyValueForKeyEvent(bytes, keyCode);
+    keyboard.code = PlatformKeyboardEvent::KeyCodeForKeyEvent(keyCode);
+    keyboard.keyIdentifier = PlatformKeyboardEvent::keyIdentifierForHaikuKeyCode(bytes.ByteAt(0), keyCode);
+    keyboard.windowsVirtualKeyCode = PlatformKeyboardEvent::windowsKeyCodeForKeyEvent(bytes.ByteAt(0), keyCode);
+    keyboard.nativeVirtualKeyCode = keyCode;
+    keyboard.isAutoRepeat = keyDown && message.FindInt32("be:key_repeat") > 0;
+    keyboard.isKeypad = keyboard.code.startsWith("Numpad"_s);
+    if (keyboard.text.isEmpty()) {
+        if (keyboard.code.startsWith("Shift"_s))
+            keyboard.key = "Shift"_s;
+        else if (keyboard.code.startsWith("Control"_s))
+            keyboard.key = "Alt"_s;
+        else if (keyboard.code.startsWith("Alt"_s))
+            keyboard.key = "Control"_s;
+        else if (keyboard.code.startsWith("Meta"_s))
+            keyboard.key = "Meta"_s;
+        else if (keyboard.code == "CapsLock"_s || keyboard.code == "NumLock"_s)
+            keyboard.key = keyboard.code;
+        else
+            keyboard.key = "Unidentified"_s;
+    }
+    return adoptRef(*new NativeWebKeyboardEvent({ makeEventDataHaiku(message, keyDown ? WebEventType::KeyDown : WebEventType::KeyUp), WTF::move(keyboard) }, message));
+}
+
+NativeWebKeyboardEvent::NativeWebKeyboardEvent(WebKeyboardEventInit&& init, const BMessage& message)
+    : WebKeyboardEvent(WTF::move(init.event), WTF::move(init.keyboard))
+    , m_nativeEvent(message)
+{
+}
+
+static WebMouseEventButton mouseButtonForMask(uint32_t buttons)
+{
+    if (buttons & B_PRIMARY_MOUSE_BUTTON)
+        return WebMouseEventButton::Left;
+    if (buttons & B_SECONDARY_MOUSE_BUTTON)
+        return WebMouseEventButton::Right;
+    if (buttons & B_TERTIARY_MOUSE_BUTTON)
+        return WebMouseEventButton::Middle;
+    if (buttons & 8)
+        return WebMouseEventButton::Back;
+    if (buttons & 16)
+        return WebMouseEventButton::Forward;
+    return WebMouseEventButton::None;
+}
+
+RefPtr<NativeWebMouseEvent> NativeWebMouseEvent::create(const BMessage& message, BPoint viewPosition, BPoint screenPosition, uint32_t previousButtons)
+{
+    if ((message.what != B_MOUSE_DOWN && message.what != B_MOUSE_UP && message.what != B_MOUSE_MOVED)
+        || !validPosition(viewPosition) || !validPosition(screenPosition))
+        return nullptr;
+    WebEventType type = message.what == B_MOUSE_DOWN ? WebEventType::MouseDown
+        : message.what == B_MOUSE_UP ? WebEventType::MouseUp : WebEventType::MouseMove;
+    auto buttons = static_cast<uint32_t>(message.FindInt32("buttons")) & 31;
+    uint32_t changedButtons = buttons;
+    if (type == WebEventType::MouseDown)
+        changedButtons = buttons & ~previousButtons;
+    else if (type == WebEventType::MouseUp)
+        changedButtons = previousButtons & ~buttons;
+    WebMouseEventData mouse;
+    mouse.button = mouseButtonForMask(changedButtons);
+    mouse.buttons = buttons;
+    mouse.position = { viewPosition.x, viewPosition.y };
+    mouse.globalPosition = { screenPosition.x, screenPosition.y };
+    mouse.clickCount = type == WebEventType::MouseMove ? 0 : std::max(0, message.FindInt32("clicks"));
+    return adoptRef(*new NativeWebMouseEvent({ makeEventDataHaiku(message, type), WTF::move(mouse) }, message));
+}
+
+NativeWebMouseEvent::NativeWebMouseEvent(WebMouseEventInit&& init, const BMessage& message)
+    : WebMouseEvent(WTF::move(init.event), WTF::move(init.mouse))
+    , m_nativeEvent(message)
+{
+}
+
+// One notch of a Haiku mouse wheel is one tick. WebKit's line step (40 px)
+// made each notch crawl, and a notch animated over 40 px easily reads as the
+// wheel not working. Haiku's own scroll views move three small steps a notch;
+// Chrome moves 100 px. SUMMIT_WHEEL_PIXELS_PER_NOTCH (10 to 400) overrides it.
+static float wheelPixelsPerNotch()
+{
+    static float pixels = [] {
+        if (const char* value = std::getenv("SUMMIT_WHEEL_PIXELS_PER_NOTCH")) {
+            float requested = std::strtof(value, nullptr);
+            if (requested >= 10 && requested <= 400)
+                return requested;
+        }
+        return 2.5f * Scrollbar::pixelsPerLineStep();
+    }();
+    return pixels;
+}
+
+RefPtr<NativeWebWheelEvent> NativeWebWheelEvent::create(const BMessage& message, BPoint viewPosition, BPoint screenPosition)
+{
+    if (message.what != B_MOUSE_WHEEL_CHANGED || !validPosition(viewPosition) || !validPosition(screenPosition))
+        return nullptr;
+    float deltaX = message.FindFloat("be:wheel_delta_x");
+    float deltaY = message.FindFloat("be:wheel_delta_y");
+    if (!std::isfinite(deltaX) || !std::isfinite(deltaY) || std::abs(deltaX) > 1e6f || std::abs(deltaY) > 1e6f)
+        return nullptr;
+    WebWheelEventData wheel;
+    wheel.position = { static_cast<int>(std::round(viewPosition.x)), static_cast<int>(std::round(viewPosition.y)) };
+    wheel.globalPosition = { static_cast<int>(std::round(screenPosition.x)), static_cast<int>(std::round(screenPosition.y)) };
+    wheel.wheelTicks = { -deltaX, -deltaY };
+    wheel.delta = wheel.wheelTicks;
+    wheel.delta.scale(wheelPixelsPerNotch());
+    wheel.granularity = WebWheelEventGranularity::ScrollByPixelWheelEvent;
+    return adoptRef(*new NativeWebWheelEvent({ makeEventDataHaiku(message, WebEventType::Wheel), WTF::move(wheel) }, message));
+}
+
+NativeWebWheelEvent::NativeWebWheelEvent(WebWheelEventInit&& init, const BMessage& message)
+    : WebWheelEvent(WTF::move(init.event), WTF::move(init.wheel))
+    , m_nativeEvent(message)
+{
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/Shared/haiku/ProcessDiagnosticsHaiku.cpp b/Source/WebKit/Shared/haiku/ProcessDiagnosticsHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f7f33487ae0c3fcd65e4f55adaa73078af451b2
--- /dev/null
+++ b/Source/WebKit/Shared/haiku/ProcessDiagnosticsHaiku.cpp
@@ -0,0 +1,421 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#include "config.h"
+#include "ProcessDiagnosticsHaiku.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <condition_variable>
+#include <string>
+#include <unistd.h>
+#include <vector>
+#include <wtf/RunLoop.h>
+
+namespace WebKit {
+namespace ProcessDiagnosticsHaiku {
+
+namespace {
+
+constexpr const char* portName = "WebKit diagnostics";
+constexpr int32 requestCode = 'wdrq';
+constexpr int32 chunkCode = 'wdrc';
+constexpr int32 endCode = 'wdre';
+constexpr size_t chunkSize = 64 * 1024;
+
+struct Provider {
+    std::string name;
+    bool mainThread { false };
+    Function<Ref<JSON::Object>()> function;
+};
+
+std::mutex providersLock;
+std::vector<std::unique_ptr<Provider>> topics;
+std::vector<std::unique_ptr<Provider>> actions;
+std::string processRole;
+std::atomic<bool> started { false };
+
+std::string jsonText(Ref<JSON::Object>&& object)
+{
+    auto text = object->toJSONString().utf8();
+    return std::string(text.legacyCStringPointer(), text.length());
+}
+
+std::string jsonQuoted(const std::string& text)
+{
+    auto value = JSON::Value::create(String::fromUTF8(text.c_str()));
+    auto json = value->toJSONString().utf8();
+    return std::string(json.legacyCStringPointer(), json.length());
+}
+
+// What the main thread collected for one request. The requesting thread may
+// give up before the main thread gets to it; then the results are dropped.
+struct Collection {
+    std::mutex lock;
+    std::condition_variable condition;
+    bool done { false };
+    bool abandoned { false };
+    bigtime_t queuedAt { 0 };
+    bigtime_t startedAt { 0 };
+    bigtime_t finishedAt { 0 };
+    std::vector<std::pair<std::string, std::string>> results;
+};
+
+Ref<JSON::Object> processReport()
+{
+    auto report = JSON::Object::create();
+    report->setInteger("team"_s, getpid());
+    report->setString("role"_s, String::fromUTF8(processRole.c_str()));
+    team_info team;
+    if (get_team_info(B_CURRENT_TEAM, &team) == B_OK) {
+        report->setInteger("threads"_s, team.thread_count);
+        report->setDouble("uptimeSeconds"_s, (system_time() - team.start_time) / 1e6);
+    }
+    uint64 resident = 0, reserved = 0;
+    int areas = 0;
+    ssize_t cookie = 0;
+    area_info area;
+    while (get_next_area_info(B_CURRENT_TEAM, &cookie, &area) == B_OK) {
+        resident += area.ram_size;
+        reserved += area.size;
+        ++areas;
+    }
+    report->setInteger("areas"_s, areas);
+    report->setDouble("residentMiB"_s, resident / 1048576.0);
+    report->setDouble("reservedMiB"_s, reserved / 1048576.0);
+    return report;
+}
+
+std::vector<std::string> requestedTopics(const RefPtr<JSON::Object>& request)
+{
+    std::vector<std::string> names;
+    String list;
+    if (request && request->getString("topics"_s, list)) {
+        auto text = list.utf8();
+        std::string all(text.legacyCStringPointer(), text.length());
+        size_t start = 0;
+        while (start <= all.size()) {
+            size_t comma = all.find(',', start);
+            if (comma == std::string::npos)
+                comma = all.size();
+            std::string name = all.substr(start, comma - start);
+            name.erase(0, name.find_first_not_of(' '));
+            name.erase(name.find_last_not_of(' ') + 1);
+            if (!name.empty())
+                names.push_back(name);
+            start = comma + 1;
+        }
+    }
+    if (names.empty() || std::find(names.begin(), names.end(), "all") != names.end()) {
+        names.clear();
+        std::lock_guard guard(providersLock);
+        for (auto& topic : topics)
+            names.push_back(topic->name);
+    }
+    return names;
+}
+
+std::string handle(const std::string& requestText)
+{
+    auto parsed = JSON::Value::parseJSON(String::fromUTF8(requestText.c_str()));
+    RefPtr<JSON::Object> request = parsed ? parsed->asObject() : nullptr;
+    int timeoutMs = 2000;
+    if (request) {
+        if (auto value = request->getInteger("timeoutMs"_s))
+            timeoutMs = std::clamp(*value, 50, 120000);
+    }
+    String actionName;
+    const bool isAction = request && request->getString("action"_s, actionName);
+
+    std::vector<std::pair<std::string, std::string>> parts;
+    parts.emplace_back("process", jsonText(processReport()));
+
+    std::vector<Provider*> mainThreadProviders;
+    std::string unknown;
+    if (isAction) {
+        auto name = actionName.utf8();
+        std::lock_guard guard(providersLock);
+        for (auto& action : actions) {
+            if (action->name == name.legacyCStringPointer())
+                mainThreadProviders.push_back(action.get());
+        }
+        if (mainThreadProviders.empty())
+            unknown = name.legacyCStringPointer();
+        if (timeoutMs == 2000)
+            timeoutMs = 30000;
+    } else {
+        for (auto& name : requestedTopics(request)) {
+            Provider* provider = nullptr;
+            {
+                std::lock_guard guard(providersLock);
+                for (auto& topic : topics) {
+                    if (topic->name == name)
+                        provider = topic.get();
+                }
+            }
+            if (!provider) {
+                unknown += (unknown.empty() ? "" : ",") + name;
+                continue;
+            }
+            if (provider->mainThread)
+                mainThreadProviders.push_back(provider);
+            else
+                parts.emplace_back(provider->name, jsonText(provider->function()));
+        }
+    }
+
+    if (!mainThreadProviders.empty()) {
+        auto collection = std::make_shared<Collection>();
+        collection->queuedAt = system_time();
+        RunLoop::mainSingleton().dispatch([collection, mainThreadProviders] {
+            {
+                std::lock_guard guard(collection->lock);
+                if (collection->abandoned)
+                    return;
+                collection->startedAt = system_time();
+            }
+            std::vector<std::pair<std::string, std::string>> results;
+            for (auto* provider : mainThreadProviders)
+                results.emplace_back(provider->name, jsonText(provider->function()));
+            std::lock_guard guard(collection->lock);
+            if (collection->abandoned)
+                return;
+            collection->results = std::move(results);
+            collection->finishedAt = system_time();
+            collection->done = true;
+            collection->condition.notify_all();
+        });
+        std::unique_lock guard(collection->lock);
+        collection->condition.wait_for(guard, std::chrono::milliseconds(timeoutMs), [&] { return collection->done; });
+        std::string mainThread;
+        if (collection->done) {
+            for (auto& result : collection->results)
+                parts.push_back(result);
+            char text[160];
+            snprintf(text, sizeof(text), "{\"responsive\":true,\"queueDelayMs\":%.1f,\"collectMs\":%.1f}",
+                (collection->startedAt - collection->queuedAt) / 1000.0, (collection->finishedAt - collection->startedAt) / 1000.0);
+            mainThread = text;
+        } else {
+            collection->abandoned = true;
+            char text[200];
+            snprintf(text, sizeof(text), "{\"responsive\":false,\"note\":\"the main thread did not run the request within %d ms%s\"}",
+                timeoutMs, collection->startedAt ? " (it started, so it is slow rather than stuck)" : " (busy or hung)");
+            mainThread = text;
+        }
+        parts.emplace_back("mainThread", mainThread);
+    }
+    if (!unknown.empty())
+        parts.emplace_back("unknown", jsonQuoted(unknown));
+
+    std::string answer = "{";
+    for (size_t i = 0; i < parts.size(); ++i) {
+        if (i)
+            answer += ',';
+        answer += jsonQuoted(parts[i].first) + ":" + parts[i].second;
+    }
+    answer += "}";
+    return answer;
+}
+
+status_t serve(void*)
+{
+    const port_id port = create_port(8, portName);
+    if (port < 0)
+        return port;
+    std::vector<char> buffer;
+    while (true) {
+        const ssize_t size = port_buffer_size(port);
+        if (size == B_INTERRUPTED)
+            continue;
+        if (size < 0)
+            break;
+        buffer.resize(std::max<ssize_t>(size, 1));
+        int32 code = 0;
+        const ssize_t got = read_port(port, &code, buffer.data(), buffer.size());
+        if (got < 0) {
+            if (got == B_INTERRUPTED)
+                continue;
+            break;
+        }
+        if (code != requestCode || got < static_cast<ssize_t>(sizeof(port_id)))
+            continue;
+        port_id reply;
+        memcpy(&reply, buffer.data(), sizeof(reply));
+        std::string request(buffer.data() + sizeof(reply), got - sizeof(reply));
+        const std::string answer = handle(request);
+        size_t offset = 0;
+        do {
+            const size_t length = std::min(chunkSize, answer.size() - offset);
+            const bool last = offset + length >= answer.size();
+            if (write_port_etc(reply, last ? endCode : chunkCode, answer.data() + offset, length, B_RELATIVE_TIMEOUT, 2000000) != B_OK)
+                break;
+            offset += length;
+        } while (offset < answer.size());
+    }
+    return B_OK;
+}
+
+// The compositors' counters.
+struct FrameRecord {
+    bigtime_t started { 0 };
+    bigtime_t duration { 0 };
+    bool scrolling { false };
+};
+std::mutex compositorLock;
+std::string glRenderer, glVendor, glVersion;
+std::atomic<int> compositors { 0 };
+std::atomic<uint64_t> framesTotal { 0 };
+std::atomic<uint64_t> framesScrolling { 0 };
+std::atomic<uint64_t> renderMicrosTotal { 0 };
+FrameRecord recentFrames[240];
+
+} // namespace
+
+void start(const char* role)
+{
+    if (started.exchange(true))
+        return;
+    processRole = role;
+    const thread_id thread = spawn_thread(serve, "WebKit diagnostics", B_NORMAL_PRIORITY, nullptr);
+    if (thread >= 0)
+        resume_thread(thread);
+}
+
+void addTopic(const char* name, bool mainThread, Function<Ref<JSON::Object>()>&& function)
+{
+    std::lock_guard guard(providersLock);
+    topics.push_back(std::make_unique<Provider>(Provider { name, mainThread, WTF::move(function) }));
+}
+
+void addAction(const char* name, Function<Ref<JSON::Object>()>&& function)
+{
+    std::lock_guard guard(providersLock);
+    actions.push_back(std::make_unique<Provider>(Provider { name, true, WTF::move(function) }));
+}
+
+String request(team_id team, const String& requestJSON, Seconds timeout)
+{
+    port_id target = -1;
+    int32 cookie = 0;
+    port_info info;
+    while (get_next_port_info(team, &cookie, &info) == B_OK) {
+        if (!strcmp(info.name, portName)) {
+            target = info.port;
+            break;
+        }
+    }
+    if (target < 0)
+        return { };
+    const port_id reply = create_port(4, "WebKit diagnostics reply");
+    if (reply < 0)
+        return { };
+    const bigtime_t deadline = system_time() + static_cast<bigtime_t>(timeout.microseconds());
+    auto text = requestJSON.utf8();
+    std::vector<char> message(sizeof(port_id) + text.length());
+    memcpy(message.data(), &reply, sizeof(reply));
+    memcpy(message.data() + sizeof(reply), text.legacyCStringPointer(), text.length());
+    std::string answer;
+    bool complete = false;
+    if (write_port_etc(target, requestCode, message.data(), message.size(), B_ABSOLUTE_TIMEOUT, deadline) == B_OK) {
+        std::vector<char> buffer;
+        while (true) {
+            const ssize_t size = port_buffer_size_etc(reply, B_ABSOLUTE_TIMEOUT, deadline);
+            if (size == B_INTERRUPTED)
+                continue;
+            if (size < 0)
+                break;
+            buffer.resize(std::max<ssize_t>(size, 1));
+            int32 code = 0;
+            const ssize_t got = read_port_etc(reply, &code, buffer.data(), buffer.size(), B_ABSOLUTE_TIMEOUT, deadline);
+            if (got < 0)
+                break;
+            answer.append(buffer.data(), got);
+            if (code == endCode) {
+                complete = true;
+                break;
+            }
+        }
+    }
+    delete_port(reply);
+    if (!complete)
+        return { };
+    return String::fromUTF8(answer.c_str());
+}
+
+void setGLStrings(const char* renderer, const char* vendor, const char* version)
+{
+    std::lock_guard guard(compositorLock);
+    glRenderer = renderer ? renderer : "";
+    glVendor = vendor ? vendor : "";
+    glVersion = version ? version : "";
+}
+
+void compositorCreated()
+{
+    ++compositors;
+}
+
+void compositorDestroyed()
+{
+    --compositors;
+}
+
+void frameRendered(bigtime_t started, bigtime_t duration, bool scrolling)
+{
+    const uint64_t index = framesTotal++;
+    renderMicrosTotal += duration;
+    if (scrolling)
+        ++framesScrolling;
+    std::lock_guard guard(compositorLock);
+    recentFrames[index % std::size(recentFrames)] = { started, duration, scrolling };
+}
+
+Ref<JSON::Object> compositorReport()
+{
+    auto report = JSON::Object::create();
+    std::vector<FrameRecord> frames;
+    {
+        std::lock_guard guard(compositorLock);
+        report->setString("glRenderer"_s, String::fromUTF8(glRenderer.c_str()));
+        report->setString("glVendor"_s, String::fromUTF8(glVendor.c_str()));
+        report->setString("glVersion"_s, String::fromUTF8(glVersion.c_str()));
+        for (auto& frame : recentFrames) {
+            if (frame.started)
+                frames.push_back(frame);
+        }
+    }
+    report->setInteger("compositors"_s, compositors.load());
+    report->setDouble("framesRendered"_s, static_cast<double>(framesTotal.load()));
+    report->setDouble("framesForScrolling"_s, static_cast<double>(framesScrolling.load()));
+    report->setDouble("renderSecondsTotal"_s, renderMicrosTotal.load() / 1e6);
+    if (frames.empty())
+        return report;
+    std::sort(frames.begin(), frames.end(), [](auto& a, auto& b) { return a.started < b.started; });
+    const bigtime_t now = system_time();
+    report->setDouble("lastFrameAgoMs"_s, (now - frames.back().started) / 1000.0);
+    unsigned lastSecond = 0, lastFive = 0;
+    std::vector<bigtime_t> durations;
+    for (auto& frame : frames) {
+        if (now - frame.started <= 1000000)
+            ++lastSecond;
+        if (now - frame.started <= 5000000)
+            ++lastFive;
+        durations.push_back(frame.duration);
+    }
+    std::sort(durations.begin(), durations.end());
+    report->setInteger("framesLastSecond"_s, lastSecond);
+    report->setDouble("framesPerSecondLast5s"_s, lastFive / 5.0);
+    auto recent = JSON::Object::create();
+    recent->setInteger("frames"_s, static_cast<int>(durations.size()));
+    recent->setDouble("medianMs"_s, durations[durations.size() / 2] / 1000.0);
+    recent->setDouble("p95Ms"_s, durations[std::min(durations.size() - 1, durations.size() * 95 / 100)] / 1000.0);
+    recent->setDouble("longestMs"_s, durations.back() / 1000.0);
+    report->setObject("recentRenderTimes"_s, WTF::move(recent));
+    return report;
+}
+
+} // namespace ProcessDiagnosticsHaiku
+} // namespace WebKit
diff --git a/Source/WebKit/Shared/haiku/ProcessDiagnosticsHaiku.h b/Source/WebKit/Shared/haiku/ProcessDiagnosticsHaiku.h
