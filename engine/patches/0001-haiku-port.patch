+class WebPageProxy;
+struct DownloadRegistryEventHaiku;
+
+// Bridges the context-owned native download registry to the downloads
+// extension API. It observes every download of its browser context (as other
+// browsers expose them to extensions with the "downloads" permission) and keeps
+// a history for the lifetime of the controller; the history is not persisted.
+// Confined to the WTF main RunLoop.
+class WebExtensionDownloadsHaiku final {
+    WTF_MAKE_TZONE_ALLOCATED(WebExtensionDownloadsHaiku);
+public:
+    explicit WebExtensionDownloadsHaiku(WebExtensionController&);
+    ~WebExtensionDownloadsHaiku();
+
+    // Starts a download continuing a paused one (WebViewContextHaiku::resumeDownload):
+    // url, path, validator, expected size, the download it continues, the new identifier.
+    using Resumer = Function<status_t(const String&, const String&, const String&, int64_t, uint64_t, uint64_t&)>;
+    void attach(const std::shared_ptr<DownloadRegistryHaiku>&, bool incognito, Resumer&& = nullptr);
+    void shutdown();
+
+    // destination: a DownloadRegistryHaiku::Destination.
+    std::expected<uint64_t, String> start(WebExtensionContext&, WebPageProxy&, WebCore::ResourceRequest&&, const String& filename, uint8_t destination);
+    std::expected<Ref<JSON::Array>, String> search(const JSON::Object& query) const;
+    std::expected<Vector<uint64_t>, String> erase(const JSON::Object& query);
+    std::expected<void, String> cancel(uint64_t identifier);
+    std::expected<void, String> pause(uint64_t identifier);
+    std::expected<void, String> resume(uint64_t identifier);
+    std::expected<void, String> removeFile(uint64_t identifier);
+    std::expected<String, String> pathForShow(uint64_t identifier) const;
+    // A complete download's file, for open() and getFileIcon().
+    std::expected<String, String> completedFile(uint64_t identifier) const;
+    std::expected<void, String> acceptDanger(uint64_t identifier) const;
+    String directory() const;
+
+    // Registry notifications, delivered on the WTF main RunLoop.
+    void observe(const DownloadRegistryEventHaiku&);
+
+private:
+    struct Item {
+        uint64_t identifier { 0 };
+        uint64_t order { 0 };
+        String url;
+        String finalURL;
+        String filename;
+        String mimeType;
+        WallTime startTime;
+        std::optional<WallTime> endTime;
+        String state;
+        String error;
+        uint64_t bytesReceived { 0 };
+        int64_t totalBytes { -1 };
+        int64_t fileSize { -1 };
+        bool exists { false };
+        bool paused { false };
+        bool canResume { false };
+        String byExtensionIdentifier;
+        String byExtensionName;
+    };
+    // Kept beside the item (whose size HashMap bounds).
+    struct Transfer {
+        // The download transferring for the item now, or last: its first
+        // identifier, or a resumed one's.
+        uint64_t engine { 0 };
+        String validator;
+        // Resume once the transfer has stopped (resume() during a pause).
+        bool resumeWhenPaused { false };
+    };
+    struct Initiator {
+        String identifier;
+        String name;
+    };
+
+    void dispatch(WebExtensionEventListenerType, const String& argumentJSON);
+    void dispatchChanges(const Item& previous, const Item&);
+    std::expected<void, String> startResume(Item&);
+    Item* itemForEngine(uint64_t engine);
+    Transfer& transfer(const Item&);
+    Ref<JSON::Object> toJSON(const Item&) const;
+    std::expected<Vector<const Item*>, String> query(const JSON::Object&) const;
+
+    WeakPtr<WebExtensionController> m_controller;
+    std::weak_ptr<DownloadRegistryHaiku> m_registry;
+    bool m_incognito { false };
+    uint64_t m_nextOrder { 0 };
+    HashMap<uint64_t, Item> m_items;
+    HashMap<uint64_t, Initiator> m_initiators;
+    HashMap<uint64_t, Transfer> m_transfers;
+    // A resumed download's identifier -> the item it continues.
+    HashMap<uint64_t, uint64_t> m_resumed;
+    // The item resume() is starting: its Started notification comes synchronously.
+    uint64_t m_resuming { 0 };
+    Resumer m_resumer;
+};
+
+} // namespace WebKit
