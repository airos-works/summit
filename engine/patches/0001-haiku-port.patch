+void WebExtensionContext::identityLaunchWebAuthFlowHaiku(URL url, bool interactive, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    static constexpr auto apiName = "identity.launchWebAuthFlow()"_s;
+    if (!hasPermission("identity"_s)) {
+        completion(toWebExtensionError(apiName, nullString(), "permission denied"_s));
+        return;
+    }
+    if (!url.protocolIsInHTTPFamily()) {
+        completion(toWebExtensionError(apiName, "url"_s, "an http or https URL is expected"_s));
+        return;
+    }
+    // Pages are not loaded unseen, so a flow that needs no sign-in still
+    // shows its window; without interaction Chrome would fail the same way
+    // whenever the page asks for anything.
+    if (!interactive) {
+        completion(toWebExtensionError(apiName, nullString(), "User interaction required."_s));
+        return;
+    }
+    if (m_authFlowsHaiku.size() >= 4) {
+        completion(toWebExtensionError(apiName, nullString(), "too many sign-ins are in progress"_s));
+        return;
+    }
+    RefPtr controller = extensionController();
+    bool profileIsPrivate = controller && !controller->configuration().defaultWebsiteDataStore().isPersistent();
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    bool complete = message.AddUInt32("command", B_WEBKIT_BROWSER_OPEN_WINDOW) == B_OK
+        && message.AddBool("focused", true) == B_OK
+        && message.AddBool("private", profileIsPrivate) == B_OK
+        && message.AddString("type", "popup") == B_OK
+        && message.AddString("state", "normal") == B_OK
+        && message.AddDouble("left", std::numeric_limits<double>::quiet_NaN()) == B_OK
+        && message.AddDouble("top", std::numeric_limits<double>::quiet_NaN()) == B_OK
+        && message.AddDouble("width", 520) == B_OK
+        && message.AddDouble("height", 680) == B_OK
+        && message.AddString("url", url.string().utf8().legacyCStringPointer()) == B_OK;
+    if (!complete) {
+        completion(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+        return;
+    }
+    sendNativeBrowserCommand(WTF::move(message), apiName, [this, protectedThis = Ref { *this }, completion = WTF::move(completion)](NativeBrowserCommandResult&& result) mutable {
+        if (!result) {
+            completion(makeUnexpected(result.error()));
+            return;
+        }
+        RefPtr tab = result->isEmpty() ? nullptr : getOrCreateNativeTab(result->first());
+        if (!tab) {
+            completion(toWebExtensionError(apiName, nullString(), "the browser did not open the sign-in window"_s));
+            return;
+        }
+        m_authFlowsHaiku.append({ result->first(), tab->identifier(), WTF::move(completion) });
+    });
+}
+
+bool WebExtensionContext::completeAuthFlowHaiku(WebPageProxyIdentifier page, const URL& url)
+{
+    auto index = m_authFlowsHaiku.findIf([&](auto& flow) { return flow.page == page; });
+    if (index == notFound)
+        return false;
+    auto redirectHost = makeString(baseURL().host().convertToASCIILowercase(), ".chromiumapp.org"_s);
+    if (!url.protocolIsInHTTPFamily() || !equalIgnoringASCIICase(url.host(), redirectHost))
+        return false;
+    auto flow = WTF::move(m_authFlowsHaiku[index].completion);
+    m_authFlowsHaiku.removeAt(index);
+    if (RefPtr tab = getTab(page)) {
+        if (RefPtr window = tab->window())
+            window->close([](auto&&) { });
+    }
+    if (flow)
+        flow(url.string());
+    return true;
+}
+
+void WebExtensionContext::failAuthFlowHaiku(WebExtensionTabIdentifier tab)
+{
+    auto index = m_authFlowsHaiku.findIf([&](auto& flow) { return flow.tab == tab; });
+    if (index == notFound)
+        return;
+    auto flow = WTF::move(m_authFlowsHaiku[index].completion);
+    m_authFlowsHaiku.removeAt(index);
+    if (flow)
+        flow(toWebExtensionError("identity.launchWebAuthFlow()"_s, nullString(), "The user did not approve access."_s));
+}
