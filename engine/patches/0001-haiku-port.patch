+class FFmpegAudioDecoderHaiku final : public AudioDecoder {
+public:
+    static RefPtr<FFmpegAudioDecoderHaiku> create(const String& codec, const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+    {
+        auto* name = ffmpegDecoderName(codec);
+        auto* ffmpeg = name ? FFmpegAudio::load() : nullptr;
+        auto* decoder = ffmpeg ? ffmpeg->findDecoderByName(name) : nullptr;
+        if (!decoder || !config.sampleRate || !config.numberOfChannels || config.numberOfChannels > 8)
+            return nullptr;
+        std::optional<ADTSFields> adts;
+        if (isAACCodec(codec) && !config.description.isEmpty()) {
+            adts = adtsFieldsFromAudioSpecificConfig(config.description.span());
+            if (!adts)
+                return nullptr;
+        }
+        void* context = ffmpeg->allocContext(decoder);
+        if (!context)
+            return nullptr;
+        if (needsExtradata(codec)) {
+            // Freed with the context; FFmpeg's readers may look 64 bytes past the end.
+            auto& description = config.description;
+            if (description.isEmpty() || description.size() > 1 << 20 || !ffmpeg->contextExtradataOffset) {
+                ffmpeg->freeContext(&context);
+                return nullptr;
+            }
+            auto* extradata = static_cast<uint8_t*>(ffmpeg->mallocz(description.size() + 64));
+            if (!extradata) {
+                ffmpeg->freeContext(&context);
+                return nullptr;
+            }
+            memcpy(extradata, description.span().data(), description.size());
+            int size = description.size();
+            auto* bytes = static_cast<uint8_t*>(context);
+            memcpy(bytes + ffmpeg->contextExtradataOffset, &extradata, sizeof(extradata));
+            memcpy(bytes + ffmpeg->contextExtradataOffset + sizeof(extradata), &size, sizeof(size));
+        }
+        if (ffmpeg->open(context, decoder, nullptr) < 0) {
+            ffmpeg->freeContext(&context);
+            return nullptr;
+        }
+        return adoptRef(*new FFmpegAudioDecoderHaiku(*ffmpeg, context, adts, config, WTF::move(outputCallback)));
+    }
+
+    ~FFmpegAudioDecoderHaiku()
+    {
+        m_ffmpeg.freeFrame(&m_frame);
+        m_ffmpeg.freePacket(&m_packet);
+        m_ffmpeg.freeContext(&m_context);
+    }
+
+private:
+    FFmpegAudioDecoderHaiku(const FFmpegAudio& ffmpeg, void* context, std::optional<ADTSFields> adts, const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+        : m_ffmpeg(ffmpeg)
+        , m_context(context)
+        , m_packet(ffmpeg.allocPacket())
+        , m_frame(ffmpeg.allocFrame())
+        , m_adts(adts)
+        , m_sampleRate(config.sampleRate)
+        , m_channels(config.numberOfChannels)
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs FFmpeg audio decoder"_s))
+    {
+    }
+
+    Ref<DecodePromise> decode(AudioEncodedData&& chunk) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, chunk = WTF::move(chunk).isolatedCopy()] mutable {
+            return protectedThis->decodeOnQueue(WTF::move(chunk));
+        });
+    }
+
+    Ref<DecodePromise> decodeOnQueue(AudioEncodedData&& chunk)
+    {
+        if (m_isClosed)
+            return DecodePromise::createAndReject("The decoder is closed"_s);
+        if (!m_packet || !m_frame)
+            return DecodePromise::createAndReject("Out of memory"_s);
+        auto data = chunk.data->span();
+        Vector<uint8_t> framed;
+        if (m_adts) {
+            framed = adtsFrame(*m_adts, data);
+            data = framed.span();
+        }
+        // The decoders give one block of samples a packet, in order.
+        m_timestamps.append(chunk.timestamp);
+        auto* packet = static_cast<AVPacketPrefix*>(m_packet);
+        packet->data = const_cast<uint8_t*>(data.data());
+        packet->size = data.size();
+        int result = m_ffmpeg.sendPacket(m_context, m_packet);
+        packet->data = nullptr;
+        packet->size = 0;
+        if (result < 0 && result != averrorEAGAIN)
+            return DecodePromise::createAndReject(makeString("Audio decoding failed with error "_s, result));
+        receive();
+        return DecodePromise::createAndResolve();
+    }
+
+    void receive()
+    {
+        while (m_ffmpeg.receiveFrame(m_context, m_frame) >= 0) {
+            auto* frame = static_cast<AVFramePrefix*>(m_frame);
+            int64_t timestamp = m_timestamps.isEmpty() ? m_nextTimestamp : m_timestamps.takeFirst();
+            if (RefPtr data = audioData(*frame, timestamp)) {
+                m_nextTimestamp = timestamp + data->duration().value_or(0);
+                m_outputCallback(DecodedData { data.releaseNonNull() });
+            }
+        }
+    }
+
+    RefPtr<PlatformRawAudioDataHaiku> audioData(const AVFramePrefix& frame, int64_t timestamp)
+    {
+        size_t samples = std::max(frame.sampleCount, 0);
+        bool planar = frame.format >= sampleU8Planar;
+        // A planar frame has one plane a channel; a packed one, the channels configured.
+        size_t channels = m_channels;
+        if (planar) {
+            channels = 0;
+            while (channels < 8 && frame.data[channels])
+                ++channels;
+        }
+        if (!samples || !channels)
+            return nullptr;
+        size_t sampleSize = 0;
+        AudioSampleFormat format;
+        switch (frame.format) {
+        case sampleU8: case sampleU8Planar: sampleSize = 1; format = planar ? AudioSampleFormat::U8Planar : AudioSampleFormat::U8; break;
+        case sampleS16: case sampleS16Planar: sampleSize = 2; format = planar ? AudioSampleFormat::S16Planar : AudioSampleFormat::S16; break;
+        case sampleS32: case sampleS32Planar: sampleSize = 4; format = planar ? AudioSampleFormat::S32Planar : AudioSampleFormat::S32; break;
+        case sampleFloat: case sampleFloatPlanar: case sampleDouble: case sampleDoublePlanar:
+            sampleSize = 4;
+            format = planar ? AudioSampleFormat::F32Planar : AudioSampleFormat::F32;
+            break;
+        default:
+            return nullptr;
+        }
+        bool isDouble = frame.format == sampleDouble || frame.format == sampleDoublePlanar;
+        Vector<uint8_t> bytes(samples * channels * sampleSize);
+        auto copyPlane = [&](const uint8_t* source, size_t values, size_t destinationOffset) {
+            if (isDouble) {
+                auto* doubles = reinterpret_cast<const double*>(source);
+                for (size_t i = 0; i < values; ++i) {
+                    float value = doubles[i];
+                    memcpy(bytes.mutableSpan().data() + destinationOffset + i * 4, &value, 4);
+                }
+            } else
+                memcpy(bytes.mutableSpan().data() + destinationOffset, source, values * sampleSize);
+        };
+        if (planar) {
+            for (size_t channel = 0; channel < channels; ++channel)
+                copyPlane(frame.data[channel], samples, channel * samples * sampleSize);
+        } else
+            copyPlane(frame.data[0], samples * channels, 0);
+        return PlatformRawAudioDataHaiku::create(SharedBuffer::create(WTF::move(bytes)), format, m_sampleRate, timestamp, samples, channels);
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }] {
+            // A null packet drains the decoder; flushing its buffers lets it
+            // take packets again.
+            protectedThis->m_ffmpeg.sendPacket(protectedThis->m_context, nullptr);
+            protectedThis->receive();
+            protectedThis->m_ffmpeg.flushBuffers(protectedThis->m_context);
+            protectedThis->m_timestamps.clear();
+            return GenericPromise::createAndResolve();
+        });
+    }
+
+    void reset() final
+    {
+        m_queue->dispatch([protectedThis = Ref { *this }] {
+            protectedThis->m_ffmpeg.flushBuffers(protectedThis->m_context);
+            protectedThis->m_timestamps.clear();
+        });
+    }
+
+    void close() final { m_isClosed = true; }
+
+    const FFmpegAudio& m_ffmpeg;
+    void* m_context;
+    void* m_packet;
+    void* m_frame;
+    const std::optional<ADTSFields> m_adts;
+    const unsigned m_sampleRate;
+    const unsigned m_channels;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    Deque<int64_t> m_timestamps;
+    int64_t m_nextTimestamp { 0 };
+    std::atomic<bool> m_isClosed { false };
+};
+
+class OpusAudioEncoderHaiku final : public AudioEncoder {
+public:
+    static RefPtr<OpusAudioEncoderHaiku> create(const AudioEncoder::Config& config, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+    {
+        if ((!isOpusSampleRate(config.sampleRate) && !isResampledOpusRate(config.sampleRate)) || !config.numberOfChannels || config.numberOfChannels > 2)
+            return nullptr;
+        auto opusConfig = config.opusConfig.value_or(OpusConfig { });
+        if (opusConfig.isOggBitStream)
+            return nullptr;
+        // 2.5, 5, 10, 20, 40 or 60 ms a packet.
+        static constexpr std::array durations { 2500, 5000, 10000, 20000, 40000, 60000 };
+        if (std::ranges::find(durations, opusConfig.frameDuration) == durations.end())
+            return nullptr;
+        int error = OPUS_OK;
+        unsigned codecRate = opusCodecRate(config.sampleRate);
+        auto* encoder = opus_encoder_create(codecRate, config.numberOfChannels, OPUS_APPLICATION_AUDIO, &error);
+        if (!encoder || error != OPUS_OK)
+            return nullptr;
+        opus_encoder_ctl(encoder, OPUS_SET_BITRATE(config.bitRate ? static_cast<opus_int32>(config.bitRate) : OPUS_AUTO));
+        opus_encoder_ctl(encoder, OPUS_SET_VBR(config.bitRateMode == BitrateMode::Constant ? 0 : 1));
+        if (opusConfig.complexity)
+            opus_encoder_ctl(encoder, OPUS_SET_COMPLEXITY(static_cast<opus_int32>(std::min<size_t>(*opusConfig.complexity, 10))));
+        opus_encoder_ctl(encoder, OPUS_SET_PACKET_LOSS_PERC(static_cast<opus_int32>(std::min<size_t>(opusConfig.packetlossperc, 100))));
+        opus_encoder_ctl(encoder, OPUS_SET_INBAND_FEC(opusConfig.useinbandfec ? 1 : 0));
+        opus_encoder_ctl(encoder, OPUS_SET_DTX(opusConfig.usedtx ? 1 : 0));
+        size_t frameSize = codecRate * opusConfig.frameDuration / 1000000;
+        return adoptRef(*new OpusAudioEncoderHaiku(encoder, config, frameSize, WTF::move(descriptionCallback), WTF::move(outputCallback)));
+    }
+
+    ~OpusAudioEncoderHaiku()
+    {
+        opus_encoder_destroy(m_encoder);
+    }
+
+private:
+    OpusAudioEncoderHaiku(OpusEncoder* encoder, const AudioEncoder::Config& config, size_t frameSize, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+        : m_encoder(encoder)
+        , m_config(config)
+        , m_frameSize(frameSize)
+        , m_codecRate(opusCodecRate(config.sampleRate))
+        , m_descriptionCallback(WTF::move(descriptionCallback))
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs Opus encoder"_s))
+    {
+    }
+
+    Ref<EncodePromise> encode(RawFrame&& frame) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, frame = WTF::move(frame)] mutable {
+            return protectedThis->encodeOnQueue(WTF::move(frame));
+        });
+    }
+
+    Ref<EncodePromise> encodeOnQueue(RawFrame&& frame)
+    {
+        if (m_isClosed)
+            return EncodePromise::createAndReject("The encoder is closed"_s);
+        RefPtr audio = frame.frame;
+        if (!audio || audio->numberOfChannels() != m_config.numberOfChannels || audio->sampleRate() != m_config.sampleRate)
+            return EncodePromise::createAndReject("The audio does not match the encoder's channels and sample rate"_s);
+        size_t frames = audio->numberOfFrames();
+        size_t channels = m_config.numberOfChannels;
+        // Times count from the first sample still waiting.
+        if (m_pending.isEmpty() && m_input.isEmpty())
+            m_pendingTimestamp = frame.timestamp;
+        auto& destination = m_codecRate == m_config.sampleRate ? m_pending : m_input;
+        size_t start = destination.size();
+        destination.grow(start + frames * channels);
+        audio->copyTo(asMutableByteSpan(destination.mutableSpan().subspan(start)), AudioSampleFormat::F32, 0, 0, frames, frames * channels);
+        resampleInput(false);
+        while (m_pending.size() >= m_frameSize * channels) {
+            if (auto error = encodePacket())
+                return EncodePromise::createAndReject(WTF::move(*error));
+        }
+        return EncodePromise::createAndResolve();
+    }
+
+    // The input in whole 10 ms pieces (padded with silence when finishing),
+    // at the codec's rate.
+    void resampleInput(bool finishing)
+    {
+        if (m_codecRate == m_config.sampleRate)
+            return;
+        size_t channels = m_config.numberOfChannels;
+        size_t inputPiece = m_config.sampleRate / 100;
+        size_t outputPiece = m_codecRate / 100;
+        if (finishing && m_input.size() % (inputPiece * channels))
+            m_input.grow(m_input.size() + inputPiece * channels - m_input.size() % (inputPiece * channels));
+        if (!m_resampler)
+            m_resampler = std::make_unique<webrtc::PushResampler<float>>(inputPiece, outputPiece, channels);
+        size_t consumed = 0;
+        while (m_input.size() - consumed >= inputPiece * channels) {
+            size_t start = m_pending.size();
+            m_pending.grow(start + outputPiece * channels);
+            m_resampler->Resample(webrtc::InterleavedView<const float>(m_input.span().subspan(consumed).data(), inputPiece, channels),
+                webrtc::InterleavedView<float>(m_pending.mutableSpan().subspan(start).data(), outputPiece, channels));
+            consumed += inputPiece * channels;
+        }
+        if (consumed)
+            m_input.removeAt(0, consumed);
+    }
+
+    std::optional<String> encodePacket()
+    {
+        size_t channels = m_config.numberOfChannels;
+        Vector<uint8_t> packet(4000);
+        int length = opus_encode_float(m_encoder, m_pending.span().data(), m_frameSize, packet.mutableSpan().data(), packet.size());
+        if (length < 0)
+            return makeString("Opus encoding failed: "_s, String::fromLatin1(opus_strerror(length)));
+        packet.shrink(length);
+        if (!m_hasDescribed) {
+            m_hasDescribed = true;
+            opus_int32 preSkip = 0;
+            opus_encoder_ctl(m_encoder, OPUS_GET_LOOKAHEAD(&preSkip));
+            ActiveConfiguration configuration;
+            configuration.codec = "opus"_s;
+            configuration.sampleRate = m_config.sampleRate;
+            configuration.numberOfChannels = channels;
+            if (m_config.bitRate)
+                configuration.bitrate = m_config.bitRate;
+            configuration.description = opusHead(channels, preSkip, m_config.sampleRate);
+            m_descriptionCallback(WTF::move(configuration));
+        }
+        uint64_t duration = m_frameSize * 1000000 / m_codecRate;
+        m_outputCallback({ WTF::move(packet), true, m_pendingTimestamp, duration });
+        m_pending.removeAt(0, m_frameSize * channels);
+        m_pendingTimestamp += duration;
+        return std::nullopt;
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }] {
+            // The rest, padded with silence to a whole packet.
+            protectedThis->resampleInput(true);
+            auto& pending = protectedThis->m_pending;
+            while (pending.size() >= protectedThis->m_frameSize * protectedThis->m_config.numberOfChannels && !protectedThis->m_isClosed)
+                protectedThis->encodePacket();
+            if (!pending.isEmpty() && !protectedThis->m_isClosed) {
+                pending.grow(protectedThis->m_frameSize * protectedThis->m_config.numberOfChannels);
+                protectedThis->encodePacket();
+            }
+            pending.clear();
+            return GenericPromise::createAndResolve();
+        });
+    }
+
+    void reset() final
+    {
+        m_queue->dispatch([protectedThis = Ref { *this }] {
+            protectedThis->m_pending.clear();
+            protectedThis->m_input.clear();
+            protectedThis->m_resampler = nullptr;
+            opus_encoder_ctl(protectedThis->m_encoder, OPUS_RESET_STATE);
+        });
+    }
+
+    void close() final { m_isClosed = true; }
+
+    OpusEncoder* const m_encoder;
+    const AudioEncoder::Config m_config;
+    const size_t m_frameSize;
+    // libopus's rate: the configured one, or 48 kHz with the input resampled.
+    const unsigned m_codecRate;
+    DescriptionCallback m_descriptionCallback;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    Vector<float> m_pending;
+    Vector<float> m_input;
+    std::unique_ptr<webrtc::PushResampler<float>> m_resampler;
+    int64_t m_pendingTimestamp { 0 };
+    bool m_hasDescribed { false };
+    std::atomic<bool> m_isClosed { false };
+};
