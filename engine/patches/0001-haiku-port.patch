+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(ValueEvent);
+ValueEvent::ValueEvent(JSC::JSGlobalObject& global, const AtomString& type, Init&& init, IsTrusted trusted)
+    : Event(EventInterfaceType::ValueEvent, type, WTF::move(init), trusted), m_value(global, init.value) { }
+ValueEvent::ValueEvent(bool value)
+    : Event(EventInterfaceType::ValueEvent, eventNames().availabilitychangedEvent, CanBubble::No, IsCancelable::No, IsComposed::No), m_nativeValue(value) { }
+Ref<ValueEvent> ValueEvent::create(JSC::JSGlobalObject& global, const AtomString& type, Init&& init, IsTrusted trusted)
+{ return adoptRef(*new ValueEvent(global, type, WTF::move(init), trusted)); }
+Ref<ValueEvent> ValueEvent::createAvailability(bool value) { return adoptRef(*new ValueEvent(value)); }
+JSC::JSValue JSValueEvent::value(JSC::JSGlobalObject& global) const
+{
+    if (auto value = wrapped().nativeValue()) return JSC::jsBoolean(*value);
+    auto scope = DECLARE_THROW_SCOPE(global.vm());
+    return cachedPropertyValue(scope, global, *this, wrapped().cachedValue(), [this](JSC::ThrowScope&) { return wrapped().value().getValue(JSC::jsNull()); });
+}
+template<typename Visitor> void JSValueEvent::visitAdditionalChildrenInGCThread(Visitor& visitor)
+{
+    wrapped().value().visitInGCThread(visitor);
+    wrapped().cachedValue().visitInGCThread(visitor);
+}
+DEFINE_VISIT_ADDITIONAL_CHILDREN_IN_GC_THREAD(JSValueEvent);
+}
+#endif
