@@ -0,0 +1,37 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "DashManifestHaiku.h"
+#include "PlatformMediaResourceLoader.h"
+#include "SecurityOriginData.h"
+#include <wtf/Function.h>
+#include <wtf/HashMap.h>
+#include <wtf/HashSet.h>
+#include <wtf/RefCounted.h>
+#include <wtf/WeakPtr.h>
+
+namespace WebCore {
+class SecurityOrigin;
+// Uses the media element's loader, retaining WebCore's redirect, credential,
+// CSP and CORS rules. Each result is delivered asynchronously on the main loop.
+class DashResourceLoaderHaiku final : public RefCounted<DashResourceLoaderHaiku>, public CanMakeWeakPtr<DashResourceLoaderHaiku> {
+public:
+    using Completion = Function<void(uint64_t, bool, std::vector<uint8_t>&&, std::string&&, double)>;
+    static Ref<DashResourceLoaderHaiku> create(Ref<PlatformMediaResourceLoader>&& loader, Completion&& completion)
+    { return adoptRef(*new DashResourceLoaderHaiku(WTF::move(loader), WTF::move(completion))); }
+    ~DashResourceLoaderHaiku();
