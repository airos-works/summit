+#if ENABLE(WEBUSB)
+void WebView::usbRequest(uint64_t frame, const String& origin, const String& arguments, Vector<uint8_t>&& bytes,
+    CompletionHandler<void(String&&, Vector<uint8_t>&&)>&& completion)
+{
+    if (!m_page || m_state->closed || !m_state->context) {
+        completion("{\"error\":\"AbortError\"}"_s, { });
+        return;
+    }
+    auto parsed = JSON::Value::parseJSON(arguments);
+    auto args = parsed ? parsed->asObject() : nullptr;
+    auto document = args ? args->getString("document"_s) : String { };
+    if (document.isEmpty() || document.length() > 64) {
+        completion("{\"error\":\"TypeError\"}"_s, { });
+        return;
+    }
+    auto page = m_page->identifier().toUInt64();
+    auto generation = m_state->usbGeneration;
+    auto owner = makeString(page, '/', frame, '/', document);
+    m_state->context->usb()->request(page, owner, origin, nativeView(), arguments, WTF::move(bytes),
+        [state = std::weak_ptr { m_state }, generation] {
+            auto current = state.lock();
+            return current && !current->closed && current->usbGeneration == generation;
+        }, WTF::move(completion));
+}
+#endif
