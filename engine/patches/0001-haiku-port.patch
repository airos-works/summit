+{
+}
+
+void BWebWindow::SetResizable(bool flag, BWebView* /*view*/)
+{
+    if (flag)
+        SetFlags(Flags() & ~B_NOT_RESIZABLE);
+    else
+        SetFlags(Flags() | B_NOT_RESIZABLE);
+}
+
+void BWebWindow::StatusChanged(const BString& /*statusText*/, BWebView* /*view*/)
+{
+}
