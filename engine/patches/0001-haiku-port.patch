+    void get(Ref<WebExtensionCallbackHandler>&&);
+
+private:
+    void send(const String& method, RefPtr<JSON::Value> properties, ASCIILiteral textKey, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+};
+
+} // namespace WebKit
+
+SPECIALIZE_TYPE_TRAITS_WEB_EXTENSION(WebExtensionAPISearch, search);
