+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebDataListSuggestionsDropdownHaiku.h"
+#include "NativeDataListSuggestionsHaiku.h"
