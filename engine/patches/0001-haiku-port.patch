+// chrome.tabGroups. Summit has no tab groups, so it answers as Chrome does
+// for a window without any: no groups, and every tab's groupId is
+// TAB_GROUP_ID_NONE. Extensions that look for the namespace (Sidebery, Tree
+// Style Tab) start instead of failing.
+class WebExtensionAPITabGroups : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPITabGroups, tabGroups, tabGroups);
+
+public:
