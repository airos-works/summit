+
+// WebPage::updatePreferences() calls this after it has applied the store sent
+// by the UI process, and it does so again for every later preference change.
+// The Haiku UI process always sends acceleratedCompositingEnabled = false
+// (UIProcess/haiku/WebView.cpp), because it cannot know whether this process
+// has a working GPU. Only this process can, so the decision is applied here,
+// every time, or the next unrelated preference change would silently undo it.
+void DrawingAreaHaiku::updatePreferences(const WebPreferencesStore&)
+{
+    applyGLCompositingSettings();
+}
+
+void DrawingAreaHaiku::applyGLCompositingSettings()
+{
+    if (!m_layerTreeHost && LayerTreeHostHaiku::isAvailable()) {
+        m_layerTreeHost = LayerTreeHostHaiku::create(m_webPage.get());
+        if (!m_layerTreeHost)
+            LayerTreeHostHaiku::disableForProcess("the compositor could not be created");
+    } else if (m_layerTreeHost && !LayerTreeHostHaiku::isAvailable())
+        m_layerTreeHost = nullptr; // Another page hit a GL failure.
+
+    // Compositing is forced, not merely allowed, so that every page of this
+    // process takes the same path instead of switching between software and GL
+    // frames as composited layers come and go.
+    const bool useGL = !!m_layerTreeHost;
+    Settings& settings = m_webPage->corePage()->settings();
+    settings.setAcceleratedCompositingEnabled(useGL);
+    settings.setForceCompositingMode(useGL);
+}
+
+void DrawingAreaHaiku::exitGLCompositing(const char* reason)
+{
+    LayerTreeHostHaiku::disableForProcess(reason);
+    // Turning the settings off makes the next rendering update tear the layer
+    // tree down, after which the page paints completely in software again.
+    applyGLCompositingSettings();
+    ASSERT(!m_layerTreeHost);
+}
+#endif // USE(TEXTURE_MAPPER)
+
+void DrawingAreaHaiku::updateGeometryHaiku(uint64_t geometryIdentifier, const IntSize& size, float scale, CompletionHandler<void()>&& completionHandler)
+{
+    if ((!size.isEmpty() && !bitmapFrameSizeHaiku(size, scale)) || !std::isfinite(scale) || scale <= 0 || scale > 8) {
+        completionHandler();
+        return;
+    }
+    m_geometryIdentifier = geometryIdentifier;
+    Ref page = m_webPage.get();
+    page->setDeviceScaleFactor(scale);
+    page->setSize(size);
+#if USE(TEXTURE_MAPPER)
+    if (m_layerTreeHost)
+        m_layerTreeHost->sizeDidChange();
+#endif
+    setNeedsDisplay();
+    completionHandler();
+}
+
+void DrawingAreaHaiku::setDeviceScaleFactor(float scale, CompletionHandler<void()>&& completionHandler)
+{
+    updateGeometryHaiku(m_geometryIdentifier, m_webPage->size(), scale, WTF::move(completionHandler));
+}
+
+void DrawingAreaHaiku::didPresentBitmapHaiku(uint64_t frameIdentifier)
+{
+    if (m_pendingFrame != frameIdentifier)
+        return;
+    m_pendingFrame.reset();
+    if (m_statistics && m_statistics->sentAt) {
+        m_statistics->present += MonotonicTime::now() - m_statistics->sentAt;
+        ++m_statistics->presented;
+        m_statistics->sentAt = MonotonicTime();
+    }
+    scheduleDisplay();
+}
+
+void DrawingAreaHaiku::scheduleDisplay()
+{
+    if (!m_needsDisplay || m_pendingFrame || m_isFrozen || m_isDisplaying || (!m_isVisible && m_repaintCallbacks.isEmpty()) || m_displayTimer.isActive())
+        return;
+    // A frame is due one display period after the previous frame *started*. Waiting
+    // a fixed period after the UI process acknowledged the last frame instead added
+    // painting and presentation to every interval, which held a page that paints in
+    // 10 ms to about 30 frames per second however much headroom the machine had.
+    // SUMMIT_FRAME_PACING=ack restores that older behaviour for comparisons.
+    static const bool pacesFromAcknowledgement = [] {
+        const char* value = getenv("SUMMIT_FRAME_PACING");
+        return value && !strcmp(value, "ack");
+    }();
+    auto period = displayPeriodHaiku();
+    if (pacesFromAcknowledgement) {
+        m_displayTimer.startOneShot(period);
+        return;
+    }
+    auto elapsed = MonotonicTime::now() - m_lastFrameStart;
+    m_displayTimer.startOneShot(elapsed >= period ? 0_s : period - elapsed);
+}
+
+void DrawingAreaHaiku::recordFrameStatistics(bool painted, bool unchanged, bool dropped, MonotonicTime frameStart,
+    MonotonicTime afterUpdate, MonotonicTime afterDraw, MonotonicTime afterPaint, uint64_t dirtyPixels)
+{
+    auto& statistics = *m_statistics;
+    ++statistics.frames;
+    statistics.unchanged += unchanged;
+    statistics.dropped += dropped;
+    statistics.update += afterUpdate - frameStart;
+    if (painted) {
+        // "paint" is this process walking the page and sending drawing commands;
+        // "flush" is waiting for app_server to finish carrying them out.
+        statistics.paint += afterDraw - afterUpdate;
+        statistics.flush += afterPaint - afterDraw;
+        statistics.dirtyPixels += dirtyPixels;
+    }
+    if (statistics.previousStart) {
+        auto interval = frameStart - statistics.previousStart;
+        statistics.interval += interval;
+        statistics.longestInterval = std::max(statistics.longestInterval, interval);
+    }
+    statistics.longestFrame = std::max(statistics.longestFrame, afterPaint - frameStart);
+    statistics.previousStart = frameStart;
+
+    auto& painting = WebCore::paintStatisticsHaiku();
+    statistics.glyphRuns += painting.glyphRuns;
+    statistics.glyphs += painting.glyphs;
+    statistics.images += painting.images;
+    statistics.fills += painting.fills;
+    statistics.strokes += painting.strokes;
+    statistics.clips += painting.clips;
+    statistics.stateChanges += painting.stateChanges;
+    statistics.roundTrips += painting.roundTrips;
+    statistics.clipQueries += painting.clipQueries;
+    statistics.roundTripTime += painting.roundTripTime;
+    statistics.glyphTime += painting.glyphTime;
+    statistics.imageTime += painting.imageTime;
+    statistics.stateTime += painting.stateTime;
+    statistics.fillTime += painting.fillTime;
+    statistics.clipTime += painting.clipTime;
+    statistics.saveTime += painting.saveTime;
+    statistics.primitiveTime += painting.primitiveTime;
+    painting.clear();
+
+    auto elapsed = MonotonicTime::now() - statistics.periodStart;
+    if (elapsed < statistics.period)
+        return;
+    auto per = [&](Seconds total, unsigned count) { return count ? total.milliseconds() / count : 0.0; };
+#if USE(TEXTURE_MAPPER)
+    const char* path = m_layerTreeHost ? " [gl]" : "";
+#else
+    const char* path = "";
+#endif
+    WTFLogAlways("Summit frames: %.1f/s over %.1f s (painted=%u unchanged=%u dropped=%u) "
+        "update=%.2f ms paint=%.2f ms flush=%.2f ms present=%.2f ms interval=%.2f ms (max %.2f) "
+        "longest frame=%.2f ms dirty=%.2f Mpx/frame%s",
+        statistics.frames / elapsed.seconds(), elapsed.seconds(),
+        statistics.frames - statistics.unchanged - statistics.dropped, statistics.unchanged, statistics.dropped,
+        per(statistics.update, statistics.frames),
+        per(statistics.paint, statistics.presented ? statistics.presented : statistics.frames),
+        per(statistics.flush, statistics.presented ? statistics.presented : statistics.frames),
+        per(statistics.present, statistics.presented),
+        per(statistics.interval, statistics.frames > 1 ? statistics.frames - 1 : 1),
+        statistics.longestInterval.milliseconds(), statistics.longestFrame.milliseconds(),
+        statistics.presented ? statistics.dirtyPixels / (1e6 * statistics.presented) : 0.0,
+        path);
+    // Second line: what those frames asked the port to draw, per frame. Only
+    // GraphicsContextHaiku keeps this tally, so with Skia there is nothing to
+    // report rather than a line of zeroes.
+    auto perFrame = [&](double total) { return statistics.frames ? total / statistics.frames : 0.0; };
+#if USE(HAIKU_GRAPHICS)
+    WTFLogAlways("Summit painting: per frame drawing calls %.2f ms of which %.0f text runs (%.0f glyphs) %.2f ms, "
+        "%.0f images %.2f ms; %.0f fills %.2f ms, %.0f strokes, %.0f clips %.2f ms, "
+        "%.0f state changes %.2f ms (%.2f ms in save/restore), "
+        "%.0f app_server round trips %.2f ms (%.0f for the clip)",
+        perFrame(statistics.primitiveTime.milliseconds()),
+        perFrame(statistics.glyphRuns), perFrame(statistics.glyphs), perFrame(statistics.glyphTime.milliseconds()),
+        perFrame(statistics.images), perFrame(statistics.imageTime.milliseconds()),
+        perFrame(statistics.fills), perFrame(statistics.fillTime.milliseconds()),
+        perFrame(statistics.strokes),
+        perFrame(statistics.clips), perFrame(statistics.clipTime.milliseconds()),
+        perFrame(statistics.stateChanges), perFrame(statistics.stateTime.milliseconds()),
+        perFrame(statistics.saveTime.milliseconds()), perFrame(statistics.roundTrips),
+        perFrame(statistics.roundTripTime.milliseconds()), perFrame(statistics.clipQueries));
+#else
+    UNUSED_PARAM(perFrame);
+#endif
+    auto period = statistics.period;
+    auto previousStart = statistics.previousStart;
+    statistics = FrameStatistics();
+    statistics.period = period;
+    statistics.previousStart = previousStart;
+    statistics.periodStart = MonotonicTime::now();
+}
+
+void DrawingAreaHaiku::completeRepaintCallbacks()
+{
+    auto callbacks = std::exchange(m_repaintCallbacks, { });
+    for (auto& callback : callbacks)
+        callback();
+}
+
+GraphicsContext* DrawingAreaHaiku::frameContext(ShareableBitmap& bitmap, float scale)
+{
+    if (!m_frameContext) {
+        m_frameContext = bitmap.createGraphicsContext();
+        if (m_frameContext)
+            m_frameContext->applyDeviceScaleFactor(scale);
+    }
+    return m_frameContext.get();
+}
+
+void DrawingAreaHaiku::display()
+{
+    if (m_isDisplaying || m_pendingFrame)
+        return;
+    m_displayTimer.stop();
+    if (m_isFrozen || (!m_isVisible && m_repaintCallbacks.isEmpty())) {
+        completeRepaintCallbacks();
+        return;
+    }
+    Ref protectedThis { *this };
+    auto frameStart = MonotonicTime::now();
+    m_lastFrameStart = frameStart;
+    uint64_t dirtyPixels = 0;
+    {
+        SetForScope displaying(m_isDisplaying, true);
+        Ref page = m_webPage.get();
+        // Clear before layout, which can request another rendering update.
+        m_needsDisplay = false;
+        if (page->isClosed()) {
+            completeRepaintCallbacks();
+            return;
+        }
+        page->updateRendering();
+        page->finalizeRenderingUpdate({ });
+        page->flushPendingEditorStateUpdate();
+        auto afterUpdate = MonotonicTime::now();
+        auto afterDraw = afterUpdate;
+
+        float scale = page->corePage()->deviceScaleFactor();
+        auto bitmapSize = bitmapFrameSizeHaiku(page->size(), scale);
+        if (!bitmapSize) {
+            m_frameContext = nullptr;
+            m_frameBitmap = nullptr;
+        } else if (!m_frameBitmap || m_frameBitmap->size() != *bitmapSize || m_frameBitmapScale != scale) {
+            m_frameContext = nullptr;
+            m_frameBitmap = ShareableBitmap::create({ *bitmapSize });
+            m_frameBitmapScale = scale;
+            m_needsFullRepaint = true;
+        }
+        RefPtr bitmap = m_frameBitmap;
+
+        enum class FrameResult : uint8_t { NotPainted, Painted, Dropped, Unchanged };
+        auto result = FrameResult::NotPainted;
+#if USE(TEXTURE_MAPPER)
+        if (bitmap && m_layerTreeHost) {
+            if (m_layerTreeHost->renderFrame(*bitmap)) {
+                result = FrameResult::Painted;
+                afterDraw = MonotonicTime::now();
+                dirtyPixels = static_cast<uint64_t>(page->size().width()) * page->size().height();
+                // A later software frame cannot build on pixels composited by GL.
+                m_needsFullRepaint = true;
+                m_dirtyRegion = { };
+                m_scrollRect = { };
+                m_scrollOffset = { };
+                // Animations run in the compositor and invalidate nothing.
+                if (m_layerTreeHost->hasRunningAnimations())
+                    m_needsDisplay = true;
+            } else {
+                // The layer tree still exists, so painting this frame in
+                // software would leave out all composited content. Drop the
+                // frame instead. Turning the settings off makes the next
+                // rendering update tear the layers down, and the frame after
+                // that is complete. Repaint callbacks stay queued for it.
+                exitGLCompositing("rendering a frame failed");
+                m_needsDisplay = true;
+                result = FrameResult::Dropped;
+            }
+        }
+#endif
+        if (bitmap && result == FrameResult::NotPainted) {
+            // Invalidations made by the rendering update above belong to this frame.
+            // Diagnostic escape hatch: SUMMIT_FULL_REPAINT=1 repaints the whole page every frame.
+            static const bool alwaysRepaintEverything = [] {
+                const char* value = getenv("SUMMIT_FULL_REPAINT");
+                return value && !strcmp(value, "1");
+            }();
+            bool fullRepaint = std::exchange(m_needsFullRepaint, false) || alwaysRepaintEverything;
+            auto dirtyRegion = std::exchange(m_dirtyRegion, { });
+            auto scrollRect = std::exchange(m_scrollRect, { });
+            auto scrollOffset = std::exchange(m_scrollOffset, { });
+            // Move what the scroll kept on screen; the strip it uncovered is
+            // already in the dirty region. If the pixels cannot be moved, the
+            // whole scrolled area is painted instead.
+            if (!fullRepaint && !scrollRect.isEmpty() && !scrollOffset.isZero()
+                && !copyScrolledPixels(*bitmap, scale, scrollRect, scrollOffset))
+                dirtyRegion.unite(scrollRect);
+            Vector<IntRect, 8> rects;
+            if (fullRepaint)
+                rects.append(page->bounds());
+            else if (!dirtyRegion.isEmpty()) {
+                // Many small rectangles cost more app_server traffic than their bounds.
+                auto regionRects = dirtyRegion.rects();
+                if (regionRects.size() > 8)
+                    rects.append(dirtyRegion.bounds());
+                else
+                    rects.appendVector(regionRects);
+            }
+            if (rects.isEmpty())
+                result = FrameResult::Unchanged;
+            else if (auto* context = frameContext(*bitmap, scale)) {
+#if USE(HAIKU_GRAPHICS)
+                // BView flushes its link to app_server on every PopState(), and
+                // WebKit saves and restores state hundreds of times a frame. A
+                // view transaction holds those flushes back until the frame is
+                // painted, so the commands travel in whole buffers instead of
+                // one port write each. SUMMIT_BATCH_DRAWING=0 turns it off.
+                // Skia issues no commands to app_server, so it needs none of it.
+                static const bool batchedDrawing = [] {
+                    const char* value = getenv("SUMMIT_BATCH_DRAWING");
+                    return !value || strcmp(value, "0");
+                }();
+                BWindow* batchWindow = batchedDrawing ? context->platformContext()->Window() : nullptr;
+                if (batchWindow)
+                    batchWindow->BeginViewTransaction();
+#endif
+                // No explicit color means the default opaque base background. Only a page that
+                // was given a translucent one can show the previous frame through its repaint.
+                bool clearsFirst = page->backgroundColor() && !page->backgroundColor()->isOpaque();
+                // SUMMIT_DEBUG_DAMAGE=1 paints the damage instead of the page,
+                // so a screenshot shows exactly which pixels a frame claimed.
+                static const bool showDamage = [] {
+                    const char* value = getenv("SUMMIT_DEBUG_DAMAGE");
+                    return value && !strcmp(value, "1");
+                }();
+                for (auto& rect : rects) {
+                    GraphicsContextStateSaver stateSaver(*context);
+                    context->clip(rect);
+                    if (clearsFirst)
+                        context->clearRect(rect);
+                    if (showDamage)
+                        context->fillRect(rect, WebCore::Color::magenta);
+                    else
+                        page->drawRect(*context, rect);
+                    dirtyPixels += static_cast<uint64_t>(rect.width()) * rect.height();
+                }
+                afterDraw = MonotonicTime::now();
+#if USE(HAIKU_GRAPHICS)
+                // Finish app_server writes before publishing the shared pixels.
+                if (batchWindow)
+                    batchWindow->EndViewTransaction();
+                context->platformContext()->Sync();
+#endif
+                result = FrameResult::Painted;
+            } else
+                m_needsFullRepaint = true;
+        }
+        auto afterPaint = MonotonicTime::now();
+        if (result == FrameResult::Painted) {
+            if (auto handle = bitmap->createReadOnlyHandle()) {
+                auto frameIdentifier = ++m_frameIdentifier;
+                if (send(Messages::DrawingAreaProxy::UpdateBitmapHaiku(m_geometryIdentifier, frameIdentifier, page->size(), scale, WTF::move(*handle)))) {
+                    m_pendingFrame = frameIdentifier;
+                    if (m_statistics)
+                        m_statistics->sentAt = afterPaint;
+                }
+            }
+        }
+        if (m_statistics) {
+            recordFrameStatistics(result == FrameResult::Painted, result == FrameResult::Unchanged,
+                result == FrameResult::Dropped, frameStart, afterUpdate, afterDraw, afterPaint, dirtyPixels);
+        }
+        page->didUpdateRendering();
+        if (result != FrameResult::Dropped)
+            completeRepaintCallbacks();
+    }
+    scheduleDisplay();
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/WebProcess/WebPage/haiku/DrawingAreaHaiku.h b/Source/WebKit/WebProcess/WebPage/haiku/DrawingAreaHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..3fbdb891367700b88586c40ced6315b49818da85
--- /dev/null
+++ b/Source/WebKit/WebProcess/WebPage/haiku/DrawingAreaHaiku.h
@@ -0,0 +1,143 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+
+#include "DrawingArea.h"
+#include <WebCore/GraphicsContext.h>
+#include <WebCore/Region.h>
+#include <WebCore/ShareableBitmap.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/RunLoop.h>
+#include <wtf/Seconds.h>
+
+namespace WebKit {
+
+#if USE(TEXTURE_MAPPER)
+class LayerTreeHostHaiku;
+#endif
+
+// Paints complete frames into shared bitmaps for DrawingAreaProxyHaiku.
+//
+// A frame is painted in software, or, with USE(TEXTURE_MAPPER) and when
+// LayerTreeHostHaiku::isAvailable(), composited with OpenGL ES 2 and read back
+// (docs/gpu-compositing.md in the Summit tree). Frame pacing, the bitmap
+// format and the messages are the same in both cases, so the UI process is not
+// involved in the choice, and a GL failure falls back to software by itself.
+class DrawingAreaHaiku final : public DrawingArea {
+    WTF_MAKE_TZONE_ALLOCATED(DrawingAreaHaiku);
+public:
+    static Ref<DrawingAreaHaiku> create(WebPage&, const WebPageCreationParameters&);
+    ~DrawingAreaHaiku() override;
+
+private:
+    DrawingAreaHaiku(WebPage&, const WebPageCreationParameters&);
+    void setNeedsDisplay() override;
+    void setNeedsDisplayInRect(const WebCore::IntRect&) override;
+    void scroll(const WebCore::IntRect&, const WebCore::IntSize&) override;
+    void triggerRenderingUpdate() override;
+    bool scheduleRenderingUpdate() override;
+    void updateRenderingWithForcedRepaint() override;
+    void updateRenderingWithForcedRepaintAsync(WebPage&, CompletionHandler<void()>&&) override;
+    void setRootCompositingLayer(WebCore::Frame&, WebCore::GraphicsLayer*) override;
+    void setLayerTreeStateIsFrozen(bool) override;
+    bool layerTreeStateIsFrozen() const override { return m_isFrozen; }
+    void activityStateDidChange(OptionSet<WebCore::ActivityState>, ActivityStateChangeID, CompletionHandler<void()>&&) override;
+    void updateGeometryHaiku(uint64_t, const WebCore::IntSize&, float, CompletionHandler<void()>&&) override;
+    void didPresentBitmapHaiku(uint64_t) override;
+    void setDeviceScaleFactor(float, CompletionHandler<void()>&&) override;
+#if USE(TEXTURE_MAPPER)
+    // Pure virtual in DrawingArea whenever USE(TEXTURE_MAPPER) is set.
+    void updateGeometry(const WebCore::IntSize&, CompletionHandler<void()>&&) override;
+    // Always false: the UI process keeps receiving bitmaps and is never told.
+    bool enterAcceleratedCompositingModeIfNeeded() override { return false; }
+    void updatePreferences(const WebPreferencesStore&) override;
+    void attachViewOverlayGraphicsLayer(WebCore::FrameIdentifier, WebCore::GraphicsLayer*) override;
+    void applyGLCompositingSettings();
+    void exitGLCompositing(const char* reason);
+#endif
+    // Requests a frame without invalidating any content.
+    void scheduleFrame();
+    void scheduleDisplay();
+    void display();
+    void recordFrameStatistics(bool painted, bool unchanged, bool dropped, MonotonicTime frameStart,
+        MonotonicTime afterUpdate, MonotonicTime afterDraw, MonotonicTime afterPaint, uint64_t dirtyPixels);
+    // Moves the pixels a scroll kept on screen inside the frame bitmap, so only
+    // the strip that came into view has to be painted. False means the frame
+    // has to be repainted the ordinary way.
+    bool copyScrolledPixels(WebCore::ShareableBitmap&, float scale, const WebCore::IntRect&, const WebCore::IntSize&);
+    WebCore::GraphicsContext* frameContext(WebCore::ShareableBitmap&, float scale);
+    void completeRepaintCallbacks();
+
+#if USE(TEXTURE_MAPPER)
+    std::unique_ptr<LayerTreeHostHaiku> m_layerTreeHost;
+#endif
+    RunLoop::Timer m_displayTimer;
+    Vector<CompletionHandler<void()>> m_repaintCallbacks;
+    uint64_t m_geometryIdentifier { 0 };
+    uint64_t m_frameIdentifier { 0 };
+    std::optional<uint64_t> m_pendingFrame;
+    // The UI process copies a frame before acknowledging it, and only one frame is in
+    // flight, so the same shared bitmap is repainted where content was invalidated.
+    RefPtr<WebCore::ShareableBitmap> m_frameBitmap;
+    // Creating a drawing context sets up an app_server offscreen window and thread,
+    // about ten times the cost of a typical frame, so it lives as long as the bitmap.
+    std::unique_ptr<WebCore::GraphicsContext> m_frameContext;
+    float m_frameBitmapScale { 0 };
+    WebCore::Region m_dirtyRegion;
+    // The area the page scrolled and by how much, accumulated since the last
+    // frame, in the same coordinates as the dirty region.
+    WebCore::IntRect m_scrollRect;
+    WebCore::IntSize m_scrollOffset;
+
+    // SUMMIT_FRAME_STATS=<seconds> prints one summary line per period to stderr,
+    // which is how frame pacing is measured on a page that cannot be instrumented
+    // from JavaScript (docs/performance.md). Off unless the variable is set.
+    struct FrameStatistics {
+        Seconds period;
+        MonotonicTime periodStart;
+        MonotonicTime previousStart;
+        MonotonicTime sentAt;
+        Seconds update;
+        Seconds paint;
+        Seconds flush;
+        Seconds present;
+        Seconds interval;
+        Seconds longestInterval;
+        Seconds longestFrame;
+        unsigned frames { 0 };
+        unsigned unchanged { 0 };
+        unsigned dropped { 0 };
+        unsigned presented { 0 };
+        uint64_t dirtyPixels { 0 };
+        // What the port was asked to draw, from WebCore::paintStatisticsHaiku().
+        unsigned glyphRuns { 0 };
+        unsigned glyphs { 0 };
+        unsigned images { 0 };
+        unsigned fills { 0 };
+        unsigned strokes { 0 };
+        unsigned clips { 0 };
+        unsigned stateChanges { 0 };
+        unsigned roundTrips { 0 };
+        unsigned clipQueries { 0 };
+        Seconds roundTripTime;
+        Seconds glyphTime;
+        Seconds imageTime;
+        Seconds stateTime;
+        Seconds fillTime;
+        Seconds clipTime;
+        Seconds saveTime;
+        Seconds primitiveTime;
+    };
+    std::unique_ptr<FrameStatistics> m_statistics;
+    // Frame pacing: the next frame is due one display period after the previous
+    // one started, not a fixed delay after the UI process acknowledged the last.
+    MonotonicTime m_lastFrameStart;
+    bool m_needsFullRepaint { true };
+    bool m_needsDisplay { true };
+    bool m_isVisible { false };
+    bool m_isFrozen { false };
+    bool m_isDisplaying { false };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/WebProcess/WebPage/haiku/LayerTreeHostHaiku.cpp b/Source/WebKit/WebProcess/WebPage/haiku/LayerTreeHostHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a8c2c564757c95bf45dd4d2a6b84c3e487ddabea
--- /dev/null
+++ b/Source/WebKit/WebProcess/WebPage/haiku/LayerTreeHostHaiku.cpp
@@ -0,0 +1,434 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+// The layer bookkeeping follows LayerTreeHostTextureMapper.cpp and the
+// offscreen render-and-read-back step follows WCScene.cpp (both upstream).
+
+#include "config.h"
+#include "LayerTreeHostHaiku.h"
+
+#if USE(TEXTURE_MAPPER)
+
+#include "WebPage.h"
+#if USE(LIBEPOXY)
+#include <epoxy/gl.h>
+#else
+#include <GLES2/gl2.h>
+#endif
+#include <GLES2/gl2ext.h>
+#include <WebCore/BitmapTexture.h>
+#include <WebCore/GLContext.h>
+#include <WebCore/GraphicsContext.h>
+#include <WebCore/GraphicsLayerTextureMapper.h>
+#include <WebCore/DocumentView.h>
+#include <WebCore/LocalFrameInlines.h>
+#include <WebCore/LocalFrameView.h>
+#include <WebCore/Page.h>
+#include <WebCore/PlatformDisplay.h>
+#include <WebCore/PlatformDisplayHaiku.h>
+#include <WebCore/ShareableBitmap.h>
+#include <WebCore/TextureMapper.h>
+#include <WebCore/TextureMapperLayer.h>
+#include <array>
+#include <cstdlib>
+#include <wtf/MainThread.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/text/WTFString.h>
+
+#ifndef GL_BGRA_EXT
+#define GL_BGRA_EXT 0x80E1
+#endif
+
+namespace WebKit {
+using namespace WebCore;
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(LayerTreeHostHaiku);
+
+namespace {
+
+enum class Availability : uint8_t { Unknown, Available, Unavailable };
+
+Availability s_availability { Availability::Unknown };
+bool s_supportsBGRAReadback { false };
+
+// The only GL context of the process. It is made current once and stays
+// current on the main thread, for two reasons: GraphicsLayers release their
+// textures whenever they die, and BitmapTexturePool's release timer falls back
+// to PlatformDisplay::sharedDisplay().sharingGLContext() when no context is
+// current, which would create a second, sharing context.
+std::unique_ptr<GLContext>& processContext()
+{
+    static NeverDestroyed<std::unique_ptr<GLContext>> context;
+    return context;
+}
+
+bool environmentFlagIsSet(const char* name)
+{
+    const char* value = getenv(name);
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN // Haiku port
+    return value && value[0] && !(value[0] == '0' && !value[1]);
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+}
+
+bool isSoftwareRenderer(const String& renderer)
+{
+    auto name = renderer.convertToASCIILowercase();
+    for (auto token : { "llvmpipe"_s, "softpipe"_s, "software"_s, "swrast"_s, "lavapipe"_s }) {
+        if (name.contains(token))
+            return true;
+    }
+    return false;
+}
+
+void drainGLErrors()
+{
+    // Bounded: a lost context may report errors indefinitely.
+    for (unsigned i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i) { }
+}
+
+// A renderer string alone does not show that the driver works. Clear a small
+// framebuffer object and read it back, which is what every frame depends on.
+bool framebufferReadbackWorks()
+{
+    constexpr GLsizei size = 4;
+    drainGLErrors();
+
+    GLuint texture = 0;
+    GLuint framebuffer = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, size, size, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glGenFramebuffers(1, &framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+
+    bool works = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (works) {
+        // Asymmetric, so that a red/blue swap is detected too.
+        std::array<uint8_t, 4> pixel { 0, 0, 0, 0 };
+        glViewport(0, 0, size, size);
+        glDisable(GL_SCISSOR_TEST);
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glReadPixels(1, 1, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel.data());
+        works = glGetError() == GL_NO_ERROR && pixel == std::array<uint8_t, 4> { 255, 0, 0, 255 };
+    }
+
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &framebuffer);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glDeleteTextures(1, &texture);
+    return works;
+}
+
+Availability probe()
+{
+    const bool forced = environmentFlagIsSet("SUMMIT_FORCE_GL_COMPOSITING");
+    if (environmentFlagIsSet("SUMMIT_DISABLE_GL_COMPOSITING")) {
+        WTFLogAlways("Summit GL compositing: disabled by SUMMIT_DISABLE_GL_COMPOSITING; rendering in software.");
+        return Availability::Unavailable;
+    }
+
+    // setSharedDisplay() may only happen once per process. Nothing else on
+    // Haiku installs a display, but do not crash if that ever changes.
+    if (PlatformDisplay::sharedDisplayIfExists()) {
+        WTFLogAlways("Summit GL compositing: a platform display already exists; rendering in software.");
+        return Availability::Unavailable;
+    }
+
+    auto display = PlatformDisplayHaiku::create();
+    if (!display) {
+        WTFLogAlways("Summit GL compositing: EGL did not initialize (%s); rendering in software.", GLContext::lastErrorString());
+        return Availability::Unavailable;
+    }
+
+    // No sharing context: see processContext(). On Haiku this tries a pbuffer
+    // surface first and a surfaceless context second.
+    auto context = GLContext::create(display->glDisplay(), GLContext::Target::Default);
+    if (!context || !context->makeContextCurrent()) {
+        WTFLogAlways("Summit GL compositing: no offscreen OpenGL ES 2 context (%s); rendering in software.", GLContext::lastErrorString());
+        context = nullptr; // Before the display that owns it.
+        return Availability::Unavailable;
+    }
+
+    auto glString = [](GLenum name) {
+        const auto* value = reinterpret_cast<const char*>(glGetString(name));
+        return value ? String::fromLatin1(value) : String();
+    };
+    const String renderer = glString(GL_RENDERER);
+    const String version = glString(GL_VERSION);
+
+    const char* rejection = nullptr;
+    if (renderer.isEmpty())
+        rejection = "the driver reports no renderer";
+    else if (isSoftwareRenderer(renderer) && !forced)
+        rejection = "software renderer (set SUMMIT_FORCE_GL_COMPOSITING=1 to use it)";
+    else if (!framebufferReadbackWorks())
+        rejection = "the framebuffer readback self-test failed";
+
+    if (rejection) {
+        WTFLogAlways("Summit GL compositing: %s [%s, %s]; rendering in software.", rejection, renderer.utf8().legacyCStringPointer(), version.utf8().legacyCStringPointer());
+        context = nullptr; // Before the display that owns it.
+        return Availability::Unavailable;
+    }
+
+    // Only GL_RGBA/GL_UNSIGNED_BYTE readback is guaranteed by OpenGL ES 2.
+    s_supportsBGRAReadback = GLContext::isExtensionSupported(reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS)), "GL_EXT_read_format_bgra");
+
+    WTFLogAlways("Summit GL compositing: enabled%s [%s, %s, %s readback].", forced ? " (forced)" : "", renderer.utf8().legacyCStringPointer(), version.utf8().legacyCStringPointer(), s_supportsBGRAReadback ? "BGRA" : "RGBA+swap");
+
+    // Installing the display keeps PlatformDisplay::sharedDisplay(), which
+    // asserts when there is none, safe for BitmapTexturePool.
+    PlatformDisplay::setSharedDisplay(WTF::move(display));
+    processContext() = WTF::move(context);
+    return Availability::Available;
+}
+
+} // namespace
+
+bool LayerTreeHostHaiku::isAvailable()
+{
+    ASSERT(isMainThread());
+    if (s_availability == Availability::Unknown)
+        s_availability = probe();
+    return s_availability == Availability::Available;
+}
+
+void LayerTreeHostHaiku::disableForProcess(const char* reason)
+{
+    ASSERT(isMainThread());
+    if (s_availability == Availability::Available)
+        WTFLogAlways("Summit GL compositing: %s; falling back to software rendering.", reason);
+    // The context and display stay alive: layers created so far still own
+    // textures, and they are released as those layers are torn down.
+    s_availability = Availability::Unavailable;
+}
+
+std::unique_ptr<LayerTreeHostHaiku> LayerTreeHostHaiku::create(WebPage& webPage)
+{
+    if (!isAvailable())
+        return nullptr;
+
+    auto host = std::unique_ptr<LayerTreeHostHaiku>(new LayerTreeHostHaiku(webPage));
+    if (!host->initialize())
+        return nullptr;
+    return host;
+}
+
+LayerTreeHostHaiku::LayerTreeHostHaiku(WebPage& webPage)
+    : m_webPage(webPage)
+{
+    m_rootLayer = GraphicsLayer::create(nullptr, *this);
+    m_rootLayer->setDrawsContent(true);
+    m_rootLayer->setContentsOpaque(true);
+    // Scale from the top-left corner, so that applyDeviceScaleFactor() needs
+    // no translation to compensate for a centered transform origin.
+    m_rootLayer->setAnchorPoint({ });
+    m_rootLayer->setSize(m_webPage.size());
+    m_rootLayer->setNeedsDisplay();
+#ifndef NDEBUG
+    m_rootLayer->setName(MAKE_STATIC_STRING_IMPL("Root layer"));
+#endif
+    applyDeviceScaleFactor();
+}
+
+LayerTreeHostHaiku::~LayerTreeHostHaiku()
+{
+    // Textures are released below and need the context.
+    if (auto& context = processContext())
+        context->makeContextCurrent();
+
+    m_rootLayer->removeAllChildren();
+    m_rootLayer = nullptr;
+    m_surface = nullptr;
+    m_textureMapper = nullptr;
+}
+
+bool LayerTreeHostHaiku::initialize()
+{
+    auto& context = processContext();
+    if (!context || !context->makeContextCurrent())
+        return false;
+
+    // Requires a current context.
+    m_textureMapper = TextureMapper::create();
+    return !!m_textureMapper;
+}
+
+void LayerTreeHostHaiku::updateRootLayerChildren()
+{
+    m_rootLayer->removeAllChildren();
+    if (m_overlayCompositingLayer)
+        m_rootLayer->addChild(*m_overlayCompositingLayer);
+    if (m_rootCompositingLayer)
+        m_rootLayer->addChild(*m_rootCompositingLayer);
+}
+
+void LayerTreeHostHaiku::setRootCompositingLayer(GraphicsLayer* graphicsLayer)
+{
+    if (m_rootCompositingLayer == graphicsLayer)
+        return;
+
+    m_rootCompositingLayer = graphicsLayer;
+    updateRootLayerChildren();
+}
+
+void LayerTreeHostHaiku::setViewOverlayRootLayer(GraphicsLayer* graphicsLayer)
+{
+    if (m_overlayCompositingLayer == graphicsLayer)
+        return;
+
+    m_overlayCompositingLayer = graphicsLayer;
+    updateRootLayerChildren();
+}
+
+void LayerTreeHostHaiku::setNonCompositedContentsNeedDisplay(const IntRect& rect)
+{
+    m_rootLayer->setNeedsDisplayInRect(rect);
+}
+
+void LayerTreeHostHaiku::setNonCompositedContentsNeedDisplay()
+{
+    m_rootLayer->setNeedsDisplay();
+}
+
+void LayerTreeHostHaiku::sizeDidChange()
+{
+    // The device scale factor can change without the size changing.
+    applyDeviceScaleFactor();
+
+    const auto& newSize = m_webPage.size();
+    if (m_rootLayer->size() == newSize)
+        return;
+
+    m_rootLayer->setSize(newSize);
+    m_rootLayer->setNeedsDisplay();
+}
+
+void LayerTreeHostHaiku::applyDeviceScaleFactor()
+{
+    // Layer geometry is in CSS pixels; backing stores and the target surface
+    // are in device pixels.
+    TransformationMatrix transform;
+    transform.scale(deviceScaleFactor());
+    m_rootLayer->setTransform(transform);
+}
+
+bool LayerTreeHostHaiku::renderFrame(ShareableBitmap& bitmap)
+{
+    ASSERT(isMainThread());
+
+    auto& context = processContext();
+    if (!isAvailable() || !context || !m_textureMapper || !context->makeContextCurrent())
+        return false;
+
+    const IntSize surfaceSize = bitmap.size();
+    if (surfaceSize.isEmpty())
+        return false;
+
+    const auto maxTextureSize = m_textureMapper->maxTextureSize();
+    if (surfaceSize.width() > maxTextureSize.width() || surfaceSize.height() > maxTextureSize.height())
+        return false;
+
+    if (!m_surface || m_surface->size() != surfaceSize)
+        m_surface = BitmapTexture::create(surfaceSize, { BitmapTexture::Flags::SupportsAlpha });
+
+    drainGLErrors();
+
+    // Page::finalizeRenderingUpdate() has flushed the document's layers. The
+    // root and overlay layers are outside of that tree.
+    m_rootLayer->flushCompositingStateForThisLayerOnly();
+    if (m_overlayCompositingLayer)
+        m_overlayCompositingLayer->flushCompositingState(FloatRect({ }, m_rootLayer->size()));
+
+    // Paints dirty tiles with the Haiku GraphicsContext and uploads them.
+    auto& rootLayer = downcast<GraphicsLayerTextureMapper>(*m_rootLayer);
+    rootLayer.updateBackingStoreIncludingSubLayers(*m_textureMapper);
+
+    m_hasRunningAnimations = rootLayer.layer().applyAnimationsRecursively(MonotonicTime::now());
+
+    // With a BitmapTexture as the surface TextureMapper always flips the Y
+    // axis (the FlipY argument only applies to the default framebuffer), so
+    // the first row that glReadPixels() returns is the top row of the page,
+    // which is also the first row of a BBitmap.
+    m_textureMapper->beginPainting(TextureMapper::FlipY::No, m_surface.get());
+
+    bool rendered = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (rendered) {
+        // Tile-based GPUs would otherwise reload the previous frame. It also
+        // keeps any area that the opaque root layer does not cover opaque.
+        glClearColor(1, 1, 1, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+
+        rootLayer.layer().paint(*m_textureMapper);
+
+        // Before endPainting(), which binds the previous framebuffer again.
+        rendered = readPixels(bitmap);
+    }
+
+    m_textureMapper->endPainting();
+    return rendered;
+}
+
+bool LayerTreeHostHaiku::readPixels(ShareableBitmap& bitmap)
+{
+    const size_t width = bitmap.size().width();
+    const size_t height = bitmap.size().height();
+    const size_t packedBytesPerRow = width * 4;
+    const size_t bitmapBytesPerRow = bitmap.bytesPerRow();
+    auto destination = bitmap.mutableSpan();
+    if (bitmapBytesPerRow < packedBytesPerRow || destination.size() < bitmapBytesPerRow * (height - 1) + packedBytesPerRow)
+        return false;
+
+    // glReadPixels() writes rows of exactly width * 4 bytes (the default
+    // GL_PACK_ALIGNMENT of 4 never pads them). Use a staging buffer only if
+    // the bitmap rows are padded.
+    const bool readsDirectly = bitmapBytesPerRow == packedBytesPerRow;
+    if (!readsDirectly) {
+        m_readbackBuffer.shrink(0);
+        if (!m_readbackBuffer.tryGrow(packedBytesPerRow * height))
+            return false;
+    }
+
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN // Haiku port
+    uint8_t* pixels = readsDirectly ? destination.data() : m_readbackBuffer.mutableSpan().data();
+
+    glReadPixels(0, 0, width, height, s_supportsBGRAReadback ? GL_BGRA_EXT : GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    if (glGetError() != GL_NO_ERROR)
+        return false;
+
+    if (!s_supportsBGRAReadback) {
+        for (size_t i = 0; i < width * height; ++i)
+            std::swap(pixels[i * 4], pixels[i * 4 + 2]);
+    }
+
+    if (!readsDirectly) {
+        for (size_t y = 0; y < height; ++y)
+            memcpy(destination.data() + y * bitmapBytesPerRow, pixels + y * packedBytesPerRow, packedBytesPerRow);
+    }
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+
+    return true;
+}
+
+void LayerTreeHostHaiku::paintContents(const GraphicsLayer&, GraphicsContext& context, const FloatRect& rectToPaint, OptionSet<GraphicsLayerPaintBehavior>)
+{
+    context.save();
+    context.clip(rectToPaint);
+    if (auto* localMainFrame = dynamicDowncast<LocalFrame>(m_webPage.corePage()->mainFrame())) {
+        if (auto* view = localMainFrame->view())
+            view->paint(context, enclosingIntRect(rectToPaint));
+    }
+    context.restore();
+}
+
+float LayerTreeHostHaiku::deviceScaleFactor() const
+{
+    return m_webPage.corePage()->deviceScaleFactor();
+}
+
+} // namespace WebKit
+
+#endif // USE(TEXTURE_MAPPER)
