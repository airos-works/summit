+void IconDatabase::PageURLRecord::setIconRecord(RefPtr<IconRecord>&& icon)
+{
+    if (m_iconRecord)
+        m_iconRecord->retainingPageURLs().remove(m_pageURL);
+
+    m_iconRecord = std::move(icon);
+
+    if (m_iconRecord)
+        m_iconRecord->retainingPageURLs().add(m_pageURL);
+}
