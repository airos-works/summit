diff --git a/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBookmarksHaiku.cpp b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBookmarksHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..34ca1316cddf36588566bf139bc13fc820fe5d9a
--- /dev/null
+++ b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIBookmarksHaiku.cpp
@@ -0,0 +1,264 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPIBookmarksHaiku.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionAPINamespace.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionEventListenerType.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+#include <wtf/URL.h>
+
+namespace WebKit {
+
+static bool validIdentifier(const String& id, String& exception)
+{
+    if (id.isEmpty() || !id.containsOnly<isASCIIDigit>() || id.length() > 18) {
+        exception = toErrorString(nullString(), "id"_s, "it is not a bookmark identifier"_s);
+        return false;
+    }
+    return true;
+}
+
+static RefPtr<JSON::Object> objectArgument(const JSON::Value* value, ASCIILiteral name, String& exception)
+{
+    RefPtr object = value ? const_cast<JSON::Value*>(value)->asObject() : nullptr;
+    if (!object)
+        exception = toErrorString(nullString(), name, "an object is expected"_s);
+    return object;
+}
+
+// Copies the string members of an object, checking their types; url must be a
+// valid URL and parentId an identifier.
+static bool copyStrings(const JSON::Object& from, JSON::Object& to, std::initializer_list<ASCIILiteral> keys, String& exception)
+{
+    for (auto key : keys) {
+        RefPtr value = from.getValue(key);
+        if (!value)
+            continue;
+        auto string = value->asString();
+        if (string.isNull()) {
+            exception = toErrorString(nullString(), key, "a string is expected"_s);
+            return false;
+        }
+        if (key == "url"_s && !URL { string }.isValid()) {
+            exception = toErrorString(nullString(), key, "a valid URL is expected"_s);
+            return false;
+        }
+        if (key == "parentId"_s && !validIdentifier(string, exception))
+            return false;
+        to.setString(key, string);
+    }
+    return true;
+}
+
+static bool copyIndex(const JSON::Object& from, JSON::Object& to, String& exception)
+{
+    RefPtr value = from.getValue("index"_s);
+    if (!value)
+        return true;
+    auto index = value->asDouble();
+    if (!index || *index < 0 || *index != std::floor(*index)) {
+        exception = toErrorString(nullString(), "index"_s, "it must be a non-negative integer"_s);
+        return false;
+    }
+    to.setDouble("index"_s, *index);
+    return true;
+}
+
+void WebExtensionAPIBookmarksHaiku::get(const String& idOrIdListJSON, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr idOrIdList = JSON::Value::parseJSON(idOrIdListJSON);
+    Ref ids = JSON::Array::create();
+    if (idOrIdList && idOrIdList->type() == JSON::Value::Type::String) {
+        if (!validIdentifier(idOrIdList->asString(), exception))
+            return;
+        ids->pushString(idOrIdList->asString());
+    } else if (RefPtr array = idOrIdList ? idOrIdList->asArray() : nullptr; array && array->length()) {
+        for (auto& item : *array) {
+            if (item->type() != JSON::Value::Type::String || !validIdentifier(item->asString(), exception)) {
+                if (exception.isEmpty())
+                    exception = toErrorString(nullString(), "idOrIdList"_s, "a string or an array of strings is expected"_s);
+                return;
+            }
+            ids->pushString(item->asString());
+        }
+    } else {
+        exception = toErrorString(nullString(), "idOrIdList"_s, "a string or a non-empty array of strings is expected"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    arguments->setArray("ids"_s, WTF::move(ids));
+    query("get"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::getChildren(const String& id, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    query("getChildren"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::getRecent(double numberOfItems, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!std::isfinite(numberOfItems) || numberOfItems < 1) {
+        exception = toErrorString(nullString(), "numberOfItems"_s, "it must be at least 1"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    arguments->setDouble("numberOfItems"_s, std::floor(numberOfItems));
+    query("getRecent"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::getTree(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    query("getTree"_s, JSON::Object::create(), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::getSubTree(const String& id, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    query("getSubTree"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::search(const String& queryJSON, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr queryValue = JSON::Value::parseJSON(queryJSON);
+    Ref arguments = JSON::Object::create();
+    if (queryValue && queryValue->type() == JSON::Value::Type::String)
+        arguments->setString("query"_s, queryValue->asString());
+    else {
+        RefPtr object = objectArgument(queryValue.get(), "query"_s, exception);
+        if (!object || !copyStrings(*object, arguments, { "query"_s, "url"_s, "title"_s }, exception))
+            return;
+    }
+    query("search"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::create(RefPtr<JSON::Value> bookmark, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(bookmark.get(), "bookmark"_s, exception);
+    Ref arguments = JSON::Object::create();
+    if (!object || !copyStrings(*object, arguments, { "parentId"_s, "title"_s, "url"_s }, exception) || !copyIndex(*object, arguments, exception))
+        return;
+    query("create"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::move(const String& id, RefPtr<JSON::Value> destination, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    RefPtr object = objectArgument(destination.get(), "destination"_s, exception);
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    if (!object || !copyStrings(*object, arguments, { "parentId"_s }, exception) || !copyIndex(*object, arguments, exception))
+        return;
+    query("move"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::update(const String& id, RefPtr<JSON::Value> changes, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    RefPtr object = objectArgument(changes.get(), "changes"_s, exception);
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    if (!object || !copyStrings(*object, arguments, { "title"_s, "url"_s }, exception))
+        return;
+    query("update"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::remove(const String& id, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    query("remove"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::removeTree(const String& id, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validIdentifier(id, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("id"_s, id);
+    query("removeTree"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIBookmarksHaiku::query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::BookmarksQueryHaiku(method, arguments->toJSONString()),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isEmpty() || *result == "null"_s) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+WebExtensionAPIEvent& WebExtensionAPIBookmarksHaiku::onCreated()
+{
+    if (!m_onCreated)
+        m_onCreated = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::BookmarksOnCreated);
+    return *m_onCreated;
+}
+
+WebExtensionAPIEvent& WebExtensionAPIBookmarksHaiku::onRemoved()
+{
+    if (!m_onRemoved)
+        m_onRemoved = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::BookmarksOnRemoved);
+    return *m_onRemoved;
+}
+
+WebExtensionAPIEvent& WebExtensionAPIBookmarksHaiku::onChanged()
+{
+    if (!m_onChanged)
+        m_onChanged = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::BookmarksOnChanged);
+    return *m_onChanged;
+}
+
+WebExtensionAPIEvent& WebExtensionAPIBookmarksHaiku::onMoved()
+{
+    if (!m_onMoved)
+        m_onMoved = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::BookmarksOnMoved);
+    return *m_onMoved;
+}
+
+void WebExtensionContextProxy::dispatchBookmarksEventHaiku(WebExtensionEventListenerType type, const String& identifier, const String& infoJSON)
+{
+    // Listeners get (id, info), as in Chrome.
+    auto idJSON = JSON::Value::create(identifier)->toJSONString();
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        auto& bookmarks = namespaceObject.bookmarks();
+        WebExtensionAPIEvent* event = nullptr;
+        switch (type) {
+        case WebExtensionEventListenerType::BookmarksOnCreated: event = &bookmarks.onCreated(); break;
+        case WebExtensionEventListenerType::BookmarksOnRemoved: event = &bookmarks.onRemoved(); break;
+        case WebExtensionEventListenerType::BookmarksOnChanged: event = &bookmarks.onChanged(); break;
+        case WebExtensionEventListenerType::BookmarksOnMoved: event = &bookmarks.onMoved(); break;
+        default: return;
+        }
+        event->invokeListenersWithJSONArguments({ idJSON, infoJSON });
+    });
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
