+    auto rootContentsLayer = static_cast<ScrollingTreeFrameScrollingNodeCoordinated*>(rootScrollingNode)->rootContentsLayer();
+    if (!rootContentsLayer)
+        return now;
+    return rootContentsLayer->nextFrameTimeHaiku(now).value_or(now);
+}
