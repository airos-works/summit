+}
+
+void LauncherWindow::NavigationCapabilitiesChanged(bool canGoBackward,
+    bool canGoForward, bool canStop, BWebView* view)
+{
+    if (m_BackButton)
+        m_BackButton->SetEnabled(canGoBackward);
+    if (m_ForwardButton)
