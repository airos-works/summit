+// B_WEBKIT_DATA_* as WebKit's types.
+static OptionSet<WebKit::WebsiteDataType> websiteDataTypesHaiku(uint32 types)
+{
+    using WebKit::WebsiteDataType;
+    OptionSet<WebsiteDataType> result;
+    if (types & B_WEBKIT_DATA_COOKIES)
+        result.add(WebsiteDataType::Cookies);
+    if (types & B_WEBKIT_DATA_CACHE)
+        result.add({ WebsiteDataType::DiskCache, WebsiteDataType::MemoryCache });
+    if (types & B_WEBKIT_DATA_LOCAL_STORAGE)
+        result.add({ WebsiteDataType::LocalStorage, WebsiteDataType::SessionStorage });
+    if (types & B_WEBKIT_DATA_INDEXED_DB)
+        result.add(WebsiteDataType::IndexedDBDatabases);
+    if (types & B_WEBKIT_DATA_SERVICE_WORKERS)
+        result.add({ WebsiteDataType::ServiceWorkerRegistrations, WebsiteDataType::DOMCache });
+    return result;
+}
+
+// A site's record without extensions' own origins; false when nothing is left.
+static bool websiteRecordWithoutExtensionsHaiku(WebKit::WebsiteDataRecord& record)
+{
+    record.origins.removeIf([](const WebCore::SecurityOriginData& origin) {
+        return (origin.protocol() == "webkit-extension"_s || origin.protocol() == "chrome-extension"_s);
+    });
+    return !record.origins.isEmpty() || !record.cookieHostNames.isEmpty();
+}
+
+void BWebKitContext::FetchWebsiteDataSizes(uint32 types, const BMessenger& reply, uint64 identifier)
+{
+    if (m_status != B_OK) {
+        BMessage message(B_WEBKIT_WEBSITE_DATA_SIZES);
+        message.AddUInt64("identifier", identifier);
+        message.AddString("error", "The website data could not be opened");
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        return;
+    }
+    auto operation = [context = m_context, types, reply, identifier] {
+        Ref store = context->dataStore();
+        store->fetchData(websiteDataTypesHaiku(types), WebKit::WebsiteDataFetchOption::ComputeSizes,
+            [reply, identifier](Vector<WebKit::WebsiteDataRecord> records) mutable {
+                BMessage message(B_WEBKIT_WEBSITE_DATA_SIZES);
+                message.AddUInt64("identifier", identifier);
+                for (auto& record : records) {
+                    if (record.displayName.isEmpty() || !websiteRecordWithoutExtensionsHaiku(record))
+                        continue;
+                    message.AddString("site", record.displayName.utf8().legacyCStringPointer());
+                    message.AddUInt64("size", record.size ? record.size->totalSize : 0);
+                }
+                reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+            });
+    };
+    if (RunLoop::isMain())
+        operation();
+    else
+        RunLoop::mainSingleton().dispatch(WTF::move(operation));
+}
+
+void BWebKitContext::RemoveWebsiteDataOfSites(uint32 types, const std::vector<std::string>& sites, const BMessenger& reply, uint64 identifier)
+{
+    auto respond = [reply, identifier](const char* error) {
+        BMessage message(B_WEBKIT_WEBSITE_DATA_REMOVED);
+        message.AddUInt64("identifier", identifier);
+        if (error)
+            message.AddString("error", error);
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    };
+    if (m_status != B_OK) {
+        respond("The website data could not be opened");
+        return;
+    }
+    HashSet<String> names;
+    for (const auto& site : sites) {
+        if (!site.empty())
+            names.add(String::fromUTF8(site.c_str()).isolatedCopy());
+    }
+    auto operation = [context = m_context, types, names = WTF::move(names), respond] {
+        Ref store = context->dataStore();
+        const auto dataTypes = websiteDataTypesHaiku(types);
+        store->fetchData(dataTypes, { }, [store, dataTypes, names, respond](Vector<WebKit::WebsiteDataRecord> records) mutable {
+            Vector<WebKit::WebsiteDataRecord> removable;
+            for (auto& record : records) {
+                if (names.contains(record.displayName) && websiteRecordWithoutExtensionsHaiku(record))
+                    removable.append(WTF::move(record));
+            }
+            if (removable.isEmpty()) {
+                respond(nullptr);
+                return;
+            }
+            store->removeData(dataTypes, removable, [respond] { respond(nullptr); });
+        });
+    };
+    if (RunLoop::isMain())
+        operation();
+    else
+        RunLoop::mainSingleton().dispatch(WTF::move(operation));
+}
+
+void BWebKitContext::RemoveWebsiteDataSince(uint32 types, int64 since, const std::vector<std::string>& hosts, const BMessenger& reply,
+    uint64 identifier)
+{
+    auto respond = [reply, identifier](const char* error) {
+        BMessage message(B_WEBKIT_WEBSITE_DATA_REMOVED);
+        message.AddUInt64("identifier", identifier);
+        if (error)
+            message.AddString("error", error);
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    };
+    if (m_status != B_OK) {
+        respond("The website data could not be opened");
+        return;
+    }
+    HashSet<String> domains;
+    for (const auto& host : hosts) {
+        auto domain = WebCore::RegistrableDomain::uncheckedCreateFromHost(String::fromUTF8(host.c_str()));
+        if (!domain.isEmpty())
+            domains.add(domain.string().isolatedCopy());
+    }
+    auto operation = [context = m_context, types, since, domains = WTF::move(domains), respond] {
+        using WebKit::WebsiteDataType;
+        OptionSet<WebsiteDataType> timed;
+        OptionSet<WebsiteDataType> bySite;
+        if (types & B_WEBKIT_DATA_COOKIES)
+            timed.add(WebsiteDataType::Cookies);
+        if (types & B_WEBKIT_DATA_CACHE)
+            timed.add({ WebsiteDataType::DiskCache, WebsiteDataType::MemoryCache });
+        if (types & B_WEBKIT_DATA_LOCAL_STORAGE)
+            bySite.add({ WebsiteDataType::LocalStorage, WebsiteDataType::SessionStorage });
+        if (types & B_WEBKIT_DATA_INDEXED_DB)
+            bySite.add(WebsiteDataType::IndexedDBDatabases);
+        if (types & B_WEBKIT_DATA_SERVICE_WORKERS)
+            bySite.add({ WebsiteDataType::ServiceWorkerRegistrations, WebsiteDataType::DOMCache });
+        Ref store = context->dataStore();
+        auto pending = std::make_shared<unsigned>(2);
+        auto finished = [pending, respond] {
+            if (!--*pending)
+                respond(nullptr);
+        };
+        if (timed)
+            store->removeData(timed, WallTime::fromRawSeconds(std::max<int64>(since, 0)), [finished] { finished(); });
+        else
+            finished();
+        if (!bySite || domains.isEmpty()) {
+            finished();
+            return;
+        }
+        store->fetchData(bySite, { }, [store, bySite, domains, finished](Vector<WebKit::WebsiteDataRecord> records) mutable {
+            Vector<WebKit::WebsiteDataRecord> removable;
+            for (auto& record : records) {
+                record.origins.removeIf([&](const WebCore::SecurityOriginData& origin) {
+                    return (origin.protocol() == "webkit-extension"_s || origin.protocol() == "chrome-extension"_s)
+                        || !domains.contains(WebCore::RegistrableDomain::uncheckedCreateFromHost(origin.host()).string());
+                });
+                if (!record.origins.isEmpty())
+                    removable.append(WTF::move(record));
+            }
+            if (removable.isEmpty()) {
+                finished();
+                return;
+            }
+            store->removeData(bySite, removable, WTF::move(finished));
+        });
+    };
+    if (RunLoop::isMain())
+        operation();
+    else
+        RunLoop::mainSingleton().dispatch(WTF::move(operation));
+}
+
+void BWebKitContext::RemoveWebsiteData(uint32 types, const BMessenger& reply, uint64 identifier, bool includeExtensions)
+{
+    auto respond = [reply, identifier](const char* error) {
+        BMessage message(B_WEBKIT_WEBSITE_DATA_REMOVED);
+        message.AddUInt64("identifier", identifier);
+        if (error)
+            message.AddString("error", error);
+        reply.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    };
+    if (m_status != B_OK) {
+        respond("The website data could not be opened");
+        return;
+    }
+    auto operation = [context = m_context, types, includeExtensions, respond] {
+        using WebKit::WebsiteDataType;
+        // Cookies and caches are removed whole; storage is removed per origin
+        // so that extensions' own origins can be kept.
+        OptionSet<WebsiteDataType> whole;
+        OptionSet<WebsiteDataType> byOrigin;
+        if (types & B_WEBKIT_DATA_COOKIES)
+            whole.add(WebsiteDataType::Cookies);
+        if (types & B_WEBKIT_DATA_CACHE) {
+            whole.add({ WebsiteDataType::DiskCache, WebsiteDataType::MemoryCache });
+            // The scripts' compiled code (CachedScriptSourceProviderHaiku.cpp).
+            const char* bytecode = getenv("WEBKIT_HAIKU_BYTECODE_CACHE");
+            if (context->dataStore().isPersistent() && bytecode && *bytecode == '/') {
+                Thread::create("Bytecode cache removal"_s, [path = String::fromUTF8(bytecode)] {
+                    FileSystem::deleteNonEmptyDirectory(path);
+                })->detach();
+            }
+        }
+        if (types & B_WEBKIT_DATA_LOCAL_STORAGE)
+            byOrigin.add({ WebsiteDataType::LocalStorage, WebsiteDataType::SessionStorage });
+        if (types & B_WEBKIT_DATA_INDEXED_DB)
+            byOrigin.add(WebsiteDataType::IndexedDBDatabases);
+        if (types & B_WEBKIT_DATA_SERVICE_WORKERS)
+            byOrigin.add({ WebsiteDataType::ServiceWorkerRegistrations, WebsiteDataType::DOMCache });
+        if (includeExtensions) {
+            whole.add(byOrigin);
+            byOrigin = { };
+        }
+        Ref store = context->dataStore();
+        auto pending = std::make_shared<unsigned>(2);
+        auto finished = [pending, respond] {
+            if (!--*pending)
+                respond(nullptr);
+        };
+        if (whole)
+            store->removeData(whole, WallTime::fromRawSeconds(0), [finished] { finished(); });
+        else
+            finished();
+        if (!byOrigin) {
+            finished();
+            return;
+        }
+        store->fetchData(byOrigin, { }, [store, byOrigin, finished](Vector<WebKit::WebsiteDataRecord> records) mutable {
+            Vector<WebKit::WebsiteDataRecord> removable;
+            for (auto& record : records) {
+                record.origins.removeIf([](const WebCore::SecurityOriginData& origin) {
+                    return (origin.protocol() == "webkit-extension"_s || origin.protocol() == "chrome-extension"_s);
+                });
+                if (!record.origins.isEmpty())
+                    removable.append(WTF::move(record));
+            }
+            if (removable.isEmpty()) {
+                finished();
+                return;
+            }
+            store->removeData(byOrigin, removable, WTF::move(finished));
+        });
+    };
+    if (RunLoop::isMain())
+        operation();
+    else
+        RunLoop::mainSingleton().dispatch(WTF::move(operation));
+}
