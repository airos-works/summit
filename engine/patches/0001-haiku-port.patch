+void TextChecker::checkSpellingForLanguageHaiku(StringView text, const String& language, int32_t& misspellingLocation, int32_t& misspellingLength)
+{
+    misspellingLocation = -1;
+    misspellingLength = 0;
+    auto& checker = spellChecker();
+    if (!checker.enabled)
+        return;
+    UBreakIterator* iterator = wordBreakIterator(text);
+    if (!iterator)
+        return;
+    int start = ubrk_first(iterator);
+    for (int end = ubrk_next(iterator); end != UBRK_DONE; end = ubrk_next(iterator)) {
+        if (isWordTextBreak(iterator) && !checker.isCorrect(text.substring(start, end - start), language)) {
+            misspellingLocation = start;
+            misspellingLength = end - start;
+            return;
+        }
+        start = end;
+    }
+}
