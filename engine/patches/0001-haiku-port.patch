diff --git a/Source/WebCore/Modules/webbluetooth/BluetoothDevice.cpp b/Source/WebCore/Modules/webbluetooth/BluetoothDevice.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bd4b6fd2d217a7be1feb7e46d5108d90547e6fca
--- /dev/null
+++ b/Source/WebCore/Modules/webbluetooth/BluetoothDevice.cpp
@@ -0,0 +1,143 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEB_BLUETOOTH)
+#include "BluetoothDevice.h"
+#include "BluetoothGATTObjects.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventDispatcher.h"
+#include "Event.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSBluetoothRemoteGATTServer.h"
+#include <wtf/TZoneMallocInlines.h>
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(BluetoothDevice);
+Ref<BluetoothDevice> BluetoothDevice::create(Document& document, Bluetooth& bluetooth, Ref<JSON::Object>&& data)
+{
+    auto result = adoptRef(*new BluetoothDevice(document, bluetooth, WTF::move(data))); result->suspendIfNeeded(); return result;
+}
+BluetoothDevice::BluetoothDevice(Document& document, Bluetooth& bluetooth, Ref<JSON::Object>&& data)
+    : ActiveDOMObject(&document), m_id(data->getString("id"_s)), m_name(data->getString("name"_s)), m_bluetooth(bluetooth), m_timer(*this, &BluetoothDevice::poll) { }
+BluetoothDevice::~BluetoothDevice() = default;
+Document* BluetoothDevice::document() const { return dynamicDowncast<Document>(scriptExecutionContext()); }
+Ref<BluetoothRemoteGATTServer> BluetoothDevice::gatt()
+{
+    if (m_gatt) return Ref { *m_gatt };
+    auto server = BluetoothRemoteGATTServer::create(*this); m_gatt = server; return server;
+}
+Ref<JSON::Object> BluetoothDevice::arguments(ASCIILiteral operation) const
+{
+    auto args = JSON::Object::create(); args->setString("operation"_s, operation); args->setString("id"_s, m_id); args->setString("generation"_s, m_generation); return args;
+}
+void BluetoothDevice::connect(DOMPromiseDeferred<IDLInterface<BluetoothRemoteGATTServer>>&& promise)
+{
+    if (m_forgotten || m_stopped) { promise.reject(ExceptionCode::SecurityError, "This Bluetooth device is no longer permitted"_s); return; }
+    if (m_connected) { promise.resolve(gatt()); return; }
+    if (m_connecting) { promise.reject(ExceptionCode::InvalidStateError, "A Bluetooth connection is already pending"_s); return; }
+    m_connecting = true; auto attempt = ++m_connectAttempt;
+    Bluetooth::perform(document(), arguments("connect"_s), { }, [this, protectedThis = Ref { *this }, attempt, promise = WTF::move(promise)](auto&& result, auto&&, auto connected) mutable {
+        if (attempt != m_connectAttempt || m_stopped || m_forgotten) { promise.reject(ExceptionCode::AbortError, "The Bluetooth connection was cancelled"_s); return; }
+        m_connecting = false;
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        auto object = result.releaseReturnValue();
+        m_generation = object->getString("generation"_s);
+        if (!connected.value_or(false) || m_generation.isEmpty()) { promise.reject(ExceptionCode::NetworkError, "The Bluetooth server did not connect"_s); return; }
+        m_connected = true;
+        m_timer.startRepeating(100_ms);
+        promise.resolve(gatt());
+    });
+}
+void BluetoothDevice::disconnect()
+{
+    if (!m_connected && !m_connecting) return;
+    auto args = arguments("disconnect"_s);
+    Bluetooth::perform(document(), WTF::move(args), { }, [](auto&&, auto&&, auto) { });
+    disconnected();
+}
+void BluetoothDevice::disconnected(bool dispatch)
+{
+    bool wasConnected = m_connected;
+    ++m_connectAttempt; m_connected = false; m_connecting = false; m_generation = { }; m_timer.stop();
+    for (auto& entry : m_characteristics) if (entry.value) entry.value->disconnected();
+    m_characteristics.clear(); m_services.clear();
+    if (wasConnected && dispatch && !m_stopped) dispatchEvent(Event::create(eventNames().gattserverdisconnectedEvent, Event::CanBubble::Yes, Event::IsCancelable::No));
+}
+void BluetoothDevice::forget(DOMPromiseDeferred<void>&& promise)
+{
+    if (m_forgotten) { promise.resolve(); return; }
+    Bluetooth::perform(document(), arguments("forget"_s), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        m_forgotten = true; disconnected(); promise.resolve();
+    });
+}
+void BluetoothDevice::perform(const String& generation, Ref<JSON::Object>&& args, Vector<uint8_t>&& bytes, Bluetooth::Completion&& completion)
+{
+    if (!m_connected || m_stopped) { completion(Exception { ExceptionCode::NetworkError, "The Bluetooth server is disconnected"_s }, { }, false); return; }
+    if (generation.isEmpty() || generation != m_generation) { completion(Exception { ExceptionCode::InvalidStateError, "This GATT object belongs to a previous connection"_s }, { }, true); return; }
+    args->setString("generation"_s, generation);
+    Bluetooth::perform(document(), WTF::move(args), WTF::move(bytes),
+        [this, protectedThis = Ref { *this }, generation, completion = WTF::move(completion)](auto&& result, auto&& bytes, auto connected) mutable {
+            if (!m_connected || generation != m_generation) { completion(Exception { ExceptionCode::NetworkError, "The Bluetooth connection ended before the operation completed"_s }, { }, false); return; }
+            if (connected && !*connected) disconnected();
+            if (!result.hasException()) {
+                auto object = result.releaseReturnValue();
+                // Keep result storage independent: an event handler may navigate,
+                // disconnect or start another request while notifications bubble.
+                deliverNotifications(object);
+                if (!m_connected || generation != m_generation) { completion(Exception { ExceptionCode::NetworkError, "The Bluetooth connection ended"_s }, { }, false); return; }
+                completion(WTF::move(object), WTF::move(bytes), connected);
+            } else completion(result.releaseException(), WTF::move(bytes), connected);
+        });
+}
+Ref<BluetoothRemoteGATTService> BluetoothDevice::service(Ref<JSON::Object>&& data)
+{
+    unsigned handle = data->getInteger("handle"_s).value_or(0);
+    if (auto item = m_services.find(handle); item != m_services.end() && item->value) return Ref { *item->value };
+    auto value = BluetoothRemoteGATTService::create(*this, WTF::move(data)); m_services.set(handle, value); return value;
+}
+Ref<BluetoothRemoteGATTCharacteristic> BluetoothDevice::characteristic(BluetoothRemoteGATTService& service, Ref<JSON::Object>&& data)
+{
+    unsigned handle = data->getInteger("handle"_s).value_or(0);
+    if (auto item = m_characteristics.find(handle); item != m_characteristics.end() && item->value) return Ref { *item->value };
+    auto value = BluetoothRemoteGATTCharacteristic::create(service, WTF::move(data)); m_characteristics.set(handle, value); return value;
+}
+void BluetoothDevice::deliverNotifications(const JSON::Object& object)
+{
+    auto array = object.getArray("notifications"_s);
+    if (!array) return;
+    for (auto& value : *array) {
+        if (!m_connected || m_stopped) break;
+        auto notification = value->asObject(); if (!notification) continue;
+        unsigned handle = notification->getInteger("handle"_s).value_or(0);
+        auto found = m_characteristics.find(handle); if (found == m_characteristics.end() || !found->value) continue;
+        Ref characteristic = *found->value;
+        auto data = notification->getArray("value"_s); if (!data || data->length() > 512) continue;
+        Vector<uint8_t> bytes; for (auto& byte : *data) bytes.append(byte->asInteger().value_or(0));
+        characteristic->notification(WTF::move(bytes));
+    }
+}
+void BluetoothDevice::poll()
+{
+    if (m_polling || !m_connected || m_stopped) return;
+    m_polling = true;
+    auto generation = m_generation;
+    perform(generation, arguments("poll"_s), { }, [this, protectedThis = Ref { *this }, generation](auto&& result, auto&&, auto) {
+        m_polling = false;
+        if (result.hasException() && generation == m_generation) disconnected();
+    });
+}
+void BluetoothDevice::dispatchEvent(Event& event)
+{
+    Ref protectedThis { *this }; RefPtr parent = m_bluetooth.get();
+    if (parent) EventDispatcher::dispatchEvent(std::initializer_list<EventTarget*> { this, parent.get() }, event);
+    else EventTarget::dispatchEvent(event);
+}
+void BluetoothDevice::stop() { m_stopped = true; disconnected(false); }
+void BluetoothDevice::suspend(ReasonForSuspension) { disconnect(); }
+void BluetoothDevice::resume() { }
+bool BluetoothDevice::virtualHasPendingActivity() const { return !m_stopped && (m_connected || m_connecting); }
+}
+#endif
