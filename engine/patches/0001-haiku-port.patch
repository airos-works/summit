+namespace WebKit {
+class SitePermissionsHaiku;
+
+// WebHID. It shares the WebUSB broker's request channel ("api": "hid") and
+// its rules: the browser process owns the devices, and paths, identities and
+// unapproved devices never reach a web process. Grants last for this
+// browsing context; private contexts get their own broker.
+class WebHIDBrokerHaiku final : public std::enable_shared_from_this<WebHIDBrokerHaiku> {
+public:
