diff --git a/Source/WebKit/Platform/haiku/PerformanceCoresHaiku.h b/Source/WebKit/Platform/haiku/PerformanceCoresHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..4a6b597ccebfcd20f94b48b0ee1755eb5b9d20fc
--- /dev/null
+++ b/Source/WebKit/Platform/haiku/PerformanceCoresHaiku.h
@@ -0,0 +1,99 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <OS.h>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <sys/types.h>
+#include <vector>
+
+namespace WebKit {
+
+// Haiku's scheduler treats every core alike. Where an ARM SoC pairs fast and
+// slow cores (the Cubie A7S's two Cortex-A76 and six A55, the RK3588's four
+// A76 and four A55), the threads a page waits on then run on a slow core most
+// of the time: on the Cubie scripts and layout took 2.2 times as long there.
+// preferPerformanceCoresHaiku() keeps a thread on the fast cores. It does
+// nothing where all cores are of one kind, on any CPU that is not ARM's own
+// design, and with SUMMIT_PERFORMANCE_CORES=0.
+class PerformanceCoresHaiku {
+public:
+    static void prefer(thread_id thread = find_thread(nullptr))
+    {
+        auto& cores = singleton();
+        if (cores.m_setAffinity)
+            cores.m_setAffinity(thread, sizeof(cores.m_mask), cores.m_mask);
+    }
+
+private:
+    // As cpuset_t in Haiku's <gnu/sched.h> (CPU_SETSIZE 1024).
+    uint32_t m_mask[1024 / 32] { };
+    int (*m_setAffinity)(pid_t, size_t, const void*) { nullptr };
+
+    static const PerformanceCoresHaiku& singleton()
+    {
+        static const PerformanceCoresHaiku cores;
+        return cores;
+    }
+
+    // ARM's in-order "LITTLE" designs, by MIDR part number; the kernel gives
+    // each core's MIDR as its model.
+    static bool isEfficiencyCore(uint32_t midr)
+    {
+        if ((midr >> 24) != 0x41)
+            return false;
+        switch ((midr >> 4) & 0xfff) {
+        case 0xd01: // Cortex-A32
+        case 0xd02: // Cortex-A34
+        case 0xd03: // Cortex-A53
+        case 0xd04: // Cortex-A35
+        case 0xd05: // Cortex-A55
+        case 0xd46: // Cortex-A510
+        case 0xd80: // Cortex-A520
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    PerformanceCoresHaiku()
+    {
+#if defined(__aarch64__)
+        const char* setting = std::getenv("SUMMIT_PERFORMANCE_CORES");
+        if (setting && !std::strcmp(setting, "0"))
+            return;
+        uint32 count = 0;
+        if (get_cpu_topology_info(nullptr, &count) != B_OK || !count)
+            return;
+        std::vector<cpu_topology_node_info> nodes(count);
+        if (get_cpu_topology_info(nodes.data(), &count) != B_OK)
+            return;
+        // Depth first: each core node comes before the logical CPUs (SMT
+        // nodes, numbered by CPU) that belong to it.
+        uint32_t model = 0;
+        unsigned fast = 0;
+        unsigned slow = 0;
+        for (uint32 i = 0; i < count; i++) {
+            if (nodes[i].type == B_TOPOLOGY_CORE)
+                model = nodes[i].data.core.model;
+            else if (nodes[i].type == B_TOPOLOGY_SMT && nodes[i].id < 1024) {
+                if (isEfficiencyCore(model))
+                    slow++;
+                else {
+                    fast++;
+                    m_mask[nodes[i].id / 32] |= 1u << (nodes[i].id % 32);
+                }
+            }
+        }
+        if (!fast || !slow)
+            return;
+        // libgnu's, looked up so that nothing changes where it is missing.
+        m_setAffinity = reinterpret_cast<int (*)(pid_t, size_t, const void*)>(dlsym(RTLD_DEFAULT, "sched_setaffinity"));
+#endif
+    }
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/Platform/haiku/PresentStatsHaiku.h b/Source/WebKit/Platform/haiku/PresentStatsHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..9d80ad20274f13f8e315dba78444ea9890119281
--- /dev/null
+++ b/Source/WebKit/Platform/haiku/PresentStatsHaiku.h
@@ -0,0 +1,65 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <OS.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace WebKit {
+
+// SUMMIT_PRESENT_STATS=1 prints, every two seconds, how long each stage that
+// moves a finished frame towards the screen took: the web process reading it
+// back from the GPU, the UI process copying it, app_server drawing it. Each
+// stage is a full-frame copy, so this is where a high density screen costs.
+class PresentStageStatsHaiku {
+public:
+    explicit PresentStageStatsHaiku(const char* name)
+        : m_name(name)
+    {
+    }
+
+    static bool enabled()
+    {
+        static const bool on = [] {
+            const char* value = std::getenv("SUMMIT_PRESENT_STATS");
+            return value && !std::strcmp(value, "1");
+        }();
+        return on;
+    }
+
+    void add(bigtime_t elapsed, double megapixels)
+    {
+        std::lock_guard guard(m_mutex);
+        bigtime_t now = system_time();
+        if (!m_windowStart)
+            m_windowStart = now;
+        ++m_count;
+        m_total += elapsed;
+        m_max = std::max(m_max, elapsed);
+        m_megapixels += megapixels;
+        if (now - m_windowStart < 2000000)
+            return;
+        std::fprintf(stderr, "Summit present %s: %ld in %.1f s, mean %.2f ms, max %.2f ms, %.2f Mpx each\n",
+            m_name, long(m_count), (now - m_windowStart) / 1e6, m_total / 1e3 / m_count, m_max / 1e3, m_megapixels / m_count);
+        m_windowStart = now;
+        m_count = 0;
+        m_total = 0;
+        m_max = 0;
+        m_megapixels = 0;
+    }
+
+private:
+    const char* m_name;
+    std::mutex m_mutex;
+    bigtime_t m_windowStart { 0 };
+    long m_count { 0 };
+    bigtime_t m_total { 0 };
+    bigtime_t m_max { 0 };
+    double m_megapixels { 0 };
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/Platform/haiku/ReadWriteLockHaiku.cpp b/Source/WebKit/Platform/haiku/ReadWriteLockHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bbb7bcdedf9a8e0e8887eeffd36462679b305f03
--- /dev/null
+++ b/Source/WebKit/Platform/haiku/ReadWriteLockHaiku.cpp
@@ -0,0 +1,125 @@
+/*
+ * Copyright 2009, Michael Lotz, mmlr@mlotz.ch.
+ * Copyright 2026 KunanyiOS contributors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "config.h"
+#include "WKDeclarationSpecifiers.h"
+
+#include <locks.h>
+
+#include <OS.h>
+
+#include <cstddef>
+
+#include <user_thread.h>
+
+extern "C" status_t _kern_block_thread(uint32 flags, bigtime_t timeout);
+
+
+// Haiku's libroot rw_lock wait loop can lose progress after SIGCHLD or
+// another signal interrupts _kern_block_thread. Export just the two acquisition
+// functions so libbe's existing looper locks use the corrected wait path in
+// WebKit processes. Keep them in libWebKit, a direct dependency of the browser
+// and helpers: placing them only in its JavaScriptCore dependency lets libroot
+// win native symbol lookup first. Initialization, release and recursion remain
+// native, and no lock state is duplicated between libraries.
+// These private headers must match the target Haiku development environment.
+typedef struct rw_lock_waiter {
+	rw_lock_waiter *	next;
+	thread_id			thread;
+	bool				writer;
+} rw_lock_waiter;
+
+
+static status_t
+rw_lock_wait(rw_lock* lock, bool writer)
+{
+    rw_lock_waiter waiter;
+    waiter.thread = find_thread(nullptr);
+    waiter.next = nullptr;
+    waiter.writer = writer;
+    if (lock->waiters)
+        lock->last_waiter->next = &waiter;
+    else
+        lock->waiters = &waiter;
+    lock->last_waiter = &waiter;
+
+    for (;;) {
+        // Restore the wait state while holding the queue's mutex. A signal
+        // interruption leaves B_INTERRUPTED in it; retrying the syscall alone
+        // cannot block again and makes a later native wakeup ineffective.
+        get_user_thread()->wait_status = 1;
+        mutex_unlock(&lock->lock);
+        status_t result = _kern_block_thread(0, 0);
+        mutex_lock(&lock->lock);
+        if (result != B_INTERRUPTED)
+            return result;
+        // Unlock may have granted this waiter while the syscall was returning
+        // from interruption. Its removal is the protected grant record; do not
+        // sleep again after that handoff or increment reader counts twice.
+        bool pending = false;
+        for (auto* current = lock->waiters; current; current = current->next) {
+            if (current == &waiter) {
+                pending = true;
+                break;
+            }
+        }
+        if (!pending)
+            return B_OK;
+    }
+}
+
+WK_EXPORT status_t
+__rw_lock_read_lock(rw_lock *lock)
+{
+	MutexLocker locker(lock->lock);
+
+	if (lock->writer_count == 0) {
+		lock->reader_count++;
+		return B_OK;
+	}
+
+	if (lock->holder == find_thread(NULL)) {
+		lock->owner_count++;
+		return B_OK;
+	}
+
+	return rw_lock_wait(lock, false);
+}
+
+
+WK_EXPORT status_t
+__rw_lock_write_lock(rw_lock *lock)
+{
+	MutexLocker locker(lock->lock);
+
+	if (lock->reader_count == 0 && lock->writer_count == 0) {
+		lock->writer_count++;
+		lock->holder = find_thread(NULL);
+		lock->owner_count = 1;
+		return B_OK;
+	}
+
+	if (lock->holder == find_thread(NULL)) {
+		lock->owner_count++;
+		return B_OK;
+	}
+
+	lock->writer_count++;
+
+	status_t result = rw_lock_wait(lock, true);
+	if (result != B_OK)
+		return result;
+
+	if (lock->holder != find_thread(NULL)) {
+		debugger("write locked but holder not set");
+		return B_ERROR;
+	}
+
+	lock->owner_count = 1;
+	return B_OK;
+}
+
