+namespace {
+
+// The stable prefix of Haiku's usb_raw.h ABI (MIT, Haiku Inc. 2006-2008), as
+// used by WebUSB (USBDeviceSessionHaiku.cpp).
+constexpr uint32_t getVersion = 0x1000;
+constexpr uint32_t controlTransferCommand = 0x4000;
+constexpr uint32_t interruptTransferCommand = 0x4001;
+struct RawControl {
+    status_t status;
+    uint8_t requestType;
+    uint8_t request;
+    uint16_t value;
+    uint16_t index;
+    uint16_t length;
+    void* data;
+};
+struct RawTransfer {
+    status_t status;
+    uint32_t interfaceIndex;
+    uint32_t endpointIndex;
+    void* data;
+    size_t length;
+};
+constexpr status_t rawSuccess = 0;
+constexpr status_t rawStalled = 3;
+
+constexpr uint8_t hidClass = 3;
+constexpr uint8_t hidDescriptorType = 0x21;
+constexpr uint16_t reportDescriptorValue = 0x2200;
+constexpr size_t maximumDescriptorLength = 4096;
+constexpr size_t maximumReportLength = 4096;
+constexpr bigtime_t operationDeadline = 5000000;
+
+bool validPath(const std::string& path)
+{
+    constexpr std::string_view prefix = "/dev/bus/usb/";
+    if (!path.starts_with(prefix) || path.size() > 256)
+        return false;
+    auto rest = std::string_view(path).substr(prefix.size());
+    if (rest.empty() || rest.front() == '/' || rest.back() == '/')
+        return false;
+    for (char c : rest) {
+        if ((c < '0' || c > '9') && c != '/' && c != 'h' && c != 'u' && c != 'b')
+            return false;
+    }
+    return rest.find("//") == std::string_view::npos;
+}
+
+void listDevices(const std::string& path, unsigned depth, std::vector<std::string>& result)
+{
+    if (depth > 8 || result.size() >= 128)
+        return;
+    auto* dir = opendir(path.c_str());
+    if (!dir)
+        return;
+    while (auto* entry = readdir(dir)) {
+        if (entry->d_name[0] == '.')
+            continue;
+        auto child = path + '/' + entry->d_name;
+        if (!validPath(child))
+            continue;
+        struct stat st;
+        if (lstat(child.c_str(), &st) || S_ISLNK(st.st_mode))
+            continue;
+        if (S_ISDIR(st.st_mode))
+            listDevices(child, depth + 1, result);
+        else
+            result.push_back(std::move(child));
+        if (result.size() >= 128)
+            break;
+    }
+    closedir(dir);
+}
+
+std::string safeString(const char* text)
+{
+    if (!text)
+        return { };
+    return std::string(text, strnlen(text, 1024));
+}
+
+std::optional<size_t> reportDescriptorLength(const BUSBInterface& interface)
+{
+    alignas(usb_descriptor) uint8_t buffer[256];
+    for (uint32_t i = 0; i < 16; ++i) {
+        std::memset(buffer, 0, sizeof(buffer));
+        auto* descriptor = reinterpret_cast<usb_descriptor*>(buffer);
+        if (interface.OtherDescriptorAt(i, descriptor, sizeof(buffer)) != B_OK)
+            break;
+        uint8_t length = buffer[0];
+        if (buffer[1] != hidDescriptorType || length < 9)
+            continue;
+        // bcdHID, bCountryCode, bNumDescriptors, then (bDescriptorType,
+        // wDescriptorLength) pairs; the report descriptor is type 0x22.
+        unsigned count = buffer[5];
+        for (unsigned d = 0; d < count && 6 + d * 3 + 2 < length; ++d) {
+            if (buffer[6 + d * 3] == 0x22)
+                return buffer[7 + d * 3] | (buffer[8 + d * 3] << 8);
+        }
+    }
+    return std::nullopt;
+}
+
+std::string identityOf(const BUSBDevice& device, const struct stat& st)
+{
+    // As for WebUSB: length-delimited serial, and the device node so that a
+    // serial-less device reattached at the same address is a new device.
+    auto serial = safeString(device.SerialNumberString());
+    return std::to_string(device.VendorID()) + ":" + std::to_string(device.ProductID()) + ":"
+        + std::to_string(device.Version()) + ":" + std::to_string(serial.size()) + ":" + serial
+        + ":" + std::to_string(st.st_dev) + ":" + std::to_string(st.st_ino);
+}
+
+// The interfaces of one device, read once per device node.
+std::vector<Interface> describe(const std::string& path, const struct stat& st)
+{
+    std::vector<Interface> result;
+    BUSBDevice device(path.c_str());
+    if (device.InitCheck() != B_OK || !device.VendorID())
+        return result;
+    auto* configuration = device.ActiveConfiguration();
+    if (!configuration || configuration->CountInterfaces() > 128)
+        return result;
+    std::string identity;
+    std::string product;
+    for (uint32_t i = 0; i < configuration->CountInterfaces(); ++i) {
+        auto* interface = configuration->InterfaceAt(i);
+        if (!interface || interface->Class() != hidClass)
+            continue;
+        // Boot keyboards and mice are protected whatever they describe.
+        if (interface->Subclass() == 1 && (interface->Protocol() == 1 || interface->Protocol() == 2))
+            continue;
+        auto length = reportDescriptorLength(*interface);
+        if (!length || !*length || *length > maximumDescriptorLength)
+            continue;
+        std::vector<uint8_t> bytes(*length);
+        auto number = interface->Descriptor()->interface_number;
+        auto read = device.ControlTransfer(USB_REQTYPE_INTERFACE_IN | USB_REQTYPE_STANDARD, USB_REQUEST_GET_DESCRIPTOR,
+            reportDescriptorValue, number, bytes.size(), bytes.data());
+        if (read <= 0)
+            continue;
+        bytes.resize(read);
+        auto descriptor = parseReportDescriptor(bytes);
+        if (!descriptor || !eligible(*descriptor))
+            continue;
+        if (identity.empty()) {
+            identity = identityOf(device, st);
+            product = safeString(device.ProductString());
+        }
+        Interface value;
+        value.path = path;
+        value.identity = identity;
+        value.number = number;
+        value.vendorId = device.VendorID();
+        value.productId = device.ProductID();
+        value.product = product;
+        value.descriptor = std::move(*descriptor);
+        result.push_back(std::move(value));
+    }
+    return result;
+}
+
+// Raw USB waits can only be interrupted by killing the calling thread. Run
+// just the ioctl in its own thread, as WebUSB does: the kernel cancels the
+// queued transfer before unwinding and the caller joins before reusing the
+// buffers.
+struct Call {
+    int fd { -1 };
+    uint32_t operation { 0 };
+    void* command { nullptr };
+    size_t size { 0 };
+    sem_id done { -1 };
+    std::atomic<bool> returned { false };
+    bool failed { false };
+    thread_id thread { -1 };
+};
+
+int32 callEntry(void* data)
+{
+    auto& call = *static_cast<Call*>(data);
+    call.failed = ioctl(call.fd, call.operation, call.command, call.size) != 0;
+    call.returned.store(true);
+    release_sem(call.done);
+    return 0;
+}
+
+bool startCall(Call& call)
+{
+    call.thread = spawn_thread(callEntry, "WebHID transfer", B_NORMAL_PRIORITY, &call);
+    if (call.thread < B_OK)
+        return false;
+    if (resume_thread(call.thread) != B_OK) {
+        kill_thread(call.thread);
+        status_t ignored;
+        wait_for_thread(call.thread, &ignored);
+        return false;
+    }
+    return true;
+}
+
+// Ends a call that may still be waiting; returns whether its ioctl returned.
+bool finishCall(Call& call)
+{
+    if (call.thread < B_OK)
+        return false;
+    if (!call.returned.load())
+        kill_thread(call.thread);
+    status_t ignored;
+    wait_for_thread(call.thread, &ignored);
+    call.thread = -1;
+    return call.returned.load();
+}
+
+} // namespace
+
+std::vector<Interface> enumerateInterfaces()
+{
+    // Reading a report descriptor is a control transfer: do it once for each
+    // device node. A device node is never reused for a different device
+    // without being removed first.
+    static std::mutex cacheLock;
+    static std::map<std::string, std::vector<Interface>> cache;
+    std::vector<std::string> paths;
+    listDevices("/dev/bus/usb", 0, paths);
+    std::map<std::string, std::vector<Interface>> current;
+    std::vector<Interface> result;
+    for (auto& path : paths) {
+        struct stat st;
+        if (lstat(path.c_str(), &st) || S_ISLNK(st.st_mode))
+            continue;
+        auto key = path + ':' + std::to_string(st.st_dev) + ':' + std::to_string(st.st_ino);
+        std::vector<Interface> interfaces;
+        bool known = false;
+        {
+            std::lock_guard lock(cacheLock);
+            auto found = cache.find(key);
+            if (found != cache.end()) {
+                interfaces = found->second;
+                known = true;
+            }
+        }
+        if (!known)
+            interfaces = describe(path, st);
+        current[key] = interfaces;
+        result.insert(result.end(), interfaces.begin(), interfaces.end());
+    }
+    {
+        std::lock_guard lock(cacheLock);
+        cache = std::move(current);
+    }
+    return result;
+}
+
+struct Connection::State {
+    int fd { -1 };
+    std::string path;
+    uint8_t interfaceNumber { 0 };
+    uint32_t interfaceIndex { 0 };
+    std::optional<uint32_t> inputEndpoint;
+    std::optional<uint32_t> outputEndpoint;
+    Descriptor descriptor;
+    size_t inputLength { 0 };
+    InputHandler input;
+    sem_id event { -1 };
+
+    struct Operation {
+        int kind { 0 };
+        uint8_t reportId { 0 };
+        std::vector<uint8_t> data;
+        Completion completion;
+    };
+    std::mutex lock;
+    std::deque<Operation> operations;
+    bool closing { false };
+    bool gone { false };
+
+    void run();
+    Error perform(Operation&);
+    Error control(bool input, uint8_t request, uint16_t value, std::vector<uint8_t>& data);
+    Error interruptOut(const std::vector<uint8_t>& data);
+    bool closingNow()
+    {
+        std::lock_guard locker(lock);
+        return closing;
+    }
+};
+
+enum { SendReport, SendFeatureReport, ReceiveFeatureReport };
+
+std::shared_ptr<Connection> Connection::open(const Interface& approved, InputHandler&& input, Error& error)
+{
+    error = Error::None;
+    if (!validPath(approved.path) || !eligible(approved.descriptor)) {
+        error = Error::Security;
+        return nullptr;
+    }
+    struct stat before;
+    if (lstat(approved.path.c_str(), &before) || S_ISLNK(before.st_mode)) {
+        error = Error::NotFound;
+        return nullptr;
+    }
+    BUSBDevice device(approved.path.c_str());
+    if (device.InitCheck() != B_OK || identityOf(device, before) != approved.identity) {
+        error = Error::NotFound;
+        return nullptr;
+    }
+    auto* configuration = device.ActiveConfiguration();
+    const BUSBInterface* interface = nullptr;
+    for (uint32_t i = 0; configuration && i < configuration->CountInterfaces(); ++i) {
+        auto* candidate = configuration->InterfaceAt(i);
+        if (candidate && candidate->Descriptor()->interface_number == approved.number && candidate->Class() == hidClass)
+            interface = candidate;
+    }
+    if (!interface) {
+        error = Error::NotFound;
+        return nullptr;
+    }
+    auto state = std::make_shared<State>();
+    state->path = approved.path;
+    state->interfaceNumber = approved.number;
+    state->interfaceIndex = interface->Index();
+    state->descriptor = approved.descriptor;
+    for (uint32_t e = 0; e < interface->CountEndpoints(); ++e) {
+        auto* endpoint = interface->EndpointAt(e);
+        if (!endpoint || !endpoint->IsInterrupt())
+            continue;
+        if (endpoint->IsInput() && !state->inputEndpoint)
+            state->inputEndpoint = e;
+        else if (endpoint->IsOutput() && !state->outputEndpoint)
+            state->outputEndpoint = e;
+    }
+    // Ask for exactly the largest report: a transfer of a report that fills
+    // whole packets ends only when that many bytes have arrived.
+    size_t inputLength = state->descriptor.maximumReportLength(ReportType::Input);
+    if (inputLength && state->descriptor.usesReportIds)
+        ++inputLength;
+    if (!inputLength || inputLength > maximumReportLength)
+        state->inputEndpoint.reset();
+    state->inputLength = inputLength;
+
+    int fd = ::open(approved.path.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        error = Error::NotFound;
+        return nullptr;
+    }
+    struct stat opened;
+    status_t version = 0;
+    if (fstat(fd, &opened) || opened.st_dev != before.st_dev || opened.st_ino != before.st_ino) {
+        ::close(fd);
+        error = Error::NotFound;
+        return nullptr;
+    }
+    if (ioctl(fd, getVersion, &version, sizeof(version)) || (version != 0x14 && version != 0x15)) {
+        ::close(fd);
+        error = Error::NotSupported;
+        return nullptr;
+    }
+    state->fd = fd;
+    state->input = std::move(input);
+    state->event = create_sem(0, "WebHID device");
+    if (state->event < B_OK) {
+        ::close(fd);
+        error = Error::Network;
+        return nullptr;
+    }
+    auto* owner = new std::shared_ptr<State>(state);
+    auto thread = spawn_thread([](void* data) -> int32 {
+        std::unique_ptr<std::shared_ptr<State>> state(static_cast<std::shared_ptr<State>*>(data));
+        (*state)->run();
+        return 0;
+    }, "WebHID device", B_NORMAL_PRIORITY, owner);
+    if (thread < B_OK || resume_thread(thread) != B_OK) {
+        if (thread >= B_OK)
+            kill_thread(thread);
+        delete owner;
+        ::close(fd);
+        delete_sem(state->event);
+        error = Error::Network;
+        return nullptr;
+    }
+    return std::shared_ptr<Connection>(new Connection(std::move(state)));
+}
+
+Connection::Connection(std::shared_ptr<State> state)
+    : m_state(std::move(state)) { }
+Connection::~Connection() { close(); }
+
+void Connection::close()
+{
+    {
+        std::lock_guard lock(m_state->lock);
+        if (m_state->closing)
+            return;
+        m_state->closing = true;
+    }
+    release_sem(m_state->event);
+}
+
+void Connection::enqueue(int kind, uint8_t reportId, std::vector<uint8_t>&& data, Completion&& completion)
+{
+    {
+        std::lock_guard lock(m_state->lock);
+        if (!m_state->closing && !m_state->gone && m_state->operations.size() < 64) {
+            m_state->operations.push_back({ kind, reportId, std::move(data), std::move(completion) });
+            release_sem(m_state->event);
+            return;
+        }
+    }
+    completion(m_state->gone ? Error::NotFound : Error::InvalidState, { });
+}
+
+void Connection::sendReport(uint8_t reportId, std::vector<uint8_t>&& data, Completion&& completion)
+{
+    enqueue(SendReport, reportId, std::move(data), std::move(completion));
+}
+void Connection::sendFeatureReport(uint8_t reportId, std::vector<uint8_t>&& data, Completion&& completion)
+{
+    enqueue(SendFeatureReport, reportId, std::move(data), std::move(completion));
+}
+void Connection::receiveFeatureReport(uint8_t reportId, Completion&& completion)
+{
+    enqueue(ReceiveFeatureReport, reportId, { }, std::move(completion));
+}
+
+void Connection::State::run()
+{
+    struct Read {
+        Call call;
+        RawTransfer transfer { };
+        std::vector<uint8_t> buffer;
+    };
+    std::unique_ptr<Read> read;
+    unsigned failures = 0;
+    auto deliver = [&](Read& done) {
+        bool ok = !done.call.failed && done.transfer.status == rawSuccess;
+        if (done.call.failed) {
+            // The device was removed or the handle is no longer usable.
+            std::lock_guard locker(lock);
+            gone = true;
+        }
+        if (!ok) {
+            ++failures;
+            return;
+        }
+        failures = 0;
+        size_t length = std::min(done.transfer.length, done.buffer.size());
+        if (!length)
+            return;
+        uint8_t reportId = 0;
+        size_t offset = 0;
+        if (descriptor.usesReportIds) {
+            reportId = done.buffer[0];
+            offset = 1;
+        }
+        input(reportId, std::vector<uint8_t>(done.buffer.begin() + offset, done.buffer.begin() + length), false);
+    };
+    auto stopRead = [&] {
+        if (!read)
+            return;
+        if (finishCall(read->call))
+            deliver(*read);
+        read.reset();
+    };
+
+    for (;;) {
+        std::optional<Operation> operation;
+        bool deviceGone;
+        {
+            std::lock_guard locker(lock);
+            if (closing)
+                break;
+            if (!operations.empty()) {
+                operation = std::move(operations.front());
+                operations.pop_front();
+            }
+            deviceGone = gone;
+        }
+        if (operation) {
+            stopRead();
+            auto error = perform(*operation);
+            if (error == Error::NotFound) {
+                std::lock_guard locker(lock);
+                gone = true;
+            }
+            operation->completion(error, std::move(operation->data));
+            continue;
+        }
+        if (deviceGone) {
+            stopRead();
+            input(0, { }, true);
+            // Fail what arrives later until the broker closes this.
+            for (;;) {
+                acquire_sem(event);
+                std::deque<Operation> failed;
+                {
+                    std::lock_guard locker(lock);
+                    if (closing)
+                        break;
+                    failed.swap(operations);
+                }
+                for (auto& item : failed)
+                    item.completion(Error::NotFound, { });
+            }
+            break;
+        }
+        if (inputEndpoint && !read) {
+            if (failures > 32) {
+                // A stalled or misbehaving input endpoint: try again later
+                // without spinning.
+                if (acquire_sem_etc(event, 1, B_RELATIVE_TIMEOUT, 250000) == B_OK)
+                    continue;
+                failures = 16;
+            } else if (failures)
+                snooze(2000);
+            read = std::make_unique<Read>();
+            read->buffer.resize(inputLength);
+            read->transfer.status = rawSuccess;
+            read->transfer.interfaceIndex = interfaceIndex;
+            read->transfer.endpointIndex = *inputEndpoint;
+            read->transfer.data = read->buffer.data();
+            read->transfer.length = read->buffer.size();
+            read->call.fd = fd;
+            read->call.operation = interruptTransferCommand;
+            read->call.command = &read->transfer;
+            read->call.size = sizeof(read->transfer);
+            read->call.done = event;
+            if (!startCall(read->call)) {
+                read.reset();
+                ++failures;
+                continue;
+            }
+        }
+        acquire_sem(event);
+        if (read && read->call.returned.load()) {
+            finishCall(read->call);
+            deliver(*read);
+            read.reset();
+        }
+    }
+    stopRead();
+    std::deque<Operation> remaining;
+    {
+        std::lock_guard locker(lock);
+        remaining.swap(operations);
+    }
+    for (auto& item : remaining)
+        item.completion(Error::Abort, { });
+    ::close(fd);
+    fd = -1;
+    delete_sem(event);
+    event = -1;
+}
+
+Error Connection::State::perform(Operation& operation)
+{
+    auto type = operation.kind == SendReport ? ReportType::Output : ReportType::Feature;
+    // Numbered reports need an ID and unnumbered ones must not have one.
+    if (!operation.reportId != !descriptor.usesReportIds)
+        return Error::NotSupported;
+    auto length = descriptor.reportLength(type, operation.reportId);
+    if (operation.kind != ReceiveFeatureReport) {
+        if (!length || operation.data.size() > *length)
+            return Error::NotSupported;
+        // Devices expect whole reports: pad short ones, as other hosts do.
+        operation.data.resize(*length, 0);
+        // Numbered reports are sent with their ID in front.
+        if (operation.reportId)
+            operation.data.insert(operation.data.begin(), operation.reportId);
+        if (operation.kind == SendReport && outputEndpoint) {
+            auto error = interruptOut(operation.data);
+            operation.data.clear();
+            return error;
+        }
+        auto error = control(false, 0x09, uint16_t((operation.kind == SendReport ? 0x0200 : 0x0300) | operation.reportId), operation.data);
+        operation.data.clear();
+        return error;
+    }
+    if (!length)
+        return Error::NotSupported;
+    operation.data.assign(*length + (operation.reportId ? 1 : 0), 0);
+    // As in other browsers, a numbered feature report keeps its ID as the
+    // first byte.
+    return control(true, 0x01, uint16_t(0x0300 | operation.reportId), operation.data);
+}
+
+Error Connection::State::control(bool input, uint8_t request, uint16_t value, std::vector<uint8_t>& data)
+{
+    RawControl command { };
+    command.status = rawSuccess;
+    // Class request to the interface: SET_REPORT (0x21) or GET_REPORT (0xa1).
+    command.requestType = input ? 0xa1 : 0x21;
+    command.request = request;
+    command.value = value;
+    command.index = interfaceNumber;
+    command.length = data.size();
+    command.data = data.data();
+    Call call;
+    call.fd = fd;
+    call.operation = controlTransferCommand;
+    call.command = &command;
+    call.size = sizeof(command);
+    call.done = create_sem(0, "WebHID control");
+    if (call.done < B_OK)
+        return Error::Network;
+    if (!startCall(call)) {
+        delete_sem(call.done);
+        return Error::Network;
+    }
+    auto deadline = system_time() + operationDeadline;
+    while (!call.returned.load() && system_time() < deadline && !closingNow())
+        acquire_sem_etc(call.done, 1, B_RELATIVE_TIMEOUT, 100000);
+    bool returned = finishCall(call);
+    delete_sem(call.done);
+    if (!returned)
+        return closingNow() ? Error::Abort : Error::Network;
+    if (call.failed)
+        return Error::NotFound;
+    if (command.status == rawStalled)
+        return Error::NotSupported;
+    if (command.status != rawSuccess)
+        return Error::Network;
+    if (input)
+        data.resize(std::min<size_t>(command.length, data.size()));
+    return Error::None;
+}
+
+Error Connection::State::interruptOut(const std::vector<uint8_t>& data)
+{
+    RawTransfer transfer { };
+    std::vector<uint8_t> buffer = data;
+    transfer.status = rawSuccess;
+    transfer.interfaceIndex = interfaceIndex;
+    transfer.endpointIndex = *outputEndpoint;
+    transfer.data = buffer.data();
+    transfer.length = buffer.size();
+    Call call;
+    call.fd = fd;
+    call.operation = interruptTransferCommand;
+    call.command = &transfer;
+    call.size = sizeof(transfer);
+    call.done = create_sem(0, "WebHID output");
+    if (call.done < B_OK)
+        return Error::Network;
+    if (!startCall(call)) {
+        delete_sem(call.done);
+        return Error::Network;
+    }
+    auto deadline = system_time() + operationDeadline;
+    while (!call.returned.load() && system_time() < deadline && !closingNow())
+        acquire_sem_etc(call.done, 1, B_RELATIVE_TIMEOUT, 100000);
+    bool returned = finishCall(call);
+    delete_sem(call.done);
+    if (!returned)
+        return closingNow() ? Error::Abort : Error::Network;
+    if (call.failed)
+        return Error::NotFound;
+    return transfer.status == rawSuccess ? Error::None : Error::Network;
+}
+
+} // namespace WebKit::HIDHaiku
