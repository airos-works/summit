+    // Tracker shows the containing folder; the file is not selected.
+    if (auto result = openFolder(FileSystem::parentPath(*path)); !result) {
+        completionHandler(toWebExtensionError(apiName, nullString(), result.error()));
+        return;
+    }
+    completionHandler({ });
