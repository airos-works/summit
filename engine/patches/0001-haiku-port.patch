+
+String WebExtensionAPIIdentity::getRedirectURL(const String& path)
+{
+    // Chrome's form; the UI process recognizes the same host.
+    auto host = extensionContext().baseURL().host().convertToASCIILowercase();
+    auto trimmed = path.startsWith('/') ? path.substring(1) : path;
+    return makeString("https://"_s, host, ".chromiumapp.org/"_s, trimmed);
+}
+
+void WebExtensionAPIIdentity::launchWebAuthFlow(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = details ? details->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), "details"_s, "an object is expected"_s);
+        return;
+    }
+    URL url { object->getString("url"_s) };
+    if (!url.isValid() || !url.protocolIsInHTTPFamily()) {
+        exception = toErrorString(nullString(), "url"_s, "an http or https URL is expected"_s);
+        return;
+    }
+    bool interactive = false;
+    if (RefPtr value = object->getValue("interactive"_s))
+        interactive = value->asBoolean().value_or(false);
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::IdentityLaunchWebAuthFlowHaiku(url, interactive),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            callback->call(toJSValueRef(callback->globalContext(), *result));
+        }, extensionContext().identifier());
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
