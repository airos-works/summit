+#include "WebCore/BackForwardClient.h"
+#include <wtf/HashSet.h>
+#include <wtf/Vector.h>
+
+typedef Vector<RefPtr<WebCore::HistoryItem>> HistoryItemVector;
+typedef HashSet<RefPtr<WebCore::HistoryItem>> HistoryItemHashSet;
+
+class BackForwardList : public WebCore::BackForwardClient {
+public: 
+    static Ref<BackForwardList> create() { return adoptRef(*new BackForwardList()); }
+    virtual ~BackForwardList();
+
+    void addItem(Ref<WebCore::HistoryItem>&&) override;
+    void goToItem(WebCore::HistoryItem&) override;
+
+    RefPtr<WebCore::HistoryItem> itemAtIndex(int, WebCore::FrameIdentifier) override;
+    void setChildItem(WebCore::BackForwardFrameItemIdentifier, WTF::Ref<WebCore::HistoryItem>&&) override {};
+
+    unsigned int backListCount(void) const override;
+    unsigned int forwardListCount(void) const override;
+    bool containsItem(const WebCore::HistoryItem&) const override;
+
+    Vector<Ref<WebCore::HistoryItem>> allItems(WebCore::FrameIdentifier) override;
+
+    void close() override;
+
+private:
+    explicit BackForwardList();
+
+    HistoryItemVector m_entries;
+    HistoryItemHashSet m_entryHash;
+    unsigned m_current;
+    unsigned m_capacity;
+    bool m_closed;
+    bool m_enabled;
+};
