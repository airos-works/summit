+
+using webm::Status;
+constexpr auto ok = Status(Status::kOkCompleted);
+constexpr auto invalid = Status(Status::kInvalidElementValue);
+constexpr size_t maximumFrameSize = 16 * 1024 * 1024;
+constexpr size_t maximumBlockSize = 32 * 1024 * 1024;
+constexpr size_t maximumHeaderSize = 1024 * 1024;
+constexpr uint64_t nanosecondsPerSecond = 1000000000;
+
+// All pointers use the public API from libavcodec/vorbis_parser.h, whose
+// context is opaque. In particular, no AVCodecContext layout is duplicated.
+struct AVVorbisParseContext;
+struct VorbisAPI {
+    AVVorbisParseContext* (*init)(const uint8_t*, int) { nullptr };
+    void (*free)(AVVorbisParseContext**) { nullptr };
+    int (*frame)(AVVorbisParseContext*, const uint8_t*, int) { nullptr };
+    void (*reset)(AVVorbisParseContext*) { nullptr };
+
+    VorbisAPI()
+    {
+        for (auto* name : { "libavcodec.so", "libavcodec.so.62", "libavcodec.so.61", "libavcodec.so.60", "libavcodec.so.59" }) {
+            auto* handle = dlopen(name, RTLD_LAZY | RTLD_LOCAL);
+            if (!handle)
+                continue;
+            init = reinterpret_cast<decltype(init)>(dlsym(handle, "av_vorbis_parse_init"));
+            free = reinterpret_cast<decltype(free)>(dlsym(handle, "av_vorbis_parse_free"));
+            frame = reinterpret_cast<decltype(frame)>(dlsym(handle, "av_vorbis_parse_frame"));
+            reset = reinterpret_cast<decltype(reset)>(dlsym(handle, "av_vorbis_parse_reset"));
+            if (init && free && frame && reset)
+                return; // Keep the library loaded while contexts may exist.
+            dlclose(handle);
+        }
+        init = nullptr;
+    }
+    static const VorbisAPI& singleton()
+    {
+        static const VorbisAPI api;
+        return api;
+    }
+};
+
+struct VorbisDeleter {
+    void operator()(AVVorbisParseContext* context) const { VorbisAPI::singleton().free(&context); }
+};
+
+class Reader final : public webm::Reader {
+public:
+    void set(const uint8_t* data, size_t size) { m_data = data; m_size = size; }
+    Status Read(size_t requested, uint8_t* out, uint64_t* count) final
+    {
+        size_t amount = std::min(requested, m_size);
+        if (amount)
+            std::memcpy(out, m_data, amount);
+        return Skip(requested, count);
+    }
+    Status Skip(uint64_t requested, uint64_t* count) final
+    {
+        *count = std::min<uint64_t>(requested, m_size);
+        if (!*count)
+            return Status(Status::kWouldBlock);
+        m_data += *count;
+        m_size -= *count;
+        m_position += *count;
+        return Status(*count == requested ? Status::kOkCompleted : Status::kOkPartial);
+    }
+    uint64_t Position() const final { return m_position; }
+    bool empty() const { return !m_size; }
+private:
+    const uint8_t* m_data { nullptr };
+    size_t m_size { 0 };
+    uint64_t m_position { 0 };
+};
+
+uint32_t littleEndian32(const uint8_t* data)
+{
+    return uint32_t(data[0]) | uint32_t(data[1]) << 8 | uint32_t(data[2]) << 16 | uint32_t(data[3]) << 24;
+}
+
+// Round to the nearest track tick, using wide arithmetic so hostile timecodes
+// cannot wrap around to plausible negative presentation times.
+std::optional<int64_t> trackTime(__int128 nanoseconds, uint32_t scale)
+{
+    auto ticks = nanoseconds * scale;
+    ticks = (ticks + (ticks < 0 ? -500000000 : 500000000)) / nanosecondsPerSecond;
+    if (ticks < INT64_MIN || ticks > INT64_MAX)
+        return std::nullopt;
+    return static_cast<int64_t>(ticks);
+}
+
+} // namespace
+
+class Parser::Impl final : public webm::Callback {
+public:
+    explicit Impl(Parser& owner) : m_owner(owner) { }
+
+    bool append(const uint8_t* data, size_t size)
+    {
+        if (m_failed || (!data && size) || size > UINT64_MAX - m_reader.Position() - 1)
+            return false;
+        m_reader.set(data, size);
+        auto status = m_parser.Feed(this, &m_reader);
+        m_failed = m_failed || (!status.ok() && status.code != Status::kWouldBlock) || !m_reader.empty();
+        // The reader never retains caller-owned append data.
+        m_reader.set(nullptr, 0);
+        if (m_failed) {
+            m_frames.clear();
+            m_frame.clear();
+            for (auto& [id, track] : m_tracks)
+                track.pending.reset();
+        }
+        return !m_failed;
+    }
+
+    void flushPendingSamples()
+    {
+        if (m_failed)
+            return;
+        for (auto& [id, track] : m_tracks)
+            emitPending(track);
+    }
+
+    void reset()
+    {
+        m_parser.DidSeek();
+        m_reader = Reader();
+        m_failed = false;
+        m_frames.clear();
+        m_frame.clear();
+        m_inGroup = false;
+        m_blockActive = false;
+        m_haveCluster = false;
+        m_pendingTracks.clear();
+        m_initializing = false;
+        m_haveInfo = m_haveInit;
+        for (auto& [id, track] : m_tracks) {
+            track.pending.reset();
+            track.lastEnd.reset();
+            track.sawPacket = false;
+            track.preSkipRemaining = 0;
+            if (track.vorbis)
+                VorbisAPI::singleton().reset(track.vorbis.get());
+        }
+    }
+
+private:
+    struct Track {
+        SummitMP4::TrackInfo info;
+        uint64_t codecDelay { 0 };
+        uint32_t defaultDuration { 0 };
+        uint32_t lastDuration { 0 };
+        uint32_t preSkipRemaining { 0 };
+        bool sawPacket { false };
+        std::optional<int64_t> lastEnd;
+        std::optional<SummitMP4::Sample> pending;
+        std::unique_ptr<AVVorbisParseContext, VorbisDeleter> vorbis;
+    };
+
+    Status OnElementBegin(const webm::ElementMetadata& metadata, webm::Action* action) final
+    {
+        using webm::Id;
+        *action = webm::Action::kRead;
+        // These sections don't participate in the MSE byte stream. Skip
+        // them without allocating their bodies, regardless of their size.
+        switch (metadata.id) {
+        case Id::kCues:
+        case Id::kChapters:
+        case Id::kTags:
+        case Id::kSeekHead:
+        case Id::kVoid:
+            *action = webm::Action::kSkip;
+            return ok;
+        case Id::kContentEncodings:
+            return invalid; // WebM encryption/compression is not MP4 CENC.
+        case Id::kSegment:
+        case Id::kCluster:
+            return ok; // Unknown-length live segments/clusters are valid.
+        case Id::kSimpleBlock:
+        case Id::kBlockGroup:
+        case Id::kBlock:
+            if (metadata.size > maximumBlockSize)
+                return invalid;
+            // libwebm retains block metadata until the Cluster ends. Bound
+            // the count even for a malicious unknown-length Cluster.
+            if (++m_clusterElements > 65536)
+                return invalid;
+            return ok;
+        case Id::kTracks:
+            if (!m_haveInfo || !m_initializing)
+                return invalid;
+            break;
+        default:
+            break;
+        }
+        return metadata.size <= maximumHeaderSize ? ok : invalid;
+    }
+
+    Status OnEbml(const webm::ElementMetadata&, const webm::Ebml& ebml) final
+    {
+        if (ebml.doc_type.value() != "webm" || ebml.ebml_read_version.value() != 1
+            || ebml.doc_type_read_version.value() > 4 || ebml.ebml_max_id_length.value() > 4
+            || ebml.ebml_max_size_length.value() > 8)
+            return invalid;
+        flushPendingSamples();
+        m_pendingTracks.clear();
+        m_initializing = true;
+        m_haveEbml = true;
+        m_haveInfo = m_haveCluster = false;
+        m_duration = 0;
+        return ok;
+    }
+
+    Status OnSegmentBegin(const webm::ElementMetadata&, webm::Action* action) final
+    {
+        *action = webm::Action::kRead;
+        return m_haveEbml ? ok : invalid;
+    }
+
+    Status OnInfo(const webm::ElementMetadata&, const webm::Info& info) final
+    {
+        if (!m_haveEbml || m_haveInfo || !info.timecode_scale.value() || info.timecode_scale.value() > nanosecondsPerSecond)
+            return invalid;
+        m_pendingTimecodeScale = info.timecode_scale.value();
+        if (info.duration.is_present()) {
+            auto duration = info.duration.value() * m_pendingTimecodeScale / 1000.0;
+            if (!std::isfinite(duration) || duration < 0 || duration >= double(INT64_MAX))
+                return invalid;
+            m_duration = static_cast<uint64_t>(duration);
+        }
+        m_haveInfo = true;
+        return ok;
+    }
+
+    Status OnTrackEntry(const webm::ElementMetadata&, const webm::TrackEntry& entry) final
+    {
+        if (!m_haveInfo || !m_initializing || m_pendingTracks.size() >= 32 || !entry.track_number.value()
+            || entry.track_number.value() > UINT32_MAX || m_pendingTracks.count(entry.track_number.value()))
+            return invalid;
+        Track track;
+        auto& info = track.info;
+        info.id = entry.track_number.value();
+        info.codecConfig = entry.codec_private.value();
+        track.codecDelay = entry.codec_delay.value();
+        if (track.codecDelay > nanosecondsPerSecond * 60)
+            return invalid;
+        auto& codec = entry.codec_id.value();
+        if (entry.track_type.value() == webm::TrackType::kVideo) {
+            info.kind = SummitMP4::TrackInfo::Kind::Video;
+            info.timescale = 1000000;
+            auto& video = entry.video.value();
+            if (!video.pixel_width.value() || video.pixel_width.value() > 16384
+                || !video.pixel_height.value() || video.pixel_height.value() > 16384)
+                return invalid;
+            info.width = video.pixel_width.value();
+            info.height = video.pixel_height.value();
+            if (codec == "V_VP8")
+                info.codec = "vp08";
+            else if (codec == "V_VP9")
+                info.codec = "vp09";
+            else if (codec == "V_AV1")
+                info.codec = "av01";
+            else
+                return invalid;
+            if (codec != "V_AV1")
+                info.codecConfig.clear();
+        } else if (entry.track_type.value() == webm::TrackType::kAudio) {
+            info.kind = SummitMP4::TrackInfo::Kind::Audio;
+            info.packetTimedAudio = true;
+            const auto& audio = entry.audio.value();
+            auto rate = audio.sampling_frequency.value();
+            if (!std::isfinite(rate) || rate < 8000 || rate > 192000 || std::floor(rate) != rate
+                || !audio.channels.value() || audio.channels.value() > 8)
+                return invalid;
+            info.channels = audio.channels.value();
+            info.sampleRate = info.timescale = rate;
+            if (entry.seek_pre_roll.value() > nanosecondsPerSecond * 60)
+                return invalid;
+            info.seekPreRoll = std::max<uint64_t>(80000000, entry.seek_pre_roll.value());
+            const auto& config = info.codecConfig;
+            if (codec == "A_OPUS") {
+                if (config.size() < 19 || std::memcmp(config.data(), "OpusHead", 8) || config[8] > 15 || config[9] != info.channels)
+                    return invalid;
+                if (!config[18]) {
+                    if (info.channels > 2 || config.size() != 19)
+                        return invalid;
+                } else {
+                    if (config.size() != 21 + info.channels || !config[19] || config[20] > config[19]
+                        || unsigned(config[19]) + config[20] > 255)
+                        return invalid;
+                    for (size_t i = 21; i < config.size(); ++i) {
+                        if (config[i] != 255 && config[i] >= unsigned(config[19]) + config[20])
+                            return invalid;
+                    }
+                }
+                info.codec = "Opus";
+                info.sampleRate = info.timescale = 48000;
+            } else if (codec == "A_VORBIS") {
+                // CodecPrivate contains three Xiph-laced Vorbis headers.
+                // Check the identification header against the container;
+                // libavcodec then validates the complete setup and modes.
+                size_t offset = 1;
+                size_t lengths[2] { };
+                if (config.empty() || config[0] != 2 || !Parser::supportsVorbis())
+                    return invalid;
+                for (auto& length : lengths) {
+                    uint8_t byte;
+                    do {
+                        if (offset >= config.size())
+                            return invalid;
+                        byte = config[offset++];
+                        length += byte;
+                    } while (byte == 255);
+                }
+                if (lengths[0] < 30 || lengths[0] + lengths[1] >= config.size() - offset
+                    || config[offset] != 1 || std::memcmp(config.data() + offset + 1, "vorbis", 6)
+                    || config[offset + 11] != info.channels || littleEndian32(config.data() + offset + 12) != info.sampleRate)
+                    return invalid;
+                track.vorbis.reset(VorbisAPI::singleton().init(config.data(), config.size()));
+                if (!track.vorbis)
+                    return invalid;
+                info.codec = "vorb";
+            } else
+                return invalid;
+        } else
+            return invalid;
+        if (entry.default_duration.is_present()) {
+            auto duration = trackTime(entry.default_duration.value(), info.timescale);
+            if (!duration || *duration <= 0 || *duration > UINT32_MAX)
+                return invalid;
+            track.defaultDuration = *duration;
+        }
+        auto trackID = info.id;
+        m_pendingTracks.emplace(trackID, std::move(track));
+        return ok;
+    }
+
+    Status OnElementEnd(const webm::ElementMetadata& metadata) final
+    {
+        if (metadata.id != webm::Id::kTracks)
+            return ok;
+        if (m_pendingTracks.empty() || !m_initializing) {
+            m_failed = true; // libwebm does not propagate OnElementEnd errors.
+            return invalid;
+        }
+        m_tracks = std::move(m_pendingTracks);
+        m_pendingTracks.clear();
+        m_timecodeScale = m_pendingTimecodeScale;
+        m_initializing = false;
+        SummitMP4::InitSegment init;
+        init.movieTimescale = 1000000;
+        init.duration = m_duration;
+        for (auto& [id, track] : m_tracks)
+            init.tracks.push_back(track.info);
+        m_haveInit = true;
+        if (m_owner.onInitSegment)
+            m_owner.onInitSegment(std::move(init));
+        return ok;
+    }
+
+    Status OnClusterBegin(const webm::ElementMetadata&, const webm::Cluster& cluster, webm::Action* action) final
+    {
+        *action = webm::Action::kRead;
+        if (!m_haveInit || m_initializing || !cluster.timecode.is_present())
+            return invalid;
+        m_clusterTime = cluster.timecode.value();
+        m_clusterElements = 0;
+        m_haveCluster = true;
+        return ok;
+    }
+
+    Status beginBlock(const webm::Block& block, webm::Action* action)
+    {
+        *action = webm::Action::kRead;
+        if (!m_haveCluster || m_blockActive || block.track_number > UINT32_MAX || !m_tracks.count(block.track_number) || block.num_frames < 1 || block.num_frames > 256)
+            return invalid;
+        m_block = block;
+        m_blockActive = true;
+        m_frames.clear();
+        m_frame.clear();
+        m_blockBytes = 0;
+        return ok;
+    }
+
+    Status OnSimpleBlockBegin(const webm::ElementMetadata&, const webm::SimpleBlock& block, webm::Action* action) final
+    {
+        if (m_inGroup)
+            return invalid;
+        m_keyframe = block.is_key_frame;
+        return beginBlock(block, action);
+    }
+    Status OnBlockGroupBegin(const webm::ElementMetadata&, webm::Action* action) final
+    {
+        if (m_inGroup || m_blockActive)
+            return invalid;
+        *action = webm::Action::kRead;
+        m_inGroup = true;
+        return ok;
+    }
+    Status OnBlockBegin(const webm::ElementMetadata&, const webm::Block& block, webm::Action* action) final
+    {
+        return m_inGroup ? beginBlock(block, action) : invalid;
+    }
+    Status OnFrame(const webm::FrameMetadata& metadata, webm::Reader* reader, uint64_t* remaining) final
+    {
+        if (!m_blockActive || !metadata.size || metadata.size > maximumFrameSize || *remaining > metadata.size)
+            return invalid;
+        if (m_frame.empty()) {
+            if (m_frames.size() >= size_t(m_block.num_frames) || metadata.size > maximumBlockSize - m_blockBytes)
+                return invalid;
+            m_frame.resize(metadata.size);
+            m_blockBytes += metadata.size;
+        }
+        while (*remaining) {
+            uint64_t count = 0;
+            auto status = reader->Read(*remaining, m_frame.data() + metadata.size - *remaining, &count);
+            *remaining -= count;
+            if (!status.ok())
+                return status;
+        }
+        m_frames.push_back(std::move(m_frame));
+        m_frame.clear();
+        return ok;
+    }
+    Status OnSimpleBlockEnd(const webm::ElementMetadata&, const webm::SimpleBlock&) final
+    {
+        return finishBlock(0, 0);
+    }
+    Status OnBlockGroupEnd(const webm::ElementMetadata&, const webm::BlockGroup& group) final
+    {
+        if (!m_inGroup || !group.block.is_present())
+            return invalid;
+        m_inGroup = false;
+        m_keyframe = group.references.empty();
+        return finishBlock(group.duration.value(), group.discard_padding.value());
+    }
+
+    Status finishBlock(uint64_t blockDuration, int64_t padding)
+    {
+        if (!m_blockActive || m_frames.size() != size_t(m_block.num_frames))
+            return invalid;
+        m_blockActive = false;
+        auto& track = m_tracks.at(m_block.track_number);
+        auto& info = track.info;
+        auto timestamp = trackTime((__int128(m_clusterTime) + m_block.timecode) * m_timecodeScale - track.codecDelay, info.timescale);
+        auto explicitDuration = trackTime(__int128(blockDuration) * m_timecodeScale, info.timescale);
+        auto discard = trackTime(padding, info.timescale);
+        if (!timestamp || !explicitDuration || *explicitDuration > UINT32_MAX || !discard || *discard < -int64_t(UINT32_MAX) || *discard > UINT32_MAX)
+            return invalid;
+        bool audio = info.kind == SummitMP4::TrackInfo::Kind::Audio;
+        if (!track.sawPacket && info.codec == "Opus") {
+            // OpusHead pre-skip applies at the encoded stream's beginning.
+            // Seeking straight to a later Cluster must not consume it again.
+            if ((__int128(m_clusterTime) + m_block.timecode) * m_timecodeScale == 0)
+                track.preSkipRemaining = uint32_t(info.codecConfig[10]) | uint32_t(info.codecConfig[11]) << 8;
+        }
+        track.sawPacket = true;
+        // WebM timestamps are often quantized to 1 ms. Continue the precise
+        // audio sample clock across rounding-sized gaps/overlaps, while
+        // retaining actual discontinuities and out-of-order appends.
+        if (audio && track.lastEnd && (*timestamp >= *track.lastEnd ? __int128(*timestamp) - *track.lastEnd : __int128(*track.lastEnd) - *timestamp) <= (__int128(m_timecodeScale) * info.timescale / nanosecondsPerSecond + 1))
+            timestamp = track.lastEnd;
+        std::vector<uint32_t> durations;
+        durations.reserve(m_frames.size());
+        uint64_t remainingDuration = 0;
+        for (auto& bytes : m_frames) {
+            int64_t duration = *explicitDuration ? *explicitDuration / m_frames.size() : track.defaultDuration;
+            if (info.codec == "Opus") {
+                unsigned char toc;
+                const unsigned char* frames[48];
+                opus_int16 sizes[48];
+                int payload;
+                // The public packet parser accepts a single Opus stream.
+                // Surround packets concatenate self-delimited streams and
+                // can exceed that API's 1275-byte per-frame limit. Their
+                // first TOC still gives the duration; the decoder validates
+                // each stream's payload and channel mapping.
+                if (!info.codecConfig[18] && opus_packet_parse(bytes.data(), bytes.size(), &toc, frames, sizes, &payload) < 0)
+                    return invalid;
+                duration = opus_packet_get_nb_samples(bytes.data(), bytes.size(), 48000);
+            } else if (track.vorbis)
+                duration = VorbisAPI::singleton().frame(track.vorbis.get(), bytes.data(), bytes.size());
+            if (duration < 0 || duration > UINT32_MAX)
+                return invalid;
+            durations.push_back(duration);
+            remainingDuration += duration;
+        }
+        uint64_t discardStart = audio && *discard < 0 ? -*discard : 0;
+        uint64_t discardEnd = audio && *discard > 0 ? *discard : 0;
+        if (discardStart + discardEnd + std::min<uint64_t>(track.preSkipRemaining, remainingDuration) > remainingDuration)
+            return invalid;
+        for (size_t index = 0; index < m_frames.size(); ++index) {
+            auto& bytes = m_frames[index];
+            uint32_t duration = durations[index];
+            remainingDuration -= duration;
+            if (*timestamp > INT64_MAX - duration)
+                return invalid;
+            if (track.pending) {
+                auto difference = __int128(*timestamp) - track.pending->presentationTime;
+                if (difference > 0 && difference <= UINT32_MAX)
+                    track.pending->duration = static_cast<uint32_t>(difference);
+                emitPending(track);
+            }
+            SummitMP4::Sample sample;
+            sample.trackID = info.id;
+            sample.decodeTime = sample.presentationTime = *timestamp;
+            sample.duration = duration;
+            sample.isSync = audio || m_keyframe;
+            sample.data = std::move(bytes);
+            // Keep coded duration and presentation timestamps intact. The
+            // audio renderer consumes these trims after decoding the packet.
+            sample.trimStart = std::min(track.preSkipRemaining, sample.duration);
+            track.preSkipRemaining -= sample.trimStart;
+            uint32_t start = std::min<uint64_t>(discardStart, duration - sample.trimStart);
+            sample.trimStart += start;
+            discardStart -= start;
+            if (discardEnd > remainingDuration)
+                sample.trimEnd = std::min<uint64_t>(duration, discardEnd - remainingDuration);
+            if (uint64_t(sample.trimStart) + sample.trimEnd > sample.duration)
+                return invalid;
+            if (!audio && !duration) {
+                track.pending = std::move(sample);
+                // Laced video requires timing for the individual frames.
+                if (m_frames.size() > 1)
+                    return invalid;
+            } else if (m_owner.onSample)
+                m_owner.onSample(std::move(sample));
+            *timestamp += duration;
+        }
+        track.lastEnd = *timestamp;
+        m_frames.clear();
+        return ok;
+    }
+
+    void emitPending(Track& track)
+    {
+        if (!track.pending)
+            return;
+        auto sample = std::move(*track.pending);
+        track.pending.reset();
+        if (!sample.duration)
+            sample.duration = track.defaultDuration ? track.defaultDuration : track.lastDuration ? track.lastDuration : 33333;
+        track.lastDuration = sample.duration;
+        if (m_owner.onSample)
+            m_owner.onSample(std::move(sample));
+    }
+
+    Parser& m_owner;
+    webm::WebmParser m_parser;
+    Reader m_reader;
+    std::map<uint32_t, Track> m_tracks;
+    std::map<uint32_t, Track> m_pendingTracks;
+    uint64_t m_pendingTimecodeScale { 1000000 };
+    uint64_t m_timecodeScale { 1000000 };
+    uint64_t m_clusterTime { 0 };
+    uint64_t m_duration { 0 };
+    uint32_t m_clusterElements { 0 };
+    webm::Block m_block { };
+    std::vector<std::vector<uint8_t>> m_frames;
+    std::vector<uint8_t> m_frame;
+    size_t m_blockBytes { 0 };
+    bool m_failed { false };
+    bool m_initializing { false };
+    bool m_haveEbml { false };
+    bool m_haveInfo { false };
+    bool m_haveInit { false };
+    bool m_haveCluster { false };
+    bool m_inGroup { false };
+    bool m_blockActive { false };
+    bool m_keyframe { false };
+};
+
+Parser::Parser() : m_impl(std::make_unique<Impl>(*this)) { }
+Parser::~Parser() = default;
+bool Parser::append(const uint8_t* data, size_t size) { return m_impl->append(data, size); }
+void Parser::flushPendingSamples() { m_impl->flushPendingSamples(); }
+void Parser::reset() { m_impl->reset(); }
+bool Parser::supportsVorbis() { return VorbisAPI::singleton().init; }
+
+} // namespace SummitWebM
