diff --git a/Source/WebCore/Modules/webhid/HID.cpp b/Source/WebCore/Modules/webhid/HID.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2149ba8bc0cc03e7a96fa7037f006a4c2de57285
--- /dev/null
+++ b/Source/WebCore/Modules/webhid/HID.cpp
@@ -0,0 +1,224 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "HID.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "HIDConnectionEvent.h"
+#include "HIDInputReportEvent.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMConvertSequences.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSHIDDevice.h"
+#include "LocalDOMWindow.h"
+#include "USB.h"
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(HID);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(HIDConnectionEvent);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(HIDInputReportEvent);
+
+Ref<HID> HID::create(Document& document)
+{
+    auto result = adoptRef(*new HID(document));
+    result->suspendIfNeeded();
+    return result;
+}
+HID::HID(Document& document)
+    : ActiveDOMObject(&document), m_pollTimer(*this, &HID::pollDevices) { }
+HID::~HID() = default;
+Document* HID::document() const { return dynamicDowncast<Document>(scriptExecutionContext()); }
+
+void HID::perform(Document* document, Ref<JSON::Object>&& arguments, Vector<uint8_t>&& bytes, Completion&& completion)
+{
+    // The same document checks, request channel and browser-side origin
+    // policy as WebUSB.
+    arguments->setString("api"_s, "hid"_s);
+    USB::perform(document, WTF::move(arguments), WTF::move(bytes), WTF::move(completion));
+}
+
+Ref<HIDDevice> HID::device(Ref<JSON::Object>&& data)
+{
+    m_devices.removeIf([&](auto& entry) {
+        if (!entry.value->forgotten())
+            return false;
+        m_connected.remove(entry.key);
+        return true;
+    });
+    auto id = data->getString("id"_s);
+    if (!m_stopped && !m_pollTimer.isActive())
+        m_pollTimer.startRepeating(2_s);
+    if (auto it = m_devices.find(id); it != m_devices.end()) {
+        it->value->update(WTF::move(data));
+        return it->value.copyRef();
+    }
+    auto value = HIDDevice::create(*document(), WTF::move(data));
+    m_devices.add(id, value.copyRef());
+    return value;
+}
+
+Vector<Ref<HIDDevice>> HID::devices(const JSON::Object& result)
+{
+    Vector<Ref<HIDDevice>> list;
+    if (auto values = result.getArray("devices"_s)) {
+        for (auto& value : *values) {
+            auto data = value->asObject();
+            if (!data || data->getString("id"_s).isEmpty())
+                continue;
+            auto item = device(data.releaseNonNull());
+            m_connected.add(item->identifier());
+            list.append(WTF::move(item));
+        }
+    }
+    return list;
+}
+
+void HID::getDevices(DOMPromiseDeferred<IDLSequence<IDLInterface<HIDDevice>>>&& promise)
+{
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "getDevices"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        if (m_stopped) {
+            promise.resolve({ });
+            return;
+        }
+        promise.resolve(devices(response.releaseReturnValue()));
+    });
+}
+
+static RefPtr<JSON::Array> filtersJSON(const Vector<HIDDeviceFilter>& filters)
+{
+    if (filters.size() > 64)
+        return nullptr;
+    auto result = JSON::Array::create();
+    for (auto& filter : filters) {
+        // A filter needs at least one member; a product needs its vendor and
+        // a usage its usage page.
+        if ((!filter.vendorId && !filter.productId && !filter.usagePage && !filter.usage)
+            || (filter.productId && !filter.vendorId) || (filter.usage && !filter.usagePage)
+            || (filter.vendorId && *filter.vendorId > 0xffff))
+            return nullptr;
+        auto value = JSON::Object::create();
+        if (filter.vendorId) value->setInteger("vendorId"_s, *filter.vendorId);
+        if (filter.productId) value->setInteger("productId"_s, *filter.productId);
+        if (filter.usagePage) value->setInteger("usagePage"_s, *filter.usagePage);
+        if (filter.usage) value->setInteger("usage"_s, *filter.usage);
+        result->pushObject(WTF::move(value));
+    }
+    return result;
+}
+
+void HID::requestDevice(HIDDeviceRequestOptions&& options, DOMPromiseDeferred<IDLSequence<IDLInterface<HIDDevice>>>&& promise)
+{
+    auto filters = filtersJSON(options.filters);
+    auto exclusions = filtersJSON(options.exclusionFilters);
+    if (!filters || !exclusions) {
+        promise.reject(ExceptionCode::TypeError, "Invalid HID device filter"_s);
+        return;
+    }
+    RefPtr doc = document();
+    if (!doc || !doc->window() || !doc->window()->hasTransientActivation()) {
+        promise.reject(ExceptionCode::SecurityError, "Choosing a HID device requires a user gesture"_s);
+        return;
+    }
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "requestDevice"_s);
+    args->setArray("filters"_s, filters.releaseNonNull());
+    args->setArray("exclusionFilters"_s, exclusions.releaseNonNull());
+    perform(doc.get(), WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        if (m_stopped) {
+            promise.resolve({ });
+            return;
+        }
+        promise.resolve(devices(response.releaseReturnValue()));
+    });
+}
+
+void HID::eventListenersDidChange()
+{
+    bool listening = hasEventListeners(eventNames().connectEvent) || hasEventListeners(eventNames().disconnectEvent);
+    if (listening && !m_stopped && !m_pollTimer.isActive())
+        m_pollTimer.startRepeating(2_s);
+    else if (!listening && m_devices.isEmpty())
+        m_pollTimer.stop();
+}
+bool HID::virtualHasPendingActivity() const
+{
+    if (m_stopped)
+        return false;
+    if (hasEventListeners())
+        return true;
+    return std::ranges::any_of(m_devices.values(), [](auto& device) { return device->opened(); });
+}
+void HID::suspend(ReasonForSuspension) { m_pollTimer.stop(); }
+void HID::resume() { eventListenersDidChange(); }
+void HID::stop()
+{
+    m_stopped = true;
+    m_pollTimer.stop();
+    for (auto& entry : m_devices)
+        entry.value->disconnected();
+    m_connected.clear();
+    // The browser process independently closes devices when a page navigates
+    // or closes.
+}
+void HID::pollDevices()
+{
+    if (m_polling || m_stopped)
+        return;
+    m_polling = true;
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "getDevices"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }](auto&& response, auto&&) mutable {
+        m_polling = false;
+        if (response.hasException() || m_stopped)
+            return;
+        HashSet<String> connected;
+        Vector<Ref<Event>> events;
+        auto result = response.releaseReturnValue();
+        if (auto values = result->getArray("devices"_s)) {
+            for (auto& value : *values) {
+                auto data = value->asObject();
+                if (!data || data->getString("id"_s).isEmpty())
+                    continue;
+                auto item = device(data.releaseNonNull());
+                auto id = item->identifier();
+                connected.add(id);
+                if (!m_connected.contains(id)) {
+                    HIDConnectionEvent::Init init { { }, item.copyRef() };
+                    events.append(HIDConnectionEvent::create(eventNames().connectEvent, WTF::move(init), Event::IsTrusted::Yes));
+                }
+            }
+        }
+        for (auto& id : m_connected) {
+            if (connected.contains(id))
+                continue;
+            if (auto it = m_devices.find(id); it != m_devices.end()) {
+                it->value->disconnected();
+                HIDConnectionEvent::Init init { { }, it->value.copyRef() };
+                events.append(HIDConnectionEvent::create(eventNames().disconnectEvent, WTF::move(init), Event::IsTrusted::Yes));
+            }
+        }
+        m_connected = WTF::move(connected);
+        // A listener may navigate or stop this object. Finish updating the
+        // device map before invoking page code, and iterate a separate list.
+        for (auto& event : events) {
+            if (m_stopped)
+                break;
+            dispatchEvent(event);
+        }
+    });
+}
+} // namespace WebCore
+#endif
