+void WebExtensionContext::sidebarActionHaiku(const String& method, const String& argumentsJSON, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    auto apiName = makeString("sidebarAction."_s, method, "()"_s);
+    static constexpr std::array methods { "open"_s, "close"_s, "toggle"_s, "isOpen"_s, "setPanel"_s, "getPanel"_s, "setTitle"_s, "getTitle"_s };
+    RefPtr manifest = protect(extension())->manifestObject();
+    if (std::ranges::find(methods, method) == methods.end() || !manifest || !manifest->getObject("sidebar_action"_s)) {
+        completion(toWebExtensionError(apiName, nullString(), "the extension has no sidebar_action"_s));
+        return;
+    }
+    RefPtr arguments = JSON::Value::parseJSON(argumentsJSON);
+    RefPtr object = arguments ? arguments->asObject() : nullptr;
+    if (!object) {
+        completion(toWebExtensionError(apiName, "details"_s, "an object is expected"_s));
+        return;
+    }
+    // A panel is a page of the extension (null resets it to the default).
+    if (RefPtr panel = object->getValue("panel"_s); panel && panel->type() != JSON::Value::Type::Null) {
+        URL url { baseURL(), panel->asString() };
+        if (panel->asString().isEmpty() || !url.isValid() || url.protocol() != baseURL().protocol() || url.host() != baseURL().host()) {
+            completion(toWebExtensionError(apiName, "panel"_s, "it is not a page of the extension"_s));
+            return;
+        }
+        object->setString("panel"_s, url.string());
+    }
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    if (message.AddUInt32("command", B_WEBKIT_BROWSER_SIDEBAR) != B_OK || message.AddString("method", method.utf8().legacyCStringPointer()) != B_OK
+        || message.AddString("arguments", object->toJSONString().utf8().legacyCStringPointer()) != B_OK) {
+        completion(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+        return;
+    }
+    // The window named, or the window of the tab named (the browser keeps
+    // one sidebar a window); otherwise the host's front window.
+    RefPtr<WebExtensionWindow> window;
+    if (auto windowId = object->getDouble("windowId"_s)) {
+        auto identifier = toWebExtensionWindowIdentifier(*windowId);
+        window = identifier ? getWindow(*identifier) : nullptr;
+        if (!window) {
+            completion(toWebExtensionError(apiName, "windowId"_s, "window not found"_s));
+            return;
+        }
+    } else if (auto tabId = object->getDouble("tabId"_s)) {
+        auto identifier = toWebExtensionTabIdentifier(*tabId);
+        RefPtr tab = identifier ? getTab(*identifier) : nullptr;
+        window = tab ? tab->window() : nullptr;
+        if (!window) {
+            completion(toWebExtensionError(apiName, "tabId"_s, "tab not found"_s));
+            return;
+        }
+    }
+    if (window && !addNativeBrowserCommandWindow(message, *window)) {
+        completion(toWebExtensionError(apiName, nullString(), "the window is not available in the browser"_s));
+        return;
+    }
+    sendNativeBrowserQueryHaiku(WTF::move(message), apiName, WTF::move(completion));
+}
