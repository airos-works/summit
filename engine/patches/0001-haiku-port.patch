+
+#include "config.h"
+#include "MediaTrackSeekHaiku.h"
+
+// The track's extractor, stream and position are private to BMediaTrack, and
+// this file alone sees them. It is compiled on its own, outside the unified
+// sources and the precompiled header, so MediaTrack.h is first read here,
+// through the media kit's plugin headers MediaExtractor.h includes. What those
+// include besides each other is read before, as it is.
+#include <MediaFormats.h>
+#include <SupportDefs.h>
+#define private public
+#include <private/media/MediaExtractor.h>
+#include <MediaTrack.h>
+#undef private
+
+namespace WebCore {
+
+// What BMediaTrack's seek does with a decoder, without one: the extractor
+// moves the stream and says where it landed.
+static status_t seekWithoutDecoder(BMediaTrack& track, uint32 seekTo, int64* frame, bigtime_t* time)
+{
+    if (track.fDecoder || !track.fExtractor)
+        return B_NO_INIT;
+    status_t status = track.fExtractor->Seek(track.fStream, seekTo, frame, time);
+    if (status != B_OK)
+        return status;
+    track.fCurrentFrame = *frame;
+    track.fCurrentTime = *time;
+    return B_OK;
+}
+
+status_t seekTrackToTimeHaiku(BMediaTrack& track, bigtime_t* time, int32 flags)
+{
+    status_t status = track.SeekToTime(time, flags);
+    if (status != B_NO_INIT || !time)
+        return status;
+    int64 frame = 0;
+    return seekWithoutDecoder(track, (flags & B_MEDIA_SEEK_DIRECTION_MASK) | B_MEDIA_SEEK_TO_TIME, &frame, time);
+}
+
+status_t seekTrackToFrameHaiku(BMediaTrack& track, int64* frame, int32 flags)
+{
+    status_t status = track.SeekToFrame(frame, flags);
+    if (status != B_NO_INIT || !frame)
+        return status;
+    bigtime_t time = 0;
+    return seekWithoutDecoder(track, (flags & B_MEDIA_SEEK_DIRECTION_MASK) | B_MEDIA_SEEK_TO_FRAME, frame, &time);
+}
+
+} // namespace WebCore
