+
+    void get(double groupId, Ref<WebExtensionCallbackHandler>&&);
+    void query(RefPtr<JSON::Value> queryInfo, Ref<WebExtensionCallbackHandler>&&);
+    void update(double groupId, RefPtr<JSON::Value> updateProperties, Ref<WebExtensionCallbackHandler>&&);
+    void move(double groupId, RefPtr<JSON::Value> moveProperties, Ref<WebExtensionCallbackHandler>&&);
+
+    WebExtensionAPIEvent& onCreated();
+    WebExtensionAPIEvent& onUpdated();
+    WebExtensionAPIEvent& onRemoved();
+    WebExtensionAPIEvent& onMoved();
+
+private:
+    RefPtr<WebExtensionAPIEvent> m_onCreated;
+    RefPtr<WebExtensionAPIEvent> m_onUpdated;
+    RefPtr<WebExtensionAPIEvent> m_onRemoved;
+    RefPtr<WebExtensionAPIEvent> m_onMoved;
+};
+
