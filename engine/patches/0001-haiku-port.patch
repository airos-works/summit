+        Ref sheet = API::UserStyleSheet::create(WebCore::UserStyleSheet { text, URL { }, { }, { }, UserContentInjectedFrames::InjectInAllFrames,
+            UserContentMatchParentFrame::Never, WebCore::UserStyleLevel::User }, API::ContentWorld::pageContentWorldSingleton());
+        controller->addUserStyleSheet(sheet.get());
+        sheets->set(WTF::move(controller), WTF::move(sheet));
+    });
