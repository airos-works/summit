+    Ref<MediaSampleHaiku> withClearBytes(std::vector<uint8_t>&& bytes) const
+    {
+        return create(HaikuSampleData::create(WTF::move(bytes)), m_configuration.copyRef(), m_trackID, m_presentationTime, m_decodeTime, m_duration, m_flags, m_trimStart, m_trimEnd);
+    }
+
+private:
+    MediaSampleHaiku(Ref<HaikuSampleData>&&, Ref<HaikuTrackConfiguration>&&, TrackID, const MediaTime&, const MediaTime&, const MediaTime&, SampleFlags, const MediaTime&, const MediaTime&);
+
+    const Ref<HaikuSampleData> m_data;
+    const Ref<HaikuTrackConfiguration> m_configuration;
+    TrackID m_trackID;
+    MediaTime m_presentationTime;
+    MediaTime m_decodeTime;
+    MediaTime m_duration;
+    SampleFlags m_flags;
+    MediaTime m_trimStart;
+    MediaTime m_trimEnd;
+};
