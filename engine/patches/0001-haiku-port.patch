+
+namespace WebKit {
+struct WebColorPickerHaiku::CompletionState {
+    // Only read, invoked or cleared on the WebKit main thread.
+    Function<void(std::optional<rgb_color>)> callback;
+};
+Ref<WebColorPickerHaiku> WebColorPickerHaiku::create(WebPageProxy& page, std::shared_ptr<WebViewStateHaiku> state,
+    Vector<WebCore::Color>&& suggestions, std::optional<WebCore::FrameIdentifier> frame)
+{
+    return adoptRef(*new WebColorPickerHaiku(page, std::move(state), WTF::move(suggestions), frame));
+}
+WebColorPickerHaiku::WebColorPickerHaiku(WebPageProxy& page, std::shared_ptr<WebViewStateHaiku> state,
+    Vector<WebCore::Color>&& suggestions, std::optional<WebCore::FrameIdentifier> frame)
+    : WebColorPicker(&page.colorPickerClient(), frame), m_state(std::move(state)), m_suggestions(WTF::move(suggestions)) { }
+WebColorPickerHaiku::~WebColorPickerHaiku() { invalidate(); }
+void WebColorPickerHaiku::invalidate()
+{
+    ASSERT(RunLoop::isMain());
+    if (m_completion) m_completion->callback = nullptr;
+    m_completion = nullptr;
+    m_native = nullptr;
+}
+void WebColorPickerHaiku::endPicker()
+{
+    Ref protectedThis { *this };
+    invalidate();
+    WebColorPicker::endPicker();
+}
+void WebColorPickerHaiku::setSelectedColor(const WebCore::Color& color)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_native) m_native->setColor(color);
+}
+void WebColorPickerHaiku::showColorPicker(const WebCore::Color& color, const WebCore::IntRect& rect)
+{
+    ASSERT(RunLoop::isMain());
+    invalidate();
+    auto state = m_state.lock();
+    if (!client() || !state || state->closed) { endPicker(); return; }
+    WebViewGeometryHaiku geometry;
+    { std::lock_guard lock(state->mutex); geometry = state->geometry; }
+    if (!geometry.attached || !geometry.visible) { endPicker(); return; }
+    // elementRect is in root-view coordinates, already accounting for zoom.
+    BRect anchor(geometry.screenOrigin.x() + rect.x(), geometry.screenOrigin.y() + rect.y(),
+        geometry.screenOrigin.x() + static_cast<double>(rect.maxX()), geometry.screenOrigin.y() + static_cast<double>(rect.maxY()));
+    if (!anchor.IsValid() || !std::isfinite(anchor.left) || !std::isfinite(anchor.top)
+        || !std::isfinite(anchor.right) || !std::isfinite(anchor.bottom)) { endPicker(); return; }
+    std::vector<rgb_color> suggestions;
+    // Keep author-provided suggestions within one reasonable native row.
+    for (auto& suggestion : m_suggestions) {
+        if (suggestions.size() == 10) break;
+        suggestions.push_back(suggestion);
+    }
+    m_completion = std::make_shared<CompletionState>();
+    m_completion->callback = [this](std::optional<rgb_color> selected) { complete(selected); };
+    m_native = std::make_unique<NativeColorPickerHaiku>(color, suggestions, anchor,
+        [completion = m_completion](std::optional<rgb_color> selected) {
+            RunLoop::mainSingleton().dispatch([completion, selected] {
+                if (auto callback = std::exchange(completion->callback, nullptr)) callback(selected);
+            });
+        });
+}
+void WebColorPickerHaiku::complete(std::optional<rgb_color> selected)
+{
+    ASSERT(RunLoop::isMain());
+    Ref protectedThis { *this };
+    auto state = m_state.lock();
+    if (selected && state && !state->closed) {
+        bool visible;
+        { std::lock_guard lock(state->mutex); visible = state->geometry.visible; }
+        if (visible) {
+            if (CheckedPtr client = this->client()) client->didChooseColor(WebCore::Color(*selected));
+        }
+    }
+    endPicker();
+}
+}
