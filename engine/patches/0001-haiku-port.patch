+    const int32_t m_windowToken;
+    const IntSize m_screenSize;
+    RefPtr<Thread> m_thread;
+    Lock m_lock;
+    Condition m_condition;
+    bool m_running WTF_GUARDED_BY_LOCK(m_lock) { false };
+    std::atomic<double> m_captureFrameRate { 15 };
