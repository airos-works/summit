+#pragma once
+
+#include "FragmentedMP4ParserHaiku.h"
+
+namespace SummitMPEGAudio {
+
+// MSE's audio/aac (ADTS) and audio/mpeg (Layer I/II/III) byte streams.
+// Metadata is skipped incrementally; frame bytes and header state are bounded.
+class Parser {
+public:
+    enum class Format { ADTS, MPEG };
+    explicit Parser(Format format) : m_format(format) { }
+    std::function<void(SummitMP4::InitSegment&&)> onInitSegment;
+    std::function<void(SummitMP4::Sample&&)> onSample;
+    bool append(const uint8_t*, size_t);
+    void reset();
+
+private:
+    enum class Result { Complete, NeedMore, Error };
+    Result parseOne();
+    Result parseADTS(SummitMP4::TrackInfo&, size_t& frameSize, uint32_t& duration);
+    Result parseMPEG(SummitMP4::TrackInfo&, size_t& frameSize, uint32_t& duration);
+    void emit(SummitMP4::TrackInfo&&, size_t frameSize, uint32_t duration);
+
+    const Format m_format;
+    std::vector<uint8_t> m_buffer;
+    size_t m_offset { 0 };
+    uint64_t m_skipBytes { 0 };
+    bool m_failed { false };
+    bool m_haveInit { false };
+    SummitMP4::TrackInfo m_track;
+    int64_t m_nextTimestamp { 0 };
+    uint32_t m_freeFormatHeader { 0 };
+    size_t m_freeFormatFrameSize { 0 }; // Excludes padding.
+};
+
+} // namespace SummitMPEGAudio
