+void WebExtensionContext::sessionsValueHaiku(uint8_t operation, std::optional<WebExtensionTabIdentifier> tabIdentifier, std::optional<WebExtensionWindowIdentifier> windowIdentifier, const String& key, const String& valueJSON, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    // The operations of WebExtensionAPISessions::value().
+    enum : uint8_t { Get, Set, Remove };
+    static constexpr std::array names { "getTabValue()"_s, "setTabValue()"_s, "removeTabValue()"_s, "getWindowValue()"_s, "setWindowValue()"_s, "removeWindowValue()"_s };
+    if (operation > Remove || tabIdentifier.has_value() == windowIdentifier.has_value() || !hasPermission("sessions"_s)) {
+        completion(toWebExtensionError("sessions"_s, nullString(), "permission denied"_s));
+        return;
+    }
+    auto apiName = makeString("sessions."_s, names[operation + (windowIdentifier ? 3 : 0)]);
+    String entry;
+    if (tabIdentifier) {
+        RefPtr tab = getTab(*tabIdentifier);
+        if (!tab || !tab->extensionHasAccess()) {
+            completion(toWebExtensionError(apiName, "tabId"_s, "tab not found"_s));
+            return;
+        }
+        entry = makeString('t', tabIdentifier->toUInt64(), ':', key);
+    } else {
+        RefPtr window = getWindow(*windowIdentifier);
+        if (!window || !window->extensionHasAccess()) {
+            completion(toWebExtensionError(apiName, "windowId"_s, "window not found"_s));
+            return;
+        }
+        entry = makeString('w', window->identifier().toUInt64(), ':', key);
+    }
+    if (operation == Get) {
+        completion(m_sessionValuesHaiku.get(entry));
+        return;
+    }
+    if (operation == Set) {
+        // Values of tabs and windows that have gone are dropped as they pile up.
+        if (!m_sessionValuesHaiku.contains(entry) && !(m_sessionValuesHaiku.size() % 256)) {
+            m_sessionValuesHaiku.removeIf([&](auto& item) {
+                auto identifier = parseInteger<uint64_t>(StringView { item.key }.substring(1, item.key.find(':') - 1));
+                if (!identifier)
+                    return true;
+                if (item.key[0] == 't') {
+                    auto tab = toWebExtensionTabIdentifier(static_cast<double>(*identifier));
+                    return !tab || !getTab(*tab);
+                }
+                auto window = toWebExtensionWindowIdentifier(static_cast<double>(*identifier));
+                return !window || !getWindow(*window);
+            });
+        }
+        if (valueJSON.length() > 1024 * 1024) {
+            completion(toWebExtensionError(apiName, "value"_s, "it is too large"_s));
+            return;
+        }
+        m_sessionValuesHaiku.set(entry, valueJSON);
+    } else
+        m_sessionValuesHaiku.remove(entry);
+    completion(String { });
+}
