+        { "SCRIPT"_s, "script"_s }, { "IMAGE"_s, "image"_s }, { "FONT"_s, "font"_s }, { "OBJECT"_s, "object"_s },
+        { "XMLHTTPREQUEST"_s, "xmlhttprequest"_s }, { "PING"_s, "ping"_s }, { "CSP_REPORT"_s, "csp_report"_s },
