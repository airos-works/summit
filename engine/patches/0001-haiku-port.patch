+}
+
+static const std::array<uint8_t, 4> startCode { 0, 0, 0, 1 };
+
+// An avcC record (ISO 14496-15): the NAL length size and the parameter sets.
+struct AVCConfiguration {
+    unsigned lengthSize { 4 };
+    Vector<uint8_t> parameterSets; // Annex B
+};
+
+static std::optional<AVCConfiguration> parseAVCConfiguration(std::span<const uint8_t> record)
+{
+    if (record.size() < 7 || record[0] != 1)
+        return std::nullopt;
+    AVCConfiguration configuration;
+    configuration.lengthSize = (record[4] & 3) + 1;
+    size_t offset = 5;
+    for (int list = 0; list < 2; ++list) {
+        if (offset >= record.size())
+            return std::nullopt;
+        unsigned count = list ? record[offset] : record[offset] & 0x1f;
+        ++offset;
+        for (unsigned i = 0; i < count; ++i) {
+            if (offset + 2 > record.size())
+                return std::nullopt;
+            size_t length = (record[offset] << 8) | record[offset + 1];
+            offset += 2;
+            if (offset + length > record.size())
+                return std::nullopt;
+            configuration.parameterSets.append(std::span { startCode });
+            configuration.parameterSets.append(record.subspan(offset, length));
+            offset += length;
+        }
+    }
+    return configuration;
+}
+
+// An hvcC record (ISO 14496-15): the NAL length size and the parameter sets
+// (VPS, SPS, PPS and SEI arrays), as AVCConfiguration holds them.
+static std::optional<AVCConfiguration> parseHEVCConfiguration(std::span<const uint8_t> record)
+{
+    if (record.size() < 23 || record[0] != 1)
+        return std::nullopt;
+    AVCConfiguration configuration;
+    configuration.lengthSize = (record[21] & 3) + 1;
+    unsigned arrays = record[22];
+    size_t offset = 23;
+    for (unsigned array = 0; array < arrays; ++array) {
+        if (offset + 3 > record.size())
+            return std::nullopt;
+        unsigned count = (record[offset + 1] << 8) | record[offset + 2];
+        offset += 3;
+        for (unsigned i = 0; i < count; ++i) {
+            if (offset + 2 > record.size())
+                return std::nullopt;
+            size_t length = (record[offset] << 8) | record[offset + 1];
+            offset += 2;
+            if (offset + length > record.size())
+                return std::nullopt;
+            configuration.parameterSets.append(std::span { startCode });
+            configuration.parameterSets.append(record.subspan(offset, length));
+            offset += length;
+        }
+    }
+    return configuration;
+}
+
+// Length-prefixed NAL units (WebCodecs' "avc" format, and HEVC's) as Annex B.
+static std::optional<Vector<uint8_t>> annexBFromAVC(std::span<const uint8_t> data, const AVCConfiguration& configuration, bool keyFrame)
+{
+    Vector<uint8_t> result;
+    if (keyFrame)
+        result.append(configuration.parameterSets.span());
+    size_t offset = 0;
+    while (offset < data.size()) {
+        if (offset + configuration.lengthSize > data.size())
+            return std::nullopt;
+        size_t length = 0;
+        for (unsigned i = 0; i < configuration.lengthSize; ++i)
+            length = (length << 8) | data[offset + i];
+        offset += configuration.lengthSize;
+        if (!length || offset + length > data.size())
+            return std::nullopt;
+        result.append(std::span { startCode });
+        result.append(data.subspan(offset, length));
+        offset += length;
+    }
+    return result;
+}
+
+// The NAL units of an Annex B stream.
+static Vector<std::span<const uint8_t>> annexBUnits(std::span<const uint8_t> data)
+{
+    Vector<std::span<const uint8_t>> units;
+    size_t start = std::numeric_limits<size_t>::max();
+    for (size_t i = 0; i + 2 < data.size(); ++i) {
+        if (data[i] || data[i + 1] || data[i + 2] != 1)
+            continue;
+        if (start != std::numeric_limits<size_t>::max()) {
+            size_t end = i;
+            if (end > start && !data[end - 1])
+                --end;
+            units.append(data.subspan(start, end - start));
+        }
+        start = i + 3;
+        i += 2;
+    }
+    if (start < data.size())
+        units.append(data.subspan(start));
+    return units;
+}
+
+// Decoding.
+
+namespace {
+
+class InternalDecoderHaiku final : public ThreadSafeRefCounted<InternalDecoderHaiku>, public webrtc::DecodedImageCallback {
+public:
+    static RefPtr<InternalDecoderHaiku> create(const webrtc::SdpVideoFormat& format, const VideoDecoder::Config& config, VideoDecoder::OutputCallback&& outputCallback)
+    {
+        std::optional<AVCConfiguration> avc;
+        if ((isH264(format) || isH265(format)) && !config.description.isEmpty()) {
+            avc = isH264(format) ? parseAVCConfiguration(config.description.span()) : parseHEVCConfiguration(config.description.span());
+            if (!avc)
+                return nullptr;
+        }
+        auto factory = createVideoDecoderFactoryHaiku();
+        auto decoder = factory ? factory->Create(webrtc::EnvironmentFactory().Create(), format) : nullptr;
+        if (!decoder)
+            return nullptr;
+        webrtc::VideoDecoder::Settings settings;
+        settings.set_number_of_cores(webrtc::cpu_info::DetectNumberOfCores());
+        if (config.width && config.height)
+            settings.set_max_render_resolution({ static_cast<int>(config.width), static_cast<int>(config.height) });
+        if (!decoder->Configure(settings))
+            return nullptr;
+        Ref result = adoptRef(*new InternalDecoderHaiku(WTF::move(decoder), WTF::move(avc), config, WTF::move(outputCallback)));
+        result->m_decoder->RegisterDecodeCompleteCallback(result.ptr());
+        return result;
+    }
+
+    ~InternalDecoderHaiku()
+    {
+        m_decoder->RegisterDecodeCompleteCallback(nullptr);
+        m_decoder->Release();
+    }
+
+    Ref<VideoDecoder::DecodePromise> decode(VideoEncodedData&& frame)
+    {
+        assertIsCurrent(m_queue.get());
+        if (m_isClosed)
+            return VideoDecoder::DecodePromise::createAndReject("The decoder is closed"_s);
+        auto data = frame.data->span();
+        std::optional<Vector<uint8_t>> converted;
+        if (m_avc) {
+            converted = annexBFromAVC(data, *m_avc, frame.isKeyFrame);
+            if (!converted)
+                return VideoDecoder::DecodePromise::createAndReject("The H.264 chunk is not in the configured length-prefixed format"_s);
+            data = converted->span();
+        }
+        // The RTP timestamp names the chunk, so decoders that hold pictures
+        // back still label them with the chunk's own time.
+        uint32_t label = ++m_nextLabel;
+        m_pending.set(label, std::pair { frame.timestamp, frame.duration });
+        if (m_pending.size() > 64)
+            m_pending.remove(label - 64);
+        webrtc::EncodedImage image;
+        image.SetEncodedData(webrtc::EncodedImageBuffer::Create(data.data(), data.size()));
+        image._frameType = frame.isKeyFrame ? webrtc::VideoFrameType::kVideoFrameKey : webrtc::VideoFrameType::kVideoFrameDelta;
+        image.SetRtpTimestamp(label);
+        auto error = m_decoder->Decode(image, false, 0);
+        if (error && (error != WEBRTC_VIDEO_CODEC_NO_OUTPUT || m_treatNoOutputAsError))
+            return VideoDecoder::DecodePromise::createAndReject(makeString("Decoding failed with error "_s, error));
+        return VideoDecoder::DecodePromise::createAndResolve();
+    }
+
+    // Pictures a decoder holds back (H.264 B-frames) come out now; decoders
+    // that hold none ignore the empty image.
+    void drain()
+    {
+        assertIsCurrent(m_queue.get());
+        if (m_isClosed)
+            return;
+        webrtc::EncodedImage image;
+        m_decoder->Decode(image, false, 0);
+    }
+
+    void close() { m_isClosed = true; }
+    WorkQueue& queue() { return m_queue.get(); }
+
+private:
+    InternalDecoderHaiku(std::unique_ptr<webrtc::VideoDecoder>&& decoder, std::optional<AVCConfiguration>&& avc, const VideoDecoder::Config& config, VideoDecoder::OutputCallback&& outputCallback)
+        : m_decoder(WTF::move(decoder))
+        , m_avc(WTF::move(avc))
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_colorSpace(config.colorSpace)
+        , m_treatNoOutputAsError(config.noOutputAsError == VideoDecoder::TreatNoOutputAsError::Yes)
+        , m_queue(WorkQueue::create("WebCodecs video decoder"_s))
+    {
+    }
+
+    int32_t Decoded(webrtc::VideoFrame& frame) final
+    {
+        if (m_isClosed)
+            return 0;
+        auto timing = m_pending.take(frame.rtp_timestamp());
+        // Without a colour space from the page, pictures are BT.601, as VP8
+        // defines and as Haiku's frames are converted to I420 for encoding.
+        PlatformVideoColorSpace colorSpace = m_colorSpace.value_or(rec601ColorSpace());
+        Ref<VideoFrame> videoFrame = videoFrameFromWebRTCBuffer(frame.video_frame_buffer(), MediaTime(timing.first, 1000000), VideoFrame::Rotation::None, WTF::move(colorSpace));
+        m_outputCallback(VideoDecoder::DecodedFrame { WTF::move(videoFrame), timing.first, timing.second });
+        return 0;
+    }
+
+    std::unique_ptr<webrtc::VideoDecoder> m_decoder;
+    const std::optional<AVCConfiguration> m_avc;
+    VideoDecoder::OutputCallback m_outputCallback;
+    const std::optional<PlatformVideoColorSpace> m_colorSpace;
+    const bool m_treatNoOutputAsError;
+    const Ref<WorkQueue> m_queue;
+    HashMap<uint32_t, std::pair<int64_t, std::optional<uint64_t>>, IntHash<uint32_t>, WTF::UnsignedWithZeroKeyHashTraits<uint32_t>> m_pending;
+    uint32_t m_nextLabel { 0 };
+    bool m_isClosed { false };
+};
+
+class VideoDecoderHaiku final : public VideoDecoder {
+public:
+    static Ref<VideoDecoderHaiku> create(Ref<InternalDecoderHaiku>&& decoder) { return adoptRef(*new VideoDecoderHaiku(WTF::move(decoder))); }
+
+private:
+    explicit VideoDecoderHaiku(Ref<InternalDecoderHaiku>&& decoder)
+        : m_decoder(WTF::move(decoder))
+    {
+    }
+
+    Ref<DecodePromise> decode(VideoEncodedData&& frame) final
+    {
+        return invokeAsync(m_decoder->queue(), [frame = WTF::move(frame).isolatedCopy(), decoder = m_decoder] mutable {
+            return decoder->decode(WTF::move(frame));
+        });
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_decoder->queue(), [decoder = m_decoder] {
+            decoder->drain();
+            return GenericPromise::createAndResolve();
+        });
+    }
+
+    void reset() final { m_decoder->close(); }
+    void close() final { m_decoder->close(); }
+
+    const Ref<InternalDecoderHaiku> m_decoder;
+};
+
+} // namespace
+
+void createLibWebRTCVideoDecoderHaiku(const String& codecName, const VideoDecoder::Config& config, VideoDecoder::CreateCallback&& callback, VideoDecoder::OutputCallback&& outputCallback)
+{
+    auto format = sdpFormatForCodec(codecName);
+    RefPtr decoder = format ? InternalDecoderHaiku::create(*format, config, WTF::move(outputCallback)) : nullptr;
+    if (!decoder) {
+        callback(makeUnexpected("Not supported"_s));
+        return;
+    }
+    callback(Ref<VideoDecoder> { VideoDecoderHaiku::create(decoder.releaseNonNull()) });
+}
+
+// Encoding.
+
+namespace {
+
+static constexpr double defaultFrameRate = 30;
+
+class InternalEncoderHaiku final : public ThreadSafeRefCounted<InternalEncoderHaiku>, public webrtc::EncodedImageCallback {
+public:
+    static RefPtr<InternalEncoderHaiku> create(const String& codecName, const webrtc::SdpVideoFormat& format, const VideoEncoder::Config& config, VideoEncoder::DescriptionCallback&& descriptionCallback, VideoEncoder::OutputCallback&& outputCallback)
+    {
+        if (!config.width || !config.height || config.width > 8192 || config.height > 8192)
+            return nullptr;
+        auto factory = createVideoEncoderFactoryHaiku();
+        auto encoder = factory ? factory->Create(webrtc::EnvironmentFactory().Create(), format) : nullptr;
+        if (!encoder)
+            return nullptr;
+        webrtc::VideoCodec codec;
+        codec.width = config.width;
+        codec.height = config.height;
+        codec.maxFramerate = 100;
+        unsigned temporalLayers = 1;
+        switch (config.scalabilityMode) {
+        case VideoEncoder::ScalabilityMode::L1T1:
+            codec.SetScalabilityMode(webrtc::ScalabilityMode::kL1T1);
+            break;
+        case VideoEncoder::ScalabilityMode::L1T2:
+            temporalLayers = 2;
+            codec.SetScalabilityMode(webrtc::ScalabilityMode::kL1T2);
+            break;
+        case VideoEncoder::ScalabilityMode::L1T3:
+            temporalLayers = 3;
+            codec.SetScalabilityMode(webrtc::ScalabilityMode::kL1T3);
+            break;
+        }
+        if (format.name == "VP8") {
+            codec.codecType = webrtc::kVideoCodecVP8;
+            codec.VP8()->numberOfTemporalLayers = temporalLayers;
+        } else if (format.name == "VP9") {
+            codec.codecType = webrtc::kVideoCodecVP9;
+            codec.VP9()->numberOfSpatialLayers = 1;
+        } else {
+            if (temporalLayers > 1)
+                return nullptr;
+            codec.codecType = webrtc::kVideoCodecH264;
+        }
+        auto bitRate = config.bitRate ? config.bitRate : 3 * config.width * config.height;
+        codec.startBitrate = bitRate / 1000;
+        codec.maxBitrate = bitRate / 1000;
+        constexpr int maximumPayloadSize = 1440;
+        if (encoder->InitEncode(&codec, webrtc::VideoEncoder::Settings { webrtc::VideoEncoder::Capabilities { true }, static_cast<int>(webrtc::cpu_info::DetectNumberOfCores()), maximumPayloadSize }))
+            return nullptr;
+        Ref result = adoptRef(*new InternalEncoderHaiku(codecName, WTF::move(encoder), isH264(format), temporalLayers > 1, config, WTF::move(descriptionCallback), WTF::move(outputCallback)));
+        result->m_encoder->RegisterEncodeCompleteCallback(result.ptr());
+        result->setRates(0, 0);
+        return result;
+    }
+
+    ~InternalEncoderHaiku()
+    {
+        m_encoder->RegisterEncodeCompleteCallback(nullptr);
+        m_encoder->Release();
+    }
+
+    Ref<VideoEncoder::EncodePromise> encode(VideoEncoder::RawFrame&& rawFrame, bool shouldGenerateKeyFrame)
+    {
+        assertIsCurrent(m_queue.get());
+        if (m_isClosed)
+            return VideoEncoder::EncodePromise::createAndReject("The encoder is closed"_s);
+        RefPtr frame = dynamicDowncast<VideoFrameHaiku>(rawFrame.frame.get());
+        if (frame && frame->size() != IntSize(m_config.width, m_config.height))
+            frame = frame->resizedTo({ static_cast<int>(m_config.width), static_cast<int>(m_config.height) });
+        auto buffer = frame ? webRTCBufferFromVideoFrame(*frame) : nullptr;
+        if (!buffer)
+            return VideoEncoder::EncodePromise::createAndReject("The frame cannot be encoded"_s);
+        // libwebrtc wants positive, increasing times.
+        if (rawFrame.timestamp + m_timestampOffset <= 0)
+            m_timestampOffset = 1 - rawFrame.timestamp;
+        m_timestamp = rawFrame.timestamp;
+        m_duration = rawFrame.duration;
+        webrtc::VideoFrame videoFrame { buffer, webrtc::kVideoRotation_0, rawFrame.timestamp + m_timestampOffset };
+        std::vector<webrtc::VideoFrameType> frameTypes { (shouldGenerateKeyFrame || !m_hasEncoded) ? webrtc::VideoFrameType::kVideoFrameKey : webrtc::VideoFrameType::kVideoFrameDelta };
+        auto error = m_encoder->Encode(videoFrame, &frameTypes);
+        if (error)
+            return VideoEncoder::EncodePromise::createAndReject(makeString("Encoding failed with error "_s, error));
+        m_hasEncoded = true;
+        return VideoEncoder::EncodePromise::createAndResolve();
+    }
+
+    void setRates(uint64_t bitRate, double frameRate)
+    {
+        if (bitRate)
+            m_config.bitRate = bitRate;
+        if (frameRate)
+            m_config.frameRate = frameRate;
+        auto total = m_config.bitRate ? m_config.bitRate : 3 * m_config.width * m_config.height;
+        webrtc::VideoBitrateAllocation allocation;
+        switch (m_config.scalabilityMode) {
+        case VideoEncoder::ScalabilityMode::L1T1:
+            allocation.SetBitrate(0, 0, total);
+            break;
+        case VideoEncoder::ScalabilityMode::L1T2:
+            allocation.SetBitrate(0, 0, total * 0.6);
+            allocation.SetBitrate(0, 1, total * 0.4);
+            break;
+        case VideoEncoder::ScalabilityMode::L1T3:
+            allocation.SetBitrate(0, 0, total * 0.5);
+            allocation.SetBitrate(0, 1, total * 0.2);
+            allocation.SetBitrate(0, 2, total * 0.3);
+            break;
+        }
+        m_encoder->SetRates({ allocation, m_config.frameRate ? m_config.frameRate : defaultFrameRate });
+    }
+
+    void close() { m_isClosed = true; }
+    WorkQueue& queue() { return m_queue.get(); }
+
+private:
+    InternalEncoderHaiku(const String& codecName, std::unique_ptr<webrtc::VideoEncoder>&& encoder, bool h264, bool temporalLayers, const VideoEncoder::Config& config, VideoEncoder::DescriptionCallback&& descriptionCallback, VideoEncoder::OutputCallback&& outputCallback)
+        : m_codecName(codecName.isolatedCopy())
+        , m_encoder(WTF::move(encoder))
+        , m_isH264(h264)
+        , m_hasTemporalLayers(temporalLayers)
+        , m_config(config)
+        , m_descriptionCallback(WTF::move(descriptionCallback))
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs video encoder"_s))
+    {
+    }
+
+    // H.264 in WebCodecs' default "avc" format: length-prefixed NAL units,
+    // with the parameter sets in an avcC description.
+    Vector<uint8_t> avcFromAnnexB(std::span<const uint8_t> data, std::optional<Vector<uint8_t>>& description)
+    {
+        Vector<uint8_t> result;
+        std::span<const uint8_t> sps, pps;
+        for (auto unit : annexBUnits(data)) {
+            if (unit.empty())
+                continue;
+            auto type = unit[0] & 0x1f;
+            if (type == 7) {
+                sps = unit;
+                continue;
+            }
+            if (type == 8) {
+                pps = unit;
+                continue;
+            }
+            uint32_t length = unit.size();
+            result.appendList({ static_cast<uint8_t>(length >> 24), static_cast<uint8_t>(length >> 16), static_cast<uint8_t>(length >> 8), static_cast<uint8_t>(length) });
+            result.append(unit);
+        }
+        if (sps.size() >= 4 && !pps.empty()) {
+            Vector<uint8_t> record { 1, sps[1], sps[2], sps[3], 0xff, 0xe1, static_cast<uint8_t>(sps.size() >> 8), static_cast<uint8_t>(sps.size()) };
+            record.append(sps);
+            record.appendList({ static_cast<uint8_t>(1), static_cast<uint8_t>(pps.size() >> 8), static_cast<uint8_t>(pps.size()) });
+            record.append(pps);
+            if (record != m_lastDescription) {
+                m_lastDescription = record;
+                description = WTF::move(record);
+            }
+        }
+        return result;
+    }
+
+    Result OnEncodedImage(const webrtc::EncodedImage& image, const webrtc::CodecSpecificInfo*) final
+    {
+        if (m_isClosed)
+            return Result { Result::OK };
+        auto data = unsafeMakeSpan(image.data(), image.size());
+        std::optional<Vector<uint8_t>> description;
+        Vector<uint8_t> bytes = m_isH264 && !m_config.useAnnexB ? avcFromAnnexB(data, description) : Vector<uint8_t> { data };
+        std::optional<unsigned> temporalIndex;
+        if (m_hasTemporalLayers) {
+            if (auto index = image.TemporalIndex())
+                temporalIndex = *index;
+        }
+        if (m_needsDescription || description) {
+            m_needsDescription = false;
+            VideoEncoder::ActiveConfiguration configuration;
+            configuration.codec = m_codecName;
+            configuration.visibleWidth = m_config.width;
+            configuration.visibleHeight = m_config.height;
+            configuration.description = WTF::move(description);
+            configuration.colorSpace = rec601ColorSpace();
+            m_descriptionCallback(WTF::move(configuration));
+        }
+        m_outputCallback({ WTF::move(bytes), image._frameType == webrtc::VideoFrameType::kVideoFrameKey, m_timestamp, m_duration, temporalIndex });
+        return Result { Result::OK };
+    }
+
+    void OnFrameDropped(uint32_t, int, bool) final { }
+
+    const String m_codecName;
+    std::unique_ptr<webrtc::VideoEncoder> m_encoder;
+    const bool m_isH264;
+    const bool m_hasTemporalLayers;
+    VideoEncoder::Config m_config;
+    VideoEncoder::DescriptionCallback m_descriptionCallback;
+    VideoEncoder::OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    Vector<uint8_t> m_lastDescription;
+    int64_t m_timestamp { 0 };
+    int64_t m_timestampOffset { 0 };
+    std::optional<uint64_t> m_duration;
+    bool m_hasEncoded { false };
+    bool m_needsDescription { true };
+    bool m_isClosed { false };
+};
+
+class VideoEncoderHaiku final : public VideoEncoder {
+public:
+    static Ref<VideoEncoderHaiku> create(Ref<InternalEncoderHaiku>&& encoder) { return adoptRef(*new VideoEncoderHaiku(WTF::move(encoder))); }
+
+private:
+    explicit VideoEncoderHaiku(Ref<InternalEncoderHaiku>&& encoder)
+        : m_encoder(WTF::move(encoder))
+    {
+    }
+
+    Ref<EncodePromise> encode(RawFrame&& frame, bool shouldGenerateKeyFrame) final
+    {
+        return invokeAsync(m_encoder->queue(), [frame = WTF::move(frame), shouldGenerateKeyFrame, encoder = m_encoder] mutable {
+            return encoder->encode(WTF::move(frame), shouldGenerateKeyFrame);
+        });
+    }
+
+    Ref<GenericPromise> setRates(uint64_t bitRate, double frameRate) final
+    {
+        return invokeAsync(m_encoder->queue(), [encoder = m_encoder, bitRate, frameRate] {
+            encoder->setRates(bitRate, frameRate);
+            return GenericPromise::createAndResolve();
+        });
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        // The encoders output each frame as it is encoded.
+        return invokeAsync(m_encoder->queue(), [] { return GenericPromise::createAndResolve(); });
+    }
+
+    void reset() final { m_encoder->close(); }
+    void close() final { m_encoder->close(); }
+
+    const Ref<InternalEncoderHaiku> m_encoder;
+};
+
+} // namespace
+
+void createLibWebRTCVideoEncoderHaiku(const String& codecName, const VideoEncoder::Config& config, VideoEncoder::CreateCallback&& callback, VideoEncoder::DescriptionCallback&& descriptionCallback, VideoEncoder::OutputCallback&& outputCallback)
+{
+    auto format = sdpFormatForCodec(codecName);
+    RefPtr encoder = format ? InternalEncoderHaiku::create(codecName, *format, config, WTF::move(descriptionCallback), WTF::move(outputCallback)) : nullptr;
+    if (!encoder) {
+        callback(makeUnexpected("Not supported"_s));
+        return;
+    }
+    callback(Ref<VideoEncoder> { VideoEncoderHaiku::create(encoder.releaseNonNull()) });
+}
+
+} // namespace WebCore
