+bool CoordinatedBackingStore::coversOpaquelyHaiku(TextureMapper& textureMapper, const FloatRect& targetRect, const TransformationMatrix& transform, float opacity) const
+{
+    if (m_tiles.isEmpty() || m_size.isZero() || opacity < 1)
+        return false;
+    FloatRect layerRect = { { }, m_size };
+    TransformationMatrix adjustedTransform = transform * TransformationMatrix::rectToRect(layerRect, targetRect);
+    // Only where rectangles stay rectangles.
+    if (!adjustedTransform.isAffine() || adjustedTransform.b() || adjustedTransform.c())
+        return false;
+    auto inverse = adjustedTransform.inverse();
+    if (!inverse)
+        return false;
+
+    // In the target's pixels, each of which a draw covers when it holds the
+    // pixel's center: tiles next to each other share their edge, so rounding
+    // it gives both the same pixel column. In the tiles' own coordinates
+    // (292.57 pixels at 175 %), the whole pixels inside each tile left a
+    // column between every two uncovered, the page's background color was
+    // drawn under its opaque tiles in every frame (1.85 megapixels at the
+    // laptop's full screen). SUMMIT_TILE_COVER_IN_TARGET=0 tests in the tiles'
+    // coordinates.
+    static const bool inTarget = [] {
+        const char* value = getenv("SUMMIT_TILE_COVER_IN_TARGET");
+        return !value || strcmp(value, "0");
+    }();
+    if (inTarget) {
+        auto pixels = [](const FloatRect& rect) {
+            int left = std::round(rect.x());
+            int top = std::round(rect.y());
+            int right = std::round(rect.maxX());
+            int bottom = std::round(rect.maxY());
+            return IntRect(left, top, std::max(0, right - left), std::max(0, bottom - top));
+        };
+        IntRect shownPixels = pixels(intersection(FloatRect(textureMapper.clipBounds()), adjustedTransform.mapRect(layerRect)));
+        if (shownPixels.isEmpty())
+            return true;
+        Region uncoveredPixels(shownPixels);
+        for (const auto& tile : m_tiles.values()) {
+            if (!tile.canBePainted() || !tile.texture().isOpaque())
+                continue;
+            auto tilePixels = pixels(adjustedTransform.mapRect(tile.rect()));
+            if (tilePixels.isEmpty())
+                continue;
+            uncoveredPixels.subtract(tilePixels);
+            if (uncoveredPixels.isEmpty())
+                return true;
+        }
+        return false;
+    }
+
+    // What the clip shows of the layer, in the tiles' coordinates.
+    FloatRect shown = inverse->mapRect(FloatRect(textureMapper.clipBounds()));
+    shown.intersect(layerRect);
+    if (shown.isEmpty())
+        return true;
+    Region uncovered(enclosingIntRect(shown));
+    for (const auto& tile : m_tiles.values()) {
+        if (!tile.canBePainted() || !tile.texture().isOpaque())
+            continue;
+        // The whole pixels inside the tile.
+        const auto& rect = tile.rect();
+        int left = std::ceil(rect.x());
+        int top = std::ceil(rect.y());
+        int right = std::floor(rect.maxX());
+        int bottom = std::floor(rect.maxY());
+        if (right <= left || bottom <= top)
+            continue;
+        uncovered.subtract(IntRect(left, top, right - left, bottom - top));
+        if (uncovered.isEmpty())
+            return true;
+    }
+    return false;
+}
