+void WebExtensionContext::historyQueryHaiku(const String& method, const String& argumentsJSON, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    auto apiName = makeString("history."_s, method, "()"_s);
+    static constexpr std::array methods { "search"_s, "getVisits"_s, "addUrl"_s, "deleteUrl"_s, "deleteRange"_s, "deleteAll"_s };
+    // History is the browser's own, not a private window's.
+    if (auto message = nativeNamespaceQueryHaiku(*this, B_WEBKIT_BROWSER_HISTORY, "history"_s, methods, method, argumentsJSON, apiName, completion))
+        sendNativeBrowserQueryHaiku(WTF::move(*message), apiName, WTF::move(completion));
+}
