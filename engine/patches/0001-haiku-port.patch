+void WebExtensionContext::downloadsItemAction(String&& action, double downloadIdentifier, String&& optionsJSON, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completionHandler)
+{
+    // Documentation: https://developer.chrome.com/docs/extensions/reference/api/downloads
+    static constexpr ASCIILiteral actions[] { "pause"_s, "resume"_s, "open"_s, "removeFile"_s, "acceptDanger"_s, "getFileIcon"_s, "setUiOptions"_s };
+    auto known = std::ranges::find(actions, action);
+    if (known == std::end(actions)) {
+        completionHandler(toWebExtensionError("downloads"_s, nullString(), "the action is not supported"_s));
+        return;
+    }
+    if (action == "setUiOptions"_s) {
+        // Chrome's downloads.ui permission; the browser keeps it per extension.
+        static constexpr auto apiName = "downloads.setUiOptions()"_s;
+        RefPtr options = parseObject(optionsJSON);
+        RefPtr enabled = options ? options->getValue("enabled"_s) : nullptr;
+        if (!hasPermission("downloads.ui"_s)) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "it requires the 'downloads.ui' permission"_s));
+            return;
+        }
+        if (!enabled || !enabled->asBoolean()) {
+            completionHandler(toWebExtensionError(apiName, "options"_s, "it must have a boolean 'enabled'"_s));
+            return;
+        }
+        BMessage message(B_WEBKIT_BROWSER_COMMAND);
+        if (message.AddUInt32("command", B_WEBKIT_BROWSER_DOWNLOADS_UI) != B_OK || message.AddBool("enabled", *enabled->asBoolean()) != B_OK) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "out of memory"_s));
+            return;
+        }
+        sendNativeBrowserQueryHaiku(WTF::move(message), apiName, [completionHandler = WTF::move(completionHandler)](std::expected<String, WebExtensionError>&& result) mutable {
+            if (!result) {
+                completionHandler(makeUnexpected(result.error()));
+                return;
+            }
+            completionHandler(String { emptyString() });
+        });
+        return;
+    }
+    auto apiName = makeString("downloads."_s, *known, "()"_s);
+    RefPtr controller = extensionController();
+    auto identifier = toDownloadIdentifier(downloadIdentifier);
+    if (!controller || !identifier) {
+        completionHandler(toWebExtensionError(apiName, "downloadId"_s, "it is not a valid download identifier"_s));
+        return;
+    }
+    auto& downloads = controller->nativeDownloads();
+    auto reply = [&](std::expected<void, String>&& result) {
+        if (!result) {
+            completionHandler(toWebExtensionError(apiName, nullString(), result.error()));
+            return;
+        }
+        completionHandler(String { emptyString() });
+    };
+
+    if (action == "pause"_s)
+        return reply(downloads.pause(*identifier));
+    if (action == "resume"_s)
+        return reply(downloads.resume(*identifier));
+    if (action == "removeFile"_s)
+        return reply(downloads.removeFile(*identifier));
+    if (action == "acceptDanger"_s)
+        return reply(downloads.acceptDanger(*identifier));
+
+    if (action == "open"_s) {
+        // Chrome and Firefox ask for this permission besides "downloads".
+        if (!hasPermission("downloads.open"_s)) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "it requires the 'downloads.open' permission"_s));
+            return;
+        }
+        auto path = downloads.completedFile(*identifier);
+        if (!path) {
+            completionHandler(toWebExtensionError(apiName, nullString(), path.error()));
+            return;
+        }
+        // The file opens in its preferred application, as from Tracker.
+        BEntry entry(path->utf8().legacyCStringPointer());
+        entry_ref reference;
+        auto status = entry.GetRef(&reference);
+        if (status == B_OK)
+            status = be_roster->Launch(&reference);
+        if (status != B_OK && status != B_ALREADY_RUNNING) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "the file could not be opened"_s));
+            return;
+        }
+        completionHandler(String { emptyString() });
+        return;
+    }
+
+    // getFileIcon({size}): 16 or 32 pixels, 32 by default.
+    int size = 32;
+    if (RefPtr options = parseObject(optionsJSON)) {
+        if (RefPtr value = options->getValue("size"_s)) {
+            auto number = value->asDouble();
+            if (!number || (*number != 16 && *number != 32)) {
+                completionHandler(toWebExtensionError(apiName, "size"_s, "it must be 16 or 32"_s));
+                return;
+            }
+            size = static_cast<int>(*number);
+        }
+    }
+    auto path = downloads.pathForShow(*identifier);
+    if (!path) {
+        completionHandler(toWebExtensionError(apiName, nullString(), path.error()));
+        return;
+    }
+    auto icon = fileIconURL(*path, size);
+    if (!icon) {
+        completionHandler(toWebExtensionError(apiName, nullString(), icon.error()));
+        return;
+    }
+    completionHandler(JSON::Value::create(*icon)->toJSONString());
+}
+
+void WebExtensionContext::fireDownloadsEventIfNeeded(WebExtensionEventListenerType type, const String& argumentJSON)
+{
+    auto loadIdentifier = privilegedIdentifier();
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ type }, [this, protectedThis = Ref { *this }, type, argumentJSON, loadIdentifier] {
+        if (!isLoaded() || privilegedIdentifier() != loadIdentifier || !hasPermission(WebExtensionPermission::downloads()))
+            return;
+        sendToProcessesForEvent(type, Messages::WebExtensionContextProxy::DispatchDownloadsEvent(type, argumentJSON));
+    });
+}
+
+} // namespace WebKit
