+// A page's video shown in the host's Picture in Picture window: its frames go
+// to the host as B_WEBKIT_PICTURE_IN_PICTURE_FRAME ('wpif') messages,
+// fitted into the window's size, at most 30 a second and only when the
+// picture or the state the window shows (time, paused, volume) changed. One
+// per page; main thread only.
+struct PictureInPictureHaiku {
+    WeakPtr<WebPage> page;
+    WeakPtr<HTMLMediaElement> video;
+    BMessenger target;
+    IntSize size;
+    std::unique_ptr<RunLoop::Timer> timer;
+    double lastTime { -1 };
+    bool lastPaused { false };
+    double lastVolume { -1 };
+    bool lastMuted { false };
+    bool seeking { false };
+    IntSize lastVideoSize;
+    uint32_t idleTicks { 0 };
+    // Frames sent whatever changed: after a seek the picture at the new time
+    // can come a little after the time does, also while paused.
+    uint32_t forcedTicks { 0 };
+};
+
+HashMap<uint64_t, std::unique_ptr<PictureInPictureHaiku>>& pictureInPicturesHaiku()
+{
+    static NeverDestroyed<HashMap<uint64_t, std::unique_ptr<PictureInPictureHaiku>>> pictures;
+    return pictures.get();
+}
+
+constexpr uint32 pictureInPictureFrameHaiku = 'wpif';
+constexpr uint32 pictureInPictureEndedHaiku = 'wpie';
+
+void endPictureInPictureHaiku(uint64_t pageID, bool notifyHost)
+{
+    auto entry = pictureInPicturesHaiku().take(pageID);
+    if (!entry)
+        return;
+    if (entry->timer)
+        entry->timer->stop();
+    if (RefPtr video = entry->video.get())
+        video->dispatchEvent(Event::create("leavepictureinpicture"_s, Event::CanBubble::Yes, Event::IsCancelable::No));
+    if (notifyHost) {
+        BMessage message(pictureInPictureEndedHaiku);
+        message.AddUInt64("page", pageID);
+        entry->target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+}
+
+void sendPictureInPictureFrameHaiku(uint64_t pageID)
+{
+    auto found = pictureInPicturesHaiku().find(pageID);
+    if (found == pictureInPicturesHaiku().end())
+        return;
+    auto& picture = *found->value;
+    RefPtr video = dynamicDowncast<HTMLVideoElement>(picture.video.get());
+    if (!video || !video->isConnected() || !picture.page) {
+        endPictureInPictureHaiku(pageID, true);
+        return;
+    }
+    const double time = video->currentTime();
+    const bool paused = video->paused();
+    const double volume = video->volume();
+    const bool muted = video->muted();
+    // The picture of a seek that just ended, which a paused video shows at
+    // a time already sent.
+    const bool seekEnded = picture.seeking && !video->seeking();
+    picture.seeking = video->seeking();
+    const bool forced = picture.forcedTicks || seekEnded;
+    if (picture.forcedTicks)
+        --picture.forcedTicks;
+    const bool same = time == picture.lastTime && paused == picture.lastPaused && volume == picture.lastVolume && muted == picture.lastMuted;
+    // A paused picture that was sent stays; check once a second for a seek.
+    if (same && !forced && ++picture.idleTicks < 30)
+        return;
+    picture.idleTicks = 0;
+    RefPtr image = video->nativeImageForCurrentTime();
+    auto platformImage = image ? image->platformImage() : nullptr;
+    if (!platformImage || platformImage->width() <= 0 || platformImage->height() <= 0)
+        return;
+    const IntSize videoSize(platformImage->width(), platformImage->height());
+    if (same && !forced && videoSize == picture.lastVideoSize)
+        return;
+    const IntSize bounds(std::clamp(picture.size.width(), 64, 1920), std::clamp(picture.size.height(), 36, 1080));
+    const double fit = std::min(double(bounds.width()) / videoSize.width(), double(bounds.height()) / videoSize.height());
+    const int width = std::max(1, int(std::round(videoSize.width() * fit)));
+    const int height = std::max(1, int(std::round(videoSize.height() * fit)));
+    Vector<uint8_t> pixels(size_t(width) * height * 4);
+    auto surface = SkSurfaces::WrapPixels(SkImageInfo::MakeN32Premul(width, height), pixels.mutableSpan().data(), width * 4);
+    if (!surface)
+        return;
+    surface->getCanvas()->clear(SK_ColorBLACK);
+    surface->getCanvas()->drawImageRect(platformImage, SkRect::MakeWH(width, height), SkSamplingOptions(SkFilterMode::kLinear, SkMipmapMode::kNone));
+    BMessage message(pictureInPictureFrameHaiku);
+    message.AddUInt64("page", pageID);
+    message.AddInt32("width", width);
+    message.AddInt32("height", height);
+    message.AddData("pixels", B_RAW_TYPE, pixels.span().data(), pixels.size(), false);
+    message.AddBool("paused", paused);
+    message.AddDouble("time", time);
+    message.AddDouble("duration", video->duration());
+    message.AddDouble("volume", volume);
+    message.AddBool("muted", muted);
+    // A full queue drops the frame rather than holding up the page.
+    if (picture.target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0) == B_BAD_PORT_ID) {
+        endPictureInPictureHaiku(pageID, false);
+        return;
+    }
+    picture.lastTime = time;
+    picture.lastPaused = paused;
+    picture.lastVolume = volume;
+    picture.lastMuted = muted;
+    picture.lastVideoSize = videoSize;
+}
+
+// A time to seek to, kept within what the video can seek to.
+double clampedPictureInPictureTimeHaiku(HTMLMediaElement& video, double time)
+{
+    Ref seekableRanges = video.seekable();
+    const auto& seekable = seekableRanges->ranges();
+    if (seekable.length())
+        return std::clamp(time, seekable.minimumBufferedTime().toDouble(), seekable.maximumBufferedTime().toDouble());
+    const double duration = video.duration();
+    return std::isfinite(duration) ? std::clamp(time, 0.0, duration) : std::max(time, 0.0);
+}
+
+} // namespace
+
+void WebPage::enterPictureInPictureHaiku(String&& token, String&& target, IntSize size)
+{
+    const uint64_t pageID = identifier().toUInt64();
+    endPictureInPictureHaiku(pageID, true);
+    if (token.isEmpty() || token.length() > 20)
+        return;
+    for (auto character : StringView(token).codeUnits()) {
+        if (!isASCIIDigit(character))
+            return;
+    }
+    Vector<uint8_t> bytes;
+    if (target.isEmpty() || target.length() % 2 || target.length() > 4096)
+        return;
+    for (unsigned i = 0; i < target.length(); i += 2) {
+        if (!isASCIIHexDigit(target[i]) || !isASCIIHexDigit(target[i + 1]))
+            return;
+        bytes.append(toASCIIHexValue(target[i], target[i + 1]));
+    }
+    BMessage carrier;
+    BMessenger messenger;
+    if (carrier.Unflatten(reinterpret_cast<const char*>(bytes.span().data())) != B_OK
+        || carrier.FindMessenger("target", &messenger) != B_OK)
+        return;
+    RefPtr<HTMLVideoElement> video;
+    const auto selector = makeString("video[data-summit-pip=\""_s, token, "\"]"_s);
+    for (RefPtr<Frame> frame = corePage() ? &corePage()->mainFrame() : nullptr; frame && !video; frame = frame->tree().traverseNext()) {
+        RefPtr localFrame = dynamicDowncast<LocalFrame>(frame);
+        RefPtr document = localFrame ? localFrame->document() : nullptr;
+        if (!document)
+            continue;
+        auto element = document->querySelector(selector);
+        if (!element.hasException())
+            video = dynamicDowncast<HTMLVideoElement>(element.releaseReturnValue());
+    }
+    if (!video) {
+        BMessage message(pictureInPictureEndedHaiku);
+        message.AddUInt64("page", pageID);
+        messenger.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        return;
+    }
+    auto picture = std::make_unique<PictureInPictureHaiku>();
+    picture->page = *this;
+    picture->video = *video;
+    picture->target = messenger;
+    picture->size = size;
+    picture->timer = std::make_unique<RunLoop::Timer>(RunLoop::mainSingleton(), "PictureInPictureHaiku"_s, [pageID] {
+        sendPictureInPictureFrameHaiku(pageID);
+    });
+    picture->timer->startRepeating(33_ms);
+    pictureInPicturesHaiku().set(pageID, WTF::move(picture));
+    video->dispatchEvent(Event::create("enterpictureinpicture"_s, Event::CanBubble::Yes, Event::IsCancelable::No));
+    sendPictureInPictureFrameHaiku(pageID);
+}
+
+void WebPage::setPictureInPictureSizeHaiku(IntSize size)
+{
+    if (auto found = pictureInPicturesHaiku().find(identifier().toUInt64()); found != pictureInPicturesHaiku().end()) {
+        found->value->size = size;
+        found->value->lastVideoSize = { };
+        found->value->lastTime = -1;
+    }
+}
+
+void WebPage::pictureInPictureCommandHaiku(String&& command)
+{
+    auto found = pictureInPicturesHaiku().find(identifier().toUInt64());
+    if (found == pictureInPicturesHaiku().end())
+        return;
+    RefPtr video = found->value->video.get();
+    if (!video)
+        return;
+    // The window's buttons are the user's own action.
+    UserGestureIndicator gesture(IsProcessingUserGesture::Yes, protect(video->document()).ptr());
+    // The argument of "name:<number>": a finite number, else nothing.
+    auto argument = [&](ASCIILiteral name) -> std::optional<double> {
+        if (command.length() > 40 || !command.startsWith(name))
+            return std::nullopt;
+        bool valid = false;
+        const double value = StringView(command).substring(name.length()).toDouble(valid);
+        if (!valid || !std::isfinite(value))
+            return std::nullopt;
+        return value;
+    };
+    // More frames after a seek: the window shows the new time and picture.
+    auto sendFrames = [pageID = identifier().toUInt64()] {
+        if (auto entry = pictureInPicturesHaiku().find(pageID); entry != pictureInPicturesHaiku().end())
+            entry->value->forcedTicks = 15;
+    };
+    if (command == "play"_s || (command == "toggle"_s && video->paused()))
+        video->play();
+    else if (command == "pause"_s || command == "toggle"_s)
+        video->pause();
+    else if (command == "mute"_s || command == "unmute"_s)
+        video->setMuted(command == "mute"_s);
+    else if (auto time = argument("seek:"_s)) {
+        (void)video->setCurrentTimeForBindings(clampedPictureInPictureTimeHaiku(*video, *time));
+        sendFrames();
+    } else if (auto delta = argument("skip:"_s)) {
+        if (std::fabs(*delta) <= 24 * 3600) {
+            (void)video->setCurrentTimeForBindings(clampedPictureInPictureTimeHaiku(*video, video->currentTime() + *delta));
+            sendFrames();
+        }
+    } else if (auto volume = argument("volume:"_s)) {
+        if (*volume >= 0 && *volume <= 1)
+            (void)video->setVolume(*volume);
+    }
+}
+
+void WebPage::exitPictureInPictureHaiku()
+{
+    endPictureInPictureHaiku(identifier().toUInt64(), false);
+}
+
+void WebPage::runBookmarkletHaiku(URL&& url, ScriptExecutionContextIdentifier expectedDocument, CompletionHandler<void(String&&)>&& completion)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!document || document->identifier() != expectedDocument || frame->loader().provisionalDocumentLoader())
+        return completion("The document changed"_s);
+    if (!url.isValid() || !url.protocolIsJavaScript() || url.string().length() > 65536
+        || (!document->url().protocolIsInHTTPFamily() && !document->url().protocolIsFile())
+        || document->isSandboxed(SandboxFlag::Scripts) || !frame->settings().isScriptEnabled())
+        return completion("Bookmarklets cannot run on this page"_s);
+    NavigationAction action { *document, ResourceRequest { URL { url } }, InitiatedByMainFrame::Yes, true };
+    bool replaced = false;
+    // Use WebCore's percent decoding, main-world completion and document
+    // replacement, with browser activation rather than a page link's CSP.
+    protect(frame->script())->executeJavaScriptURL(url, action, replaced, ScriptController::JavaScriptURLSource::Bookmarklet);
+    completion({ });
+}
+
+void WebPage::drawPagesForPrintingHaiku(FrameIdentifier frameID, const PrintInfo& printInfo, uint32_t first, uint32_t count, float rasterScale, bool printBackgrounds,
+    CompletionHandler<void(std::optional<WebCore::SharedMemoryHandle>&&, uint32_t, IntSize)>&& completion)
+{
+    RefPtr page = corePage();
+    if (!page) {
+        completion(std::nullopt, 0, { });
+        return;
+    }
+#if ENABLE(PDFJS)
+    RefPtr webFrame = WebProcess::singleton().webFrame(frameID);
+    RefPtr frame = webFrame ? webFrame->coreLocalFrame() : nullptr;
+    RefPtr document = frame ? frame->document() : nullptr;
+    RefPtr pdf = dynamicDowncast<PDFJSDocument>(document);
+    if (!pdf && frame) {
+        // The PDF toolbar calls window.print from the bundled viewer iframe.
+        RefPtr parent = dynamicDowncast<LocalFrame>(frame->tree().parent());
+        if (RefPtr parentPDF = parent ? dynamicDowncast<PDFJSDocument>(parent->document()) : nullptr;
+            parentPDF && parentPDF->viewerFrame() == frame)
+            pdf = WTF::move(parentPDF);
+    }
+    if (pdf) {
+        drawPDFPagesForPrintingHaiku(*pdf, printInfo, first, count, rasterScale, WTF::move(completion));
+        return;
+    }
+#endif
+    // PrintInfo holds the paper's printable area and margins in CSS pixels
+    // (the host converts its points), so that pages are laid out as wide as
+    // in other browsers; pages are drawn on paper measured in points.
+    constexpr float pointsPerPixel = 0.75f;
+    const float scale = printInfo.pageSetupScaleFactor > 0 ? printInfo.pageSetupScaleFactor : 1;
+    const FloatSize paper((printInfo.availablePaperWidth + printInfo.margin.left() + printInfo.margin.right()) * pointsPerPixel * scale,
+        (printInfo.availablePaperHeight + printInfo.margin.top() + printInfo.margin.bottom()) * pointsPerPixel * scale);
+    const FloatPoint origin(printInfo.margin.left() * pointsPerPixel * scale, printInfo.margin.top() * pointsPerPixel * scale);
+    const float contentWidth = printInfo.availablePaperWidth * pointsPerPixel * scale;
+
+    auto& settings = page->settings();
+    const bool backgrounds = settings.shouldPrintBackgrounds();
+    settings.setShouldPrintBackgrounds(printBackgrounds);
+    PrintInfo layoutInfo = printInfo;
+    layoutInfo.pageSetupScaleFactor = 1;
+    beginPrinting(frameID, layoutInfo);
+    RefPtr printContext = m_printContext;
+    const uint32_t pageCount = printContext ? printContext->pageCount() : 0;
+    const uint32_t end = first < pageCount ? std::min<uint32_t>(pageCount, first + count) : first;
+    auto drawPage = [&](SkCanvas& canvas, uint32_t number) {
+        canvas.save();
+        canvas.translate(origin.x(), origin.y());
+        GraphicsContextSkia context(canvas, RenderingMode::Unaccelerated, RenderingPurpose::Unspecified);
+        printContext->spoolPage(context, number, contentWidth);
+        canvas.restore();
+    };
+
+    std::optional<WebCore::SharedMemoryHandle> handle;
+    IntSize pageSize;
+    if (printContext && first < end && rasterScale <= 0) {
+        SkDynamicMemoryWStream stream;
+        SkPDF::Metadata metadata;
+        RefPtr webFrame = WebProcess::singleton().webFrame(frameID);
+        RefPtr coreFrame = webFrame ? webFrame->coreLocalFrame() : nullptr;
+        if (RefPtr document = coreFrame ? coreFrame->document() : nullptr) {
+            auto title = document->title().utf8();
+            metadata.fTitle = SkString(title.legacyCStringPointer());
+        }
+        metadata.fCreator = SkString("Summit");
+        // SkPDF refuses to make a document without these (pictures in JPEG).
+        metadata.jpegDecoder = SkPDF::JPEG::Decode;
+        metadata.jpegEncoder = SkPDF::JPEG::Encode;
+        std::time_t now = std::time(nullptr);
+        if (std::tm local; localtime_r(&now, &local)) {
+            metadata.fCreation = SkPDF::DateTime { static_cast<int16_t>(local.tm_gmtoff / 60), static_cast<uint16_t>(local.tm_year + 1900),
+                static_cast<uint8_t>(local.tm_mon + 1), static_cast<uint8_t>(local.tm_wday), static_cast<uint8_t>(local.tm_mday),
+                static_cast<uint8_t>(local.tm_hour), static_cast<uint8_t>(local.tm_min), static_cast<uint8_t>(local.tm_sec) };
+            metadata.fModified = metadata.fCreation;
+        }
+        auto pdf = SkPDF::MakeDocument(&stream, metadata);
+        for (uint32_t number = first; pdf && number < end; ++number) {
+            if (auto* canvas = pdf->beginPage(paper.width(), paper.height())) {
+                drawPage(*canvas, number);
+                pdf->endPage();
+            }
+        }
+        if (pdf)
+            pdf->close();
+        auto data = SharedBuffer::create(stream.detachAsData());
+        if (RefPtr memory = SharedMemory::copyBuffer(data.get()))
+            handle = memory->createHandle(SharedMemory::Protection::ReadOnly);
+        pageSize = IntSize(std::ceil(paper.width()), std::ceil(paper.height()));
+    } else if (printContext && first < end) {
+        pageSize = IntSize(std::ceil(paper.width() * rasterScale), std::ceil(paper.height() * rasterScale));
+        const size_t pageBytes = static_cast<size_t>(pageSize.width()) * pageSize.height() * 4;
+        RefPtr memory = pageSize.isEmpty() || pageBytes * (end - first) > (512u << 20) ? nullptr : SharedMemory::allocate(pageBytes * (end - first));
+        if (memory) {
+            auto bytes = memory->mutableSpan();
+            for (uint32_t number = first; number < end; ++number) {
+                auto info = SkImageInfo::MakeN32Premul(pageSize.width(), pageSize.height());
+                auto surface = SkSurfaces::WrapPixels(info, bytes.subspan(pageBytes * (number - first)).data(), pageSize.width() * 4);
+                if (!surface)
+                    continue;
+                auto* canvas = surface->getCanvas();
+                canvas->clear(SK_ColorWHITE);
+                canvas->scale(rasterScale, rasterScale);
+                drawPage(*canvas, number);
+            }
+            handle = memory->createHandle(SharedMemory::Protection::ReadOnly);
+        }
+    }
+    if (m_printContext)
+        endPrintingImmediately();
+    settings.setShouldPrintBackgrounds(backgrounds);
+    completion(WTF::move(handle), pageCount, pageSize);
+}
