+
+void HaikuVideoCaptureSource::connect()
+{
+    if (m_connected)
+        return;
+    auto& camera = HaikuSharedCamera::forDevice(persistentID(), name());
+    if (!camera.addSource(*this, requestedSize())) {
+        HaikuSharedCamera::releaseIfUnused(persistentID());
+        captureFailed();
+        return;
+    }
+    m_connected = true;
+}
+
+void HaikuVideoCaptureSource::disconnect()
+{
+    if (!m_connected)
+        return;
+    m_connected = false;
+    if (auto* camera = HaikuSharedCamera::existing(persistentID())) {
+        camera->removeSource(*this);
+        HaikuSharedCamera::releaseIfUnused(persistentID());
+    }
+}
