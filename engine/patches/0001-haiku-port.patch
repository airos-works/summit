+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPISearch.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionTabIdentifier.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+
+namespace WebKit {
+
+void WebExtensionAPISearch::query(RefPtr<JSON::Value> queryInfo, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("query"_s, WTF::move(queryInfo), "text"_s, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISearch::search(RefPtr<JSON::Value> searchProperties, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("search"_s, WTF::move(searchProperties), "query"_s, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISearch::get(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::SearchQueryHaiku("get"_s, "{}"_s, std::nullopt),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPISearch::send(const String& method, RefPtr<JSON::Value> properties, ASCIILiteral textKey, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = properties ? properties->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), method == "query"_s ? "queryInfo"_s : "searchProperties"_s, "an object is expected"_s);
+        return;
+    }
+    auto text = object->getString(textKey);
+    if (text.isNull()) {
+        exception = toErrorString(nullString(), textKey, "a string is expected"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    arguments->setString("text"_s, text);
+    if (RefPtr disposition = object->getValue("disposition"_s)) {
+        // Chrome's CURRENT_TAB/NEW_TAB/NEW_WINDOW; Firefox's lower-case names.
+        auto name = disposition->asString().convertToASCIIUppercase();
+        if (name != "CURRENT_TAB"_s && name != "NEW_TAB"_s && name != "NEW_WINDOW"_s) {
+            exception = toErrorString(nullString(), "disposition"_s, "it must be 'CURRENT_TAB', 'NEW_TAB' or 'NEW_WINDOW'"_s);
+            return;
+        }
+        arguments->setString("disposition"_s, name);
+    }
+    if (RefPtr engine = object->getValue("engine"_s)) {
+        if (engine->asString().isNull()) {
+            exception = toErrorString(nullString(), "engine"_s, "a string is expected"_s);
+            return;
+        }
+        arguments->setString("engine"_s, engine->asString());
+    }
+    std::optional<WebExtensionTabIdentifier> tab;
+    if (RefPtr tabValue = object->getValue("tabId"_s)) {
+        auto number = tabValue->asDouble();
+        tab = number ? toWebExtensionTabIdentifier(*number) : std::nullopt;
+        if (!tab || !isValid(tab)) {
+            exception = toErrorString(nullString(), "tabId"_s, "it is not a tab identifier"_s);
+            return;
+        }
+        if (arguments->getString("disposition"_s).isNull())
+            arguments->setString("disposition"_s, "CURRENT_TAB"_s);
+        else if (arguments->getString("disposition"_s) != "CURRENT_TAB"_s) {
+            exception = toErrorString(nullString(), "tabId"_s, "it cannot be used with a disposition other than 'CURRENT_TAB'"_s);
+            return;
+        }
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::SearchQueryHaiku(method, arguments->toJSONString(), tab),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            callback->call();
+        }, extensionContext().identifier());
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
