+
+void ResourceUsageThread::platformSaveStateBeforeStarting()
+{
+    m_resetCPUSample.store(true);
+#if USE(COORDINATED_GRAPHICS)
+    CoordinatedTileBuffer::resetMemoryUsage();
+#endif
+#if ENABLE(SAMPLING_PROFILER)
+    m_samplingProfilerThreadID.store(0);
+    if (auto* profiler = m_vm->samplingProfiler()) {
+        if (auto* thread = profiler->thread())
+            m_samplingProfilerThreadID.store(thread->id());
+    }
+#endif
+}
+
+void ResourceUsageThread::platformCollectCPUData(JSC::VM*, ResourceUsageData& data)
+{
+    team_usage_info teamUsage;
+    if (get_team_usage_info(getpid(), B_TEAM_USAGE_SELF, &teamUsage) != B_OK)
+        return;
+
+    int64_t now = system_time();
+    int64_t teamTime = teamUsage.user_time + teamUsage.kernel_time;
+    bool reset = m_resetCPUSample.exchange(false) || !m_previousSampleTime;
+    int64_t elapsed = reset ? 0 : now - m_previousSampleTime;
+    auto percent = [elapsed](int64_t delta) -> float {
+        return elapsed > 0 ? 100.0 * std::max<int64_t>(delta, 0) / elapsed : 0;
+    };
+
+    // The team counter includes threads that exited between samples. Summing
+    // only live thread counters would lose their work.
+    data.cpu = reset ? 0 : percent(teamTime - m_previousTeamCPUTime);
+    m_previousSampleTime = now;
+    m_previousTeamCPUTime = teamTime;
+
+    HashSet<pid_t> knownWebKitThreads;
+    for (auto& thread : Thread::allThreads()) {
+        if (auto id = thread.id())
+            knownWebKitThreads.add(id);
+    }
+    HashMap<pid_t, String> knownWorkerThreads;
+    for (auto& thread : WorkerOrWorkletThread::workerOrWorkletThreads()) {
+        if (thread.thread()) {
+            if (auto id = thread.thread()->id())
+                knownWorkerThreads.set(id, thread.inspectorIdentifier().isolatedCopy());
+        }
+    }
+
+    HashMap<int32_t, int64_t> currentThreadTimes;
+    int32 cookie = 0;
+    thread_info info;
+    float debuggerCPU = 0;
+    auto collectorID = Thread::currentID();
+    while (get_next_thread_info(getpid(), &cookie, &info) == B_OK) {
+        int64_t cpuTime = info.user_time + info.kernel_time;
+        currentThreadTimes.set(info.thread, cpuTime);
+        // A new thread's lifetime fits inside this interval. Thread IDs are
+        // native identities, not reusable pthread handles.
+        float usage = reset ? 0 : std::clamp(percent(cpuTime - m_previousThreadCPUTimes.get(info.thread)), 0.0f, 100.0f);
+        bool debugger = info.thread == collectorID;
+#if ENABLE(SAMPLING_PROFILER)
+        debugger |= info.thread == m_samplingProfilerThreadID.load();
+#endif
+        if (debugger) {
+            debuggerCPU += usage;
+            continue;
+        }
+        if (info.thread == getpid()) {
+            data.cpuThreads.append(ThreadCPUInfo { "Main Thread"_s, { }, usage, ThreadCPUInfo::Type::Main });
+            continue;
+        }
+        String name = String::fromUTF8(info.name);
+        String identifier = knownWorkerThreads.get(info.thread);
+        bool webKit = knownWebKitThreads.contains(info.thread) || !identifier.isEmpty() || name == "BMScavenger"_s;
+        data.cpuThreads.append(ThreadCPUInfo { name, identifier, usage, webKit ? ThreadCPUInfo::Type::WebKit : ThreadCPUInfo::Type::Unknown });
+    }
+    m_previousThreadCPUTimes = WTF::move(currentThreadTimes);
+    data.cpuExcludingDebuggerThreads = std::max(0.0f, data.cpu - debuggerCPU);
+}
+
+void ResourceUsageThread::platformCollectMemoryData(JSC::VM* vm, ResourceUsageData& data)
+{
+    // Read the page VM and cache on their owning thread. These categories are
+    // allocation counters, not private physical-memory measurements.
+    callOnMainThreadAndWait([&] {
+        JSC::JSLockHolder locker { vm };
+        size_t extra = vm->heap.extraMemorySize();
+        size_t external = std::min(extra, vm->heap.externalMemorySize());
+        data.categories[MemoryCategory::GCHeap].dirtySize = vm->heap.blockBytesAllocated();
+        data.categories[MemoryCategory::GCOwned].dirtySize = extra - external;
+        data.categories[MemoryCategory::GCOwned].externalSize = external;
+        data.totalExternalSize = external;
+        data.categories[MemoryCategory::Images].dirtySize = MemoryCache::singleton().getStatistics().images.decodedSize;
+        data.timeOfNextEdenCollection = data.timestamp + vm->heap.edenActivityCallback()->timeUntilFire().value_or(Seconds(std::numeric_limits<double>::infinity()));
+        data.timeOfNextFullCollection = data.timestamp + vm->heap.fullActivityCallback()->timeUntilFire().value_or(Seconds(std::numeric_limits<double>::infinity()));
+    });
+
+#if ENABLE(JIT)
+    {
+        Locker locker { JSC::ExecutableAllocator::singleton().getLock() };
+        data.categories[MemoryCategory::JSJIT].dirtySize = JSC::ExecutableAllocator::committedByteCount();
+    }
+#endif
+#if USE(COORDINATED_GRAPHICS)
+    data.categories[MemoryCategory::Layers].dirtySize = CoordinatedTileBuffer::getMemoryUsage();
+#endif
+
+    ProcessMemoryStatus status;
+    currentProcessMemoryStatus(status);
+    // Haiku exposes resident area/cache sizes, not a private dirty total.
+    // copy_count counts copy-on-write events and cannot identify shared RAM.
+    data.totalDirtySize = status.resident;
+    // Categories and resident areas are different estimates, collected at
+    // different instants. Saturate each subtraction to avoid underflow or an
+    // overflowing sum of allocation counters.
+    size_t remaining = status.resident;
+    for (auto& category : data.categories)
+        remaining -= std::min(remaining, category.dirtySize);
+    data.categories[MemoryCategory::Other].dirtySize = remaining;
+}
