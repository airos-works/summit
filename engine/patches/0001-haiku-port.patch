@@ -0,0 +1,176 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace WebKit::USBHaiku {
+
+constexpr size_t maximumTransferSize = 16 * 1024 * 1024;
+constexpr size_t maximumIsochronousPackets = 1024;
+
+struct Endpoint {
+    uint8_t number { 0 };
+    bool input { false };
+    uint8_t type { 0 }; // USB bmAttributes: 1 isochronous, 2 bulk, 3 interrupt.
+    uint16_t packetSize { 0 };
+};
+struct Alternate {
+    uint8_t setting { 0 };
+    uint8_t classCode { 0 };
+    uint8_t subclassCode { 0 };
+    uint8_t protocolCode { 0 };
+    std::string name;
+    std::vector<Endpoint> endpoints;
+};
+struct Interface {
+    uint8_t number { 0 };
+    uint8_t alternate { 0 };
+    bool claimed { false };
+    std::vector<Alternate> alternates;
+};
+struct Configuration {
+    uint8_t value { 0 };
+    std::string name;
+    std::vector<Interface> interfaces;
+};
+struct Device {
+    // These two fields never cross the renderer IPC boundary.
+    std::string path;
+    std::string identity;
+    uint16_t usbVersion { 0 };
+    uint16_t vendorId { 0 };
+    uint16_t productId { 0 };
+    uint16_t deviceVersion { 0 };
+    uint8_t classCode { 0 };
+    uint8_t subclassCode { 0 };
+    uint8_t protocolCode { 0 };
+    uint8_t configuration { 0 };
+    std::string manufacturer;
+    std::string product;
+    std::string serial;
+    std::vector<Configuration> configurations;
+};
+struct Filter {
+    std::optional<uint16_t> vendorId;
+    std::optional<uint16_t> productId;
+    std::optional<uint8_t> classCode;
+    std::optional<uint8_t> subclassCode;
+    std::optional<uint8_t> protocolCode;
+    std::optional<std::string> serialNumber;
+};
+
+inline bool validFilter(const Filter& f)
+{
+    return (!f.productId || f.vendorId) && (!f.subclassCode || f.classCode)
+        && (!f.protocolCode || f.subclassCode) && (!f.serialNumber || f.serialNumber->size() <= 1024);
+}
+
+inline bool protectedClass(uint8_t value)
+{
+    // https://wicg.github.io/webusb/#protected-interface-class
+    switch (value) {
+    case 0x01: case 0x03: case 0x08: case 0x09:
+    case 0x0b: case 0x0e: case 0x10: case 0xe0:
+        return true;
+    default:
+        return false;
+    }
+}
+
+inline bool blocklisted(uint16_t vendor, uint16_t product, uint16_t version)
+{
+    (void)version;
+    // WICG/webusb blocklist.txt, retrieved 2026-10-06. Revisit with engine updates.
+    // Entries currently have no version bounds. Keep tokens out of raw USB.
+    constexpr uint32_t devices[] = {
+        0x096e0850, 0x096e0852, 0x096e0853, 0x096e0854, 0x096e0856,
+        0x096e0858, 0x096e085a, 0x096e085b, 0x096e0880, 0x09c30023,
+        0x10500010, 0x10500018, 0x10500030, 0x10500110, 0x10500111,
+        0x10500112, 0x10500113, 0x10500114, 0x10500115, 0x10500116,
+        0x10500120, 0x10500200, 0x10500211, 0x10500401, 0x10500402,
+        0x10500403, 0x10500404, 0x10500405, 0x10500406, 0x10500407,
+        0x10500410, 0x10c48acf, 0x18d15026, 0x1a4400bb, 0x1d5060fc,
+        0x1e0df1ae, 0x1e0df1d0, 0x1ea8f025, 0x20a04287, 0x24dc0101,
+        0x2581f1d0, 0x2abe1002, 0x2ccf0880
+    };
+    return std::binary_search(std::begin(devices), std::end(devices), (uint32_t(vendor) << 16) | product);
+}
+
+inline bool eligible(const Device& d)
+{
+    if (!d.vendorId || !d.productId || d.configurations.empty()
+        || protectedClass(d.classCode) || blocklisted(d.vendorId, d.productId, d.deviceVersion))
+        return false;
+    // Haiku's raw USB driver cannot reserve a single interface against kernel
+    // drivers. Therefore exclude the entire composite device if *any* alternate
+    // has a protected class. Never reconfigure a keyboard or a mounted disk.
+    bool hasInterface = false;
+    for (auto& configuration : d.configurations) {
+        for (auto& interface : configuration.interfaces) {
+            for (auto& alternate : interface.alternates) {
+                hasInterface = true;
+                if (protectedClass(alternate.classCode))
+                    return false;
+            }
+        }
+    }
+    return hasInterface;
+}
+
+inline bool matches(const Device& d, const Filter& f)
+{
+    if (!validFilter(f) || (f.vendorId && *f.vendorId != d.vendorId)
+        || (f.productId && *f.productId != d.productId)
+        || (f.serialNumber && *f.serialNumber != d.serial))
+        return false;
+    if (!f.classCode)
+        return true;
+    auto matchesClass = [&](uint8_t c, uint8_t s, uint8_t p) {
+        return *f.classCode == c && (!f.subclassCode || *f.subclassCode == s)
+            && (!f.protocolCode || *f.protocolCode == p);
+    };
+    if (matchesClass(d.classCode, d.subclassCode, d.protocolCode))
+        return true;
+    for (auto& c : d.configurations) {
+        for (auto& i : c.interfaces) {
+            for (auto& a : i.alternates) {
+                if (matchesClass(a.classCode, a.subclassCode, a.protocolCode))
+                    return true;
+            }
+        }
+    }
+    return false;
+}
+
+inline bool matches(const Device& d, const std::vector<Filter>& include, const std::vector<Filter>& exclude)
+{
+    return eligible(d) && (include.empty() || std::any_of(include.begin(), include.end(), [&](auto& f) { return matches(d, f); }))
+        && std::none_of(exclude.begin(), exclude.end(), [&](auto& f) { return matches(d, f); });
+}
+
+inline bool allowedStandardControl(bool input, uint8_t request)
+{
+    // WebUSB permits only these read-only standard requests. State changes
+    // must go through selectConfiguration/selectAlternateInterface/clearHalt.
+    return input && (request == 0 || request == 6 || request == 8 || request == 10 || request == 12);
+}
+
+inline bool validPacketLengths(const std::vector<uint32_t>& lengths, size_t& total)
+{
+    total = 0;
+    if (lengths.size() > maximumIsochronousPackets)
+        return false;
+    for (auto length : lengths) {
+        // Haiku's usb_iso_packet_descriptor uses a signed 16-bit length.
+        if (length > 32767 || length > maximumTransferSize - total)
+            return false;
+        total += length;
+    }
+    return true;
+}
+
+} // namespace WebKit::USBHaiku
