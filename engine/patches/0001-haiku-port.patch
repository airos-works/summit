diff --git a/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.cpp b/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..02d3134aae723398272d2ae66de2cef304318dbd
--- /dev/null
+++ b/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.cpp
@@ -0,0 +1,44 @@
+// Copyright (C) 2026 Summit contributors. BSD-2-Clause.
+#if __has_include("config.h")
+#include "config.h"
+#endif
+#include "CencCryptoHaiku.h"
+#include <openssl/evp.h>
+#include <algorithm>
+#include <climits>
+#include <memory>
+
+namespace SummitMP4 {
+
+bool decryptCenc(std::span<const uint8_t> input, const CencSample& sample,
+    const std::array<uint8_t, 16>& key, std::vector<uint8_t>& output)
+{
+    if (!validCencSample(sample, input.size())) return false;
+    std::array<uint8_t, 16> counter { };
+    std::copy(sample.iv.begin(), sample.iv.end(), counter.begin());
+    std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)> context(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+    if (!context || EVP_DecryptInit_ex(context.get(), EVP_aes_128_ctr(), nullptr, key.data(), counter.data()) != 1)
+        return false;
+    std::vector<uint8_t> result(input.begin(), input.end());
+    auto decrypt = [&](size_t at, size_t count) {
+        if (!count) return true;
+        int written = 0;
+        return count <= INT_MAX && EVP_DecryptUpdate(context.get(), result.data() + at, &written, input.data() + at, int(count)) == 1 && written == int(count);
+    };
+    if (sample.subsamples.empty()) {
+        if (!decrypt(0, input.size())) return false;
+    } else {
+        size_t at = 0;
+        for (const auto& entry : sample.subsamples) {
+            at += entry.clearBytes;
+            if (!decrypt(at, entry.encryptedBytes)) return false;
+            at += entry.encryptedBytes;
+        }
+    }
+    std::array<uint8_t, 16> finalBytes { };
+    int written = 0;
+    if (EVP_DecryptFinal_ex(context.get(), finalBytes.data(), &written) != 1 || written) return false;
+    output = std::move(result);
+    return true;
+}
+} // namespace SummitMP4
diff --git a/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.h b/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..d77546c5a2050ae628523b3befeb7c7ebd2897bc
--- /dev/null
+++ b/Source/WebCore/platform/graphics/haiku/CencCryptoHaiku.h
@@ -0,0 +1,38 @@
+// Copyright (C) 2026 Summit contributors. BSD-2-Clause.
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace SummitMP4 {
+struct CencSubsample {
+    uint32_t clearBytes { 0 };
+    uint32_t encryptedBytes { 0 };
+};
+struct CencSample {
+    std::array<uint8_t, 16> keyID { };
+    std::vector<uint8_t> iv;
+    std::vector<CencSubsample> subsamples;
+};
+// AES-128 CTR. Clear bytes do not consume the keystream. Failure leaves output
+// unchanged, and never exposes a partially decrypted sample to a decoder.
+bool decryptCenc(std::span<const uint8_t> input, const CencSample&,
+    const std::array<uint8_t, 16>& key, std::vector<uint8_t>& output);
+inline bool validCencSample(const CencSample& sample, size_t size)
+{
+    if ((sample.iv.size() != 8 && sample.iv.size() != 16) || size > 64 * 1024 * 1024 || sample.subsamples.size() > 65535)
+        return false;
+    if (sample.subsamples.empty()) return true;
+    size_t remaining = size;
+    for (const auto& entry : sample.subsamples) {
+        if (entry.clearBytes > remaining) return false;
+        remaining -= entry.clearBytes;
+        if (entry.encryptedBytes > remaining) return false;
+        remaining -= entry.encryptedBytes;
+    }
+    return !remaining;
+}
+
+} // namespace SummitMP4
