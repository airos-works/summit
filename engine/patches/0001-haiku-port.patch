+
+    bool opened() const { return m_opened; }
+    uint16_t vendorId() const;
+    uint16_t productId() const;
+    String productName() const;
+    JSC::JSValue collections(JSC::JSGlobalObject&) const;
+    String identifier() const { return m_identifier; }
+    bool forgotten() const { return m_forgotten; }
+    void update(Ref<JSON::Object>&&);
+    void disconnected();
+
+    void open(DOMPromiseDeferred<void>&&);
+    void close(DOMPromiseDeferred<void>&&);
+    void forget(DOMPromiseDeferred<void>&&);
+    void sendReport(uint8_t reportId, BufferSource&&, DOMPromiseDeferred<void>&&);
+    void sendFeatureReport(uint8_t reportId, BufferSource&&, DOMPromiseDeferred<void>&&);
+    void receiveFeatureReport(uint8_t reportId, DOMPromiseDeferred<IDLDataView>&&);
+
+private:
+    HIDDevice(Document&, Ref<JSON::Object>&&);
+    EventTargetInterfaceType eventTargetInterface() const final { return EventTargetInterfaceType::HIDDevice; }
+    void refEventTarget() final { ref(); }
+    void derefEventTarget() final { deref(); }
+    void stop() final;
+    bool virtualHasPendingActivity() const final;
+    Document* document() const;
+    Ref<JSON::Object> arguments(ASCIILiteral operation) const;
+    void changeState(ASCIILiteral operation, DOMPromiseDeferred<void>&&);
+    void send(ASCIILiteral operation, uint8_t reportId, BufferSource&&, DOMPromiseDeferred<void>&&);
+    void receive();
+    Ref<JSON::Object> m_data;
+    String m_identifier;
+    String m_collections;
+    uint64_t m_generation { 0 };
+    bool m_opened { false };
+    bool m_busy { false };
+    bool m_receiving { false };
+    bool m_forgotten { false };
+    bool m_stopped { false };
+};
+} // namespace WebCore
+SPECIALIZE_TYPE_TRAITS_EVENTTARGET(HIDDevice)
+#endif
