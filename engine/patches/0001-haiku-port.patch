+}
+
+namespace WebCore {
+class Document;
+
+class HIDDevice final : public RefCounted<HIDDevice>, public EventTarget, public ActiveDOMObject {
+    WTF_MAKE_TZONE_ALLOCATED(HIDDevice);
+public:
+    static Ref<HIDDevice> create(Document&, Ref<JSON::Object>&&);
+    ~HIDDevice();
+    void ref() const final { RefCounted::ref(); }
