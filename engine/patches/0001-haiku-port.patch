+namespace SummitMPEGTS {
+
+// Incremental MPEG-TS demuxing through the installed FFmpeg public API. Only
+// this parser's worker enters FFmpeg; callbacks run synchronously on append's
+// caller. The worker waits for input instead of treating an append boundary
+// as end-of-stream, which would truncate a PES packet or an access unit.
+class Parser {
+public:
+    Parser();
+    ~Parser();
+    Parser(const Parser&) = delete;
+    Parser& operator=(const Parser&) = delete;
+    static bool available();
+    std::function<void(SummitMP4::InitSegment&&)> onInitSegment;
+    std::function<void(SummitMP4::Sample&&)> onSample;
+    bool append(const uint8_t*, size_t);
+    bool finish();
+    void reset();
+    bool resetTimestampOffset();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace SummitMPEGTS
