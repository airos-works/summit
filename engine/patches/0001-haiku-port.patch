+bool Pasteboard::hasData()
+{
+    if (m_forDragAndDrop)
+        return !m_dragFileNames.isEmpty() || m_dragData.hasData();
+    bool result = false;
+
+    if (be_clipboard->Lock()) {
+        BMessage* data = be_clipboard->Data();
+
+        if (data)
+            result = !data->IsEmpty();
+
+        be_clipboard->Unlock();
+    }
+
+    return result;
