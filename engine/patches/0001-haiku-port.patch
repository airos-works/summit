@@ -0,0 +1,418 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEB_BLUETOOTH)
+#include "WebBluetoothBrokerHaiku.h"
+#include "BluetoothGATTHaiku.h"
+#include "SitePermissionsHaiku.h"
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/UUID.h>
+#include <wtf/text/MakeString.h>
+#include <unordered_map>
+
+namespace WebKit {
+using namespace BluetoothHaiku;
+using BluetoothUUID = WebCore::BluetoothHaiku::UUID;
+static String fromUTF8(const std::string& string) { return String::fromUTF8ReplacingInvalidSequences(std::span(reinterpret_cast<const char8_t*>(string.data()), string.size())); }
+static std::string toUTF8(const String& string)
+{ auto bytes = string.utf8(); return { bytes.legacyCStringPointer(), bytes.length() }; }
+static String error(ASCIILiteral name, ASCIILiteral message)
+{
+    auto object = JSON::Object::create();
+    object->setString("error"_s, name); object->setString("message"_s, message);
+    return object->toJSONString();
+}
+static Ref<JSON::Object> deviceJSON(const Device& device, const String& id)
+{
+    auto object = JSON::Object::create();
+    object->setString("id"_s, id);
+    if (!device.advertisement.name.empty()) object->setString("name"_s, fromUTF8(device.advertisement.name));
+    return object;
+}
+static std::optional<BluetoothUUID> uuidValue(const JSON::Value& value)
+{
+    auto string = value.asString();
+    return string.isNull() ? std::nullopt : BluetoothUUID::parse(toUTF8(string));
+}
+static std::optional<std::set<BluetoothUUID>> servicesArray(const JSON::Array& array)
+{
+    if (array.length() > 128) return std::nullopt;
+    std::set<BluetoothUUID> result;
+    for (auto& value : array) {
+        auto uuid = uuidValue(value.get());
+        if (!uuid || blocked(*uuid)) return std::nullopt;
+        result.insert(*uuid);
+    }
+    return result;
+}
+static bool bytesArray(const JSON::Object& object, ASCIILiteral key, std::vector<uint8_t>& output)
+{
+    auto value = object.getValue(key);
+    if (!value) return true;
+    auto array = value->asArray();
+    if (!array || array->length() > 512) return false;
+    for (auto& entry : *array) {
+        auto byte = entry->asInteger();
+        if (!byte || *byte < 0 || *byte > 255) return false;
+        output.push_back(*byte);
+    }
+    return true;
+}
+static std::optional<std::vector<Filter>> filters(const JSON::Object& args, ASCIILiteral key)
+{
+    auto value = args.getValue(key);
+    if (!value) return std::vector<Filter> { };
+    auto array = value->asArray();
+    if (!array || array->length() > 64 || !array->length()) return std::nullopt;
+    std::vector<Filter> output;
+    for (auto& entry : *array) {
+        auto object = entry->asObject();
+        if (!object) return std::nullopt;
+        Filter filter;
+        if (auto name = object->getValue("name"_s)) {
+            auto string = name->asString(); if (string.isNull()) return std::nullopt;
+            filter.name = toUTF8(string);
+        }
+        if (auto name = object->getValue("namePrefix"_s)) {
+            auto string = name->asString(); if (string.isNull()) return std::nullopt;
+            filter.namePrefix = toUTF8(string);
+        }
+        if (auto value = object->getValue("services"_s)) {
+            auto array = value->asArray();
+            auto services = array ? servicesArray(*array) : std::nullopt;
+            if (!services || services->empty()) return std::nullopt;
+            filter.services.assign(services->begin(), services->end());
+        }
+        for (bool manufacturer : { true, false }) {
+            auto data = object->getValue(manufacturer ? "manufacturerData"_s : "serviceData"_s);
+            if (!data) continue;
+            auto array = data->asArray();
+            if (!array || !array->length() || array->length() > 64) return std::nullopt;
+            for (auto& entry : *array) {
+                auto object = entry->asObject();
+                DataFilter dataFilter;
+                if (!object || !bytesArray(*object, "dataPrefix"_s, dataFilter.prefix) || !bytesArray(*object, "mask"_s, dataFilter.mask)
+                    || !dataFilter.valid() || (object->getValue("mask"_s) && dataFilter.mask.size() != dataFilter.prefix.size())) return std::nullopt;
+                if (manufacturer) {
+                    auto company = object->getInteger("companyIdentifier"_s);
+                    if (!company || *company < 0 || *company > 65535 || filter.manufacturerData.contains(*company)) return std::nullopt;
+                    filter.manufacturerData.emplace(*company, std::move(dataFilter));
+                } else {
+                    auto service = object->getValue("service"_s);
+                    auto uuid = service ? uuidValue(*service) : std::nullopt;
+                    if (!uuid || blocked(*uuid) || filter.serviceData.contains(*uuid)) return std::nullopt;
+                    filter.serviceData.emplace(*uuid, std::move(dataFilter));
+                }
+            }
+        }
+        if (!filter.valid()) return std::nullopt;
+        output.push_back(std::move(filter));
+    }
+    return output;
+}
+
+struct WebBluetoothBrokerHaiku::Connection {
+    Connection(const Device& device, Ref<WorkQueue>&& serialQueue)
+        : queue(WTF::move(serialQueue)), session(std::make_shared<Session>(device)), generation(WTF::UUID::createVersion4().toString()) { }
+    static auto& peers()
+    {
+        // Main thread, across normal/private contexts. A closing connection
+        // retains its queue so a replacement waits for native link cleanup.
+        static NeverDestroyed<std::unordered_map<std::string, std::weak_ptr<Connection>>> peers;
+        return peers.get();
+    }
+    Ref<WorkQueue> queue;
+    std::shared_ptr<Session> session;
+    std::unique_ptr<GATTConnection> gatt; // Worker queue only.
+    String generation; // Main thread only; isolated copy crosses queues.
+    std::atomic<bool> closing { false };
+};
+static Ref<WorkQueue> scanQueue()
+{
+    static NeverDestroyed<Ref<WorkQueue>> queue(WorkQueue::create("WebKit.Bluetooth.Scan"_s, WorkQueue::QOS::Utility));
+    return queue.get().copyRef();
+}
+static std::string peerKey(const Device& device)
+{
+    std::string key(reinterpret_cast<const char*>(device.address.data()), device.address.size());
+    key += char(device.addressType);
+    return key;
+}
+std::shared_ptr<WebBluetoothBrokerHaiku> WebBluetoothBrokerHaiku::create(std::shared_ptr<SitePermissionsHaiku> permissions)
+{ return std::shared_ptr<WebBluetoothBrokerHaiku>(new WebBluetoothBrokerHaiku(std::move(permissions))); }
+WebBluetoothBrokerHaiku::WebBluetoothBrokerHaiku(std::shared_ptr<SitePermissionsHaiku> permissions)
+    : m_permissions(std::move(permissions)), m_scanQueue(scanQueue()) { }
+WebBluetoothBrokerHaiku::~WebBluetoothBrokerHaiku() { shutdown(); }
+
+void WebBluetoothBrokerHaiku::choose(uint64_t page, const String& owner, const String& origin, const BMessenger& view,
+    Ref<JSON::Object>&& args, std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    auto include = filters(args.get(), "filters"_s), exclude = filters(args.get(), "exclusionFilters"_s);
+    auto optional = args->getArray("optionalServices"_s);
+    auto services = optional ? servicesArray(*optional) : std::optional { std::set<BluetoothUUID> { } };
+    bool all = args->getBoolean("acceptAllDevices"_s).value_or(false);
+    if (!include || !exclude || !services || (all == !!args->getValue("filters"_s))
+        || (all && args->getValue("exclusionFilters"_s))
+        || (args->getValue("optionalServices"_s) && !optional)) {
+        completion(error("TypeError"_s, "Invalid Bluetooth device filters"_s), { }); return;
+    }
+    for (auto& filter : *include) services->insert(filter.services.begin(), filter.services.end());
+    if (m_scans.size() >= 4) { completion(error("InvalidStateError"_s, "A Bluetooth chooser is already pending"_s), { }); return; }
+    auto identifier = ++m_nextScan;
+    auto cancelled = std::make_shared<std::atomic<bool>>(false);
+    m_scans.add(identifier, Scan { page, cancelled, view });
+    m_scanQueue->dispatch([self = shared_from_this(), page, identifier, cancelled, owner = owner.isolatedCopy(), origin = origin.isolatedCopy(), view,
+        include = std::move(*include), exclude = std::move(*exclude), services = std::move(*services), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+        std::vector<Device> devices;
+        auto result = scan(devices, *cancelled);
+        std::erase_if(devices, [&](auto& device) { return !matches(device.advertisement, include, exclude); });
+        RunLoop::mainSingleton().dispatch([self, page, identifier, cancelled, result, owner = owner.isolatedCopy(), origin = origin.isolatedCopy(), view,
+            devices = std::move(devices), services = std::move(services), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            if (self->m_shutdown || *cancelled || !isCurrent()) {
+                self->m_scans.remove(identifier); completion(error("AbortError"_s, "The Bluetooth document was closed"_s), { }); return;
+            }
+            if (result != NativeError::None || devices.empty()) {
+                self->m_scans.remove(identifier); completion(error("NotFoundError"_s, "No matching Bluetooth device is advertising"_s), { }); return;
+            }
+            Vector<std::pair<String, String>> choices;
+            Vector<String> tokens;
+            for (auto& device : devices) {
+                auto token = WTF::UUID::createVersion4().toString();
+                auto label = fromUTF8(device.advertisement.name.empty() ? "Unnamed Bluetooth device" : device.advertisement.name);
+                label = makeStringByReplacingAll(makeStringByReplacingAll(label, '\n', ' '), '\r', ' ');
+                label = makeStringByReplacingAll(label, '\0', ' ');
+                choices.append({ token, label }); tokens.append(token);
+            }
+            self->m_permissions->requestBluetooth(origin, view, WTF::move(choices),
+                [self, identifier, cancelled, devices = std::move(devices), tokens = WTF::move(tokens), services = std::move(services), origin,
+                    isCurrent = std::move(isCurrent), completion = WTF::move(completion)](bool allowed, const String& selected) mutable {
+                    self->m_scans.remove(identifier);
+                    if (self->m_shutdown || *cancelled || !isCurrent()) { completion(error("AbortError"_s, "The Bluetooth document was closed"_s), { }); return; }
+                    auto index = tokens.find(selected);
+                    if (!allowed || index == notFound || index >= devices.size()) { completion(error("NotFoundError"_s, "No Bluetooth device was selected"_s), { }); return; }
+                    auto& device = devices[index];
+                    String token;
+                    for (auto& entry : self->m_grants) if (entry.value->origin == origin && entry.value->device.samePeer(device)) {
+                        token = entry.key;
+                        entry.value->services.insert(services.begin(), services.end());
+                        entry.value->device = device;
+                        break;
+                    }
+                    if (token.isEmpty()) {
+                        if (self->m_grants.size() >= 256) { completion(error("NotAllowedError"_s, "Too many Bluetooth device grants"_s), { }); return; }
+                        token = WTF::UUID::createVersion4().toString();
+                        self->m_grants.add(token, std::make_unique<Grant>(Grant { origin, device, std::move(services), { }, 0, nullptr, 0 }));
+                    }
+                    auto object = JSON::Object::create(); object->setObject("device"_s, deviceJSON(device, token));
+                    completion(object->toJSONString(), { });
+                });
+        });
+    });
+}
+
+static bool validOperation(const JSON::Object& args, size_t bytes)
+{
+    auto op = args.getString("operation"_s);
+    if (op == "connect"_s || op == "disconnect"_s || op == "forget"_s || op == "poll"_s) return !bytes;
+    if (auto uuid = args.getValue("uuid"_s); uuid && !uuidValue(*uuid)) return false;
+    if (op == "services"_s) return !bytes;
+    auto handle = args.getInteger("handle"_s);
+    if (!handle || *handle < 1 || *handle > 65535) return false;
+    if (op == "includedServices"_s || op == "characteristics"_s || op == "descriptors"_s) return !bytes;
+    if (op == "notifications"_s) return !bytes && args.getBoolean("enable"_s).has_value();
+    if (!args.getBoolean("descriptor"_s)) return false;
+    if (op == "read"_s) return !bytes;
+    return op == "write"_s && bytes <= 512 && args.getBoolean("response"_s).has_value();
+}
+static void appendNotifications(JSON::Object& object, const std::vector<Notification>& notifications)
+{
+    auto array = JSON::Array::create();
+    for (auto& notification : notifications) {
+        auto item = JSON::Object::create(); item->setInteger("handle"_s, notification.handle);
+        auto bytes = JSON::Array::create(); for (auto byte : notification.value) bytes->pushInteger(byte);
+        item->setArray("value"_s, WTF::move(bytes)); array->pushObject(WTF::move(item));
+    }
+    object.setArray("notifications"_s, WTF::move(array));
+}
+static GATTResult operate(GATTConnection& gatt, const JSON::Object& args, std::span<const uint8_t> bytes, JSON::Object& object, std::vector<uint8_t>& output)
+{
+    auto op = args.getString("operation"_s);
+    uint16_t handle = args.getInteger("handle"_s).value_or(0);
+    auto value = args.getValue("uuid"_s); auto query = value ? uuidValue(*value) : std::nullopt;
+    auto array = JSON::Array::create();
+    GATTResult result;
+    if (op == "services"_s || op == "includedServices"_s) {
+        std::vector<Service> services;
+        result = op == "services"_s ? gatt.services(query, services) : gatt.includedServices(handle, query, services);
+        for (auto& service : services) {
+            auto item = JSON::Object::create(); item->setInteger("handle"_s, service.start);
+            item->setString("uuid"_s, fromUTF8(service.uuid.string())); item->setBoolean("primary"_s, service.primary); array->pushObject(WTF::move(item));
+        }
+    } else if (op == "characteristics"_s) {
+        std::vector<GATTCharacteristic> characteristics; result = gatt.characteristics(handle, query, characteristics);
+        for (auto& characteristic : characteristics) {
+            auto item = JSON::Object::create(); item->setInteger("handle"_s, characteristic.attribute.value);
+            item->setString("uuid"_s, fromUTF8(characteristic.attribute.uuid.string())); item->setInteger("properties"_s, characteristic.attribute.properties);
+            item->setInteger("extendedProperties"_s, characteristic.extendedProperties); array->pushObject(WTF::move(item));
+        }
+    } else if (op == "descriptors"_s) {
+        std::vector<GATTDescriptor> descriptors; result = gatt.descriptors(handle, query, descriptors);
+        for (auto& descriptor : descriptors) {
+            auto item = JSON::Object::create(); item->setInteger("handle"_s, descriptor.attribute.handle);
+            item->setString("uuid"_s, fromUTF8(descriptor.attribute.uuid.string())); array->pushObject(WTF::move(item));
+        }
+    } else if (op == "read"_s) result = gatt.read(handle, args.getBoolean("descriptor"_s).value_or(false), output);
+    else if (op == "write"_s) result = gatt.write(handle, args.getBoolean("descriptor"_s).value_or(false), bytes, args.getBoolean("response"_s).value_or(true));
+    else if (op == "notifications"_s) result = gatt.notifications(handle, args.getBoolean("enable"_s).value_or(false));
+    object.setArray("items"_s, WTF::move(array));
+    return result;
+}
+static ASCIILiteral gattErrorName(const GATTResult& result)
+{
+    switch (result.error) {
+    case GATTError::Security: return "SecurityError"_s;
+    case GATTError::NotFound: return "NotFoundError"_s;
+    case GATTError::InvalidState: return "InvalidStateError"_s;
+    case GATTError::NotSupported: return "NotSupportedError"_s;
+    case GATTError::ATT:
+        if (result.att.error == ATTError::InvalidLength) return "InvalidModificationError"_s;
+        if (result.att.error == ATTError::Remote && (result.att.remoteError == 5 || result.att.remoteError == 8 || result.att.remoteError == 15)) return "NotAllowedError"_s;
+        return "NetworkError"_s;
+    case GATTError::None: return ""_s;
+    }
+    return "NetworkError"_s;
+}
+
+void WebBluetoothBrokerHaiku::request(uint64_t page, const String& owner, const String& origin, const BMessenger& view,
+    const String& arguments, Vector<uint8_t>&& bytes, std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown || !isCurrent()) { completion(error("AbortError"_s, "The Bluetooth document was closed"_s), { }); return; }
+    if (arguments.length() > 65536 || bytes.size() > 512 || origin.isEmpty() || origin == "null"_s) { completion(error("SecurityError"_s, "Invalid Bluetooth request"_s), { }); return; }
+    auto parsed = JSON::Value::parseJSON(arguments); auto args = parsed ? parsed->asObject() : nullptr;
+    if (!args) { completion(error("TypeError"_s, "Invalid Bluetooth request"_s), { }); return; }
+    auto op = args->getString("operation"_s);
+    if (op == "getAvailability"_s && bytes.isEmpty()) {
+        if (m_pendingAvailability >= 16) { completion(error("InvalidStateError"_s, "Too many Bluetooth availability requests"_s), { }); return; }
+        ++m_pendingAvailability;
+        m_scanQueue->dispatch([self = shared_from_this(), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            bool present = available();
+            RunLoop::mainSingleton().dispatch([self, present, isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+                --self->m_pendingAvailability;
+                if (self->m_shutdown || !isCurrent()) { completion(error("AbortError"_s, "The Bluetooth document was closed"_s), { }); return; }
+                completion(present ? "{\"available\":true}"_s : "{\"available\":false}"_s, { });
+            });
+        });
+        return;
+    }
+    if (op == "requestDevice"_s && bytes.isEmpty()) { choose(page, owner, origin, view, args.releaseNonNull(), std::move(isCurrent), WTF::move(completion)); return; }
+    if (op == "getDevices"_s && bytes.isEmpty()) {
+        auto object = JSON::Object::create(); auto devices = JSON::Array::create();
+        for (auto& grant : m_grants) if (grant.value->origin == origin) devices->pushObject(deviceJSON(grant.value->device, grant.key));
+        object->setArray("devices"_s, WTF::move(devices)); completion(object->toJSONString(), { }); return;
+    }
+    auto token = args->getString("id"_s); auto found = m_grants.find(token);
+    if (found == m_grants.end() || found->value->origin != origin) { completion(error("SecurityError"_s, "This origin has no grant for the Bluetooth device"_s), { }); return; }
+    if (!validOperation(*args, bytes.size())) { completion(error("TypeError"_s, "Invalid Bluetooth operation"_s), { }); return; }
+    auto& grant = *found->value;
+    if (op == "forget"_s) { closeGrant(grant); m_grants.remove(found); completion("{}"_s, { }); return; }
+    if (op == "disconnect"_s) {
+        if (grant.connection && grant.owner == owner && (args->getString("generation"_s).isEmpty() || args->getString("generation"_s) == grant.connection->generation)) closeGrant(grant);
+        completion("{}"_s, { }); return;
+    }
+    if (grant.pending >= 8 || (grant.connection && (grant.owner != owner || grant.connection->closing))) {
+        completion(error("InvalidStateError"_s, "The Bluetooth connection is busy"_s), { }); return;
+    }
+    bool connecting = op == "connect"_s;
+    if (connecting && !grant.connection) {
+        auto& peers = Connection::peers();
+        std::erase_if(peers, [](auto& entry) { return entry.second.expired(); });
+        auto key = peerKey(grant.device); auto existing = peers.find(key);
+        auto previous = existing == peers.end() ? nullptr : existing->second.lock();
+        if (previous && !previous->closing) { completion(error("InvalidStateError"_s, "Another page is using this Bluetooth device"_s), { }); return; }
+        auto queue = previous ? previous->queue.copyRef() : WorkQueue::create("WebKit.Bluetooth.GATT"_s, WorkQueue::QOS::Utility);
+        grant.connection = std::make_shared<Connection>(grant.device, WTF::move(queue)); grant.owner = owner; grant.page = page;
+        peers[key] = grant.connection;
+    }
+    if (!grant.connection || (!connecting && args->getString("generation"_s) != grant.connection->generation)) {
+        completion(op == "poll"_s ? "{\"connected\":false}"_s : error("NetworkError"_s, "The Bluetooth server is disconnected"_s), { }); return;
+    }
+    auto connection = grant.connection;
+    ++grant.pending;
+    connection->queue->dispatch([self = shared_from_this(), connection, token = token.isolatedCopy(), generation = connection->generation.isolatedCopy(),
+        arguments = arguments.isolatedCopy(), services = grant.services, bytes = WTF::move(bytes), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+        auto parsed = JSON::Value::parseJSON(arguments); auto args = parsed->asObject(); auto op = args->getString("operation"_s);
+        auto object = JSON::Object::create(); std::vector<uint8_t> output; GATTResult result;
+        bool close = connection->closing;
+        if (!close && op == "connect"_s && !connection->gatt) {
+            auto status = connection->session->connect();
+            if (status != NativeError::None) {
+                close = true;
+                object->setString("error"_s, status == NativeError::Busy ? "InvalidStateError"_s : "NetworkError"_s);
+                object->setString("message"_s, status == NativeError::Busy ? "The Bluetooth controller is already in use by another application"_s : "The Bluetooth connection could not be established"_s);
+            }
+            else {
+                connection->gatt = std::make_unique<GATTConnection>(connection->session->client(), services);
+                result = connection->gatt->initialize(); close = !result;
+            }
+        }
+        if (!close && connection->gatt) {
+            connection->gatt->addGrants(services);
+            std::vector<Notification> notifications;
+            result = connection->gatt->poll(notifications);
+            appendNotifications(object, notifications);
+            if (!result || !connection->session->connected()) close = true;
+            else if (op != "connect"_s && op != "poll"_s) result = operate(*connection->gatt, *args, bytes.span(), object, output);
+        }
+        if (!result) {
+            object->setString("error"_s, gattErrorName(result));
+            object->setString("message"_s, result.error == GATTError::Security ? "The requested GATT attribute is not permitted"_s : "The Bluetooth operation could not be completed"_s);
+            close |= result.error == GATTError::InvalidState || (result.error == GATTError::ATT && result.att.error != ATTError::Remote && result.att.error != ATTError::InvalidLength);
+        }
+        if (close) {
+            connection->closing = true; connection->gatt.reset(); connection->session->disconnect();
+            if (op != "poll"_s && !object->getValue("error"_s)) object->setString("error"_s, "NetworkError"_s);
+        }
+        object->setBoolean("connected"_s, !close);
+        object->setString("generation"_s, generation);
+        RunLoop::mainSingleton().dispatch([self, connection, token = token.isolatedCopy(), close, response = object->toJSONString().isolatedCopy(),
+            bytes = Vector<uint8_t>(std::span<const uint8_t>(output)), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            auto found = self->m_grants.find(token);
+            if (found != self->m_grants.end() && found->value->connection == connection) {
+                --found->value->pending;
+                if (close) self->closeGrant(*found->value);
+            }
+            if (self->m_shutdown || !isCurrent()) { completion(error("AbortError"_s, "The Bluetooth document was closed"_s), { }); return; }
+            completion(WTF::move(response), WTF::move(bytes));
+        });
+    });
+}
+void WebBluetoothBrokerHaiku::closeGrant(Grant& grant)
+{
+    if (auto connection = std::exchange(grant.connection, nullptr)) {
+        connection->closing = true; connection->session->abort();
+        connection->queue->dispatch([connection] { connection->gatt.reset(); connection->session->disconnect(); });
+    }
+    grant.owner = { }; grant.page = 0; grant.pending = 0;
+}
+void WebBluetoothBrokerHaiku::cancelPage(uint64_t page)
+{
+    ASSERT(RunLoop::isMain());
+    Vector<BMessenger> views;
+    for (auto& scan : m_scans) if (scan.value.page == page) { *scan.value.cancelled = true; views.append(scan.value.view); }
+    for (auto& view : views) m_permissions->cancelBluetoothRequests(view);
+    for (auto& grant : m_grants) if (grant.value->page == page) closeGrant(*grant.value);
+}
+void WebBluetoothBrokerHaiku::shutdown()
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown) return;
+    m_shutdown = true;
+    Vector<BMessenger> views;
+    for (auto& scan : m_scans) { *scan.value.cancelled = true; views.append(scan.value.view); }
+    for (auto& view : views) m_permissions->cancelBluetoothRequests(view);
+    for (auto& grant : m_grants) closeGrant(*grant.value);
+    m_grants.clear();
+}
+}
+#endif
