+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "ResourceLoader.h"
+
+#if ENABLE(PDFJS)
+#include "PDFJSResourcesHaiku.h"
+#include "ResourceError.h"
+#include "SharedBuffer.h"
+#include <wtf/RunLoop.h>
+#include <wtf/text/CString.h>
+#include <zlib.h>
+
+namespace WebCore {
+void ResourceLoader::loadPDFJSResourceHaiku()
+{
+    // Delivery is deferred until WebLoaderStrategy has registered the load.
+    RunLoop::mainSingleton().dispatch([loader = Ref { *this }] {
+        if (loader->reachedTerminalState() || loader->wasCancelled()) return;
+        auto url = loader->request().url();
+        auto path = url.path().toString().utf8();
+        const PDFJSResourceHaiku* resource = nullptr;
+        if (loader->isPDFJSResourceLoad() && url.host() == "pdfjs"_s && !url.port()
+            && loader->request().httpMethod() == "GET"_s && path.length() < 512)
+            resource = findPDFJSResourceHaiku({ path.legacyCStringPointer(), path.length() });
+        if (!resource) {
+            loader->didFail(ResourceError("PDFJS"_s, 1, url, "The PDF viewer resource is unavailable"_s));
+            return;
+        }
+        Vector<uint8_t> data(resource->size);
+        uLongf size = data.size();
+        if (uncompress(data.mutableSpan().data(), &size, resource->bytes, resource->compressedSize) != Z_OK
+            || size != resource->size) {
+            loader->didFail(ResourceError("PDFJS"_s, 2, url, "Could not decode a PDF viewer resource"_s));
+            return;
+        }
