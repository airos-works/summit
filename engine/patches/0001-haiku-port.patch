+
+namespace WebKit {
+
+// chrome.search.query and Firefox's search.search/get. Each call becomes one
+// SearchQueryHaiku message, which the UI process forwards to the host browser
+// as a SEARCH browser command (with the tab, when one is named).
+class WebExtensionAPISearch : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPISearch, search, search);
