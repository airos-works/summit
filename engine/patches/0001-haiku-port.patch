diff --git a/Source/WebCore/page/ProtocolHandlerUtilities.h b/Source/WebCore/page/ProtocolHandlerUtilities.h
new file mode 100644
index 0000000000000000000000000000000000000000..a98fad150b4dabf1b3429d078eef8f6227c918e6
--- /dev/null
+++ b/Source/WebCore/page/ProtocolHandlerUtilities.h
@@ -0,0 +1,25 @@
+// Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+#include <wtf/text/WTFString.h>
+#include <wtf/text/ASCIILiteral.h>
+
+namespace WebCore {
+inline bool isAllowedProtocolHandlerScheme(const String& scheme)
+{
+    static constexpr ASCIILiteral allowed[] = { "bitcoin"_s, "ftp"_s, "ftps"_s, "geo"_s,
+        "im"_s, "irc"_s, "ircs"_s, "magnet"_s, "mailto"_s, "matrix"_s, "mms"_s,
+        "news"_s, "nntp"_s, "openpgp4fpr"_s, "sftp"_s, "sip"_s, "sms"_s, "smsto"_s,
+        "ssh"_s, "tel"_s, "urn"_s, "webcal"_s, "wtai"_s, "xmpp"_s };
+    for (auto value : allowed) {
+        if (scheme == value)
+            return true;
+    }
+    if (!scheme.startsWith("web+"_s) || scheme.length() <= 4)
+        return false;
+    for (unsigned i = 4; i < scheme.length(); ++i) {
+        if (scheme[i] < 'a' || scheme[i] > 'z')
+            return false;
+    }
+    return true;
+}
+}
