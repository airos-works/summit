+    else
+        parameter = markerRange->platformTextMarkerRange();
+    id string = [m_element accessibilityAttributeValue:@"AXAttributedStringForTextMarkerRangeWithOptions" forParameter:parameter];
+    return createJSStringRef(string);
+}
