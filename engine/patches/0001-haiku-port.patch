+void WebExtensionAPITabs::setZoom(WebPageProxyIdentifier page, double tabID, double zoomFactor, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/tabs/setZoom
+
+    std::optional<WebExtensionTabIdentifier> tab;
+    if (!parseOptionalTabIdentifier(tabID, tab, exception))
+        return;
+    // 0 restores the default; otherwise Chrome's range.
+    if (!std::isfinite(zoomFactor) || (zoomFactor && (zoomFactor < 0.25 || zoomFactor > 5))) {
+        exception = toErrorString(nullString(), "zoomFactor"_s, "it must be 0, or between 0.25 and 5"_s);
+        return;
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::TabsSetZoom(page, tab, zoomFactor),
