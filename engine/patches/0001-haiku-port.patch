+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <vector>
+
+namespace WebCore {
+
+// Media Kit's dav1d decoder loses the timestamp and its HEVC decoder returns
+// the most recently read packet's timestamp, before frame reordering. Its
+// H.264 software decoder does the same, with invalid timestamps on drain.
+// These decoders deliver pictures in presentation order. Retain the container's timestamps
+// for the access units still inside the decoder, including seek preroll.
+class VideoPresentationTimelineHaiku {
+public:
+    bool append(int64_t timestamp)
+    {
+        if (m_timestamps.size() >= 256 || timestamp == std::numeric_limits<int64_t>::min()
+            || timestamp == std::numeric_limits<int64_t>::max())
+            return false;
+        m_timestamps.insert(std::upper_bound(m_timestamps.begin(), m_timestamps.end(), timestamp), timestamp);
+        return true;
+    }
+
+    std::optional<int64_t> take()
+    {
+        if (m_timestamps.empty())
+            return std::nullopt;
+        int64_t timestamp = m_timestamps.front();
+        m_timestamps.erase(m_timestamps.begin());
+        return timestamp;
+    }
+
+    void clear() { m_timestamps.clear(); }
+
+private:
+    std::vector<int64_t> m_timestamps;
+};
+
+} // namespace WebCore
