+void WebExtensionAPITabs::duplicate(double tabID, RefPtr<JSON::Value> properties, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/tabs/duplicate
+
+    auto tab = toWebExtensionTabIdentifier(tabID);
+    if (!isValid(tab)) {
+        exception = toErrorString(nullString(), "tabId"_s, "it is not a tab identifier"_s);
+        return;
+    }
+    WebExtensionTabParameters parameters;
+    if (properties && !properties->isNull()) {
+        RefPtr object = properties->asObject();
+        if (!object) {
+            exception = toErrorString(nullString(), "duplicateProperties"_s, "an object is expected"_s);
+            return;
+        }
+        if (RefPtr index = object->getValue("index"_s)) {
+            auto value = index->asDouble();
+            if (!value || *value < 0 || *value != std::floor(*value)) {
+                exception = toErrorString(nullString(), "index"_s, "it must be a non-negative integer"_s);
+                return;
+            }
+            parameters.index = static_cast<uint64_t>(*value);
+        }
+        if (RefPtr active = object->getValue("active"_s)) {
+            auto value = active->asBoolean();
+            if (!value) {
+                exception = toErrorString(nullString(), "active"_s, "a boolean is expected"_s);
+                return;
+            }
+            parameters.active = *value;
+        }
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::TabsDuplicate(*tab, parameters),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<std::optional<WebExtensionTabParameters>, WebExtensionError>&& result) {
+            callWithTab(callback.get(), WTF::move(result));
+        }, extensionContext().identifier());
+}
