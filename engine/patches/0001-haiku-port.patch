+
+void WebExtensionContextProxy::dispatchWebNavigationEvent(WebExtensionEventListenerType type, WebExtensionTabIdentifier tabID, const WebExtensionFrameParameters& frameParameters, WallTime timestamp)
+{
+    auto details = webExtensionNavigationEventJSON(tabID, frameParameters, timestamp);
+    if (!details)
+        return;
+    auto json = details->toJSONString();
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        auto& navigation = namespaceObject.webNavigation();
+        WebExtensionAPIWebNavigationEvent* event = nullptr;
+        switch (type) {
+        case WebExtensionEventListenerType::WebNavigationOnBeforeNavigate: event = &navigation.onBeforeNavigate(); break;
+        case WebExtensionEventListenerType::WebNavigationOnCommitted: event = &navigation.onCommitted(); break;
+        case WebExtensionEventListenerType::WebNavigationOnDOMContentLoaded: event = &navigation.onDOMContentLoaded(); break;
+        case WebExtensionEventListenerType::WebNavigationOnCompleted: event = &navigation.onCompleted(); break;
+        case WebExtensionEventListenerType::WebNavigationOnErrorOccurred: event = &navigation.onErrorOccurred(); break;
+#if PLATFORM(HAIKU)
+        case WebExtensionEventListenerType::WebNavigationOnHistoryStateUpdated: event = &navigation.onHistoryStateUpdated(); break;
+        case WebExtensionEventListenerType::WebNavigationOnReferenceFragmentUpdated: event = &navigation.onReferenceFragmentUpdated(); break;
+#endif
+        default: ASSERT_NOT_REACHED(); return;
+        }
+        event->invokeListenersWithJSONArgument(json, *frameParameters.url);
+    });
+}
+
+#if PLATFORM(HAIKU)
+void WebExtensionContextProxy::dispatchWebNavigationCreatedNavigationTargetEventHaiku(WebExtensionTabIdentifier sourceTab, WebExtensionFrameIdentifier sourceFrame, WebExtensionTabIdentifier tab, const URL& url, WallTime timestamp)
+{
+    auto details = JSON::Object::create();
+    details->setDouble("sourceTabId"_s, toWebAPI(sourceTab));
+    // Process identifiers are not exposed (Chrome reports -1 when it has none).
+    details->setInteger("sourceProcessId"_s, -1);
+    details->setDouble("sourceFrameId"_s, toWebAPI(sourceFrame));
+    details->setDouble("tabId"_s, toWebAPI(tab));
+    details->setString("url"_s, url.string());
+    details->setDouble("timeStamp"_s, floor(timestamp.approximate<WallTime>().secondsSinceEpoch().milliseconds()));
+    auto json = details->toJSONString();
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        namespaceObject.webNavigation().onCreatedNavigationTarget().invokeListenersWithJSONArgument(json, url);
+    });
+}
+#endif
+
