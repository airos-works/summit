+class HaikuMSEVideoRenderer {
+    WTF_MAKE_NONCOPYABLE(HaikuMSEVideoRenderer);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(HaikuMSEVideoRenderer);
+public:
+    HaikuMSEVideoRenderer(MediaPlayerPrivateHaikuMSE& player, const HaikuMSEClock& clock)
+        : m_weakPlayer(player)
+        , m_clock(clock)
+        , m_queue(90, player)
+    {
+        m_presentationThread = Thread::create("Summit MSE present"_s, [this] { presentFrames(); }, ThreadType::Graphics, Thread::QOS::UserInteractive);
+        m_thread = Thread::create("Summit MSE video"_s, [this] { run(); }, ThreadType::Graphics, Thread::QOS::UserInteractive);
+    }
+
+    ~HaikuMSEVideoRenderer()
+    {
+        m_queue.abort();
+        {
+            Locker locker { m_outputLock };
+            m_outputCondition.notifyAll();
+        }
+        if (m_thread)
+            m_thread->waitForCompletion();
+        if (m_presentationThread)
+            m_presentationThread->waitForCompletion();
+    }
+
+    void enqueue(Ref<MediaSampleHaiku>&& sample)
+    {
+        if (!m_enqueuedSinceFlush.exchange(true))
+            MSE_TRACE("video first sample enqueued pts=%.3f sync=%d\n", sample->presentationTime().toDouble(), sample->isSync());
+        m_queue.enqueue(WTF::move(sample));
+    }
+    bool isReadyForMore() { return m_queue.isReadyForMore(); }
+#if ENABLE(ENCRYPTED_MEDIA)
+    bool waitingForKey() const { return m_queue.waitingForKey(); }
+    bool decryptionFailed() const { return m_queue.decryptionFailed(); }
+#endif
+    void requestReadyNotification(ThreadSafeWeakPtr<SourceBufferPrivateHaiku>&& buffer, TrackID trackID) { m_queue.requestReadyNotification(WTF::move(buffer), trackID); }
+    void setEndOfStream() { m_queue.setEndOfStream(); }
+    void flush()
+    {
+        // Serialize generation changes with publication, so an old picture
+        // cannot satisfy preroll or replace the paused seek target afterward.
+        Locker locker { m_outputLock };
+        m_hasFrameSinceFlush = false;
+        m_enqueuedSinceFlush = false;
+        m_queue.flush();
+        m_outputFrames.clear();
+        m_outputBytes = 0;
+        m_outputCondition.notifyAll();
+        MSE_TRACE("video flush generation=%u\n", m_queue.generation());
+    }
+    // The picture at the current position is on screen, so the clock can run.
+    bool hasFrameSinceFlush() const { return m_hasFrameSinceFlush; }
+
+#if USE(SKIA)
+    sk_sp<SkImage> currentFrame()
+    {
+        Locker locker { m_frameLock };
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+        // A picture that went to the compositor as planes becomes an image
+        // only when something paints it (a canvas, or the video before it is
+        // composited).
+        if (!m_frame && m_framePlanes) {
+            const auto& layout = m_framePlanesLayout;
+            auto pixels = SkData::MakeUninitialized(size_t(layout.width) * 4 * layout.height);
+            AddOnVideoDecoderHaiku::convertToBGRA(static_cast<const uint8_t*>(m_framePlanes->data()), layout,
+                static_cast<uint8_t*>(pixels->writable_data()), size_t(layout.width) * 4);
+            auto info = SkImageInfo::Make(layout.width, layout.height, kBGRA_8888_SkColorType, kOpaque_SkAlphaType, SkColorSpace::MakeSRGB());
+            m_frame = SkImages::RasterFromData(info, WTF::move(pixels), size_t(layout.width) * 4);
+        }
+#endif
+        return m_frame;
+    }
+#endif
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    void setLayerBufferProxy(RefPtr<CoordinatedPlatformLayerBufferProxy>&& proxy)
+    {
+        Locker locker { m_frameLock };
+        m_layerBufferProxy = WTF::move(proxy);
+    }
+#endif
+    IntSize frameSize()
+    {
+        Locker locker { m_frameLock };
+        return m_frameSize;
+    }
+    // A frame the compositor replaced before it showed it was not presented
+    // (getVideoPlaybackQuality() counts it dropped): sites such as YouTube
+    // choose a lighter stream when too many are, as they do in browsers
+    // whose compositor reports them. SUMMIT_COUNT_UNSHOWN_FRAMES=0 counts
+    // every frame handed to the compositor as presented, as before.
+    unsigned presentedFrames() const { return m_presentedFrames - m_unshownFrames; }
+    // Every picture handed on, for requestVideoFrameCallback.
+    unsigned framesHandedOn() const { return m_presentedFrames; }
+    unsigned droppedFrames() const { return m_droppedFrames + m_unshownFrames; }
+    // For the browser's debugging tools (engineDescription()): the decoder
+    // the last setup chose and how it went.
+    struct DecoderInfo {
+        std::string name;
+        std::string shortName;
+        bool namedAddOn { false };
+        status_t status { B_NO_INIT };
+        IntSize size;
+        unsigned setups { 0 };
+        double setupMs { 0 };
+    };
+    DecoderInfo decoderInfo()
+    {
+        Locker locker { m_frameLock };
+        return m_decoderInfo;
+    }
+    unsigned unshownFrames() const { return m_unshownFrames; }
+
+private:
+    void run()
+    {
+        while (!m_queue.aborted()) {
+            unsigned generation = 0;
+            RefPtr configuration = m_queue.waitForSample(generation);
+            if (!configuration)
+                return;
+            if (generation != m_lastGeneration) {
+                m_lastGeneration = generation;
+                m_queuedSinceFlush = false;
+                m_nonDisplaying.clear();
+                m_decodedBeforeTarget = 0;
+                m_skippedBeforeTarget = 0;
+            }
+            if (!decodeWith(*configuration, generation)) {
+                m_queue.dropSamplesFor(configuration.get());
+                if (!m_queue.aborted() && m_queue.generation() == generation) {
+                    callOnMainThread([weakPlayer = m_weakPlayer] {
+                        if (RefPtr player = weakPlayer.get())
+                            player->decodingFailed();
+                    });
+                }
+            }
+        }
+    }
+
+    // Decodes every sample that has this configuration. Returns false if no
+    // decoder can be made for it.
+    bool decodeWith(const HaikuTrackConfiguration& configuration, unsigned generation)
+    {
+        auto& info = configuration.info;
+        uint32 codec = isH264(info.codec) ? ffmpegCodecH264 : info.codec == "vp08" ? ffmpegCodecVP8
+            : info.codec == "vp09" ? ffmpegCodecVP9 : info.codec == "av01" ? ffmpegCodecAV1
+            : info.codec == "hvc1" || info.codec == "hev1" ? ffmpegCodecHEVC : 0;
+        if (!codec || !info.width || !info.height) {
+            MSE_TRACE("video codec %s %ux%u is not supported\n", info.codec.c_str(), info.width, info.height);
+            return false;
+        }
+        media_format format;
+        if (!makeEncodedFormat(codec, true, format))
+            return false;
+        format.u.encoded_video.output.display.line_width = info.width;
+        format.u.encoded_video.output.display.line_count = info.height;
+        format.u.encoded_video.output.field_rate = 30;
+        format.u.encoded_video.output.pixel_width_aspect = 1;
+        format.u.encoded_video.output.pixel_height_aspect = 1;
+
+        // The avcC record's byte 4 gives the NAL length field's size.
+        const unsigned nalLengthSize = isH264(info.codec) && info.codecConfig.size() > 4 ? (info.codecConfig[4] & 3) + 1 : 0;
+        const std::span<const uint8_t> codecConfig { info.codecConfig.data(), info.codecConfig.size() };
+        RefPtr<MediaSampleHaiku> current;
+        // The samples a decoder took while it was set up, given again to the
+        // next one when it refused the stream.
+        Vector<RefPtr<MediaSampleHaiku>> taken;
+        size_t replayed = 0;
+        bool keepTaken = true;
+        // Retain compressed samples from a keyframe until every older output
+        // has been consumed. Reordering can leave old pictures pending after
+        // the decoder has read the next keyframe, so retain both GOPs then.
+        Vector<RefPtr<MediaSampleHaiku>> recoverySamples;
+        size_t recoveryBytes = 0;
+        const bool tryAddOn = AddOnVideoDecoderHaiku::canDecode(format, codecConfig);
+        bool keepRecovery = tryAddOn;
+        bool recoveryLimitReached = false;
+        std::optional<int64_t> lastHardwareOutput;
+        bool replayingHardwareOutput = false;
+        // Named hardware decoders return the timestamp of the actual picture.
+        // Software timestamp recovery starts below, after addon negotiation.
+        bool useInputTimeline = false;
+        VideoPresentationTimelineHaiku inputTimeline;
+        bool invalidTimeline = false;
+        auto nextChunk = [&](const void** data, size_t* size, media_header* header) -> status_t {
+            // Cached recovery samples must stop promptly on a seek as well.
+            if (m_queue.aborted() || m_queue.generation() != generation)
+                return B_CANCELED;
+            RefPtr<MediaSampleHaiku> next;
+            if (replayed < taken.size())
+                next = taken[replayed++];
+            else {
+                while (true) {
+                    if (m_queue.take(&configuration, generation, next) == HaikuMSESampleQueue::TakeResult::Stop) {
+                        // After a flush (or when closing) the pictures still in
+                        // the decoder are not wanted: it stops at once. At the
+                        // end of the stream it gives them out first. The
+                        // Raspberry Pi's decoder, told the stream ended, waits
+                        // for the firmware to say so too, which after a flush
+                        // never came: the video stopped for good.
+                        return m_queue.aborted() || m_queue.generation() != generation ? B_CANCELED : B_LAST_BUFFER_ERROR;
+                    }
+                    // A seek decodes from the keyframe before the target (5 s of
+                    // pictures on YouTube, 0.75 s of decoding at 60 frames/s);
+                    // the pictures nothing refers to can be left out.
+                    if (next->isNonDisplaying() && skipDisposableBeforeTarget()
+                        && isDisposableH264({ next->bytes(), next->size() }, nalLengthSize)) {
+                        ++m_skippedBeforeTarget;
+                        continue;
+                    }
+                    break;
+                }
+                if (next->isNonDisplaying()) {
+                    m_nonDisplaying.append(toMicroseconds(next->presentationTime()));
+                    ++m_decodedBeforeTarget;
+                }
+                if (keepRecovery) {
+                    recoverySamples.append(next);
+                    recoveryBytes += next->size();
+                    // Switch now, while every consumed packet is still
+                    // available. At most one extra demuxed packet is held.
+                    if (recoverySamples.size() > 512 || recoveryBytes > 64 * 1024 * 1024)
+                        recoveryLimitReached = true;
+                }
+                if (keepTaken) {
+                    if (taken.size() >= 256)
+                        return B_MEDIA_BAD_FORMAT;
+                    taken.append(next);
+                    replayed = taken.size();
+                }
+            }
+            current = WTF::move(next);
+            if (keepRecovery && recoveryLimitReached)
+                return B_BUFFER_OVERFLOW;
+            std::memset(header, 0, sizeof(*header));
+            header->type = B_MEDIA_ENCODED_VIDEO;
+            header->start_time = toMicroseconds(current->presentationTime());
+            if (useInputTimeline && !inputTimeline.append(header->start_time)) {
+                invalidTimeline = true;
+                return B_MEDIA_BAD_FORMAT;
+            }
+            header->size_used = current->size();
+            if (current->isSync())
+                header->u.encoded_video.field_flags = B_MEDIA_KEY_FRAME;
+            *data = current->bytes();
+            *size = current->size();
+            return B_OK;
+        };
+        bigtime_t setupStarted = system_time();
+
+        // Explicitly selected AMD or Raspberry Pi decoder first, or the
+        // Cubie's kept from before a seek of this stream (see below).
+        std::unique_ptr<AddOnVideoDecoderHaiku> addOn;
+        const KeptDecoderKey key { info.codec, info.width, info.height, info.codecConfig };
+        if (auto kept = std::exchange(m_keptAddOn, nullptr)) {
+            if (tryAddOn && m_keptAddOnKey == key) {
+                kept->setChunkSource([&](const void** data, size_t* size, media_header* header) {
+                    return nextChunk(data, size, header);
+                });
+                if (kept->seekedTo(0, 0) == B_OK) {
+                    addOn = WTF::move(kept);
+                    MSE_TRACE("video decoder %s kept across the seek\n", addOn->codecInfo().pretty_name);
+                }
+            }
+            // One that does not fit goes before another is made.
+        }
+        if (tryAddOn && !addOn) {
+            addOn = AddOnVideoDecoderHaiku::create(format, codecConfig, [&](const void** data, size_t* size, media_header* header) {
+                return nextChunk(data, size, header);
+            });
+            if (!addOn) {
+                keepRecovery = false;
+                recoveryLimitReached = false;
+                if (!recoverySamples.isEmpty())
+                    taken = WTF::move(recoverySamples);
+                replayed = 0;
+            }
+        }
+        // A decoder that stops for a seek (a new generation of this stream)
+        // waits for it, where its add-on allows that: the Cubie's video
+        // engine needs a new set of physically contiguous pictures for each
+        // decoder, which a fragmented memory may no longer have.
+        auto keepAcrossSeek = makeScopeExit([&] {
+            if (!addOn || !addOn->keptAcrossSeeks() || m_queue.aborted() || m_queue.generation() == generation)
+                return;
+            // This call's chunks go away with it.
+            addOn->setChunkSource([](const void**, size_t* size, media_header*) -> status_t {
+                *size = 0;
+                return B_CANCELED;
+            });
+            m_keptAddOnKey = key;
+            m_keptAddOn = WTF::move(addOn);
+        });
+        if (!addOn && (m_queue.aborted() || m_queue.generation() != generation))
+            return true;
+
+        // Media Kit's H.264, HEVC and AV1 software decoders report packet
+        // timestamps, including invalid timestamps when draining. Their
+        // output pictures are ordered; retain input presentation times from
+        // the start of software input, including any replayed setup samples.
+        if (!addOn && (codec == ffmpegCodecH264 || codec == ffmpegCodecHEVC || codec == ffmpegCodecAV1))
+            useInputTimeline = true;
+
+        HaikuChunkDecoder decoder([&](const void** data, size_t* size, media_header* header) {
+            return nextChunk(data, size, header);
+        });
+        status_t status = B_OK;
+        media_codec_info codecInfo;
+        std::memset(&codecInfo, 0, sizeof(codecInfo));
+        int width = 0;
+        int height = 0;
+        size_t rowBytes = 0;
+        if (addOn) {
+            codecInfo = addOn->codecInfo();
+            width = addOn->width();
+            height = addOn->height();
+            rowBytes = size_t(width) * 4;
+        } else {
+            status = decoder.SetTo(&format, info.codecConfig.data(), info.codecConfig.size());
+            if (status != B_OK) {
+                // The add-on the media kit chose failed (the Raspberry Pi 4's image
+                // has the ROCK 5's Rockchip decoder first); see MediaDecoderSelectionHaiku.h.
+                replayed = 0;
+                inputTimeline.clear();
+                invalidTimeline = false;
+                status = setSoftwareDecoderHaiku(decoder, format, info.codecConfig.data(), info.codecConfig.size());
+                std::fprintf(stderr, "Summit media: no decoder add-on took MSE video at first; libavcodec status %ld\n", long(status));
+            }
+            if (status == B_OK) {
+                // NVDEC runs out of pictures on 16 reference frames; see MediaDecoderSelectionHaiku.h.
+                media_codec_info chosen = { };
+                decoder.GetDecoderInfo(&chosen);
+                if (isH264(info.codec) && hardwareDecoderCannotDecodeHaiku(chosen, codecConfig)) {
+                    replayed = 0;
+                    inputTimeline.clear();
+                    invalidTimeline = false;
+                    status = setSoftwareDecoderHaiku(decoder, format, info.codecConfig.data(), info.codecConfig.size());
+                    std::fprintf(stderr, "Summit media: MSE H.264 with %u reference frames goes to libavcodec instead of %s (status %ld)\n",
+                        h264MaxReferenceFrames(codecConfig).value_or(0), chosen.pretty_name, long(status));
+                }
+            }
+            media_format output;
+            output.type = B_MEDIA_RAW_VIDEO;
+            output.u.raw_video = media_raw_video_format::wildcard;
+            output.u.raw_video.display.format = B_RGB32;
+            output.u.raw_video.display.line_width = info.width;
+            output.u.raw_video.display.line_count = info.height;
+            if (status == B_OK)
+                status = decoder.SetOutputFormat(&output);
+            decoder.GetDecoderInfo(&codecInfo);
+            if (status == B_OK && output.u.raw_video.display.format != B_RGB32)
+                status = B_MEDIA_BAD_FORMAT;
+            width = output.u.raw_video.display.line_width;
+            height = output.u.raw_video.display.line_count;
+            rowBytes = output.u.raw_video.display.bytes_per_row;
+            if (!rowBytes)
+                rowBytes = size_t(width) * 4;
+        }
+        keepTaken = false;
+        if (!addOn) {
+            keepRecovery = false;
+            recoverySamples.clear();
+        }
+        // Unread setup samples must survive a fallback until it consumes them.
+        if (replayed == taken.size())
+            taken.clear();
+        MSE_TRACE("video decoder %s %ux%u status=%ld setup=%.1f ms\n", codecInfo.pretty_name, info.width, info.height,
+            long(status), (system_time() - setupStarted) / 1000.0);
+        {
+            Locker locker { m_frameLock };
+            m_decoderInfo.name = codecInfo.pretty_name;
+            m_decoderInfo.shortName = codecInfo.short_name;
+            m_decoderInfo.namedAddOn = !!addOn;
+            m_decoderInfo.status = status;
+            m_decoderInfo.size = { width, height };
+            m_decoderInfo.setupMs = (system_time() - setupStarted) / 1000.0;
+            ++m_decoderInfo.setups;
+        }
+        // A flush while the decoder was set up (it reads samples to find the
+        // picture size) is no reason to drop what the next generation queued.
+        if (m_queue.aborted() || m_queue.generation() != generation)
+            return true;
+        if (status != B_OK || width <= 0 || height <= 0)
+            return false;
+
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+        // The Raspberry Pi's pictures go to the compositor as they come, in
+        // planes; see CoordinatedPlatformLayerBufferPlanesHaiku.h.
+        // SUMMIT_VIDEO_PLANES=0 converts them to RGB here instead.
+        static const bool sendPlanes = [] {
+            const char* value = std::getenv("SUMMIT_VIDEO_PLANES");
+            return !value || std::strcmp(value, "0");
+        }();
+        bool planes = addOn && addOn->hasPlanes() && sendPlanes;
+#endif
+        while (!m_queue.aborted() && m_queue.generation() == generation) {
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+            sk_sp<SkData> pixels = takeBuffer(planes ? addOn->planesSize() : rowBytes * height);
+            void* target = pixels->writable_data();
+#elif USE(SKIA)
+            sk_sp<SkData> pixels = takeBuffer(rowBytes * height);
+            void* target = pixels->writable_data();
+#else
+            m_scratch.resize(rowBytes * height);
+            void* target = m_scratch.mutableSpan().data();
+#endif
+            media_header header;
+            std::memset(&header, 0, sizeof(header));
+            media_decode_info decodeInfo { };
+            // Pictures before a seek target are decoded only to reach it.
+            // The NVDEC add-on skips their pixel conversion when told the
+            // first time it will be asked to show.
+            if (!m_nonDisplaying.isEmpty())
+                decodeInfo.time_to_decode = -(*std::max_element(m_nonDisplaying.begin(), m_nonDisplaying.end()) + 1);
+            int64 frames = 0;
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+            if (planes)
+                status = addOn->decodePlanes(target, &frames, &header, &decodeInfo);
+            else
+#endif
+            status = addOn ? addOn->decode(target, rowBytes, &frames, &header, &decodeInfo)
+                : decoder.Decode(target, &frames, &header, &decodeInfo);
+            if (status != B_OK) {
+                MSE_TRACE("video decoder stopped status=%ld frames=%lld generation=%u invalidTimeline=%d\n", long(status), static_cast<long long>(frames), generation, invalidTimeline);
+                if (m_queue.aborted() || m_queue.generation() != generation || status == B_CANCELED)
+                    return true;
+                if (status == B_INTERRUPTED)
+                    continue;
+                if (status == B_LAST_BUFFER_ERROR)
+                    return !invalidTimeline;
+                if (!addOn || invalidTimeline)
+                    return false;
+                // A decoder can fail before asking for its first packet.
+                // Then the queue is untouched and software can start there;
+                // there is no keyframe to replay yet. Once input or output
+                // has been consumed, recovery still requires a saved GOP.
+                if (recoverySamples.isEmpty()) {
+                    if (current || lastHardwareOutput)
+                        return false;
+                } else if (!recoverySamples[0]->isSync())
+                    return false;
+                std::fprintf(stderr, "Summit media: %s failed (%s); replaying %zu MSE samples in software\n",
+                    codecInfo.pretty_name, strerror(status), recoverySamples.size());
+                addOn = nullptr;
+                keepRecovery = false;
+                recoveryLimitReached = false;
+                taken = WTF::move(recoverySamples);
+                replayed = 0;
+                useInputTimeline = true;
+                replayingHardwareOutput = true;
+                inputTimeline.clear();
+                status = setSoftwareDecoderHaiku(decoder, format, info.codecConfig.data(), info.codecConfig.size(), &codecInfo);
+                media_format output { };
+                output.type = B_MEDIA_RAW_VIDEO;
+                output.u.raw_video = media_raw_video_format::wildcard;
+                output.u.raw_video.display.format = B_RGB32;
+                output.u.raw_video.display.line_width = info.width;
+                output.u.raw_video.display.line_count = info.height;
+                if (status == B_OK)
+                    status = decoder.SetOutputFormat(&output);
+                if (m_queue.aborted() || m_queue.generation() != generation)
+                    return true;
+                const auto& display = output.u.raw_video.display;
+                if (status != B_OK || output.type != B_MEDIA_RAW_VIDEO || display.format != B_RGB32
+                    || !display.line_width || !display.line_count || display.line_width > 4096 || display.line_count > 4096
+                    || display.bytes_per_row < display.line_width * 4 || display.bytes_per_row > 4096 * 4)
+                    return false;
+                width = display.line_width;
+                height = display.line_count;
+                rowBytes = display.bytes_per_row;
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+                planes = false;
+#endif
+                continue;
+            }
+            if (m_queue.generation() != generation)
+                break;
+            if (!frames)
+                continue;
+            if (frames != 1)
+                return false;
+            std::optional<int64_t> presentationTime = useInputTimeline ? inputTimeline.take() : std::optional<int64_t>(header.start_time);
+            if (!presentationTime || *presentationTime == INT64_MIN || *presentationTime == INT64_MAX)
+                return false;
+            int64_t pts = *presentationTime;
+            // Replayed pictures rebuild software references, but must not be
+            // presented or counted a second time (including late/preroll ones).
+            if (replayingHardwareOutput && lastHardwareOutput && pts <= *lastHardwareOutput)
+                continue;
+            if (addOn) {
+                lastHardwareOutput = pts;
+                size_t discard = 0;
+                int64_t greatestEarlierPTS = INT64_MIN;
+                for (size_t i = 0; i < recoverySamples.size(); ++i) {
+                    int64_t samplePTS = toMicroseconds(recoverySamples[i]->presentationTime());
+                    if (i && recoverySamples[i]->isSync() && samplePTS <= pts && greatestEarlierPTS <= pts)
+                        discard = i;
+                    greatestEarlierPTS = std::max(greatestEarlierPTS, samplePTS);
+                }
+                for (size_t i = 0; i < discard; ++i)
+                    recoveryBytes -= recoverySamples[i]->size();
+                if (discard)
+                    recoverySamples.removeAt(0, discard);
+            }
+            if (replayed == taken.size()) {
+                taken.clear();
+                replayed = 0;
+            }
+            if (mseTraceEnabled())
+                MSE_TRACE("video output codec=%s generation=%u pts=%lld native=%lld\n", info.codec.c_str(), generation,
+                    static_cast<long long>(pts), static_cast<long long>(header.start_time));
+            if (takeNonDisplaying(pts))
+                continue;
+            if (!m_queuedSinceFlush && (m_decodedBeforeTarget || m_skippedBeforeTarget))
+                MSE_TRACE("seek target reached: %u pictures decoded before it, %u left out\n", m_decodedBeforeTarget, m_skippedBeforeTarget);
+            DecodedFrame frame;
+            frame.pts = pts;
+            frame.generation = generation;
+            frame.size = IntSize(width, height);
+#if USE(SKIA)
+            frame.pixels = WTF::move(pixels);
+            frame.rowBytes = rowBytes;
+#endif
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+            if (planes)
+                frame.planesLayout = addOn->layout();
+#endif
+            if (!enqueueFrame(WTF::move(frame)))
+                break;
+            m_queuedSinceFlush = true;
+        }
+        return true;
+    }
+
+    struct DecodedFrame {
+        int64_t pts { 0 };
+        unsigned generation { 0 };
+        IntSize size;
+#if USE(SKIA)
+        sk_sp<SkData> pixels;
+        size_t rowBytes { 0 };
+#endif
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+        std::optional<AddOnVideoDecoderHaiku::I420Layout> planesLayout;
+#endif
+        size_t byteSize() const
+        {
+#if USE(SKIA)
+            return pixels->size();
+#else
+            return 0;
+#endif
+        }
+    };
+
+    bool enqueueFrame(DecodedFrame&& frame)
+    {
+        // Let decoding absorb short expensive pictures while presentation
+        // follows the clock independently. Bound both count and memory; one
+        // frame larger than the byte budget may enter an otherwise empty queue.
+        constexpr size_t maxFrames = 6;
+        constexpr size_t maxBytes = 64 * 1024 * 1024;
+        Locker locker { m_outputLock };
+        while (!m_queue.aborted() && m_queue.generation() == frame.generation) {
+            if (m_outputFrames.isEmpty() || (m_outputFrames.size() < maxFrames
+                && frame.byteSize() <= maxBytes && m_outputBytes <= maxBytes - frame.byteSize())) {
+                m_outputBytes += frame.byteSize();
+                m_outputFrames.append(WTF::move(frame));
+                m_outputCondition.notifyAll();
+                return true;
+            }
+            m_outputCondition.wait(m_outputLock);
+        }
+        return false;
+    }
+
+    void presentFrames()
+    {
+        unsigned presentationGeneration = UINT_MAX;
+        while (!m_queue.aborted()) {
+            DecodedFrame frame;
+            {
+                Locker locker { m_outputLock };
+                while (!m_queue.aborted() && m_outputFrames.isEmpty())
+                    m_outputCondition.wait(m_outputLock);
+                if (m_queue.aborted())
+                    return;
+                frame = m_outputFrames.takeFirst();
+                m_outputBytes -= frame.byteSize();
+                m_outputCondition.notifyAll();
+            }
+            if (presentationGeneration != frame.generation) {
+                presentationGeneration = frame.generation;
+                m_presentedSinceFlush = false;
+            }
+            if (!waitUntilDue(frame.pts, frame.generation))
+                continue;
+            Locker locker { m_outputLock };
+            if (m_queue.aborted() || m_queue.generation() != frame.generation)
+                continue;
+            __int128 lateness = m_clock.isRunning() ? static_cast<__int128>(m_clock.now()) - frame.pts : 0;
+            if (m_presentedSinceFlush && lateness > 80000) {
+                ++m_droppedFrames;
+                continue;
+            }
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+            if (frame.planesLayout) {
+                presentPlanes(WTF::move(frame.pixels), *frame.planesLayout);
+                continue;
+            }
+#endif
+#if USE(SKIA)
+            auto imageInfo = SkImageInfo::Make(frame.size.width(), frame.size.height(), kBGRA_8888_SkColorType, kOpaque_SkAlphaType, SkColorSpace::MakeSRGB());
+            present(SkImages::RasterFromData(imageInfo, WTF::move(frame.pixels), frame.rowBytes), frame.size);
+#else
+            present(frame.size);
+#endif
+        }
+    }
+
+    bool takeNonDisplaying(int64_t pts)
+    {
+        for (size_t i = 0; i < m_nonDisplaying.size(); ++i) {
+            if (m_nonDisplaying[i] == pts) {
+                m_nonDisplaying.removeAt(i);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool waitUntilDue(int64_t pts, unsigned generation)
+    {
+        while (!m_queue.aborted() && m_queue.generation() == generation) {
+            // The first frame after a flush is the picture at the seek target;
+            // show it at once, even while paused.
+            if (!m_presentedSinceFlush)
+                return true;
+            // End-of-stream can stop the clock while the decoder drains its
+            // last pictures. Frames already due must still be presented.
+            __int128 wait = static_cast<__int128>(pts) - m_clock.now();
+            if (wait <= 3000)
+                return true;
+            if (!m_clock.isRunning()) {
+                m_queue.waitFor(10_ms, generation);
+                continue;
+            }
+            m_queue.waitFor(Seconds::fromMicroseconds(static_cast<int64_t>(std::min<__int128>(wait - 2000, 20000))), generation);
+        }
+        return false;
+    }
+
+#if USE(SKIA)
+    sk_sp<SkData> takeBuffer(size_t size)
+    {
+        // A buffer is free again once no image refers to it.
+        for (auto& buffer : m_buffers) {
+            if (buffer->unique() && buffer->size() == size)
+                return buffer;
+        }
+        m_buffers.removeAllMatching([](auto& buffer) { return buffer->unique(); });
+        auto buffer = SkData::MakeUninitialized(size);
+        if (m_buffers.size() < 8)
+            m_buffers.append(buffer);
+        return buffer;
+    }
+
+    void present(sk_sp<SkImage>&& image, IntSize size)
+    {
+        if (!image)
+            return;
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+        RefPtr<CoordinatedPlatformLayerBufferProxy> proxy;
+#endif
+        {
+            Locker locker { m_frameLock };
+            m_frame = image;
+            m_frameSize = size;
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+            m_framePlanes = nullptr;
+            proxy = m_layerBufferProxy;
+#endif
+        }
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+        // Hand the frame to the compositor directly, so a busy page thread
+        // does not hold it back and no tile has to be repainted for it.
+        if (proxy && proxy->isValid()) {
+            if (RefPtr nativeImage = NativeImage::create(WTF::move(image)))
+                noteReplacedUnshown(proxy->setDisplayBufferHaiku(CoordinatedPlatformLayerBufferNativeImage::create(nativeImage.releaseNonNull(), nullptr)));
+        }
+#endif
+        didPresent();
+    }
+
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    void presentPlanes(sk_sp<SkData>&& planes, const AddOnVideoDecoderHaiku::I420Layout& layout)
+    {
+        RefPtr<CoordinatedPlatformLayerBufferProxy> proxy;
+        {
+            Locker locker { m_frameLock };
+            m_frame = nullptr;
+            m_framePlanes = planes;
+            m_framePlanesLayout = layout;
+            m_frameSize = IntSize(layout.width, layout.height);
+            proxy = m_layerBufferProxy;
+        }
+        if (proxy && proxy->isValid())
+            noteReplacedUnshown(proxy->setDisplayBufferHaiku(makeUnique<CoordinatedPlatformLayerBufferPlanesHaiku>(WTF::move(planes), layout)));
+        didPresent();
+    }
+#endif
+
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    void noteReplacedUnshown(bool replaced)
+    {
+        static const bool counts = [] {
+            const char* value = std::getenv("SUMMIT_COUNT_UNSHOWN_FRAMES");
+            return !value || std::strcmp(value, "0");
+        }();
+        if (replaced && counts)
+            ++m_unshownFrames;
+    }
+#endif
+#else
+    void present(IntSize size)
+    {
+        {
+            Locker locker { m_frameLock };
+            m_frameSize = size;
+        }
+        didPresent();
+    }
+#endif
+
+    void didPresent()
+    {
+        m_presentedSinceFlush = true;
+        m_hasFrameSinceFlush = true;
+        ++m_presentedFrames;
+        if (m_repaintQueued.exchange(true))
+            return;
+        callOnMainThread([weakPlayer = m_weakPlayer, this] {
+            RefPtr player = weakPlayer.get();
+            if (!player)
+                return;
+            m_repaintQueued = false;
+            player->videoFrameAvailable();
+        });
+    }
+
+    WeakPtr<MediaPlayerPrivateHaikuMSE> m_weakPlayer;
+    const HaikuMSEClock& m_clock;
+    HaikuMSESampleQueue m_queue;
+    RefPtr<Thread> m_thread;
+    RefPtr<Thread> m_presentationThread;
+    Lock m_outputLock;
+    Condition m_outputCondition;
+    Deque<DecodedFrame> m_outputFrames WTF_GUARDED_BY_LOCK(m_outputLock);
+    size_t m_outputBytes WTF_GUARDED_BY_LOCK(m_outputLock) { 0 };
+    unsigned m_lastGeneration { UINT_MAX };
+    // A named add-on's decoder kept across a seek, and the stream it
+    // decodes (video thread; see decodeWith()).
+    struct KeptDecoderKey {
+        std::string codec;
+        uint32_t width { 0 };
+        uint32_t height { 0 };
+        std::vector<uint8_t> codecConfig;
+        bool operator==(const KeptDecoderKey&) const = default;
+    };
+    std::unique_ptr<AddOnVideoDecoderHaiku> m_keptAddOn;
+    KeptDecoderKey m_keptAddOnKey;
+    bool m_queuedSinceFlush { false }; // Decoder thread only.
+    bool m_presentedSinceFlush { false }; // Presentation thread only.
+    Vector<int64_t> m_nonDisplaying;
+    unsigned m_decodedBeforeTarget { 0 };
+    unsigned m_skippedBeforeTarget { 0 };
+    std::atomic<bool> m_repaintQueued { false };
+    std::atomic<bool> m_hasFrameSinceFlush { false };
+    std::atomic<bool> m_enqueuedSinceFlush { false };
+    std::atomic<unsigned> m_presentedFrames { 0 };
+    std::atomic<unsigned> m_droppedFrames { 0 };
+    std::atomic<unsigned> m_unshownFrames { 0 };
+    Lock m_frameLock;
+#if USE(SKIA)
+    Vector<sk_sp<SkData>> m_buffers;
+    sk_sp<SkImage> m_frame WTF_GUARDED_BY_LOCK(m_frameLock);
+#endif
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    // The newest picture when it came as planes; m_frame is made from it on demand.
+    sk_sp<SkData> m_framePlanes WTF_GUARDED_BY_LOCK(m_frameLock);
+    AddOnVideoDecoderHaiku::I420Layout m_framePlanesLayout WTF_GUARDED_BY_LOCK(m_frameLock);
+#endif
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    RefPtr<CoordinatedPlatformLayerBufferProxy> m_layerBufferProxy WTF_GUARDED_BY_LOCK(m_frameLock);
+#endif
+#if USE(SKIA)
+#else
+    Vector<uint8_t> m_scratch;
+#endif
+    IntSize m_frameSize WTF_GUARDED_BY_LOCK(m_frameLock);
+    DecoderInfo m_decoderInfo WTF_GUARDED_BY_LOCK(m_frameLock);
+};
+
+// #pragma mark - Audio
+
+class HaikuMSEAudioRenderer {
+    WTF_MAKE_NONCOPYABLE(HaikuMSEAudioRenderer);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(HaikuMSEAudioRenderer);
+public:
+    HaikuMSEAudioRenderer(MediaPlayerPrivateHaikuMSE& player, const HaikuMSEClock& clock)
+        : m_weakPlayer(player)
+        , m_clock(clock)
+        , m_queue(120, player)
+    {
+        m_thread = Thread::create("Summit MSE audio decoder"_s, [this] { run(); }, ThreadType::Audio, Thread::QOS::UserInteractive);
+    }
+
+    ~HaikuMSEAudioRenderer()
+    {
+        m_queue.abort();
+        {
+            Locker locker { m_pcmLock };
+            m_pcmCondition.notifyAll();
+        }
+        if (m_thread)
+            m_thread->waitForCompletion();
+        releaseOutput();
+    }
+
+    void enqueue(Ref<MediaSampleHaiku>&& sample) { m_queue.enqueue(WTF::move(sample)); }
+    bool isReadyForMore() { return m_queue.isReadyForMore(); }
+#if ENABLE(ENCRYPTED_MEDIA)
+    bool waitingForKey() const { return m_queue.waitingForKey(); }
+    bool decryptionFailed() const { return m_queue.decryptionFailed(); }
+#endif
+    void requestReadyNotification(ThreadSafeWeakPtr<SourceBufferPrivateHaiku>&& buffer, TrackID trackID) { m_queue.requestReadyNotification(WTF::move(buffer), trackID); }
+    void setEndOfStream() { m_queue.setEndOfStream(); }
+    void flush()
+    {
+        m_queue.flush();
+        Locker locker { m_pcmLock };
+        m_pcm.clear();
+        m_pcmFrames = 0;
+        m_lastPCMEnd = m_clock.now();
+        m_pcmCondition.notifyAll();
+    }
+
+    // Main thread.
+    void setPlaying(bool playing)
+    {
+        m_playing = playing;
+        updateOutput();
+    }
+    void setVolume(float volume)
+    {
+        m_volume = volume;
+        if (m_soundPlayer)
+            m_soundPlayer->SetVolume(m_muted ? 0 : volume);
+    }
+    void setMuted(bool muted)
+    {
+        m_muted = muted;
+        updateOutput();
+    }
+    // Main thread, from the player's timer: the output needs the decoded
+    // format, which is only known after the first chunk.
+    void updateOutput()
+    {
+        bool wanted = m_playing && !m_muted && m_formatKnown;
+        if (!wanted) {
+            if (m_soundPlayer && m_outputStarted) {
+                m_soundPlayer->Stop(false);
+                m_outputStarted = false;
+            }
+            if (m_muted)
+                releaseOutput();
+            return;
+        }
+        if (!m_soundPlayer) {
+            media_raw_audio_format format;
+            {
+                Locker locker { m_pcmLock };
+                format = m_format;
+            }
+            BMediaRoster* roster = BMediaRoster::Roster();
+            media_node output;
+            if (!roster || roster->GetAudioOutput(&output) != B_OK)
+                return;
+            roster->ReleaseNode(output);
+            m_soundPlayer = new BSoundPlayer(&format, "Summit MSE audio", playCallback, nullptr, this);
+            if (m_soundPlayer->InitCheck() != B_OK) {
+                MSE_TRACE("audio output failed: %ld\n", long(m_soundPlayer->InitCheck()));
+                delete m_soundPlayer;
+                m_soundPlayer = nullptr;
+                return;
+            }
+            m_latency = m_soundPlayer->Latency();
+            m_soundPlayer->SetVolume(m_volume);
+            m_soundPlayer->SetHasData(true);
+            MSE_TRACE("audio output %.0f Hz %lu channels latency=%.1f ms\n", format.frame_rate, (unsigned long)format.channel_count, m_latency / 1000.0);
+        }
+        if (!m_outputStarted) {
+            m_soundPlayer->Start();
+            m_outputStarted = true;
+        }
+    }
+
+    void outputFormatChanged()
+    {
+        if (m_formatChanged.exchange(false))
+            releaseOutput();
+        updateOutput();
+        Locker locker { m_pcmLock };
+        m_outputFormatReady = true;
+        m_pcmCondition.notifyAll();
+    }
+
+private:
+    struct PCMBlock {
+        int64_t pts { 0 };
+        Vector<uint8_t> bytes;
+        size_t offset { 0 };
+    };
+
+    void releaseOutput()
+    {
+        if (!m_soundPlayer)
+            return;
+        auto* soundPlayer = std::exchange(m_soundPlayer, nullptr);
+        m_outputStarted = false;
+        soundPlayer->Stop(true);
+        delete soundPlayer;
+    }
+
+    void run()
+    {
+        while (!m_queue.aborted()) {
+            unsigned generation = 0;
+            RefPtr configuration = m_queue.waitForSample(generation);
+            if (!configuration)
+                return;
+            if (!decodeWith(*configuration, generation)) {
+                m_queue.dropSamplesFor(configuration.get());
+                if (!m_queue.aborted() && m_queue.generation() == generation) {
+                    callOnMainThread([weakPlayer = m_weakPlayer] {
+                        if (RefPtr player = weakPlayer.get())
+                            player->decodingFailed();
+                    });
+                }
+            }
+        }
+    }
+
+    bool decodeWith(const HaikuTrackConfiguration& configuration, unsigned generation)
+    {
+        auto& info = configuration.info;
+        uint32 codec = isAAC(info) ? ffmpegCodecAAC : info.codec == "Opus" ? ffmpegCodecOpus
+            : info.codec == "vorb" ? ffmpegCodecVorbis : info.codec == "mp1" ? ffmpegCodecMP1
+            : info.codec == "mp2" ? ffmpegCodecMP2 : info.codec == "mp3" ? ffmpegCodecMP3
+            : info.codec == "ac-3" ? ffmpegCodecAC3 : info.codec == "ec-3" ? ffmpegCodecEAC3 : 0;
+        bool packetTimedAudio = info.packetTimedAudio;
+        if (!codec || !info.sampleRate || !info.channels) {
+            MSE_TRACE("audio codec %s (0x%x) is not supported\n", info.codec.c_str(), info.objectTypeIndication);
+            return false;
+        }
+        media_format format;
+        if (!makeEncodedFormat(codec, false, format))
+            return false;
+        format.u.encoded_audio.output.frame_rate = info.sampleRate;
+        format.u.encoded_audio.output.channel_count = info.channels;
+        format.u.encoded_audio.output.byte_order = B_MEDIA_HOST_ENDIAN;
+        format.u.encoded_audio.frame_size = isAAC(info) ? 1024 : 0;
+
+        // Media Kit's FFmpeg decoder consumes Opus pre-skip without moving
+        // the first output timestamp. Decode the entire packet and apply the
+        // parser/append-window trims ourselves on the exact PCM timeline.
+        auto codecConfig = info.codecConfig;
+        if (info.codec == "Opus") {
+            if (codecConfig.size() < 19 || std::memcmp(codecConfig.data(), "OpusHead", 8))
+                return false;
+            codecConfig[10] = codecConfig[11] = 0;
+        }
+        struct PacketTiming {
+            MediaTime presentationTime;
+            MediaTime duration;
+            MediaTime trimStart;
+            MediaTime trimEnd;
+            bool nonDisplaying;
+            uint64_t consumedFrames { 0 };
+        };
+        Deque<PacketTiming> packetTimings;
+        bool firstPacket = true;
+        RefPtr<MediaSampleHaiku> current;
+        size_t prerollIndex = 0;
+        bool deliveredCurrent = true;
+        MediaTime prerollRemaining = MediaTime::zeroTime();
+        HaikuChunkDecoder decoder([&](const void** data, size_t* size, media_header* header) -> status_t {
+            if (deliveredCurrent) {
+                RefPtr<MediaSampleHaiku> next;
+                if (m_queue.take(&configuration, generation, next) == HaikuMSESampleQueue::TakeResult::Stop)
+                    return B_LAST_BUFFER_ERROR;
+                current = WTF::move(next);
+                deliveredCurrent = false;
+                prerollIndex = 0;
+                prerollRemaining = MediaTime::zeroTime();
+                for (auto& packet : current->preroll())
+                    prerollRemaining += MediaTime(packet.duration, info.timescale);
+            }
+            PacketTiming timing { current->codedPresentationTime(), current->codedDuration(), current->trimStart(), current->trimEnd(), current->isNonDisplaying() };
+            if (prerollIndex < current->preroll().size()) {
+                auto& packet = current->preroll()[prerollIndex++];
+                timing.presentationTime -= prerollRemaining;
+                timing.duration = MediaTime(packet.duration, info.timescale);
+                timing.trimStart = timing.trimEnd = MediaTime::zeroTime();
+                timing.nonDisplaying = true;
+                prerollRemaining -= timing.duration;
+                *data = packet.data.data();
+                *size = packet.data.size();
+            } else {
+                deliveredCurrent = true;
+                *data = current->bytes();
+                *size = current->size();
+            }
+            // Vorbis' first packet primes the overlapping transform and
+            // produces no PCM. Its nominal container duration must not be
+            // assigned to the first decoded block from the following packet.
+            if (packetTimedAudio && !(firstPacket && info.codec == "vorb")) {
+                if (packetTimings.size() >= 512)
+                    return B_MEDIA_BAD_FORMAT;
+                packetTimings.append(timing);
+            }
+            firstPacket = false;
+            std::memset(header, 0, sizeof(*header));
+            header->type = B_MEDIA_ENCODED_AUDIO;
+            header->start_time = toMicroseconds(packetTimedAudio ? timing.presentationTime : current->presentationTime());
+            header->size_used = *size;
+            return B_OK;
+        });
+        status_t status = decoder.SetTo(&format, codecConfig.data(), codecConfig.size());
+        if (status != B_OK)
+            status = setSoftwareDecoderHaiku(decoder, format, codecConfig.data(), codecConfig.size());
+        media_format output;
+        output.type = B_MEDIA_RAW_AUDIO;
+        output.u.raw_audio = media_raw_audio_format::wildcard;
+        if (status == B_OK)
+            status = decoder.SetOutputFormat(&output);
+        MSE_TRACE("audio decoder %u Hz %u channels status=%ld format=0x%lx buffer=%lu\n", info.sampleRate, info.channels, long(status),
+            (unsigned long)output.u.raw_audio.format, (unsigned long)output.u.raw_audio.buffer_size);
+        if (status != B_OK || !output.u.raw_audio.buffer_size || !output.u.raw_audio.channel_count)
+            return false;
+
+        size_t sampleSize = output.u.raw_audio.format & media_raw_audio_format::B_AUDIO_SIZE_MASK;
+        size_t frameSize = sampleSize * output.u.raw_audio.channel_count;
+        if (!frameSize)
+            return false;
+        {
+            Locker locker { m_pcmLock };
+            bool changed = m_formatKnown && (m_format.frame_rate != output.u.raw_audio.frame_rate
+                || m_format.channel_count != output.u.raw_audio.channel_count || m_format.format != output.u.raw_audio.format);
+            // Existing PCM still belongs to the old SoundPlayer format. Let
+            // it drain before changing channels, sample width, or sample rate.
+            while (changed && (!m_pcm.isEmpty() || m_clock.now() < m_lastPCMEnd) && !m_queue.aborted() && m_queue.generation() == generation)
+                m_pcmCondition.waitFor(m_pcmLock, 20_ms);
+            if (m_queue.aborted() || m_queue.generation() != generation)
+                return true;
+            m_format = output.u.raw_audio;
+            m_frameSize = frameSize;
+            if (changed)
+                m_formatChanged = true;
+        }
+        if (!m_formatKnown.exchange(true) || m_formatChanged) {
+            {
+                Locker locker { m_pcmLock };
+                m_outputFormatReady = false;
+            }
+            // Reloading can replace the renderer while this task is queued.
+            // The player checks ownership before dereferencing the pointer.
+            callOnMainThread([weakPlayer = m_weakPlayer, renderer = this] {
+                if (RefPtr player = weakPlayer.get())
+                    player->audioOutputFormatChanged(renderer);
+            });
+            Locker locker { m_pcmLock };
+            while (!m_outputFormatReady && !m_queue.aborted() && m_queue.generation() == generation)
+                m_pcmCondition.waitFor(m_pcmLock, 20_ms);
+            if (m_queue.aborted() || m_queue.generation() != generation)
+                return true;
+        }
+
+        uint64_t decodedPCMFrames = 0;
+        uint64_t queuedPCMFrames = 0;
+        bool loggedFirstPCM = false;
+        auto enqueuePCM = [&](PCMBlock&& block) {
+            Locker locker { m_pcmLock };
+            if (m_queue.generation() != generation)
+                return;
+            if (!loggedFirstPCM) {
+                MSE_TRACE("audio first PCM codec=%s generation=%u pts=%.6f frames=%zu\n", info.codec.c_str(), generation, block.pts / 1000000.0, block.bytes.size() / frameSize);
+                loggedFirstPCM = true;
+            }
+            queuedPCMFrames += block.bytes.size() / frameSize;
+            m_lastPCMEnd = blockEnd(block);
+            m_pcmFrames += block.bytes.size() / frameSize;
+            m_pcm.append(WTF::move(block));
+            // Hold about half a second; drop what the clock has already passed.
+            while (!m_queue.aborted() && m_queue.generation() == generation && m_pcmFrames > m_format.frame_rate / 2) {
+                if (!m_pcm.isEmpty() && m_clock.isRunning() && blockEnd(m_pcm.first()) < m_clock.now() - 200000) {
+                    m_pcmFrames -= (m_pcm.first().bytes.size() - m_pcm.first().offset) / m_frameSize;
+                    m_pcm.removeFirst();
+                    continue;
+                }
+                m_pcmCondition.waitFor(m_pcmLock, 20_ms);
+            }
+        };
+        auto pcmFramesFor = [&](const MediaTime& duration) -> uint64_t {
+            return std::max<int64_t>(0, std::llround(duration.toDouble() * output.u.raw_audio.frame_rate));
+        };
+        while (!m_queue.aborted() && m_queue.generation() == generation) {
+            PCMBlock block;
+            block.bytes.grow(output.u.raw_audio.buffer_size);
+            media_header header;
+            std::memset(&header, 0, sizeof(header));
+            int64 frames = 0;
+            status = decoder.Decode(block.bytes.mutableSpan().data(), &frames, &header, nullptr);
+            if (status != B_OK || frames <= 0)
+                break;
+            block.bytes.shrink(std::min<size_t>(block.bytes.size(), size_t(frames) * frameSize));
+            decodedPCMFrames += block.bytes.size() / frameSize;
+            if (!packetTimedAudio) {
+                block.pts = header.start_time;
+                enqueuePCM(WTF::move(block));
+                continue;
+            }
+            // A Media Kit output buffer may span several encoded packets.
+            // Split on packet boundaries before applying presentation trims,
+            // so timestamp gaps and discarded tails don't shift later audio.
+            size_t offsetFrames = 0;
+            size_t decodedFrames = block.bytes.size() / frameSize;
+            while (offsetFrames < decodedFrames) {
+                if (packetTimings.isEmpty()) {
+                    MSE_TRACE("audio output exceeded its coded packet timeline\n");
+                    return false;
+                }
+                auto& timing = packetTimings.first();
+                uint64_t codedFrames = pcmFramesFor(timing.duration);
+                uint64_t begin = std::min(codedFrames, pcmFramesFor(timing.trimStart));
+                uint64_t end = codedFrames - std::min(codedFrames - begin, pcmFramesFor(timing.trimEnd));
+                size_t amount = std::min<uint64_t>(decodedFrames - offsetFrames, codedFrames - timing.consumedFrames);
+                uint64_t visibleBegin = std::max(begin, timing.consumedFrames);
+                uint64_t visibleEnd = std::min(end, timing.consumedFrames + amount);
+                if (!timing.nonDisplaying && visibleEnd > visibleBegin) {
+                    PCMBlock visible;
+                    visible.pts = toMicroseconds(timing.presentationTime)
+                        + std::llround(visibleBegin * 1000000.0 / output.u.raw_audio.frame_rate);
+                    size_t byteOffset = (offsetFrames + visibleBegin - timing.consumedFrames) * frameSize;
+                    visible.bytes.append(block.bytes.span().subspan(byteOffset, (visibleEnd - visibleBegin) * frameSize));
+                    enqueuePCM(WTF::move(visible));
+                }
+                timing.consumedFrames += amount;
+                offsetFrames += amount;
+                if (timing.consumedFrames == codedFrames)
+                    packetTimings.removeFirst();
+            }
+        }
+        MSE_TRACE("audio finished codec=%s generation=%u decoded=%llu queued=%llu status=%ld\n", info.codec.c_str(), generation,
+            static_cast<unsigned long long>(decodedPCMFrames), static_cast<unsigned long long>(queuedPCMFrames), long(status));
+        return status == B_OK || status == B_LAST_BUFFER_ERROR || status == B_CANCELED
+            || m_queue.aborted() || m_queue.generation() != generation;
+    }
+
+    int64_t blockEnd(const PCMBlock& block) const WTF_REQUIRES_LOCK(m_pcmLock)
+    {
+        return block.pts + int64_t(block.bytes.size() / m_frameSize * 1000000.0 / m_format.frame_rate);
+    }
+
+    static void playCallback(void* cookie, void* buffer, size_t size, const media_raw_audio_format&)
+    {
+        static_cast<HaikuMSEAudioRenderer*>(cookie)->fill(static_cast<uint8_t*>(buffer), size);
+    }
+
+    void fill(uint8_t* buffer, size_t size)
+    {
+        size_t written = 0;
+        if (m_clock.isRunning()) {
+            Locker locker { m_pcmLock };
+            if (m_frameSize && m_format.frame_rate > 0) {
+                double microsecondsPerFrame = 1000000.0 / m_format.frame_rate;
+                // Media time at which the start of this buffer will be heard.
+                int64_t target = m_clock.now() + m_latency;
+                while (written < size && !m_pcm.isEmpty()) {
+                    auto& block = m_pcm.first();
+                    int64_t blockTime = block.pts + int64_t(block.offset / m_frameSize * microsecondsPerFrame);
+                    int64_t outputTime = target + int64_t(written / m_frameSize * microsecondsPerFrame);
+                    int64_t drift = blockTime - outputTime;
+                    if (drift < -60000) {
+                        // Behind the clock: skip ahead.
+                        size_t skip = std::min(block.bytes.size() - block.offset, size_t(-drift / microsecondsPerFrame) * m_frameSize);
+                        skip = std::max(skip, m_frameSize);
+                        block.offset = std::min(block.bytes.size(), block.offset + skip);
+                        m_pcmFrames -= skip / m_frameSize;
+                    } else if (drift > 60000) {
+                        // Ahead of the clock: wait with silence.
+                        size_t silence = std::min(size - written, size_t(drift / microsecondsPerFrame) * m_frameSize);
+                        if (!silence)
+                            break;
+                        std::memset(buffer + written, 0, silence);
+                        written += silence;
+                        continue;
+                    } else {
+                        size_t count = std::min(size - written, block.bytes.size() - block.offset);
+                        count -= count % m_frameSize;
+                        if (!count)
+                            break;
+                        std::memcpy(buffer + written, block.bytes.span().data() + block.offset, count);
+                        block.offset += count;
+                        written += count;
+                        m_pcmFrames -= count / m_frameSize;
+                    }
+                    if (block.offset >= block.bytes.size())
+                        m_pcm.removeFirst();
+                }
+                m_pcmCondition.notifyAll();
+            }
+        }
+        if (written < size)
+            std::memset(buffer + written, 0, size - written);
+    }
+
+    WeakPtr<MediaPlayerPrivateHaikuMSE> m_weakPlayer;
+    const HaikuMSEClock& m_clock;
+    HaikuMSESampleQueue m_queue;
+    RefPtr<Thread> m_thread;
+    Lock m_pcmLock;
+    Condition m_pcmCondition;
+    Deque<PCMBlock> m_pcm WTF_GUARDED_BY_LOCK(m_pcmLock);
+    bool m_outputFormatReady WTF_GUARDED_BY_LOCK(m_pcmLock) { true };
+    int64_t m_lastPCMEnd WTF_GUARDED_BY_LOCK(m_pcmLock) { 0 };
+    int64_t m_pcmFrames WTF_GUARDED_BY_LOCK(m_pcmLock) { 0 };
+    media_raw_audio_format m_format WTF_GUARDED_BY_LOCK(m_pcmLock) { };
+    size_t m_frameSize { 0 };
+    std::atomic<bool> m_formatKnown { false };
+    std::atomic<bool> m_formatChanged { false };
+    std::atomic<int64_t> m_latency { 0 };
+    BSoundPlayer* m_soundPlayer { nullptr };
+    bool m_outputStarted { false };
+    bool m_playing { false };
+    bool m_muted { false };
+    float m_volume { 1 };
+};
