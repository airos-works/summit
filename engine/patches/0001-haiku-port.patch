+// The url, title and favIconUrl of closed tabs need the tabs permission or
+// access to the site, as for open ones.
+static void filterSessionTabHaiku(WebExtensionContext& context, JSON::Object& tab)
+{
+    if (context.hasPermission(WebExtensionPermission::tabs()) || context.hasPermission(URL { tab.getString("url"_s) }))
+        return;
+    tab.remove("url"_s);
+    tab.remove("title"_s);
+    tab.remove("favIconUrl"_s);
+}
+
+static void filterSessionHaiku(WebExtensionContext& context, JSON::Value& value)
+{
+    RefPtr session = value.asObject();
+    if (!session)
+        return;
+    if (RefPtr tab = session->getObject("tab"_s))
+        filterSessionTabHaiku(context, *tab);
+    if (RefPtr window = session->getObject("window"_s)) {
+        if (RefPtr tabs = window->getArray("tabs"_s)) {
+            for (auto& tab : *tabs) {
+                if (RefPtr object = tab->asObject())
+                    filterSessionTabHaiku(context, *object);
+            }
+        }
+    }
+}
