     std::optional<WebExtensionContentWorldType> world;
     std::optional<WebCore::UserStyleLevel> styleLevel;
+
+#if PLATFORM(HAIKU)
+    // userScripts (identifier prefixed with webExtensionUserScriptPrefix): its
+    // sources in order, each a (file, code) pair with one of the two set, and
+    // the glob patterns the page URL must (not) match.
+    std::optional<Vector<std::pair<String, String>>> userScriptSources;
+    std::optional<Vector<String>> includeGlobs;
+    std::optional<Vector<String>> excludeGlobs;
