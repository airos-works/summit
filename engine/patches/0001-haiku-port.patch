+
+void MediaPlayerPrivateHaikuMSE::updatePlaybackState()
+{
+    RefPtr mediaSource = m_mediaSourcePrivate;
+    bool run = !m_paused && !m_pendingSeek && (m_dash ? !m_dash->isStopped() && m_dash->hasMetadata() : bool(mediaSource));
+    run = run && m_networkState != MediaPlayer::NetworkState::DecodeError;
+#if ENABLE(ENCRYPTED_MEDIA)
+    run = run && !m_waitingForKey;
+#endif
+    auto now = currentTime();
+    auto mediaDuration = duration();
+    bool atDurationEnd = !m_pendingSeek && mediaDuration.isValid() && !mediaDuration.isIndefinite()
+        && !mediaDuration.isPositiveInfinite() && now >= mediaDuration;
+    // HTML can notice endedPlayback() and pause the engine before its next
+    // timer tick. The final position notification is still required to fire
+    // the DOM ended event. An open MSE at its buffered edge is only stalled.
+    bool reachedEnd = atDurationEnd && (m_dash ? m_dash->hasEnded() : mediaSource && mediaSource->isEnded());
+    bool announceEnd = reachedEnd && !m_reachedEnd;
+    m_reachedEnd = reachedEnd;
+    if (run) {
+        if (atDurationEnd) {
+            run = false;
+        } else if (m_clock.isRunning())
+            run = m_dash ? m_dash->hasCurrentData() && m_dash->bufferedEnd() > now.toDouble() : mediaSource->hasFutureTime(now, MediaTime::zeroTime());
+        else {
+            run = m_dash ? m_dash->hasCurrentData() && (m_dash->bufferedEnd() - now.toDouble() >= 0.1 || m_dash->hasEnded()) : mediaSource->hasFutureTime(now, MediaTime(1, 10));
+            // Preroll: start the clock once the picture at this position has
+            // been decoded, or every frame decoded meanwhile arrives late and
+            // is dropped. Give up waiting after a second in case no decoder
+            // can be made for the video.
+            if (run && hasVideo() && (!m_videoRenderer || !m_videoRenderer->hasFrameSinceFlush())) {
+                if (!m_prerollStartedAt)
+                    m_prerollStartedAt = MonotonicTime::now();
+                if (MonotonicTime::now() - m_prerollStartedAt < 1_s)
+                    run = false;
+            }
+        }
+    }
+    if (run || m_paused)
+        m_prerollStartedAt = { };
+    if (run != m_clock.isRunning()) {
+        if (run)
+            m_clock.start();
+        else
+            m_clock.stop();
+        bool stalled = !run && !m_paused && !m_pendingSeek;
+        MSE_TRACE("clock %s at %.3f%s\n", run ? "started" : "stopped", currentTime().toDouble(), stalled ? (reachedEnd ? " (end)" : " (stalled)") : "");
+        if (stalled != m_stalled) {
+            m_stalled = stalled;
+            if (!announceEnd) {
+                if (RefPtr player = m_player.get())
+                    player->timeChanged();
+            }
+        }
+    }
+    if (m_audioRenderer)
+        m_audioRenderer->setPlaying(run);
+    if (announceEnd) {
+        if (RefPtr player = m_player.get())
+            player->timeChanged();
+    }
+
+    bool needsTimer = m_dash ? !m_dash->isStopped() : !m_paused;
+    if (needsTimer && !m_playbackTimer.isActive()) m_playbackTimer.startRepeating(50_ms);
+    else if (!needsTimer) m_playbackTimer.stop();
+}
+
+void MediaPlayerPrivateHaikuMSE::playbackTimerFired()
+{
+    Ref protectedThis { *this };
+    if (m_dash) {
+        m_dash->tick(currentTime().toDouble(), MonotonicTime::now().secondsSinceEpoch().value());
+        dashChanged();
+    }
+    updatePlaybackState();
+    if (mseTraceEnabled() && m_videoRenderer && ++m_statsTicks >= 100) {
+        m_statsTicks = 0;
+        MSE_TRACE("stats time=%.2f presented=%u dropped=%u running=%d\n", currentTime().toDouble(),
+            m_videoRenderer->presentedFrames(), m_videoRenderer->droppedFrames(), m_clock.isRunning());
+    }
+    if (m_audioRenderer)
+        m_audioRenderer->updateOutput();
+}
