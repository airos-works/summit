+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEB_BLUETOOTH)
+#include "BluetoothUUID.h"
+namespace WebCore {
+String BluetoothUUID::canonicalUUID(uint32_t value)
+{ return String::fromLatin1(BluetoothHaiku::UUID::alias(value).string()); }
+ExceptionOr<String> BluetoothUUID::resolve(BluetoothHaiku::UUIDKind kind, const BluetoothUUIDValue& value)
+{
+    if (auto* alias = std::get_if<uint32_t>(&value)) return canonicalUUID(*alias);
+    auto& name = std::get<String>(value);
+    auto bytes = name.utf8();
+    if (auto uuid = BluetoothHaiku::namedUUID(kind, std::string_view { bytes.legacyCStringPointer(), bytes.length() })) return String::fromLatin1(uuid->string());
+    return Exception { ExceptionCode::TypeError, "Invalid Bluetooth UUID or assigned name"_s };
+}
+}
+#endif
