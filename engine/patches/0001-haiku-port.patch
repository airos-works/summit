+void MediaPlayerPrivateHaikuMSE::initializationDataEncountered(std::vector<uint8_t>&& headers)
+{
+    if (headers.empty()) return;
+    if (RefPtr player = m_player.get()) {
+        if (m_dashLoader && m_dashLoader->hasInsecureResource())
+            player->initializationDataEncountered(emptyString(), nullptr);
+        else
+            player->initializationDataEncountered("cenc"_s, ArrayBuffer::create(std::span { headers }));
+    }
+}
