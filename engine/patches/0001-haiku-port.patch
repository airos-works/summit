@@ -0,0 +1,44 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <OS.h>
+#include <wtf/Function.h>
+#include <wtf/JSONValues.h>
+#include <wtf/Seconds.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+
+// What an engine process tells the browser's debugging tools about itself
+// (BWebKitProcessDiagnostics, WebKitDiagnostics.h). A thread of the process
+// waits on a port named "WebKit diagnostics" for a request, a JSON object:
+//   {"topics": "pages,memory,media,graphics,network" or "all", "timeoutMs": 2000}
+//   {"action": "gc" | "release-memory"}
+// Topics that only the main thread can read are collected there, within the
+// time limit; a main thread that does not get to it in time is reported as
+// "unresponsive" and the answer carries what other threads can read. The
+// thread costs nothing while nobody asks.
+namespace ProcessDiagnosticsHaiku {
+
+// Starts the port's thread once; role is "web" or "network".
+void start(const char* role);
+// A topic's provider: on the main run loop when mainThread, else on the
+// diagnostics thread (thread-safe reads only).
+void addTopic(const char* name, bool mainThread, Function<Ref<JSON::Object>()>&&);
+// An action, run on the main run loop.
+void addAction(const char* name, Function<Ref<JSON::Object>()>&&);
+// Asks the process team, waiting at most timeout. A null string: no answer.
+String request(team_id, const String& requestJSON, Seconds timeout);
+
+// The compositors of this process (ThreadedCompositor.cpp reports to it).
+// Any thread.
+void setGLStrings(const char* renderer, const char* vendor, const char* version);
+void compositorCreated();
+void compositorDestroyed();
+void frameRendered(bigtime_t started, bigtime_t duration, bool scrolling);
+Ref<JSON::Object> compositorReport();
+
+} // namespace ProcessDiagnosticsHaiku
+
+} // namespace WebKit
