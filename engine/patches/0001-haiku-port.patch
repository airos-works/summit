+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#ifndef SUMMIT_USB_STANDALONE
+#include "config.h"
+#endif
+#include "USBDeviceSessionHaiku.h"
+
+#include <USBKit.h>
+#include <OS.h>
+#include <algorithm>
+#include <cstring>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace WebKit::USBHaiku {
+namespace {
+
+// The stable prefix of Haiku's usb_raw.h ABI (MIT, Haiku Inc. 2006-2008).
+// Use raw transfer replies because USBKit collapses STALL into B_ERROR.
+constexpr uint32_t getVersion = 0x1000;
+constexpr uint32_t controlTransferCommand = 0x4000;
+constexpr uint32_t interruptTransferCommand = 0x4001;
+constexpr uint32_t bulkTransferCommand = 0x4002;
+constexpr uint32_t isochronousTransferCommand = 0x4003;
+struct RawControl {
+    status_t status;
+    uint8_t requestType;
+    uint8_t request;
+    uint16_t value;
+    uint16_t index;
+    uint16_t length;
+    void* data;
+};
+struct RawTransfer {
+    status_t status;
+    uint32_t interfaceIndex;
+    uint32_t endpointIndex;
+    void* data;
+    size_t length;
+};
+struct RawIsochronous {
+    status_t status;
+    uint32_t interfaceIndex;
+    uint32_t endpointIndex;
+    void* data;
+    size_t length;
+    usb_iso_packet_descriptor* packets;
+    uint32_t packetCount;
+};
+
+// Raw USB waits are interruptible by killing their calling thread. Run only
+// the ioctl in that thread: buffers and C++ resources remain owned here. On
+// cancellation the kernel cancels its queued request before unwinding, and we
+// join before releasing buffers. This also bounds a non-responsive transfer.
+Error transferIoctl(int fd, uint32_t operation, void* command, size_t size, const std::atomic<bool>& aborted)
+{
+    if (aborted.load())
+        return Error::Abort;
+    struct Call { int fd; uint32_t operation; void* command; size_t size; } call { fd, operation, command, size };
+    auto thread = spawn_thread([](void* data) -> int32 {
+        auto& call = *static_cast<Call*>(data);
+        return ioctl(call.fd, call.operation, call.command, call.size) ? B_ERROR : B_OK;
+    }, "WebUSB transfer", B_NORMAL_PRIORITY, &call);
+    if (thread < B_OK)
+        return Error::Network;
+    if (resume_thread(thread) != B_OK) {
+        kill_thread(thread);
+        status_t ignored;
+        wait_for_thread(thread, &ignored);
+        return Error::Network;
+    }
+    auto deadline = system_time() + 10000000;
+    for (;;) {
+        status_t result = B_ERROR;
+        auto wait = wait_for_thread_etc(thread, B_RELATIVE_TIMEOUT, 100000, &result);
+        if (wait == B_OK)
+            return aborted.load() ? Error::Abort : result == B_OK ? Error::None : Error::Network;
+        if (wait == B_INTERRUPTED)
+            continue;
+        if (wait != B_TIMED_OUT && wait != B_WOULD_BLOCK) {
+            kill_thread(thread);
+            wait_for_thread(thread, &result);
+            return Error::Network;
+        }
+        bool cancelled = aborted.load();
+        if (cancelled || system_time() >= deadline) {
+            kill_thread(thread);
+            wait_for_thread(thread, &result);
+            return cancelled ? Error::Abort : Error::Network;
+        }
+    }
+}
+
+Result rawResult(status_t status, size_t transferred, size_t capacity)
+{
+    if (status == 3) {
+        Result r;
+        r.status = Status::Stall;
+        return r;
+    }
+    if (status != 0)
+        return Result::failure(Error::Network);
+    Result r;
+    r.status = transferred > capacity ? Status::Babble : Status::Ok;
+    r.transferred = std::min(transferred, capacity);
+    return r;
+}
+
+bool validPath(const std::string& path)
+{
+    constexpr std::string_view prefix = "/dev/bus/usb/";
+    if (!path.starts_with(prefix) || path.size() > 256)
+        return false;
+    auto rest = std::string_view(path).substr(prefix.size());
+    if (rest.empty() || rest.front() == '/' || rest.back() == '/')
+        return false;
+    for (char c : rest) {
+        if ((c < '0' || c > '9') && c != '/' && c != 'h' && c != 'u' && c != 'b')
+            return false;
+    }
+    return rest.find("//") == std::string_view::npos;
+}
+
+std::string safeString(const char* text)
+{
+    if (!text)
+        return { };
+    return std::string(text, strnlen(text, 1024));
+}
+
+std::optional<uint8_t> activeConfiguration(const BUSBDevice& device)
+{
+    uint8_t value = 0;
+    if (device.ControlTransfer(0x80, 8, 0, 0, 1, &value) != 1)
+        return std::nullopt;
+    return value;
+}
+
+std::optional<Device> describe(BUSBDevice& device, const std::string& path)
+{
+    if (device.InitCheck() != B_OK || device.CountConfigurations() > 32)
+        return std::nullopt;
+    Device d;
+    d.path = path;
+    d.usbVersion = device.USBVersion();
+    d.vendorId = device.VendorID();
+    d.productId = device.ProductID();
+    d.deviceVersion = device.Version();
+    d.classCode = device.Class();
+    d.subclassCode = device.Subclass();
+    d.protocolCode = device.Protocol();
+    size_t descriptorCount = 0;
+    for (uint32_t c = 0; c < device.CountConfigurations(); ++c) {
+        auto* config = device.ConfigurationAt(c);
+        if (!config || config->CountInterfaces() > 128)
+            return std::nullopt;
+        Configuration configuration;
+        configuration.value = config->Descriptor()->configuration_value;
+        for (uint32_t i = 0; i < config->CountInterfaces(); ++i) {
+            auto* iface = config->InterfaceAt(i);
+            if (!iface || iface->CountAlternates() > 128)
+                return std::nullopt;
+            Interface interface;
+            interface.number = iface->Descriptor()->interface_number;
+            interface.alternate = iface->Descriptor()->alternate_setting;
+            for (uint32_t a = 0; a < iface->CountAlternates(); ++a) {
+                auto* alt = iface->AlternateAt(a);
+                if (!alt || alt->CountEndpoints() > 30 || ++descriptorCount > 4096)
+                    return std::nullopt;
+                Alternate alternate;
+                alternate.setting = alt->Descriptor()->alternate_setting;
+                alternate.classCode = alt->Class();
+                alternate.subclassCode = alt->Subclass();
+                alternate.protocolCode = alt->Protocol();
+                // Do not read strings until the complete class tree is known.
+                for (uint32_t e = 0; e < alt->CountEndpoints(); ++e) {
+                    auto* endpoint = alt->EndpointAt(e);
+                    if (!endpoint || ++descriptorCount > 4096)
+                        return std::nullopt;
+                    auto* desc = endpoint->Descriptor();
+                    Endpoint value;
+                    value.number = desc->endpoint_address & 15;
+                    value.input = endpoint->IsInput();
+                    value.type = desc->attributes & 3;
+                    value.packetSize = endpoint->MaxPacketSize() & 0x7ff;
+                    if (value.number && value.type)
+                        alternate.endpoints.push_back(value);
+                }
+                interface.alternates.push_back(std::move(alternate));
+            }
+            configuration.interfaces.push_back(std::move(interface));
+        }
+        d.configurations.push_back(std::move(configuration));
+    }
+    // Protected devices are observable only to the broker's policy test, never
+    // returned to a web origin. Avoid even string/control reads for these.
+    if (!eligible(d))
+        return d;
+    d.manufacturer = safeString(device.ManufacturerString());
+    d.product = safeString(device.ProductString());
+    d.serial = safeString(device.SerialNumberString());
+    for (size_t c = 0; c < d.configurations.size(); ++c) {
+        auto* config = device.ConfigurationAt(c);
+        d.configurations[c].name = safeString(config->ConfigurationString());
+        for (size_t i = 0; i < d.configurations[c].interfaces.size(); ++i) {
+            auto* iface = config->InterfaceAt(i);
+            auto& interface = d.configurations[c].interfaces[i];
+            for (size_t a = 0; a < interface.alternates.size(); ++a)
+                interface.alternates[a].name = safeString(iface->AlternateAt(a)->InterfaceString());
+        }
+    }
+    // Length-delimited serial avoids identity collisions with delimiter bytes.
+    d.identity = std::to_string(d.vendorId) + ":" + std::to_string(d.productId) + ":"
+        + std::to_string(d.deviceVersion) + ":" + std::to_string(d.serial.size()) + ":" + d.serial;
+    struct stat st;
+    if (lstat(path.c_str(), &st))
+        return std::nullopt;
+    // A reattached serial-less device must not inherit a grant from a device
+    // which previously occupied the same USB address.
+    d.identity += ":" + std::to_string(st.st_dev) + ":" + std::to_string(st.st_ino);
+    if (auto value = activeConfiguration(device))
+        d.configuration = *value;
+    return d;
+}
+
+void enumerate(const std::string& path, unsigned depth, std::vector<Device>& result)
+{
+    if (depth > 8 || result.size() >= 128)
+        return;
+    auto* dir = opendir(path.c_str());
+    if (!dir)
+        return;
+    while (auto* entry = readdir(dir)) {
+        if (entry->d_name[0] == '.')
+            continue;
+        auto child = path + '/' + entry->d_name;
+        if (!validPath(child))
+            continue;
+        struct stat st;
+        if (lstat(child.c_str(), &st) || S_ISLNK(st.st_mode))
+            continue;
+        if (S_ISDIR(st.st_mode))
+            enumerate(child, depth + 1, result);
+        else if (auto device = describeDevice(child))
+            result.push_back(std::move(*device));
+        if (result.size() >= 128)
+            break;
+    }
+    closedir(dir);
+}
+} // namespace
+
+std::optional<Device> describeDevice(const std::string& path)
+{
+    if (!validPath(path))
+        return std::nullopt;
+    BUSBDevice device(path.c_str());
+    return describe(device, path);
+}
+
+std::vector<Device> enumerateDevices()
+{
+    std::vector<Device> result;
+    enumerate("/dev/bus/usb", 0, result);
+    return result;
+}
+
+Session::Session() = default;
+Session::~Session() { close(); }
+
+Result Session::open(const Device& approved)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (opened())
+        return { };
+    if (!eligible(approved) || !validPath(approved.path))
+        return Result::failure(Error::Security);
+    struct stat before;
+    if (lstat(approved.path.c_str(), &before) || S_ISLNK(before.st_mode))
+        return Result::failure(Error::NotFound);
+    auto device = std::make_unique<BUSBDevice>(approved.path.c_str());
+    auto info = describe(*device, approved.path);
+    if (!info)
+        return Result::failure(Error::NotFound);
+    if (!eligible(*info) || info->identity != approved.identity)
+        return Result::failure(Error::Security);
+    int fd = ::open(approved.path.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0)
+        return Result::failure(Error::NotFound);
+    struct stat opened;
+    if (fstat(fd, &opened) || opened.st_dev != before.st_dev || opened.st_ino != before.st_ino) {
+        ::close(fd);
+        return Result::failure(Error::NotFound);
+    }
+    status_t version = 0;
+    // v0x15 adds streaming commands, without changing transfer structures.
+    if (ioctl(fd, getVersion, &version, sizeof(version)) || (version != 0x14 && version != 0x15)) {
+        ::close(fd);
+        return Result::failure(Error::NotSupported);
+    }
+    m_rawFD = fd;
+    m_device = std::move(device);
+    m_state = std::move(*info);
+    return { };
+}
+
+void Session::close()
+{
+    if (m_rawFD >= 0)
+        ::close(m_rawFD);
+    m_rawFD = -1;
+    m_claimed.clear();
+    for (auto& c : m_state.configurations) {
+        for (auto& i : c.interfaces)
+            i.claimed = false;
+    }
+    m_device.reset();
+}
+
+const BUSBConfiguration* Session::configuration() const
+{
+    if (!m_device || !m_state.configuration)
+        return nullptr;
+    for (uint32_t i = 0; i < m_device->CountConfigurations(); ++i) {
+        auto* config = m_device->ConfigurationAt(i);
+        if (config && config->Descriptor()->configuration_value == m_state.configuration)
+            return config;
+    }
+    return nullptr;
+}
+
+bool Session::currentConfigurationMatches() const
+{
+    if (!m_device || m_rawFD < 0 || m_aborted.load())
+        return false;
+    uint8_t active = 0;
+    RawControl command { 0, 0x80, 8, 0, 0, 1, &active };
+    return transferIoctl(m_rawFD, controlTransferCommand, &command, sizeof(command), m_aborted) == Error::None
+        && command.status == 0 && command.length == 1 && active == m_state.configuration;
+}
+
+const BUSBInterface* Session::interface(uint8_t number) const
+{
+    auto* config = configuration();
+    if (!config)
+        return nullptr;
+    for (uint32_t i = 0; i < config->CountInterfaces(); ++i) {
+        auto* iface = config->InterfaceAt(i);
+        if (iface && iface->Descriptor()->interface_number == number)
+            return iface;
+    }
+    return nullptr;
+}
+
+const BUSBEndpoint* Session::endpoint(bool input, uint8_t number) const
+{
+    if (!number || number > 15)
+        return nullptr;
+    for (auto n : m_claimed) {
+        auto* iface = interface(n);
+        if (!iface)
+            continue;
+        for (uint32_t i = 0; i < iface->CountEndpoints(); ++i) {
+            auto* endpoint = iface->EndpointAt(i);
+            if (endpoint && (endpoint->Descriptor()->endpoint_address & 15) == number && endpoint->IsInput() == input)
+                return endpoint;
+        }
+    }
+    return nullptr;
+}
+
+void Session::refreshInterfaceState()
+{
+    for (auto& c : m_state.configurations) {
+        for (auto& i : c.interfaces) {
+            i.claimed = c.value == m_state.configuration && m_claimed.contains(i.number);
+            if (c.value == m_state.configuration) {
+                if (auto* iface = interface(i.number))
+                    i.alternate = iface->Descriptor()->alternate_setting;
+            }
+        }
+    }
+}
+
+Result Session::selectConfiguration(uint8_t value)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device)
+        return Result::failure(Error::InvalidState);
+    for (uint32_t i = 0; i < m_device->CountConfigurations(); ++i) {
+        auto* config = m_device->ConfigurationAt(i);
+        if (!config || config->Descriptor()->configuration_value != value)
+            continue;
+        if (value == m_state.configuration && currentConfigurationMatches())
+            return { };
+        if (!m_claimed.empty())
+            return Result::failure(Error::InvalidState);
+        if (m_device->SetConfiguration(config) != B_OK)
+            return Result::failure(Error::Network);
+        m_state.configuration = value;
+        refreshInterfaceState();
+        return { };
+    }
+    return Result::failure(Error::NotFound);
+}
+
+Result Session::claimInterface(uint8_t number)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration() || !currentConfigurationMatches())
+        return Result::failure(Error::InvalidState);
+    auto* iface = interface(number);
+    if (!iface)
+        return Result::failure(Error::NotFound);
+    for (uint32_t i = 0; i < iface->CountAlternates(); ++i) {
+        auto* alt = iface->AlternateAt(i);
+        if (!alt || protectedClass(alt->Class()))
+            return Result::failure(Error::Security);
+    }
+    m_claimed.insert(number);
+    refreshInterfaceState();
+    return { };
+}
+
+Result Session::releaseInterface(uint8_t number)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration())
+        return Result::failure(Error::InvalidState);
+    if (!interface(number))
+        return Result::failure(Error::NotFound);
+    m_claimed.erase(number);
+    refreshInterfaceState();
+    return { };
+}
+
+Result Session::selectAlternateInterface(uint8_t number, uint8_t setting)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration() || !currentConfigurationMatches() || !m_claimed.contains(number))
+        return Result::failure(Error::InvalidState);
+    auto* iface = interface(number);
+    if (!iface)
+        return Result::failure(Error::NotFound);
+    for (uint32_t i = 0; i < iface->CountAlternates(); ++i) {
+        auto* alt = iface->AlternateAt(i);
+        if (!alt || alt->Descriptor()->alternate_setting != setting)
+            continue;
+        if (protectedClass(alt->Class()))
+            return Result::failure(Error::Security);
+        if (const_cast<BUSBInterface*>(iface)->SetAlternate(i) != B_OK)
+            return Result::failure(Error::Network);
+        refreshInterfaceState();
+        return { };
+    }
+    return Result::failure(Error::NotFound);
+}
+
+Result Session::clearHalt(bool input, uint8_t number)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration() || !currentConfigurationMatches())
+        return Result::failure(Error::InvalidState);
+    auto* ep = endpoint(input, number);
+    if (!ep)
+        return Result::failure(Error::NotFound);
+    if (ep->IsIsochronous())
+        return Result::failure(Error::InvalidAccess);
+    return ep->ClearStall() == B_OK ? Result { } : Result::failure(Error::Network);
+}
+
+Result Session::controlTransfer(bool input, uint8_t type, uint8_t recipient, uint8_t request,
+    uint16_t value, uint16_t index, size_t length, std::span<const uint8_t> output)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device)
+        return Result::failure(Error::InvalidState);
+    if (type > 2 || recipient > 3 || length > 65535 || (!input && length != output.size()))
+        return Result::failure(Error::Range);
+    if (recipient == 1 || recipient == 2) {
+        if (!configuration() || !currentConfigurationMatches())
+            return Result::failure(Error::InvalidState);
+        if (recipient == 1 && !m_claimed.contains(index & 0xff))
+            return Result::failure(Error::InvalidState);
+        if (recipient == 2 && !endpoint(index & 0x80, index & 0x0f))
+            return Result::failure(Error::NotFound);
+    }
+    if (type == 0 && !allowedStandardControl(input, request))
+        return Result::failure(Error::Security);
+    std::vector<uint8_t> data(std::max<size_t>(length, 1));
+    if (!input)
+        std::copy(output.begin(), output.end(), data.begin());
+    RawControl command { 0, uint8_t((input ? 0x80 : 0) | (type << 5) | recipient), request, value, index, uint16_t(length), data.data() };
+    if (auto error = transferIoctl(m_rawFD, controlTransferCommand, &command, sizeof(command), m_aborted); error != Error::None)
+        return Result::failure(error);
+    auto result = rawResult(command.status, command.length, length);
+    if (input && result.error == Error::None) {
+        data.resize(result.transferred);
+        result.data = std::move(data);
+    }
+    return result;
+}
+
+Result Session::transfer(bool input, uint8_t number, size_t length, std::span<const uint8_t> output)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration() || !currentConfigurationMatches())
+        return Result::failure(Error::InvalidState);
+    if (length > maximumTransferSize || (!input && length != output.size()))
+        return Result::failure(Error::Range);
+    auto* ep = endpoint(input, number);
+    if (!ep)
+        return Result::failure(Error::NotFound);
+    if (!ep->IsBulk() && !ep->IsInterrupt())
+        return Result::failure(Error::InvalidAccess);
+    std::vector<uint8_t> data(std::max<size_t>(length, 1));
+    if (!input)
+        std::copy(output.begin(), output.end(), data.begin());
+    RawTransfer command { 0, ep->Interface()->Index(), ep->Index(), data.data(), length };
+    if (auto error = transferIoctl(m_rawFD, ep->IsBulk() ? bulkTransferCommand : interruptTransferCommand, &command, sizeof(command), m_aborted); error != Error::None)
+        return Result::failure(error);
+    auto result = rawResult(command.status, command.length, length);
+    if (input && result.error == Error::None) {
+        data.resize(result.transferred);
+        result.data = std::move(data);
+    }
+    return result;
+}
+
+Result Session::isochronousTransfer(bool input, uint8_t number, const std::vector<uint32_t>& lengths,
+    std::span<const uint8_t> output)
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device || !configuration() || !currentConfigurationMatches())
+        return Result::failure(Error::InvalidState);
+    size_t length = 0;
+    if (!validPacketLengths(lengths, length) || (!input && length != output.size()))
+        return Result::failure(Error::Range);
+    auto* ep = endpoint(input, number);
+    if (!ep)
+        return Result::failure(Error::NotFound);
+    if (!ep->IsIsochronous())
+        return Result::failure(Error::InvalidAccess);
+    if (lengths.empty())
+        return { };
+    std::vector<usb_iso_packet_descriptor> packets(lengths.size());
+    for (size_t i = 0; i < lengths.size(); ++i) {
+        if (lengths[i] > ep->MaxPacketSize())
+            return Result::failure(Error::Range);
+        packets[i].request_length = lengths[i];
+    }
+    std::vector<uint8_t> data(std::max<size_t>(length, 1));
+    if (!input)
+        std::copy(output.begin(), output.end(), data.begin());
+    RawIsochronous command { 0, ep->Interface()->Index(), ep->Index(), data.data(), length, packets.data(), uint32_t(packets.size()) };
+    if (auto error = transferIoctl(m_rawFD, isochronousTransferCommand, &command, sizeof(command), m_aborted); error != Error::None)
+        return Result::failure(error);
+    auto result = rawResult(command.status, command.length, length);
+    if (result.error != Error::None)
+        return result;
+    for (size_t i = 0; i < packets.size(); ++i) {
+        if (packets[i].actual_length < 0 || uint32_t(packets[i].actual_length) > lengths[i])
+            return Result::failure(Error::Network);
+        result.packets.push_back({ packets[i].status == B_OK ? Status::Ok : Status::Stall, uint32_t(packets[i].actual_length) });
+    }
+    if (input) {
+        // Packet data retains the requested offsets, including short packets.
+        data.resize(length);
+        result.data = std::move(data);
+    }
+    return result;
+}
+
+Result Session::reset()
+{
+    if (m_aborted.load())
+        return Result::failure(Error::Abort);
+    if (!m_device)
+        return Result::failure(Error::InvalidState);
+    // Haiku's raw USB ABI has no port reset operation. Do not pretend that a
+    // SET_CONFIGURATION or a close/open cycle resets the hardware.
+    return Result::failure(Error::NotSupported);
+}
+
+} // namespace WebKit::USBHaiku
