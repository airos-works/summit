+// Parse EME and Bluetooth directives using the existing structured-fields parser.
+// Other features retain their existing policy behavior. Origin lists use the same
+// exact-origin matching as iframe allowlists; unsupported expressions grant nothing.
+static PermissionsPolicy::PolicyDirective declaredDeviceAndMediaPolicy(const Document& document)
+{
+    PermissionsPolicy::PolicyDirective result;
+    RefPtr loader = document.loader();
+    if (!loader)
+        return result;
+    auto dictionary = RFC8941::parseDictionaryStructuredFieldValue(loader->response().httpHeaderField("Permissions-Policy"_s));
+    if (!dictionary)
+        return result;
+    for (auto entry : { std::pair { "encrypted-media"_s, PermissionsPolicy::Feature::EncryptedMedia }, std::pair { "bluetooth"_s, PermissionsPolicy::Feature::Bluetooth } }) {
+        auto iterator = dictionary->find(entry.first);
+        if (iterator == dictionary->end())
+            continue;
+        auto& value = iterator->value.first;
+        HashSet<SecurityOriginData> origins;
+        bool allOrigins = false;
+        auto append = [&](const RFC8941::BareItem& item) {
+            if (auto* token = std::get_if<RFC8941::Token>(&item)) {
+                if (token->string() == "*"_s)
+                    allOrigins = true;
+                else if (token->string() == "self"_s)
+                    origins.add(document.securityOrigin().data());
+            } else if (auto* string = std::get_if<String>(&item)) {
+                URL url { *string };
+                auto authority = string->find("://"_s);
+                if (url.isValid() && authority != notFound && string->find('/', authority + 3) == notFound
+                    && !string->contains('*') && !string->contains('?') && !string->contains('#') && !string->contains('@')) {
+                    auto origin = SecurityOrigin::create(url);
+                    if (!origin->isOpaque())
+                        origins.add(origin->data());
+                }
+            }
+        };
+        if (auto* innerList = std::get_if<RFC8941::InnerList>(&value)) {
+            for (auto& item : *innerList)
+                append(item.first);
+        } else {
+            auto& item = std::get<RFC8941::BareItem>(value);
+            if (std::holds_alternative<RFC8941::Token>(item))
+                append(item);
+        }
+        result.add(entry.second,
+            allOrigins ? Allowlist { Allowlist::AllowAllOrigins { } } : Allowlist { WTF::move(origins) });
+    }
+    return result;
+}
