+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPIHistory.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionAPINamespace.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionEventListenerType.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+#include <wtf/URL.h>
+
+namespace WebKit {
+
+static RefPtr<JSON::Object> objectArgument(const JSON::Value* value, ASCIILiteral name, String& exception)
+{
+    RefPtr object = value ? const_cast<JSON::Value*>(value)->asObject() : nullptr;
+    if (!object)
+        exception = toErrorString(nullString(), name, "an object is expected"_s);
+    return object;
+}
+
+static bool copyNumber(const JSON::Object& from, JSON::Object& to, ASCIILiteral key, String& exception)
+{
+    RefPtr value = from.getValue(key);
+    if (!value)
+        return true;
+    auto number = value->asDouble();
+    if (!number || !std::isfinite(*number)) {
+        exception = toErrorString(nullString(), key, "a number is expected"_s);
+        return false;
+    }
+    to.setDouble(key, *number);
+    return true;
+}
+
+// The url member, which must be a valid absolute URL.
+static bool copyURL(const JSON::Object& from, JSON::Object& to, String& exception)
+{
+    auto url = from.getString("url"_s);
+    if (url.isNull() || !URL { url }.isValid()) {
+        exception = toErrorString(nullString(), "url"_s, "a valid URL is expected"_s);
+        return false;
+    }
+    to.setString("url"_s, url);
+    return true;
+}
+
+void WebExtensionAPIHistory::search(RefPtr<JSON::Value> queryInfo, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(queryInfo.get(), "query"_s, exception);
+    if (!object)
+        return;
+    auto text = object->getString("text"_s);
+    if (text.isNull()) {
+        exception = toErrorString(nullString(), "text"_s, "a string is expected"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    arguments->setString("text"_s, text);
+    // Chrome's defaults: the last 24 hours, at most 100 results.
+    if (!copyNumber(*object, arguments, "startTime"_s, exception) || !copyNumber(*object, arguments, "endTime"_s, exception) || !copyNumber(*object, arguments, "maxResults"_s, exception))
+        return;
+    query("search"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::getVisits(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(details.get(), "details"_s, exception);
+    Ref arguments = JSON::Object::create();
+    if (!object || !copyURL(*object, arguments, exception))
+        return;
+    query("getVisits"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::addUrl(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(details.get(), "details"_s, exception);
+    Ref arguments = JSON::Object::create();
+    if (!object || !copyURL(*object, arguments, exception))
+        return;
+    if (auto title = object->getString("title"_s); !title.isNull())
+        arguments->setString("title"_s, title);
+    if (!copyNumber(*object, arguments, "visitTime"_s, exception))
+        return;
+    query("addUrl"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::deleteUrl(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(details.get(), "details"_s, exception);
+    Ref arguments = JSON::Object::create();
+    if (!object || !copyURL(*object, arguments, exception))
+        return;
+    query("deleteUrl"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::deleteRange(RefPtr<JSON::Value> range, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = objectArgument(range.get(), "range"_s, exception);
+    if (!object)
+        return;
+    if (!object->getValue("startTime"_s) || !object->getValue("endTime"_s)) {
+        exception = toErrorString(nullString(), "range"_s, "'startTime' and 'endTime' are required"_s);
+        return;
+    }
+    Ref arguments = JSON::Object::create();
+    if (!copyNumber(*object, arguments, "startTime"_s, exception) || !copyNumber(*object, arguments, "endTime"_s, exception))
+        return;
+    query("deleteRange"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::deleteAll(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    query("deleteAll"_s, JSON::Object::create(), WTF::move(callback));
+}
+
+void WebExtensionAPIHistory::query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::HistoryQueryHaiku(method, arguments->toJSONString()),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isEmpty() || *result == "null"_s) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+WebExtensionAPIEvent& WebExtensionAPIHistory::onVisited()
+{
+    if (!m_onVisited)
+        m_onVisited = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::HistoryOnVisited);
+    return *m_onVisited;
+}
+
+WebExtensionAPIEvent& WebExtensionAPIHistory::onVisitRemoved()
+{
+    if (!m_onVisitRemoved)
+        m_onVisitRemoved = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::HistoryOnVisitRemoved);
+    return *m_onVisitRemoved;
+}
+
+void WebExtensionContextProxy::dispatchHistoryEventHaiku(WebExtensionEventListenerType type, const String& json)
+{
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        auto& history = namespaceObject.history();
+        auto& event = type == WebExtensionEventListenerType::HistoryOnVisited ? history.onVisited() : history.onVisitRemoved();
+        event.invokeListenersWithJSONArguments({ json });
+    });
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
