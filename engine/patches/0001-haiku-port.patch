+void DownloadRegistryHaiku::setObserver(Function<void(const DownloadRegistryEventHaiku&)>&& observer)
+{
+    ASSERT(RunLoop::isMain());
+    m_observer = WTF::move(observer);
+}
+
+void DownloadRegistryHaiku::registerDownload(DownloadProxy& download, const BMessenger& view, const String& requestedFilename, const Resume* resume,
+    Destination choice)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    if (auto* existing = entry(identifier)) {
+        if (view.IsValid())
+            existing->view = view;
+        if (!requestedFilename.isEmpty() && existing->destination.isEmpty())
+            existing->requestedFilename = requestedFilename;
+        return;
+    }
+    // "folder/name.txt": the folders, each made a safe name, are made in the
+    // download directory when the download starts writing.
+    auto directory = m_directory;
+    auto filename = requestedFilename;
+    if (!m_directory.isEmpty() && filename.contains('/')) {
+        auto parts = filename.split('/');
+        filename = parts.isEmpty() ? String() : parts.takeLast();
+        for (auto& part : parts) {
+            if (part.isEmpty())
+                continue;
+            auto folder = String::fromUTF8(sanitizedDownloadFilename(BString(part.utf8().legacyCStringPointer())).String());
+            directory = FileSystem::pathByAppendingComponent(directory, folder);
+        }
+    }
+    auto item = std::make_unique<Entry>(download, m_listener, directory);
+    item->view = view;
+    item->requestedFilename = filename;
+    item->choice = choice;
+    if (resume)
+        item->continues = resume->continues;
+    if (resume && !resume->path.isEmpty()) {
+        item->resume = *resume;
+        item->destination = resume->path;
+        item->currentSize = resume->offset;
+        item->ownsFile = true;
+    }
+    auto* value = item.get();
+    m_downloads.emplace(identifier, std::move(item));
+    download.setClient(adoptRef(*new DownloadClientHaiku(weak_from_this())));
+    auto delivered = notify(*value, B_WEBKIT_DOWNLOAD_STARTED);
+    if (m_shuttingDown)
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_CANCELLED, B_CANCELED, "Download context closed"_s);
+    else if (delivered != B_OK)
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, delivered, "Download listener is unavailable"_s);
+    else if (value->directory.isEmpty())
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, B_NO_INIT, "Download directory is not configured"_s);
+}
+
+status_t DownloadRegistryHaiku::notify(Entry& item, uint32_t what, uint32_t result, const String& domain, int32_t error, const String& description)
+{
+    if (m_observer) {
+        DownloadRegistryEventHaiku event;
+        event.type = what == B_WEBKIT_DOWNLOAD_STARTED ? DownloadRegistryEventHaiku::Type::Started
+            : what == B_WEBKIT_DOWNLOAD_FINISHED ? DownloadRegistryEventHaiku::Type::Finished : DownloadRegistryEventHaiku::Type::Progress;
+        event.identifier = item.download->downloadID().toUInt64();
+        event.url = item.download->request().url().string();
+        event.finalURL = item.responseURL.isEmpty() ? event.url : item.responseURL;
+        event.path = item.destination;
+        event.mimeType = item.mimeType;
+        event.currentSize = item.currentSize;
+        event.expectedSize = item.expectedSize;
+        event.result = result;
+        event.error = error;
+        event.errorDescription = description;
+        event.validator = item.validator;
+        event.resumed = item.resume.has_value();
+        m_observer(event);
+    }
+    BMessage message(what);
+    status_t status = B_OK;
+    auto append = [&status](status_t result) {
+        if (status == B_OK)
+            status = result;
+    };
+    auto appendString = [&](const char* key, const String& value) {
+        append(message.AddString(key, value.isEmpty() ? "" : value.utf8().legacyCStringPointer()));
+    };
+    append(message.AddUInt64("identifier", item.download->downloadID().toUInt64()));
+    appendString("url", item.responseURL.isEmpty() ? item.download->request().url().string() : item.responseURL);
+    appendString("path", item.destination);
+    appendString("filename", FileSystem::pathFileName(item.destination));
+    append(message.AddUInt64("current_size", item.currentSize));
+    append(message.AddInt64("expected_size", item.expectedSize));
+    appendString("request_url", item.download->request().url().string());
+    if (item.answered) {
+        appendString("validator", item.validator);
+        append(message.AddBool("accepts_ranges", item.acceptsRanges));
+    }
+    if (item.resumedFrom)
+        append(message.AddUInt64("resumed_from", *item.resumedFrom));
+    if (item.restarted)
+        append(message.AddBool("restarted", true));
+    if (item.continues)
+        append(message.AddUInt64("continues", item.continues));
+    if (item.view.IsValid())
+        append(message.AddMessenger("view", item.view));
+    if (what == B_WEBKIT_DOWNLOAD_FINISHED) {
+        append(message.AddUInt32("result", result));
+        appendString("error_domain", domain);
+        append(message.AddInt32("error", error));
+        appendString("error_description", description);
+        append(message.AddBool("partial", item.partial));
+    }
+    if (status != B_OK)
+        return status;
+    // The receiving looper must not synchronously call back into WebKit. All
+    // payloads are values; the registry does not expose an engine pointer.
+    return item.target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+}
+
+String DownloadRegistryHaiku::chooseDestination(const Entry& item, const String& suggestedFilename) const
+{
+    auto name = sanitizedDownloadFilename(BString(suggestedFilename.utf8().legacyCStringPointer()));
+    // This bound also avoids a UI-main-thread loop over an unbounded directory.
+    for (uint32_t attempt = 0; attempt < 10000; ++attempt) {
+        auto leaf = attempt ? downloadFilenameWithCounter(name, attempt - 1) : name;
+        auto destination = FileSystem::pathByAppendingComponent(item.directory, String::fromUTF8(leaf.String()));
+        bool reserved = false;
+        for (const auto& [identifier, other] : m_downloads) {
+            if (other.get() != &item && other->destination == destination) {
+                reserved = true;
+                break;
+            }
+        }
+        if (reserved)
+            continue;
+        struct stat info;
+        if (!lstat(destination.utf8().legacyCStringPointer(), &info))
+            continue;
+        if (errno == ENOENT)
+            return destination;
+        return { };
+    }
+    return { };
+}
+
+void DownloadRegistryHaiku::decideDestination(DownloadProxy& download, const WebCore::ResourceResponse& response, const String& filename, CompletionHandler<void(AllowOverwrite, String)>&& completion)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    auto* item = entry(identifier);
+    if (!item || item->cancelling || m_shuttingDown) {
+        completion(AllowOverwrite::No, { });
+        return;
+    }
+    item->responseURL = response.url().string();
+    item->mimeType = response.mimeType();
+    item->expectedSize = response.expectedContentLength() < 0 ? -1 : response.expectedContentLength();
+    item->validator = validatorOf(response);
+    item->acceptsRanges = acceptsByteRanges(response);
+    item->answered = true;
+    if (item->resume) {
+        // The network process appends a 206 answer from the asked offset to
+        // the partial file and writes any other success over it.
+        const auto& resume = *item->resume;
+        auto status = response.httpStatusCode();
+        String failure;
+        bool complete = false;
+        if (status == 206) {
+            WebCore::ParsedContentRange range(response.httpHeaderField(WebCore::HTTPHeaderName::ContentRange));
+            bool knownLength = range.isValid() && range.instanceLength() != WebCore::ParsedContentRange::unknownLength;
+            if (!range.isValid() || static_cast<uint64_t>(range.firstBytePosition()) != resume.offset)
+                failure = "The server sent a different part of the file"_s;
+            else if (!resume.hasValidator && resume.expectedSize >= 0 && knownLength && range.instanceLength() != resume.expectedSize)
+                failure = "The file changed on the server"_s;
+            else {
+                item->resumedFrom = resume.offset;
+                item->currentSize = resume.offset;
+                if (knownLength)
+                    item->expectedSize = range.instanceLength();
+                else if (item->expectedSize >= 0)
+                    item->expectedSize += resume.offset;
+            }
+        } else if (status == 416 && resume.offset && unsatisfiedRangeLength(response) == resume.offset) {
+            // The partial file was the whole file already.
+            complete = true;
+            item->currentSize = resume.offset;
+            item->expectedSize = resume.offset;
+        } else if (status >= 200 && status < 300) {
+            item->resumedFrom = 0;
+            item->restarted = resume.offset > 0;
+            item->currentSize = 0;
+        } else
+            failure = makeString("The server could not continue the download (HTTP "_s, status, ')');
+        if (complete || !failure.isNull()) {
+            completion(AllowOverwrite::No, { });
+            requestCancel(identifier, complete ? B_WEBKIT_DOWNLOAD_SUCCEEDED : B_WEBKIT_DOWNLOAD_FAILED, complete ? B_OK : B_ERROR, failure, true);
+            return;
+        }
+        completion(AllowOverwrite::Yes, item->destination);
+        return;
+    }
+    auto suggested = item->requestedFilename.isEmpty() ? filename : item->requestedFilename;
+    if (item->destination.isEmpty() && item->directory != m_directory && !FileSystem::makeAllDirectories(item->directory)) {
+        completion(AllowOverwrite::No, { });
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, B_IO_ERROR, "Could not make the download's folder"_s);
+        return;
+    }
+    if (item->destination.isEmpty() && item->choice != Destination::Unique) {
+        auto name = String::fromUTF8(sanitizedDownloadFilename(BString(suggested.utf8().legacyCStringPointer())).String());
+        auto named = FileSystem::pathByAppendingComponent(item->directory, name);
+        bool taken = FileSystem::fileExists(named);
+        bool reserved = std::ranges::any_of(m_downloads, [&](auto& other) { return other.second.get() != item && other.second->destination == named; });
+        if (item->choice == Destination::Ask || (item->choice == Destination::Prompt && (taken || reserved))) {
+            if (askDestination(*item, name, WTF::move(completion)))
+                return;
+        } else if (item->choice == Destination::Overwrite && !reserved && !name.isEmpty()) {
+            // As asked (Chrome's conflictAction "overwrite"); never a file
+            // another download of this browser is writing.
+            item->destination = named;
+            completion(AllowOverwrite::Yes, item->destination);
+            return;
+        }
+    }
+    if (item->destination.isEmpty())
+        item->destination = chooseDestination(*item, suggested);
+    if (item->destination.isEmpty()) {
+        completion(AllowOverwrite::No, { });
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, B_IO_ERROR, "Could not choose an unused download destination"_s);
+        return;
+    }
+    // The NetworkProcess performs the actual O_EXCL open; a competing external
+    // creation fails safely. Never pre-create this path or permit overwrite.
+    completion(AllowOverwrite::No, item->destination);
+}
+
+bool DownloadRegistryHaiku::askDestination(Entry& item, const String& suggestedFilename, CompletionHandler<void(AllowOverwrite, String)>&& completion)
+{
+    BMessage message(B_WEBKIT_DOWNLOAD_DESTINATION);
+    auto add = [&](const char* key, const String& value) {
+        return message.AddString(key, value.isEmpty() ? "" : value.utf8().legacyCStringPointer()) == B_OK;
+    };
+    if (message.AddUInt64("identifier", item.download->downloadID().toUInt64()) != B_OK
+        || !add("suggested_filename", suggestedFilename) || !add("directory", item.directory)
+        || !add("url", item.responseURL.isEmpty() ? item.download->request().url().string() : item.responseURL)
+        || (item.view.IsValid() && message.AddMessenger("view", item.view) != B_OK))
+        return false;
+    item.pendingDestination = WTF::move(completion);
+    if (item.target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0) == B_OK)
+        return true;
+    // No one to ask: the caller picks a free name.
+    completion = std::exchange(item.pendingDestination, nullptr);
+    return false;
+}
+
+void DownloadRegistryHaiku::setDestination(uint64_t identifier, const String& path)
+{
+    ASSERT(RunLoop::isMain());
+    auto* item = entry(identifier);
+    if (!item || !item->pendingDestination)
+        return;
+    if (path.isEmpty()) {
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_CANCELLED, B_CANCELED, "Download cancelled"_s);
+        return;
+    }
+    auto folder = FileSystem::parentPath(path);
+    if (!path.startsWith('/') || FileSystem::pathFileName(path).isEmpty() || !FileSystem::fileTypeFollowingSymlinks(folder)
+        || *FileSystem::fileTypeFollowingSymlinks(folder) != FileSystem::FileType::Directory) {
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, B_BAD_VALUE, "The chosen destination is not in a folder"_s);
+        return;
+    }
+    item->destination = path;
+    // The user chose this file, knowing it may exist.
+    std::exchange(item->pendingDestination, nullptr)(AllowOverwrite::Yes, path);
+}
+
+void DownloadRegistryHaiku::didCreateDestination(DownloadProxy& download, const String& path)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    auto* item = entry(identifier);
+    if (!item || item->cancelling)
+        return;
+    item->destination = path;
+    item->ownsFile = true;
+    auto result = notify(*item, B_WEBKIT_DOWNLOAD_PROGRESS);
+    if (result != B_OK)
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, result, "Download listener is unavailable"_s);
+}
+
+void DownloadRegistryHaiku::didReceiveData(DownloadProxy& download, uint64_t bytes)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    auto* item = entry(identifier);
+    if (!item || item->cancelling)
+        return;
+    if (bytes > std::numeric_limits<uint64_t>::max() - item->currentSize) {
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, B_BAD_DATA, "Download byte count overflow"_s);
+        return;
+    }
+    item->currentSize += bytes;
+    auto now = MonotonicTime::now();
+    if (item->lastProgress && now - item->lastProgress < 100_ms)
+        return;
+    item->lastProgress = now;
+    auto result = notify(*item, B_WEBKIT_DOWNLOAD_PROGRESS);
+    if (result != B_OK)
+        requestCancel(identifier, B_WEBKIT_DOWNLOAD_FAILED, result, "Download listener is unavailable"_s);
+}
+
+void DownloadRegistryHaiku::finish(uint64_t identifier, uint32_t result, const String& domain, int32_t error, const String& description)
+{
+    ASSERT(RunLoop::isMain());
+    // Remove first: reentrancy and late finish/failure/cancel completions cannot
+    // emit another terminal notification or release the same entry twice.
+    auto found = m_downloads.find(identifier);
+    if (found == m_downloads.end())
+        return;
+    auto item = std::move(found->second);
+    m_downloads.erase(found);
+    if (auto pending = std::exchange(item->pendingDestination, nullptr))
+        pending(AllowOverwrite::No, { });
+    // The network process leaves an incomplete file where it was: a paused
+    // download continues in it, so may a failed one if the host wants that.
+    if (item->ownsFile && !item->destination.isEmpty() && result != B_WEBKIT_DOWNLOAD_SUCCEEDED) {
+        bool keep = result == B_WEBKIT_DOWNLOAD_PAUSED || item->keepFile
+            || (result == B_WEBKIT_DOWNLOAD_FAILED && m_keepFailedDownloads);
+        if (keep)
+            item->partial = FileSystem::fileExists(item->destination);
+        else
+            FileSystem::deleteFile(item->destination);
+    }
+    notify(*item, B_WEBKIT_DOWNLOAD_FINISHED, result, domain, error, description);
+}
+
+void DownloadRegistryHaiku::didFinish(DownloadProxy& download)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    auto* item = entry(identifier);
+    if (!item)
+        return;
+    if (!item->cancelIssued) {
+        // The engine completed before the queued cancellation ran. Its completed
+        // file and success win; the queued request will find no entry.
+        finish(identifier, B_WEBKIT_DOWNLOAD_SUCCEEDED);
+        return;
+    }
+    // Completion can race an already-issued cancellation. Preserve the observed
+    // success, but retain the entry until the cancellation reply removes the
+    // proxy from DownloadProxyMap. HasPendingDownloads stays true meanwhile.
+    item->cancelResult = B_WEBKIT_DOWNLOAD_SUCCEEDED;
+    item->cancelDomain = { };
+    item->cancelError = B_OK;
+    item->cancelDescription = { };
+}
+
+void DownloadRegistryHaiku::didFail(DownloadProxy& download, const WebCore::ResourceError& error)
+{
+    ASSERT(RunLoop::isMain());
+    auto identifier = download.downloadID().toUInt64();
+    auto* item = entry(identifier);
+    if (!item)
+        return;
+    if (!item->cancelIssued) {
+        finish(identifier, B_WEBKIT_DOWNLOAD_FAILED, error.domain(), error.errorCode(), error.localizedDescription());
+        return;
+    }
+    item->cancelResult = B_WEBKIT_DOWNLOAD_FAILED;
+    item->cancelDomain = error.domain();
+    item->cancelError = error.errorCode();
+    item->cancelDescription = error.localizedDescription();
+}
+
+void DownloadRegistryHaiku::processDidCrash(DownloadProxy& download)
+{
+    ASSERT(RunLoop::isMain());
+    // Release our proxy reference during invalidation. Holding it until a later
+    // cancellation reply could let DownloadProxy try to remove it from the
+    // already-cleared DownloadProxyMap. A crash is a failure, even after a user
+    // requested cancellation; it does not prove that a partial file was removed.
+    finish(download.downloadID().toUInt64(), B_WEBKIT_DOWNLOAD_FAILED, "HaikuDownload"_s, B_ERROR, "Download network process exited"_s);
+}
+
+void DownloadRegistryHaiku::requestCancel(uint64_t identifier, uint32_t result, int32_t error, const String& description, bool keepFile)
+{
+    ASSERT(RunLoop::isMain());
+    auto* item = entry(identifier);
+    if (!item || item->cancelling)
+        return;
+    item->cancelling = true;
+    item->keepFile = keepFile;
+    // A download waiting for its destination writes nothing.
+    if (auto pending = std::exchange(item->pendingDestination, nullptr))
+        pending(AllowOverwrite::No, { });
+    item->cancelResult = result;
+    item->cancelError = error;
+    item->cancelDescription = description;
+    if (result == B_WEBKIT_DOWNLOAD_SUCCEEDED)
+        item->cancelDomain = { };
+    // Defer the map mutation out of download callbacks, in particular the
+    // DownloadProxyMap::invalidate iteration used during process shutdown.
+    RunLoop::mainSingleton().dispatch([registry = shared_from_this(), identifier] {
+        auto* item = registry->entry(identifier);
+        if (!item)
+            return;
+        item->cancelIssued = true;
+        item->download->cancel([registry, identifier](API::Data*) {
+            auto* item = registry->entry(identifier);
+            if (!item)
+                return;
+            registry->finish(identifier, item->cancelResult, item->cancelDomain, item->cancelError, item->cancelDescription);
+        });
+    });
+}
+
+void DownloadRegistryHaiku::cancel(uint64_t identifier)
+{
+    requestCancel(identifier, B_WEBKIT_DOWNLOAD_CANCELLED, B_CANCELED, "Download cancelled"_s);
+}
+
+void DownloadRegistryHaiku::cancelAll()
+{
+    ASSERT(RunLoop::isMain());
+    for (const auto& [identifier, item] : m_downloads)
+        cancel(identifier);
+}
+
+void DownloadRegistryHaiku::pause(uint64_t identifier)
+{
+    requestCancel(identifier, B_WEBKIT_DOWNLOAD_PAUSED, B_INTERRUPTED, "Download paused"_s, true);
+}
+
+void DownloadRegistryHaiku::pauseAll()
+{
+    ASSERT(RunLoop::isMain());
+    for (const auto& [identifier, item] : m_downloads)
+        pause(identifier);
+}
+
+void DownloadRegistryHaiku::shutdown()
+{
+    ASSERT(RunLoop::isMain());
+    m_shuttingDown = true;
+    cancelAll();
+}
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.h b/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..0c9d1d39fd419389852498aa1b949c53c21a5468
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/DownloadRegistryHaiku.h
@@ -0,0 +1,121 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <Messenger.h>
+#include <SupportDefs.h>
+#include <memory>
+#include <unordered_map>
+#include <wtf/CompletionHandler.h>
+#include <wtf/Function.h>
+#include <wtf/Ref.h>
+#include <wtf/text/WTFString.h>
+
+namespace API { class DownloadClient; }
+namespace WebCore { class ResourceError; class ResourceResponse; }
+
+namespace WebKit {
+
+class DownloadProxy;
+enum class AllowOverwrite : bool;
+
+// A value-only view of a registry notification, delivered synchronously on the
+// WTF main RunLoop together with the listener message of the same kind. The
+// observer must not call back into the registry synchronously.
+struct DownloadRegistryEventHaiku {
+    enum class Type : uint8_t { Started, Progress, Finished };
+    Type type { Type::Started };
+    uint64_t identifier { 0 };
+    String url;
+    String finalURL;
+    String path;
+    String mimeType;
+    uint64_t currentSize { 0 };
+    int64_t expectedSize { -1 };
+    // B_WEBKIT_DOWNLOAD_SUCCEEDED/FAILED/CANCELLED; meaningful for Finished only.
+    uint32_t result { 0 };
+    int32_t error { 0 };
+    String errorDescription;
+    // What a later resume sends as If-Range, once the server has answered.
+    String validator;
+    // The download continues a partial file (BWebKitContext::ResumeDownload).
+    bool resumed { false };
+};
+
+// Every method and all engine references are confined to the application's
+// WTF main RunLoop. Clients weakly reference this registry; cancellation replies
+// retain it until shutdown has removed every registered download.
+class DownloadRegistryHaiku final : public std::enable_shared_from_this<DownloadRegistryHaiku> {
+public:
+    static std::shared_ptr<DownloadRegistryHaiku> create();
+    ~DownloadRegistryHaiku();
+    Ref<API::DownloadClient> createClient();
+
+    status_t setListener(const BMessenger&);
+    status_t setDirectory(const char*);
+    status_t setKeepFailedDownloads(bool);
+    bool hasPendingDownloads() const;
+    void cancel(uint64_t);
+    void cancelAll();
+    // Like cancel, but the partial file stays (BWebKitContext::PauseDownload).
+    void pause(uint64_t);
+    void pauseAll();
+    void shutdown();
+
+    // A download continuing in a partial file (BWebKitContext::ResumeDownload).
+    struct Resume {
+        String path;
+        // The file's size when the download was registered: the Range start.
+        uint64_t offset { 0 };
+        bool hasValidator { false };
+        int64_t expectedSize { -1 };
+        // The identifier of the download this one continues, when known; the
+        // host learns it from the notifications' "continues" field.
+        uint64_t continues { 0 };
+    };
+    // Checks a host's partial file and fills resume (its offset); path may be
+    // empty for a download that never had a file.
+    status_t prepareResume(const String& path, const String& validator, int64_t expectedSize, Resume&) const;
+
+    // Where a new download goes: a free name in the download directory
+    // (Unique), the name even if a file has it (Overwrite), the host asks the
+    // user when a file has the name (Prompt) or always (Ask:
+    // B_WEBKIT_DOWNLOAD_DESTINATION, answered by setDestination).
+    enum class Destination : uint8_t { Unique, Overwrite, Prompt, Ask };
+    // requestedFilename, when not empty, replaces the engine's suggested name.
+    // It is sanitized and uniquified like every other destination.
+    void registerDownload(DownloadProxy&, const BMessenger& = { }, const String& requestedFilename = { }, const Resume* = nullptr,
+        Destination = Destination::Unique);
+    // The host's answer to B_WEBKIT_DOWNLOAD_DESTINATION; an empty path cancels.
+    void setDestination(uint64_t, const String& path);
+    // One observer (the native extension downloads bridge). Null clears it.
+    void setObserver(Function<void(const DownloadRegistryEventHaiku&)>&&);
+    const String& directory() const { return m_directory; }
+    bool isActive(uint64_t identifier) const { return m_downloads.contains(identifier); }
+    void decideDestination(DownloadProxy&, const WebCore::ResourceResponse&, const String&, CompletionHandler<void(AllowOverwrite, String)>&&);
+    void didCreateDestination(DownloadProxy&, const String&);
+    void didReceiveData(DownloadProxy&, uint64_t);
+    void didFinish(DownloadProxy&);
+    void didFail(DownloadProxy&, const WebCore::ResourceError&);
+    void processDidCrash(DownloadProxy&);
+
+private:
+    DownloadRegistryHaiku() = default;
+    struct Entry;
+    Entry* entry(uint64_t);
+    void requestCancel(uint64_t, uint32_t result, int32_t error, const String& description, bool keepFile = false);
+    void finish(uint64_t, uint32_t result, const String& domain = { }, int32_t error = 0, const String& description = { });
+    status_t notify(Entry&, uint32_t what, uint32_t result = 0, const String& domain = { }, int32_t error = 0, const String& description = { });
+    String chooseDestination(const Entry&, const String&) const;
+    // Asks the host where to save the download; false when it cannot be asked.
+    bool askDestination(Entry&, const String& suggestedFilename, CompletionHandler<void(AllowOverwrite, String)>&&);
+
+    BMessenger m_listener;
+    Function<void(const DownloadRegistryEventHaiku&)> m_observer;
+    String m_directory;
+    bool m_shuttingDown { false };
+    bool m_keepFailedDownloads { false };
+    std::unordered_map<uint64_t, std::unique_ptr<Entry>> m_downloads;
+};
+
+} // namespace WebKit
