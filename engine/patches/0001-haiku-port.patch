+#if ENABLE(CONTEXT_MENUS)
+#if ENABLE(WK_WEB_EXTENSIONS)
+// Extension items (menus/contextMenus) of the context menu on screen, named by
+// the tokens the host received. Main thread only; a new menu replaces them.
+struct ExtensionMenuChoiceHaiku {
+    RefPtr<WebExtensionContext> context;
+    Ref<WebExtensionMenuItem> item;
+    WebExtensionMenuItemContextParameters parameters;
+};
+
+static std::unordered_map<uint64_t, ExtensionMenuChoiceHaiku>& extensionMenuChoicesHaiku()
+{
+    static NeverDestroyed<std::unordered_map<uint64_t, ExtensionMenuChoiceHaiku>> choices;
+    return choices.get();
+}
+
+static void addExtensionMenuItemsHaiku(BMessage& into, WebExtensionContext& context, const WebExtensionMenuItem::MenuItemVector& items,
+    const WebExtensionMenuItemContextParameters& parameters, Ref<JSON::Array>& shownIdentifiers)
+{
+    static uint64_t lastToken;
+    for (const auto& item : items) {
+        if (!item->isVisible() || !item->matches(parameters))
+            continue;
+        // As the extension gave it: a string or an integer.
+        if (auto decoded = decodeWebExtensionMenuIdentifier(item->identifier())) {
+            if (auto* string = std::get_if<String>(&*decoded))
+                shownIdentifiers->pushString(*string);
+            else
+                shownIdentifiers->pushDouble(static_cast<double>(std::get<int64_t>(*decoded)));
+        }
+        BMessage entry;
+        if (item->type() == WebExtensionMenuItemType::Separator) {
+            entry.AddBool("separator", true);
+            into.AddMessage("item", &entry);
+            continue;
+        }
+        // Chrome and Firefox show the selection in place of %s.
+        addTextHaiku(entry, "title", makeStringByReplacingAll(item->title(), "%s"_s, parameters.selectionString));
+        entry.AddBool("enabled", item->isEnabled());
+        entry.AddBool("checkable", isCheckedType(item->type()));
+        entry.AddBool("checked", item->isChecked());
+        if (!item->submenuItems().isEmpty())
+            addExtensionMenuItemsHaiku(entry, context, item->submenuItems(), parameters, shownIdentifiers);
+        else {
+            const uint64_t token = ++lastToken;
+            extensionMenuChoicesHaiku().emplace(token, ExtensionMenuChoiceHaiku { &context, item, parameters });
+            entry.AddUInt64("token", token);
+        }
+        into.AddMessage("item", &entry);
+    }
+}
+
+// The open context menu, for menus.refresh and menus.onHidden: what it was
+// made for and the extensions told of it (menus.onShown).
+struct ShownExtensionMenuHaiku {
+    std::weak_ptr<WebViewStateHaiku> state;
+    WeakPtr<WebPageProxy> page;
+    ContextMenuContextData context;
+    FrameInfoData frame;
+    Vector<WeakPtr<WebExtensionContext>> shown;
+};
+
+static std::optional<ShownExtensionMenuHaiku>& shownExtensionMenuHaiku()
+{
+    static NeverDestroyed<std::optional<ShownExtensionMenuHaiku>> menu;
+    return menu.get();
+}
+
+// menus.onShown's info: what the menu was opened on (Firefox's OnShowData).
+static String extensionMenuShownInfoHaiku(WebPageProxy& page, const WebExtensionMenuItemContextParameters& parameters, Ref<JSON::Array>&& menuIdentifiers)
+{
+    Ref info = JSON::Object::create();
+    info->setArray("menuIds"_s, WTF::move(menuIdentifiers));
+    Ref contexts = JSON::Array::create();
+    contexts->pushString("all"_s);
+    static constexpr std::array<std::pair<WebExtensionMenuItemContextType, ASCIILiteral>, 8> names { {
+        { WebExtensionMenuItemContextType::Page, "page"_s }, { WebExtensionMenuItemContextType::Frame, "frame"_s },
+        { WebExtensionMenuItemContextType::Selection, "selection"_s }, { WebExtensionMenuItemContextType::Link, "link"_s },
+        { WebExtensionMenuItemContextType::Editable, "editable"_s }, { WebExtensionMenuItemContextType::Image, "image"_s },
+        { WebExtensionMenuItemContextType::Video, "video"_s }, { WebExtensionMenuItemContextType::Audio, "audio"_s },
+    } };
+    for (auto& [type, name] : names) {
+        if (parameters.types.contains(type))
+            contexts->pushString(name);
+    }
+    info->setArray("contexts"_s, WTF::move(contexts));
+    info->setBoolean("editable"_s, parameters.editable);
+    if (parameters.frameIdentifier)
+        info->setDouble("frameId"_s, toWebAPI(*parameters.frameIdentifier));
+    info->setString("pageUrl"_s, page.pageLoadState().activeURL().string());
+    if (!parameters.frameURL.isEmpty())
+        info->setString("frameUrl"_s, parameters.frameURL.string());
+    if (!parameters.linkURL.isEmpty()) {
+        info->setString("linkUrl"_s, parameters.linkURL.string());
+        info->setString("linkText"_s, parameters.linkText);
+    }
+    if (!parameters.sourceURL.isEmpty()) {
+        info->setString("srcUrl"_s, parameters.sourceURL.string());
+        info->setString("mediaType"_s, parameters.types.contains(WebExtensionMenuItemContextType::Image) ? "image"_s
+            : parameters.types.contains(WebExtensionMenuItemContextType::Audio) ? "audio"_s : "video"_s);
+    }
+    if (!parameters.selectionString.isEmpty())
+        info->setString("selectionText"_s, parameters.selectionString);
+    info->setString("viewType"_s, "tab"_s);
+    return info->toJSONString();
+}
+
+// As WebExtensionContext::addItemsToContextMenu on macOS: the clicked
+// element's contexts, for every loaded extension allowed on this page. When
+// shown (the menu opens), each is told with menus.onShown, items or not, as
+// Firefox does so that it can add some.
+static void addExtensionMenusHaiku(BMessage& message, WebPageProxy& page, const ContextMenuContextData& contextData, const FrameInfoData& fallbackFrame,
+    Vector<WeakPtr<WebExtensionContext>>* shown = nullptr)
+{
+    extensionMenuChoicesHaiku().clear();
+    RefPtr controller = page.webExtensionController();
+    if (!controller)
+        return;
+    const auto& hitTest = contextData.webHitTestResultData();
+    const FrameInfoData& frame = hitTest && hitTest->frameInfo ? *hitTest->frameInfo : fallbackFrame;
+    for (Ref context : controller->extensionContexts()) {
+        if (!context->isLoaded()
+            || !(context->hasPermission(WebExtensionPermission::menus()) || context->hasPermission(WebExtensionPermission::contextMenus())))
+            continue;
+        WebExtensionMenuItemContextParameters parameters;
+        parameters.frameIdentifier = isMainFrameHaiku(frame, &page) ? WebExtensionFrameConstants::MainFrameIdentifier : toWebExtensionFrameIdentifier(std::optional { frame.frameID });
+        parameters.frameURL = frame.request.url();
+        RefPtr tab = context->getTab(page.identifier());
+        if (tab)
+            parameters.tabIdentifier = tab->identifier();
+        if (!context->hasPermission(frame.request.url(), tab.get()) && (!tab || !isMainFrameHaiku(frame, &page) || !context->hasPermission(WebExtensionPermission::activeTab())))
+            continue;
+        if (hitTest) {
+            if (!hitTest->absoluteImageURL.isEmpty()) {
+                parameters.types.add(WebExtensionMenuItemContextType::Image);
+                parameters.sourceURL = URL { hitTest->absoluteImageURL };
+            }
+            if (!hitTest->absoluteMediaURL.isEmpty() && hitTest->elementType != WebHitTestResultData::ElementType::None) {
+                parameters.sourceURL = URL { hitTest->absoluteMediaURL };
+                parameters.types.add(hitTest->elementType == WebHitTestResultData::ElementType::Audio
+                    ? WebExtensionMenuItemContextType::Audio : WebExtensionMenuItemContextType::Video);
+            }
+            if (hitTest->isContentEditable) {
+                parameters.types.add(WebExtensionMenuItemContextType::Editable);
+                parameters.editable = true;
+            }
+            if (hitTest->isSelected && !contextData.selectedText().isEmpty()) {
+                parameters.types.add(WebExtensionMenuItemContextType::Selection);
+                parameters.selectionString = contextData.selectedText();
+            }
+            if (!hitTest->absoluteLinkURL.isEmpty()) {
+                parameters.types.remove(WebExtensionMenuItemContextType::Selection);
+                parameters.types.add(WebExtensionMenuItemContextType::Link);
+                parameters.linkURL = URL { hitTest->absoluteLinkURL };
+                parameters.linkText = hitTest->linkLabel;
+            }
+        }
+        if (parameters.types.isEmpty())
+            parameters.types.add(isMainFrameHaiku(frame, &page) ? WebExtensionMenuItemContextType::Page : WebExtensionMenuItemContextType::Frame);
+        BMessage extension;
+        Ref shownIdentifiers = JSON::Array::create();
+        addExtensionMenuItemsHaiku(extension, context, context->mainMenuItems(), parameters, shownIdentifiers);
+        if (extension.HasMessage("item")) {
+            addTextHaiku(extension, "name", protect(context->extension())->displayShortName());
+            message.AddMessage("extension", &extension);
+        }
+        if (shown && context->hasPermission(WebExtensionPermission::menus())) {
+            shown->append(context.get());
+            context->fireMenusShownEventHaiku(extensionMenuShownInfoHaiku(page, parameters, WTF::move(shownIdentifiers)), tab ? std::optional { tab->parameters() } : std::nullopt);
+        }
+    }
+}
+
+void refreshExtensionMenusHaiku(WebExtensionContext& context)
+{
+    ASSERT(RunLoop::isMain());
+    auto& menu = shownExtensionMenuHaiku();
+    if (!menu || !menu->shown.containsIf([&](auto& item) { return item.get() == &context; }))
+        return;
+    RefPtr page = menu->page.get();
+    auto state = menu->state.lock();
+    if (!page || page->isClosed() || !state || state->closed)
+        return;
+    BMessage message(B_WEBKIT_CONTEXT_MENU_EXTENSIONS);
+    addExtensionMenusHaiku(message, *page, menu->context, menu->frame);
+    sendToHostHaiku(state, message);
+}
+
+void contextMenuClosedHaiku(WebPageProxy& page)
+{
+    ASSERT(RunLoop::isMain());
+    auto& menu = shownExtensionMenuHaiku();
+    if (!menu || menu->page.get() != &page)
+        return;
+    auto shown = WTF::move(menu->shown);
+    menu.reset();
+    for (auto& weakContext : shown) {
+        if (RefPtr context = weakContext.get(); context && context->isLoaded())
+            context->fireMenusHiddenEventHaiku();
+    }
+}
+
+void performExtensionMenuItemHaiku(uint64_t token)
+{
+    ASSERT(RunLoop::isMain());
+    auto found = extensionMenuChoicesHaiku().find(token);
+    if (found == extensionMenuChoicesHaiku().end())
+        return;
+    auto choice = std::move(found->second);
+    extensionMenuChoicesHaiku().clear();
+    if (RefPtr context = choice.context; context && context->isLoaded())
+        context->performMenuItem(choice.item, choice.parameters, WebExtensionContext::UserTriggered::Yes);
+}
+#else
+void performExtensionMenuItemHaiku(uint64_t) { }
+#endif
+
+// The frame of each page's last context menu on a misspelt word, for
+// performSpellingCommandHaiku(). Main thread only.
+static std::map<uint64_t, FrameInfoData>& spellingMenuFramesHaiku()
+{
+    static NeverDestroyed<std::map<uint64_t, FrameInfoData>> frames;
+    return frames.get();
+}
+
+// The host builds its own native menu from what was clicked; WebKit's
+// proposed items (and their actions) are not used, except the spelling
+// guesses.
+class PendingContextMenuHaiku final : public WebContextMenuProxy {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(PendingContextMenuHaiku);
+public:
+    PendingContextMenuHaiku(std::weak_ptr<WebViewStateHaiku> state, WebPageProxy& page, FrameInfoData&& frame, ContextMenuContextData&& context, const UserData& data)
+        : WebContextMenuProxy(page, WTF::move(frame), WTF::move(context), data), m_state(std::move(state)) { }
+private:
+    void showContextMenuWithItems(Vector<Ref<WebContextMenuItem>>&& items) override
+    {
+        m_proposedItems = WTF::move(items);
+        if (auto state = m_state.lock(); state && !state->closed) {
+            BMessage message(B_WEBKIT_CONTEXT_MENU);
+            const auto location = m_context.menuLocation();
+            message.AddPoint("where", BPoint(location.x(), location.y()));
+            addTextHaiku(message, "selected_text", m_context.selectedText());
+            addTextHaiku(message, "frame_url", m_frameInfo.request.url().string());
+            message.AddBool("main_frame", isMainFrameHaiku(m_frameInfo, page()));
+            if (const auto& hit = m_context.webHitTestResultData()) {
+                addTextHaiku(message, "link_url", hit->absoluteLinkURL);
+                addTextHaiku(message, "link_label", hit->linkLabel);
+                addTextHaiku(message, "link_title", hit->linkTitle);
+                addTextHaiku(message, "link_filename", hit->linkSuggestedFilename);
+                addTextHaiku(message, "image_url", hit->absoluteImageURL);
+                addTextHaiku(message, "image_filename", hit->imageSuggestedFilename);
+                addTextHaiku(message, "media_url", hit->absoluteMediaURL);
+                message.AddBool("editable", hit->isContentEditable);
+                message.AddBool("selected", hit->isSelected);
+                message.AddBool("downloadable_media", hit->isDownloadableMedia);
+            }
+            // WebCore proposes spelling guesses for a misspelt word under the
+            // pointer (Ignore and Learn come with them); the host offers them.
+            bool misspelled = false;
+            for (auto& item : m_proposedItems) {
+                const auto action = item->data().action();
+                if (action == ContextMenuItemTagSpellingGuess)
+                    addTextHaiku(message, "spelling_guess", item->data().title());
+                if (action == ContextMenuItemTagSpellingGuess || action == ContextMenuItemTagNoGuessesFound
+                    || action == ContextMenuItemTagLearnSpelling)
+                    misspelled = true;
+            }
+            if (misspelled) {
+                message.AddBool("misspelled", true);
+                if (RefPtr page = this->page())
+                    spellingMenuFramesHaiku().insert_or_assign(page->identifier().toUInt64(), m_frameInfo);
+            }
+#if ENABLE(WK_WEB_EXTENSIONS)
+            if (RefPtr page = this->page()) {
+                // A menu replaces the last one, which closed first.
+                if (auto& last = shownExtensionMenuHaiku(); last && last->page)
+                    contextMenuClosedHaiku(*last->page);
+                ShownExtensionMenuHaiku shown { m_state, *page, m_context, m_frameInfo, { } };
+                addExtensionMenusHaiku(message, *page, m_context, m_frameInfo, &shown.shown);
+                shownExtensionMenuHaiku() = WTF::move(shown);
+            }
+#endif
+            sendToHostHaiku(state, message);
+        }
+        if (RefPtr page = this->page())
+            page->didDismissContextMenu(m_frameInfo);
+    }
+
+    const std::weak_ptr<WebViewStateHaiku> m_state;
+    Vector<Ref<WebContextMenuItem>> m_proposedItems;
+};
+
+void performSpellingCommandHaiku(WebPageProxy& page, uint32_t command, const String& word)
+{
+    ASSERT(RunLoop::isMain());
+    auto frame = spellingMenuFramesHaiku().find(page.identifier().toUInt64());
+    if (frame == spellingMenuFramesHaiku().end())
+        return;
+    auto frameInfo = frame->second;
+    switch (command) {
+    case B_WEBKIT_SPELLING_REPLACE:
+        // WebCore takes the word around the caret (Unix editing) and
+        // replaces it, as for its own menu's guesses.
+        if (!word.isEmpty())
+            page.contextMenuItemSelected(WebContextMenuItemData(ContextMenuItemType::Action, ContextMenuItemTagSpellingGuess, String { word }, true, false), frameInfo);
+        break;
+    case B_WEBKIT_SPELLING_IGNORE:
+    case B_WEBKIT_SPELLING_LEARN:
+        // Ignore and Learn act on the selection: select the word first.
+        page.executeEditCommand("SelectWord"_s, { });
+        page.contextMenuItemSelected(WebContextMenuItemData(ContextMenuItemType::Action,
+            command == B_WEBKIT_SPELLING_LEARN ? ContextMenuItemTagLearnSpelling : ContextMenuItemTagIgnoreSpelling,
+            String { }, true, false), frameInfo);
+        break;
+    }
+    spellingMenuFramesHaiku().erase(frame);
+}
+
+Ref<WebContextMenuProxy> WebView::createContextMenuProxy(WebPageProxy& page, FrameInfoData&& frame, ContextMenuContextData&& context, const UserData& data)
+{
+    return adoptRef(*new PendingContextMenuHaiku(m_state, page, WTF::move(frame), WTF::move(context), data));
+}
