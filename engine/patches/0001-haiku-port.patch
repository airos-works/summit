+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include "USBDevicePolicyHaiku.h"
+#include <atomic>
+#include <memory>
+#include <set>
+#include <span>
+
+class BUSBDevice;
+class BUSBConfiguration;
+class BUSBInterface;
+class BUSBEndpoint;
+
+namespace WebKit::USBHaiku {
+
+enum class Error { None, NotFound, Security, InvalidState, Network, NotSupported, Range, InvalidAccess, Abort };
+enum class Status { Ok, Stall, Babble };
+struct PacketResult {
+    Status status { Status::Ok };
+    uint32_t transferred { 0 };
+};
+struct Result {
+    Error error { Error::None };
+    Status status { Status::Ok };
+    uint32_t transferred { 0 };
+    std::vector<uint8_t> data;
+    std::vector<PacketResult> packets;
+    static Result failure(Error error) { Result r; r.error = error; return r; }
+};
+
+// Used exclusively on a broker worker thread. Browser-origin grants and
+// opaque capabilities are checked by the broker before it invokes this class.
+// Enumeration only reads descriptors; it never configures or claims a device.
+std::vector<Device> enumerateDevices();
+std::optional<Device> describeDevice(const std::string& path);
+
+class Session final {
+public:
+    Session();
+    ~Session();
+    Result open(const Device& approvedDevice);
+    void close();
+    // Safe from the broker main thread; the transfer worker owns all cleanup.
+    void abort() { m_aborted.store(true); }
+    bool opened() const { return !!m_device; }
+    const Device& state() const { return m_state; }
+    Result selectConfiguration(uint8_t);
+    Result claimInterface(uint8_t);
+    Result releaseInterface(uint8_t);
+    Result selectAlternateInterface(uint8_t, uint8_t);
+    Result clearHalt(bool input, uint8_t endpoint);
+    Result controlTransfer(bool input, uint8_t requestType, uint8_t recipient,
+        uint8_t request, uint16_t value, uint16_t index, size_t length, std::span<const uint8_t> output = { });
+    Result transfer(bool input, uint8_t endpoint, size_t length, std::span<const uint8_t> output = { });
+    Result isochronousTransfer(bool input, uint8_t endpoint, const std::vector<uint32_t>& lengths,
+        std::span<const uint8_t> output = { });
+    Result reset();
+
+private:
+    const BUSBConfiguration* configuration() const;
+    const BUSBInterface* interface(uint8_t number) const;
+    const BUSBEndpoint* endpoint(bool input, uint8_t number) const;
+    void refreshInterfaceState();
+    bool currentConfigurationMatches() const;
+    std::atomic<bool> m_aborted { false };
+    std::unique_ptr<BUSBDevice> m_device;
+    int m_rawFD { -1 };
+    Device m_state;
+    std::set<uint8_t> m_claimed;
+};
+
+} // namespace WebKit::USBHaiku
