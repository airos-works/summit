+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+#include <expected>
+#include <optional>
+#include <wtf/JSONValues.h>
+#include <wtf/URL.h>
+#include <wtf/Vector.h>
+
+namespace WebKit {
+
+struct WebExtensionWebRequestHeaderHaiku {
+    String name;
+    Vector<uint8_t> value;
+};
+
+struct WebExtensionWebRequestCredentialsHaiku {
+    String username;
+    String password;
+};
+
+// Preserve absent header lists separately from an explicitly empty replacement,
+// and preserve response-header duplicates and binary values without flattening.
+struct WebExtensionWebRequestDecisionHaiku {
+    bool cancel { false };
+    std::optional<URL> redirectURL;
+    std::optional<Vector<WebExtensionWebRequestHeaderHaiku>> requestHeaders;
+    std::optional<Vector<WebExtensionWebRequestHeaderHaiku>> responseHeaders;
+    std::optional<WebExtensionWebRequestCredentialsHaiku> authCredentials;
+};
+
+// This is the untrusted reply decoder, not an authorization decision. The UI
+// must still verify the responding context, event phase, permissions, private
+// access and redirect destination before any network mutation is permitted.
+std::expected<WebExtensionWebRequestDecisionHaiku, String> parseWebExtensionWebRequestDecisionHaiku(const String&);
+
+}
+#endif
diff --git a/Source/WebKit/Shared/Extensions/WebExtensionWebRequestGateResultHaiku.h b/Source/WebKit/Shared/Extensions/WebExtensionWebRequestGateResultHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..3001f2cff4c8cd460352b483777b65479cb052ce
--- /dev/null
+++ b/Source/WebKit/Shared/Extensions/WebExtensionWebRequestGateResultHaiku.h
@@ -0,0 +1,53 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+#include <optional>
+#include <utility>
+#include <wtf/Seconds.h>
+#include <wtf/URL.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+
+// Blocking webRequest phases, in network order. The values travel over IPC as
+// uint8_t and must stay in sync with WebExtensionWebRequestPhaseHaiku.
+constexpr uint8_t webExtensionWebRequestBeforeRequestPhaseHaiku = 0;
+constexpr uint8_t webExtensionWebRequestBeforeSendHeadersPhaseHaiku = 1;
+constexpr uint8_t webExtensionWebRequestHeadersReceivedPhaseHaiku = 2;
+constexpr uint8_t webExtensionWebRequestAuthRequiredPhaseHaiku = 3;
+constexpr uint8_t webExtensionWebRequestLastPhaseHaiku = webExtensionWebRequestAuthRequiredPhaseHaiku;
+
+constexpr uint8_t webExtensionWebRequestPhaseBitHaiku(uint8_t phase) { return static_cast<uint8_t>(1u << phase); }
+constexpr uint8_t webExtensionWebRequestAllPhasesHaiku = 0x0f;
+
+// A blocking decision never holds a load for longer than this. The UI process
+// completes the network process' request unmodified (fail open) when it fires.
+// The WebProcess stops waiting for Promise/asyncBlocking listeners slightly
+// earlier so that late listeners do not keep their transaction alive.
+constexpr Seconds webExtensionWebRequestBlockingTimeoutHaiku { 20_s };
+constexpr Seconds webExtensionWebRequestListenerTimeoutHaiku { 18_s };
+
+// Extension-supplied credentials are offered at most this many times for one
+// load before the ordinary authentication path takes over, which bounds loops
+// caused by wrong credentials.
+constexpr unsigned webExtensionWebRequestMaximumCredentialAttemptsHaiku = 3;
+
+// The merged, authorized result for one phase of one request. An empty result
+// continues the load unmodified. headers carries request headers for
+// BeforeSendHeaders and response headers for HeadersReceived.
+struct WebExtensionWebRequestGateResultHaiku {
+    bool cancel { false };
+    std::optional<URL> redirectURL;
+    std::optional<Vector<std::pair<String, String>>> headers;
+    std::optional<std::pair<String, String>> credentials;
+    // A redirect to a data: URL or to a web-accessible extension resource
+    // (uBlock Origin's redirect= surrogates), which the network process cannot
+    // load: the MIME type and body it answers the original request with.
+    std::optional<std::pair<String, Vector<uint8_t>>> surrogate;
+
+    bool isEmpty() const { return !cancel && !redirectURL && !headers && !credentials && !surrogate; }
+};
+
+}
+#endif
