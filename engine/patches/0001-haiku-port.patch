+    void removeIndexedDB(RefPtr<JSON::Value> options, Ref<WebExtensionCallbackHandler>&& callback, String& exception) { removeType(options, "indexedDB"_s, WTF::move(callback), exception); }
+    void removeLocalStorage(RefPtr<JSON::Value> options, Ref<WebExtensionCallbackHandler>&& callback, String& exception) { removeType(options, "localStorage"_s, WTF::move(callback), exception); }
+    void removePasswords(RefPtr<JSON::Value> options, Ref<WebExtensionCallbackHandler>&& callback, String& exception) { removeType(options, "passwords"_s, WTF::move(callback), exception); }
+    void removePluginData(RefPtr<JSON::Value> options, Ref<WebExtensionCallbackHandler>&& callback, String& exception) { removeType(options, "pluginData"_s, WTF::move(callback), exception); }
