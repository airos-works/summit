+
+void BWebKitSetSpellChecking(bool enabled, const char* languages, const char* dictionaryDirectory, const char* wordListPath)
+{
+    BWebKitSetSpellChecking(enabled, languages, dictionaryDirectory, wordListPath, true);
+}
+
+void BWebKitSetSpellChecking(bool enabled, const char* languages, const char* dictionaryDirectory, const char* wordListPath, bool usePageLanguage)
+{
+    auto apply = [enabled, usePageLanguage, languages = String::fromUTF8(languages ? languages : "").isolatedCopy(),
+        directory = String::fromUTF8(dictionaryDirectory ? dictionaryDirectory : "").isolatedCopy(),
+        wordList = String::fromUTF8(wordListPath ? wordListPath : "").isolatedCopy()] {
+        auto& checker = spellChecker();
+        if (checker.languages != languages || checker.dictionaryDirectory != directory || checker.wordListPath != wordList || checker.usePageLanguage != usePageLanguage || !enabled)
+            checker.unload();
+        checker.languages = languages;
+        checker.usePageLanguage = usePageLanguage;
+        checker.dictionaryDirectory = directory;
+        checker.wordListPath = wordList;
+        checker.enabled = enabled;
+        if (enabled)
+            checker.ensureLoaded();
+        {
+            std::lock_guard guard(languageLock);
+            auto name = checker.language.utf8();
+            strlcpy(languageName, name.legacyCStringPointer(), sizeof(languageName));
+        }
+        TextChecker::setContinuousSpellCheckingEnabled(enabled && (!checker.language.isEmpty()
+            || (usePageLanguage && checker.hunspell.load() && !checker.installedLanguages().empty())));
+    };
+    if (RunLoop::isMain())
+        apply();
+    else
+        RunLoop::mainSingleton().dispatch(WTF::move(apply));
+}
+
+const char* BWebKitSpellCheckingLanguage()
+{
+    std::lock_guard guard(languageLock);
+    return languageName;
+}
