index 0000000000000000000000000000000000000000..4ddda92f0c44ce8a1163c90ac526a0f0b849c75e
--- /dev/null
+++ b/Source/WebCore/platform/graphics/haiku/DashManifestHaiku.cpp
@@ -0,0 +1,319 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "DashManifestHaiku.h"
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+#include <libxml/uri.h>
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <limits>
+#include <map>
+#include <memory>
+#include <stdexcept>
+
+namespace SummitDASH {
+namespace {
+using Node = xmlNode*;
+using Attributes = std::map<std::string, std::string>;
+constexpr size_t maxSegments = 20000;
+struct Failure : std::runtime_error { using std::runtime_error::runtime_error; };
+bool named(Node node, const char* name)
+{
+    return node && node->type == XML_ELEMENT_NODE && xmlStrEqual(node->name, BAD_CAST name)
+        && (!node->ns || xmlStrEqual(node->ns->href, BAD_CAST "urn:mpeg:dash:schema:mpd:2011"));
+}
+std::string owned(xmlChar* value)
+{
+    if (!value) return {};
+    std::string result(reinterpret_cast<char*>(value)); xmlFree(value); return result;
+}
+std::string attribute(Node node, const char* name) { return owned(xmlGetProp(node, BAD_CAST name)); }
+Node child(Node node, const char* name)
+{
+    for (Node n = node ? node->children : nullptr; n; n = n->next) if (named(n, name)) return n;
+    return nullptr;
+}
+std::string trimmed(std::string s)
+{
+    auto start = s.find_first_not_of(" \t\r\n"), end = s.find_last_not_of(" \t\r\n");
+    return start == std::string::npos ? std::string() : s.substr(start, end - start + 1);
+}
+uint64_t number(const std::string& s, uint64_t fallback = 0)
+{
+    if (s.empty()) return fallback;
+    uint64_t value = 0;
+    auto result = std::from_chars(s.data(), s.data() + s.size(), value);
+    if (result.ec != std::errc() || result.ptr != s.data() + s.size()) throw Failure("Invalid DASH integer");
+    return value;
+}
+double seconds(const std::string& s, double fallback = 0)
+{
+    if (s.empty()) return fallback;
+    // XML durations used by media presentations: days, hours, minutes, seconds.
+    if (s[0] != 'P') throw Failure("Invalid DASH duration");
+    size_t at = 1; bool time = false, any = false; double total = 0;
+    while (at < s.size()) {
+        if (s[at] == 'T' && !time) { time = true; ++at; continue; }
+        size_t start = at;
+        while (at < s.size() && ((s[at] >= '0' && s[at] <= '9') || s[at] == '.')) ++at;
+        if (start == at || at == s.size()) throw Failure("Invalid DASH duration component");
+        const auto amount = s.substr(start, at - start);
+        char* end = nullptr; double value = std::strtod(amount.c_str(), &end);
+        if (end != amount.c_str() + amount.size() || !std::isfinite(value) || value < 0) throw Failure("Invalid DASH duration value");
+        char unit = s[at++];
+        double scale = !time && unit == 'D' ? 86400 : time && unit == 'H' ? 3600 : time && unit == 'M' ? 60 : time && unit == 'S' ? 1 : 0;
+        if (!scale) throw Failure("Unsupported DASH duration unit");
+        total += value * scale; any = true;
+    }
+    if (!any || !std::isfinite(total) || total > 315576000) throw Failure("DASH duration is out of range");
+    return total;
+}
+double timestamp(const std::string& text)
+{
+    int y, m, d, h, minute, consumed = 0; double second;
+    if (std::sscanf(text.c_str(), "%d-%d-%dT%d:%d:%lf%n", &y, &m, &d, &h, &minute, &second, &consumed) != 6
+        || y < 1970 || y > 9999 || m < 1 || m > 12 || d < 1 || d > 31 || h < 0 || h > 23 || minute < 0 || minute > 59
+        || !std::isfinite(second) || second < 0 || second >= 60)
+        throw Failure("Invalid DASH availability start time");
+    auto zone = text.substr(consumed); int offset = 0;
+    if (zone != "Z") {
+        int zh, zm, used = 0;
+        if (zone.size() != 6 || (zone[0] != '+' && zone[0] != '-') || std::sscanf(zone.c_str() + 1, "%d:%d%n", &zh, &zm, &used) != 2
+            || used != 5 || zh < 0 || zh > 23 || zm < 0 || zm > 59)
+            throw Failure("Invalid DASH timezone");
+        offset = (zh * 60 + zm) * 60 * (zone[0] == '-' ? -1 : 1);
+    }
+    std::tm time {}; time.tm_year = y - 1900; time.tm_mon = m - 1; time.tm_mday = d;
+    time.tm_hour = h; time.tm_min = minute; time.tm_sec = int(second);
+    auto epoch = timegm(&time);
+    if (time.tm_year != y - 1900 || time.tm_mon != m - 1 || time.tm_mday != d) throw Failure("Invalid DASH calendar date");
+    return double(epoch) + second - int(second) - offset;
+}
+std::string resolve(const std::string& base, const std::string& relative)
+{
+    if (relative.size() > 4096) throw Failure("DASH URL is too long");
+    auto result = owned(xmlBuildURI(BAD_CAST relative.c_str(), BAD_CAST base.c_str()));
+    std::unique_ptr<xmlURI, decltype(&xmlFreeURI)> uri(xmlParseURI(result.c_str()), xmlFreeURI);
+    if (!uri || !uri->scheme || !uri->server || uri->user
+        || (std::string(uri->scheme) != "https" && std::string(uri->scheme) != "http")) throw Failure("DASH resource requires an HTTP URL without credentials");
+    return result;
+}
+std::string baseURL(Node node, const std::string& base)
+{
+    auto n = child(node, "BaseURL"); return n ? resolve(base, trimmed(owned(xmlNodeGetContent(n)))) : base;
+}
+Attributes mergeAttributes(Attributes attributes, Node node)
+{
+    for (auto* a = node ? node->properties : nullptr; a; a = a->next)
+        attributes[reinterpret_cast<const char*>(a->name)] = owned(xmlNodeListGetString(node->doc, a->children, 1));
+    return attributes;
+}
+std::optional<ByteRange> range(const std::string& text)
+{
+    if (text.empty()) return {};
+    auto dash = text.find('-'); if (dash == std::string::npos || !dash || dash == text.size() - 1) throw Failure("Invalid DASH byte range");
+    ByteRange value {number(text.substr(0, dash)), number(text.substr(dash + 1))};
+    if (value.last < value.first || value.last - value.first > 128 * 1024 * 1024) throw Failure("DASH byte range is out of bounds");
+    return value;
+}
+std::string substitute(const std::string& pattern, const Representation& rep, uint64_t sequence, uint64_t time)
+{
+    std::string out;
+    for (size_t at = 0; at < pattern.size();) {
+        if (pattern[at] != '$') { out += pattern[at++]; continue; }
+        if (at + 1 < pattern.size() && pattern[at + 1] == '$') { out += '$'; at += 2; continue; }
+        size_t end = pattern.find('$', at + 1); if (end == std::string::npos) throw Failure("Unclosed DASH template variable");
+        auto variable = pattern.substr(at + 1, end - at - 1); auto format = variable.find('%');
+        unsigned width = 0;
+        if (format != std::string::npos) {
+            auto spec = variable.substr(format);
+            if (spec.size() < 4 || spec[1] != '0' || spec.back() != 'd') throw Failure("Unsupported DASH number format");
+            width = number(spec.substr(2, spec.size() - 3)); if (width > 20) throw Failure("DASH number width is too large");
+            variable.resize(format);
+        }
+        std::string value;
+        if (variable == "RepresentationID" && !width) value = rep.id;
+        else if (variable == "Number") value = std::to_string(sequence);
+        else if (variable == "Time") value = std::to_string(time);
+        else if (variable == "Bandwidth") value = std::to_string(rep.bandwidth);
+        else throw Failure("Unsupported DASH template variable");
+        if (width > value.size()) value.insert(0, width - value.size(), '0');
+        out += value; at = end + 1;
+        if (out.size() > 4096) throw Failure("DASH template result is too long");
+    }
+    return out;
+}
+struct Addressing {
+    std::string kind;
+    Attributes attributes;
+    Node timeline {nullptr}, initialization {nullptr}, list {nullptr};
+};
+Addressing addressing(Addressing inherited, Node node)
+{
+    for (const char* kind : {"SegmentTemplate", "SegmentList", "SegmentBase"}) {
+        if (auto n = child(node, kind)) {
+            if (inherited.kind != kind) inherited = {};
+            inherited.kind = kind; inherited.attributes = mergeAttributes(std::move(inherited.attributes), n);
+            if (auto timeline = child(n, "SegmentTimeline")) inherited.timeline = timeline;
+            if (auto init = child(n, "Initialization")) inherited.initialization = init;
+            if (child(n, "SegmentURL")) inherited.list = n;
+            return inherited;
+        }
+    }
+    return inherited;
+}
+void segments(Representation& rep, Addressing address, const std::string& base, double duration, const Manifest& manifest)
+{
+    if (address.kind != "SegmentTemplate" && address.kind != "SegmentList") throw Failure("DASH requires SegmentTemplate or SegmentList addressing");
+    auto& attrs = address.attributes;
+    const auto timescale = number(attrs["timescale"], 1), offset = number(attrs["presentationTimeOffset"]);
+    if (!timescale || timescale > UINT32_MAX) throw Failure("Invalid DASH timescale");
+    rep.presentationTimeOffset = double(offset) / timescale;
+    uint64_t sequence = number(attrs["startNumber"], 1);
+    if (address.kind == "SegmentTemplate") {
+        if (attrs["initialization"].empty() || attrs["media"].empty()) throw Failure("DASH template lacks initialization or media URL");
+        rep.initialization.url = resolve(base, substitute(attrs["initialization"], rep, sequence, 0));
+    } else {
+        if (!address.initialization || !address.list) throw Failure("DASH segment list lacks initialization or media");
+        rep.initialization = {resolve(base, attribute(address.initialization, "sourceURL")), range(attribute(address.initialization, "range"))};
+    }
+    std::vector<Node> urls;
+    if (address.list) for (Node n = address.list->children; n; n = n->next) if (named(n, "SegmentURL")) urls.push_back(n);
+    const double edge = manifest.dynamic ? std::max(0.0, manifest.liveEdge - rep.periodStart) : duration;
+    const double limit = duration > 0 ? (manifest.dynamic ? std::min(duration, edge) : duration) : edge;
+    if (!std::isfinite(limit) || limit <= 0) return;
+    const double earliest = manifest.dynamic ? std::max(0.0, edge - manifest.timeShiftBufferDepth) : 0;
+    size_t index = 0;
+    auto emit = [&](uint64_t time, uint64_t ticks) {
+        if (!ticks || time > UINT64_MAX - ticks || sequence == UINT64_MAX) throw Failure("Invalid DASH segment time");
+        double start = (double(time) - offset) / timescale, length = double(ticks) / timescale;
+        Resource resource;
+        if (address.kind == "SegmentTemplate") resource.url = resolve(base, substitute(attrs["media"], rep, sequence, time));
+        else {
+            if (index >= urls.size()) throw Failure("DASH timeline and segment list differ in length");
+            resource = {resolve(base, attribute(urls[index], "media")), range(attribute(urls[index], "mediaRange"))};
+        }
+        if (start + length > earliest && start < limit && (!manifest.dynamic || start + length <= limit + 0.01)) {
+            if (rep.segments.size() >= maxSegments) throw Failure("DASH representation contains too many segments");
+            rep.segments.push_back({std::move(resource), rep.periodStart + start, length, sequence, time});
+        }
+        ++index; ++sequence;
+    };
+    if (address.timeline) {
+        uint64_t current = 0;
+        for (Node n = address.timeline->children; n; n = n->next) {
+            if (!named(n, "S")) continue;
+            current = number(attribute(n, "t"), current);
+            uint64_t ticks = number(attribute(n, "d")); if (!ticks) throw Failure("DASH timeline duration is zero");
+            auto repeatText = attribute(n, "r"); uint64_t count;
+            if (repeatText == "-1") {
+                Node next = n->next; while (next && !named(next, "S")) next = next->next;
+                double boundary = next && !attribute(next, "t").empty() ? double(number(attribute(next, "t"))) : limit * timescale + offset;
+                if (boundary <= current) continue;
+                const double expanded = std::ceil((boundary - current) / ticks);
+                if (!std::isfinite(expanded) || expanded > 10000000) throw Failure("DASH repeat is too large");
+                count = uint64_t(expanded);
+            } else {
+                auto repeat = number(repeatText); if (repeat == UINT64_MAX) throw Failure("DASH repeat is too large"); count = repeat + 1;
+            }
+            if (count > 10000000 || count > (UINT64_MAX - current) / ticks) throw Failure("DASH timeline expansion is out of range");
+            // Skip old live segments arithmetically, not by looping over days of history.
+            uint64_t skip = 0;
+            if (earliest * timescale + offset > current)
+                skip = uint64_t(std::min(double(count), (earliest * timescale + offset - current) / ticks));
+            if (sequence > UINT64_MAX - skip || index > SIZE_MAX - skip) throw Failure("DASH sequence overflows");
+            current += skip * ticks; sequence += skip; index += skip;
+            for (uint64_t i = skip; i < count; ++i) {
+                if ((double(current) - offset) / timescale >= limit) break;
+                emit(current, ticks); current += ticks;
+            }
+        }
+    } else {
+        uint64_t ticks = number(attrs["duration"]); if (!ticks) throw Failure("DASH addressing has no duration or timeline");
+        double needed = std::ceil(limit * timescale / ticks);
+        if (!std::isfinite(needed) || needed > 10000000) throw Failure("DASH segment count is out of range");
+        uint64_t count = uint64_t(needed), first = uint64_t(earliest * timescale / ticks);
+        if (address.kind == "SegmentList") count = urls.size();
+        if (count > first + maxSegments || sequence > UINT64_MAX - count || count > (UINT64_MAX - offset) / ticks) throw Failure("DASH segment count is too large");
+        index = first; sequence += first;
+        for (uint64_t i = first; i < count; ++i) emit(offset + i * ticks, ticks);
+    }
+    if (rep.segments.empty()) throw Failure("DASH representation has no available segments");
+}
+}
+
+std::optional<Manifest> parseManifest(std::string_view xml, const std::string& responseURL, double nowUTC, std::string& error)
+{
+    error.clear();
+    try {
+        if (xml.empty() || xml.size() > 4 * 1024 * 1024 || !std::isfinite(nowUTC)) throw Failure("DASH manifest size or clock is invalid");
+        std::unique_ptr<xmlDoc, decltype(&xmlFreeDoc)> doc(xmlReadMemory(xml.data(), int(xml.size()), responseURL.c_str(), nullptr,
+            XML_PARSE_NONET | XML_PARSE_NOBLANKS | XML_PARSE_NOERROR | XML_PARSE_NOWARNING), xmlFreeDoc);
+        Node root = doc ? xmlDocGetRootElement(doc.get()) : nullptr;
+        if (!named(root, "MPD") || doc->intSubset || doc->extSubset
+            || (root->ns && !xmlStrEqual(root->ns->href, BAD_CAST "urn:mpeg:dash:schema:mpd:2011"))) throw Failure("Invalid DASH XML document");
+        Manifest result;
+        const auto type = attribute(root, "type");
+        if (!type.empty() && type != "static" && type != "dynamic") throw Failure("Unknown DASH presentation type");
+        result.dynamic = type == "dynamic";
+        result.duration = seconds(attribute(root, "mediaPresentationDuration"));
+        result.updatePeriod = std::clamp(seconds(attribute(root, "minimumUpdatePeriod"), 5), 1.0, 60.0);
+        result.timeShiftBufferDepth = std::clamp(seconds(attribute(root, "timeShiftBufferDepth"), 120), 5.0, 3600.0);
+        if (result.dynamic) result.liveEdge = std::max(0.0, nowUTC - timestamp(attribute(root, "availabilityStartTime")));
+        const auto base = baseURL(root, resolve(responseURL, ""));
+        std::vector<Node> periods;
+        for (Node n = root->children; n; n = n->next) if (named(n, "Period")) periods.push_back(n);
+        if (periods.empty() || periods.size() > 128) throw Failure("Invalid DASH period count");
+        double nextStart = 0; size_t representations = 0, totalSegments = 0;
+        for (size_t p = 0; p < periods.size(); ++p) {
+            Node node = periods[p]; Period period;
+            period.id = attribute(node, "id"); period.start = seconds(attribute(node, "start"), nextStart);
+            period.duration = seconds(attribute(node, "duration"));
+            if (!period.duration && p + 1 < periods.size() && !attribute(periods[p + 1], "start").empty()) period.duration = seconds(attribute(periods[p + 1], "start")) - period.start;
+            if (!period.duration && result.duration) period.duration = result.duration - period.start;
+            if (period.duration < 0 || (!result.dynamic && !period.duration)) throw Failure("DASH period has no finite duration");
+            nextStart = period.start + period.duration;
+            if (result.dynamic && ((period.duration && nextStart <= result.liveEdge - result.timeShiftBufferDepth)
+                || period.start >= result.liveEdge)) continue;
+            auto periodBase = baseURL(node, base); auto periodAddress = addressing({}, node);
+            unsigned adaptationIndex = 0;
+            for (Node adaptation = node->children; adaptation; adaptation = adaptation->next) {
+                if (!named(adaptation, "AdaptationSet")) continue;
+                ++adaptationIndex;
+                auto inherited = mergeAttributes({}, adaptation);
+                auto adaptationBase = baseURL(adaptation, periodBase);
+                auto adaptationAddress = addressing(periodAddress, adaptation);
+                for (Node representation = adaptation->children; representation; representation = representation->next) {
+                    if (!named(representation, "Representation")) continue;
+                    if (++representations > 256) throw Failure("DASH has too many representations");
+                    auto attributes = mergeAttributes(inherited, representation);
+                    Representation rep;
+                    rep.id = attribute(representation, "id"); rep.adaptationID = attribute(adaptation, "id");
+                    if (rep.adaptationID.empty()) rep.adaptationID = std::to_string(adaptationIndex);
+                    rep.mimeType = attributes["mimeType"]; rep.codecs = attributes["codecs"]; rep.language = attributes["lang"];
+                    if (!rep.mimeType.empty() && rep.mimeType != "video/mp4" && rep.mimeType != "audio/mp4") continue;
+                    rep.audio = attributes["contentType"] == "audio" || rep.mimeType == "audio/mp4";
+                    rep.video = attributes["contentType"] == "video" || rep.mimeType == "video/mp4";
+                    if (!rep.audio && !rep.video) continue;
+                    if (rep.mimeType.empty()) rep.mimeType = rep.audio ? "audio/mp4" : "video/mp4";
+                    rep.bandwidth = number(attributes["bandwidth"]);
+                    auto width = number(attributes["width"]), height = number(attributes["height"]);
+                    if (width > 16384 || height > 16384) throw Failure("DASH video dimensions are too large");
+                    rep.width = unsigned(width); rep.height = unsigned(height); rep.periodStart = period.start;
+                    rep.encrypted = child(adaptation, "ContentProtection") || child(representation, "ContentProtection");
+                    segments(rep, addressing(adaptationAddress, representation), baseURL(representation, adaptationBase), period.duration, result);
+                    totalSegments += rep.segments.size(); if (totalSegments > 250000) throw Failure("DASH manifest expands to too many segments");
+                    period.representations.push_back(std::move(rep));
+                }
+            }
+            if (!period.representations.empty()) result.periods.push_back(std::move(period));
+        }
+        if (result.periods.empty()) throw Failure("DASH manifest has no supported media representations");
+        if (!result.dynamic && !result.duration) result.duration = nextStart;
+        return result;
+    } catch (const Failure& failure) { error = failure.what(); return {}; }
+}
+}
diff --git a/Source/WebCore/platform/graphics/haiku/DashManifestHaiku.h b/Source/WebCore/platform/graphics/haiku/DashManifestHaiku.h
