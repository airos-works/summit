+void BWebKitContext::NotifyHistoryChanged(const char* event, const char* json)
+{
+    if (m_status != B_OK || !event || !json)
+        return;
+    bool visited = !strcmp(event, "visited");
+    if (!visited && strcmp(event, "removed"))
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([context = m_context, visited, json = String::fromUTF8(json).isolatedCopy()] {
+        Ref controller = context->extensionController();
