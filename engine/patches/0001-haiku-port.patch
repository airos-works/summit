@@ -0,0 +1,222 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEB_BLUETOOTH)
+#include "BluetoothGATTObjects.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventDispatcher.h"
+#include "Event.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "JSDOMConvertBufferSource.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMConvertNullable.h"
+#include "JSDOMConvertSequences.h"
+#include "JSDOMGlobalObjectInlines.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSBluetoothRemoteGATTServer.h"
+#include "JSBluetoothRemoteGATTService.h"
+#include "JSBluetoothRemoteGATTCharacteristic.h"
+#include "JSBluetoothRemoteGATTDescriptor.h"
+#include "JSValueInWrappedObjectInlines.h"
+#include "ScriptWrappableInlines.h"
+#include <JavaScriptCore/JSCInlines.h>
+#include <wtf/TZoneMallocInlines.h>
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(BluetoothRemoteGATTService);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(BluetoothRemoteGATTDescriptor);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(BluetoothRemoteGATTCharacteristic);
+
+template<typename T, bool single, typename Factory, typename Promise>
+static void discover(BluetoothDevice& device, const String& generation, Ref<JSON::Object>&& args,
+    std::optional<BluetoothUUIDValue>&& query, BluetoothHaiku::UUIDKind kind, Factory&& factory, Promise&& promise)
+{
+    if (query) {
+        auto resolved = BluetoothUUID::resolve(kind, *query);
+        if (resolved.hasException()) { promise.reject(resolved.releaseException()); return; }
+        args->setString("uuid"_s, resolved.releaseReturnValue());
+    }
+    device.perform(generation, WTF::move(args), { }, [factory = std::forward<Factory>(factory), promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        Vector<Ref<T>> items;
+        if (auto values = result.releaseReturnValue()->getArray("items"_s)) {
+            for (auto& value : *values) if (auto object = value->asObject()) items.append(factory(object.releaseNonNull()));
+        }
+        if constexpr (single) {
+            if (items.isEmpty()) promise.reject(ExceptionCode::NotFoundError, "The requested GATT attribute was not found"_s);
+            else promise.resolve(items[0].copyRef());
+        } else promise.resolve(WTF::move(items));
+    });
+}
