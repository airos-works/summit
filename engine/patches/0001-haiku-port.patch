+    // A scroll animation is sampled at the time the next frame is due
+    // (ScrollingTreeCoordinated::scrollAnimationSampleTimeHaiku()), by
+    // whichever refresh comes first after the last frame's scene was taken:
+    // twice a frame, so that every frame gets one although the timer is not
+    // in step with the compositor. A second refresh for the same frame finds
+    // the animations where the first left them.
+    static const bool samplesAtFrameTimes = [] {
+        const char* value = std::getenv("SUMMIT_SCROLL_FRAME_TIMES");
+        return !value || value[0] != '0' || value[1];
+    }();
+    auto interval = haikuScrollRefreshInterval();
+    if (animates && samplesAtFrameTimes)
+        interval = interval / 2;
+    m_queue->dispatchAfter(interval, [this, protectedThis = Ref { *this }] {
+        refreshHaikuScrollingTrees();
+    });
+}
