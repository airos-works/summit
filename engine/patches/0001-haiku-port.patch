+// The libwebrtc format of a WebCodecs codec string, if it is one we have.
+static std::optional<webrtc::SdpVideoFormat> sdpFormatForCodec(const String& codec)
+{
+    if (codec == "vp8"_s)
+        return webrtc::SdpVideoFormat("VP8");
+    if (codec.startsWith("vp09.00"_s))
+        return webrtc::SdpVideoFormat("VP9", { { "profile-id", "0" } });
+    if (codec.startsWith("vp09.02"_s))
+        return webrtc::SdpVideoFormat("VP9", { { "profile-id", "2" } });
+    // avc1.PPCCLL: profile, constraints and level, in hexadecimal.
+    if ((codec.startsWith("avc1."_s) || codec.startsWith("avc3."_s)) && codec.length() == 11) {
+        auto profileLevel = codec.substring(5).convertToASCIILowercase();
+        if (!parseInteger<uint32_t>(profileLevel, 16))
+            return std::nullopt;
+        return webrtc::SdpVideoFormat("H264", {
+            { "profile-level-id", profileLevel.utf8().toStdString() },
+            { "packetization-mode", "1" },
+            { "level-asymmetry-allowed", "1" },
+        });
+    }
+    // Decoded through FFmpeg (dav1d, its HEVC decoder) only: WebRTC is not offered them.
+    if (codec.startsWith("av01."_s))
+        return webrtc::SdpVideoFormat("AV1");
+    if (codec.startsWith("hev1."_s) || codec.startsWith("hvc1."_s))
+        return webrtc::SdpVideoFormat("H265");
+    return std::nullopt;
+}
