+void WebExtensionAPITabs::ungroup(JSContextRef context, JSValueRef tabIds, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    // A tab identifier or an array of them, as tabs.remove takes.
+    RefPtr values = fromJSValue(context, tabIds);
+    if (auto identifiers = parseWebExtensionTabIdentifiers(values.get()); !identifiers) {
+        exception = identifiers.error();
+        return;
+    }
+    callback->call();
+}
