index 0000000000000000000000000000000000000000..8097f7a017033ac54c4f2131279f7585e978f7b0
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/SpellingLanguageHaiku.h
@@ -0,0 +1,82 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace WebKit::SpellingLanguageHaiku {
+
+inline std::string normalize(std::string_view language)
+{
+    if (language.empty() || language.size() > 128)
+        return { };
+    std::string result;
+    unsigned subtagLength = 0;
+    bool first = true;
+    for (unsigned char character : language) {
+        if (character == '-' || character == '_') {
+            if (!subtagLength || subtagLength > 8 || (first && subtagLength < 2))
+                return { };
+            result += '-';
+            subtagLength = 0;
+            first = false;
+            continue;
+        }
+        if (character >= 'A' && character <= 'Z')
+            character += 'a' - 'A';
+        if (!((character >= 'a' && character <= 'z') || (!first && character >= '0' && character <= '9')))
+            return { };
+        result += character;
+        ++subtagLength;
+    }
+    if (!subtagLength || subtagLength > 8 || (first && subtagLength < 2))
+        return { };
+    return result;
+}
+
+// Prefer the exact tag, then progressively less specific tags. When a tag
+// only names a language, keep a matching system preference before choosing
+// another installed regional dictionary. Return the installed spelling of
+// the name, never a filename supplied by the page.
+inline std::string select(std::string_view language, const std::vector<std::string>& available,
+    const std::vector<std::string>& preferred)
+{
+    auto candidate = normalize(language);
+    while (!candidate.empty()) {
+        for (const auto& name : available) {
+            if (normalize(name) == candidate)
+                return name;
+        }
+        const auto prefix = candidate + '-';
+        for (const auto& preference : preferred) {
+            const auto normalized = normalize(preference);
+            if (!normalized.starts_with(prefix))
+                continue;
+            for (const auto& name : available) {
+                if (normalize(name) == normalized)
+                    return name;
+            }
+        }
+        for (const auto& name : available) {
+            if (normalize(name) == candidate + '-' + candidate)
+                return name;
+        }
+        for (const auto& name : available) {
+            if (normalize(name).starts_with(prefix))
+                return name;
+        }
+        auto separator = candidate.rfind('-');
+        if (separator == std::string::npos)
+            break;
+        candidate.resize(separator);
+        // Remove an extension singleton together with its last subtag.
+        separator = candidate.rfind('-');
+        if (separator != std::string::npos && candidate.size() - separator == 2)
+            candidate.resize(separator);
+    }
+    return { };
+}
+
+} // namespace WebKit::SpellingLanguageHaiku
