+    if (changed.containsAny({ WebCore::ActivityState::IsVisible, WebCore::ActivityState::IsAudible, WebCore::ActivityState::IsCapturingMedia }))
+        updateProcessPriorityHaiku(m_pageMap);
+#endif
 }
 
