diff --git a/Source/WebCore/Modules/webusb/USB.cpp b/Source/WebCore/Modules/webusb/USB.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1c9ca609fa8add3ebb591ef48730532f87eeac10
--- /dev/null
+++ b/Source/WebCore/Modules/webusb/USB.cpp
@@ -0,0 +1,262 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "USB.h"
+#include "Chrome.h"
+#include "ChromeClient.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "FrameDestructionObserverInlines.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMConvertSequences.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSUSBDevice.h"
+#include "LocalDOMWindow.h"
+#include "LocalFrame.h"
+#include "Page.h"
+#include "PermissionsPolicy.h"
+#include "SecurityOrigin.h"
+#include "USBConnectionEvent.h"
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(USB);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(USBConnectionEvent);
+
+Ref<USB> USB::create(Document& document)
+{
+    auto result = adoptRef(*new USB(document));
+    result->suspendIfNeeded();
+    return result;
+}
+USB::USB(Document& document)
+    : ActiveDOMObject(&document), m_pollTimer(*this, &USB::pollDevices) { }
+USB::~USB() = default;
+Document* USB::document() const { return dynamicDowncast<Document>(scriptExecutionContext()); }
+
+static ExceptionCode errorCode(const String& name)
+{
+    if (name == "SecurityError"_s) return ExceptionCode::SecurityError;
+    if (name == "NotFoundError"_s) return ExceptionCode::NotFoundError;
+    if (name == "NotAllowedError"_s) return ExceptionCode::NotAllowedError;
+    if (name == "InvalidStateError"_s) return ExceptionCode::InvalidStateError;
+    if (name == "NotSupportedError"_s) return ExceptionCode::NotSupportedError;
+    if (name == "InvalidAccessError"_s) return ExceptionCode::InvalidAccessError;
+    if (name == "AbortError"_s) return ExceptionCode::AbortError;
+    if (name == "TypeError"_s) return ExceptionCode::TypeError;
+    if (name == "RangeError"_s) return ExceptionCode::RangeError;
+    return ExceptionCode::NetworkError;
+}
+
+void USB::perform(Document* document, Ref<JSON::Object>&& arguments, Vector<uint8_t>&& bytes, Completion&& completion)
+{
+    if (!document || !document->isFullyActive() || !document->frame() || !document->page()) {
+        completion(Exception { ExceptionCode::InvalidStateError, "The USB document is no longer active"_s }, { });
+        return;
+    }
+    if (!document->isSecureContext() || document->securityOrigin().isOpaque()
+        || !PermissionsPolicy::isFeatureEnabled(PermissionsPolicy::Feature::USB, *document)) {
+        completion(Exception { ExceptionCode::SecurityError, "USB access is not allowed in this document"_s }, { });
+        return;
+    }
+    if (bytes.size() > 16 * 1024 * 1024) {
+        completion(Exception { ExceptionCode::RangeError, "USB transfer exceeds 16 MiB"_s }, { });
+        return;
+    }
+    arguments->setString("document"_s, document->identifier().toString());
+    document->page()->chrome().client().usbRequest(*document->frame(), arguments->toJSONString(), WTF::move(bytes),
+        [document = WeakPtr { *document }, completion = WTF::move(completion)](String&& response, Vector<uint8_t>&& bytes) mutable {
+            if (!document || !document->isFullyActive()) {
+                completion(Exception { ExceptionCode::AbortError, "The USB document was closed"_s }, { });
+                return;
+            }
+            auto value = JSON::Value::parseJSON(response);
+            auto object = value ? value->asObject() : nullptr;
+            if (!object) {
+                completion(Exception { ExceptionCode::NetworkError, "Invalid USB broker response"_s }, { });
+                return;
+            }
+            auto error = object->getString("error"_s);
+            if (!error.isEmpty()) {
+                completion(Exception { errorCode(error), object->getString("message"_s) }, { });
+                return;
+            }
+            completion(object.releaseNonNull(), WTF::move(bytes));
+        });
+}
+
+Ref<USBDevice> USB::device(Ref<JSON::Object>&& data)
+{
+    m_devices.removeIf([&](auto& entry) {
+        if (!entry.value->state().forgotten)
+            return false;
+        m_connected.remove(entry.key);
+        return true;
+    });
+    auto id = data->getString("id"_s);
+    if (!m_stopped && !m_pollTimer.isActive())
+        m_pollTimer.startRepeating(2_s);
+    if (auto it = m_devices.find(id); it != m_devices.end())
+        return it->value.copyRef();
+    auto value = USBDevice::create(*document(), WTF::move(data));
+    m_devices.add(id, value.copyRef());
+    return value;
+}
+
+void USB::getDevices(DOMPromiseDeferred<IDLSequence<IDLInterface<USBDevice>>>&& promise)
+{
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "getDevices"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        Vector<Ref<USBDevice>> devices;
+        if (auto values = result->getArray("devices"_s)) {
+            for (auto& value : *values) {
+                if (auto data = value->asObject()) {
+                    auto item = device(data.releaseNonNull());
+                    m_connected.add(item->identifier());
+                    devices.append(WTF::move(item));
+                }
+            }
+        }
+        promise.resolve(WTF::move(devices));
+    });
+}
+
+static RefPtr<JSON::Array> filtersJSON(const Vector<USBDeviceFilter>& filters)
+{
+    if (filters.size() > 64)
+        return nullptr;
+    auto result = JSON::Array::create();
+    for (auto& filter : filters) {
+        if ((filter.productId && !filter.vendorId) || (filter.subclassCode && !filter.classCode)
+            || (filter.protocolCode && !filter.subclassCode) || filter.serialNumber.length() > 1024)
+            return nullptr;
+        auto value = JSON::Object::create();
+        if (filter.vendorId) value->setInteger("vendorId"_s, *filter.vendorId);
+        if (filter.productId) value->setInteger("productId"_s, *filter.productId);
+        if (filter.classCode) value->setInteger("classCode"_s, *filter.classCode);
+        if (filter.subclassCode) value->setInteger("subclassCode"_s, *filter.subclassCode);
+        if (filter.protocolCode) value->setInteger("protocolCode"_s, *filter.protocolCode);
+        if (!filter.serialNumber.isNull()) value->setString("serialNumber"_s, filter.serialNumber);
+        result->pushObject(WTF::move(value));
+    }
+    return result;
+}
+
+void USB::requestDevice(USBDeviceRequestOptions&& options, DOMPromiseDeferred<IDLInterface<USBDevice>>&& promise)
+{
+    auto filters = filtersJSON(options.filters);
+    auto exclusions = filtersJSON(options.exclusionFilters);
+    if (!filters || !exclusions) {
+        promise.reject(ExceptionCode::TypeError, "Invalid USB device filter"_s);
+        return;
+    }
+    auto* doc = document();
+    if (!doc || !doc->window() || !doc->window()->hasTransientActivation()) {
+        promise.reject(ExceptionCode::SecurityError, "Choosing a USB device requires a user gesture"_s);
+        return;
+    }
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "requestDevice"_s);
+    args->setArray("filters"_s, filters.releaseNonNull());
+    args->setArray("exclusionFilters"_s, exclusions.releaseNonNull());
+    perform(doc, WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        auto value = result->getObject("device"_s);
+        if (!value) {
+            promise.reject(ExceptionCode::NotFoundError, "No USB device was selected"_s);
+            return;
+        }
+        auto selected = device(value.releaseNonNull());
+        m_connected.add(selected->identifier());
+        promise.resolve(WTF::move(selected));
+    });
+}
+
+void USB::eventListenersDidChange()
+{
+    bool listening = hasEventListeners(eventNames().connectEvent) || hasEventListeners(eventNames().disconnectEvent);
+    if (listening && !m_stopped && !m_pollTimer.isActive())
+        m_pollTimer.startRepeating(2_s);
+    else if (!listening && m_devices.isEmpty())
+        m_pollTimer.stop();
+}
+bool USB::virtualHasPendingActivity() const
+{
+    if (m_stopped)
+        return false;
+    if (hasEventListeners())
+        return true;
+    return std::ranges::any_of(m_devices.values(), [](auto& device) { return device->opened(); });
+}
+void USB::suspend(ReasonForSuspension) { m_pollTimer.stop(); }
+void USB::resume() { eventListenersDidChange(); }
+void USB::stop()
+{
+    m_stopped = true;
+    m_pollTimer.stop();
+    for (auto& entry : m_devices)
+        entry.value->disconnected();
+    m_connected.clear();
+    // The UI broker independently cancels leases on frame navigation/closure.
+}
+void USB::pollDevices()
+{
+    if (m_polling || m_stopped)
+        return;
+    m_polling = true;
+    auto args = JSON::Object::create();
+    args->setString("operation"_s, "getDevices"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }](auto&& response, auto&&) mutable {
+        m_polling = false;
+        if (response.hasException() || m_stopped)
+            return;
+        HashSet<String> connected;
+        Vector<Ref<Event>> events;
+        auto result = response.releaseReturnValue();
+        if (auto values = result->getArray("devices"_s)) {
+            for (auto& value : *values) {
+                auto data = value->asObject();
+                if (!data)
+                    continue;
+                auto item = device(data.releaseNonNull());
+                auto id = item->identifier();
+                connected.add(id);
+                if (!m_connected.contains(id)) {
+                    USBConnectionEvent::Init init { { }, item.copyRef() };
+                    events.append(USBConnectionEvent::create(eventNames().connectEvent, WTF::move(init), Event::IsTrusted::Yes));
+                }
+            }
+        }
+        for (auto& id : m_connected) {
+            if (connected.contains(id))
+                continue;
+            if (auto it = m_devices.find(id); it != m_devices.end()) {
+                it->value->disconnected();
+                USBConnectionEvent::Init init { { }, it->value.copyRef() };
+                events.append(USBConnectionEvent::create(eventNames().disconnectEvent, WTF::move(init), Event::IsTrusted::Yes));
+            }
+        }
+        m_connected = WTF::move(connected);
+        // A listener may navigate or stop this object. Finish updating the
+        // device map before invoking page code, and iterate a separate list.
+        for (auto& event : events) {
+            if (m_stopped)
+                break;
+            dispatchEvent(event);
+        }
+    });
+}
+} // namespace WebCore
+#endif
