+void Pasteboard::clear()
+{
+    if (m_forDragAndDrop) {
+        m_dragData.clear();
+        m_dragFileNames.clear();
+        return;
+    }
+    AutoClipboardLocker locker(be_clipboard);
+    if (!locker.isLocked())
+        return;
+
+    be_clipboard->Clear();
+    be_clipboard->Commit();
+}
