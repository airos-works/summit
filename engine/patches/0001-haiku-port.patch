+void EventDispatcher::scheduleHaikuScrollRefresh()
+{
+    // Haiku has no display link. Keep layer positions in step with wheel
+    // scrolling, but stop the timer as soon as the scrolling tree is inactive.
+    auto interval = haikuScrollRefreshInterval();
+    if (!interval || m_haikuScrollRefreshScheduled)
+        return;
+
+    m_haikuScrollRefreshScheduled = true;
+    m_queue->dispatchAfter(interval, [this, protectedThis = Ref { *this }] {
+        refreshHaikuScrollingTrees();
+    });
+}
+
+// The refreshes above run on their own timer, out of step with the frames:
+// the first after a frame's scene was taken samples the animations for the
+// next, anywhere up to 8 ms later. A rendering update starts just after the
+// frame (RenderingUpdateScheduler), so scripts reading the scroll position in
+// requestAnimationFrame saw the next frame's position some frames and the
+// last one's on others: a step repeated and one doubled every 12 frames or so
+// (a script parallax jerked). Sampled as soon as the scene is taken, the next
+// frame's position is there when the update starts, and what a script draws
+// with it is composed with that frame. The timer's refreshes for the same
+// frame sample the same time.
+void EventDispatcher::compositorDidFlushFrameHaiku()
+{
+    Locker locker { m_scrollingTreesLock };
+    for (auto& entry : m_scrollingTrees) {
+        Ref scrollingTree = entry.value;
+        if (scrollingTree->hasRecentActivity() && scrollingTree->hasNodeWithActiveScrollAnimations())
+            scrollingTree->displayDidRefresh(scrollingTree->displayID());
+    }
+}
