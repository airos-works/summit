+
+#pragma once
+
+#if OS(HAIKU)
+
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Noncopyable.h>
+
+namespace WebKit {
+
+// Haiku sends applications no low-memory notifications, so, like the Linux
+// monitor, this polls the system's memory use and tells every auxiliary
+// process when it runs short. They then drop caches, collect garbage and
+// return free heap to the system.
+class MemoryPressureMonitor {
+    WTF_MAKE_NONCOPYABLE(MemoryPressureMonitor);
+    friend NeverDestroyed<MemoryPressureMonitor>;
+public:
+    static MemoryPressureMonitor& singleton();
+    void start();
+    static bool disabled();
+
+private:
+    MemoryPressureMonitor() = default;
+    bool m_started { false };
+};
+
+} // namespace WebKit
+
+#endif // OS(HAIKU)
diff --git a/Source/WebKit/UIProcess/haiku/NativeColorPickerHaiku.h b/Source/WebKit/UIProcess/haiku/NativeColorPickerHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..e9cb002658620cb1ebd184697a6b449987c1dac4
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeColorPickerHaiku.h
@@ -0,0 +1,138 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <Button.h>
+#include <ColorControl.h>
+#include <GroupView.h>
+#include <LayoutBuilder.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <Screen.h>
+#include <View.h>
+#include <Window.h>
+#include <algorithm>
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace WebKit {
+
+// The window looper owns only native data. Its completion queues work for the
+// WebKit loop; cancel never waits for the window or dereferences a raw view.
+class NativeColorPickerHaiku final {
+    enum : uint32 { changed = 'cpch', accept = 'cpok', update = 'cpup', swatch = 'cpsw' };
+    struct Control {
+        explicit Control(std::function<void(std::optional<rgb_color>)>&& callback)
+            : complete(std::move(callback)) { }
+        const std::function<void(std::optional<rgb_color>)> complete;
+        std::atomic<bool> cancelled { false };
+    };
+    class Swatch final : public BButton {
+    public:
+        Swatch(rgb_color color, BMessage* message)
+            : BButton("color-swatch", "", message), m_color(color)
+        {
+            SetExplicitSize(BSize(24, 24));
+        }
+        void Draw(BRect) override
+        {
+            auto bounds = Bounds();
+            SetHighColor(ui_color(B_PANEL_TEXT_COLOR)); StrokeRect(bounds);
+            bounds.InsetBy(2, 2);
+            SetHighColor(m_color); FillRect(bounds);
+        }
+        void setColor(rgb_color color) { m_color = color; Invalidate(); }
+    private:
+        rgb_color m_color;
+    };
+    class Window final : public BWindow {
+    public:
+        Window(std::shared_ptr<Control> control, rgb_color initial, const std::vector<rgb_color>& suggestions, BRect anchor)
+            : BWindow(BRect(0, 0, 360, 260), "Choose color — Summit", B_TITLED_WINDOW,
+                B_ASYNCHRONOUS_CONTROLS | B_AUTO_UPDATE_SIZE_LIMITS | B_NOT_RESIZABLE | B_NOT_ZOOMABLE | B_CLOSE_ON_ESCAPE)
+            , m_control(std::move(control))
+        {
+            m_picker = new BColorControl(B_ORIGIN, B_CELLS_32x8, 8, "color-picker", new BMessage(changed));
+            m_picker->SetValue(initial);
+            m_preview = new Swatch(initial, nullptr);
+            m_preview->SetEnabled(false);
+            auto* done = new BButton("color-done", "Done", new BMessage(accept));
+            auto* cancel = new BButton("color-cancel", "Cancel", new BMessage(B_QUIT_REQUESTED));
+            auto layout = BLayoutBuilder::Group<>(this, B_VERTICAL, 12).SetInsets(12);
+            layout.Add(m_picker);
+            if (!suggestions.empty()) {
+                auto* colors = new BGroupView("suggested-colors", B_HORIZONTAL, 4);
+                for (auto color : suggestions) {
+                    auto* message = new BMessage(swatch);
+                    message->AddData("color", B_RGB_COLOR_TYPE, &color, sizeof(color));
+                    colors->AddChild(new Swatch(color, message));
+                }
+                layout.Add(colors);
+            }
+            layout.AddGroup(B_HORIZONTAL, 8).Add(m_preview).AddGlue().Add(cancel).Add(done).End();
+            SetDefaultButton(done);
+            Layout(true);
+            auto screen = BScreen().Frame();
+            MoveTo(std::clamp(anchor.left, screen.left, std::max(screen.left, screen.right - Bounds().Width())),
+                std::clamp(anchor.bottom + 8, screen.top + 24, std::max(screen.top + 24, screen.bottom - Bounds().Height())));
+        }
+        bool QuitRequested() override { finish(std::nullopt); return true; }
+        void MessageReceived(BMessage* message) override
+        {
+            if (message->what == accept) {
+                finish(m_picker->ValueAsColor());
+                PostMessage(B_QUIT_REQUESTED);
+                return;
+            }
+            if (message->what == update || message->what == swatch) {
+                const rgb_color* color = nullptr;
+                ssize_t size = 0;
+                if (message->FindData("color", B_RGB_COLOR_TYPE, reinterpret_cast<const void**>(&color), &size) == B_OK && size == sizeof(rgb_color))
+                    m_picker->SetValue(*color);
+                m_preview->setColor(m_picker->ValueAsColor());
+                return;
+            }
+            if (message->what == changed) { m_preview->setColor(m_picker->ValueAsColor()); return; }
+            BWindow::MessageReceived(message);
+        }
+    private:
+        void finish(std::optional<rgb_color> color)
+        {
+            if (std::exchange(m_finished, true) || m_control->cancelled) return;
+            m_control->complete(color);
+        }
+        const std::shared_ptr<Control> m_control;
+        BColorControl* m_picker { nullptr };
+        Swatch* m_preview { nullptr };
+        bool m_finished { false };
+    };
+public:
+    NativeColorPickerHaiku(rgb_color initial, const std::vector<rgb_color>& suggestions, BRect anchor,
+        std::function<void(std::optional<rgb_color>)>&& completion)
+        : m_control(std::make_shared<Control>(std::move(completion)))
+    {
+        auto* window = new Window(m_control, initial, suggestions, anchor);
+        m_window = BMessenger(window);
+        window->Show();
+    }
+    ~NativeColorPickerHaiku() { cancel(); }
+    void cancel()
+    {
+        m_control->cancelled = true;
+        BMessage message(B_QUIT_REQUESTED);
+        m_window.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+    void setColor(rgb_color color)
+    {
+        BMessage message(update);
+        message.AddData("color", B_RGB_COLOR_TYPE, &color, sizeof(color));
+        m_window.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+private:
+    const std::shared_ptr<Control> m_control;
+    BMessenger m_window;
+};
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/NativeDataListSuggestionsHaiku.h b/Source/WebKit/UIProcess/haiku/NativeDataListSuggestionsHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..5207569116db94edce3a1009a7e57304be507f14
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeDataListSuggestionsHaiku.h
@@ -0,0 +1,278 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <ListItem.h>
+#include <ListView.h>
+#include <MessageRunner.h>
+#include <Messenger.h>
+#include <Screen.h>
+#include <ScrollView.h>
+#include <String.h>
+#include <Window.h>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace WebKit {
+
+// The native looper owns the window and list. The engine owns only this
+// cancellation handle; callbacks must dispatch back to the engine's run loop.
+class NativeDataListSuggestionsHaiku final {
+public:
+    struct Item { std::string value; std::string label; };
+    using Completion = std::function<void(std::optional<std::string>, uint64_t)>;
+    enum class Key { Up, Down, Enter, Escape };
+
+    NativeDataListSuggestionsHaiku(BMessenger view, Completion completion)
+        : m_control(std::make_shared<Control>(view, std::move(completion))) { }
+    ~NativeDataListSuggestionsHaiku() { cancel(); }
+    static unsigned activeCount() { return s_active.load(); }
+    BMessenger target() const { std::lock_guard lock(m_control->mutex); return m_control->target; }
+    void cancel() { m_control->cancelled = true; target().SendMessage(updateMessage); }
+    void update(std::vector<Item> items, BRect anchor, uint64_t generation)
+    {
+        {
+            std::lock_guard lock(m_control->mutex);
+            m_control->items = std::move(items);
+            m_control->anchor = anchor;
+            m_control->generation = generation;
+        }
+        target().SendMessage(updateMessage);
+    }
+    void key(Key key)
+    {
+        {
+            std::lock_guard lock(m_control->mutex);
+            m_control->keys.emplace_back(key, m_control->generation);
+        }
+        target().SendMessage(updateMessage);
+    }
+    status_t start()
+    {
+        if (std::exchange(m_started, true)) return B_NOT_ALLOWED;
+        auto* data = new std::shared_ptr<Control>(m_control);
+        ++s_active;
+        auto thread = spawn_thread([](void* pointer) -> int32 {
+            std::unique_ptr<std::shared_ptr<Control>> data(static_cast<std::shared_ptr<Control>*>(pointer));
+            auto control = *data;
+            status_t status = B_TIMED_OUT;
+            const auto deadline = system_time() + 2000000;
+            while (!control->cancelled && system_time() < deadline) {
+                status = control->view.LockTargetWithTimeout(50000);
+                if (status != B_TIMED_OUT && status != B_WOULD_BLOCK) break;
+            }
+            Window* window = nullptr;
+            if (status == B_OK) {
+                BLooper* looper = nullptr;
+                auto* view = dynamic_cast<BView*>(control->view.Target(&looper));
+                auto* owner = view ? view->Window() : nullptr;
+                if (!control->cancelled && owner && owner->IsActive() && !owner->IsHidden() && !view->IsHidden()) {
+                    window = new Window(control);
+                    if (window->AddToSubset(owner) != B_OK) { delete window; window = nullptr; }
+                }
+                if (looper) looper->Unlock();
+            }
+            if (window) {
+                {
+                    std::lock_guard lock(control->mutex);
+                    control->target = BMessenger(window);
+                }
+                // Begin hidden; the first update validates the owner's focus
+                // again, after releasing its looper lock.
+                if (window->Run() < B_OK) delete window;
+                else control->target.SendMessage(updateMessage);
+            } else finish(control, std::nullopt, 0);
+            --s_active;
+            return B_OK;
+        }, "WebKit datalist", B_NORMAL_PRIORITY, data);
+        if (thread < B_OK) { --s_active; delete data; return thread; }
+        auto status = resume_thread(thread);
+        if (status != B_OK) { kill_thread(thread); --s_active; delete data; }
+        return status;
+    }
+
+private:
+    static constexpr uint32 updateMessage = 'dlup', chooseMessage = 'dlch';
+    struct Control {
+        Control(BMessenger view, Completion completion) : view(view), completion(std::move(completion)) { }
+        const BMessenger view;
+        const Completion completion;
+        std::mutex mutex;
+        BMessenger target;
+        std::vector<Item> items;
+        BRect anchor;
+        uint64_t generation { 0 };
+        std::vector<std::pair<Key, uint64_t>> keys;
+        std::atomic<bool> cancelled { false }, finished { false };
+    };
+    static void finish(const std::shared_ptr<Control>& control, std::optional<std::string> value, uint64_t generation)
+    {
+        if (!control->finished.exchange(true))
+            control->completion(control->cancelled ? std::nullopt : std::move(value), generation);
+    }
+    class Row final : public BListItem {
+    public:
+        explicit Row(Item item) : m_item(std::move(item)) { }
+        const std::string& value() const { return m_item.value; }
+        void Update(BView* view, const BFont* font) override
+        {
+            BListItem::Update(view, font);
+            font_height height; font->GetHeight(&height);
+            SetHeight(std::ceil(height.ascent + height.descent + height.leading) + 12);
+        }
+        void DrawItem(BView* view, BRect rect, bool) override
+        {
+            const bool selected = IsSelected();
+            view->SetHighColor(ui_color(selected ? B_LIST_SELECTED_BACKGROUND_COLOR : B_LIST_BACKGROUND_COLOR));
+            view->FillRect(rect);
+            view->SetLowColor(view->HighColor());
+            BFont font; view->GetFont(&font);
+            font_height height; font.GetHeight(&height);
+            const float available = std::max(0.0f, rect.Width() - 16);
+            BString value(m_item.value.c_str()), label(m_item.label.c_str());
+            const bool hasLabel = !label.IsEmpty() && label != value;
+            const float valueWidth = hasLabel ? std::min(font.StringWidth(value.String()), available * .55f) : available;
+            font.TruncateString(&value, B_TRUNCATE_END, valueWidth);
+            view->SetHighColor(ui_color(selected ? B_LIST_SELECTED_ITEM_TEXT_COLOR : B_LIST_ITEM_TEXT_COLOR));
+            const auto baseline = rect.top + (rect.Height() - height.ascent - height.descent) / 2 + height.ascent;
+            view->DrawString(value.String(), BPoint(rect.left + 8, baseline));
+            if (hasLabel) {
+                font.TruncateString(&label, B_TRUNCATE_END, std::max(0.0f, available - valueWidth - 12));
+                if (!selected) view->SetHighColor(tint_color(view->HighColor(), B_LIGHTEN_1_TINT));
+                view->DrawString(label.String(), BPoint(rect.left + 20 + valueWidth, baseline));
+            }
+        }
+    private:
+        Item m_item;
+    };
+    class List final : public BListView {
+    public:
+        explicit List(BRect frame) : BListView(frame, "datalist", B_SINGLE_SELECTION_LIST, B_FOLLOW_ALL, B_WILL_DRAW | B_FRAME_EVENTS) { }
+        ~List() override { clear(); }
+        void clear() { while (auto* item = RemoveItem(int32(0))) delete item; }
+        void MouseDown(BPoint point) override
+        {
+            const auto index = IndexOf(point);
+            if (index >= 0) { Select(index); Invoke(); }
+        }
+    };
+    class Activity {
+    protected:
+        Activity() { ++s_active; }
+        ~Activity() { --s_active; }
+    };
+    class CompletionAfterDestruction {
+    protected:
+        explicit CompletionAfterDestruction(std::shared_ptr<Control> control) : m_control(std::move(control)) { }
+        ~CompletionAfterDestruction() { finish(m_control, std::move(m_value), m_generation); }
+        std::optional<std::string> m_value;
+        uint64_t m_generation { 0 };
+    private:
+        std::shared_ptr<Control> m_control;
+    };
+    class Window final : private Activity, private CompletionAfterDestruction, public BWindow {
+    public:
+        explicit Window(std::shared_ptr<Control> control)
+            : CompletionAfterDestruction(control)
+            , BWindow(BRect(0, 0, 300, 100), "WebKit suggestions", B_NO_BORDER_WINDOW_LOOK, B_FLOATING_SUBSET_WINDOW_FEEL,
+                B_AVOID_FOCUS | B_NOT_MOVABLE | B_NOT_CLOSABLE | B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE | B_NOT_RESIZABLE
+                    | B_WILL_ACCEPT_FIRST_CLICK | B_ASYNCHRONOUS_CONTROLS)
+            , m_control(std::move(control))
+        {
+            m_list = new List(BRect(0, 0, Bounds().Width() - B_V_SCROLL_BAR_WIDTH, Bounds().Height()));
+            AddChild(new BScrollView("datalist-scroll", m_list, B_FOLLOW_ALL, 0, false, true, B_NO_BORDER));
+            m_list->SetInvocationMessage(new BMessage(chooseMessage));
+            m_list->SetTarget(this);
+            BMessage update(updateMessage);
+            m_timer = std::make_unique<BMessageRunner>(BMessenger(this), &update, 100000);
+        }
+        void MessageReceived(BMessage* message) override
+        {
+            if (message->what == updateMessage) {
+                refresh();
+                std::vector<std::pair<Key, uint64_t>> keys;
+                {
+                    std::lock_guard lock(m_control->mutex);
+                    // Keep keys queued until the native list has caught up.
+                    if (m_generation == m_control->generation) keys.swap(m_control->keys);
+                }
+                for (auto [key, generation] : keys)
+                    if (!m_closing && generation == m_generation) handleKey(key);
+                return;
+            }
+            if (message->what == chooseMessage) { choose(); return; }
+            BWindow::MessageReceived(message);
+        }
+    private:
+        void dismiss() { m_closing = true; PostMessage(B_QUIT_REQUESTED); }
+        void handleKey(Key key)
+        {
+            if (key == Key::Escape) { dismiss(); return; }
+            if (key == Key::Enter) { choose(); return; }
+            const int32 count = m_list->CountItems();
+            auto index = m_list->CurrentSelection();
+            if (count && (key == Key::Up || key == Key::Down)) {
+                index = key == Key::Down ? (index + 1) % count : (index <= 0 ? count - 1 : index - 1);
+                m_list->Select(index);
+                m_list->ScrollToSelection();
+            }
+        }
+        void choose()
+        {
+            if (m_closing) return;
+            if (auto* item = static_cast<Row*>(m_list->ItemAt(m_list->CurrentSelection()))) m_value = item->value();
+            dismiss();
+        }
+        void refresh()
+        {
+            if (m_closing) return;
+            if (m_control->cancelled || !m_control->view.IsValid()) { dismiss(); return; }
+            // Never wait for an owner that might be waiting on app_server.
+            if (m_control->view.LockTargetWithTimeout(0) != B_OK) return;
+            BLooper* looper = nullptr;
+            auto* view = dynamic_cast<BView*>(m_control->view.Target(&looper));
+            auto* owner = view ? view->Window() : nullptr;
+            const bool available = owner && owner->IsActive() && !owner->IsHidden() && !owner->IsMinimized() && !view->IsHidden();
+            if (looper) looper->Unlock();
+            if (!available) { dismiss(); return; }
+            BRect anchor;
+            std::vector<Item> items;
+            {
+                std::lock_guard lock(m_control->mutex);
+                if (m_generation == m_control->generation) return;
+                m_generation = m_control->generation;
+                anchor = m_control->anchor;
+                items = m_control->items;
+            }
+            if (items.empty() || !anchor.IsValid() || !std::isfinite(anchor.left) || !std::isfinite(anchor.top)
+                || !std::isfinite(anchor.right) || !std::isfinite(anchor.bottom)) { dismiss(); return; }
+            m_list->clear();
+            for (auto& item : items) m_list->AddItem(new Row(std::move(item)));
+            m_list->ScrollTo(0, 0);
+            const auto screen = BScreen(this).Frame();
+            const float width = std::min(std::max(anchor.Width(), 300.0f), screen.Width());
+            const float height = std::min(m_list->ItemAt(0)->Height() * std::min<size_t>(8, items.size()), screen.Height());
+            const float x = std::clamp(anchor.left, screen.left, screen.right - width);
+            float y = anchor.bottom + 1;
+            if (y + height > screen.bottom) y = anchor.top - height - 1;
+            y = std::clamp(y, screen.top, screen.bottom - height);
+            ResizeTo(width, height);
+            MoveTo(x, y);
+            if (IsHidden()) Show();
+        }
+        const std::shared_ptr<Control> m_control;
+        List* m_list { nullptr };
+        std::unique_ptr<BMessageRunner> m_timer;
+        bool m_closing { false };
+    };
+    const std::shared_ptr<Control> m_control;
+    bool m_started { false };
+    inline static std::atomic<unsigned> s_active { 0 };
+};
+}
diff --git a/Source/WebKit/UIProcess/haiku/NativeDateTimePickerHaiku.h b/Source/WebKit/UIProcess/haiku/NativeDateTimePickerHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..4e2f3c504a1210c1c5ebff4679aa533885aae00b
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeDateTimePickerHaiku.h
@@ -0,0 +1,195 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "DateTimeValueHaiku.h"
+#include <Button.h>
+#include <GroupView.h>
+#include <LayoutBuilder.h>
+#include <MenuField.h>
+#include <MenuItem.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <PopUpMenu.h>
+#include <Screen.h>
+#include <StringView.h>
+#include <TextControl.h>
+#include <TextView.h>
+#include <Window.h>
+#include <private/shared/CalendarView.h>
+#include <atomic>
+#include <cstdio>
+#include <functional>
+#include <memory>
+#include <utility>
+
+namespace WebKit {
+class NativeDateTimePickerHaiku final {
+    using Type = DateTimeValueHaiku::Type;
+    enum : uint32 { changed = 'dtch', selected = 'dtsl', accept = 'dtok', clear = 'dtcl', previous = 'dtpr', next = 'dtnx', suggested = 'dtsg' };
+    struct Control {
+        explicit Control(std::function<void(std::optional<std::string>)>&& callback) : complete(std::move(callback)) { }
+        const std::function<void(std::optional<std::string>)> complete;
+        std::atomic<bool> cancelled { false };
+    };
+    class Window final : public BWindow {
+    public:
+        Window(DateTimeValueHaiku model, BRect anchor, std::shared_ptr<Control> control)
+            : BWindow(BRect(0, 0, 460, 420), "Choose date and time — Summit", B_TITLED_WINDOW,
+                B_ASYNCHRONOUS_CONTROLS | B_AUTO_UPDATE_SIZE_LIMITS | B_NOT_ZOOMABLE | B_CLOSE_ON_ESCAPE)
+            , m_model(std::move(model)), m_control(std::move(control))
+        {
+            m_value = new BTextControl("date-value", "Value:", m_model.current.c_str(), new BMessage(changed));
+            m_value->SetModificationMessage(new BMessage(changed));
+            m_value->TextView()->SetMaxBytes(64);
+            m_value->SetExplicitMinSize(BSize(420, B_SIZE_UNSET));
+            m_error = new BStringView("date-error", "");
+            m_done = new BButton("date-done", "Done", new BMessage(accept));
+            auto layout = BLayoutBuilder::Group<>(this, B_VERTICAL, 10).SetInsets(12);
+            layout.Add(m_value).Add(new BStringView("date-format", m_model.format()));
+            if (m_model.type != Type::Time) {
+                m_calendar = new BPrivate::BCalendarView("date-calendar");
+                m_calendar->SetSelectionMessage(new BMessage(selected));
+                m_calendar->SetInvocationMessage(new BMessage(selected));
+                m_calendar->SetWeekNumberHeaderVisible(m_model.type == Type::Week);
+                m_calendar->SetStartOfWeek(B_WEEKDAY_MONDAY);
+                m_month = new BStringView("date-month", "");
+                layout.AddGroup(B_HORIZONTAL, 8)
+                    .Add(new BButton("date-previous", "‹", new BMessage(previous)))
+                    .Add(m_month, 1)
+                    .Add(new BButton("date-next", "›", new BMessage(next))).End();
+                layout.Add(m_calendar);
+                // BDate uses the historical Julian/Gregorian transition.
+                // Map the display into a Gregorian 400-year cycle so HTML's
+                // proleptic Gregorian dates (including October 1582) work.
+                auto today = BDate::CurrentDate(B_LOCAL_TIME);
+                setCalendar(today.Year(), today.Month(), today.Day());
+            }
+            if (!m_model.suggestions.empty()) {
+                auto* menu = new BPopUpMenu("Suggested values");
+                for (auto& value : m_model.suggestions) {
+                    if (m_model.parse(value)) {
+                        auto* message = new BMessage(suggested);
+                        message->AddString("value", value.c_str());
+                        menu->AddItem(new BMenuItem(value.c_str(), message));
+                    }
+                }
+                layout.Add(new BMenuField("date-suggestions", "Suggestions:", menu));
+            }
+            layout.Add(m_error).AddGroup(B_HORIZONTAL, 8)
+                .Add(new BButton("date-clear", "Clear", new BMessage(clear)))
+                .AddGlue().Add(new BButton("date-cancel", "Cancel", new BMessage(B_QUIT_REQUESTED))).Add(m_done).End();
+            updateFromText();
+            SetDefaultButton(m_done);
+            m_value->MakeFocus();
+            Layout(true);
+            auto screen = BScreen().Frame();
+            MoveTo(std::clamp(anchor.left, screen.left, std::max(screen.left, screen.right - Bounds().Width())),
+                std::clamp(anchor.bottom + 8, screen.top + 24, std::max(screen.top + 24, screen.bottom - Bounds().Height())));
+        }
+        bool QuitRequested() override { finish(std::nullopt); return true; }
+        void MessageReceived(BMessage* message) override
+        {
+            switch (message->what) {
+            case changed: updateFromText(); return;
+            case selected: updateFromCalendar(); return;
+            case previous:
+            case next: {
+                if (!m_calendar) return;
+                auto date = m_calendar->Date(); date.AddMonths(message->what == previous ? -1 : 1);
+                m_calendar->SetDate(date); updateFromCalendar(); return;
+            }
+            case suggested:
+                m_value->SetText(message->GetString("value", "")); updateFromText(); return;
+            case clear:
+                finish(std::string()); PostMessage(B_QUIT_REQUESTED); return;
+            case accept: {
+                std::string value = m_value->Text();
+                if (!m_model.error(value).empty()) { updateFromText(); return; }
+                if (auto parsed = m_model.parse(value)) value = DateTimeValueHaiku::text(*parsed);
+                finish(std::move(value)); PostMessage(B_QUIT_REQUESTED); return;
+            }
+            default: BWindow::MessageReceived(message);
+            }
+        }
+    private:
+        void setCalendar(int year, int month, int day)
+        {
+            if (!m_calendar || year < 1 || year > 275760) return;
+            const int displayYear = 2000 + year % 400;
+            m_yearOffset = year - displayYear;
+            m_calendar->SetDate(displayYear, month, day);
+            BString caption = BDate::LongMonthName(month);
+            caption << " " << year;
+            m_month->SetText(caption);
+        }
+        void updateFromText()
+        {
+            const std::string value = m_value->Text();
+            auto error = m_model.error(value);
+            m_error->SetText(error.c_str());
+            m_done->SetEnabled(error.empty());
+            if (!m_calendar) return;
+            auto date = m_model.parse(value);
+            if (!date) return;
+            if (m_model.type == Type::Week)
+                date = WebCore::DateComponents::fromMillisecondsSinceEpochForDate(date->millisecondsSinceEpoch());
+            if (date) setCalendar(date->fullYear(), date->month() + 1, m_model.type == Type::Month ? 1 : date->monthDay());
+        }
+        void updateFromCalendar()
+        {
+            if (!m_calendar) return;
+            const int year = m_calendar->Year() + m_yearOffset;
+            char buffer[64];
+            std::snprintf(buffer, sizeof(buffer), "%04d-%02d-%02d", year, int(m_calendar->Month()), int(m_calendar->Day()));
+            std::string value(buffer);
+            if (m_model.type == Type::Month)
+                value.resize(value.size() - 3);
+            else if (m_model.type == Type::Week) {
+                if (auto day = WebCore::DateComponents::fromParsingDate(String::fromUTF8(value))) {
+                    if (auto week = WebCore::DateComponents::fromMillisecondsSinceEpochForWeek(day->millisecondsSinceEpoch()))
+                        value = DateTimeValueHaiku::text(*week);
+                }
+            } else if (m_model.type == Type::DateTimeLocal) {
+                std::string time = "00:00";
+                if (auto current = m_model.parse(m_value->Text())) {
+                    if (auto parsedTime = WebCore::DateComponents::fromMillisecondsSinceMidnight(
+                        current->hour() * 3600000.0 + current->minute() * 60000.0 + current->second() * 1000.0 + current->millisecond()))
+                        time = DateTimeValueHaiku::text(*parsedTime);
+                }
+                value += "T" + time;
+            }
+            m_value->SetText(value.c_str());
+            updateFromText();
+        }
+        void finish(std::optional<std::string> value)
+        {
+            if (std::exchange(m_finished, true) || m_control->cancelled) return;
+            m_control->complete(std::move(value));
+        }
+        const DateTimeValueHaiku m_model;
+        const std::shared_ptr<Control> m_control;
+        BTextControl* m_value { nullptr };
+        BStringView* m_error { nullptr };
+        BStringView* m_month { nullptr };
+        BPrivate::BCalendarView* m_calendar { nullptr };
+        BButton* m_done { nullptr };
+        int m_yearOffset { 0 };
+        bool m_finished { false };
+    };
+public:
+    NativeDateTimePickerHaiku(DateTimeValueHaiku model, BRect anchor, std::function<void(std::optional<std::string>)>&& completion)
+        : m_control(std::make_shared<Control>(std::move(completion)))
+    {
+        auto* window = new Window(std::move(model), anchor, m_control);
+        m_window = BMessenger(window); window->Show();
+    }
+    ~NativeDateTimePickerHaiku()
+    {
+        m_control->cancelled = true;
+        BMessage message(B_QUIT_REQUESTED);
+        m_window.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+private:
+    const std::shared_ptr<Control> m_control;
+    BMessenger m_window;
+};
+}
diff --git a/Source/WebKit/UIProcess/haiku/NativeExtensionPopupHaiku.h b/Source/WebKit/UIProcess/haiku/NativeExtensionPopupHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..9fa4b7ac5416aa7f51b2aa0b770fde7890a4afe0
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeExtensionPopupHaiku.h
@@ -0,0 +1,296 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <Application.h>
+#include <MessageRunner.h>
+#include <Messenger.h>
+#include <Screen.h>
+#include <View.h>
+#include <Window.h>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace WebKit {
+
+// Owns only native objects. Native workers never inspect WebKit references;
+// their bridge callbacks must submit engine work to its owning run loop.
+class NativeExtensionPopupHaiku final {
+public:
+    enum class Event { Created, Shown, Closed };
+    using Notification = std::function<void(Event, status_t)>;
+    using ViewFactory = std::function<BView*(BRect)>;
+
+    NativeExtensionPopupHaiku(BMessenger owner, BRect anchor, std::string title, ViewFactory factory, Notification notification, std::function<bool()> hasModalChild = { })
+        : m_control(std::make_shared<Control>(owner, anchor, std::move(title), std::move(factory), std::move(notification), std::move(hasModalChild))) { }
+    ~NativeExtensionPopupHaiku() { cancel(); }
+    static uint32_t activeCount() { return s_active.load(); }
+
+    status_t start()
+    {
+        if (std::exchange(m_started, true))
+            return B_NOT_ALLOWED;
+        auto anchor = m_control->anchor;
+        if (!m_control->factory || !m_control->notification || !anchor.IsValid()
+            || !std::isfinite(anchor.left) || !std::isfinite(anchor.top) || !std::isfinite(anchor.right) || !std::isfinite(anchor.bottom))
+            return B_BAD_VALUE;
+        auto* data = new std::shared_ptr<Control>(m_control);
+        ++s_active;
+        auto thread = spawn_thread([](void* pointer) -> int32 {
+            std::unique_ptr<std::shared_ptr<Control>> data(static_cast<std::shared_ptr<Control>*>(pointer));
+            auto control = *data;
+            status_t status = B_TIMED_OUT;
+            const auto deadline = system_time() + 2000000;
+            while (!control->cancelled && system_time() < deadline) {
+                status = control->owner.LockTargetWithTimeout(50000);
+                if (status == B_OK)
+                    break;
+                if (status != B_TIMED_OUT && status != B_WOULD_BLOCK)
+                    break;
+            }
+            if (control->cancelled) {
+                if (status == B_OK) {
+                    BLooper* looper = nullptr;
+                    control->owner.Target(&looper);
+                    if (looper)
+                        looper->Unlock();
+                }
+                finish(control, B_CANCELED);
+            } else if (status != B_OK)
+                finish(control, status);
+            else {
+                BLooper* looper = nullptr;
+                auto* owner = dynamic_cast<BWindow*>(control->owner.Target(&looper));
+                if (!owner || owner != looper || owner->IsHidden() || owner->IsMinimized()) {
+                    if (looper)
+                        looper->Unlock();
+                    finish(control, B_BAD_VALUE);
+                } else {
+                    auto* window = new Window(control);
+                    status = window->AddToSubset(owner);
+                    looper->Unlock();
+                    if (status == B_OK && !control->cancelled && window->hasContent()) {
+                        {
+                            std::lock_guard guard(control->mutex);
+                            control->target = BMessenger(window);
+                        }
+                        control->notification(Event::Created, B_OK);
+                        if (window->Run() < B_OK) {
+                            control->closeStatus = B_ERROR;
+                            delete window;
+                        }
+                        // Run transferred window lifetime to its native looper.
+                    } else {
+                        control->closeStatus = status != B_OK ? status : (control->cancelled ? B_CANCELED : B_NO_INIT);
+                        delete window;
+                    }
+                }
+            }
+            --s_active;
+            return B_OK;
+        }, "WebKit extension popup", B_NORMAL_PRIORITY, data);
+        if (thread < B_OK) {
+            --s_active;
+            delete data;
+            return thread;
+        }
+        auto status = resume_thread(thread);
+        if (status != B_OK) {
+            kill_thread(thread);
+            --s_active;
+            delete data;
+        }
+        return status;
+    }
+
+    void show(bool requireFocusedOwner = false)
+    {
+        m_control->requireFocusedOwner = requireFocusedOwner;
+        m_control->showRequested = true;
+        wake();
+    }
+    void cancel() { m_control->cancelled = true; wake(); }
+    void resize(BSize size)
+    {
+        if (!std::isfinite(size.width) || !std::isfinite(size.height) || size.width <= 0 || size.height <= 0)
+            return;
+        {
+            std::lock_guard guard(m_control->mutex);
+            m_control->size = size;
+            ++m_control->sizeGeneration;
+        }
+        wake();
+    }
+    BMessenger target() const
+    {
+        std::lock_guard guard(m_control->mutex);
+        return m_control->target;
+    }
+
+    static BRect frameForSize(BRect anchor, BSize size, BRect screen)
+    {
+        auto maximumWidth = std::max(1.0f, std::min(800.0f, screen.Width() - 16));
+        auto maximumHeight = std::max(1.0f, std::min(600.0f, screen.Height() - 16));
+        auto width = std::clamp(std::isfinite(size.width) ? std::ceil(size.width) : 360.0f, std::min(25.0f, maximumWidth), maximumWidth);
+        auto height = std::clamp(std::isfinite(size.height) ? std::ceil(size.height) : 240.0f, std::min(25.0f, maximumHeight), maximumHeight);
+        auto x = anchor.right - width + 1;
+        auto y = anchor.bottom + 1;
+        if (y + height > screen.bottom && anchor.top - height >= screen.top)
+            y = anchor.top - height;
+        x = std::clamp(x, screen.left, std::max(screen.left, screen.right - width + 1));
+        y = std::clamp(y, screen.top, std::max(screen.top, screen.bottom - height + 1));
+        return { x, y, x + width - 1, y + height - 1 };
+    }
+
+private:
+    static constexpr uint32 updateMessage = 'expu';
+    struct Control {
+        Control(BMessenger owner, BRect anchor, std::string title, ViewFactory factory, Notification notification, std::function<bool()> hasModalChild)
+            : owner(owner), anchor(anchor), title(std::move(title)), factory(std::move(factory)), notification(std::move(notification)), hasModalChild(std::move(hasModalChild)) { }
+        const BMessenger owner;
+        const BRect anchor;
+        const std::string title;
+        const ViewFactory factory;
+        const Notification notification;
+        const std::function<bool()> hasModalChild;
+        std::mutex mutex;
+        BMessenger target;
+        BSize size { 360, 240 };
+        uint64_t sizeGeneration { 1 };
+        std::atomic<bool> cancelled { false };
+        std::atomic<bool> showRequested { false };
+        std::atomic<bool> requireFocusedOwner { false };
+        std::atomic<bool> finished { false };
+        std::atomic<status_t> closeStatus { B_OK };
+    };
+    static void finish(const std::shared_ptr<Control>& control, status_t status)
+    {
+        if (!control->finished.exchange(true))
+            control->notification(Event::Closed, status);
+    }
+    void wake()
+    {
+        BMessage message(updateMessage);
+        target().SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+        // The periodic native update also observes state if the port is full.
+    }
+    class Activity {
+    protected:
+        Activity() { ++s_active; }
+        ~Activity() { --s_active; }
+    };
+    class CompletionAfterDestruction {
+    protected:
+        explicit CompletionAfterDestruction(std::shared_ptr<Control> control) : m_control(std::move(control)) { }
+        ~CompletionAfterDestruction() { finish(m_control, m_control->closeStatus); }
+    private:
+        std::shared_ptr<Control> m_control;
+    };
+    // Complete after the native window and all child views have been destroyed;
+    // keep activity nonzero until the completion has been submitted.
+    class Window final : private Activity, private CompletionAfterDestruction, public BWindow {
+    public:
+        explicit Window(std::shared_ptr<Control> control)
+            : CompletionAfterDestruction(control)
+            , BWindow(frameForSize(control->anchor, BSize(360, 240), BScreen().Frame()), control->title.c_str(), B_BORDERED_WINDOW_LOOK, B_FLOATING_SUBSET_WINDOW_FEEL,
+                B_ASYNCHRONOUS_CONTROLS | B_NOT_RESIZABLE | B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE | B_NOT_MOVABLE | B_CLOSE_ON_ESCAPE)
+            , m_control(std::move(control))
+        {
+            if (!m_control->cancelled) {
+                m_content = m_control->factory(Bounds());
+                if (m_content) {
+                    AddChild(m_content);
+                    m_content->MakeFocus();
+                }
+            }
+            BMessage update(updateMessage);
+            m_update = std::make_unique<BMessageRunner>(BMessenger(this), &update, 100000);
+        }
+        bool hasContent() const { return m_content && m_content->Window() == this && m_update->InitCheck() == B_OK; }
+        bool QuitRequested() override { m_control->cancelled = true; return true; }
+        void WindowActivated(bool active) override
+        {
+            BWindow::WindowActivated(active);
+            if (active) {
+                m_activated = true;
+                m_deactivatedAt = 0;
+            } else if (m_activated)
+                m_deactivatedAt = system_time();
+        }
+        void MessageReceived(BMessage* message) override
+        {
+            if (message->what != updateMessage) {
+                BWindow::MessageReceived(message);
+                return;
+            }
+            bool ownerAvailable = m_control->owner.IsValid();
+            if (ownerAvailable && m_control->owner.LockTargetWithTimeout(0) == B_OK) {
+                BLooper* looper = nullptr;
+                auto* owner = dynamic_cast<BWindow*>(m_control->owner.Target(&looper));
+                ownerAvailable = owner && !owner->IsHidden() && !owner->IsMinimized();
+                if (looper)
+                    looper->Unlock();
+            }
+            bool lostFocus = m_deactivatedAt && system_time() - m_deactivatedAt >= 100000
+                && !(m_control->hasModalChild && m_control->hasModalChild());
+            if (m_control->cancelled || !ownerAvailable || lostFocus) {
+                PostMessage(B_QUIT_REQUESTED);
+                return;
+            }
+            BSize size;
+            uint64_t generation;
+            {
+                std::lock_guard guard(m_control->mutex);
+                size = m_control->size;
+                generation = m_control->sizeGeneration;
+            }
+            if (generation != m_sizeGeneration) {
+                m_sizeGeneration = generation;
+                auto rect = frameForSize(m_control->anchor, size, BScreen(this).Frame());
+                ResizeTo(rect.Width(), rect.Height());
+                MoveTo(rect.LeftTop());
+            }
+            if (!m_shown && m_control->showRequested) {
+                // A programmatic request can outlive its owner's focus while
+                // waiting for this native looper. Check at presentation time;
+                // a busy owner is retried by the periodic update.
+                if (m_control->requireFocusedOwner) {
+                    if (m_control->owner.LockTargetWithTimeout(0) != B_OK)
+                        return;
+                    BLooper* looper = nullptr;
+                    auto* owner = dynamic_cast<BWindow*>(m_control->owner.Target(&looper));
+                    bool focused = owner && owner->IsActive() && !owner->IsHidden() && !owner->IsMinimized();
+                    if (looper)
+                        looper->Unlock();
+                    if (!focused) {
+                        m_control->cancelled = true;
+                        m_control->closeStatus = B_CANCELED;
+                        PostMessage(B_QUIT_REQUESTED);
+                        return;
+                    }
+                }
+                m_shown = true;
+                Show();
+                Activate(true);
+                m_content->MakeFocus();
+                m_control->notification(Event::Shown, B_OK);
+            }
+        }
+    private:
+        const std::shared_ptr<Control> m_control;
+        std::unique_ptr<BMessageRunner> m_update;
+        BView* m_content { nullptr };
+        uint64_t m_sizeGeneration { 0 };
+        bigtime_t m_deactivatedAt { 0 };
+        bool m_shown { false };
+        bool m_activated { false };
+    };
+    const std::shared_ptr<Control> m_control;
+    bool m_started { false };
+    static inline std::atomic<uint32_t> s_active { 0 };
+};
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h b/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..3b6bd0d9d011c797c2a2e6deb3e2bbbd4eec80ce
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/NativeSelectPopupHaiku.h
@@ -0,0 +1,233 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include <Application.h>
+#include <MenuItem.h>
+#include <Message.h>
+#include <Messenger.h>
+#include <OS.h>
+#include <PopUpMenu.h>
+#include <Screen.h>
+#include <algorithm>
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace WebKit {
+
+// This class owns only native data. Menu tracking and destruction take place
+// on its worker; cancel never waits for that worker or touches a raw BMenu.
+class NativeSelectPopupHaiku final {
+public:
+    struct Item {
+        std::string label;
+        bool enabled { true };
+        bool groupLabel { false };
+        bool separator { false };
+    };
+
+    NativeSelectPopupHaiku(std::vector<Item>&& items, BRect anchor, bool rightToLeft, int32 selectedIndex, std::function<void(int32)>&& completion)
+        : m_control(std::make_shared<Control>(std::move(items), anchor, rightToLeft, selectedIndex, std::move(completion))) { }
+
+    ~NativeSelectPopupHaiku() { cancel(); }
+
+    static size_t activeCount() { return s_activeCount.load(); }
+
+    status_t start()
+    {
+        if (m_started)
+            return B_NOT_ALLOWED;
+        m_started = true;
+        auto* owner = new std::shared_ptr<Control>(m_control);
+        ++s_activeCount;
+        thread_id thread = spawn_thread([](void* data) -> int32 {
+            std::unique_ptr<std::shared_ptr<Control>> owner(static_cast<std::shared_ptr<Control>*>(data));
+            auto control = *owner;
+            int32 index = -1;
+            if (!control->cancelled && !control->items.empty()) {
+                auto menu = std::make_unique<Menu>(control);
+                if (menu->populate()) {
+                    BPoint location = menu->location();
+                    // BPopUpMenu's async Go has no completion or failure result.
+                    // Its synchronous result is safe here, off the WebKit loop,
+                    // and covers selection, Escape, outside click and failure.
+                    BMenuItem* chosen = menu->Go(location, false, true, control->anchor, false);
+                    if (chosen && !control->cancelled)
+                        index = menu->IndexOf(chosen);
+                }
+                // Go has joined its own tracking thread. Destroy the native
+                // menu before posting the completion to the application.
+                menu.reset();
+            }
+            if (control->cancelled)
+                index = -1;
+            control->completion(index);
+            --s_activeCount;
+            return B_OK;
+        }, "WebKit select popup", B_NORMAL_PRIORITY, owner);
+        if (thread < B_OK) {
+            --s_activeCount;
+            delete owner;
+            return thread;
+        }
+        status_t status = resume_thread(thread);
+        if (status != B_OK) {
+            kill_thread(thread);
+            --s_activeCount;
+            delete owner;
+        }
+        return status;
+    }
+
+    void cancel()
+    {
+        m_control->cancelled = true;
+        sendEscape(target());
+    }
+
+    BMessenger target() const
+    {
+        std::lock_guard lock(m_control->mutex);
+        return m_control->target;
+    }
+
+private:
+    struct Control {
+        Control(std::vector<Item>&& items, BRect anchor, bool rightToLeft, int32 selectedIndex, std::function<void(int32)>&& completion)
+            : items(std::move(items)), anchor(anchor), rightToLeft(rightToLeft), selectedIndex(selectedIndex), completion(std::move(completion)) { }
+        const std::vector<Item> items;
+        const BRect anchor;
+        const bool rightToLeft;
+        const int32 selectedIndex;
+        const std::function<void(int32)> completion;
+        std::atomic<bool> cancelled { false };
+        std::mutex mutex;
+        BMessenger target;
+    };
+
+    static void sendEscape(BMessenger target)
+    {
+        if (!target.IsValid())
+            return;
+        BMessage message(B_KEY_DOWN);
+        const char escape[] = { B_ESCAPE, 0 };
+        message.AddString("bytes", escape);
+        target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+
+    class Menu final : public BPopUpMenu {
+        class Option final : public BMenuItem {
+        public:
+            explicit Option(const char* label) : BMenuItem(label, nullptr) { }
+            bool isHighlighted() const { return IsSelected(); }
+        };
+
+    public:
+        explicit Menu(std::shared_ptr<Control> control)
+            : BPopUpMenu("WebKit select", true, false), m_control(std::move(control))
+        {
+            SetTriggersEnabled(false);
+            SetTrackingHook([](BMenu*, void* state) {
+                return static_cast<Control*>(state)->cancelled.load();
+            }, m_control.get());
+        }
+
+        bool populate()
+        {
+            for (size_t i = 0; i < m_control->items.size(); ++i) {
+                const auto& source = m_control->items[i];
+                if (source.separator) {
+                    if (!AddSeparatorItem())
+                        return false;
+                    continue;
+                }
+                auto item = std::make_unique<Option>(source.label.c_str());
+                item->SetEnabled(source.enabled && !source.groupLabel);
+                item->SetMarked(static_cast<int32>(i) == m_control->selectedIndex);
+                if (!AddItem(item.get()))
+                    return false;
+                item.release();
+            }
+            return true;
+        }
+
+        BPoint location()
+        {
+            BRect screen = BScreen().Frame();
+            SetMaxContentWidth(std::max(1.0f, screen.Width() - 40));
+            SetExplicitMinSize(BSize(std::clamp(m_control->anchor.Width(), 1.0f, std::max(1.0f, screen.Width() - 2)), B_SIZE_UNSET));
+            DoLayout();
+            BPoint point = m_control->anchor.LeftTop();
+            if (m_control->rightToLeft)
+                point.x = m_control->anchor.right - Bounds().Width();
+            if (auto* marked = ItemAt(m_control->selectedIndex))
+                point.y -= marked->Frame().top;
+            point.x = std::clamp(point.x, screen.left, std::max(screen.left, screen.right - Bounds().Width()));
+            // Oversized menus keep their full content height. BMenu provides
+            // native screen clipping, scroll arrows and marked-item scrolling.
+            point.y = std::clamp(point.y, screen.top, std::max(screen.top, screen.bottom - Bounds().Height()));
+            return point;
+        }
+
+        void AttachedToWindow() override
+        {
+            BPopUpMenu::AttachedToWindow();
+            BMessenger messenger(this);
+            {
+                std::lock_guard lock(m_control->mutex);
+                m_control->target = messenger;
+            }
+            if (m_control->cancelled)
+                sendEscape(messenger);
+        }
+
+        void KeyDown(const char* bytes, int32 count) override
+        {
+            if (count <= 0)
+                return;
+            bool highlighted = false;
+            for (int32 i = 0; i < CountItems(); ++i) {
+                if (auto* option = dynamic_cast<Option*>(ItemAt(i)); option && option->isHighlighted()) {
+                    highlighted = true;
+                    break;
+                }
+            }
+            // BMenu deselects highlighted items when the pointer is outside
+            // the menu. Begin keyboard navigation from the current value,
+            // using native navigation to skip groups, disabled rows and rules.
+            auto* selected = ItemAt(m_control->selectedIndex);
+            if (!highlighted && selected && selected->IsEnabled()
+                && (bytes[0] == B_UP_ARROW || bytes[0] == B_DOWN_ARROW || bytes[0] == B_ENTER || bytes[0] == B_SPACE)) {
+                const char down = B_DOWN_ARROW;
+                for (int32 i = 0; i <= m_control->selectedIndex; ++i) {
+                    if (ItemAt(i)->IsEnabled())
+                        BPopUpMenu::KeyDown(&down, 1);
+                }
+            }
+            BPopUpMenu::KeyDown(bytes, count);
+        }
+
+        void DetachedFromWindow() override
+        {
+            {
+                std::lock_guard lock(m_control->mutex);
+                m_control->target = { };
+            }
+            BPopUpMenu::DetachedFromWindow();
+        }
+
+    private:
+        const std::shared_ptr<Control> m_control;
+    };
+
+    const std::shared_ptr<Control> m_control;
+    bool m_started { false };
+    inline static std::atomic<size_t> s_activeCount { 0 };
+};
+
+} // namespace WebKit
