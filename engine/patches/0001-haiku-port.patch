+#include <bluetooth/L2CAP/btL2CAP.h>
+#ifndef B_L2CAP_LE_ATT_CID
+// The ATT channel of an LE link (air/OS btL2CAP.h). A stock Haiku stack has
+// no LE links: its bluetooth_server does not know the LE scan and connection
+// requests below, which fail before a socket is opened.
+#define B_L2CAP_LE_ATT_CID 0x0004
+#endif
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <mutex>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace WebKit::BluetoothHaiku {
+namespace {
+bool testing()
+{
+    const char* backend = std::getenv("SUMMIT_BLUETOOTH_TEST_BACKEND");
+    const char* input = std::getenv("SUMMIT_ENABLE_INPUT_SYNTHESIS");
+    return backend && !std::strcmp(backend, "1") && input && !std::strcmp(input, "1");
+}
+// air/OS bluetooth_server's listener-scoped LE protocol. No force operations.
+constexpr const char* serverSignature = "application/x-vnd.Haiku-bluetooth_server";
+constexpr uint32_t code(const char* s) { return uint32_t(s[0]) << 24 | uint32_t(s[1]) << 16 | uint32_t(s[2]) << 8 | uint32_t(s[3]); }
+constexpr uint32_t countAdapters = code("btCd"), acquireAdapter = code("btAd");
+constexpr uint32_t scanStart = code("leSS"), scanStop = code("leST"), advertisement = code("leAD");
+constexpr uint32_t linkConnect = code("leCN"), linkCancel = code("leCC"), linkDisconnect = code("leDC");
+constexpr uint32_t linkConnected = code("leCD"), linkFailed = code("leCF"), linkDisconnected = code("leDD");
+constexpr bigtime_t messageTimeout = 1000000;
+
+status_t request(BMessage& message, BMessage& reply)
+{
+    BMessenger server(serverSignature);
+    if (!server.IsValid()) return B_NO_INIT;
+    auto status = server.SendMessage(&message, &reply, messageTimeout, messageTimeout);
+    return status == B_OK ? reply.GetInt32("status", B_ERROR) : status;
+}
+status_t scopedRequest(uint32_t what, int32_t adapter, const BMessenger& listener)
+{
+    BMessage message(what), reply;
+    message.AddInt32("hci_id", adapter);
+    message.AddMessenger("listener", listener);
+    return request(message, reply);
+}
+std::vector<int32_t> adapters()
+{
+    BMessage count(countAdapters), reply;
+    if (request(count, reply) != B_OK) return { };
+    int32_t total = std::clamp(reply.GetInt32("count", 0), 0, 16);
+    std::vector<int32_t> result;
+    for (int32_t i = 0; i < total; ++i) {
+        BMessage acquire(acquireAdapter), response;
+        if (request(acquire, response) != B_OK) continue;
+        int32_t id = response.GetInt32("hci_id", -1);
+        if (id >= 0 && std::find(result.begin(), result.end(), id) == result.end()) result.push_back(id);
+    }
+    return result;
+}
+struct Notices {
+    std::mutex mutex;
+    std::vector<Device> devices;
+    std::atomic<uint32_t> link { 0 };
+};
+class Listener final : public BLooper {
+public:
+    explicit Listener(std::shared_ptr<Notices> notices) : BLooper("Summit Bluetooth"), m_notices(std::move(notices)) { }
+    void MessageReceived(BMessage* message) override
+    {
+        switch (message->what) {
+        case linkConnected: case linkFailed: case linkDisconnected:
+            m_notices->link = message->what;
+            return;
+        case advertisement: {
+            const void* address = nullptr;
+            const void* data = nullptr;
+            ssize_t addressSize = 0, dataSize = 0;
+            uint8_t type = 0, event = 0;
+            int8_t rssi = -127;
+            int32_t adapter = -1;
+            if (message->FindData("address", B_RAW_TYPE, &address, &addressSize) != B_OK || addressSize != 6
+                || message->FindData("data", B_RAW_TYPE, &data, &dataSize) != B_OK || dataSize < 0 || dataSize > 1650
+                || message->FindUInt8("address_type", &type) != B_OK || type > 1
+                || message->FindInt32("hci_id", &adapter) != B_OK || adapter < 0) return;
+            message->FindUInt8("event_type", &event);
+            message->FindInt8("rssi", &rssi);
+            Device incoming;
+            std::memcpy(incoming.address.data(), address, 6);
+            incoming.addressType = type;
+            incoming.adapter = adapter;
+            std::lock_guard lock(m_notices->mutex);
+            auto it = std::find_if(m_notices->devices.begin(), m_notices->devices.end(), [&](auto& device) {
+                return device.samePeer(incoming) && device.adapter == adapter;
+            });
+            if (it == m_notices->devices.end()) {
+                if (m_notices->devices.size() >= 256) return;
+                m_notices->devices.push_back(incoming);
+                it = m_notices->devices.end() - 1;
+            }
+            it->advertisement.rssi = rssi;
+            it->advertisement.connectable |= event == 0 || event == 1;
+            it->advertisement.append({ static_cast<const uint8_t*>(data), size_t(dataSize) });
+            return;
+        }
+        default: BLooper::MessageReceived(message);
+        }
+    }
+private:
+    std::shared_ptr<Notices> m_notices;
+};
+class ScopedListener {
+public:
+    ScopedListener() : notices(std::make_shared<Notices>()), m_listener(new Listener(notices))
+    {
+        if (m_listener->Run() < 0) { delete m_listener; m_listener = nullptr; }
+        else messenger = BMessenger(m_listener);
+    }
+    ~ScopedListener() { if (m_listener && m_listener->Lock()) m_listener->Quit(); }
+    std::shared_ptr<Notices> notices;
+    BMessenger messenger;
+private:
+    Listener* m_listener;
+};
+}
+
+bool available()
+{
+    if (testing()) return true;
+    BMessage message(countAdapters), reply;
+    return request(message, reply) == B_OK && reply.GetInt32("count", 0) > 0;
+}
+
+NativeError scan(std::vector<Device>& result, const std::atomic<bool>& cancelled, unsigned milliseconds)
+{
+    result.clear();
+    if (cancelled) return NativeError::Aborted;
+    if (testing()) {
+        for (int index = 0; index < 2; ++index) {
+            Device device; device.adapter = -31 - index; device.address[0] = uint8_t(index + 1); device.addressType = 1;
+            device.advertisement.connectable = true;
+            device.advertisement.name = index ? "Summit Test Busy Peripheral" : "Summit Test Peripheral";
+            device.advertisement.services.insert(UUID::alias(0x180f));
+            result.push_back(std::move(device));
+        }
+        return NativeError::None;
+    }
+    ScopedListener listener;
+    if (!listener.messenger.IsValid()) return NativeError::Unavailable;
+    std::vector<int32_t> scanning;
+    for (auto adapter : adapters()) {
+        if (cancelled) break;
+        // Keep every attempted adapter, including a timed-out acknowledgement:
+        // the server may have registered this listener before its reply expired.
+        scanning.push_back(adapter);
+        scopedRequest(scanStart, adapter, listener.messenger);
+    }
+    auto deadline = system_time() + bigtime_t(std::min(milliseconds, 15000u)) * 1000;
+    while (!scanning.empty() && !cancelled && system_time() < deadline) snooze(50000);
+    for (auto adapter : scanning) scopedRequest(scanStop, adapter, listener.messenger);
+    if (cancelled) return NativeError::Aborted;
+    if (scanning.empty()) return NativeError::Unavailable;
+    {
+        std::lock_guard lock(listener.notices->mutex);
+        result = std::move(listener.notices->devices);
+    }
+    std::stable_sort(result.begin(), result.end(), [](auto& a, auto& b) { return a.advertisement.rssi > b.advertisement.rssi; });
+    // A peer seen by several adapters needs just one chooser entry.
+    for (size_t i = 0; i < result.size(); ++i) {
+        auto first = result.begin() + i + 1;
+        result.erase(std::remove_if(first, result.end(), [&](auto& device) { return device.samePeer(result[i]); }), result.end());
+    }
+    return NativeError::None;
+}
+
+struct Session::State { ScopedListener listener; bool attempted { false }; };
+Session::Session(Device device) : m_device(std::move(device)), m_client(*this) { }
+Session::~Session() { disconnect(); }
+bool Session::connected() const
+{
+    return m_connected && !m_aborted;
+}
+NativeError Session::connect()
+{
+    if (m_aborted) return NativeError::Aborted;
+    if (m_state || m_testTransport) return NativeError::Busy;
+    if (testing() && (m_device.adapter == -31 || m_device.adapter == -32)) {
+        if (m_device.adapter == -32) return NativeError::Busy;
+        m_testTransport = std::make_unique<TestTransport>(); m_connected = true; return NativeError::None;
+    }
+    m_state = std::make_unique<State>();
+    if (!m_state->listener.messenger.IsValid()) { disconnect(); return NativeError::Unavailable; }
+    BMessage message(linkConnect), reply;
+    message.AddInt32("hci_id", m_device.adapter);
+    message.AddMessenger("listener", m_state->listener.messenger);
+    message.AddData("address", B_RAW_TYPE, m_device.address.data(), 6);
+    message.AddUInt8("address_type", m_device.addressType);
+    m_state->attempted = true;
+    auto status = request(message, reply);
+    if (status != B_OK) {
+        int32_t refusal = B_OK;
+        if (reply.FindInt32("status", &refusal) == B_OK && refusal != B_OK) m_state->attempted = false;
+        disconnect();
+        return status == B_BUSY ? NativeError::Busy : NativeError::Network;
+    }
+    auto deadline = system_time() + 20000000;
+    while (!m_aborted && !m_state->listener.notices->link && system_time() < deadline) snooze(50000);
+    if (m_aborted || m_state->listener.notices->link != linkConnected) {
+        auto error = m_aborted ? NativeError::Aborted : (!m_state->listener.notices->link ? NativeError::Timeout : NativeError::Network);
+        disconnect();
+        return error;
+    }
+    m_socket = socket(AF_BLUETOOTH, SOCK_SEQPACKET, BLUETOOTH_PROTO_L2CAP);
+    if (m_socket < 0 || fcntl(m_socket, F_SETFL, O_NONBLOCK) < 0) { disconnect(); return NativeError::Network; }
+    sockaddr_l2cap peer { };
+    peer.l2cap_len = sizeof(peer);
+    peer.l2cap_family = AF_BLUETOOTH;
+    peer.l2cap_psm = B_L2CAP_LE_ATT_CID;
+    std::memcpy(peer.l2cap_bdaddr.b, m_device.address.data(), 6);
+    if (::connect(m_socket, reinterpret_cast<const sockaddr*>(&peer), sizeof(peer)) < 0) {
+        if (errno != EINPROGRESS && errno != EWOULDBLOCK) { disconnect(); return NativeError::Network; }
+        deadline = system_time() + 5000000;
+        bool ready = false;
+        while (!m_aborted && system_time() < deadline) {
+            pollfd descriptor { m_socket, POLLOUT, 0 };
+            int polled = poll(&descriptor, 1, 100);
+            if (polled < 0 && errno == EINTR) continue;
+            if (polled < 0) break;
+            if (polled > 0) {
+                int error = 0;
+                socklen_t size = sizeof(error);
+                ready = getsockopt(m_socket, SOL_SOCKET, SO_ERROR, &error, &size) == 0 && !error && !(descriptor.revents & (POLLERR | POLLHUP | POLLNVAL));
+                break;
+            }
+        }
+        if (!ready) { disconnect(); return m_aborted ? NativeError::Aborted : NativeError::Network; }
+    }
+    m_connected = true;
+    return NativeError::None;
+}
+
+void Session::disconnect()
+{
+    m_connected = false;
+    m_testTransport.reset();
+    if (m_socket >= 0) { close(m_socket); m_socket = -1; }
+    if (!m_state) return;
+    if (m_state->attempted) {
+        auto& listener = m_state->listener;
+        scopedRequest(linkCancel, m_device.adapter, listener.messenger);
+        scopedRequest(linkDisconnect, m_device.adapter, listener.messenger);
+        // A cancellation may race with connection completion. Retain ownership
+        // until the terminal notice, and disconnect a just-completed own link.
+        auto deadline = system_time() + 1500000;
+        while (system_time() < deadline) {
+            auto state = listener.notices->link.load();
+            if (state == linkFailed || state == linkDisconnected) break;
+            if (state == linkConnected) scopedRequest(linkDisconnect, m_device.adapter, listener.messenger);
+            snooze(50000);
+        }
+    }
+    m_state.reset();
+}
+
+ATTResult Session::send(std::span<const uint8_t> bytes)
+{
+    if (bytes.empty() || bytes.size() > 23) return { ATTError::InvalidLength };
+    if (m_aborted) return { ATTError::Aborted };
+    if (m_testTransport) return m_testTransport->send(bytes);
+    if (!m_connected || m_socket < 0 || m_state->listener.notices->link != linkConnected) { m_connected = false; return { ATTError::Disconnected }; }
+    auto deadline = system_time() + 5000000;
+    while (!m_aborted && system_time() < deadline) {
+        auto length = ::send(m_socket, bytes.data(), bytes.size(), 0);
+        if (length == ssize_t(bytes.size())) return { };
+        if (length >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { m_connected = false; return { ATTError::Disconnected }; }
+        pollfd descriptor { m_socket, POLLOUT, 0 };
+        poll(&descriptor, 1, 100);
+    }
+    return { m_aborted ? ATTError::Aborted : ATTError::Timeout };
+}
+ATTResult Session::receive(std::vector<uint8_t>& bytes, unsigned milliseconds)
+{
+    bytes.clear();
+    if (m_aborted) return { ATTError::Aborted };
+    if (m_testTransport) return m_testTransport->receive(bytes, milliseconds);
+    auto deadline = system_time() + bigtime_t(milliseconds) * 1000;
+    do {
+        if (m_aborted) return { ATTError::Aborted };
+        if (!m_connected || m_socket < 0 || m_state->listener.notices->link != linkConnected) { m_connected = false; return { ATTError::Disconnected }; }
+        pollfd descriptor { m_socket, POLLIN, 0 };
+        auto remaining = std::max<bigtime_t>(0, (deadline - system_time() + 999) / 1000);
+        int polled = poll(&descriptor, 1, int(std::min<bigtime_t>(remaining, 100)));
+        if (polled < 0 && errno == EINTR) continue;
+        if (polled < 0 || (descriptor.revents & (POLLERR | POLLHUP | POLLNVAL))) { m_connected = false; return { ATTError::Disconnected }; }
+        if (polled > 0) {
+            uint8_t packet[24];
+            auto length = recv(m_socket, packet, sizeof(packet), 0);
+            if (length < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+            if (length <= 0) { m_connected = false; return { ATTError::Disconnected }; }
+            if (length > 23) return { ATTError::Protocol };
+            bytes.assign(packet, packet + length);
+            return { };
+        }
+    } while (system_time() < deadline);
+    return { ATTError::Timeout };
+}
+}
