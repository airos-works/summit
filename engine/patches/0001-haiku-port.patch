+static ExceptionOr<URL> normalizeProtocolHandler(Document& document, const String& scheme, const String& value)
+{
+    if (!isAllowedProtocolHandlerScheme(scheme))
+        return Exception { ExceptionCode::SecurityError, "This scheme cannot be registered by a website."_s };
+    if (!value.contains("%s"_s))
+        return Exception { ExceptionCode::SyntaxError, "A protocol handler URL must contain %s."_s };
+    auto url = document.encodingParseURL(value);
+    if (!url.isValid())
+        return Exception { ExceptionCode::SyntaxError, "Invalid protocol handler URL."_s };
+    if (!url.protocolIsInHTTPFamily() || !document.securityOrigin().isSameOriginAs(SecurityOrigin::create(url)))
+        return Exception { ExceptionCode::SecurityError, "A protocol handler must be an HTTP(S) URL on this origin."_s };
+    if (!document.isFullyActive())
+        return Exception { ExceptionCode::InvalidStateError, "The registering document is not active."_s };
+    return url;
+}
+
+ExceptionOr<void> Navigator::registerProtocolHandler(const String& scheme, const String& value)
+{
+    RefPtr document = this->document();
+    RefPtr frame = this->frame();
+    if (!document || !frame || !frame->page())
+        return Exception { ExceptionCode::InvalidStateError };
+    auto normalizedScheme = scheme.convertToASCIILowercase();
+    auto result = normalizeProtocolHandler(*document, normalizedScheme, value);
+    if (result.hasException())
+        return result.releaseException();
+    frame->page()->chrome().client().protocolHandlerRequested(*frame, normalizedScheme, result.releaseReturnValue(), false);
+    return { };
+}
+
+ExceptionOr<void> Navigator::unregisterProtocolHandler(const String& scheme, const String& value)
+{
+    RefPtr document = this->document();
+    RefPtr frame = this->frame();
+    if (!document || !frame || !frame->page())
+        return Exception { ExceptionCode::InvalidStateError };
+    auto normalizedScheme = scheme.convertToASCIILowercase();
+    auto result = normalizeProtocolHandler(*document, normalizedScheme, value);
+    if (result.hasException())
+        return result.releaseException();
+    frame->page()->chrome().client().protocolHandlerRequested(*frame, normalizedScheme, result.releaseReturnValue(), true);
+    return { };
+}
