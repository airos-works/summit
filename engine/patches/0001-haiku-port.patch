diff --git a/Source/WebKit/WebProcess/DigitalCredentials/haiku/DigitalCredentialsRequestValidatorHaiku.cpp b/Source/WebKit/WebProcess/DigitalCredentials/haiku/DigitalCredentialsRequestValidatorHaiku.cpp
