+
+// webNavigation.onReferenceFragmentUpdated and onHistoryStateUpdated, called
+// before the frame takes the new URL.
+static void didSameDocumentNavigationForExtensionsHaiku(WebPageProxy& page, WebFrameProxy& frame, SameDocumentNavigationType navigationType, const URL& url)
+{
+    RefPtr controller = page.webExtensionController();
+    if (!controller)
+        return;
+    auto eventType = WebExtensionEventListenerType::WebNavigationOnHistoryStateUpdated;
+    switch (navigationType) {
+    case SameDocumentNavigationType::AnchorNavigation:
+        eventType = WebExtensionEventListenerType::WebNavigationOnReferenceFragmentUpdated;
+        break;
+    case SameDocumentNavigationType::SessionStatePop:
+        // Every same-document load reports a pop. One that only changes the
+        // fragment is followed by an anchor navigation, reported above.
+        if (equalIgnoringFragmentIdentifier(url, frame.url()) && url.fragmentIdentifier() != frame.url().fragmentIdentifier())
+            return;
+        break;
+    case SameDocumentNavigationType::SessionStatePush:
+    case SameDocumentNavigationType::SessionStateReplace:
+        break;
+    }
+    RefPtr parent = frame.parentFrame();
+    WebExtensionFrameParameters parameters {
+        .url = url,
+        .parentFrameIdentifier = parent ? webExtensionFrameIdentifierHaiku(*parent) : WebExtensionFrameConstants::NoneIdentifier,
+        .frameIdentifier = webExtensionFrameIdentifierHaiku(frame),
+    };
+    controller->didSameDocumentNavigationForFrameHaiku(page.identifier(), parameters, eventType, WallTime::now());
+}
