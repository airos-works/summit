+#if PLATFORM(HAIKU)
+void WebExtensionContext::connectToExtensionHaiku(const String& extensionID, WebExtensionPortChannelIdentifier channelIdentifier, const String& name, const WebExtensionMessageSenderParameters& senderParameters, CompletionHandler<void(std::expected<void, WebExtensionError>&&)>&& completionHandler)
+{
+    static constexpr auto apiName = "runtime.connect()"_s;
+    const auto localWorld = senderParameters.contentWorldType;
+    constexpr auto bridgeWorld = WebExtensionContentWorldType::Native;
+
+    // The sender's port (its web process aims it at the Native world).
+    addPorts(localWorld, bridgeWorld, channelIdentifier, { senderParameters.pageProxyIdentifier });
+
+    RefPtr controller = extensionController();
+    RefPtr destination = controller ? controller->extensionContext(extensionID) : nullptr;
+    if (!destination || !destination->isLoaded() || !protect(destination->extension())->acceptsExternalMessagesFrom(uniqueIdentifier())) {
+        // The page reports the error and disconnects its port.
+        completionHandler(toWebExtensionError(apiName, nullString(), "Could not establish connection. Receiving end does not exist."_s));
+        return;
+    }
+
+    // The bridge is this side's far end until the other side disconnects.
+    m_ports.add({ bridgeWorld, channelIdentifier });
+    m_portBridgesHaiku.set(channelIdentifier, PortBridgeHaiku { *destination, localWorld });
+    destination->acceptBridgedConnectHaiku(*this, channelIdentifier, name, senderParameters);
+    completionHandler({ });
+}
+
+void WebExtensionContext::acceptBridgedConnectHaiku(WebExtensionContext& source, WebExtensionPortChannelIdentifier channelIdentifier, const String& name, const WebExtensionMessageSenderParameters& senderParameters)
+{
+    constexpr auto bridgeWorld = WebExtensionContentWorldType::Native;
+    constexpr auto localWorld = WebExtensionContentWorldType::Main;
+
+    m_ports.add({ bridgeWorld, channelIdentifier });
+    m_portBridgesHaiku.set(channelIdentifier, PortBridgeHaiku { source, localWorld });
+
+    WebExtensionMessageSenderParameters completeSenderParameters = senderParameters;
+    completeSenderParameters.extensionUniqueIdentifier = source.uniqueIdentifier();
+    // Tab identifiers are this extension's own.
+    if (RefPtr tab = getTab(senderParameters.pageProxyIdentifier))
+        completeSenderParameters.tabParameters = tab->parameters();
+    else
+        completeSenderParameters.tabParameters = std::nullopt;
+    // The receiving ports post to the bridge.
+    completeSenderParameters.contentWorldType = bridgeWorld;
+
+    constexpr auto eventType = WebExtensionEventListenerType::RuntimeOnConnectExternal;
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ eventType }, [=, this, protectedThis = Ref { *this }]() mutable {
+        auto mainWorldProcesses = processes(eventType, localWorld);
+        if (mainWorldProcesses.isEmpty()) {
+            bridgedPeerDisconnectedHaiku(channelIdentifier);
+            return;
+        }
+        auto handledCount = Box<size_t>::create(0);
+        size_t totalExpected = mainWorldProcesses.size();
+        for (auto& process : mainWorldProcesses) {
+            process->sendWithAsyncReply(Messages::WebExtensionContextProxy::DispatchRuntimeConnectEvent(localWorld, channelIdentifier, name, std::nullopt, completeSenderParameters, false), [=, this, protectedThis = Ref { *this }](HashCountedSet<WebPageProxyIdentifier>&& addedPortCounts) mutable {
+                addPorts(localWorld, bridgeWorld, channelIdentifier, WTF::move(addedPortCounts));
+                fireQueuedPortMessageEventsIfNeeded(localWorld, channelIdentifier);
+                if (++*handledCount < totalExpected)
+                    return;
+                // No listener kept a port: the sender's port disconnects.
+                if (!openPortCount(localWorld, channelIdentifier))
+                    bridgedPeerDisconnectedHaiku(channelIdentifier);
+            }, identifier());
+        }
+    });
+}
+
+bool WebExtensionContext::relayBridgedPortMessageHaiku(WebExtensionPortChannelIdentifier channelIdentifier, const String& messageJSON)
+{
+    auto bridge = m_portBridgesHaiku.find(channelIdentifier);
+    if (bridge == m_portBridgesHaiku.end())
+        return false;
+    RefPtr peer = bridge->value.peer.get();
+    if (!peer)
+        return true;
+    auto peerBridge = peer->m_portBridgesHaiku.find(channelIdentifier);
+    if (peerBridge == peer->m_portBridgesHaiku.end())
+        return true;
+    // Queued there until the far port exists. Gestures do not cross extensions.
+    peer->portPostMessage(WebExtensionContentWorldType::Native, peerBridge->value.localWorld, std::nullopt, channelIdentifier, messageJSON, false);
+    return true;
+}
+
+void WebExtensionContext::bridgedPeerDisconnectedHaiku(WebExtensionPortChannelIdentifier channelIdentifier)
+{
+    auto entry = m_portBridgesHaiku.find(channelIdentifier);
+    if (entry == m_portBridgesHaiku.end())
+        return;
+    auto bridge = entry->value;
+    m_portBridgesHaiku.remove(entry);
+    m_ports.removeAll({ WebExtensionContentWorldType::Native, channelIdentifier });
+    firePortDisconnectEventIfNeeded(WebExtensionContentWorldType::Native, bridge.localWorld, channelIdentifier);
+    clearQueuedPortMessages(bridge.localWorld, channelIdentifier);
+    if (RefPtr peer = bridge.peer.get(); peer && peer->m_portBridgesHaiku.contains(channelIdentifier))
+        peer->bridgedPeerDisconnectedHaiku(channelIdentifier);
+}
