+#pragma once
+
+#include "FragmentedMP4ParserHaiku.h"
+#include <memory>
+
+namespace SummitWebM {
+
+// Incremental WebM demuxing, backed by the in-tree libwebm parser. It emits
+// the same track/sample representation as the MP4 parser; decoding still
+// belongs to Media Kit. No WebCore or Haiku types are needed by its tests.
+class Parser {
+public:
+    Parser();
+    ~Parser();
+    Parser(const Parser&) = delete;
+    Parser& operator=(const Parser&) = delete;
+
+    std::function<void(SummitMP4::InitSegment&&)> onInitSegment;
+    std::function<void(SummitMP4::Sample&&)> onSample;
+
+    bool append(const uint8_t*, size_t);
+    // Finish complete video packets at an append boundary. An incomplete
+    // EBML element or laced frame is retained for the next append.
+    void flushPendingSamples();
+    // Abort a partial append, preserving the last initialization segment so
+    // an application can seek directly to another Cluster.
+    void reset();
+
+    // Vorbis packet timing uses libavcodec's public opaque parser API. Media
+    // Kit already uses that library; don't advertise Vorbis if it is absent.
+    static bool supportsVorbis();
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace SummitWebM
