+
+status_t DownloadRegistryHaiku::setListener(const BMessenger& listener)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shuttingDown)
+        return B_NO_INIT;
+    if (!m_downloads.empty())
+        return B_BUSY;
+    if (!listener.IsValid())
+        return B_BAD_VALUE;
+    m_listener = listener;
+    return B_OK;
+}
+
+status_t DownloadRegistryHaiku::setDirectory(const char* directory)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shuttingDown)
+        return B_NO_INIT;
+    if (!m_downloads.empty())
+        return B_BUSY;
+    if (!directory || directory[0] != '/' || String::fromUTF8(directory).isNull())
+        return B_BAD_VALUE;
+    std::unique_ptr<char, decltype(&std::free)> canonical(realpath(directory, nullptr), &std::free);
+    if (!canonical)
+        return errno == ENOENT ? B_ENTRY_NOT_FOUND : errno == EACCES ? B_PERMISSION_DENIED : B_IO_ERROR;
+    struct stat info;
+    if (stat(canonical.get(), &info) || !S_ISDIR(info.st_mode))
+        return B_NOT_A_DIRECTORY;
+    if (access(canonical.get(), W_OK | X_OK))
+        return B_PERMISSION_DENIED;
+    auto path = String::fromUTF8(canonical.get());
+    if (path.isNull())
+        return B_BAD_VALUE;
+    m_directory = WTF::move(path);
+    return B_OK;
+}
+
+status_t DownloadRegistryHaiku::setKeepFailedDownloads(bool keep)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shuttingDown)
+        return B_NO_INIT;
+    if (!m_downloads.empty())
+        return B_BUSY;
+    m_keepFailedDownloads = keep;
+    return B_OK;
+}
+
+status_t DownloadRegistryHaiku::prepareResume(const String& path, const String& validator, int64_t expectedSize, Resume& resume) const
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shuttingDown || m_directory.isEmpty())
+        return B_NO_INIT;
+    resume = { };
+    resume.hasValidator = !validator.isEmpty();
+    resume.expectedSize = expectedSize;
+    if (path.isEmpty())
+        return B_OK;
+    // Only a file directly in the download directory, as every destination is.
+    // Only a file in the download directory or a folder of it (an
+    // extension's filename can name folders), as every destination is.
+    auto parent = FileSystem::parentPath(path);
+    bool inside = parent == m_directory || (parent.startsWith(makeString(m_directory, '/')) && !path.contains("/../"_s) && !path.contains("/./"_s));
+    if (!inside || FileSystem::pathFileName(path).isEmpty())
+        return B_BAD_VALUE;
+    for (const auto& [identifier, other] : m_downloads) {
+        if (other->destination == path)
+            return B_BUSY;
+    }
+    struct stat info;
+    if (lstat(path.utf8().legacyCStringPointer(), &info)) {
+        // Gone: the download starts afresh and chooses a free name again
+        // rather than writing over whatever may appear at this one.
+        return errno == ENOENT ? B_OK : B_IO_ERROR;
+    }
+    if (!S_ISREG(info.st_mode))
+        return B_BAD_VALUE;
+    resume.path = path;
+    resume.offset = static_cast<uint64_t>(info.st_size);
+    return B_OK;
+}
+
+bool DownloadRegistryHaiku::hasPendingDownloads() const
+{
+    ASSERT(RunLoop::isMain());
+    return !m_downloads.empty();
+}
