+
+// Spell checking with Hunspell, loaded when the browser turns it on
+// (BWebKitSetSpellChecking). WebCore asks through the web process's editor
+// client; everything here runs on the UI process's main thread.
+
+#include "config.h"
+#include "TextChecker.h"
+
+#include "TextCheckerState.h"
+#include "SpellingLanguageHaiku.h"
+#include "WebKitView.h"
+#include "WebProcessPool.h"
+#include <FindDirectory.h>
+#include <Path.h>
+#include <dlfcn.h>
+#include <dirent.h>
+#include <memory>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+#include <strings.h>
+#include <unicode/ubrk.h>
+#include <unicode/uchar.h>
+#include <wtf/HashSet.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/text/StringHash.h>
+#include <wtf/text/TextBreakIterator.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+
+// The part of Hunspell's C API (hunspell.h) Summit uses.
+struct HunspellLibrary {
+    using Create = void* (*)(const char* affix, const char* dictionary);
+    using Destroy = void (*)(void*);
+    using Spell = int (*)(void*, const char*);
+    using Suggest = int (*)(void*, char*** list, const char* word);
+    using FreeList = void (*)(void*, char*** list, int count);
+    using Add = int (*)(void*, const char* word);
+    using Encoding = char* (*)(void*);
+
+    bool load()
+    {
+        if (attempted)
+            return library;
+        attempted = true;
+        for (const char* name : { "libhunspell-1.7.so.0", "libhunspell-1.7.so", "libhunspell.so" }) {
+            if ((library = dlopen(name, RTLD_LAZY | RTLD_LOCAL)))
+                break;
+        }
+        if (!library)
+            return false;
+        create = reinterpret_cast<Create>(dlsym(library, "Hunspell_create"));
+        destroy = reinterpret_cast<Destroy>(dlsym(library, "Hunspell_destroy"));
+        spell = reinterpret_cast<Spell>(dlsym(library, "Hunspell_spell"));
+        suggest = reinterpret_cast<Suggest>(dlsym(library, "Hunspell_suggest"));
+        freeList = reinterpret_cast<FreeList>(dlsym(library, "Hunspell_free_list"));
+        add = reinterpret_cast<Add>(dlsym(library, "Hunspell_add"));
+        encoding = reinterpret_cast<Encoding>(dlsym(library, "Hunspell_get_dic_encoding"));
+        if (!create || !destroy || !spell || !suggest || !freeList || !add) {
+            dlclose(library);
+            library = nullptr;
+        }
+        return library;
+    }
+
+    bool attempted { false };
+    void* library { nullptr };
+    Create create { nullptr };
+    Destroy destroy { nullptr };
+    Spell spell { nullptr };
+    Suggest suggest { nullptr };
+    FreeList freeList { nullptr };
+    Add add { nullptr };
+    Encoding encoding { nullptr };
+};
+
+struct SpellCheckerHaiku {
+    HunspellLibrary hunspell;
+    struct Dictionary {
+        HunspellLibrary& library;
+        void* handle;
+        ~Dictionary() { library.destroy(handle); }
+    };
+    std::unique_ptr<Dictionary> dictionary;
+    std::vector<std::pair<std::string, std::unique_ptr<Dictionary>>> pageDictionaries;
+    std::vector<std::string> availableLanguages;
+    bool scannedLanguages { false };
+    bool usePageLanguage { true };
+    bool enabled { false };
+    bool loaded { false };
+    String languages;
+    String dictionaryDirectory;
+    String wordListPath;
+    String language;
+    HashSet<String> ignored;
+
+    static bool exists(const std::string& path)
+    {
+        struct stat info;
+        return !stat(path.c_str(), &info) && S_ISREG(info.st_mode);
+    }
+
+    std::vector<std::string> directories() const
+    {
+        std::vector<std::string> result;
+        if (!dictionaryDirectory.isEmpty())
+            result.push_back(dictionaryDirectory.utf8().legacyCStringPointer());
+        for (auto which : { B_USER_NONPACKAGED_DATA_DIRECTORY, B_USER_DATA_DIRECTORY, B_SYSTEM_NONPACKAGED_DATA_DIRECTORY, B_SYSTEM_DATA_DIRECTORY }) {
+            BPath path;
+            if (find_directory(which, &path) == B_OK) {
+                result.push_back(std::string(path.Path()) + "/hunspell");
+                result.push_back(std::string(path.Path()) + "/myspell");
+            }
+        }
+        return result;
+    }
+
+    void unload()
+    {
+        dictionary.reset();
+        pageDictionaries.clear();
+        availableLanguages.clear();
+        scannedLanguages = false;
+        loaded = false;
+        language = { };
+    }
+
+    const std::vector<std::string>& installedLanguages()
+    {
+        if (scannedLanguages)
+            return availableLanguages;
+        scannedLanguages = true;
+        for (const auto& directory : directories()) {
+            auto* entries = opendir(directory.c_str());
+            if (!entries)
+                continue;
+            while (auto* entry = readdir(entries)) {
+                std::string name = entry->d_name;
+                if (!name.ends_with(".aff"))
+                    continue;
+                name.resize(name.size() - 4);
+                if (!SpellingLanguageHaiku::normalize(name).empty()
+                    && exists(directory + "/" + name + ".aff") && exists(directory + "/" + name + ".dic"))
+                    availableLanguages.push_back(WTF::move(name));
+            }
+            closedir(entries);
+        }
+        std::sort(availableLanguages.begin(), availableLanguages.end());
+        availableLanguages.erase(std::unique(availableLanguages.begin(), availableLanguages.end()), availableLanguages.end());
+        return availableLanguages;
+    }
+
+    std::unique_ptr<Dictionary> loadDictionary(const String& name)
+    {
+        if (name.isEmpty() || name.contains('/') || name.contains(".."_s) || !hunspell.load())
+            return nullptr;
+        for (const auto& directory : directories()) {
+            const auto base = directory + "/" + name.utf8().legacyCStringPointer();
+            if (!exists(base + ".aff") || !exists(base + ".dic"))
+                continue;
+            auto* handle = hunspell.create((base + ".aff").c_str(), (base + ".dic").c_str());
+            if (!handle)
+                continue;
+            auto result = std::make_unique<Dictionary>(hunspell, handle);
+            // Words are given as UTF-8: only dictionaries in UTF-8 fit.
+            if (hunspell.encoding) {
+                if (const char* encoding = hunspell.encoding(handle); encoding && strcasecmp(encoding, "UTF-8"))
+                    continue;
+            }
+            readWordList(handle);
+            return result;
+        }
+        return nullptr;
+    }
+
+    // Opens the first configured dictionary that exists (en_US last).
+    void ensureLoaded()
+    {
+        if (loaded || !enabled)
+            return;
+        loaded = true;
+        Vector<String> names;
+        for (auto name : languages.split(','))
+            names.append(name.trim(isASCIIWhitespace<char16_t>));
+        names.append("en_US"_s);
+        for (const auto& name : names) {
+            dictionary = loadDictionary(name);
+            if (dictionary) {
+                language = name;
+                return;
+            }
+        }
+    }
+
+    void* handleForLanguage(const String& pageLanguage)
+    {
+        if (!enabled)
+            return nullptr;
+        ensureLoaded();
+        void* fallback = dictionary ? dictionary->handle : nullptr;
+        if (!usePageLanguage || pageLanguage.isEmpty() || pageLanguage.length() > 128)
+            return fallback;
+        std::vector<std::string> preferred;
+        for (auto name : languages.split(','))
+            preferred.emplace_back(name.trim(isASCIIWhitespace<char16_t>).utf8().legacyCStringPointer());
+        preferred.emplace_back("en_US");
+        const auto selected = SpellingLanguageHaiku::select(pageLanguage.utf8().legacyCStringPointer(), installedLanguages(), preferred);
+        if (selected.empty() || selected == language.utf8().legacyCStringPointer())
+            return fallback;
+        for (const auto& entry : pageDictionaries) {
+            if (entry.first == selected)
+                return entry.second ? entry.second->handle : fallback;
+        }
+        // Bound dictionary memory independently of arbitrary page tags. Cache
+        // by installed name; aliases and missing languages cannot grow it.
+        if (pageDictionaries.size() == 8)
+            pageDictionaries.erase(pageDictionaries.begin());
+        auto extra = loadDictionary(String::fromUTF8(selected));
+        void* handle = extra ? extra->handle : fallback;
+        pageDictionaries.emplace_back(selected, WTF::move(extra));
+        return handle;
+    }
+
+    void readWordList(void* handle)
+    {
+        if (wordListPath.isEmpty())
+            return;
+        std::ifstream file(wordListPath.utf8().legacyCStringPointer());
+        std::string word;
+        while (std::getline(file, word)) {
+            if (!word.empty() && word.size() < 100)
+                hunspell.add(handle, word.c_str());
+        }
+    }
+
+    bool isCorrect(StringView word, const String& pageLanguage)
+    {
+        auto* handle = handleForLanguage(pageLanguage);
+        if (!handle)
+            return true;
+        String text = word.toString();
+        if (ignored.contains(text))
+            return true;
+        // Numbers, words with digits and single letters are left alone.
+        bool letters = false;
+        for (auto character : StringView(text).codeUnits()) {
+            if (isASCIIDigit(character))
+                return true;
+            if (u_isalpha(character))
+                letters = true;
+        }
+        if (!letters || text.length() < 2)
+            return true;
+        return hunspell.spell(handle, text.utf8().legacyCStringPointer());
+    }
+
+    Vector<String> guesses(const String& word, const String& pageLanguage = { })
+    {
+        auto* handle = handleForLanguage(pageLanguage);
+        if (!handle)
+            return { };
+        char** list = nullptr;
+        const int count = hunspell.suggest(handle, &list, word.utf8().legacyCStringPointer());
+        Vector<String> result;
+        for (int i = 0; i < count && result.size() < 6; ++i) {
+            if (list[i])
+                result.append(String::fromUTF8(list[i]));
+        }
+        if (list)
+            hunspell.freeList(handle, &list, count);
+        return result;
+    }
+
+    void learn(const String& word)
+    {
+        if (word.isEmpty() || word.length() >= 100 || word.contains('\n'))
+            return;
+        ensureLoaded();
+        if (dictionary)
+            hunspell.add(dictionary->handle, word.utf8().legacyCStringPointer());
+        for (const auto& entry : pageDictionaries) {
+            if (entry.second)
+                hunspell.add(entry.second->handle, word.utf8().legacyCStringPointer());
+        }
+        if (!wordListPath.isEmpty()) {
+            std::ofstream file(wordListPath.utf8().legacyCStringPointer(), std::ios::app);
+            file << word.utf8().legacyCStringPointer() << '\n';
+        }
+    }
+};
+
+SpellCheckerHaiku& spellChecker()
+{
+    ASSERT(RunLoop::isMain());
+    static NeverDestroyed<SpellCheckerHaiku> checker;
+    return checker.get();
