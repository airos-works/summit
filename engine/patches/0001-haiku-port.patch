+void BluetoothRemoteGATTCharacteristic::getDescriptor(BluetoothUUIDValue&& query, DOMPromiseDeferred<IDLInterface<BluetoothRemoteGATTDescriptor>>&& promise)
+{
+    discover<BluetoothRemoteGATTDescriptor, true>(m_service->device(), m_service->generation(), arguments("descriptors"_s), WTF::move(query), BluetoothHaiku::UUIDKind::Descriptor,
+        [self = Ref { *this }](auto&& data) {
+            unsigned handle = data->getInteger("handle"_s).value_or(0);
+            if (auto it = self->m_descriptors.find(handle); it != self->m_descriptors.end() && it->value) return Ref { *it->value };
+            auto descriptor = BluetoothRemoteGATTDescriptor::create(self, WTF::move(data)); self->m_descriptors.set(handle, descriptor); return descriptor;
+        }, WTF::move(promise));
+}
+void BluetoothRemoteGATTCharacteristic::getDescriptors(std::optional<BluetoothUUIDValue>&& query, DOMPromiseDeferred<IDLSequence<IDLInterface<BluetoothRemoteGATTDescriptor>>>&& promise)
+{
