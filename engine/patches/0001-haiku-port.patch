@@ -0,0 +1,228 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEB_BLUETOOTH)
+#include "Bluetooth.h"
+#include "BluetoothDevice.h"
+#include "BluetoothUUID.h"
+#include "Chrome.h"
+#include "ChromeClient.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "DocumentPage.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "FrameDestructionObserverInlines.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMConvertBoolean.h"
+#include "JSDOMConvertSequences.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSBluetoothDevice.h"
+#include "LocalDOMWindow.h"
+#include "LocalFrame.h"
+#include "Page.h"
+#include "PermissionsPolicy.h"
+#include "SecurityOrigin.h"
+#include "ValueEvent.h"
+#include <wtf/TZoneMallocInlines.h>
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(Bluetooth);
+Ref<Bluetooth> Bluetooth::create(Document& document)
+{
+    auto result = adoptRef(*new Bluetooth(document)); result->suspendIfNeeded(); return result;
+}
+Bluetooth::Bluetooth(Document& document) : ActiveDOMObject(&document), m_timer(*this, &Bluetooth::pollAvailability) { }
+Bluetooth::~Bluetooth() = default;
+Document* Bluetooth::document() const { return dynamicDowncast<Document>(scriptExecutionContext()); }
+static ExceptionCode errorCode(const String& name)
+{
+    if (name == "SecurityError"_s) return ExceptionCode::SecurityError;
+    if (name == "NotFoundError"_s) return ExceptionCode::NotFoundError;
+    if (name == "NotAllowedError"_s) return ExceptionCode::NotAllowedError;
+    if (name == "InvalidStateError"_s) return ExceptionCode::InvalidStateError;
+    if (name == "NotSupportedError"_s) return ExceptionCode::NotSupportedError;
+    if (name == "InvalidModificationError"_s) return ExceptionCode::InvalidModificationError;
+    if (name == "AbortError"_s) return ExceptionCode::AbortError;
+    if (name == "TypeError"_s) return ExceptionCode::TypeError;
+    return ExceptionCode::NetworkError;
+}
+void Bluetooth::perform(Document* document, Ref<JSON::Object>&& arguments, Vector<uint8_t>&& bytes, Completion&& completion)
+{
+    if (!document || !document->isFullyActive() || !document->frame() || !document->page()) {
+        completion(Exception { ExceptionCode::InvalidStateError, "The Bluetooth document is no longer active"_s }, { }, std::nullopt); return;
+    }
+    if (!document->isSecureContext() || document->securityOrigin().isOpaque()
+        || !PermissionsPolicy::isFeatureEnabled(PermissionsPolicy::Feature::Bluetooth, *document)) {
+        completion(Exception { ExceptionCode::SecurityError, "Bluetooth access is not allowed in this document"_s }, { }, std::nullopt); return;
+    }
+    if (bytes.size() > 512) { completion(Exception { ExceptionCode::InvalidModificationError, "Bluetooth attributes are limited to 512 bytes"_s }, { }, std::nullopt); return; }
+    arguments->setString("document"_s, document->identifier().toString());
+    auto json = arguments->toJSONString();
+    if (json.length() > 65536) { completion(Exception { ExceptionCode::TypeError, "Bluetooth request is too large"_s }, { }, std::nullopt); return; }
+    document->page()->chrome().client().bluetoothRequest(*document->frame(), json, WTF::move(bytes),
+        [document = WeakPtr { *document }, completion = WTF::move(completion)](String&& response, Vector<uint8_t>&& bytes) mutable {
+            if (!document || !document->isFullyActive()) { completion(Exception { ExceptionCode::AbortError, "The Bluetooth document was closed"_s }, { }, std::nullopt); return; }
+            auto value = JSON::Value::parseJSON(response); auto object = value ? value->asObject() : nullptr;
+            if (!object) { completion(Exception { ExceptionCode::NetworkError, "Invalid Bluetooth broker response"_s }, { }, std::nullopt); return; }
+            auto connected = object->getBoolean("connected"_s);
+            auto error = object->getString("error"_s);
+            if (!error.isEmpty()) { completion(Exception { errorCode(error), object->getString("message"_s) }, { }, connected); return; }
+            completion(object.releaseNonNull(), WTF::move(bytes), connected);
+        });
+}
+Ref<BluetoothDevice> Bluetooth::device(Ref<JSON::Object>&& data)
+{
+    m_devices.removeIf([](auto& entry) { return entry.value->forgotten(); });
+    auto id = data->getString("id"_s);
+    if (auto it = m_devices.find(id); it != m_devices.end()) return it->value.copyRef();
+    auto device = BluetoothDevice::create(*document(), *this, WTF::move(data));
+    m_devices.add(id, device.copyRef()); return device;
+}
+void Bluetooth::getAvailability(DOMPromiseDeferred<IDLBoolean>&& promise)
+{
+    auto* doc = document();
+    if (!doc || !PermissionsPolicy::isFeatureEnabled(PermissionsPolicy::Feature::Bluetooth, *doc, PermissionsPolicy::ShouldReportViolation::No)) { promise.resolve(false); return; }
+    auto args = JSON::Object::create(); args->setString("operation"_s, "getAvailability"_s);
+    perform(doc, WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { auto error = result.releaseException(); if (error.code() == ExceptionCode::SecurityError) promise.resolve(false); else promise.reject(WTF::move(error)); return; }
+        bool available = result.releaseReturnValue()->getBoolean("available"_s).value_or(false);
+        m_available = available; promise.resolve(available);
+    });
+}
+void Bluetooth::getDevices(DOMPromiseDeferred<IDLSequence<IDLInterface<BluetoothDevice>>>&& promise)
+{
+    auto args = JSON::Object::create(); args->setString("operation"_s, "getDevices"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        Vector<Ref<BluetoothDevice>> devices;
+        if (auto array = result.releaseReturnValue()->getArray("devices"_s))
+            for (auto& value : *array) if (auto object = value->asObject()) devices.append(device(object.releaseNonNull()));
+        promise.resolve(WTF::move(devices));
+    });
+}
+
+static ExceptionOr<Ref<JSON::Array>> uuidArray(const Vector<BluetoothUUIDValue>& values, bool optional = false)
+{
+    if (values.size() > 128) return Exception { ExceptionCode::TypeError, "Too many Bluetooth services"_s };
+    auto result = JSON::Array::create();
+    for (auto& value : values) {
+        auto resolved = BluetoothUUID::resolve(BluetoothHaiku::UUIDKind::Service, value);
+        if (resolved.hasException()) return resolved.releaseException();
+        auto uuid = resolved.releaseReturnValue();
+        if (BluetoothHaiku::blocked(*BluetoothHaiku::UUID::parse(uuid.utf8().legacyCStringPointer()))) {
+            if (optional) continue;
+            return Exception { ExceptionCode::SecurityError, "This Bluetooth service is blocked"_s };
+        }
+        result->pushString(uuid);
+    }
+    return result;
+}
+static bool dataFilter(JSON::Object& object, const BluetoothDataFilterInit& data)
+{
+    if ((data.mask && (!data.dataPrefix || data.mask->byteLength() != data.dataPrefix->byteLength()))
+        || (data.dataPrefix && data.dataPrefix->byteLength() > 512)) return false;
+    for (auto entry : { std::pair { "dataPrefix"_s, &data.dataPrefix }, std::pair { "mask"_s, &data.mask } }) {
+        if (!*entry.second) continue;
+        auto array = JSON::Array::create(); for (auto byte : (*entry.second)->span()) array->pushInteger(byte);
+        object.setArray(entry.first, WTF::move(array));
+    }
+    return true;
+}
+static ExceptionOr<Ref<JSON::Array>> filtersJSON(const Vector<BluetoothLEScanFilterInit>& filters)
+{
+    if (filters.isEmpty() || filters.size() > 64) return Exception { ExceptionCode::TypeError, "Bluetooth filters must be a nonempty list"_s };
+    auto result = JSON::Array::create();
+    for (auto& filter : filters) {
+        auto object = JSON::Object::create();
+        if (!filter.services && filter.name.isNull() && filter.namePrefix.isNull() && !filter.manufacturerData && !filter.serviceData)
+            return Exception { ExceptionCode::TypeError, "A Bluetooth filter must constrain a device"_s };
+        if (filter.services) {
+            if (filter.services->isEmpty()) return Exception { ExceptionCode::TypeError, "A services filter must be nonempty"_s };
+            auto array = uuidArray(*filter.services); if (array.hasException()) return array.releaseException();
+            object->setArray("services"_s, array.releaseReturnValue());
+        }
+        if ((!filter.name.isNull() && filter.name.utf8().length() > 248) || (!filter.namePrefix.isNull() && (filter.namePrefix.isEmpty() || filter.namePrefix.utf8().length() > 248)))
+            return Exception { ExceptionCode::TypeError, "Invalid Bluetooth name filter"_s };
+        if (!filter.name.isNull()) object->setString("name"_s, filter.name);
+        if (!filter.namePrefix.isNull()) object->setString("namePrefix"_s, filter.namePrefix);
+        if (filter.manufacturerData) {
+            if (filter.manufacturerData->isEmpty() || filter.manufacturerData->size() > 64) return Exception { ExceptionCode::TypeError, "Invalid manufacturer-data filter"_s };
+            auto array = JSON::Array::create(); HashSet<uint32_t> companies;
+            for (auto& data : *filter.manufacturerData) {
+                if (!companies.add(uint32_t(data.companyIdentifier) + 1).isNewEntry) return Exception { ExceptionCode::TypeError, "Duplicate manufacturer-data filter"_s };
+                auto item = JSON::Object::create(); item->setInteger("companyIdentifier"_s, data.companyIdentifier);
+                if (!dataFilter(item, data)) return Exception { ExceptionCode::TypeError, "Invalid Bluetooth data prefix or mask"_s };
+                array->pushObject(WTF::move(item));
+            }
+            object->setArray("manufacturerData"_s, WTF::move(array));
+        }
+        if (filter.serviceData) {
+            if (filter.serviceData->isEmpty() || filter.serviceData->size() > 64) return Exception { ExceptionCode::TypeError, "Invalid service-data filter"_s };
+            auto array = JSON::Array::create(); HashSet<String> services;
+            for (auto& data : *filter.serviceData) {
+                auto resolved = BluetoothUUID::resolve(BluetoothHaiku::UUIDKind::Service, data.service);
+                if (resolved.hasException()) return resolved.releaseException();
+                auto uuid = resolved.releaseReturnValue();
+                if (BluetoothHaiku::blocked(*BluetoothHaiku::UUID::parse(uuid.utf8().legacyCStringPointer()))) return Exception { ExceptionCode::SecurityError, "This Bluetooth service is blocked"_s };
+                if (!services.add(uuid).isNewEntry) return Exception { ExceptionCode::TypeError, "Duplicate service-data filter"_s };
+                auto item = JSON::Object::create(); item->setString("service"_s, uuid);
+                if (!dataFilter(item, data)) return Exception { ExceptionCode::TypeError, "Invalid Bluetooth data prefix or mask"_s };
+                array->pushObject(WTF::move(item));
+            }
+            object->setArray("serviceData"_s, WTF::move(array));
+        }
+        result->pushObject(WTF::move(object));
+    }
+    return result;
+}
+void Bluetooth::requestDevice(RequestDeviceOptions&& options, DOMPromiseDeferred<IDLInterface<BluetoothDevice>>&& promise)
+{
+    if (options.acceptAllDevices == options.filters.has_value()) { promise.reject(ExceptionCode::TypeError, "Use filters or acceptAllDevices to choose Bluetooth devices"_s); return; }
+    if (options.acceptAllDevices && options.exclusionFilters) { promise.reject(ExceptionCode::TypeError, "Exclusion filters require inclusion filters"_s); return; }
+    auto* doc = document();
+    if (!doc || !doc->window() || !doc->window()->hasTransientActivation()) { promise.reject(ExceptionCode::SecurityError, "Choosing a Bluetooth device requires a user gesture"_s); return; }
+    auto args = JSON::Object::create(); args->setString("operation"_s, "requestDevice"_s); args->setBoolean("acceptAllDevices"_s, options.acceptAllDevices);
+    for (auto entry : { std::pair { "filters"_s, &options.filters }, std::pair { "exclusionFilters"_s, &options.exclusionFilters } }) {
+        if (!*entry.second) continue;
+        auto filters = filtersJSON(**entry.second);
+        if (filters.hasException()) { promise.reject(filters.releaseException()); return; }
+        args->setArray(entry.first, filters.releaseReturnValue());
+    }
+    auto services = uuidArray(options.optionalServices, true);
+    if (services.hasException()) { promise.reject(services.releaseException()); return; }
+    args->setArray("optionalServices"_s, services.releaseReturnValue());
+    perform(doc, WTF::move(args), { }, [this, protectedThis = Ref { *this }, promise = WTF::move(promise)](auto&& result, auto&&, auto) mutable {
+        if (result.hasException()) { promise.reject(result.releaseException()); return; }
+        auto data = result.releaseReturnValue()->getObject("device"_s);
+        if (!data) { promise.reject(ExceptionCode::NotFoundError, "No Bluetooth device was selected"_s); return; }
+        promise.resolve(device(data.releaseNonNull()));
+    });
+}
+void Bluetooth::eventListenersDidChange()
+{
+    if (!m_stopped && hasEventListeners(eventNames().availabilitychangedEvent)) { if (!m_timer.isActive()) m_timer.startRepeating(2_s); }
+    else m_timer.stop();
+}
+void Bluetooth::pollAvailability()
+{
+    if (m_stopped || m_polling) return;
+    m_polling = true;
+    auto args = JSON::Object::create(); args->setString("operation"_s, "getAvailability"_s);
+    perform(document(), WTF::move(args), { }, [this, protectedThis = Ref { *this }](auto&& result, auto&&, auto) {
+        m_polling = false;
+        if (m_stopped) return;
+        bool available = !result.hasException() && result.releaseReturnValue()->getBoolean("available"_s).value_or(false);
+        auto previous = m_available; m_available = available;
+        if (previous && *previous != available) dispatchEvent(ValueEvent::createAvailability(available));
+    });
+}
+bool Bluetooth::virtualHasPendingActivity() const { return !m_stopped && hasEventListeners(); }
+void Bluetooth::suspend(ReasonForSuspension) { m_timer.stop(); }
+void Bluetooth::resume() { eventListenersDidChange(); }
+void Bluetooth::stop()
+{
+    m_stopped = true; m_timer.stop();
+    for (auto& entry : m_devices) entry.value->disconnected(false);
+    m_devices.clear();
+}
+}
+#endif
