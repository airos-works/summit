+MonotonicTime ScrollingTreeCoordinated::scrollAnimationSampleTimeHaiku(MonotonicTime now)
+{
+    // Haiku has no display link: refreshes come from a timer in the web
+    // process, at any time between two frames. Sampled at the refresh's own
+    // time, the animations moved by whatever time the timer's period and the
+    // compositor's had drifted apart: a frame showed two refreshes' worth or
+    // none, two or three times a second. Each frame now shows them where they
+    // are when it is due. SUMMIT_SCROLL_FRAME_TIMES=0 samples at the refresh.
+    auto* rootScrollingNode = rootNode();
