+// Summit has one zoom mode: remembered per site, applied by the browser.
+static Ref<JSON::Object> summitZoomSettings()
+{
+    Ref settings = JSON::Object::create();
+    settings->setString("mode"_s, "automatic"_s);
+    settings->setString("scope"_s, "per-origin"_s);
+    settings->setDouble("defaultZoomFactor"_s, 1);
+    return settings;
+}
