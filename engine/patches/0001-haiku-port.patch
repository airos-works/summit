+void WebUSBBrokerHaiku::enumerate(uint64_t page, const String& owner, const String& origin, const BMessenger& view,
+    Ref<JSON::Object>&& args, std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    bool choosing = args->getString("operation"_s) == "requestDevice"_s;
+    if (!choosing) {
+        bool hasGrant = false;
+        for (auto& grant : m_grants)
+            hasGrant |= grant.value.origin == origin;
+        if (!hasGrant) {
+            // An unapproved origin learns nothing from probing the physical bus.
+            completion("{\"devices\":[]}"_s, { });
+            return;
+        }
+    }
+    auto include = choosing ? readFilters(args, "filters"_s) : std::optional { std::vector<Filter> { } };
+    auto exclude = choosing ? readFilters(args, "exclusionFilters"_s) : std::optional { std::vector<Filter> { } };
+    if (!include || !exclude) {
+        completion(usbError("TypeError"_s, "Invalid USB device filter"_s), { });
+        return;
+    }
+    if (m_enumerations >= 4) {
+        completion(usbError("InvalidStateError"_s, "A USB enumeration is already pending"_s), { });
+        return;
+    }
+    ++m_enumerations;
+    m_queue->dispatch([self = shared_from_this(), page, owner = owner.isolatedCopy(), origin = origin.isolatedCopy(), view,
+        choosing, include = std::move(*include), exclude = std::move(*exclude), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+        auto devices = enumerateDevices();
+        std::erase_if(devices, [&](auto& device) { return !matches(device, include, exclude); });
+        RunLoop::mainSingleton().dispatch([self, page, owner = owner.isolatedCopy(), origin = origin.isolatedCopy(), view, choosing,
+            devices = std::move(devices), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            --self->m_enumerations;
+            if (self->m_shutdown || !isCurrent()) {
+                completion(usbError("AbortError"_s, "The USB document was closed"_s), { });
+                return;
+            }
+            if (!choosing) {
+                auto result = JSON::Object::create();
+                auto list = JSON::Array::create();
+                for (auto& grant : self->m_grants) {
+                    if (grant.value.origin != origin)
+                        continue;
+                    auto found = std::find_if(devices.begin(), devices.end(), [&](auto& device) {
+                        return device.path == grant.value.device.path && device.identity == grant.value.device.identity;
+                    });
+                    if (found != devices.end())
+                        list->pushObject(deviceJSON(*found, grant.key));
+                    else
+                        self->closeGrant(grant.value);
+                }
+                result->setArray("devices"_s, WTF::move(list));
+                completion(result->toJSONString(), { });
+                return;
+            }
+            if (devices.empty()) {
+                completion(usbError("NotFoundError"_s, "No eligible USB device matches these filters"_s), { });
+                return;
+            }
+            Vector<std::pair<String, String>> choices;
+            Vector<String> tokens;
+            for (auto& device : devices) {
+                auto token = WTF::UUID::createVersion4().toString();
+                auto label = fromUTF8(device.product.empty() ? "USB device" : device.product);
+                if (!device.manufacturer.empty())
+                    label = makeString(fromUTF8(device.manufacturer), " — "_s, label);
+                // Never let device strings insert new lines in the permission UI.
+                label = makeStringByReplacingAll(makeStringByReplacingAll(label, '\n', ' '), '\r', ' ');
+                choices.append({ token, label });
+                tokens.append(token);
+            }
+            self->m_permissions->requestUSB(origin, view, WTF::move(choices),
+                [self, page, owner, origin, devices = std::move(devices), tokens = WTF::move(tokens),
+                    isCurrent = std::move(isCurrent), completion = WTF::move(completion)](bool allowed, const String& selected) mutable {
+                    if (self->m_shutdown || !isCurrent()) {
+                        completion(usbError("AbortError"_s, "The USB document was closed"_s), { });
+                        return;
+                    }
+                    auto index = tokens.find(selected);
+                    if (!allowed || index == notFound || index >= devices.size()) {
+                        completion(usbError("NotFoundError"_s, "No USB device was selected"_s), { });
+                        return;
+                    }
+                    auto& device = devices[index];
+                    String token;
+                    for (auto& grant : self->m_grants) {
+                        if (grant.value.origin == origin && grant.value.device.path == device.path
+                            && grant.value.device.identity == device.identity) {
+                            token = grant.key;
+                            break;
+                        }
+                    }
+                    if (token.isEmpty()) {
+                        if (self->m_grants.size() >= 256) {
+                            completion(usbError("NotAllowedError"_s, "Too many USB device grants"_s), { });
+                            return;
+                        }
+                        token = WTF::UUID::createVersion4().toString();
+                        self->m_grants.add(token, Grant { origin, device });
+                    }
+                    auto result = JSON::Object::create();
+                    result->setObject("device"_s, deviceJSON(device, token));
+                    completion(result->toJSONString(), { });
+                });
+        });
+    });
+}
+
+// Checked before enqueueing, independently of renderer bindings.
+static bool validOperation(const JSON::Object& args, size_t outputSize)
+{
+    auto op = args.getString("operation"_s);
+    auto number = [&](ASCIILiteral key, unsigned maximum) {
+        auto value = args.getInteger(key);
+        return value && *value >= 0 && unsigned(*value) <= maximum;
+    };
+    if (op == "open"_s || op == "close"_s || op == "forget"_s || op == "reset"_s)
+        return !outputSize;
+    if (op == "selectConfiguration"_s)
+        return !outputSize && number("value"_s, 255);
+    if (op == "claimInterface"_s || op == "releaseInterface"_s)
+        return !outputSize && number("interface"_s, 255);
+    if (op == "selectAlternateInterface"_s)
+        return !outputSize && number("interface"_s, 255) && number("alternate"_s, 255);
+    auto input = args.getBoolean("input"_s);
+    if (!input)
+        return false;
+    if (*input && outputSize)
+        return false;
+    if (op == "clearHalt"_s)
+        return !outputSize && number("endpoint"_s, 15) && args.getInteger("endpoint"_s) != 0;
+    if (op == "controlTransfer"_s) {
+        if (!number("requestType"_s, 2) || !number("recipient"_s, 3) || !number("request"_s, 255)
+            || !number("value"_s, 65535) || !number("index"_s, 65535) || !number("length"_s, 65535))
+            return false;
+        return *input || args.getInteger("length"_s) == outputSize;
+    }
+    if (!number("endpoint"_s, 15) || args.getInteger("endpoint"_s) == 0)
+        return false;
+    if (op == "transfer"_s)
+        return number("length"_s, maximumTransferSize) && (*input || args.getInteger("length"_s) == outputSize);
+    if (op != "isochronousTransfer"_s)
+        return false;
+    auto packets = args.getArray("packetLengths"_s);
+    if (!packets || packets->length() > maximumIsochronousPackets)
+        return false;
+    size_t total = 0;
+    for (auto& packet : *packets) {
+        auto value = packet->asInteger();
+        if (!value || *value < 0 || *value > 32767 || unsigned(*value) > maximumTransferSize - total)
+            return false;
+        total += *value;
+    }
+    return *input || total == outputSize;
+}
+
+static Result operate(Session& session, const Device& approved, const JSON::Object& args, std::span<const uint8_t> bytes)
+{
+    auto op = args.getString("operation"_s);
+    auto n = [&](ASCIILiteral key) { return args.getInteger(key).value_or(0); };
+    bool input = args.getBoolean("input"_s).value_or(false);
+    if (op == "open"_s) return session.open(approved);
+    if (op == "close"_s || op == "forget"_s) { session.close(); return { }; }
+    if (op == "selectConfiguration"_s) return session.selectConfiguration(n("value"_s));
+    if (op == "claimInterface"_s) return session.claimInterface(n("interface"_s));
+    if (op == "releaseInterface"_s) return session.releaseInterface(n("interface"_s));
+    if (op == "selectAlternateInterface"_s) return session.selectAlternateInterface(n("interface"_s), n("alternate"_s));
+    if (op == "clearHalt"_s) return session.clearHalt(input, n("endpoint"_s));
+    if (op == "controlTransfer"_s)
+        return session.controlTransfer(input, n("requestType"_s), n("recipient"_s), n("request"_s), n("value"_s), n("index"_s), n("length"_s), bytes);
+    if (op == "transfer"_s)
+        return session.transfer(input, n("endpoint"_s), n("length"_s), bytes);
+    if (op == "isochronousTransfer"_s) {
+        std::vector<uint32_t> lengths;
+        for (auto& value : *args.getArray("packetLengths"_s))
+            lengths.push_back(*value->asInteger());
+        return session.isochronousTransfer(input, n("endpoint"_s), lengths, bytes);
+    }
+    if (op == "reset"_s) return session.reset();
+    return Result::failure(Error::NotSupported);
+}
+
+void WebUSBBrokerHaiku::request(uint64_t page, const String& owner, const String& origin, const BMessenger& view,
+    const String& arguments, Vector<uint8_t>&& bytes, std::function<bool()>&& isCurrent, Completion&& completion)
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown || !isCurrent()) {
+        completion(usbError("AbortError"_s, "The USB document was closed"_s), { });
+        return;
+    }
+    if (arguments.length() > 65536 || bytes.size() > maximumTransferSize || origin.isEmpty() || origin == "null"_s) {
+        completion(usbError("SecurityError"_s, "Invalid USB request"_s), { });
+        return;
+    }
+    auto parsed = JSON::Value::parseJSON(arguments);
+    auto args = parsed ? parsed->asObject() : nullptr;
+    if (!args) {
+        completion(usbError("TypeError"_s, "Invalid USB request"_s), { });
+        return;
+    }
+    if (args->getString("api"_s) == "hid"_s) {
+        m_hid->request(page, owner, origin, view, args.releaseNonNull(), WTF::move(bytes), std::move(isCurrent), WTF::move(completion));
+        return;
+    }
+    auto op = args->getString("operation"_s);
+    if (op == "getDevices"_s || op == "requestDevice"_s) {
+        if (!bytes.isEmpty()) {
+            completion(usbError("TypeError"_s, "Invalid USB enumeration"_s), { });
+            return;
+        }
+        enumerate(page, owner, origin, view, args.releaseNonNull(), std::move(isCurrent), WTF::move(completion));
+        return;
+    }
+    auto token = args->getString("id"_s);
+    auto found = m_grants.find(token);
+    if (found == m_grants.end() || found->value.origin != origin) {
+        completion(usbError("SecurityError"_s, "This origin has no grant for the USB device"_s), { });
+        return;
+    }
+    if (!validOperation(*args, bytes.size())) {
+        completion(usbError("TypeError"_s, "Invalid USB operation or transfer size"_s), { });
+        return;
+    }
+    auto& grant = found->value;
+    bool closing = op == "close"_s || op == "forget"_s;
+    if (op == "forget"_s && !grant.session) {
+        m_grants.remove(found);
+        completion("{}"_s, { });
+        return;
+    }
+    if (op == "close"_s && !grant.session) {
+        completion("{}"_s, { });
+        return;
+    }
+    if (grant.closing || (grant.pending >= 16 && !closing) || (grant.session && grant.owner != owner)) {
+        completion(usbError("InvalidStateError"_s, "The USB device is already in use"_s), { });
+        return;
+    }
+    if (op == "open"_s && !grant.session) {
+        auto existing = openDevices().find(grant.device.path);
+        if (existing != openDevices().end() && !existing->second.expired()) {
+            completion(usbError("InvalidStateError"_s, "Another page is using this USB device"_s), { });
+            return;
+        }
+        grant.session = std::make_shared<Session>();
+        grant.owner = owner;
+        grant.page = page;
+        openDevices()[grant.device.path] = grant.session;
+    }
+    if (!grant.session) {
+        completion(usbError("InvalidStateError"_s, "The USB device is not open"_s), { });
+        return;
+    }
+    if (closing) {
+        grant.closing = true;
+        grant.session->abort();
+    }
+    ++grant.pending;
+    m_queue->dispatch([self = shared_from_this(), token = token.isolatedCopy(), owner = owner.isolatedCopy(),
+        operation = op.isolatedCopy(), arguments = arguments.isolatedCopy(), approved = grant.device, session = grant.session,
+        bytes = WTF::move(bytes), isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+        auto parsed = JSON::Value::parseJSON(arguments);
+        auto args = parsed->asObject();
+        auto result = operate(*session, approved, *args, bytes.span());
+        auto object = JSON::Object::create();
+        if (result.error != Error::None) {
+            object->setString("error"_s, errorName(result.error));
+            object->setString("message"_s, result.error == Error::NotSupported
+                ? "This USB operation is not supported by Haiku"_s : "The USB operation could not be completed"_s);
+        } else {
+            if (operation == "open"_s || operation == "selectConfiguration"_s || operation == "claimInterface"_s
+                || operation == "releaseInterface"_s || operation == "selectAlternateInterface"_s)
+                object->setObject("device"_s, deviceJSON(session->state(), token));
+            object->setInteger("status"_s, static_cast<unsigned>(result.status));
+            object->setInteger("transferred"_s, result.transferred);
+            auto packets = JSON::Array::create();
+            for (auto& packet : result.packets) {
+                auto value = JSON::Object::create();
+                value->setInteger("status"_s, static_cast<unsigned>(packet.status));
+                value->setInteger("transferred"_s, packet.transferred);
+                packets->pushObject(WTF::move(value));
+            }
+            object->setArray("packets"_s, WTF::move(packets));
+        }
+        RunLoop::mainSingleton().dispatch([self, token = token.isolatedCopy(), owner = owner.isolatedCopy(), session,
+            operation = operation.isolatedCopy(), failed = result.error != Error::None,
+            response = object->toJSONString().isolatedCopy(), bytes = Vector<uint8_t>(std::span<const uint8_t>(result.data)),
+            isCurrent = std::move(isCurrent), completion = WTF::move(completion)]() mutable {
+            auto found = self->m_grants.find(token);
+            if (found != self->m_grants.end() && found->value.session == session) {
+                auto& grant = found->value;
+                --grant.pending;
+                if (operation == "close"_s || operation == "forget"_s || (operation == "open"_s && failed)) {
+                    self->closeGrant(grant);
+                    if (operation == "forget"_s)
+                        self->m_grants.remove(found);
+                }
+            }
+            if (self->m_shutdown || !isCurrent()) {
+                completion(usbError("AbortError"_s, "The USB document was closed"_s), { });
+                return;
+            }
+            completion(WTF::move(response), WTF::move(bytes));
+        });
+    });
+}
+
+void WebUSBBrokerHaiku::closeGrant(Grant& grant)
+{
+    if (auto session = std::exchange(grant.session, nullptr)) {
+        session->abort();
+        m_queue->dispatch([session] { session->close(); });
+    }
+    grant.owner = { };
+    grant.page = 0;
+    grant.pending = 0;
+    grant.closing = false;
+}
+void WebUSBBrokerHaiku::cancelPage(uint64_t page)
+{
+    ASSERT(RunLoop::isMain());
+    m_hid->cancelPage(page);
+    for (auto& grant : m_grants) {
+        if (grant.value.page == page)
+            closeGrant(grant.value);
+    }
+}
+void WebUSBBrokerHaiku::shutdown()
+{
+    ASSERT(RunLoop::isMain());
+    if (m_shutdown)
+        return;
+    m_shutdown = true;
+    m_hid->shutdown();
+    for (auto& grant : m_grants)
+        closeGrant(grant.value);
+    m_grants.clear();
+}
+} // namespace WebKit
+#endif
