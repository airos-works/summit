diff --git a/Source/WebCore/platform/image-decoders/heif/HEIFImageDecoder.cpp b/Source/WebCore/platform/image-decoders/heif/HEIFImageDecoder.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ff37370000fb026776370cdfb5f157988eeb72d2
--- /dev/null
+++ b/Source/WebCore/platform/image-decoders/heif/HEIFImageDecoder.cpp
@@ -0,0 +1,129 @@
+// Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause
+#include "config.h"
+#include "HEIFImageDecoder.h"
+#if USE(HEIF)
+#include "ImageBackingStore.h"
+#if USE(LCMS)
+#include "LCMSUniquePtr.h"
+#endif
+#include <libheif/heif.h>
+#include <algorithm>
+#include <wtf/Scope.h>
+
+namespace WebCore {
+ScalableImageDecoderFrame* HEIFImageDecoder::frameBufferAtIndex(size_t index)
+{
+    assertIsHeld(m_lock);
+    if (index || failed())
+        return nullptr;
+    if (m_frameBufferCache.isEmpty())
+        m_frameBufferCache.grow(1);
+    auto& frame = m_frameBufferCache.first();
+    if (!frame.isComplete())
+        decode(false, isAllDataReceived());
+    return failed() ? nullptr : &frame;
+}
+void HEIFImageDecoder::decode(bool onlySize, bool allDataReceived)
+{
+    assertIsHeld(m_lock);
+    // HEIF item extents can point anywhere in the file. Decode only after
+    // the entire resource has arrived, not an arbitrary partial prefix.
+    if (failed() || !allDataReceived || !m_data)
+        return;
+    constexpr uint64_t maximumPixels = 64 * 1024 * 1024;
+    constexpr uint64_t maximumBytes = 256 * 1024 * 1024;
+    if (m_data->size() > maximumBytes) { setFailed(); return; }
+    auto* context = heif_context_alloc();
+    if (!context) { setFailed(); return; }
+    auto freeContext = makeScopeExit([&] { heif_context_free(context); });
+    auto* limits = heif_context_get_security_limits(context);
+    limits->max_image_size_pixels = maximumPixels;
+    limits->max_memory_block_size = maximumBytes;
+    limits->max_total_memory = maximumBytes * 2;
+    limits->max_color_profile_size = 4 * 1024 * 1024;
+    heif_context_set_max_decoding_threads(context, 2);
+    auto data = m_data->span();
+    if (heif_context_read_from_memory_without_copy(context, data.data(), data.size(), nullptr).code != heif_error_Ok) {
+        setFailed(); return;
+    }
+    heif_image_handle* handle = nullptr;
+    if (heif_context_get_primary_image_handle(context, &handle).code != heif_error_Ok || !handle) {
+        setFailed(); return;
+    }
+    auto freeHandle = makeScopeExit([&] { heif_image_handle_release(handle); });
+    const int width = heif_image_handle_get_width(handle), height = heif_image_handle_get_height(handle);
+    if (width <= 0 || height <= 0 || static_cast<uint64_t>(width) * height > maximumPixels) {
+        setFailed(); return;
+    }
+    if (!isSizeAvailable() && !setSize({ width, height }))
+        return;
+    if (size() != IntSize(width, height)) { setFailed(); return; }
+    if (onlySize)
+        return;
+    heif_image* image = nullptr;
+    auto* options = heif_decoding_options_alloc();
+    if (!options) { setFailed(); return; }
+    auto freeOptions = makeScopeExit([&] { heif_decoding_options_free(options); });
+    options->convert_hdr_to_8bit = 1;
+    options->strict_decoding = 1;
+    options->num_codec_threads = 2;
+    const auto error = heif_decode_image(handle, &image, heif_colorspace_RGB, heif_chroma_interleaved_RGBA, options);
+    auto freeImage = makeScopeExit([&] { if (image) heif_image_release(image); });
+    if (error.code != heif_error_Ok || !image) { setFailed(); return; }
+    int stride = 0;
+    const auto* pixels = heif_image_get_plane_readonly(image, heif_channel_interleaved, &stride);
+    // Decoded plane dimensions, not only container metadata, determine which
+    // bytes are addressable (including cropped/tiled or malformed images).
+    if (!pixels || heif_image_get_width(image, heif_channel_interleaved) != width
+        || heif_image_get_height(image, heif_channel_interleaved) != height
+        || stride < static_cast<int64_t>(width) * 4) { setFailed(); return; }
+    auto& frame = m_frameBufferCache.first();
+    if (!frame.initialize(size(), m_premultiplyAlpha)) { setFailed(); return; }
+    const bool premultiplied = heif_image_is_premultiplied_alpha(image);
+    Vector<uint8_t> converted;
+    if (premultiplied)
+        converted.grow(static_cast<size_t>(width) * 4);
+#if USE(LCMS)
+    LCMSTransformPtr transform;
+    const auto profileSize = heif_image_handle_get_raw_color_profile_size(handle);
+    if (!m_ignoreGammaAndColorProfile && profileSize && profileSize <= 4 * 1024 * 1024) {
+        Vector<uint8_t> profile(profileSize);
+        if (heif_image_handle_get_raw_color_profile(handle, profile.mutableSpan().data()).code == heif_error_Ok) {
+            LCMSProfilePtr input(cmsOpenProfileFromMem(profile.span().data(), profile.size()));
+            LCMSProfilePtr output(cmsCreate_sRGBProfile());
+            if (input && output && cmsGetColorSpace(input.get()) == cmsSigRgbData)
+                transform.reset(cmsCreateTransform(input.get(), TYPE_RGBA_8, output.get(), TYPE_RGBA_8,
+                    INTENT_PERCEPTUAL, cmsFLAGS_COPY_ALPHA));
+        }
+        if (transform)
+            converted.grow(static_cast<size_t>(width) * 4);
+    }
+#endif
+    for (int y = 0; y < height; ++y) {
+        const auto* row = pixels + static_cast<size_t>(y) * stride;
+        if (premultiplied) {
+            auto straight = converted.mutableSpan();
+            for (size_t x = 0; x < static_cast<size_t>(width) * 4; x += 4) {
+                const unsigned alpha = row[x + 3];
+                for (unsigned c = 0; c < 3; ++c)
+                    straight[x + c] = alpha ? std::min(255u, (row[x + c] * 255u + alpha / 2) / alpha) : 0;
+                straight[x + 3] = alpha;
+            }
+            row = straight.data();
+        }
+#if USE(LCMS)
+        if (transform) {
+            cmsDoTransform(transform.get(), row, converted.mutableSpan().data(), width);
+            row = converted.span().data();
+        }
+#endif
+        for (int x = 0; x < width; ++x) {
+            const auto* pixel = row + static_cast<size_t>(x) * 4;
+            frame.backingStore()->setPixel(x, y, pixel[0], pixel[1], pixel[2], pixel[3]);
+        }
+    }
+    frame.setHasAlpha(heif_image_handle_has_alpha_channel(handle));
+    frame.setDecodingStatus(DecodingStatus::Complete);
+}
+}
+#endif
