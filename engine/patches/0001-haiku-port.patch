+void ensureIconPlatformStrategies()
+{
+    ASSERT(RunLoop::isMain());
+    if (hasPlatformStrategies())
+        return;
+    static NeverDestroyed<IconPlatformStrategiesHaiku> strategies;
+    setPlatformStrategies(&strategies.get());
+}
