+
+CaptureSourceOrError HaikuDisplayCaptureFactory::createDisplayCaptureSource(const CaptureDevice& device, MediaDeviceHashSalts&& hashSalts, const MediaConstraints* constraints, std::optional<PageIdentifier> pageIdentifier)
+{
+    return HaikuDisplayCaptureSource::create(device, WTF::move(hashSalts), constraints, pageIdentifier);
+}
+
+// Devices shared by the sources that capture from them.
+//
+// A camera's node and a sound card's input serve one consumer at a time, and
+// pages ask for the same device several times at once: the Teams device
+// check asks for the microphone four times and for the camera five times as
+// it starts, keeps the first streams and asks again with the devices' ids,
+// and every request but the first failed with NotReadableError (20 October
+// 2026). Other browsers hand out as many streams of a device as a page asks
+// for. So this process connects to each device once, for all its sources;
+// their tracks stop and change on their own. Pages in other processes still
+// find the device in use.
+
+class HaikuSharedCamera {
+    WTF_MAKE_NONCOPYABLE(HaikuSharedCamera);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(HaikuSharedCamera);
+public:
+    // Main thread, all of them.
+    static HaikuSharedCamera& forDevice(const String& persistentId, const String& label);
+    static HaikuSharedCamera* existing(const String& persistentId);
+    // Forgets the camera when it has no sources left (which disconnects it).
+    static void releaseIfUnused(const String& persistentId);
+
+    HaikuSharedCamera(const String& persistentId, const String& label)
+        : m_persistentId(persistentId)
+        , m_label(label)
+    {
+    }
+
+    ~HaikuSharedCamera()
+    {
+        // Before the members its handler uses.
+        m_connection = nullptr;
+    }
+
+    // False when the camera cannot be connected; the source is not added.
+    bool addSource(HaikuVideoCaptureSource&, IntSize);
+    void setSourceSize(HaikuVideoCaptureSource&, IntSize);
+    void removeSource(HaikuVideoCaptureSource&);
+
+private:
+    struct Source {
+        ThreadSafeWeakPtr<HaikuVideoCaptureSource> source;
+        const HaikuVideoCaptureSource* identity;
+        IntSize size;
+    };
+
+    bool hasSources();
+    IntSize largestSize();
+    bool update();
+    bool connect(IntSize);
+    void failSources();
+    void pictureReceived(const void*, size_t, const media_format&);
+
+    const String m_persistentId;
+    const String m_label;
+    std::unique_ptr<HaikuCaptureConnection> m_connection;
+    Lock m_lock;
+    Vector<Source> m_sources WTF_GUARDED_BY_LOCK(m_lock);
+    // The size asked of the camera.
+    IntSize m_connectedSize WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+static HashMap<String, std::unique_ptr<HaikuSharedCamera>>& sharedCameras()
+{
+    ASSERT(isMainThread());
+    static NeverDestroyed<HashMap<String, std::unique_ptr<HaikuSharedCamera>>> cameras;
+    return cameras;
+}
+
+HaikuSharedCamera& HaikuSharedCamera::forDevice(const String& persistentId, const String& label)
+{
+    return *sharedCameras().ensure(persistentId, [&] {
+        return makeUnique<HaikuSharedCamera>(persistentId, label);
+    }).iterator->value;
+}
+
+HaikuSharedCamera* HaikuSharedCamera::existing(const String& persistentId)
+{
+    return sharedCameras().get(persistentId);
+}
+
+void HaikuSharedCamera::releaseIfUnused(const String& persistentId)
+{
+    auto iterator = sharedCameras().find(persistentId);
+    if (iterator != sharedCameras().end() && !iterator->value->hasSources())
+        sharedCameras().remove(iterator);
+}
+
+bool HaikuSharedCamera::hasSources()
+{
+    Locker locker { m_lock };
+    return !m_sources.isEmpty();
+}
+
+IntSize HaikuSharedCamera::largestSize()
+{
+    Locker locker { m_lock };
+    IntSize largest;
+    for (auto& source : m_sources) {
+        if (int64_t(source.size.width()) * source.size.height() > int64_t(largest.width()) * largest.height())
+            largest = source.size;
+    }
+    return largest;
+}
+
+bool HaikuSharedCamera::addSource(HaikuVideoCaptureSource& source, IntSize size)
+{
+    {
+        Locker locker { m_lock };
+        m_sources.append({ ThreadSafeWeakPtr { source }, &source, size });
+    }
+    if (update())
+        return true;
+    {
+        Locker locker { m_lock };
+        m_sources.removeFirstMatching([&](auto& entry) {
+            return entry.identity == &source;
+        });
+    }
+    // The others lost the camera with it.
+    failSources();
+    return false;
+}
+
+void HaikuSharedCamera::setSourceSize(HaikuVideoCaptureSource& source, IntSize size)
+{
+    {
+        Locker locker { m_lock };
+        for (auto& entry : m_sources) {
+            if (entry.identity == &source)
+                entry.size = size;
+        }
+    }
+    if (!update())
+        failSources();
+}
+
+void HaikuSharedCamera::removeSource(HaikuVideoCaptureSource& source)
+{
+    {
+        Locker locker { m_lock };
+        m_sources.removeFirstMatching([&](auto& entry) {
+            return entry.identity == &source;
+        });
+    }
+    if (!hasSources()) {
+        m_connection = nullptr;
+        return;
+    }
+    if (!update())
+        failSources();
+}
+
+// The camera runs at the largest size its sources ask for; the others get
+// its pictures cut and scaled to theirs. A new size is a new connection, and
+// when the camera cannot give it, the last one is kept.
+bool HaikuSharedCamera::update()
+{
+    auto size = largestSize();
+    if (size.isEmpty())
+        return false;
+    std::optional<IntSize> previous;
+    {
+        Locker locker { m_lock };
+        if (m_connection && size == m_connectedSize)
+            return true;
+        if (m_connection)
+            previous = m_connectedSize;
+    }
+    // The camera has one output: free it first.
+    m_connection = nullptr;
+    if (connect(size))
+        return true;
+    return previous && connect(*previous);
+}
+
+bool HaikuSharedCamera::connect(IntSize size)
+{
+    auto input = haikuMediaInputWithId(B_MEDIA_RAW_VIDEO, m_persistentId);
+    if (!input)
+        return false;
+
+    media_format format;
+    format.type = B_MEDIA_RAW_VIDEO;
+    format.u.raw_video = media_raw_video_format::wildcard;
+    format.u.raw_video.display.format = B_RGB32;
+    format.u.raw_video.display.line_width = size.width();
+    format.u.raw_video.display.line_count = size.height();
+
+    {
+        Locker locker { m_lock };
+        m_connectedSize = size;
+    }
+    String error;
+    // Destroying the connection waits for its handler, so it never outlives
+    // this object.
+    m_connection = HaikuCaptureConnection::connect(input->node, format, [this](const void* data, size_t bytes, const media_format& format, bigtime_t) {
+        pictureReceived(data, bytes, format);
+    }, error);
+    if (!m_connection) {
+        fprintf(stderr, "Summit: camera \"%s\": %s\n", m_label.utf8().legacyCStringPointer(), error.utf8().legacyCStringPointer());
+        return false;
+    }
+    return true;
+}
+
+// Ends the tracks of a camera that could not be connected again.
+void HaikuSharedCamera::failSources()
+{
+    Vector<ThreadSafeWeakPtr<HaikuVideoCaptureSource>> sources;
+    {
+        Locker locker { m_lock };
+        for (auto& entry : m_sources)
+            sources.append(entry.source);
+    }
+    for (auto& source : sources) {
+        callOnMainThread([source = WTF::move(source)] {
+            if (RefPtr protectedSource = source.get())
+                protectedSource->captureFailed();
+        });
+    }
+}
+
+// `picture` cut to the shape of `size` around its middle and scaled to it.
+static RefPtr<VideoFrameHaiku> fitPicture(const VideoFrameHaiku& picture, IntSize size)
+{
+    auto from = picture.size();
+    if (size.isEmpty() || from.isEmpty())
+        return nullptr;
+    int width = from.width();
+    int height = from.height();
+    if (int64_t(width) * size.height() > int64_t(height) * size.width())
+        width = std::max(2, int(int64_t(height) * size.width() / size.height()) & ~1);
+    else
+        height = std::max(2, int(int64_t(width) * size.height() / size.width()) & ~1);
+    // Even, so the chroma planes line up.
+    int left = ((from.width() - width) / 2) & ~1;
+    int top = ((from.height() - height) / 2) & ~1;
+
+    auto result = VideoFrameHaiku::create(VideoFrameHaiku::Format::I420, size, picture.presentationTime());
+    auto& y = picture.plane(0);
+    auto& u = picture.plane(1);
+    auto& v = picture.plane(2);
+    auto& toY = result->plane(0);
+    auto& toU = result->plane(1);
+    auto& toV = result->plane(2);
+    if (libyuv::I420Scale(y.data + top * y.stride + left, y.stride, u.data + (top / 2) * u.stride + left / 2, u.stride,
+        v.data + (top / 2) * v.stride + left / 2, v.stride, width, height,
+        toY.data, toY.stride, toU.data, toU.stride, toV.data, toV.stride, size.width(), size.height(), libyuv::kFilterBox))
+        return nullptr;
+    return result;
+}
+
+void HaikuSharedCamera::pictureReceived(const void* data, size_t bytes, const media_format& format)
+{
+    Locker locker { m_lock };
+    auto now = MonotonicTime::now();
+    Vector<std::pair<RefPtr<HaikuVideoCaptureSource>, IntSize>, 4> takers;
+    for (auto& entry : m_sources) {
+        RefPtr source = entry.source.get();
+        if (source && source->wantsPicture(now))
+            takers.append({ WTF::move(source), entry.size == m_connectedSize ? IntSize() : entry.size });
+    }
+    if (takers.isEmpty())
+        return;
+
+    auto& video = format.u.raw_video;
+    int width = video.display.line_width;
+    int height = video.display.line_count;
+    if (width <= 0 || height <= 0)
+        return;
+    auto picture = VideoFrameHaiku::create(VideoFrameHaiku::Format::I420, { width, height }, currentMediaTime());
+    auto& y = picture->plane(0);
+    auto& u = picture->plane(1);
+    auto& v = picture->plane(2);
+    int status = -1;
+    switch (video.display.format) {
+    case B_RGB32:
+    case B_RGBA32: {
+        size_t rowBytes = video.display.bytes_per_row ? video.display.bytes_per_row : 4 * width;
+        if (bytes < rowBytes * height)
+            return;
+        status = libyuv::ARGBToI420(static_cast<const uint8_t*>(data), rowBytes, y.data, y.stride, u.data, u.stride, v.data, v.stride, width, height);
+        break;
+    }
+    case B_YCbCr422: {
+        size_t rowBytes = video.display.bytes_per_row ? video.display.bytes_per_row : 2 * width;
+        if (bytes < rowBytes * height)
+            return;
+        status = libyuv::YUY2ToI420(static_cast<const uint8_t*>(data), rowBytes, y.data, y.stride, u.data, u.stride, v.data, v.stride, width, height);
+        break;
+    }
+    default:
+        break;
+    }
+    if (status)
+        return;
+
+    for (auto& [source, fitTo] : takers)
+        source->pictureReceived(picture.get(), fitTo);
+}
+
+class HaikuSharedMicrophone {
+    WTF_MAKE_NONCOPYABLE(HaikuSharedMicrophone);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(HaikuSharedMicrophone);
+public:
+    // Main thread, all of them.
+    static HaikuSharedMicrophone& forDevice(const String& persistentId, const String& label);
+    static HaikuSharedMicrophone* existing(const String& persistentId);
+    static void releaseIfUnused(const String& persistentId);
+
+    HaikuSharedMicrophone(const String& persistentId, const String& label)
+        : m_persistentId(persistentId)
+        , m_label(label)
+    {
+    }
+
+    ~HaikuSharedMicrophone()
+    {
+        // Before the members its handler uses.
+        m_connection = nullptr;
+    }
+
+    // False when the input cannot be connected; the source is not added.
+    bool addSource(HaikuAudioCaptureSource&);
+    void removeSource(HaikuAudioCaptureSource&);
+    double sampleRate() const { return m_connection ? m_connection->format().u.raw_audio.frame_rate : 0; }
+
+private:
+    struct Source {
+        ThreadSafeWeakPtr<HaikuAudioCaptureSource> source;
+        const HaikuAudioCaptureSource* identity;
+    };
+
+    bool hasSources();
+    void samplesReceived(const void*, size_t, const media_format&);
+
+    const String m_persistentId;
+    const String m_label;
+    std::unique_ptr<HaikuCaptureConnection> m_connection;
+    Lock m_lock;
+    Vector<Source> m_sources WTF_GUARDED_BY_LOCK(m_lock);
+    // On the consumer's thread only.
+    Vector<float> m_samples;
+    // Samples waiting for a whole 10 ms chunk when voice processing is on.
+    Vector<float> m_pending;
+    Vector<float> m_unprocessed;
+};
