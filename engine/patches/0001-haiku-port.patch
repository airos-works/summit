+#include <WebCore/HTMLCanvasElement.h>
+#include <WebCore/JSDOMBinding.h>
+#include <WebCore/LocalFrame.h>
+#include <WebCore/LocalFrameInlines.h>
+#include <WebCore/NativeImage.h>
+#include <WebCore/PDFJSDocument.h>
+#include <WebCore/RunJavaScriptParameters.h>
+#include <WebCore/ScriptController.h>
+#include <WebCore/SharedBuffer.h>
+#include <skia/core/SkCanvas.h>
+#include <skia/core/SkImage.h>
+#include <skia/core/SkStream.h>
+#include <skia/core/SkSurface.h>
+#include <skia/docs/SkPDFDocument.h>
+#include <skia/docs/SkPDFJpegHelpers.h>
+#include <wtf/RunLoop.h>
+#include <wtf/text/MakeString.h>
+#include <cmath>
+#include <memory>
+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+// The viewer already owns the authorized/decrypted PDF. Render one requested
+// page at a time in its private canvas, without changing the visible viewer or
+// depending on PDF.js's synchronous window.print service. Only the bundled
+// viewer executes these scripts; no PDF content is evaluated as JavaScript.
+class PDFPrintJob : public std::enable_shared_from_this<PDFPrintJob> {
+public:
+    using Completion = CompletionHandler<void(std::optional<SharedMemoryHandle>&&, uint32_t, IntSize)>;
+
+    PDFPrintJob(PDFJSDocument& document, const PrintInfo& info, uint32_t first, uint32_t count, float rasterScale, Completion&& completion)
+        : m_document(&document)
+        , m_frame(document.viewerFrame())
+        , m_viewer(m_frame ? m_frame->document() : nullptr)
+        , m_first(first), m_count(count), m_next(first), m_rasterScale(rasterScale)
+        , m_completion(WTF::move(completion))
+    {
+        static uint64_t nextToken;
+        m_token = makeString("summit-native-print-"_s, ++nextToken);
+        const double points = 0.75 * info.pageSetupScaleFactor;
+        m_width = (info.availablePaperWidth + info.margin.left() + info.margin.right()) * points;
+        m_height = (info.availablePaperHeight + info.margin.top() + info.margin.bottom()) * points;
+        m_left = info.margin.left() * points;
+        m_top = info.margin.top() * points;
+        m_contentWidth = info.availablePaperWidth * points;
+        m_contentHeight = info.availablePaperHeight * points;
+    }
+
+    void start()
+    {
+        m_timer = std::make_unique<RunLoop::Timer>(RunLoop::mainSingleton(), "PDFPrintJob timeout"_s, [weak = weak_from_this()] {
+            if (auto job = weak.lock())
+                job->finish(false);
+        });
+        if (!isCurrent() || !m_count || !validSize(m_width, m_height) || !validSize(m_contentWidth, m_contentHeight)
+            || !std::isfinite(m_rasterScale)) {
+            finish(false);
+            return;
+        }
+        evaluate(makeString("return window.summitPDFPrint.begin('"_s, m_token, "');"_s), [self = shared_from_this()](ValueOrException result) {
+            if (!self->m_completion)
+                return;
+            if (!self->isCurrent() || !result || !result->isNumber() || result->asNumber() < 1 || result->asNumber() > INT_MAX
+                || result->asNumber() != std::floor(result->asNumber())) {
+                self->finish(false);
+                return;
+            }
+            self->m_pageCount = result->asNumber();
+            if (self->m_first >= self->m_pageCount) {
+                self->finish(true);
+                return;
+            }
+            self->m_end = self->m_first + std::min(self->m_count, self->m_pageCount - self->m_first);
+            if (!self->prepareOutput()) {
+                self->finish(false);
+                return;
+            }
+            self->renderNext();
+        });
+    }
+
+private:
+    static bool validSize(double width, double height)
+    {
+        return std::isfinite(width) && std::isfinite(height) && width > 0 && height > 0 && width <= 32768 && height <= 32768;
+    }
+
+    bool isCurrent() const
+    {
+        return m_document && m_document->frame() && m_document->frame()->page()
+            && m_document->frame()->document() == m_document && m_document->viewerFrame() == m_frame
+            && m_frame && m_viewer && m_frame->document() == m_viewer
+            && m_viewer->url().protocolIs("webkit-pdfjs-viewer"_s);
+    }
+
+    void evaluate(String&& source, CompletionHandler<void(ValueOrException)>&& callback)
+    {
+        m_timer->startOneShot(30_s);
+        JSC::JSLockHolder lock(commonVM());
+        WebCore::RunJavaScriptParameters parameters { WTF::move(source), JSC::SourceTaintedOrigin::Untainted, { },
+            RunAsAsyncFunction::Yes, ArgumentMap { }, ForceUserGesture::No, RemoveTransientActivation::No };
+        m_frame->script().executeAsynchronousUserAgentScriptInWorld(mainThreadNormalWorldSingleton(), WTF::move(parameters), WTF::move(callback));
+    }
+
+    bool prepareOutput()
+    {
+        const double outputScale = m_rasterScale > 0 ? m_rasterScale : 1;
+        if (!validSize(m_width * outputScale, m_height * outputScale))
+            return false;
+        m_size = IntSize(std::ceil(m_width * outputScale), std::ceil(m_height * outputScale));
+        m_renderScale = m_rasterScale > 0 ? m_rasterScale : 200.0 / 72;
+        const double renderWidth = std::ceil(m_contentWidth * m_renderScale);
+        const double renderHeight = std::ceil(m_contentHeight * m_renderScale);
+        if (!validSize(renderWidth, renderHeight) || renderWidth * renderHeight * 4 > (64u << 20))
+            return false;
+        if (m_rasterScale > 0) {
+            m_pageBytes = static_cast<size_t>(m_size.width()) * m_size.height() * 4;
+            if (m_pageBytes > (512u << 20) / (m_end - m_first))
+                return false;
+            m_memory = SharedMemory::allocate(m_pageBytes * (m_end - m_first));
+            return !!m_memory;
+        }
+        SkPDF::Metadata metadata;
+        auto title = m_document->title().utf8();
+        metadata.fTitle = SkString(title.legacyCStringPointer());
+        metadata.fCreator = SkString("Summit");
+        metadata.jpegDecoder = SkPDF::JPEG::Decode;
+        metadata.jpegEncoder = SkPDF::JPEG::Encode;
+        m_pdf = SkPDF::MakeDocument(&m_stream, metadata);
+        return !!m_pdf;
+    }
+
+    void renderNext()
+    {
+        if (!isCurrent()) {
+            finish(false);
+            return;
+        }
+        evaluate(makeString("return window.summitPDFPrint.render('"_s, m_token, "',"_s, m_next + 1, ","_s,
+            static_cast<unsigned>(std::ceil(m_contentWidth * m_renderScale)), ","_s,
+            static_cast<unsigned>(std::ceil(m_contentHeight * m_renderScale)), ");"_s), [self = shared_from_this()](ValueOrException result) {
+            if (!self->m_completion)
+                return;
+            if (!self->isCurrent() || !result || !result->isTrue() || !self->copyPage()) {
+                self->finish(false);
+                return;
+            }
+            if (++self->m_next == self->m_end)
+                self->finish(true);
+            else
+                self->renderNext();
+        });
+    }
+
+    bool copyPage()
+    {
+        RefPtr canvasElement = dynamicDowncast<HTMLCanvasElement>(m_viewer->getElementById(AtomString(m_token)));
+        RefPtr image = canvasElement ? canvasElement->copyNativeImage() : nullptr;
+        if (!image || !image->platformImage())
+            return false;
+        auto native = image->platformImage();
+        const double fit = std::min(m_contentWidth / native->width(), m_contentHeight / native->height());
+        const float width = native->width() * fit, height = native->height() * fit;
+        const auto destination = SkRect::MakeXYWH(m_left + (m_contentWidth - width) / 2, m_top + (m_contentHeight - height) / 2, width, height);
+        sk_sp<SkSurface> surface;
+        SkCanvas* canvas;
+        if (m_rasterScale > 0) {
+            surface = SkSurfaces::WrapPixels(SkImageInfo::MakeN32Premul(m_size.width(), m_size.height()),
+                m_memory->mutableSpan().subspan(m_pageBytes * (m_next - m_first)).data(), m_size.width() * 4);
+            if (!surface)
+                return false;
+            canvas = surface->getCanvas();
+            canvas->clear(SK_ColorWHITE);
+            canvas->scale(m_rasterScale, m_rasterScale);
+        } else {
+            canvas = m_pdf->beginPage(m_width, m_height);
+            if (!canvas)
+                return false;
+        }
+        canvas->drawImageRect(native, destination, SkSamplingOptions(SkFilterMode::kLinear));
+        if (m_pdf)
+            m_pdf->endPage();
+        // Bound the accumulated PDF stream as well as each rendered canvas.
+        return m_stream.bytesWritten() <= (512u << 20);
+    }
+
+    void finish(bool success)
+    {
+        if (!m_completion)
+            return;
+        auto completion = WTF::move(m_completion);
+        if (m_timer)
+            m_timer->stop();
+        std::optional<SharedMemoryHandle> handle;
+        if (success && m_pdf) {
+            m_pdf->close();
+            if (m_stream.bytesWritten() <= (512u << 20)) {
+                auto data = SharedBuffer::create(m_stream.detachAsData());
+                m_memory = SharedMemory::copyBuffer(data.get());
+            }
+        }
+        if (success && m_memory)
+            handle = m_memory->createHandle(SharedMemory::Protection::ReadOnly);
+        if (isCurrent()) {
+            JSC::JSLockHolder lock(commonVM());
+            WebCore::RunJavaScriptParameters parameters { makeString("window.summitPDFPrint?.release('"_s, m_token, "');"_s),
+                JSC::SourceTaintedOrigin::Untainted, { }, RunAsAsyncFunction::No, std::nullopt, ForceUserGesture::No, RemoveTransientActivation::No };
+            m_frame->script().executeAsynchronousUserAgentScriptInWorld(mainThreadNormalWorldSingleton(), WTF::move(parameters), [](ValueOrException) { });
+        }
+        m_pdf = nullptr;
+        m_memory = nullptr;
+        m_document = nullptr;
+        m_viewer = nullptr;
+        m_frame = nullptr;
+        completion(WTF::move(handle), success ? m_pageCount : 0, m_size);
+    }
+
+    RefPtr<PDFJSDocument> m_document;
+    RefPtr<LocalFrame> m_frame;
+    RefPtr<Document> m_viewer;
+    String m_token;
+    uint32_t m_first, m_count, m_next, m_end { 0 }, m_pageCount { 0 };
+    float m_rasterScale;
+    double m_width, m_height, m_left, m_top, m_contentWidth, m_contentHeight, m_renderScale { 1 };
+    IntSize m_size;
+    size_t m_pageBytes { 0 };
+    RefPtr<SharedMemory> m_memory;
+    SkDynamicMemoryWStream m_stream;
+    sk_sp<SkDocument> m_pdf;
+    Completion m_completion;
+    std::unique_ptr<RunLoop::Timer> m_timer;
+};
+}
+
+void drawPDFPagesForPrintingHaiku(PDFJSDocument& document, const PrintInfo& info, uint32_t first, uint32_t count, float rasterScale, PDFPrintJob::Completion&& completion)
+{
+    std::make_shared<PDFPrintJob>(document, info, first, count, rasterScale, WTF::move(completion))->start();
+}
+}
+#endif // ENABLE(PDFJS)
