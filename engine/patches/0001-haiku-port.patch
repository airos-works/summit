+// Opus.
+
+static bool isOpusSampleRate(uint64_t rate)
+{
+    return rate == 8000 || rate == 12000 || rate == 16000 || rate == 24000 || rate == 48000;
+}
+
+// Other rates (44.1 kHz above all) go through libopus at 48 kHz: resampled in
+// 10 ms pieces for encoding, and decoded as 48 kHz audio, as WebCodecs allows.
+static bool isResampledOpusRate(uint64_t rate)
+{
+    return !isOpusSampleRate(rate) && rate >= 8000 && rate <= 192000 && !(rate % 100);
+}
+
+static unsigned opusCodecRate(uint64_t rate)
+{
+    return isOpusSampleRate(rate) ? rate : 48000;
+}
+
+// AAC and MP3 through FFmpeg (libavcodec), loaded when first needed, as for
+// WebRTC's H.264 (LibWebRTCH264DecoderHaiku.cpp): only functions are looked
+// up, and only the leading members of AVPacket and AVFrame are used.
+namespace {
+
+struct AVPacketPrefix {
+    void* buf;
+    int64_t pts;
+    int64_t dts;
+    uint8_t* data;
+    int size;
+};
+
+struct AVFramePrefix {
+    uint8_t* data[8];
+    int linesize[8];
+    uint8_t** extendedData;
+    int width;
+    int height;
+    int sampleCount;
+    int format;
+};
+
+// AVSampleFormat values, unchanged since FFmpeg 1.
+enum : int { sampleU8, sampleS16, sampleS32, sampleFloat, sampleDouble, sampleU8Planar, sampleS16Planar, sampleS32Planar, sampleFloatPlanar, sampleDoublePlanar };
+
+constexpr int averrorEAGAIN = EDOM > 0 ? -EAGAIN : EAGAIN;
+
+struct FFmpegAudio {
+    void* (*findDecoderByName)(const char*);
+    void* (*allocContext)(const void*);
+    int (*open)(void*, const void*, void**);
+    void (*freeContext)(void**);
+    void* (*allocPacket)();
+    void (*freePacket)(void**);
+    int (*sendPacket)(void*, const void*);
+    int (*receiveFrame)(void*, void*);
+    void* (*allocFrame)();
+    void (*freeFrame)(void**);
+    void (*flushBuffers)(void*);
+
+    // Encoding, when the libraries are FFmpeg 6 or 8: AVFrame's channel
+    // layout and sample rate are past the prefix, at offsets of those
+    // versions (libavutil 58 and 60), as is the codec context's sample
+    // format (no AVOption sets it); the rest of the context is set up
+    // through AVOptions.
+    bool canEncode { false };
+    size_t frameChannelLayoutOffset { 0 };
+    size_t frameSampleRateOffset { 0 };
+    size_t contextSampleFormatOffset { 0 };
+    // AVCodecContext::extradata and extradata_size: FLAC's and Vorbis's
+    // headers (the WebCodecs description), for those versions only.
+    size_t contextExtradataOffset { 0 };
+    void* (*mallocz)(size_t) { nullptr };
+    void* (*findEncoderByName)(const char*);
+    int (*sendFrame)(void*, const void*);
+    int (*receivePacket)(void*, void*);
+    void (*unrefPacket)(void*);
+    int (*setOptionInt)(void*, const char*, int64_t, int);
+    int (*setOptionChannelLayout)(void*, const char*, const void*, int);
+    int (*getOptionInt)(void*, const char*, int, int64_t*);
+    int (*setOption)(void*, const char*, const char*, int) { nullptr };
+    void (*defaultChannelLayout)(void*, int);
+    void (*uninitChannelLayout)(void*);
+    int (*frameGetBuffer)(void*, int);
+    void (*unrefFrame)(void*);
+
+    static const FFmpegAudio* load()
+    {
+        static const FFmpegAudio* loaded = [] () -> const FFmpegAudio* {
+            void* avcodec = nullptr;
+            for (const char* name : { "libavcodec.so.62", "libavcodec.so.61", "libavcodec.so.60", "libavcodec.so.59", "libavcodec.so.58" }) {
+                if ((avcodec = dlopen(name, RTLD_NOW | RTLD_LOCAL)))
+                    break;
+            }
+            void* avutil = nullptr;
+            for (const char* name : { "libavutil.so.60", "libavutil.so.59", "libavutil.so.58", "libavutil.so.57", "libavutil.so.56" }) {
+                if ((avutil = dlopen(name, RTLD_NOW | RTLD_LOCAL)))
+                    break;
+            }
+            if (!avcodec || !avutil)
+                return nullptr;
+            auto* ffmpeg = new FFmpegAudio;
+            bool complete = true;
+            auto find = [&](void* library, const char* name) {
+                void* symbol = dlsym(library, name);
+                complete = complete && symbol;
+                return symbol;
+            };
+            ffmpeg->findDecoderByName = reinterpret_cast<void* (*)(const char*)>(find(avcodec, "avcodec_find_decoder_by_name"));
+            ffmpeg->allocContext = reinterpret_cast<void* (*)(const void*)>(find(avcodec, "avcodec_alloc_context3"));
+            ffmpeg->open = reinterpret_cast<int (*)(void*, const void*, void**)>(find(avcodec, "avcodec_open2"));
+            ffmpeg->freeContext = reinterpret_cast<void (*)(void**)>(find(avcodec, "avcodec_free_context"));
+            ffmpeg->allocPacket = reinterpret_cast<void* (*)()>(find(avcodec, "av_packet_alloc"));
+            ffmpeg->freePacket = reinterpret_cast<void (*)(void**)>(find(avcodec, "av_packet_free"));
+            ffmpeg->sendPacket = reinterpret_cast<int (*)(void*, const void*)>(find(avcodec, "avcodec_send_packet"));
+            ffmpeg->receiveFrame = reinterpret_cast<int (*)(void*, void*)>(find(avcodec, "avcodec_receive_frame"));
+            ffmpeg->allocFrame = reinterpret_cast<void* (*)()>(find(avutil, "av_frame_alloc"));
+            ffmpeg->freeFrame = reinterpret_cast<void (*)(void**)>(find(avutil, "av_frame_free"));
+            ffmpeg->flushBuffers = reinterpret_cast<void (*)(void*)>(find(avcodec, "avcodec_flush_buffers"));
+            if (!complete) {
+                delete ffmpeg;
+                return nullptr;
+            }
+            auto* avcodecVersion = reinterpret_cast<unsigned (*)()>(dlsym(avcodec, "avcodec_version"));
+            auto* avutilVersion = reinterpret_cast<unsigned (*)()>(dlsym(avutil, "avutil_version"));
+            unsigned avcodecMajor = avcodecVersion ? avcodecVersion() >> 16 : 0;
+            unsigned avutilMajor = avutilVersion ? avutilVersion() >> 16 : 0;
+            if (avcodecMajor == 60 && avutilMajor == 58) {
+                ffmpeg->frameChannelLayoutOffset = 448;
+                ffmpeg->frameSampleRateOffset = 208;
+                ffmpeg->contextSampleFormatOffset = 360;
+                ffmpeg->contextExtradataOffset = 88;
+            } else if (avcodecMajor == 62 && avutilMajor == 60) {
+                ffmpeg->frameChannelLayoutOffset = 384;
+                ffmpeg->frameSampleRateOffset = 180;
+                ffmpeg->contextSampleFormatOffset = 348;
+                ffmpeg->contextExtradataOffset = 72;
+            }
+            if (ffmpeg->frameChannelLayoutOffset) {
+                ffmpeg->mallocz = reinterpret_cast<void* (*)(size_t)>(dlsym(avutil, "av_mallocz"));
+                if (!ffmpeg->mallocz)
+                    ffmpeg->contextExtradataOffset = 0;
+                complete = true;
+                ffmpeg->findEncoderByName = reinterpret_cast<void* (*)(const char*)>(find(avcodec, "avcodec_find_encoder_by_name"));
+                ffmpeg->sendFrame = reinterpret_cast<int (*)(void*, const void*)>(find(avcodec, "avcodec_send_frame"));
+                ffmpeg->receivePacket = reinterpret_cast<int (*)(void*, void*)>(find(avcodec, "avcodec_receive_packet"));
+                ffmpeg->unrefPacket = reinterpret_cast<void (*)(void*)>(find(avcodec, "av_packet_unref"));
+                ffmpeg->setOptionInt = reinterpret_cast<int (*)(void*, const char*, int64_t, int)>(find(avutil, "av_opt_set_int"));
+                ffmpeg->setOptionChannelLayout = reinterpret_cast<int (*)(void*, const char*, const void*, int)>(find(avutil, "av_opt_set_chlayout"));
+                ffmpeg->getOptionInt = reinterpret_cast<int (*)(void*, const char*, int, int64_t*)>(find(avutil, "av_opt_get_int"));
+                ffmpeg->setOption = reinterpret_cast<int (*)(void*, const char*, const char*, int)>(find(avutil, "av_opt_set"));
+                ffmpeg->defaultChannelLayout = reinterpret_cast<void (*)(void*, int)>(find(avutil, "av_channel_layout_default"));
+                ffmpeg->uninitChannelLayout = reinterpret_cast<void (*)(void*)>(find(avutil, "av_channel_layout_uninit"));
+                ffmpeg->frameGetBuffer = reinterpret_cast<int (*)(void*, int)>(find(avutil, "av_frame_get_buffer"));
+                ffmpeg->unrefFrame = reinterpret_cast<void (*)(void*)>(find(avutil, "av_frame_unref"));
+                ffmpeg->canEncode = complete;
+            }
+            return ffmpeg;
+        }();
+        return loaded;
+    }
+};
+
+} // namespace
+
+static bool isAACCodec(StringView codec)
+{
+    return codec == "mp4a.40.2"_s || codec == "mp4a.40.02"_s || codec == "mp4a.40.5"_s || codec == "mp4a.40.05"_s || codec == "mp4a.40.29"_s;
+}
+
+// FFmpeg's decoder for a WebCodecs audio codec string.
+static const char* ffmpegDecoderName(StringView codec)
+{
+    if (isAACCodec(codec))
+        return "aac";
+    if (codec == "mp3"_s)
+        return "mp3float";
+    if (codec == "flac"_s)
+        return "flac";
+    if (codec == "vorbis"_s)
+        return "vorbis";
+    return nullptr;
+}
+
+// FLAC and Vorbis decoders need their headers (the description) as extradata.
+static bool needsExtradata(StringView codec)
+{
+    return codec == "flac"_s || codec == "vorbis"_s;
+}
+
+// WebCodecs' PCM codecs (https://w3c.github.io/webcodecs/pcm_codec_registration.html):
+// interleaved little-endian samples, A-law and mu-law bytes.
+enum class PCMCodec : uint8_t { U8, S16, S24, S32, F32, ALaw, MuLaw };
+
+static std::optional<PCMCodec> pcmCodec(StringView codec)
+{
+    if (codec == "pcm-u8"_s)
+        return PCMCodec::U8;
+    if (codec == "pcm-s16"_s)
+        return PCMCodec::S16;
+    if (codec == "pcm-s24"_s)
+        return PCMCodec::S24;
+    if (codec == "pcm-s32"_s)
+        return PCMCodec::S32;
+    if (codec == "pcm-f32"_s)
+        return PCMCodec::F32;
+    if (codec == "alaw"_s)
+        return PCMCodec::ALaw;
+    if (codec == "ulaw"_s)
+        return PCMCodec::MuLaw;
+    return std::nullopt;
+}
+
+static size_t pcmSampleSize(PCMCodec codec)
+{
+    switch (codec) {
+    case PCMCodec::U8: case PCMCodec::ALaw: case PCMCodec::MuLaw: return 1;
+    case PCMCodec::S16: return 2;
+    case PCMCodec::S24: return 3;
+    case PCMCodec::S32: case PCMCodec::F32: return 4;
+    }
+    return 1;
+}
+
+// G.711, as ITU-T's reference code expands and compresses it.
+static int16_t aLawToLinear(uint8_t value)
+{
+    value ^= 0x55;
+    int segment = (value & 0x70) >> 4;
+    int sample = (value & 0x0f) << 4;
+    sample += segment ? 0x108 : 8;
+    if (segment > 1)
+        sample <<= segment - 1;
+    return (value & 0x80) ? sample : -sample;
+}
+
+static int16_t muLawToLinear(uint8_t value)
+{
+    value = ~value;
+    int sample = (((value & 0x0f) << 3) + 0x84) << ((value & 0x70) >> 4);
+    return (value & 0x80) ? 0x84 - sample : sample - 0x84;
+}
+
+static uint8_t linearToALaw(int16_t sample)
+{
+    int value = sample >> 3;
+    uint8_t mask = value >= 0 ? 0xd5 : 0x55;
+    if (value < 0)
+        value = -value - 1;
+    static constexpr std::array<int, 8> ends { 0x1f, 0x3f, 0x7f, 0xff, 0x1ff, 0x3ff, 0x7ff, 0xfff };
+    int segment = 0;
+    while (segment < 8 && value > ends[segment])
+        ++segment;
+    if (segment == 8)
+        return 0x7f ^ mask;
+    uint8_t result = segment << 4;
+    result |= segment < 2 ? (value >> 1) & 0x0f : (value >> segment) & 0x0f;
+    return result ^ mask;
+}
+
+static uint8_t linearToMuLaw(int16_t sample)
+{
+    int value = sample >> 2;
+    uint8_t mask = 0xff;
+    if (value < 0) {
+        value = -value;
+        mask = 0x7f;
+    }
+    value = std::min(value, 8159) + 0x21;
+    static constexpr std::array<int, 8> ends { 0x3f, 0x7f, 0xff, 0x1ff, 0x3ff, 0x7ff, 0xfff, 0x1fff };
+    int segment = 0;
+    while (segment < 8 && value > ends[segment])
+        ++segment;
+    if (segment == 8)
+        return 0x7f ^ mask;
+    return ((segment << 4) | ((value >> (segment + 1)) & 0x0f)) ^ mask;
+}
+
+bool isWebCodecsAudioCodecSupportedHaiku(StringView codec)
+{
+    if (codec == "opus"_s || pcmCodec(codec))
+        return true;
+    auto* name = ffmpegDecoderName(codec);
+    auto* ffmpeg = name ? FFmpegAudio::load() : nullptr;
+    if (ffmpeg && needsExtradata(codec) && !ffmpeg->contextExtradataOffset)
+        return false;
+    return ffmpeg && ffmpeg->findDecoderByName(name);
+}
+
+// FFmpeg's encoder for a WebCodecs audio codec string: AAC LC and FLAC
+// (FFmpeg's own), HE-AAC (v1 and v2, Fraunhofer's FDK), MP3 (LAME) and
+// Vorbis (libvorbis), when the libraries have them.
+static const char* ffmpegEncoderName(StringView codec)
+{
+    if (codec == "mp4a.40.2"_s || codec == "mp4a.40.02"_s)
+        return "aac";
+    if (codec == "mp4a.40.5"_s || codec == "mp4a.40.05"_s || codec == "mp4a.40.29"_s)
+        return "libfdk_aac";
+    if (codec == "mp3"_s)
+        return "libmp3lame";
+    if (codec == "flac"_s)
+        return "flac";
+    if (codec == "vorbis"_s)
+        return "libvorbis";
+    return nullptr;
+}
+
+// ISO 14496-3's sampling frequency index, or 15 for a rate not in its table.
+static unsigned aacFrequencyIndex(unsigned sampleRate)
+{
+    static constexpr std::array rates { 96000u, 88200u, 64000u, 48000u, 44100u, 32000u, 24000u, 22050u, 16000u, 12000u, 11025u, 8000u, 7350u };
+    auto found = std::ranges::find(rates, sampleRate);
+    return found == rates.end() ? 15 : found - rates.begin();
+}
+
+// An AAC LC AudioSpecificConfig: the description of a raw AAC stream.
+static Vector<uint8_t> aacAudioSpecificConfig(unsigned sampleRate, unsigned channels)
+{
+    unsigned frequencyIndex = aacFrequencyIndex(sampleRate);
+    unsigned channelConfiguration = channels == 8 ? 7 : channels;
+    uint64_t bits = 2;
+    unsigned length = 5;
+    auto append = [&](uint64_t value, unsigned count) {
+        bits = (bits << count) | value;
+        length += count;
+    };
+    append(frequencyIndex, 4);
+    if (frequencyIndex == 15)
+        append(sampleRate, 24);
+    append(channelConfiguration, 4);
+    append(0, 3); // 1024-sample frames, no core coder, no extension.
+    unsigned padded = (length + 7) / 8 * 8;
+    bits <<= padded - length;
+    Vector<uint8_t> config;
+    for (unsigned shift = padded; shift; shift -= 8)
+        config.append(static_cast<uint8_t>(bits >> (shift - 8)));
+    return config;
+}
+
+// An AudioSpecificConfig (ISO 14496-3) as the fields of an ADTS header: the
+// profile, sampling frequency index and channel configuration.
+struct ADTSFields {
+    unsigned profile { 1 };
+    unsigned frequencyIndex { 4 };
+    unsigned channelConfiguration { 2 };
+};
+
+static std::optional<ADTSFields> adtsFieldsFromAudioSpecificConfig(std::span<const uint8_t> config)
+{
+    if (config.size() < 2)
+        return std::nullopt;
+    uint32_t bits = (config[0] << 8) | config[1];
+    unsigned objectType = bits >> 11;
+    unsigned frequencyIndex = (bits >> 7) & 0xf;
+    unsigned channels = (bits >> 3) & 0xf;
+    // An explicit frequency, or HE-AAC's core: ADTS can name only the 13 table
+    // rates and AAC LC (the decoder finds SBR and PS itself).
+    if (frequencyIndex == 15 || objectType == 31 || !channels || channels > 7)
+        return std::nullopt;
+    if (objectType != 2 && objectType != 5 && objectType != 29)
+        return std::nullopt;
+    return ADTSFields { 1, frequencyIndex, channels };
+}
+
+static Vector<uint8_t> adtsFrame(const ADTSFields& fields, std::span<const uint8_t> payload)
+{
+    size_t length = payload.size() + 7;
+    Vector<uint8_t> frame {
+        0xff, 0xf1,
+        static_cast<uint8_t>((fields.profile << 6) | (fields.frequencyIndex << 2) | (fields.channelConfiguration >> 2)),
+        static_cast<uint8_t>(((fields.channelConfiguration & 3) << 6) | (length >> 11)),
+        static_cast<uint8_t>(length >> 3),
+        static_cast<uint8_t>(((length & 7) << 5) | 0x1f),
+        0xfc,
+    };
+    frame.append(payload);
+    return frame;
+}
+
+// The 19-byte identification header (RFC 7845) a decoder may be given.
+static Vector<uint8_t> opusHead(unsigned channels, unsigned preSkip, unsigned sampleRate)
+{
+    return { 'O', 'p', 'u', 's', 'H', 'e', 'a', 'd', 1, static_cast<uint8_t>(channels),
+        static_cast<uint8_t>(preSkip), static_cast<uint8_t>(preSkip >> 8),
+        static_cast<uint8_t>(sampleRate), static_cast<uint8_t>(sampleRate >> 8), static_cast<uint8_t>(sampleRate >> 16), static_cast<uint8_t>(sampleRate >> 24),
+        0, 0, 0 };
+}
