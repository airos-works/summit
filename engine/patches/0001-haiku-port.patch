 };
 
+#if PLATFORM(HAIKU)
+// userScripts.register() IDs live beside scripting.registerContentScripts()
+// IDs, which may not start with '_', so the prefix keeps the two apart.
+static constexpr auto webExtensionUserScriptPrefix = "_us:"_s;
+inline bool isWebExtensionUserScriptIdentifier(const String& identifier) { return identifier.startsWith(webExtensionUserScriptPrefix); }
+#endif
+
