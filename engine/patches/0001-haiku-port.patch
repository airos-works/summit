+#if ENABLE(DRAG_SUPPORT)
+void WebView::startDragHaiku(WebCore::PasteboardCustomData&& data, OptionSet<WebCore::DragOperation> operations,
+    RefPtr<WebCore::ShareableBitmap>&& image, const WebCore::IntPoint& hotspot, const String& title)
+{
+    BMessage message(viewStartDragHaiku);
+    message.AddUInt32("operations", operations.toRaw());
+    message.AddString("summit:title", title.utf8().legacyCStringPointer());
+    message.AddPoint("hotspot", BPoint(hotspot.x(), hotspot.y()));
+    // The private payload preserves same-origin custom types. Native apps see
+    // standard MIME fields only; private browser bookkeeping is never sourced
+    // from arbitrary DataTransfer field names.
+    if (auto png = data.readBuffer("image/png"_s); png && png->size() <= 16 * 1024 * 1024)
+        message.AddData("image/png", B_MIME_TYPE, png->span().data(), png->size());
+    data.clear("image/png"_s);
+    size_t textBytes = 0;
+    data.forEachPlatformString([&](const String&, const String& text) { textBytes += text.utf8().length(); });
+    auto serialized = data.createSharedBuffer();
+    if (serialized->size() + textBytes > 1024 * 1024) {
+        m_page->dragCancelled();
+        return;
+    }
+    message.AddData("org.webkit.drag-data", B_RAW_TYPE, serialized->span().data(), serialized->size());
+    data.forEachPlatformString([&](const String& type, const String& text) {
+        if (type == "text/plain"_s || type == "text/html"_s || type == "text/uri-list"_s) {
+            auto bytes = text.utf8();
+            message.AddData(type.utf8().legacyCStringPointer(), B_MIME_TYPE, bytes.data(), bytes.length());
+        }
+    });
+    if (image && image->size().width() <= 2048 && image->size().height() <= 2048
+        && image->pixelFormat() == WebCore::PixelFormat::BGRA8) {
+        message.AddInt32("width", image->size().width());
+        message.AddInt32("height", image->size().height());
+        message.AddInt32("stride", image->bytesPerRow());
+        message.AddData("preview", B_RAW_TYPE, image->span().data(), image->span().size());
+    }
+    if (nativeView().SendMessage(&message, static_cast<BHandler*>(nullptr), 0) != B_OK)
+        m_page->dragCancelled();
+}
+
+void WebView::didPerformDragOperation(bool handled)
+{
+    if (m_dropSession && m_dropSource.IsValid()) {
+        BMessage reply(viewNativeDragReplyHaiku);
+        reply.AddUInt64("session", m_dropSession);
+        reply.AddPoint("screen", m_dropScreenPoint);
+        auto operation = handled ? m_page->currentDragOperation().value_or(WebCore::DragOperation::Copy) : static_cast<WebCore::DragOperation>(0);
+        reply.AddUInt32("operation", static_cast<uint32_t>(operation));
+        m_dropSource.SendMessage(&reply, static_cast<BHandler*>(nullptr), 0);
+    }
+    m_dropSource = { };
+    m_dropSession = 0;
+    m_dragFiles.clear();
+    m_dragData.clear();
+    m_page->resetCurrentDragInformation();
+}
+#endif
