+namespace WebCore {
+
+// One database per thread, as the font cache that owns it on Cocoa. The
+// shorthand cache holds AtomStrings, which belong to the thread that made
+// them (each thread has its own atom table): a database shared by the
+// process cached the main thread's family name, and a worker thread
+// resetting that cache when it ended (ThreadGlobalData::destroy ->
+// FontCache::invalidate) died in AtomStringImpl::remove, the string not
+// being in its table (laptop, 16 October 2026). GLib's shared database gets
+// away with it because its family is a static string. The entry is reset
+// before the thread's atom table goes, by that same invalidate().
+SystemFontDatabase& SystemFontDatabase::singleton()
+{
+    static NeverDestroyed<ThreadSpecific<std::unique_ptr<SystemFontDatabase>>> databases;
+    auto& database = *databases.get();
+    if (!database)
+        database = std::unique_ptr<SystemFontDatabase>(new SystemFontDatabase);
+    return *database;
+}
+
+// The system font shorthands (caption, menu, -webkit-small-control...) name
+// the system's own font: form controls, which the user agent stylesheet sets
+// in -webkit-small-control, take it when a page gives them no font of its
+// own. This used to answer with the standard family, Times, so every such
+// control came out in a serif font, which looked like a missing font.
+auto SystemFontDatabase::platformSystemFontShorthandInfo(FontShorthand fontShorthand) -> SystemFontShorthandInfo
+{
+    const BFont* font = fontShorthand == FontShorthand::Caption ? be_bold_font : be_plain_font;
+    font_family family;
+    font_style style;
+    font->GetFamilyAndStyle(&family, &style);
+    // Haiku font sizes are points at 72 dpi, which are CSS pixels; app_server
+    // scales them to the display's density, as the page's scale factor does.
+    float size = std::max(11.0f, be_plain_font->Size());
+    if (fontShorthand == FontShorthand::WebkitMiniControl)
+        size = std::max(9.0f, size - 2);
+    return { AtomString::fromUTF8(family), size, fontShorthand == FontShorthand::Caption ? boldWeightValue() : normalWeightValue() };
+}
+
+void SystemFontDatabase::platformInvalidate()
+{
+}
+
+} // namespace WebCore
