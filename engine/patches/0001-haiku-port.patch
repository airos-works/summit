+status_t WebKit::validatePageSettingsHaiku(const BMessage& settings)
+{
+    static constexpr struct { const char* name; type_code type; } fields[] {
+        { "standardFont", B_STRING_TYPE }, { "serifFont", B_STRING_TYPE },
+        { "sansSerifFont", B_STRING_TYPE }, { "fixedFont", B_STRING_TYPE },
+        { "standardFontSize", B_INT32_TYPE }, { "fixedFontSize", B_INT32_TYPE },
+        { "javascriptEnabled", B_BOOL_TYPE }, { "userAgent", B_STRING_TYPE },
+        { "minimumFontSize", B_INT32_TYPE }, { "caretBrowsing", B_BOOL_TYPE },
+        { "reducedMotion", B_BOOL_TYPE }, { "increasedContrast", B_BOOL_TYPE }
+    };
+    int32 supplied = 0;
+    for (const auto& field : fields) {
+        type_code type;
+        int32 count;
+        if (settings.GetInfo(field.name, &type, &count) != B_OK)
+            continue;
+        if (type != field.type || count != 1)
+            return B_BAD_VALUE;
+        ++supplied;
+        if (type == B_STRING_TYPE) {
+            const char* value = settings.GetString(field.name, "");
+            if (String::fromUTF8(value).isNull() || (!*value && strcmp(field.name, "userAgent")))
+                return B_BAD_VALUE;
+        } else if (type == B_INT32_TYPE) {
+            int32 value = settings.GetInt32(field.name, 0);
+            bool minimum = !strcmp(field.name, "minimumFontSize");
+            if (value < (minimum ? 0 : 1) || value > (minimum ? 72 : 512))
+                return B_BAD_VALUE;
+        }
+    }
+    if (supplied != settings.CountNames(B_ANY_TYPE))
+        return B_BAD_VALUE;
+    return B_OK;
+}
+
+void WebKit::applyPageSettingsHaiku(WebPageProxy& page, const BMessage& settings)
+{
+    if (!settings.CountNames(B_ANY_TYPE))
+        return;
+    // Opened pages may share their configuration's preferences object.
+    // Never mutate it in place when a host changes one native view.
+    Ref preferences = page.preferences().copy();
+    const char* value;
+    if (settings.FindString("standardFont", &value) == B_OK)
+        preferences->setStandardFontFamily(String::fromUTF8(value));
+    if (settings.FindString("serifFont", &value) == B_OK)
+        preferences->setSerifFontFamily(String::fromUTF8(value));
+    if (settings.FindString("sansSerifFont", &value) == B_OK)
+        preferences->setSansSerifFontFamily(String::fromUTF8(value));
+    if (settings.FindString("fixedFont", &value) == B_OK)
+        preferences->setFixedFontFamily(String::fromUTF8(value));
+    int32 size;
+    if (settings.FindInt32("standardFontSize", &size) == B_OK)
+        preferences->setDefaultFontSize(size);
+    if (settings.FindInt32("fixedFontSize", &size) == B_OK)
+        preferences->setDefaultFixedFontSize(size);
+    bool enabled;
+    if (settings.FindBool("javascriptEnabled", &enabled) == B_OK)
+        preferences->setJavaScriptEnabled(enabled);
+    if (settings.FindInt32("minimumFontSize", &size) == B_OK)
+        preferences->setMinimumFontSize(size);
+    if (settings.FindBool("caretBrowsing", &enabled) == B_OK)
+        preferences->setCaretBrowsingEnabled(enabled);
+    auto forced = [](bool on) { return static_cast<uint32_t>(on ? WebCore::ForcedAccessibilityValue::On : WebCore::ForcedAccessibilityValue::System); };
+    if (settings.FindBool("reducedMotion", &enabled) == B_OK)
+        preferences->setForcedPrefersReducedMotionAccessibilityValue(forced(enabled));
+    if (settings.FindBool("increasedContrast", &enabled) == B_OK)
+        preferences->setForcedPrefersContrastAccessibilityValue(forced(enabled));
+    page.setPreferences(preferences);
+    if (settings.FindString("userAgent", &value) == B_OK)
+        page.setCustomUserAgent(String::fromUTF8(value));
+}
+
+status_t BWebKitView::SetPageSettings(const BMessage& settings)
+{
+    if (m_status != B_OK)
+        return m_status;
+    if (status_t status = validatePageSettingsHaiku(settings); status != B_OK)
+        return status;
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, settings] {
+        if (auto* page = pageHaiku(state))
+            applyPageSettingsHaiku(*page, settings);
+    });
+    return B_OK;
+}
