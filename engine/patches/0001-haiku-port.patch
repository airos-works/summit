+
+namespace {
+
+std::string utf8(const String& text)
+{
+    auto data = text.utf8();
+    return std::string(data.legacyCStringPointer(), data.length());
+}
+
+// Runs function on WebKit's main thread and waits at most timeout for its
+// JSON text. The waiting side may give up; the main thread then drops it.
+struct MainThreadResult {
+    std::mutex lock;
+    std::condition_variable condition;
+    bool done { false };
+    bool abandoned { false };
+    std::string text;
+    bigtime_t queuedAt { 0 };
+    bigtime_t startedAt { 0 };
+};
+
+std::string onMainThread(Function<Ref<JSON::Object>()>&& function, bigtime_t timeout, bool& responsive, double& queueDelayMs)
+{
+    if (RunLoop::isMain()) {
+        responsive = true;
+        queueDelayMs = 0;
+        return utf8(function()->toJSONString());
+    }
+    auto result = std::make_shared<MainThreadResult>();
+    result->queuedAt = system_time();
+    RunLoop::mainSingleton().dispatch([result, function = WTF::move(function)]() mutable {
+        {
+            std::lock_guard guard(result->lock);
+            if (result->abandoned)
+                return;
+            result->startedAt = system_time();
+        }
+        auto text = utf8(function()->toJSONString());
+        std::lock_guard guard(result->lock);
+        if (result->abandoned)
+            return;
+        result->text = WTF::move(text);
+        result->done = true;
+        result->condition.notify_all();
+    });
+    std::unique_lock guard(result->lock);
+    result->condition.wait_for(guard, std::chrono::microseconds(timeout), [&] { return result->done; });
+    responsive = result->done;
+    queueDelayMs = result->startedAt ? (result->startedAt - result->queuedAt) / 1000.0 : -1;
+    if (!result->done) {
+        result->abandoned = true;
+        return { };
+    }
+    return result->text;
+}
+
+std::string mainThreadNote(bool responsive, double queueDelayMs, bigtime_t timeout)
+{
+    char text[200];
+    if (responsive)
+        snprintf(text, sizeof(text), "{\"responsive\":true,\"queueDelayMs\":%.1f}", queueDelayMs);
+    else
+        snprintf(text, sizeof(text), "{\"responsive\":false,\"note\":\"WebKit's main thread did not answer within %lld ms\"}",
+            static_cast<long long>(timeout / 1000));
+    return text;
+}
+
+Ref<JSON::Object> processesReport()
+{
+    auto report = JSON::Object::create();
+    auto processes = JSON::Array::create();
+    for (auto& process : WebProcessProxy::allProcesses()) {
+        auto entry = JSON::Object::create();
+        entry->setInteger("team"_s, process->processID());
+        entry->setBoolean("launching"_s, process->isLaunching());
+        entry->setBoolean("prewarmed"_s, process->isPrewarmed());
+        entry->setBoolean("responsive"_s, process->responsivenessTimer().isResponsive());
+        entry->setBoolean("serviceWorkers"_s, process->isRunningServiceWorkers());
+        auto pages = JSON::Array::create();
+        for (auto& page : process->pages()) {
+            auto item = JSON::Object::create();
+            item->setDouble("pageIdentifier"_s, page->webPageIDInMainFrameProcess().toUInt64());
+            item->setDouble("webPageProxyIdentifier"_s, page->identifier().toUInt64());
+            item->setString("url"_s, page->currentURL());
+            item->setBoolean("closed"_s, page->isClosed());
+            pages->pushObject(WTF::move(item));
+        }
+        entry->setArray("pages"_s, WTF::move(pages));
+        processes->pushObject(WTF::move(entry));
+    }
+    report->setArray("webProcesses"_s, WTF::move(processes));
+    auto networks = JSON::Array::create();
+    for (auto& network : NetworkProcessProxy::allNetworkProcesses()) {
+        auto entry = JSON::Object::create();
+        entry->setInteger("team"_s, network->processID());
+        entry->setBoolean("launching"_s, network->isLaunching());
+        networks->pushObject(WTF::move(entry));
+    }
+    report->setArray("networkProcesses"_s, WTF::move(networks));
+    return report;
+}
+
+} // namespace
+
+std::string BWebKitDiagnostics(bigtime_t timeout)
+{
+    bool responsive = false;
+    double queueDelayMs = -1;
+    std::string processes = onMainThread([] { return processesReport(); }, timeout, responsive, queueDelayMs);
+    auto local = JSON::Object::create();
+    local->setDouble("displayScale"_s, displayScaleFactorHaiku());
+    const char* pressure = getenv("SUMMIT_MEMORY_PRESSURE_PERCENT");
+    local->setInteger("memoryPressurePercent"_s, pressure ? atoi(pressure) : 90);
+    local->setBoolean("memoryPressureMonitor"_s, !getenv("WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR"));
+    std::string answer = "{\"engine\":" + utf8(local->toJSONString());
+    if (responsive)
+        answer += ",\"processes\":" + processes;
+    answer += ",\"mainThread\":" + mainThreadNote(responsive, queueDelayMs, timeout) + "}";
+    return answer;
+}
+
+std::string BWebKitProcessDiagnostics(team_id team, const char* request, bigtime_t timeout)
+{
+    return utf8(ProcessDiagnosticsHaiku::request(team, String::fromUTF8(request ? request : "{}"), Seconds::fromMicroseconds(timeout)));
+}
+
+std::string BWebKitView::Diagnostics(bigtime_t timeout) const
+{
+    auto state = m_state;
+    auto local = JSON::Object::create();
+    {
+        std::lock_guard guard(state->mutex);
+        auto& geometry = state->geometry;
+        local->setInteger("width"_s, geometry.size.width());
+        local->setInteger("height"_s, geometry.size.height());
+        local->setInteger("screenX"_s, geometry.screenOrigin.x());
+        local->setInteger("screenY"_s, geometry.screenOrigin.y());
+        local->setDouble("scale"_s, geometry.scale);
+        local->setBoolean("attached"_s, geometry.attached);
+        local->setBoolean("visible"_s, geometry.visible);
+        local->setBoolean("focused"_s, geometry.focused);
+        local->setBoolean("active"_s, geometry.active);
+        local->setBoolean("directTarget"_s, state->directTarget && state->directTarget->enabled());
+    }
+    local->setBoolean("presentedDirectly"_s, state->presentedDirectly.load());
+    local->setDouble("directFrames"_s, state->directFrames.load());
+    local->setBoolean("closed"_s, state->closed.load());
+    if (auto frame = state->presenter.snapshot()) {
+        auto last = JSON::Object::create();
+        last->setDouble("identifier"_s, frame->identifier);
+        last->setInteger("viewWidth"_s, frame->viewSize.width());
+        last->setInteger("viewHeight"_s, frame->viewSize.height());
+        last->setDouble("scale"_s, frame->scale);
+        if (frame->image) {
+            last->setInteger("pixelWidth"_s, frame->image->Bounds().IntegerWidth() + 1);
+            last->setInteger("pixelHeight"_s, frame->image->Bounds().IntegerHeight() + 1);
+        }
+        local->setObject("lastFrame"_s, WTF::move(last));
+    }
+    bool responsive = false;
+    double queueDelayMs = -1;
+    std::string page = onMainThread([state] {
+        auto report = JSON::Object::create();
+        RefPtr client = state->client;
+        RefPtr page = client ? client->page() : nullptr;
+        if (!page) {
+            report->setBoolean("page"_s, false);
+            return report;
+        }
+        report->setInteger("webProcess"_s, page->legacyMainFrameProcess().processID());
+        report->setBoolean("webProcessResponsive"_s, page->legacyMainFrameProcess().responsivenessTimer().isResponsive());
+        report->setDouble("pageIdentifier"_s, page->webPageIDInMainFrameProcess().toUInt64());
+        report->setDouble("webPageProxyIdentifier"_s, page->identifier().toUInt64());
+        report->setString("url"_s, page->currentURL());
+        report->setDouble("pageZoom"_s, page->pageZoomFactor());
+        report->setBoolean("closed"_s, page->isClosed());
+        report->setBoolean("loading"_s, page->pageLoadState().isLoading());
+        report->setString("loadOutcome"_s, String::fromLatin1(state->load.outcome));
+        return report;
+    }, timeout, responsive, queueDelayMs);
+    std::string answer = "{\"view\":" + utf8(local->toJSONString());
+    if (responsive)
+        answer += ",\"page\":" + page;
+    answer += ",\"mainThread\":" + mainThreadNote(responsive, queueDelayMs, timeout) + "}";
+    return answer;
+}
+
+BBitmap* BWebKitView::CopyPresentedFrame() const
+{
+    auto frame = m_state->presenter.snapshot();
+    if (!frame || !frame->image)
+        return nullptr;
+    auto* copy = new BBitmap(frame->image.get());
+    if (copy->InitCheck() != B_OK) {
+        delete copy;
+        return nullptr;
+    }
+    return copy;
+}
