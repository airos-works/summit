+std::shared_ptr<WebUSBBrokerHaiku> WebUSBBrokerHaiku::create(std::shared_ptr<SitePermissionsHaiku> permissions)
+{
+    return std::shared_ptr<WebUSBBrokerHaiku>(new WebUSBBrokerHaiku(std::move(permissions)));
+}
+WebUSBBrokerHaiku::WebUSBBrokerHaiku(std::shared_ptr<SitePermissionsHaiku> permissions)
+    : m_permissions(permissions), m_queue(usbQueue()), m_hid(WebHIDBrokerHaiku::create(std::move(permissions), usbQueue())) { }
+WebUSBBrokerHaiku::~WebUSBBrokerHaiku() { shutdown(); }
