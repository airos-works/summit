+    static std::shared_ptr<WebHIDBrokerHaiku> create(std::shared_ptr<SitePermissionsHaiku>, Ref<WorkQueue>&&);
+    ~WebHIDBrokerHaiku();
+    void request(uint64_t page, const String& owner, const String& origin, const BMessenger&,
+        Ref<JSON::Object>&&, Vector<uint8_t>&&, std::function<bool()>&& isCurrent, Completion&&);
+    void cancelPage(uint64_t page);
+    void shutdown();
+private:
+    WebHIDBrokerHaiku(std::shared_ptr<SitePermissionsHaiku>, Ref<WorkQueue>&&);
+    struct Grant {
+        String origin;
+        HIDHaiku::Interface device;
+        String owner;
+        uint64_t page { 0 };
+        std::shared_ptr<HIDHaiku::Connection> connection;
+        uint64_t connectionId { 0 };
+        bool opening { false };
+        bool gone { false };
+        unsigned pending { 0 };
+        Deque<std::pair<uint8_t, Vector<uint8_t>>> reports;
+        size_t reportBytes { 0 };
+        // A pending "receive": answered when input arrives or after a while.
+        std::unique_ptr<Completion> waiting;
+        uint64_t waitingId { 0 };
+    };
+    void enumerate(const String& origin, const BMessenger&, Ref<JSON::Object>&&, std::function<bool()>&&, Completion&&);
+    void open(const String& token, Grant&, const String& owner, uint64_t page, Completion&&);
+    void receive(Grant&, Completion&&);
+    void input(uint64_t connectionId, uint8_t reportId, Vector<uint8_t>&&, bool gone);
+    void answerWaiting(Grant&);
+    void closeGrant(Grant&);
+    const std::shared_ptr<SitePermissionsHaiku> m_permissions;
+    const Ref<WorkQueue> m_queue;
+    HashMap<String, std::unique_ptr<Grant>> m_grants;
+    uint64_t m_lastId { 0 };
+    unsigned m_enumerations { 0 };
