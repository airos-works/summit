+namespace {
+
+class OpusAudioDecoderHaiku final : public AudioDecoder {
+public:
+    static RefPtr<OpusAudioDecoderHaiku> create(const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+    {
+        if ((!isOpusSampleRate(config.sampleRate) && !isResampledOpusRate(config.sampleRate)) || !config.numberOfChannels || config.numberOfChannels > 2)
+            return nullptr;
+        int error = OPUS_OK;
+        auto* decoder = opus_decoder_create(opusCodecRate(config.sampleRate), config.numberOfChannels, &error);
+        if (!decoder || error != OPUS_OK)
+            return nullptr;
+        return adoptRef(*new OpusAudioDecoderHaiku(decoder, config, WTF::move(outputCallback)));
+    }
+
+    ~OpusAudioDecoderHaiku()
+    {
+        opus_decoder_destroy(m_decoder);
+    }
+
+private:
+    OpusAudioDecoderHaiku(OpusDecoder* decoder, const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+        : m_decoder(decoder)
+        , m_sampleRate(opusCodecRate(config.sampleRate))
+        , m_channels(config.numberOfChannels)
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs Opus decoder"_s))
+    {
+    }
+
+    Ref<DecodePromise> decode(AudioEncodedData&& chunk) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, chunk = WTF::move(chunk).isolatedCopy()] mutable {
+            return protectedThis->decodeOnQueue(WTF::move(chunk));
+        });
+    }
+
+    Ref<DecodePromise> decodeOnQueue(AudioEncodedData&& chunk)
+    {
+        if (m_isClosed)
+            return DecodePromise::createAndReject("The decoder is closed"_s);
+        // At most 120 ms a packet.
+        constexpr int maximumFrames = 5760;
+        Vector<float> pcm(maximumFrames * m_channels);
+        auto data = chunk.data->span();
+        int frames = opus_decode_float(m_decoder, data.data(), data.size(), pcm.mutableSpan().data(), maximumFrames, 0);
+        if (frames < 0)
+            return DecodePromise::createAndReject(makeString("Opus decoding failed: "_s, String::fromLatin1(opus_strerror(frames))));
+        pcm.shrink(frames * m_channels);
+        auto buffer = SharedBuffer::create(asBytes(pcm.span()));
+        m_outputCallback(DecodedData { PlatformRawAudioDataHaiku::create(WTF::move(buffer), AudioSampleFormat::F32, m_sampleRate, chunk.timestamp, frames, m_channels) });
+        return DecodePromise::createAndResolve();
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [] { return GenericPromise::createAndResolve(); });
+    }
+
+    void reset() final
+    {
+        m_queue->dispatch([protectedThis = Ref { *this }] {
+            opus_decoder_ctl(protectedThis->m_decoder, OPUS_RESET_STATE);
+        });
+    }
+
+    void close() final { m_isClosed = true; }
+
+    OpusDecoder* const m_decoder;
+    const unsigned m_sampleRate;
+    const unsigned m_channels;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    std::atomic<bool> m_isClosed { false };
+};
