+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WEBUSB)
+
+#include "Document.h"
+#include "ExceptionOr.h"
+#include "USBDirection.h"
+#include "USBEndpointType.h"
+#include "USBTransferStatus.h"
+#include <JavaScriptCore/DataView.h>
+#include <wtf/JSONValues.h>
+#include <wtf/RefCounted.h>
+
+namespace WebCore {
+
+class USBDevice;
+class USBConfiguration;
+class USBInterface;
+class USBAlternateInterface;
+class USBEndpoint;
+
+class USBDeviceState final : public RefCounted<USBDeviceState> {
+public:
+    static Ref<USBDeviceState> create(Document& document, Ref<JSON::Object>&& value)
+    { return adoptRef(*new USBDeviceState(document, WTF::move(value))); }
+    Ref<JSON::Object> data;
+    WeakPtr<Document, WeakPtrImplWithEventTargetData> document;
+    bool opened { false };
+    bool busy { false };
+    bool forgotten { false };
+private:
+    USBDeviceState(Document& document, Ref<JSON::Object>&& value)
+        : data(WTF::move(value)), document(document) { }
+};
+
+RefPtr<JSON::Object> usbFind(const JSON::Object&, ASCIILiteral array, ASCIILiteral key, unsigned value);
+unsigned usbNumber(const JSON::Object&, ASCIILiteral key);
+
+class USBConfiguration final : public RefCounted<USBConfiguration> {
+public:
+    static ExceptionOr<Ref<USBConfiguration>> create(USBDevice&, uint8_t);
+    static Ref<USBConfiguration> create(USBDeviceState& state, Ref<JSON::Object>&& value)
+    { return adoptRef(*new USBConfiguration(state, WTF::move(value))); }
+    uint8_t configurationValue() const { return usbNumber(m_data, "configurationValue"_s); }
+    String configurationName() const { return m_data->getString("configurationName"_s); }
+    Vector<Ref<USBInterface>> interfaces() const;
+    USBDeviceState& state() const { return m_state; }
+    JSON::Object& data() const { return m_data; }
+private:
+    USBConfiguration(USBDeviceState& state, Ref<JSON::Object>&& data) : m_state(state), m_data(WTF::move(data)) { }
+    Ref<USBDeviceState> m_state;
+    Ref<JSON::Object> m_data;
+};
+
+class USBInterface final : public RefCounted<USBInterface> {
+public:
+    static ExceptionOr<Ref<USBInterface>> create(USBConfiguration&, uint8_t);
+    static Ref<USBInterface> create(USBDeviceState& state, uint8_t configuration, Ref<JSON::Object>&& value)
+    { return adoptRef(*new USBInterface(state, configuration, WTF::move(value))); }
+    uint8_t interfaceNumber() const { return usbNumber(m_data, "interfaceNumber"_s); }
+    bool claimed() const;
+    Ref<USBAlternateInterface> alternate() const;
+    Vector<Ref<USBAlternateInterface>> alternates() const;
+    USBDeviceState& state() const { return m_state; }
+    uint8_t configurationValue() const { return m_configuration; }
+    JSON::Object& data() const { return m_data; }
+private:
+    USBInterface(USBDeviceState& state, uint8_t configuration, Ref<JSON::Object>&& data)
+        : m_state(state), m_configuration(configuration), m_data(WTF::move(data)) { }
+    RefPtr<JSON::Object> current() const;
+    Ref<USBDeviceState> m_state;
+    uint8_t m_configuration;
+    Ref<JSON::Object> m_data;
+};
+
+class USBAlternateInterface final : public RefCounted<USBAlternateInterface> {
+public:
+    static ExceptionOr<Ref<USBAlternateInterface>> create(USBInterface&, uint8_t);
+    static Ref<USBAlternateInterface> create(Ref<JSON::Object>&& value)
+    { return adoptRef(*new USBAlternateInterface(WTF::move(value))); }
+    uint8_t alternateSetting() const { return usbNumber(m_data, "alternateSetting"_s); }
+    uint8_t interfaceClass() const { return usbNumber(m_data, "interfaceClass"_s); }
+    uint8_t interfaceSubclass() const { return usbNumber(m_data, "interfaceSubclass"_s); }
+    uint8_t interfaceProtocol() const { return usbNumber(m_data, "interfaceProtocol"_s); }
+    String interfaceName() const { return m_data->getString("interfaceName"_s); }
+    Vector<Ref<USBEndpoint>> endpoints() const;
+    JSON::Object& data() const { return m_data; }
+private:
+    explicit USBAlternateInterface(Ref<JSON::Object>&& data) : m_data(WTF::move(data)) { }
+    Ref<JSON::Object> m_data;
+};
+
+class USBEndpoint final : public RefCounted<USBEndpoint> {
+public:
+    static ExceptionOr<Ref<USBEndpoint>> create(USBAlternateInterface&, uint8_t, USBDirection);
+    static Ref<USBEndpoint> create(Ref<JSON::Object>&& value)
+    { return adoptRef(*new USBEndpoint(WTF::move(value))); }
+    uint8_t endpointNumber() const { return usbNumber(m_data, "endpointNumber"_s); }
+    USBDirection direction() const { return m_data->getBoolean("input"_s).value_or(false) ? USBDirection::In : USBDirection::Out; }
+    USBEndpointType type() const
+    {
+        switch (usbNumber(m_data, "type"_s)) {
+        case 1: return USBEndpointType::Isochronous;
+        case 3: return USBEndpointType::Interrupt;
+        default: return USBEndpointType::Bulk;
+        }
+    }
+    uint32_t packetSize() const { return usbNumber(m_data, "packetSize"_s); }
+private:
+    explicit USBEndpoint(Ref<JSON::Object>&& data) : m_data(WTF::move(data)) { }
+    Ref<JSON::Object> m_data;
+};
+
+class USBInTransferResult final : public RefCounted<USBInTransferResult> {
+public:
+    static Ref<USBInTransferResult> create(USBTransferStatus status, RefPtr<JSC::DataView>&& data = nullptr)
+    { return adoptRef(*new USBInTransferResult(status, WTF::move(data))); }
+    USBTransferStatus status() const { return m_status; }
+    JSC::DataView* data() const { return m_data.get(); }
+private:
+    USBInTransferResult(USBTransferStatus status, RefPtr<JSC::DataView>&& data) : m_status(status), m_data(WTF::move(data)) { }
+    USBTransferStatus m_status;
+    RefPtr<JSC::DataView> m_data;
+};
+
+class USBIsochronousInTransferPacket final : public RefCounted<USBIsochronousInTransferPacket> {
+public:
+    static Ref<USBIsochronousInTransferPacket> create(USBTransferStatus status, RefPtr<JSC::DataView>&& data = nullptr)
+    { return adoptRef(*new USBIsochronousInTransferPacket(status, WTF::move(data))); }
+    USBTransferStatus status() const { return m_status; }
+    JSC::DataView* data() const { return m_data.get(); }
+private:
+    USBIsochronousInTransferPacket(USBTransferStatus status, RefPtr<JSC::DataView>&& data) : m_status(status), m_data(WTF::move(data)) { }
+    USBTransferStatus m_status;
+    RefPtr<JSC::DataView> m_data;
+};
+
+class USBOutTransferResult final : public RefCounted<USBOutTransferResult> {
+public:
+    static Ref<USBOutTransferResult> create(USBTransferStatus status, uint32_t bytesWritten = 0)
+    { return adoptRef(*new USBOutTransferResult(status, bytesWritten)); }
+    USBTransferStatus status() const { return m_status; }
+    uint32_t bytesWritten() const { return m_bytesWritten; }
+private:
+    USBOutTransferResult(USBTransferStatus status, uint32_t bytesWritten) : m_status(status), m_bytesWritten(bytesWritten) { }
+    USBTransferStatus m_status;
+    uint32_t m_bytesWritten;
+};
+
+class USBIsochronousOutTransferPacket final : public RefCounted<USBIsochronousOutTransferPacket> {
+public:
+    static Ref<USBIsochronousOutTransferPacket> create(USBTransferStatus status, uint32_t bytesWritten = 0)
+    { return adoptRef(*new USBIsochronousOutTransferPacket(status, bytesWritten)); }
+    USBTransferStatus status() const { return m_status; }
+    uint32_t bytesWritten() const { return m_bytesWritten; }
+private:
+    USBIsochronousOutTransferPacket(USBTransferStatus status, uint32_t bytesWritten) : m_status(status), m_bytesWritten(bytesWritten) { }
+    USBTransferStatus m_status;
+    uint32_t m_bytesWritten;
+};
+
+class USBIsochronousInTransferResult final : public RefCounted<USBIsochronousInTransferResult> {
+public:
+    static Ref<USBIsochronousInTransferResult> create(Vector<Ref<USBIsochronousInTransferPacket>>&& packets, RefPtr<JSC::DataView>&& data = nullptr)
+    { return adoptRef(*new USBIsochronousInTransferResult(WTF::move(packets), WTF::move(data))); }
+    const Vector<Ref<USBIsochronousInTransferPacket>>& packets() const { return m_packets; }
+    JSC::DataView* data() const { return m_data.get(); }
+private:
+    USBIsochronousInTransferResult(Vector<Ref<USBIsochronousInTransferPacket>>&& packets, RefPtr<JSC::DataView>&& data)
+        : m_packets(WTF::move(packets)), m_data(WTF::move(data)) { }
+    Vector<Ref<USBIsochronousInTransferPacket>> m_packets;
+    RefPtr<JSC::DataView> m_data;
+};
+class USBIsochronousOutTransferResult final : public RefCounted<USBIsochronousOutTransferResult> {
+public:
+    static Ref<USBIsochronousOutTransferResult> create(Vector<Ref<USBIsochronousOutTransferPacket>>&& packets)
+    { return adoptRef(*new USBIsochronousOutTransferResult(WTF::move(packets))); }
+    const Vector<Ref<USBIsochronousOutTransferPacket>>& packets() const { return m_packets; }
+private:
+    explicit USBIsochronousOutTransferResult(Vector<Ref<USBIsochronousOutTransferPacket>>&& packets) : m_packets(WTF::move(packets)) { }
+    Vector<Ref<USBIsochronousOutTransferPacket>> m_packets;
+};
+} // namespace WebCore
+#endif
diff --git a/Source/WebCore/Modules/webusb/USBDevice.cpp b/Source/WebCore/Modules/webusb/USBDevice.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f025824a0eed9c78087de9124cbae1f7a93486d3
--- /dev/null
+++ b/Source/WebCore/Modules/webusb/USBDevice.cpp
@@ -0,0 +1,315 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "USBDevice.h"
+#include "JSDOMConvertInterface.h"
+#include "JSDOMPromiseDeferred.h"
+#include "JSUSBInTransferResult.h"
+#include "JSUSBOutTransferResult.h"
+#include "JSUSBIsochronousInTransferResult.h"
+#include "JSUSBIsochronousOutTransferResult.h"
+#include "USB.h"
+#include <JavaScriptCore/ArrayBuffer.h>
+
+namespace WebCore {
+static constexpr size_t maximumTransferSize = 16 * 1024 * 1024;
+
+RefPtr<USBConfiguration> USBDevice::configuration() const
+{
+    auto number = usbNumber(m_state->data, "configurationValue"_s);
+    if (!number)
+        return nullptr;
+    auto value = usbFind(m_state->data, "configurations"_s, "configurationValue"_s, number);
+    return value ? USBConfiguration::create(m_state, value.releaseNonNull()).ptr() : nullptr;
+}
+Vector<Ref<USBConfiguration>> USBDevice::configurations() const
+{
+    Vector<Ref<USBConfiguration>> result;
+    if (auto values = m_state->data->getArray("configurations"_s)) {
+        for (auto& value : *values) {
+            if (auto data = value->asObject())
+                result.append(USBConfiguration::create(m_state, data.releaseNonNull()));
+        }
+    }
+    return result;
+}
+void USBDevice::disconnected() { m_state->opened = false; }
+Ref<JSON::Object> USBDevice::arguments(ASCIILiteral operation) const
+{
+    auto result = JSON::Object::create();
+    result->setString("operation"_s, operation);
+    result->setString("id"_s, identifier());
+    return result;
+}
+void USBDevice::changeState(Ref<JSON::Object>&& args, DOMPromiseDeferred<void>&& promise)
+{
+    auto operation = args->getString("operation"_s);
+    bool closing = operation == "close"_s || operation == "forget"_s;
+    if (m_state->busy || (m_transfers && !closing)) {
+        promise.reject(ExceptionCode::InvalidStateError, "A USB operation is still pending"_s);
+        return;
+    }
+    if (!m_state->opened && operation != "open"_s && operation != "forget"_s && operation != "close"_s) {
+        promise.reject(ExceptionCode::InvalidStateError, "The USB device is not open"_s);
+        return;
+    }
+    if ((operation == "open"_s && opened()) || (operation == "close"_s && !opened())) {
+        promise.resolve();
+        return;
+    }
+    m_state->busy = true;
+    USB::perform(m_state->document.get(), WTF::move(args), { },
+        [this, protectedThis = Ref { *this }, operation, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+            m_state->busy = false;
+            if (response.hasException()) {
+                promise.reject(response.releaseException());
+                return;
+            }
+            auto result = response.releaseReturnValue();
+            if (auto state = result->getObject("device"_s))
+                m_state->data = state.releaseNonNull();
+            if (operation == "open"_s)
+                m_state->opened = true;
+            else if (operation == "close"_s || operation == "forget"_s)
+                m_state->opened = false;
+            if (operation == "forget"_s)
+                m_state->forgotten = true;
+            promise.resolve();
+        });
+}
+void USBDevice::open(DOMPromiseDeferred<void>&& promise) { changeState(arguments("open"_s), WTF::move(promise)); }
+void USBDevice::close(DOMPromiseDeferred<void>&& promise) { changeState(arguments("close"_s), WTF::move(promise)); }
+void USBDevice::forget(DOMPromiseDeferred<void>&& promise) { changeState(arguments("forget"_s), WTF::move(promise)); }
+void USBDevice::reset(DOMPromiseDeferred<void>&& promise) { changeState(arguments("reset"_s), WTF::move(promise)); }
+void USBDevice::selectConfiguration(uint8_t value, DOMPromiseDeferred<void>&& promise)
+{
+    auto args = arguments("selectConfiguration"_s);
+    args->setInteger("value"_s, value);
+    changeState(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::claimInterface(uint8_t number, DOMPromiseDeferred<void>&& promise)
+{
+    auto args = arguments("claimInterface"_s);
+    args->setInteger("interface"_s, number);
+    changeState(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::releaseInterface(uint8_t number, DOMPromiseDeferred<void>&& promise)
+{
+    auto args = arguments("releaseInterface"_s);
+    args->setInteger("interface"_s, number);
+    changeState(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::selectAlternateInterface(uint8_t number, uint8_t alternate, DOMPromiseDeferred<void>&& promise)
+{
+    auto args = arguments("selectAlternateInterface"_s);
+    args->setInteger("interface"_s, number);
+    args->setInteger("alternate"_s, alternate);
+    changeState(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::clearHalt(USBDirection direction, uint8_t endpoint, DOMPromiseDeferred<void>&& promise)
+{
+    auto args = arguments("clearHalt"_s);
+    args->setBoolean("input"_s, direction == USBDirection::In);
+    args->setInteger("endpoint"_s, endpoint);
+    changeState(WTF::move(args), WTF::move(promise));
+}
+
+void USBDevice::transfer(Ref<JSON::Object>&& args, Vector<uint8_t>&& bytes, USB::Completion&& completion)
+{
+    if (!opened() || m_state->busy) {
+        completion(Exception { ExceptionCode::InvalidStateError, "The USB device is not ready"_s }, { });
+        return;
+    }
+    if (m_transfers >= 16) {
+        completion(Exception { ExceptionCode::QuotaExceededError, "Too many pending USB transfers"_s }, { });
+        return;
+    }
+    ++m_transfers;
+    USB::perform(m_state->document.get(), WTF::move(args), WTF::move(bytes),
+        [this, protectedThis = Ref { *this }, completion = WTF::move(completion)](auto&& response, auto&& data) mutable {
+            --m_transfers;
+            completion(WTF::move(response), WTF::move(data));
+        });
+}
+static USBTransferStatus transferStatus(const JSON::Object& object)
+{
+    switch (usbNumber(object, "status"_s)) {
+    case 1: return USBTransferStatus::Stall;
+    case 2: return USBTransferStatus::Babble;
+    default: return USBTransferStatus::Ok;
+    }
+}
+void USBDevice::inputTransfer(Ref<JSON::Object>&& args, InPromise&& promise)
+{
+    auto length = args->getInteger("length"_s);
+    if (!length || *length < 0 || unsigned(*length) > maximumTransferSize) {
+        promise.reject(ExceptionCode::RangeError, "USB transfer exceeds 16 MiB"_s);
+        return;
+    }
+    args->setBoolean("input"_s, true);
+    transfer(WTF::move(args), { }, [promise = WTF::move(promise)](auto&& response, auto&& bytes) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        auto status = transferStatus(result);
+        RefPtr<JSC::DataView> data;
+        if (status != USBTransferStatus::Stall)
+            data = JSC::DataView::create(JSC::ArrayBuffer::create(bytes.span()));
+        promise.resolve(USBInTransferResult::create(status, WTF::move(data)));
+    });
+}
+void USBDevice::outputTransfer(Ref<JSON::Object>&& args, std::span<const uint8_t> output, OutPromise&& promise)
+{
+    if (output.size() > maximumTransferSize) {
+        promise.reject(ExceptionCode::RangeError, "USB transfer exceeds 16 MiB"_s);
+        return;
+    }
+    args->setBoolean("input"_s, false);
+    args->setInteger("length"_s, output.size());
+    transfer(WTF::move(args), Vector<uint8_t>(output), [promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        promise.resolve(USBOutTransferResult::create(transferStatus(result), usbNumber(result, "transferred"_s)));
+    });
+}
+static void controlArguments(JSON::Object& args, const USBControlTransferParameters& setup)
+{
+    args.setInteger("requestType"_s, static_cast<uint8_t>(setup.requestType));
+    args.setInteger("recipient"_s, static_cast<uint8_t>(setup.recipient));
+    args.setInteger("request"_s, setup.request);
+    args.setInteger("value"_s, setup.value);
+    args.setInteger("index"_s, setup.index);
+}
+void USBDevice::controlTransferIn(USBControlTransferParameters&& setup, uint16_t length, InPromise&& promise)
+{
+    auto args = arguments("controlTransfer"_s);
+    controlArguments(args, setup);
+    args->setInteger("length"_s, length);
+    inputTransfer(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::controlTransferOut(USBControlTransferParameters&& setup, std::optional<BufferSource>&& output, OutPromise&& promise)
+{
+    auto args = arguments("controlTransfer"_s);
+    controlArguments(args, setup);
+    if (output && output->byteLength() > 65535) {
+        promise.reject(ExceptionCode::RangeError, "USB control transfer exceeds 65535 bytes"_s);
+        return;
+    }
+    outputTransfer(WTF::move(args), output ? output->span() : std::span<const uint8_t> { }, WTF::move(promise));
+}
+void USBDevice::transferIn(uint8_t endpoint, uint32_t length, InPromise&& promise)
+{
+    if (length > maximumTransferSize) {
+        promise.reject(ExceptionCode::RangeError, "USB transfer exceeds 16 MiB"_s);
+        return;
+    }
+    auto args = arguments("transfer"_s);
+    args->setInteger("endpoint"_s, endpoint);
+    args->setInteger("length"_s, length);
+    inputTransfer(WTF::move(args), WTF::move(promise));
+}
+void USBDevice::transferOut(uint8_t endpoint, BufferSource&& output, OutPromise&& promise)
+{
+    auto args = arguments("transfer"_s);
+    args->setInteger("endpoint"_s, endpoint);
+    outputTransfer(WTF::move(args), output.span(), WTF::move(promise));
+}
+static std::optional<size_t> packetArguments(JSON::Object& args, const Vector<uint32_t>& lengths)
+{
+    if (lengths.size() > 1024)
+        return std::nullopt;
+    size_t total = 0;
+    auto packets = JSON::Array::create();
+    for (auto length : lengths) {
+        if (length > 32767 || length > maximumTransferSize - total)
+            return std::nullopt;
+        total += length;
+        packets->pushInteger(length);
+    }
+    args.setArray("packetLengths"_s, WTF::move(packets));
+    return total;
+}
+void USBDevice::isochronousTransferIn(uint8_t endpoint, Vector<uint32_t>&& lengths, IsoInPromise&& promise)
+{
+    auto args = arguments("isochronousTransfer"_s);
+    args->setInteger("endpoint"_s, endpoint);
+    args->setBoolean("input"_s, true);
+    if (!packetArguments(args, lengths)) {
+        promise.reject(ExceptionCode::RangeError, "Invalid USB packet lengths"_s);
+        return;
+    }
+    transfer(WTF::move(args), { }, [lengths = WTF::move(lengths), promise = WTF::move(promise)](auto&& response, auto&& bytes) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        auto values = result->getArray("packets"_s);
+        if (!values || values->length() != lengths.size()) {
+            promise.reject(ExceptionCode::NetworkError);
+            return;
+        }
+        Ref buffer = JSC::ArrayBuffer::create(bytes.span());
+        Vector<Ref<USBIsochronousInTransferPacket>> packets;
+        size_t offset = 0;
+        for (size_t i = 0; i < lengths.size(); ++i) {
+            auto value = values->get(i)->asObject();
+            if (!value || offset > bytes.size() || lengths[i] > bytes.size() - offset) {
+                promise.reject(ExceptionCode::NetworkError);
+                return;
+            }
+            auto actual = usbNumber(*value, "transferred"_s);
+            if (actual > lengths[i]) {
+                promise.reject(ExceptionCode::NetworkError);
+                return;
+            }
+            auto status = transferStatus(*value);
+            RefPtr<JSC::DataView> data;
+            if (status == USBTransferStatus::Ok)
+                data = JSC::DataView::create(buffer.ptr(), offset, actual);
+            packets.append(USBIsochronousInTransferPacket::create(status, WTF::move(data)));
+            offset += lengths[i];
+        }
+        promise.resolve(USBIsochronousInTransferResult::create(WTF::move(packets), JSC::DataView::create(WTF::move(buffer))));
+    });
+}
+void USBDevice::isochronousTransferOut(uint8_t endpoint, BufferSource&& output, Vector<uint32_t>&& lengths, IsoOutPromise&& promise)
+{
+    auto args = arguments("isochronousTransfer"_s);
+    args->setInteger("endpoint"_s, endpoint);
+    args->setBoolean("input"_s, false);
+    auto total = packetArguments(args, lengths);
+    if (!total || *total != output.byteLength()) {
+        promise.reject(ExceptionCode::RangeError, "Packet lengths must equal the USB transfer size"_s);
+        return;
+    }
+    transfer(WTF::move(args), Vector<uint8_t>(output.span()), [count = lengths.size(), promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto result = response.releaseReturnValue();
+        auto values = result->getArray("packets"_s);
+        if (!values || values->length() != count) {
+            promise.reject(ExceptionCode::NetworkError);
+            return;
+        }
+        Vector<Ref<USBIsochronousOutTransferPacket>> packets;
+        for (auto& value : *values) {
+            auto object = value->asObject();
+            if (!object) {
+                promise.reject(ExceptionCode::NetworkError);
+                return;
+            }
+            packets.append(USBIsochronousOutTransferPacket::create(transferStatus(*object), usbNumber(*object, "transferred"_s)));
+        }
+        promise.resolve(USBIsochronousOutTransferResult::create(WTF::move(packets)));
+    });
+}
+} // namespace WebCore
+#endif
