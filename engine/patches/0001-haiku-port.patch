+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "BluetoothATTClientHaiku.h"
+#include <algorithm>
+
+namespace WebCore::BluetoothHaiku {
+static uint16_t read16(std::span<const uint8_t> data, size_t at = 0) { return data[at] | uint16_t(data[at + 1]) << 8; }
+static void append16(std::vector<uint8_t>& data, uint16_t value) { data.push_back(value); data.push_back(value >> 8); }
+static std::vector<uint8_t> rangeRequest(uint8_t opcode, uint16_t start, uint16_t end, uint16_t type)
+{ std::vector<uint8_t> request { opcode }; append16(request, start); append16(request, end); append16(request, type); return request; }
+static ATTResult badPacket() { return { ATTError::Protocol }; }
+
+ATTResult ATTClient::unsolicited(std::span<const uint8_t> packet, bool& handled)
+{
+    handled = true;
+    if (packet.empty() || packet.size() > 23) return badPacket();
+    if (packet[0] == 0x1b || packet[0] == 0x1d) {
+        if (packet.size() < 3 || !read16(packet, 1)) return badPacket();
+        if (packet[0] == 0x1d && !m_transport.confirmsIndications()) {
+            const std::array<uint8_t, 1> confirmation { 0x1e };
+            if (auto result = m_transport.send(confirmation); !result) return result;
+        }
+        if (m_notifications.size() >= 256) m_notifications.pop_front();
+        m_notifications.push_back({ read16(packet, 1), {packet.begin() + 3, packet.end()} });
+        return {};
+    }
+    if (packet[0] == 0x02) {
+        if (packet.size() != 3 || read16(packet, 1) < 23) return badPacket();
+        const std::array<uint8_t, 3> response { 0x03, 23, 0 };
+        return m_transport.send(response);
+    }
+    handled = false;
+    return {};
+}
+ATTResult ATTClient::exchange(std::span<const uint8_t> request, uint8_t responseOpcode, std::vector<uint8_t>& response)
+{
+    if (request.empty() || request.size() > 23) return { ATTError::InvalidLength };
+    if (auto result = m_transport.send(request); !result) return result;
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (std::chrono::steady_clock::now() < deadline) {
+        unsigned remaining = std::max<int64_t>(1, std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count());
+        if (auto result = m_transport.receive(response, remaining); !result) return result;
+        bool handled = false;
+        if (auto result = unsolicited(response, handled); !result) return result;
+        if (handled) continue;
+        if (response[0] == 0x01) {
+            if (response.size() != 5 || response[1] != request[0] || !response[4]) return badPacket();
+            return { ATTError::Remote, response[4] };
+        }
+        if (response[0] != responseOpcode) return badPacket();
+        return {};
+    }
+    return { ATTError::Timeout };
+}
+ATTResult ATTClient::services(std::vector<Service>& output, bool primary)
+{
+    std::vector<Service> found;
+    uint32_t start = 1;
+    while (start <= 65535) {
+        auto request = rangeRequest(0x10, start, 0xffff, primary ? 0x2800 : 0x2801);
+        std::vector<uint8_t> response;
+        auto result = exchange(request, 0x11, response);
+        if (result.error == ATTError::Remote && result.remoteError == 0x0a) break;
+        if (!result) return result;
+        if (response.size() < 2 || (response[1] != 6 && response[1] != 20) || response.size() <= 2 || (response.size() - 2) % response[1]) return badPacket();
+        size_t width = response[1];
+        for (size_t at = 2; at < response.size(); at += width) {
+            auto entry = std::span { response }.subspan(at, width);
+            Service service { read16(entry), read16(entry, 2), *UUID::fromWire(entry.subspan(4)), primary };
+            if (service.start < start || service.end < service.start || found.size() >= 256) return badPacket();
+            found.push_back(service); start = uint32_t(service.end) + 1;
+        }
+    }
+    output = std::move(found); return {};
+}
+ATTResult ATTClient::includedServices(const Service& parent, std::vector<Service>& output)
+{
+    if (!parent.start || parent.end < parent.start) return badPacket();
+    std::vector<Service> found;
+    uint32_t start = parent.start;
+    while (start <= parent.end) {
+        auto request = rangeRequest(0x08, start, parent.end, 0x2802);
+        std::vector<uint8_t> response;
+        auto result = exchange(request, 0x09, response);
+        if (result.error == ATTError::Remote && result.remoteError == 0x0a) break;
+        if (!result) return result;
+        if (response.size() < 2 || (response[1] != 6 && response[1] != 8) || response.size() <= 2 || (response.size() - 2) % response[1]) return badPacket();
+        size_t width = response[1];
+        // A 128-bit included service omits its UUID from this declaration;
+        // read the referenced service attribute to obtain it.
+        for (size_t at = 2; at < response.size(); at += width) {
+            auto entry = std::span { response }.subspan(at, width);
+            uint16_t declaration = read16(entry);
+            Service service { read16(entry, 2), read16(entry, 4), {}, false };
+            if (declaration < start || declaration > parent.end || !service.start || service.end < service.start || found.size() >= 256) return badPacket();
+            if (width == 8) service.uuid = *UUID::fromWire(entry.subspan(6));
+            else {
+                std::vector<uint8_t> value;
+                if (auto readResult = read(service.start, value); !readResult) return readResult;
+                auto uuid = UUID::fromWire(value);
+                if (!uuid || value.size() != 16) return badPacket();
+                service.uuid = *uuid;
+            }
+            found.push_back(service); start = uint32_t(declaration) + 1;
+        }
+    }
+    output = std::move(found); return {};
+}
+ATTResult ATTClient::characteristics(const Service& service, std::vector<Characteristic>& output)
+{
+    if (!service.start || service.end < service.start) return badPacket();
+    std::vector<Characteristic> found;
+    uint32_t start = service.start;
+    while (start <= service.end) {
+        auto request = rangeRequest(0x08, start, service.end, 0x2803);
+        std::vector<uint8_t> response;
+        auto result = exchange(request, 0x09, response);
+        if (result.error == ATTError::Remote && result.remoteError == 0x0a) break;
+        if (!result) return result;
+        if (response.size() < 2 || (response[1] != 7 && response[1] != 21) || response.size() <= 2 || (response.size() - 2) % response[1]) return badPacket();
+        size_t width = response[1];
+        for (size_t at = 2; at < response.size(); at += width) {
+            auto entry = std::span { response }.subspan(at, width);
+            Characteristic characteristic { read16(entry), read16(entry, 3), service.end, entry[2], *UUID::fromWire(entry.subspan(5)) };
+            if (characteristic.declaration < start || characteristic.value <= characteristic.declaration || characteristic.value > service.end || found.size() >= 1024) return badPacket();
+            if (!found.empty()) found.back().end = characteristic.declaration - 1;
+            found.push_back(characteristic); start = uint32_t(characteristic.value) + 1;
+        }
+    }
+    output = std::move(found); return {};
+}
+ATTResult ATTClient::descriptors(const Characteristic& characteristic, std::vector<Descriptor>& output)
+{
+    if (!characteristic.value || characteristic.end < characteristic.value) return badPacket();
+    std::vector<Descriptor> found;
+    uint32_t start = uint32_t(characteristic.value) + 1;
+    while (start <= characteristic.end) {
+        auto request = rangeRequest(0x04, start, characteristic.end, 0); request.resize(5);
+        std::vector<uint8_t> response;
+        auto result = exchange(request, 0x05, response);
+        if (result.error == ATTError::Remote && result.remoteError == 0x0a) break;
+        if (!result) return result;
+        if (response.size() < 2 || (response[1] != 1 && response[1] != 2)) return badPacket();
+        size_t width = response[1] == 1 ? 4 : 18;
+        if (response.size() <= 2 || (response.size() - 2) % width) return badPacket();
+        for (size_t at = 2; at < response.size(); at += width) {
+            auto entry = std::span { response }.subspan(at, width);
+            Descriptor descriptor { read16(entry), *UUID::fromWire(entry.subspan(2)) };
+            if (descriptor.handle < start || descriptor.handle > characteristic.end || found.size() >= 256) return badPacket();
+            found.push_back(descriptor); start = uint32_t(descriptor.handle) + 1;
+        }
+    }
+    output = std::move(found); return {};
+}
+ATTResult ATTClient::read(uint16_t handle, std::vector<uint8_t>& output)
+{
+    if (!handle) return badPacket();
+    std::vector<uint8_t> value;
+    for (;;) {
+        std::vector<uint8_t> request { uint8_t(value.empty() ? 0x0a : 0x0c) };
+        append16(request, handle); if (!value.empty()) append16(request, value.size());
+        std::vector<uint8_t> response;
+        auto result = exchange(request, value.empty() ? 0x0b : 0x0d, response);
+        if (!value.empty() && result.error == ATTError::Remote && (result.remoteError == 0x07 || result.remoteError == 0x0b)) break;
+        if (!result) return result;
+        if (response.size() - 1 > 512 - value.size()) return { ATTError::InvalidLength };
+        value.insert(value.end(), response.begin() + 1, response.end());
+        if (response.size() < 23) break;
+    }
+    output = std::move(value); return {};
+}
+ATTResult ATTClient::write(uint16_t handle, std::span<const uint8_t> value, bool response)
+{
+    if (!handle) return badPacket();
+    if (value.size() > 512 || (!response && value.size() > 20)) return { ATTError::InvalidLength };
+    if (value.size() <= 20) {
+        std::vector<uint8_t> request { uint8_t(response ? 0x12 : 0x52) }; append16(request, handle);
+        request.insert(request.end(), value.begin(), value.end());
+        if (!response) return m_transport.send(request);
+        std::vector<uint8_t> reply; auto result = exchange(request, 0x13, reply);
+        return result && reply.size() != 1 ? badPacket() : result;
+    }
+    auto execute = [&](bool commit) {
+        std::array<uint8_t, 2> request { 0x18, uint8_t(commit) };
+        std::vector<uint8_t> reply; auto result = exchange(request, 0x19, reply);
+        return result && reply.size() != 1 ? badPacket() : result;
+    };
+    for (size_t offset = 0; offset < value.size();) {
+        size_t length = std::min<size_t>(18, value.size() - offset);
+        std::vector<uint8_t> request { 0x16 }; append16(request, handle); append16(request, offset);
+        request.insert(request.end(), value.begin() + offset, value.begin() + offset + length);
+        std::vector<uint8_t> reply; auto result = exchange(request, 0x17, reply);
+        if (!result || reply.size() != request.size() || !std::equal(reply.begin() + 1, reply.end(), request.begin() + 1)) {
+            execute(false);
+            return result ? badPacket() : result;
+        }
+        offset += length;
+    }
+    return execute(true);
+}
+ATTResult ATTClient::pollNotifications(std::vector<Notification>& output)
+{
+    // Bound each poll, even if the peripheral floods the link continuously.
+    for (unsigned i = 0; i < 256; ++i) {
+        std::vector<uint8_t> packet; auto result = m_transport.receive(packet, 0);
+        if (result.error == ATTError::Timeout) break;
+        if (!result) return result;
+        bool handled = false; result = unsolicited(packet, handled);
+        if (!result) return result;
+        if (!handled) return badPacket();
+    }
+    output.assign(std::make_move_iterator(m_notifications.begin()), std::make_move_iterator(m_notifications.end()));
+    m_notifications.clear(); return {};
+}
+}
diff --git a/Source/WebCore/platform/bluetooth/haiku/BluetoothATTClientHaiku.h b/Source/WebCore/platform/bluetooth/haiku/BluetoothATTClientHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..f900e9fc3465729567cb107a6a3eb566c0130343
--- /dev/null
+++ b/Source/WebCore/platform/bluetooth/haiku/BluetoothATTClientHaiku.h
@@ -0,0 +1,43 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "BluetoothTypesHaiku.h"
+#include <chrono>
+#include <deque>
+
+namespace WebCore::BluetoothHaiku {
+enum class ATTError { None, Timeout, Disconnected, Protocol, Remote, InvalidLength, Aborted };
+struct ATTResult {
+    ATTError error { ATTError::None };
+    uint8_t remoteError { 0 };
+    explicit operator bool() const { return error == ATTError::None; }
+};
+struct Notification { uint16_t handle; std::vector<uint8_t> value; };
+class ATTTransport {
+public:
+    virtual ~ATTTransport() = default;
+    virtual ATTResult send(std::span<const uint8_t>) = 0;
+    virtual ATTResult receive(std::vector<uint8_t>&, unsigned timeoutMilliseconds) = 0;
+    // air/OS confirms indications in the kernel, including when no user-space
+    // receiver exists. Other transports must let this client confirm them.
+    virtual bool confirmsIndications() const { return false; }
+};
+// One ATT transaction at a time, run on the owning connection's worker queue.
+// Matches the native stack's default 23-byte MTU; long values use Read Blob
+// and Prepare/Execute Write, with a 512-byte attribute limit.
+class ATTClient {
+public:
+    explicit ATTClient(ATTTransport& transport) : m_transport(transport) { }
+    ATTResult services(std::vector<Service>&, bool primary = true);
+    ATTResult includedServices(const Service&, std::vector<Service>&);
+    ATTResult characteristics(const Service&, std::vector<Characteristic>&);
+    ATTResult descriptors(const Characteristic&, std::vector<Descriptor>&);
+    ATTResult read(uint16_t handle, std::vector<uint8_t>&);
+    ATTResult write(uint16_t handle, std::span<const uint8_t>, bool response = true);
+    ATTResult pollNotifications(std::vector<Notification>&);
+private:
+    ATTResult exchange(std::span<const uint8_t>, uint8_t responseOpcode, std::vector<uint8_t>&);
+    ATTResult unsolicited(std::span<const uint8_t>, bool& handled);
+    ATTTransport& m_transport;
+    std::deque<Notification> m_notifications;
+};
+}
diff --git a/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.cpp b/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6bb0cdf5fe51e03874dd53eed65d8778dbacb870
--- /dev/null
+++ b/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.cpp
@@ -0,0 +1,220 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "BluetoothGATTHaiku.h"
+#include <algorithm>
+
+namespace WebCore::BluetoothHaiku {
+GATTResult GATTConnection::checked(ATTResult result)
+{
+    if (result) return { };
+    // A timeout/protocol error may leave a delayed response on the ATT channel.
+    // Invalidate all capabilities; the broker must close the native connection.
+    if (result.error != ATTError::Remote && result.error != ATTError::InvalidLength) invalidate();
+    return { GATTError::ATT, result };
+}
+void GATTConnection::invalidate()
+{
+    m_valid = false;
+    m_catalog.clear(); m_services.clear(); m_characteristics.clear(); m_descriptors.clear();
+    m_discoveredCharacteristics.clear(); m_discoveredDescriptors.clear(); m_subscribed.clear();
+    m_serviceChanged = 0;
+}
+void GATTConnection::addGrants(const std::set<UUID>& grants)
+{
+    for (auto& uuid : grants) if (!blocked(uuid)) m_grants.insert(uuid);
+}
+GATTResult GATTConnection::initialize()
+{
+    invalidate();
+    std::vector<Service> primary, secondary;
+    if (auto result = checked(m_client.services(primary)); !result) return result;
+    auto secondaryResult = m_client.services(secondary, false);
+    if (!secondaryResult && !(secondaryResult.error == ATTError::Remote && secondaryResult.remoteError == 0x10)) return checked(secondaryResult);
+    m_catalog = std::move(primary);
+    m_catalog.insert(m_catalog.end(), secondary.begin(), secondary.end());
+    std::sort(m_catalog.begin(), m_catalog.end(), [](auto& a, auto& b) { return a.start < b.start; });
+    for (size_t i = 1; i < m_catalog.size(); ++i)
+        if (m_catalog[i].start <= m_catalog[i - 1].end) return checked({ ATTError::Protocol });
+    // Subscribe internally to Service Changed, when supported. A changed
+    // database invalidates all cached handles, including queued web operations.
+    // The broker disconnects rather than reusing an old handle for new data.
+    for (auto& service : m_catalog) {
+        if (service.uuid != UUID::alias(0x1801)) continue;
+        std::vector<Characteristic> characteristics;
+        auto status = m_client.characteristics(service, characteristics);
+        if (!status) {
+            if (status.error == ATTError::Remote) continue;
+            return checked(status);
+        }
+        for (auto& characteristic : characteristics) {
+            if (characteristic.uuid != UUID::alias(0x2a05) || !(characteristic.properties & 0x20)) continue;
+            std::vector<Descriptor> descriptors;
+            status = m_client.descriptors(characteristic, descriptors);
+            if (!status) {
+                if (status.error == ATTError::Remote) continue;
+                return checked(status);
+            }
+            auto cccd = std::find_if(descriptors.begin(), descriptors.end(), [](auto& descriptor) { return descriptor.uuid == UUID::alias(0x2902); });
+            if (cccd == descriptors.end()) continue;
+            const std::array<uint8_t, 2> indicate { 2, 0 };
+            status = m_client.write(cccd->handle, indicate);
+            if (status) m_serviceChanged = characteristic.value;
+            else if (status.error != ATTError::Remote) return checked(status);
+        }
+    }
+    m_valid = true;
+    return { };
+}
+GATTResult GATTConnection::checkServiceQuery(const std::optional<UUID>& query) const
+{
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    if (query && !allowed(*query)) return { GATTError::Security, { } };
+    return { };
+}
+GATTResult GATTConnection::services(std::optional<UUID> query, std::vector<Service>& output)
+{
+    output.clear();
+    if (auto result = checkServiceQuery(query); !result) return result;
+    for (auto& service : m_catalog) {
+        if (service.primary && allowed(service.uuid) && (!query || service.uuid == *query)) {
+            m_services[service.start] = service;
+            output.push_back(service);
+        }
+    }
+    return { };
+}
+GATTResult GATTConnection::includedServices(uint16_t parent, std::optional<UUID> query, std::vector<Service>& output)
+{
+    output.clear();
+    if (auto result = checkServiceQuery(query); !result) return result;
+    auto service = m_services.find(parent);
+    if (service == m_services.end()) return { GATTError::Security, { } };
+    std::vector<Service> found;
+    if (auto result = checked(m_client.includedServices(service->second, found)); !result) return result;
+    for (auto& included : found) {
+        auto catalog = std::find_if(m_catalog.begin(), m_catalog.end(), [&](auto& known) { return known.start == included.start && known.end == included.end && known.uuid == included.uuid; });
+        if (catalog == m_catalog.end()) return checked({ ATTError::Protocol });
+        if (allowed(catalog->uuid) && (!query || catalog->uuid == *query)) {
+            m_services[catalog->start] = *catalog;
+            output.push_back(*catalog);
+        }
+    }
+    return { };
+}
+GATTResult GATTConnection::characteristics(uint16_t parent, std::optional<UUID> query, std::vector<GATTCharacteristic>& output)
+{
+    output.clear();
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    if (query && blocked(*query)) return { GATTError::Security, { } };
+    auto service = m_services.find(parent);
+    if (service == m_services.end()) return { GATTError::Security, { } };
+    if (!m_discoveredCharacteristics.contains(parent)) {
+        std::vector<Characteristic> found;
+        if (auto result = checked(m_client.characteristics(service->second, found)); !result) return result;
+        if (m_characteristics.size() + found.size() > 4096) return checked({ ATTError::Protocol });
+        for (auto& characteristic : found) {
+            if (blocked(characteristic.uuid)) continue;
+            m_characteristics[characteristic.value] = { characteristic, parent, 0 };
+        }
+        m_discoveredCharacteristics.insert(parent);
+        // Extended properties live in a descriptor rather than the declaration.
+        for (auto& characteristic : found) {
+            if (blocked(characteristic.uuid) || !(characteristic.properties & 0x80)) continue;
+            if (auto result = rememberDescriptors(characteristic.value); !result) return result;
+            for (auto& [handle, descriptor] : m_descriptors) {
+                if (descriptor.characteristic != characteristic.value || descriptor.attribute.uuid != UUID::alias(0x2900)) continue;
+                std::vector<uint8_t> value;
+                if (auto result = checked(m_client.read(handle, value)); !result) return result;
+                if (value.size() != 2) return checked({ ATTError::Protocol });
+                m_characteristics[characteristic.value].extendedProperties = value[0] | uint16_t(value[1]) << 8;
+            }
+        }
+    }
+    for (auto& [_, characteristic] : m_characteristics)
+        if (characteristic.service == parent && (!query || characteristic.attribute.uuid == *query)) output.push_back(characteristic);
+    return { };
+}
+GATTResult GATTConnection::rememberDescriptors(uint16_t parent)
+{
+    auto characteristic = m_characteristics.find(parent);
+    if (characteristic == m_characteristics.end()) return { GATTError::Security, { } };
+    if (m_discoveredDescriptors.contains(parent)) return { };
+    std::vector<Descriptor> found;
+    if (auto result = checked(m_client.descriptors(characteristic->second.attribute, found)); !result) return result;
+    if (m_descriptors.size() + found.size() > 4096) return checked({ ATTError::Protocol });
+    for (auto& descriptor : found) if (!blocked(descriptor.uuid)) m_descriptors[descriptor.handle] = { descriptor, parent };
+    m_discoveredDescriptors.insert(parent);
+    return { };
+}
+GATTResult GATTConnection::descriptors(uint16_t parent, std::optional<UUID> query, std::vector<GATTDescriptor>& output)
+{
+    output.clear();
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    if (query && blocked(*query)) return { GATTError::Security, { } };
+    if (auto result = rememberDescriptors(parent); !result) return result;
+    for (auto& [_, descriptor] : m_descriptors)
+        if (descriptor.characteristic == parent && (!query || descriptor.attribute.uuid == *query)) output.push_back(descriptor);
+    return { };
+}
+GATTResult GATTConnection::read(uint16_t handle, bool descriptor, std::vector<uint8_t>& output)
+{
+    output.clear();
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    if (descriptor) {
+        auto item = m_descriptors.find(handle);
+        if (item == m_descriptors.end() || blocked(item->second.attribute.uuid, Access::Read)) return { GATTError::Security, { } };
+    } else {
+        auto item = m_characteristics.find(handle);
+        if (item == m_characteristics.end() || blocked(item->second.attribute.uuid, Access::Read)) return { GATTError::Security, { } };
+        if (!(item->second.attribute.properties & 2)) return { GATTError::NotSupported, { } };
+    }
+    return checked(m_client.read(handle, output));
+}
+GATTResult GATTConnection::write(uint16_t handle, bool descriptor, std::span<const uint8_t> value, bool response)
+{
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    if (descriptor) {
+        auto item = m_descriptors.find(handle);
+        if (item == m_descriptors.end() || blocked(item->second.attribute.uuid, Access::Write)) return { GATTError::Security, { } };
+        if (!response) return { GATTError::NotSupported, { } };
+    } else {
+        auto item = m_characteristics.find(handle);
+        if (item == m_characteristics.end() || blocked(item->second.attribute.uuid, Access::Write)) return { GATTError::Security, { } };
+        if (!(item->second.attribute.properties & (response ? 8 : 4))) return { GATTError::NotSupported, { } };
+    }
+    return checked(m_client.write(handle, value, response));
+}
+GATTResult GATTConnection::notifications(uint16_t handle, bool enable)
+{
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    auto item = m_characteristics.find(handle);
+    if (item == m_characteristics.end() || blocked(item->second.attribute.uuid, Access::Read)) return { GATTError::Security, { } };
+    if (handle == m_serviceChanged) return { GATTError::NotSupported, { } };
+    auto properties = item->second.attribute.properties;
+    if (!(properties & 0x30)) return { GATTError::NotSupported, { } };
+    if (m_subscribed.contains(handle) == enable) return { };
+    if (auto result = rememberDescriptors(handle); !result) return result;
+    auto cccd = std::find_if(m_descriptors.begin(), m_descriptors.end(), [&](auto& entry) { return entry.second.characteristic == handle && entry.second.attribute.uuid == UUID::alias(0x2902); });
+    if (cccd == m_descriptors.end()) return { GATTError::NotSupported, { } };
+    const std::array<uint8_t, 2> value { uint8_t(enable ? (properties & 0x10 ? 1 : 2) : 0), 0 };
+    if (auto result = checked(m_client.write(cccd->first, value)); !result) return result;
+    if (enable) m_subscribed.insert(handle);
+    else m_subscribed.erase(handle);
+    return { };
+}
+GATTResult GATTConnection::poll(std::vector<Notification>& output)
+{
+    output.clear();
+    if (!m_valid) return { GATTError::InvalidState, { } };
+    std::vector<Notification> found;
+    if (auto result = checked(m_client.pollNotifications(found)); !result) return result;
+    for (auto& notification : found) {
+        if (notification.handle == m_serviceChanged) {
+            invalidate();
+            output.clear();
+            return { GATTError::InvalidState, { } };
+        }
+        if (m_subscribed.contains(notification.handle)) output.push_back(std::move(notification));
+    }
+    return { };
+}
+}
diff --git a/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.h b/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.h
