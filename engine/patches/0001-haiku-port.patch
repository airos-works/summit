+    int64_t now() const;
+    bool isRunning() const { return m_running; }
+    void start();
+    void stop();
+    void set(int64_t mediaTime);
+
+private:
+    mutable Lock m_lock;
+    int64_t m_base WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int64_t m_startedAt WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    std::atomic<bool> m_running { false };
+};
