+void MediaPlayerPrivateHaikuMSE::encryptionStateChanged()
+{
+    bool waiting = (m_videoRenderer && m_videoRenderer->waitingForKey()) || (m_audioRenderer && m_audioRenderer->waitingForKey());
+    if (std::exchange(m_waitingForKey, waiting) != waiting) {
+        if (RefPtr player = m_player.get()) player->waitingForKeyChanged();
+    }
+    if ((m_videoRenderer && m_videoRenderer->decryptionFailed()) || (m_audioRenderer && m_audioRenderer->decryptionFailed())) {
+        m_clock.stop();
+        setNetworkState(MediaPlayer::NetworkState::DecodeError);
+    }
+    updatePlaybackState();
+}
