+#if ENABLE(CUSTOM_PROTOCOL_HANDLERS)
+void WebPageProxy::protocolHandlerRequested(IPC::Connection& connection, WebCore::FrameIdentifier frameID, const String& scheme, IPC::Untrusted<URL>&& untrustedURL, bool remove)
+{
+    // Validation below binds the template URL to this process-owned frame's
+    // committed origin and permits only trustworthy HTTP(S) handler templates.
+    auto url = WTF::move(untrustedURL).unsafeExtractWithoutValidation(IPC::UnvalidatedReason::ValidatedElsewhere);
+    Ref process = WebProcessProxy::fromConnection(connection);
+    RefPtr frame = WebFrameProxy::webFrame(frameID);
+    if (!frame || frame->page() != this || &frame->process() != process.ptr()
+        || !WebCore::isAllowedProtocolHandlerScheme(scheme) || !url.isValid()
+        || !url.protocolIsInHTTPFamily() || !url.string().contains("%s"_s))
+        return;
+    // Use the committed security origin, including inherited and opaque
+    // sandbox origins, rather than inferring identity from the frame URL.
+    Ref origin = WebCore::SecurityOrigin::create(frame->documentSecurityOriginData());
+    if (!origin->isPotentiallyTrustworthy() || !origin->isSameOriginAs(WebCore::SecurityOrigin::create(url)))
+        return;
+    if (RefPtr client = pageClient())
+        client->protocolHandlerRequested(scheme, url, remove);
+}
+#endif
+
+#if ENABLE(WEBUSB)
+void WebPageProxy::usbRequest(IPC::Connection& connection, WebCore::FrameIdentifier frameID, const String& arguments,
+    Vector<uint8_t>&& bytes, CompletionHandler<void(String&&, Vector<uint8_t>&&)>&& completion)
+{
+    Ref process = WebProcessProxy::fromConnection(connection);
+    RefPtr frame = WebFrameProxy::webFrame(frameID);
+    RefPtr topFrame = mainFrame();
+    if (!frame || !topFrame || frame->page() != this || &frame->process() != process.ptr()
+        || arguments.length() > 65536 || bytes.size() > 16 * 1024 * 1024) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    Ref origin = WebCore::SecurityOrigin::create(frame->documentSecurityOriginData());
+    Ref topOrigin = WebCore::SecurityOrigin::create(topFrame->documentSecurityOriginData());
+    // Haiku currently allows top-level and same-origin child documents. Cross-
+    // origin delegation requires a UI-process policy representation first.
+    if (origin->isOpaque() || !origin->isPotentiallyTrustworthy() || !origin->isSameOriginAs(topOrigin)) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    auto value = JSON::Value::parseJSON(arguments);
+    auto object = value ? value->asObject() : nullptr;
+    if (!object || (object->getString("operation"_s) == "requestDevice"_s && !frame->hasTransientActivation())) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    if (RefPtr client = pageClient())
+        client->usbRequest(frameID.toUInt64(), origin->toString(), arguments, WTF::move(bytes), WTF::move(completion));
+    else
+        completion("{\"error\":\"AbortError\"}"_s, { });
+}
+#endif
+#if ENABLE(WEB_BLUETOOTH)
+void WebPageProxy::bluetoothRequest(IPC::Connection& connection, WebCore::FrameIdentifier frameID, const String& arguments,
+    Vector<uint8_t>&& bytes, CompletionHandler<void(String&&, Vector<uint8_t>&&)>&& completion)
+{
+    Ref process = WebProcessProxy::fromConnection(connection);
+    RefPtr frame = WebFrameProxy::webFrame(frameID);
+    RefPtr topFrame = mainFrame();
+    if (!frame || !topFrame || frame->page() != this || &frame->process() != process.ptr()
+        || arguments.length() > 65536 || bytes.size() > 512) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    Ref origin = WebCore::SecurityOrigin::create(frame->documentSecurityOriginData());
+    Ref topOrigin = WebCore::SecurityOrigin::create(topFrame->documentSecurityOriginData());
+    // Haiku currently allows top-level and same-origin child documents. Cross-
+    // origin delegation requires a UI-process policy representation first.
+    if (origin->isOpaque() || !origin->isPotentiallyTrustworthy() || !origin->isSameOriginAs(topOrigin)) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    auto value = JSON::Value::parseJSON(arguments);
+    auto object = value ? value->asObject() : nullptr;
+    if (!object || (object->getString("operation"_s) == "requestDevice"_s && !frame->hasTransientActivation())) {
+        completion("{\"error\":\"SecurityError\"}"_s, { });
+        return;
+    }
+    if (RefPtr client = pageClient())
+        client->bluetoothRequest(frameID.toUInt64(), origin->toString(), arguments, WTF::move(bytes), WTF::move(completion));
+    else
+        completion("{\"error\":\"AbortError\"}"_s, { });
+}
