+
+// The ARM boards decode H.264 with their own decoder (rpi_mmal on the
+// Raspberry Pi 4, sunxi_cedar on the Radxa Cubie A7S) or, where there is
+// none, in software for a fraction of what VP9 and AV1 cost, which they
+// only ever decode in software. Offered all three, YouTube took VP9 on the
+// Cubie A7S and stayed at 480p, 30 frames a second, for 1.1 cores; offered
+// H.264 alone, it played 720p at 60 for 0.9. So there VP9 and AV1 (and
+// VP8, WebM's other video codec) are declined to Media Source Extensions
+// (and media capabilities, which ask supportsType()), and sites pick H.264.
+// SUMMIT_MEDIA_PREFER_H264=0 offers them again, =1 declines them elsewhere.
+static bool declinesSoftwareOnlyVideoCodecsHaiku()
+{
+    static const bool declines = [] {
+        if (const char* value = getenv("SUMMIT_MEDIA_PREFER_H264"))
+            return !std::strcmp(value, "1");
+#if CPU(ARM64)
+        return true;
+#else
+        return false;
+#endif
+    }();
+    return declines;
+}
+
+static bool isSupportedCodec(StringView codec, bool audioOnly)
+{
+    // H.264 in 8-bit 4:2:0 is what the NVDEC add-on decodes; High 10, 4:2:2
+    // and 4:4:4 profiles (0x6e, 0x7a, 0xf4) are refused.
+    if (!audioOnly && (codec.startsWith("avc1"_s) || codec.startsWith("avc3"_s))) {
+        if (codec.length() >= 7) {
+            auto profile = codec.substring(5, 2);
+            if (equalLettersIgnoringASCIICase(profile, "6e"_s) || equalLettersIgnoringASCIICase(profile, "7a"_s) || equalLettersIgnoringASCIICase(profile, "f4"_s))
+                return false;
+        }
+        return true;
+    }
+    return codec == "mp4a.40.2"_s || codec == "mp4a.40.5"_s || codec == "mp4a.40.29"_s || codec == "mp4a.40"_s || codec == "mp4a.67"_s;
+}
+
+static bool isSupportedMP4Codec(StringView codec, bool audioOnly)
+{
+    if (isSupportedCodec(codec, audioOnly) || codec == "ac-3"_s || codec == "ec-3"_s)
+        return true;
+    if (audioOnly)
+        return false;
+    if (declinesSoftwareOnlyVideoCodecsHaiku() && (codec.startsWith("vp09"_s) || codec.startsWith("av01"_s)))
+        return false;
+    if (codec.startsWith("vp09"_s)) {
+        if (auto vp = parseVPCodecParameters(codec))
+            return vp->profile < 2 ? vp->bitDepth == 8 : vp->bitDepth > 8;
+    }
+    if (auto av1 = parseAV1CodecParameters(codec))
+        return validateAV1ConfigurationRecord(*av1);
+    if (auto hevc = parseHEVCCodecParameters(codec))
+        return !hevc->generalProfileSpace && hevc->generalProfileIDC >= 1 && hevc->generalProfileIDC <= 3;
+    return false;
+}
+
+// Video types that ask for more frames a second than this are declined
+// (YouTube asks with a "framerate" parameter), so sites pick their lower-rate
+// streams. The Radxa Cubie A7S (its video engine, sunxi_ve) has no fan and
+// throttles within a minute: offered 720p60, YouTube played it at 18-25
+// frames a second and went down to 480p30 by itself; capped, it kept 720p30
+// at 26-30. SUMMIT_MEDIA_MAX_FRAMERATE=N sets the cap, 0 for none.
+static double maxVideoFrameRateHaiku()
+{
+    static const double rate = [] {
+        if (const char* value = getenv("SUMMIT_MEDIA_MAX_FRAMERATE"))
+            return std::atof(value);
+        return access("/dev/misc/sunxi_ve", F_OK) ? 0.0 : 30.0;
+    }();
+    return rate;
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateHaikuMSE::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    MSE_TRACE("supportsType %s\n", parameters.type.raw().utf8().data());
+    auto container = parameters.type.containerType().convertToASCIILowercase();
+    if (double maxRate = maxVideoFrameRateHaiku(); maxRate > 0 && container.startsWith("video/"_s)) {
+        auto frameRate = parameters.type.parameter("framerate"_s);
+        if (!frameRate.isNull() && frameRate.toDouble() > maxRate)
+            return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    if (parameters.platformType == PlatformMediaDecodingType::FileOrHLS && container == "application/dash+xml"_s) {
+        for (auto& codec : parameters.type.codecs()) if (!isSupportedCodec(codec, false))
+            return MediaPlayer::SupportsType::IsNotSupported;
+        return parameters.type.codecs().isEmpty() ? MediaPlayer::SupportsType::MayBeSupported : MediaPlayer::SupportsType::IsSupported;
+    }
+    if (parameters.platformType != PlatformMediaDecodingType::MediaSource)
+        return MediaPlayer::SupportsType::IsNotSupported;
+    // Loading a MediaSource asks with no type at all (the URL is a blob:).
+    if (container.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+    if (!mseTypes().contains(container))
+        return MediaPlayer::SupportsType::IsNotSupported;
+    auto codecs = parameters.type.codecs();
+    // These byte-stream registrations identify the codec in their MIME
+    // type and explicitly prohibit a codecs parameter.
+    if (container == "audio/aac"_s || container == "audio/mpeg"_s)
+        return parameters.type.parameter(ContentType::codecsParameter()).isNull() ? MediaPlayer::SupportsType::IsSupported : MediaPlayer::SupportsType::IsNotSupported;
+    if (codecs.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+    bool audioOnly = container.startsWith("audio/"_s);
+    if (container == "video/mp2t"_s) {
+        for (auto& codec : codecs) {
+            bool supported = codec == "mp4a.40.2"_s || codec == "mp4a.67"_s
+                || equalLettersIgnoringASCIICase(codec, "mp4a.69"_s) || equalLettersIgnoringASCIICase(codec, "mp4a.6b"_s)
+                || codec == "mp3"_s || codec == "ac-3"_s || codec == "ec-3"_s;
+            if (codec.length() == 11 && (codec.startsWith("avc1."_s) || codec.startsWith("avc3."_s))) {
+                auto avcString = makeString("avc1."_s, codec.substring(5));
+                if (auto avc = parseAVCCodecParameters(avcString))
+                    supported = avc->profileIDC == 66 || avc->profileIDC == 77 || avc->profileIDC == 88 || avc->profileIDC == 100;
+            } else if (auto hevc = parseHEVCCodecParameters(codec))
+                supported = !hevc->generalProfileSpace && hevc->generalProfileIDC >= 1 && hevc->generalProfileIDC <= 3;
+            if (!supported)
+                return MediaPlayer::SupportsType::IsNotSupported;
+        }
+        return MediaPlayer::SupportsType::IsSupported;
+    }
+#if USE(LIBWEBRTC)
+    if (container == "video/webm"_s || container == "audio/webm"_s) {
+        for (auto& codec : codecs) {
+            bool audio = codec == "opus"_s || (codec == "vorbis"_s && SummitWebM::Parser::supportsVorbis());
+            bool video = false;
+            if (!audioOnly && !declinesSoftwareOnlyVideoCodecsHaiku()) {
+                if (auto vp = parseVPCodecParameters(codec)) {
+                    bool vp8 = vp->codecName == "vp8"_s || vp->codecName == "vp08"_s;
+                    video = vp8 ? vp->bitDepth == 8 : (vp->profile < 2 ? vp->bitDepth == 8 : vp->bitDepth > 8);
+                } else if (auto av1 = parseAV1CodecParameters(codec))
+                    video = validateAV1ConfigurationRecord(*av1);
+            }
+            if (!audio && !video)
+                return MediaPlayer::SupportsType::IsNotSupported;
+        }
+        return MediaPlayer::SupportsType::IsSupported;
+    }
+#endif
+    for (auto& codec : codecs) {
+        if (!isSupportedMP4Codec(codec, audioOnly))
+            return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    return MediaPlayer::SupportsType::IsSupported;
+}
