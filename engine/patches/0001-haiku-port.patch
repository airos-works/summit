+static Ref<WorkQueue> usbQueue()
+{
+    static NeverDestroyed<Ref<WorkQueue>> queue(WorkQueue::create("WebKit.USB"_s, WorkQueue::QOS::Utility));
+    return queue.get().copyRef();
+}
+// Main-thread ownership spans normal and private browsing contexts.
+static auto& openDevices()
+{
+    static NeverDestroyed<std::unordered_map<std::string, std::weak_ptr<Session>>> devices;
+    return devices.get();
+}
+static String usbError(ASCIILiteral name, ASCIILiteral message)
+{
+    auto object = JSON::Object::create();
+    object->setString("error"_s, name);
+    object->setString("message"_s, message);
+    return object->toJSONString();
+}
+static ASCIILiteral errorName(Error error)
+{
+    switch (error) {
+    case Error::None: return ""_s;
+    case Error::NotFound: return "NotFoundError"_s;
+    case Error::Security: return "SecurityError"_s;
+    case Error::InvalidState: return "InvalidStateError"_s;
+    case Error::Network: return "NetworkError"_s;
+    case Error::NotSupported: return "NotSupportedError"_s;
+    case Error::Range: return "RangeError"_s;
+    case Error::InvalidAccess: return "InvalidAccessError"_s;
+    case Error::Abort: return "AbortError"_s;
+    }
+    return "NetworkError"_s;
+}
+static String fromUTF8(const std::string& string) { return String::fromUTF8ReplacingInvalidSequences(std::span(reinterpret_cast<const char8_t*>(string.data()), string.size())); }
+
+static Ref<JSON::Object> deviceJSON(const Device& device, const String& token)
+{
+    auto object = JSON::Object::create();
+    object->setString("id"_s, token);
+    object->setInteger("usbVersion"_s, device.usbVersion);
+    object->setInteger("vendorId"_s, device.vendorId);
+    object->setInteger("productId"_s, device.productId);
+    object->setInteger("deviceVersion"_s, device.deviceVersion);
+    object->setInteger("deviceClass"_s, device.classCode);
+    object->setInteger("deviceSubclass"_s, device.subclassCode);
+    object->setInteger("deviceProtocol"_s, device.protocolCode);
+    object->setInteger("configurationValue"_s, device.configuration);
+    if (!device.manufacturer.empty()) object->setString("manufacturerName"_s, fromUTF8(device.manufacturer));
+    if (!device.product.empty()) object->setString("productName"_s, fromUTF8(device.product));
+    if (!device.serial.empty()) object->setString("serialNumber"_s, fromUTF8(device.serial));
+    auto configurations = JSON::Array::create();
+    for (auto& c : device.configurations) {
+        auto configuration = JSON::Object::create();
+        configuration->setInteger("configurationValue"_s, c.value);
+        if (!c.name.empty()) configuration->setString("configurationName"_s, fromUTF8(c.name));
+        auto interfaces = JSON::Array::create();
+        for (auto& i : c.interfaces) {
+            auto interface = JSON::Object::create();
+            interface->setInteger("interfaceNumber"_s, i.number);
+            interface->setInteger("alternateSetting"_s, i.alternate);
+            interface->setBoolean("claimed"_s, i.claimed);
+            auto alternates = JSON::Array::create();
+            for (auto& a : i.alternates) {
+                auto alternate = JSON::Object::create();
+                alternate->setInteger("alternateSetting"_s, a.setting);
+                alternate->setInteger("interfaceClass"_s, a.classCode);
+                alternate->setInteger("interfaceSubclass"_s, a.subclassCode);
+                alternate->setInteger("interfaceProtocol"_s, a.protocolCode);
+                if (!a.name.empty()) alternate->setString("interfaceName"_s, fromUTF8(a.name));
+                auto endpoints = JSON::Array::create();
+                for (auto& e : a.endpoints) {
+                    auto endpoint = JSON::Object::create();
+                    endpoint->setInteger("endpointNumber"_s, e.number);
+                    endpoint->setBoolean("input"_s, e.input);
+                    endpoint->setInteger("type"_s, e.type);
+                    endpoint->setInteger("packetSize"_s, e.packetSize);
+                    endpoints->pushObject(WTF::move(endpoint));
+                }
+                alternate->setArray("endpoints"_s, WTF::move(endpoints));
+                alternates->pushObject(WTF::move(alternate));
+            }
+            interface->setArray("alternates"_s, WTF::move(alternates));
+            interfaces->pushObject(WTF::move(interface));
+        }
+        configuration->setArray("interfaces"_s, WTF::move(interfaces));
+        configurations->pushObject(WTF::move(configuration));
+    }
+    object->setArray("configurations"_s, WTF::move(configurations));
+    return object;
+}
+
+static std::optional<std::vector<Filter>> readFilters(const JSON::Object& arguments, ASCIILiteral key)
+{
+    auto array = arguments.getArray(key);
+    if (!array || array->length() > 64)
+        return std::nullopt;
+    std::vector<Filter> result;
+    for (auto& value : *array) {
+        auto object = value->asObject();
+        if (!object)
+            return std::nullopt;
+        Filter filter;
+        bool valid = true;
+        auto number = [&](ASCIILiteral key, auto& target, unsigned maximum) {
+            if (!object->getValue(key))
+                return;
+            auto value = object->getInteger(key);
+            if (!value || *value < 0 || unsigned(*value) > maximum)
+                valid = false;
+            else
+                target = *value;
+        };
+        number("vendorId"_s, filter.vendorId, 65535);
+        number("productId"_s, filter.productId, 65535);
+        number("classCode"_s, filter.classCode, 255);
+        number("subclassCode"_s, filter.subclassCode, 255);
+        number("protocolCode"_s, filter.protocolCode, 255);
+        if (auto serial = object->getValue("serialNumber"_s)) {
+            auto string = serial->asString();
+            if (string.isNull() || string.length() > 1024)
+                valid = false;
+            else
+                filter.serialNumber = string.utf8().legacyCStringPointer();
+        }
+        if (!valid || !validFilter(filter))
+            return std::nullopt;
+        result.push_back(std::move(filter));
+    }
+    return result;
+}
