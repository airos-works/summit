+    required octet request;
+    required unsigned short value;
+    required unsigned short index;
+  };
diff --git a/Source/WebCore/Modules/webusb/USBDescriptors.cpp b/Source/WebCore/Modules/webusb/USBDescriptors.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..296b197cb060682c008a09a6f3008e00878e2951
--- /dev/null
+++ b/Source/WebCore/Modules/webusb/USBDescriptors.cpp
@@ -0,0 +1,110 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "USBDescriptors.h"
+#include "USBDevice.h"
+
+namespace WebCore {
+unsigned usbNumber(const JSON::Object& object, ASCIILiteral key)
+{
+    return std::max(0, object.getInteger(key).value_or(0));
+}
+RefPtr<JSON::Object> usbFind(const JSON::Object& object, ASCIILiteral arrayKey, ASCIILiteral key, unsigned number)
+{
+    auto array = object.getArray(arrayKey);
+    if (!array)
+        return nullptr;
+    for (auto& value : *array) {
+        if (auto child = value->asObject(); child && child->getInteger(key) == number)
+            return child;
+    }
+    return nullptr;
+}
+
+ExceptionOr<Ref<USBConfiguration>> USBConfiguration::create(USBDevice& device, uint8_t number)
+{
+    auto data = usbFind(device.state().data, "configurations"_s, "configurationValue"_s, number);
+    if (!data)
+        return Exception { ExceptionCode::RangeError, "Unknown USB configuration"_s };
+    return create(device.state(), data.releaseNonNull());
+}
+Vector<Ref<USBInterface>> USBConfiguration::interfaces() const
+{
+    Vector<Ref<USBInterface>> result;
+    if (auto values = m_data->getArray("interfaces"_s)) {
+        for (auto& value : *values) {
+            if (auto data = value->asObject())
+                result.append(USBInterface::create(m_state, configurationValue(), data.releaseNonNull()));
+        }
+    }
+    return result;
+}
+ExceptionOr<Ref<USBInterface>> USBInterface::create(USBConfiguration& configuration, uint8_t number)
+{
+    auto data = usbFind(configuration.data(), "interfaces"_s, "interfaceNumber"_s, number);
+    if (!data)
+        return Exception { ExceptionCode::RangeError, "Unknown USB interface"_s };
+    return create(configuration.state(), configuration.configurationValue(), data.releaseNonNull());
+}
+RefPtr<JSON::Object> USBInterface::current() const
+{
+    if (auto configuration = usbFind(m_state->data, "configurations"_s, "configurationValue"_s, m_configuration))
+        return usbFind(*configuration, "interfaces"_s, "interfaceNumber"_s, interfaceNumber());
+    return nullptr;
+}
+bool USBInterface::claimed() const
+{
+    if (!m_state->opened || usbNumber(m_state->data, "configurationValue"_s) != m_configuration)
+        return false;
+    auto value = current();
+    return value && value->getBoolean("claimed"_s).value_or(false);
+}
+Ref<USBAlternateInterface> USBInterface::alternate() const
+{
+    auto value = current();
+    auto number = value ? usbNumber(*value, "alternateSetting"_s) : 0;
+    if (auto data = usbFind(m_data, "alternates"_s, "alternateSetting"_s, number))
+        return USBAlternateInterface::create(data.releaseNonNull());
+    // A malformed descriptor never reaches the broker's eligible-device list;
+    // keep a safe object if a device vanished during a state update.
+    return USBAlternateInterface::create(JSON::Object::create());
+}
+Vector<Ref<USBAlternateInterface>> USBInterface::alternates() const
+{
+    Vector<Ref<USBAlternateInterface>> result;
+    if (auto values = m_data->getArray("alternates"_s)) {
+        for (auto& value : *values) {
+            if (auto data = value->asObject())
+                result.append(USBAlternateInterface::create(data.releaseNonNull()));
+        }
+    }
+    return result;
+}
+ExceptionOr<Ref<USBAlternateInterface>> USBAlternateInterface::create(USBInterface& interface, uint8_t number)
+{
+    auto data = usbFind(interface.data(), "alternates"_s, "alternateSetting"_s, number);
+    if (!data)
+        return Exception { ExceptionCode::RangeError, "Unknown USB alternate setting"_s };
+    return create(data.releaseNonNull());
+}
+Vector<Ref<USBEndpoint>> USBAlternateInterface::endpoints() const
+{
+    Vector<Ref<USBEndpoint>> result;
+    if (auto values = m_data->getArray("endpoints"_s)) {
+        for (auto& value : *values) {
+            if (auto data = value->asObject())
+                result.append(USBEndpoint::create(data.releaseNonNull()));
+        }
+    }
+    return result;
+}
+ExceptionOr<Ref<USBEndpoint>> USBEndpoint::create(USBAlternateInterface& alternate, uint8_t number, USBDirection direction)
+{
+    for (auto& endpoint : alternate.endpoints()) {
+        if (endpoint->endpointNumber() == number && endpoint->direction() == direction)
+            return endpoint.copyRef();
+    }
+    return Exception { ExceptionCode::RangeError, "Unknown USB endpoint"_s };
+}
+} // namespace WebCore
+#endif
