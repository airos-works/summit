+namespace WebCore {
+
+// Native drag contents are copied into DragData before crossing IPC.
+
+bool DragData::canSmartReplace() const
+{
+    return false;
+}
+
+bool DragData::containsColor() const
+{
+    return false;
+}
+
+static bool containsImageHaiku(const PasteboardCustomData& data)
+{
+    for (auto type : { "image/png"_s, "image/jpeg"_s, "image/gif"_s, "image/webp"_s }) {
+        if (data.readBuffer(type))
+            return true;
+    }
+    return false;
+}
+
+bool DragData::containsFiles() const
+{
+    return !m_fileNames.isEmpty() || containsImageHaiku(m_haikuData);
+}
+
+unsigned DragData::numberOfFiles() const
+{
+    return m_fileNames.size() + containsImageHaiku(m_haikuData);
+}
+
+Vector<String> DragData::asFilenames() const
+{
+    return m_fileNames;
+}
+
+bool DragData::containsPlainText() const
+{
+    return !m_haikuData.readString("text/plain"_s).isNull();
+}
+
+String DragData::asPlainText() const
+{
+    return m_haikuData.readString("text/plain"_s);
+}
+
+Color DragData::asColor() const
+{
+    return Color();
+}
+
+bool DragData::containsCompatibleContent(WebCore::DragData::DraggingPurpose purpose) const
+{
+    if (purpose == DraggingPurpose::ForFileUpload)
+        return containsFiles();
+    return containsURL() || containsPlainText() || containsFiles()
+        || !m_haikuData.readString("text/html"_s).isNull() || containsImageHaiku(m_haikuData);
+}
+
+// A file dropped where the page takes nothing opens in the tab, as in other
+// browsers: its file: URL is the drag's URL.
+bool DragData::containsURL(FilenameConversionPolicy policy) const
+{
+    return !asURL(policy).isEmpty();
+}
+
+String DragData::asURL(FilenameConversionPolicy policy, String* title) const
+{
+    // URI lists may contain comments and multiple lines; use the first URL.
+    for (auto line : m_haikuData.readString("text/uri-list"_s).split('\n')) {
+        line = line.trim(isASCIIWhitespace);
+        if (!line.isEmpty() && !line.startsWith('#') && URL { line }.isValid()) {
+            if (title)
+                *title = line;
+            return line;
+        }
+    }
+    if (policy != ConvertFilenames || m_fileNames.isEmpty())
+        return String();
+    if (title)
+        *title = m_fileNames[0].substring(m_fileNames[0].reverseFind('/') + 1);
+    return URL::fileURLWithFileSystemPath(m_fileNames[0]).string();
+}
+
+bool DragData::shouldMatchStyleOnDrop() const
+{
+    return false;
+}
+
+
+} // namespace WebCore
