+
+static String getFinalTestURL(const String& testURL)
+{
+    if (!testURL.startsWith(ASCIILiteral::fromLiteralUnsafe("http://"))
+        && !testURL.startsWith(ASCIILiteral::fromLiteralUnsafe("https://"))) {
+        char* cFilePath = realpath(testURL.utf8().legacyCStringPointer(), NULL);
+        const String filePath = String::fromUTF8(cFilePath);
+        free(cFilePath);
+
+        if (BFile(filePath.utf8().legacyCStringPointer(), B_READ_ONLY).IsFile())
+            return makeString("file://"_s, filePath);
+    }
+
+    return testURL;
+}
+
+static inline bool isGlobalHistoryTest(const String& cTestPathOrURL)
+{
+    return cTestPathOrURL.contains(ASCIILiteral::fromLiteralUnsafe("/globalhistory/"));
+}
+
+static void createTestRunner(const String& testURL, const String& expectedPixelHash)
+{
+    gTestRunner =
+        TestRunner::create(std::string(testURL.utf8().legacyCStringPointer()),
+                                     std::string(expectedPixelHash.utf8().legacyCStringPointer()));
+
+    topLoadingFrame = 0;
+    done = false;
+    first = true;
+
+    gTestRunner->setIconDatabaseEnabled(false);
+
+    if (shouldLogFrameLoadDelegates(testURL))
+        gTestRunner->setDumpFrameLoadCallbacks(true);
+
+    if (shouldOpenWebInspector(testURL))
+        gTestRunner->showWebInspector();
+
+    gTestRunner->setDumpHistoryDelegateCallbacks(isGlobalHistoryTest(testURL));
+
+    if (shouldDumpAsText(testURL)) {
+        gTestRunner->setDumpAsText(true);
+        gTestRunner->setGeneratePixelResults(false);
+    }
+}
