+        // One sheet a content controller, so other style sheets stay.
+        static NeverDestroyed<HashMap<Ref<WebUserContentControllerProxy>, Ref<API::UserStyleSheet>>> sheets;
+        Ref controller = page->configuration().userContentController();
+        if (auto old = sheets->take(controller))
+            controller->removeUserStyleSheet(*old);
