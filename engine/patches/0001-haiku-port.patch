+
+// chrome.tabGroups (and Firefox's), for a browser without tab groups: there
+// are none to get, query, update or move, and the events never fire.
+// https://developer.chrome.com/docs/extensions/reference/api/tabGroups
+[
+    Conditional=WK_WEB_EXTENSIONS,
+    MainWorldOnly,
+    ReturnsPromiseWhenCallbackIsOmitted,
+    UseCPPAPI,
+] interface WebExtensionAPITabGroups {
+
+    [ImplementedAs=tabGroupIdentifierNone] readonly attribute double TAB_GROUP_ID_NONE;
+
+    void get(double groupId, [Optional, CallbackHandler] function callback);
+    void query([Optional, JSONValue] any queryInfo, [Optional, CallbackHandler] function callback);
+    void update(double groupId, [Optional, JSONValue] any updateProperties, [Optional, CallbackHandler] function callback);
+    void move(double groupId, [Optional, JSONValue] any moveProperties, [Optional, CallbackHandler] function callback);
+
+    readonly attribute WebExtensionAPIEvent onCreated;
+    readonly attribute WebExtensionAPIEvent onUpdated;
+    readonly attribute WebExtensionAPIEvent onRemoved;
+    readonly attribute WebExtensionAPIEvent onMoved;
+
+};
