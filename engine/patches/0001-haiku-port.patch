+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WEBUSB)
+#include "BufferSource.h"
+#include "IDLTypes.h"
+#include "JSDOMPromiseDeferredForward.h"
+#include "USBControlTransferParameters.h"
+#include "USBDescriptors.h"
+#include <wtf/CompletionHandler.h>
+
+namespace WebCore {
+
+class USBDevice final : public RefCounted<USBDevice> {
+public:
+    static Ref<USBDevice> create(Document& document, Ref<JSON::Object>&& data)
+    { return adoptRef(*new USBDevice(document, WTF::move(data))); }
+    USBDeviceState& state() const { return m_state; }
+    uint8_t usbVersionMajor() const { return usbNumber(m_state->data, "usbVersion"_s) >> 8; }
+    uint8_t usbVersionMinor() const { return (usbNumber(m_state->data, "usbVersion"_s) >> 4) & 15; }
+    uint8_t usbVersionSubminor() const { return usbNumber(m_state->data, "usbVersion"_s) & 15; }
+    uint8_t deviceClass() const { return usbNumber(m_state->data, "deviceClass"_s); }
+    uint8_t deviceSubclass() const { return usbNumber(m_state->data, "deviceSubclass"_s); }
+    uint8_t deviceProtocol() const { return usbNumber(m_state->data, "deviceProtocol"_s); }
+    uint16_t vendorId() const { return usbNumber(m_state->data, "vendorId"_s); }
+    uint16_t productId() const { return usbNumber(m_state->data, "productId"_s); }
+    uint8_t deviceVersionMajor() const { return usbNumber(m_state->data, "deviceVersion"_s) >> 8; }
+    uint8_t deviceVersionMinor() const { return (usbNumber(m_state->data, "deviceVersion"_s) >> 4) & 15; }
+    uint8_t deviceVersionSubminor() const { return usbNumber(m_state->data, "deviceVersion"_s) & 15; }
+    String manufacturerName() const { return m_state->data->getString("manufacturerName"_s); }
+    String productName() const { return m_state->data->getString("productName"_s); }
+    String serialNumber() const { return m_state->data->getString("serialNumber"_s); }
+    RefPtr<USBConfiguration> configuration() const;
+    Vector<Ref<USBConfiguration>> configurations() const;
+    bool opened() const { return m_state->opened; }
+    String identifier() const { return m_state->data->getString("id"_s); }
+    void disconnected();
+
+    void open(DOMPromiseDeferred<void>&&);
+    void close(DOMPromiseDeferred<void>&&);
+    void forget(DOMPromiseDeferred<void>&&);
+    void selectConfiguration(uint8_t, DOMPromiseDeferred<void>&&);
+    void claimInterface(uint8_t, DOMPromiseDeferred<void>&&);
+    void releaseInterface(uint8_t, DOMPromiseDeferred<void>&&);
+    void selectAlternateInterface(uint8_t, uint8_t, DOMPromiseDeferred<void>&&);
+    void clearHalt(USBDirection, uint8_t, DOMPromiseDeferred<void>&&);
+    void reset(DOMPromiseDeferred<void>&&);
+    using InPromise = DOMPromiseDeferred<IDLInterface<USBInTransferResult>>;
+    using OutPromise = DOMPromiseDeferred<IDLInterface<USBOutTransferResult>>;
+    using IsoInPromise = DOMPromiseDeferred<IDLInterface<USBIsochronousInTransferResult>>;
+    using IsoOutPromise = DOMPromiseDeferred<IDLInterface<USBIsochronousOutTransferResult>>;
+    void controlTransferIn(USBControlTransferParameters&&, uint16_t, InPromise&&);
+    void controlTransferOut(USBControlTransferParameters&&, std::optional<BufferSource>&&, OutPromise&&);
+    void transferIn(uint8_t, uint32_t, InPromise&&);
+    void transferOut(uint8_t, BufferSource&&, OutPromise&&);
+    void isochronousTransferIn(uint8_t, Vector<uint32_t>&&, IsoInPromise&&);
+    void isochronousTransferOut(uint8_t, BufferSource&&, Vector<uint32_t>&&, IsoOutPromise&&);
+
+private:
+    USBDevice(Document& document, Ref<JSON::Object>&& data) : m_state(USBDeviceState::create(document, WTF::move(data))) { }
+    Ref<JSON::Object> arguments(ASCIILiteral operation) const;
+    void changeState(Ref<JSON::Object>&&, DOMPromiseDeferred<void>&&);
+    void transfer(Ref<JSON::Object>&&, Vector<uint8_t>&&, CompletionHandler<void(ExceptionOr<Ref<JSON::Object>>&&, Vector<uint8_t>&&)>&&);
+    void inputTransfer(Ref<JSON::Object>&&, InPromise&&);
+    void outputTransfer(Ref<JSON::Object>&&, std::span<const uint8_t>, OutPromise&&);
+    Ref<USBDeviceState> m_state;
+    unsigned m_transfers { 0 };
+};
+} // namespace WebCore
+#endif
