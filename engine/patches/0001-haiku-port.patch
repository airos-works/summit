+void WebExtensionContext::tabsRemove(Vector<WebExtensionTabIdentifier> tabIdentifiers, CompletionHandler<void(std::expected<void, WebExtensionError>&&)>&& completionHandler)
+{
+    static constexpr auto apiName = "tabs.remove()"_s;
+
+    Vector<Ref<WebExtensionTab>> tabs;
+    tabs.reserveInitialCapacity(tabIdentifiers.size());
+    HashSet<WebExtensionTabIdentifier> seenIdentifiers;
+
+    for (auto& tabIdentifier : tabIdentifiers) {
+        RefPtr tab = getTab(tabIdentifier);
+        if (!tab || !tab->isOpen()) {
+            completionHandler(toWebExtensionError(apiName, nullString(), makeString("tab '"_s, tabIdentifier.toUInt64(), "' was not found"_s)));
+            return;
+        }
+        if (seenIdentifiers.add(tabIdentifier).isNewEntry)
+            tabs.append(tab.releaseNonNull());
+    }
+
+    if (tabs.isEmpty()) {
+        completionHandler({ });
+        return;
+    }
+
+    // A command goes to one window, which closes only its own tabs: one
+    // command per window, each naming all of its tabs so the window closes
+    // them together and answers once.
+    Vector<std::pair<Ref<WebExtensionWindow>, Vector<Ref<WebExtensionTab>>>> windows;
+    for (auto& tab : tabs) {
+        RefPtr window = tab->window();
+        if (!window) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "a tab is not available in the browser"_s));
+            return;
+        }
+        auto index = windows.findIf([&](auto& candidate) { return candidate.first.ptr() == window.get(); });
+        if (index == notFound)
+            windows.append({ window.releaseNonNull(), { tab } });
+        else
+            windows[index].second.append(tab);
+    }
+    // BMessage has its own operator new, so Vector cannot hold it directly.
+    Vector<std::unique_ptr<BMessage>> messages;
+    for (auto& [window, windowTabs] : windows) {
+        auto message = std::make_unique<BMessage>(B_WEBKIT_BROWSER_COMMAND);
+        bool complete = message->AddUInt32("command", B_WEBKIT_BROWSER_CLOSE_TABS) == B_OK && addNativeBrowserCommandWindow(*message, window);
+        for (auto& tab : windowTabs)
+            complete = complete && addNativeBrowserCommandTab(*message, tab);
+        if (!complete) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "a tab is not available in the browser"_s));
+            return;
+        }
+        messages.append(WTF::move(message));
+    }
+
+    // Answered once every window has; the first failure is reported.
+    struct Pending : RefCounted<Pending> {
+        CompletionHandler<void(std::expected<void, WebExtensionError>&&)> completion;
+        std::optional<WebExtensionError> error;
+        ~Pending()
+        {
+            if (error)
+                completion(makeUnexpected(WTF::move(*error)));
+            else
+                completion({ });
+        }
+    };
+    Ref pending = adoptRef(*new Pending);
+    pending->completion = WTF::move(completionHandler);
+    for (auto& message : messages) {
+        sendNativeBrowserCommand(WTF::move(*message), apiName, [pending](NativeBrowserCommandResult&& result) {
+            if (!result && !pending->error)
+                pending->error = result.error();
+        });
+    }
+}
