+
+Ref<MediaSample> MediaSampleHaiku::createNonDisplayingCopy() const
+{
+    return create(m_data.copyRef(), m_configuration.copyRef(), m_trackID, m_presentationTime, m_decodeTime, m_duration,
+        SampleFlags(m_flags | IsNonDisplaying), m_trimStart, m_trimEnd);
+}
+
+Ref<MediaSample> MediaSampleHaiku::createCopyWithAdjustedStartTime(const MediaTime& offset) const
+{
+    MediaTime clamped = std::max(MediaTime::zeroTime(), std::min(offset, m_duration));
+    return create(m_data.copyRef(), m_configuration.copyRef(), m_trackID, m_presentationTime + clamped, m_decodeTime + clamped,
+        m_duration - clamped, m_flags, m_trimStart + clamped, m_trimEnd);
+}
+
+bool MediaSampleHaiku::isDivisable() const
+{
+    return m_configuration->info.packetTimedAudio;
+}
+
+std::pair<RefPtr<MediaSample>, RefPtr<MediaSample>> MediaSampleHaiku::divide(const MediaTime& time, UseEndTime)
+{
+    if (time <= m_presentationTime)
+        return { nullptr, this };
+    if (time >= m_presentationTime + m_duration)
+        return { this, nullptr };
+    auto offset = time - m_presentationTime;
+    return {
+        create(m_data.copyRef(), m_configuration.copyRef(), m_trackID, m_presentationTime, m_decodeTime, offset,
+            m_flags, m_trimStart, m_trimEnd + m_duration - offset),
+        create(m_data.copyRef(), m_configuration.copyRef(), m_trackID, time, m_decodeTime + offset, m_duration - offset,
+            m_flags, m_trimStart + offset, m_trimEnd)
+    };
+}
