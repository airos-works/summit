+static double summitLayoutWhyTraceThreshold()
+{
+    static double threshold = [] {
+        const char* value = std::getenv("SUMMIT_LAYOUT_WHY_TRACE");
+        return value && *value ? std::atof(value) : -1.0;
+    }();
+    return threshold;
+}
