diff --git a/Tools/Scripts/generate-media-controls-images-haiku.py b/Tools/Scripts/generate-media-controls-images-haiku.py
new file mode 100644
index 0000000000000000000000000000000000000000..32dd71b3f12ace35a2ee81531ebb0a035a5bb0a5
--- /dev/null
+++ b/Tools/Scripts/generate-media-controls-images-haiku.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Write MediaControlsImagesHaiku.h: the media controls' Adwaita icons as a table
+built into WebCore. GTK and WPE read them from GResources and Windows from files
+beside the DLL; Haiku has neither. Run again after the images change:
+
+    Tools/Scripts/generate-media-controls-images-haiku.py
+"""
+import argparse
+import pathlib
+
+root = pathlib.Path(__file__).resolve().parents[2]
+parser = argparse.ArgumentParser()
+parser.add_argument('--images', type=pathlib.Path,
+                    default=root / 'Source/WebCore/Modules/modern-media-controls/images/adwaita')
+parser.add_argument('--output', type=pathlib.Path,
+                    default=root / 'Source/WebCore/platform/haiku/MediaControlsImagesHaiku.h')
+args = parser.parse_args()
+
+files = sorted(path for path in args.images.iterdir() if path.suffix in ('.svg', '.png'))
+if not files:
+    raise SystemExit('No media controls images in ' + str(args.images))
+
+lines = [
+    '// Generated by Tools/Scripts/generate-media-controls-images-haiku.py from',
+    '// Source/WebCore/Modules/modern-media-controls/images/adwaita; do not edit.',
+    '// The icons of the media controls (RenderThemeAdwaita.cpp), built into the',
+    '// library: there are no GResources on Haiku.',
+    '',
+    '#pragma once',
+    '',
+    '#include <span>',
+    '#include <wtf/StdLibExtras.h>',
+    '#include <wtf/text/WTFString.h>',
+    '',
+    'namespace WebCore {',
+    'namespace MediaControlsImagesHaiku {',
+    '',
+]
+entries = []
+for index, path in enumerate(files):
+    data = path.read_bytes()
+    if not data or len(data) > 1000000:
+        raise SystemExit('Unexpected image size: ' + str(path))
+    name = f'image{index}'
+    if path.suffix == '.svg':
+        text = data.decode('utf-8')
+        if ')SVG"' in text:
+            raise SystemExit('Raw string delimiter in ' + str(path))
+        lines.append(f'// {path.name}')
+        lines.append(f'static constexpr char {name}[] = R"SVG({text})SVG";')
+    else:
+        lines.append(f'// {path.name}')
+        escaped = ''.join(f'\\x{byte:02x}' for byte in data)
+        chunks = [escaped[start:start + 96] for start in range(0, len(escaped), 96)]
+        lines.append(f'static constexpr char {name}[] =')
+        lines += [f'    "{chunk}"' for chunk in chunks[:-1]]
+        lines.append(f'    "{chunks[-1]}";')
+    entries.append(f'    {{ "{path.stem}"_s, "{path.suffix[1:]}"_s, {{ {name}, sizeof({name}) - 1 }} }},')
+
+lines += [
+    '',
+    'struct Image {',
+    '    ASCIILiteral name;',
+    '    ASCIILiteral type;',
+    '    std::span<const char> data;',
+    '};',
+    '',
+    'static constexpr Image images[] = {',
+    *entries,
+    '};',
+    '',
+    '// The file iconName.iconType, or an empty span.',
+    'inline std::span<const uint8_t> find(const String& iconName, const String& iconType)',
+    '{',
+    '    for (auto& image : images) {',
+    '        if (iconName == image.name && iconType == image.type)',
+    '            return byteCast<uint8_t>(image.data);',
+    '    }',
+    '    return { };',
+    '}',
+    '',
+    '} // namespace MediaControlsImagesHaiku',
+    '} // namespace WebCore',
+]
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.write_text('\n'.join(lines) + '\n')
diff --git a/Tools/Scripts/generate-pdfjs-haiku-resources.py b/Tools/Scripts/generate-pdfjs-haiku-resources.py
new file mode 100644
index 0000000000000000000000000000000000000000..d20ca9f34e49e90c63fd4e5cbab489916844c631
--- /dev/null
+++ b/Tools/Scripts/generate-pdfjs-haiku-resources.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Embed the pinned PDF.js resources for the native Haiku resource loader."""
+import argparse
+import json
+import pathlib
+import re
+import zlib
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--pdfjs', type=pathlib.Path, required=True)
+parser.add_argument('--extras', type=pathlib.Path, required=True)
+parser.add_argument('--output', type=pathlib.Path, required=True)
+args = parser.parse_args()
+
+manifest = (args.pdfjs / 'PdfJSFiles.cmake').read_text()
+paths = re.findall(r'\$\{THIRDPARTY_DIR\}/pdfjs/([^\s)]+)', manifest)
+if not paths or len(paths) != len(set(paths)):
+    raise SystemExit('Invalid PDF.js resource manifest')
+resources = {f'/{path}': (args.pdfjs / path).read_bytes() for path in paths}
+for name in ['configuration.js', 'content-script.js', 'style.css']:
+    resources['/extras/haiku/' + name] = (args.extras / name).read_bytes()
+# Install settings before the viewer module initializes. This customization
+# stays outside the vendored upstream distribution and is checked at build time.
+viewer = resources['/web/viewer.html'].decode()
+if viewer.count('<head>') != 1:
+    raise SystemExit('PDF.js viewer head changed')
+resources['/web/viewer.html'] = viewer.replace('<head>',
+    '<head>\n<script src="../extras/haiku/configuration.js"></script>', 1).encode()
+mime = {'.mjs': 'text/javascript', '.js': 'text/javascript', '.css': 'text/css',
+        '.html': 'text/html', '.json': 'application/json', '.svg': 'image/svg+xml',
+        '.png': 'image/png', '.gif': 'image/gif', '.ttf': 'font/ttf', '.pfb': 'application/x-font-type1',
+        '.ftl': 'text/plain', '.wasm': 'application/wasm'}
+lines = ['// Generated; do not edit.', '#include "config.h"', '#include "PDFJSResourcesHaiku.h"',
+         '#include <algorithm>', '#include <iterator>', 'namespace WebCore {', 'namespace {']
+entries = []
+for index, (path, data) in enumerate(sorted(resources.items())):
+    if not data or len(data) > 16000000:
+        raise SystemExit('Unexpected PDF.js resource size: ' + path)
+    packed = zlib.compress(data, 9)
+    lines.append(f'static const unsigned char resource{index}[] = {{')
+    for start in range(0, len(packed), 24):
+        lines.append(','.join(str(byte) for byte in packed[start:start + 24]) + ',')
+    lines.append('};')
+    media_type = mime.get(pathlib.Path(path).suffix, 'application/octet-stream')
+    entries.append(f'{{ {json.dumps(path)}, {json.dumps(media_type)}, resource{index}, sizeof(resource{index}), {len(data)} }},')
+lines += ['static const PDFJSResourceHaiku resources[] = {', *entries, '};', '}',
+          'const PDFJSResourceHaiku* findPDFJSResourceHaiku(std::string_view path) {',
+          '    auto* item = std::lower_bound(std::begin(resources), std::end(resources), path,',
+          '        [](const auto& resource, auto name) { return resource.path < name; });',
+          '    return item != std::end(resources) && item->path == path ? item : nullptr;', '}', '}']
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.write_text('\n'.join(lines) + '\n')
