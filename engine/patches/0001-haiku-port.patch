+#if USE(JPEGXR)
+    if (spanHasPrefix(contentsSpan, unsafeMakeSpan("\x49\x49\xbc\x01", 4)))
+        return JPEGXRImageDecoder::create(alphaOption, gammaAndColorProfileOption);
+#endif
+
+#if USE(HEIF)
+    // AVIF's existing sniff accepts any ftyp box. Identify HEVC brands first,
+    // including compatible brands in a generic mif1 container.
+    if (spanHasPrefix(contentsSpan.subspan(4), "ftyp"_span)) {
+        const uint32_t boxSize = (static_cast<uint32_t>(contents[0]) << 24)
+            | (static_cast<uint32_t>(contents[1]) << 16) | (static_cast<uint32_t>(contents[2]) << 8) | contents[3];
+        if (boxSize >= 16 && boxSize <= 4096 && data.size() >= boxSize) {
+            Vector<uint8_t> brands(boxSize);
+            data.copyTo(brands.mutableSpan());
+            for (size_t offset = 8; offset + 4 <= boxSize; offset += 4) {
+                if (offset == 12) // minor version, not a brand
+                    continue;
+                auto brand = brands.span().subspan(offset, 4);
+                if (spanHasPrefix(brand, "heic"_span) || spanHasPrefix(brand, "heix"_span)
+                    || spanHasPrefix(brand, "hevc"_span) || spanHasPrefix(brand, "hevx"_span))
+                    return HEIFImageDecoder::create(alphaOption, gammaAndColorProfileOption);
+            }
+        } else if (boxSize <= 4096 && data.size() < boxSize)
+            return nullptr; // Wait for the complete brand box before choosing a decoder.
+    }
+#endif
+
 #if USE(AVIF)
     if (matchesAVIFSignature(contentsSpan, data))
         return AVIFImageDecoder::create(alphaOption, gammaAndColorProfileOption);
