diff --git a/Source/WebCore/Modules/webhid/HIDDevice.cpp b/Source/WebCore/Modules/webhid/HIDDevice.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b3422e11fafa99793a6a3f3f7eae2a841afcd980
--- /dev/null
+++ b/Source/WebCore/Modules/webhid/HIDDevice.cpp
@@ -0,0 +1,240 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#if ENABLE(WEBUSB)
+#include "HIDDevice.h"
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventNames.h"
+#include "EventTargetInlines.h"
+#include "HID.h"
+#include "HIDInputReportEvent.h"
+#include "JSDOMConvertBufferSource.h"
+#include "JSDOMPromiseDeferred.h"
+#include <JavaScriptCore/ArrayBuffer.h>
+#include <JavaScriptCore/JSONObject.h>
+#include <JavaScriptCore/ObjectConstructor.h>
+#include <JavaScriptCore/TopExceptionScope.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(HIDDevice);
+
+static constexpr size_t maximumReportLength = 65536;
+
+Ref<HIDDevice> HIDDevice::create(Document& document, Ref<JSON::Object>&& data)
+{
+    auto result = adoptRef(*new HIDDevice(document, WTF::move(data)));
+    result->suspendIfNeeded();
+    return result;
+}
+HIDDevice::HIDDevice(Document& document, Ref<JSON::Object>&& data)
+    : ActiveDOMObject(&document), m_data(WTF::move(data))
+{
+    m_identifier = m_data->getString("id"_s);
+    if (auto collections = m_data->getArray("collections"_s))
+        m_collections = collections->toJSONString();
+    else
+        m_collections = "[]"_s;
+}
+HIDDevice::~HIDDevice() = default;
+Document* HIDDevice::document() const { return dynamicDowncast<Document>(scriptExecutionContext()); }
+
+static uint16_t number(const JSON::Object& data, ASCIILiteral key)
+{
+    auto value = data.getInteger(key).value_or(0);
+    return value < 0 || value > 65535 ? 0 : value;
+}
+uint16_t HIDDevice::vendorId() const { return number(m_data, "vendorId"_s); }
+uint16_t HIDDevice::productId() const { return number(m_data, "productId"_s); }
+String HIDDevice::productName() const
+{
+    auto name = m_data->getString("productName"_s);
+    return name.isNull() ? emptyString() : name;
+}
+
+JSC::JSValue HIDDevice::collections(JSC::JSGlobalObject& globalObject) const
+{
+    // Built once per wrapper (the attribute is cached) from the descriptor
+    // the browser process parsed, then frozen as a FrozenArray would be.
+    auto& vm = globalObject.vm();
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(vm);
+    auto value = JSC::JSONParse(&globalObject, m_collections);
+    if (scope.exception() || !value.isObject()) {
+        scope.clearException();
+        value = JSC::JSONParse(&globalObject, "[]"_s);
+        scope.clearException();
+        return value;
+    }
+    JSC::objectConstructorFreeze(&globalObject, asObject(value));
+    scope.clearException();
+    return value;
+}
+
+void HIDDevice::update(Ref<JSON::Object>&& data)
+{
+    // The same interface: the collections never change.
+    m_data = WTF::move(data);
+}
+
+void HIDDevice::disconnected()
+{
+    m_opened = false;
+    ++m_generation;
+}
+
+Ref<JSON::Object> HIDDevice::arguments(ASCIILiteral operation) const
+{
+    auto result = JSON::Object::create();
+    result->setString("operation"_s, operation);
+    result->setString("id"_s, m_identifier);
+    return result;
+}
+
+void HIDDevice::changeState(ASCIILiteral operation, DOMPromiseDeferred<void>&& promise)
+{
+    bool opening = operation == "open"_s;
+    if (m_busy) {
+        promise.reject(ExceptionCode::InvalidStateError, "A HID open or close is still pending"_s);
+        return;
+    }
+    if ((opening && m_opened) || (operation == "close"_s && !m_opened)) {
+        promise.resolve();
+        return;
+    }
+    m_busy = true;
+    if (!opening) {
+        // Closing ends input at once; the browser answers a pending receive.
+        m_opened = false;
+        ++m_generation;
+    }
+    HID::perform(document(), arguments(operation), { },
+        [this, protectedThis = Ref { *this }, opening, operation, promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+            m_busy = false;
+            if (response.hasException()) {
+                promise.reject(response.releaseException());
+                return;
+            }
+            if (operation == "forget"_s)
+                m_forgotten = true;
+            if (opening && !m_stopped) {
+                m_opened = true;
+                ++m_generation;
+                receive();
+            }
+            promise.resolve();
+        });
+}
+void HIDDevice::open(DOMPromiseDeferred<void>&& promise) { changeState("open"_s, WTF::move(promise)); }
+void HIDDevice::close(DOMPromiseDeferred<void>&& promise) { changeState("close"_s, WTF::move(promise)); }
+void HIDDevice::forget(DOMPromiseDeferred<void>&& promise) { changeState("forget"_s, WTF::move(promise)); }
+
+void HIDDevice::send(ASCIILiteral operation, uint8_t reportId, BufferSource&& data, DOMPromiseDeferred<void>&& promise)
+{
+    if (!m_opened) {
+        promise.reject(ExceptionCode::InvalidStateError, "The HID device is not open"_s);
+        return;
+    }
+    if (data.byteLength() > maximumReportLength) {
+        promise.reject(ExceptionCode::TypeError, "The HID report is too long"_s);
+        return;
+    }
+    auto args = arguments(operation);
+    args->setInteger("reportId"_s, reportId);
+    HID::perform(document(), WTF::move(args), Vector<uint8_t>(data.span()), [promise = WTF::move(promise)](auto&& response, auto&&) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        promise.resolve();
+    });
+}
+void HIDDevice::sendReport(uint8_t reportId, BufferSource&& data, DOMPromiseDeferred<void>&& promise)
+{
+    send("sendReport"_s, reportId, WTF::move(data), WTF::move(promise));
+}
+void HIDDevice::sendFeatureReport(uint8_t reportId, BufferSource&& data, DOMPromiseDeferred<void>&& promise)
+{
+    send("sendFeatureReport"_s, reportId, WTF::move(data), WTF::move(promise));
+}
+void HIDDevice::receiveFeatureReport(uint8_t reportId, DOMPromiseDeferred<IDLDataView>&& promise)
+{
+    if (!m_opened) {
+        promise.reject(ExceptionCode::InvalidStateError, "The HID device is not open"_s);
+        return;
+    }
+    auto args = arguments("receiveFeatureReport"_s);
+    args->setInteger("reportId"_s, reportId);
+    HID::perform(document(), WTF::move(args), { }, [promise = WTF::move(promise)](auto&& response, auto&& bytes) mutable {
+        if (response.hasException()) {
+            promise.reject(response.releaseException());
+            return;
+        }
+        auto view = JSC::DataView::create(JSC::ArrayBuffer::create(bytes.span()), 0, bytes.size());
+        promise.resolve(view.get());
+    });
+}
+
+// While open, one request waits in the browser process for input reports.
+void HIDDevice::receive()
+{
+    if (m_receiving || !m_opened || m_stopped)
+        return;
+    m_receiving = true;
+    auto generation = m_generation;
+    HID::perform(document(), arguments("receive"_s), { },
+        [this, protectedThis = Ref { *this }, generation](auto&& response, auto&& bytes) mutable {
+            m_receiving = false;
+            if (m_stopped || !m_opened || generation != m_generation)
+                return;
+            if (response.hasException()) {
+                // The device went away or the browser closed it.
+                if (response.exception().code() == ExceptionCode::NotFoundError || response.exception().code() == ExceptionCode::InvalidStateError
+                    || response.exception().code() == ExceptionCode::SecurityError || response.exception().code() == ExceptionCode::AbortError) {
+                    disconnected();
+                    return;
+                }
+                receive();
+                return;
+            }
+            auto result = response.releaseReturnValue();
+            Vector<Ref<Event>> events;
+            if (auto reports = result->getArray("reports"_s)) {
+                size_t offset = 0;
+                for (auto& value : *reports) {
+                    auto report = value->asObject();
+                    if (!report)
+                        break;
+                    auto reportId = report->getInteger("reportId"_s).value_or(-1);
+                    auto length = report->getInteger("length"_s).value_or(-1);
+                    if (reportId < 0 || reportId > 255 || length < 0 || size_t(length) > bytes.size() - offset)
+                        break;
+                    auto buffer = JSC::ArrayBuffer::create(bytes.span().subspan(offset, length));
+                    offset += length;
+                    events.append(HIDInputReportEvent::create(eventNames().inputreportEvent, *this, reportId,
+                        JSC::DataView::create(WTF::move(buffer), 0, length)));
+                }
+            }
+            // Ask for more before running page code, which may close this.
+            receive();
+            for (auto& event : events) {
+                if (m_stopped || generation != m_generation)
+                    break;
+                dispatchEvent(event);
+            }
+        });
+}
+
+bool HIDDevice::virtualHasPendingActivity() const
+{
+    // An open device delivers input reports to its listeners.
+    return !m_stopped && (m_opened || m_busy);
+}
+
+void HIDDevice::stop()
+{
+    m_stopped = true;
+    m_opened = false;
+    ++m_generation;
+}
+} // namespace WebCore
+#endif
