+void MediaPlayerPrivateHaikuMSE::videoFrameAvailable()
+{
+    if (!m_videoRenderer)
+        return;
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    auto size = m_videoRenderer->frameSize();
+    if (!size.isEmpty() && FloatSize(size) != m_naturalSize) {
+        m_naturalSize = FloatSize(size);
+        player->sizeChanged();
+    }
+    if (m_dash) dashChanged();
+    if (!m_clock.isRunning() && !m_paused)
+        updatePlaybackState();
+    if (!m_announcedFirstFrame) {
+        m_announcedFirstFrame = true;
+        MSE_TRACE("first video frame %dx%d at %.3f\n", size.width(), size.height(), currentTime().toDouble());
+        player->firstVideoFrameAvailable();
+    }
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+    if (m_layerBufferProxy && m_layerBufferProxy->isValid())
+        return;
+#endif
+    player->repaint();
+}
+
+#if defined(HAIKU_MSE_COMPOSITED_VIDEO)
+void MediaPlayerPrivateHaikuMSE::setPlatformLayerBufferProxy(Ref<CoordinatedPlatformLayerBufferProxy>&& proxy)
+{
+    m_layerBufferProxy = proxy.copyRef();
+    videoRenderer().setLayerBufferProxy(proxy.copyRef());
+    MSE_TRACE("video goes to the compositor\n");
+    if (auto image = videoRenderer().currentFrame()) {
+        if (RefPtr nativeImage = NativeImage::create(WTF::move(image)))
+            proxy->setInitialDisplayBuffer(CoordinatedPlatformLayerBufferNativeImage::create(nativeImage.releaseNonNull(), nullptr));
+    }
+}
+#endif
+
+void MediaPlayerPrivateHaikuMSE::paint(GraphicsContext& context, const FloatRect& rect)
+{
+    if (context.paintingDisabled() || !m_videoRenderer)
+        return;
+#if USE(SKIA)
+    auto image = m_videoRenderer->currentFrame();
+    if (!image)
+        return;
+    if (auto frame = NativeImage::create(WTF::move(image)))
+        context.drawNativeImage(*frame, rect, FloatRect({ }, frame->size()));
+#else
+    UNUSED_PARAM(rect);
+#endif
+}
+
+#if USE(SKIA)
+RefPtr<NativeImage> MediaPlayerPrivateHaikuMSE::nativeImageForCurrentTime()
+{
+    if (!m_videoRenderer)
+        return nullptr;
+    auto image = m_videoRenderer->currentFrame();
+    if (!image)
+        return nullptr;
+    if (image->uniqueID() == m_readerSourceID && m_readerImage)
+        return m_readerImage;
+    // With its alpha bytes set: decoders leave them undefined in B_RGB32,
+    // and texImage2D copies them into the texture.
+    SkPixmap source;
+    if (!image->peekPixels(&source) || source.colorType() != kBGRA_8888_SkColorType)
+        return NativeImage::create(WTF::move(image));
+    auto info = source.info().makeAlphaType(kOpaque_SkAlphaType);
+    auto pixels = SkData::MakeUninitialized(source.rowBytes() * source.height());
+    auto* from = static_cast<const uint32_t*>(source.addr());
+    auto* to = static_cast<uint32_t*>(pixels->writable_data());
+    for (size_t i = 0, count = source.rowBytes() / 4 * source.height(); i < count; ++i)
+        to[i] = from[i] | 0xff000000;
+    m_readerSourceID = image->uniqueID();
+    m_readerImage = NativeImage::create(SkImages::RasterFromData(info, WTF::move(pixels), source.rowBytes()));
+    return m_readerImage;
+}
+#endif
+
+std::optional<VideoFrameMetadata> MediaPlayerPrivateHaikuMSE::videoFrameMetadata()
+{
+    unsigned presented = m_videoRenderer ? m_videoRenderer->framesHandedOn() : 0;
+    if (!presented || presented == m_lastMetadataFrames)
+        return std::nullopt;
+    m_lastMetadataFrames = presented;
+    VideoFrameMetadata metadata;
+    auto size = naturalSize();
+    metadata.width = size.width();
+    metadata.height = size.height();
+    metadata.presentedFrames = presented;
+    metadata.mediaTime = currentTime().toDouble();
+    metadata.presentationTime = MonotonicTime::now().secondsSinceEpoch().seconds();
+    metadata.expectedDisplayTime = metadata.presentationTime;
+    return metadata;
+}
