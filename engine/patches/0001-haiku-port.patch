+    void clearAllEditCommands() override;
+    bool canUndoRedo(UndoOrRedo) override;
+    void executeUndoRedo(UndoOrRedo) override;
+    void wheelEventWasNotHandledByWebCore(const NativeWebWheelEvent&) override { }
+    WebCore::FloatRect convertToDeviceSpace(const WebCore::FloatRect& rect) override { return rect; }
+    WebCore::FloatRect convertToUserSpace(const WebCore::FloatRect& rect) override { return rect; }
+    WebCore::IntPoint screenToRootView(const WebCore::IntPoint&) override;
+    WebCore::IntPoint rootViewToScreen(const WebCore::IntPoint&) override;
+    WebCore::IntRect rootViewToScreen(const WebCore::IntRect&) override;
+    WebCore::IntPoint accessibilityScreenToRootView(const WebCore::IntPoint& point) override { return screenToRootView(point); }
+    WebCore::IntRect rootViewToAccessibilityScreen(const WebCore::IntRect& rect) override { return rootViewToScreen(rect); }
+    void doneWithKeyEvent(const NativeWebKeyboardEvent&, bool) override { }
+    RefPtr<WebPopupMenuProxy> createPopupMenuProxy(WebPageProxy&) override;
+#if ENABLE(CONTEXT_MENUS)
+    Ref<WebContextMenuProxy> createContextMenuProxy(WebPageProxy&, FrameInfoData&&, ContextMenuContextData&&, const UserData&) override;
+#endif
+    RefPtr<WebColorPicker> createColorPicker(WebPageProxy&, const WebCore::Color&, ColorControlSupportsAlpha, Vector<WebCore::Color>&&, std::optional<WebCore::FrameIdentifier>) override;
+    RefPtr<WebDataListSuggestionsDropdown> createDataListSuggestionsDropdown(WebPageProxy&) override;
+    RefPtr<WebDateTimePicker> createDateTimePicker(WebPageProxy&) override;
+#if USE(COORDINATED_GRAPHICS)
+    // The layer tree context carries the identifier of the surface the web
+    // process paints into; the backing store receives its frames.
+    void enterAcceleratedCompositingMode(const LayerTreeContext& context) override { updateAcceleratedSurface(context.contextID); }
+    void exitAcceleratedCompositingMode() override { updateAcceleratedSurface(0); }
+    void updateAcceleratedCompositingMode(const LayerTreeContext& context) override { updateAcceleratedSurface(context.contextID); }
+    void updateAcceleratedSurface(uint64_t);
+#else
+    void enterAcceleratedCompositingMode(const LayerTreeContext&) override { }
+    void exitAcceleratedCompositingMode() override { }
+    void updateAcceleratedCompositingMode(const LayerTreeContext&) override { }
+#endif
+    void didChangeContentSize(const WebCore::IntSize&) override;
+    void didCommitLoadForMainFrame(const String&, bool) override { notifyState(); }
+    void didFinishLoadingDataForCustomContentProvider(const String&, std::span<const uint8_t>) override { }
+    void navigationGestureDidBegin() override { }
+    void navigationGestureWillEnd(bool, WebBackForwardListItem&) override { }
+    void navigationGestureDidEnd(bool, WebBackForwardListItem&) override { }
+    void navigationGestureDidEnd() override { }
+    void willRecordNavigationSnapshot(WebBackForwardListItem&) override { }
+    void didRemoveNavigationGestureSnapshot() override { }
+    void didFirstVisuallyNonEmptyLayoutForMainFrame() override { notifyState(); }
+    void didFinishNavigation(API::Navigation*) override { notifyState(); }
+    void didFailNavigation(API::Navigation*) override { notifyState(); }
+    void didSameDocumentNavigationForMainFrame(SameDocumentNavigationType) override { notifyState(); }
+    void didChangeBackgroundColor() override { }
+    void isPlayingAudioWillChange() override { }
+    void isPlayingAudioDidChange() override { notifyState(); }
+    // Camera, microphone or screen capture started or stopped: the host shows it.
+    void microphoneCaptureChanged() override { notifyState(); }
+    void cameraCaptureChanged() override { notifyState(); }
+    void displayCaptureChanged() override { notifyState(); }
+    void refView() override { ref(); }
+    void derefView() override { deref(); }
+    void didRestoreScrollPosition() override { }
+    WebCore::UserInterfaceLayoutDirection userInterfaceLayoutDirection() override { return WebCore::UserInterfaceLayoutDirection::LTR; }
+    void requestDOMPasteAccess(WebCore::DOMPasteAccessCategory, WebCore::DOMPasteRequiresInteraction, WebCore::FrameIdentifier, const WebCore::IntRect&, const String&, CompletionHandler<void(WebCore::DOMPasteAccessResponse)>&&) override;
+    void processWillSwap() override;
+
+#if ENABLE(FULLSCREEN_API)
+    WebFullScreenManagerProxyClient& fullScreenManagerProxyClient() override { return m_fullScreenTestClient ? *m_fullScreenTestClient : *this; }
+    void setFullScreenClientForTesting(std::unique_ptr<WebFullScreenManagerProxyClient>&& client) override { m_fullScreenTestClient = WTF::move(client); }
+    void closeFullScreenManager() override;
+    bool isFullScreen() override { return m_fullScreen; }
+    void enterFullScreen(WebCore::FloatSize, CompletionHandler<void(bool)>&&) override;
+    void exitFullScreen(CompletionHandler<void()>&&) override;
+    void beganEnterFullScreen(const WebCore::IntRect&, const WebCore::IntRect&, CompletionHandler<void(bool)>&& completion) override { completion(m_fullScreen); }
+    void beganExitFullScreen(const WebCore::IntRect&, const WebCore::IntRect&, CompletionHandler<void()>&& completion) override { completion(); }
+    void requestFullScreen(bool, CompletionHandler<void(bool)>&&);
+    void finishFullScreenRequest(uint64_t, bool);
+    bool m_fullScreen { false };
+    bool m_fullScreenRequested { false };
+    uint64_t m_fullScreenRequest { 0 };
+    CompletionHandler<void(bool)> m_fullScreenCompletion;
+    std::unique_ptr<WebFullScreenManagerProxyClient> m_fullScreenTestClient;
+#endif
+    const std::shared_ptr<WebViewStateHaiku> m_state;
+    RefPtr<WebPageProxy> m_page;
+    WeakPtr<WebDateTimePicker> m_dateTimePicker;
+    WeakPtr<WebDataListSuggestionsDropdown> m_dataListSuggestions;
+    DefaultUndoController m_undoController;
+    CompletionHandler<void()> m_presentationCallback;
+    uint64_t m_presentationIdentifier { 0 };
+    // A frame the view never showed breaks the chain of damage from one
+    // frame to the next, so the next one it shows is redrawn whole.
+    bool m_presentationNeedsFullRedraw { true };
+    uint32_t m_buttons { 0 };
+    // Destination contents and reply address, owned by WebKit's main thread.
+    Vector<String> m_dragFiles;
+    WebCore::PasteboardCustomData m_dragData;
+    OptionSet<WebCore::DragOperation> m_dragOperations;
+    BMessenger m_dropSource;
+    uint64_t m_dropSession { 0 };
+    BPoint m_dropScreenPoint;
+
+#if USE(COORDINATED_GRAPHICS)
+    RefPtr<AcceleratedBackingStore> m_acceleratedBackingStore;
+#endif
+};
+
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/haiku/WebViewStateHaiku.h b/Source/WebKit/UIProcess/haiku/WebViewStateHaiku.h
new file mode 100644
index 0000000000000000000000000000000000000000..b2945258d1674302b0bcb47785cd25ab0bb058a4
--- /dev/null
+++ b/Source/WebKit/UIProcess/haiku/WebViewStateHaiku.h
@@ -0,0 +1,233 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+#pragma once
+
+#include "BitmapPresenterHaiku.h"
+#include "JavaScriptDialogRequestsHaiku.h"
+#include <Messenger.h>
+#include <Rect.h>
+#include <WebCore/IntPoint.h>
+#include <WebCore/NavigationIdentifier.h>
+#include <WebCore/ResourceRequest.h>
+#include <WebCore/ScriptExecutionContextIdentifier.h>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+class BMessageFilter;
+class BMessageRunner;
+#include <wtf/RefPtr.h>
+#include <wtf/SharedTask.h>
+#include <wtf/text/WTFString.h>
+
+class BWindow;
+namespace API { class ContentWorld; }
+
+namespace WebKit {
+
+class DirectPresentTargetHaiku;
+class WebPageProxy;
+class WebView;
+class WebViewContextHaiku;
+
+enum : uint32_t {
+    viewFrameHaiku = 'wvfr', viewGeometryHaiku = 'wvge', viewInputHaiku = 'wvin',
+    viewDownloadHaiku = 'wvdn', viewLoadHaiku = 'wvld', viewBackHaiku = 'wvba', viewForwardHaiku = 'wvfo',
+    viewReloadHaiku = 'wvrl', viewStopHaiku = 'wvst', viewPresentedHaiku = 'wvpr',
+    viewContinueCertificateHaiku = 'wvcc',
+    viewCursorHaiku = 'wvcu', viewTooltipHaiku = 'wvtt',
+    viewFindHaiku = 'wvfi', viewHideFindHaiku = 'wvhf',
+    viewZoomHaiku = 'wvzo', viewEditHaiku = 'wved', viewRequestCloseHaiku = 'wvcl',
+    viewDismissDataListHaiku = 'wvdl',
+    viewResetCloseHaiku = 'wvcr', viewRetryCloseHaiku = 'wvrc',
+    // Files dragged over the view: phase ("entered", "updated", "exited",
+    // "drop"), local, screen, repeated path (with entered and drop).
+    viewDragHaiku = 'wvdg', viewStartDragHaiku = 'wvds',
+    viewDragStartedHaiku = 'wvda', viewDragEndedHaiku = 'wvdz',
+    viewNegotiatedDropTimeoutHaiku = 'wdnt',
+    viewNativeDragTickHaiku = 'wdtk', viewNativeDragPendingHaiku = 'wdpn', viewNativeDragReplyHaiku = 'wdrp',
+    // Presenting straight into the screen (DirectPresentHaiku.h): the view
+    // has a target for its page, or the page needs presenting again in full.
+    viewDirectTargetHaiku = 'wvdt', viewDirectRedisplayHaiku = 'wvdr',
+    // To the view itself: app_server has copied its own copy of the screen
+    // over part of the page (BWebKitView::Draw); once it is done, present the
+    // page again in full.
+    viewDirectExposedHaiku = 'wvde',
+    viewPreconnectHaiku = 'wvpc',
+    viewFullScreenResultHaiku = 'wvfa', viewExitFullScreenHaiku = 'wvfx'
+};
+
+struct WebViewGeometryHaiku {
+    WebCore::IntSize size;
+    WebCore::IntPoint screenOrigin;
+    WebCore::IntRect windowFrame;
+    // Frame buffer pixels per logical pixel; see displayScaleFactorHaiku().
+    float scale { 1 };
+    bool attached { false };
+    bool visible { false };
+    bool focused { false };
+    bool active { false };
+    bool operator==(const WebViewGeometryHaiku&) const = default;
+};
+
+struct WebViewStateHaiku {
+    explicit WebViewStateHaiku(BMessenger);
+    ~WebViewStateHaiku();
+
+    std::mutex mutex;
+    WebViewGeometryHaiku geometry;
+    BMessenger view;
+    // Where notifications go. Changed only on the WebKit main thread
+    // (BWebKitView::SetNotificationTarget), which is where it is read.
+    BMessenger target;
+    BitmapPresenterHaiku presenter;
+    std::atomic<bool> closed { false };
+    // A file drag from another application is over the view (window thread).
+    bool dragActive { false };
+    // Invalidated by navigation, another drop, a click, or detaching the view.
+    std::atomic<uint64_t> nativeDropRequest { 0 };
+    // Source session: only the native window thread touches these fields.
+    uint64_t sourceDragSession { 0 };
+    bool sourceDragActive { false };
+    bool sourceDragPending { false };
+    bigtime_t sourceDragReleasedAt { 0 };
+    std::unique_ptr<BMessage> sourceDragData;
+    std::unique_ptr<BMessageRunner> sourceDragTimer;
+    // Window thread: the filter that tells the view when its window is
+    // minimized, restored or moved between workspaces (WebKitView.cpp), and
+    // whether the window is on the workspace shown.
+    BMessageFilter* windowFilter { nullptr };
+    bool onCurrentWorkspace { true };
+    std::atomic<status_t> status { B_NO_INIT };
+    std::atomic<uint64_t> findRequestIdentifier { 0 };
+    // The host answers HTTP authentication challenges
+    // (BWebKitView::SetAuthenticationRequests).
+    std::atomic<bool> asksForAuthentication { false };
+    const std::shared_ptr<JavaScriptDialogRequestsHaiku> dialogs { std::make_shared<JavaScriptDialogRequestsHaiku>() };
+    std::shared_ptr<WebViewContextHaiku> context;
+    // Where on the screen the page goes when the view's window is a direct
+    // window with B_DIRECT_DEVICE_PIXELS (WebKitView.cpp keeps it current).
+    // Made once, on first use; guarded by `mutex`.
+    std::shared_ptr<DirectPresentTargetHaiku> directTarget;
+    // The view's frame in its window's coordinates and whether it shows,
+    // kept by the view for that; guarded by WebKitView.cpp's registry lock.
+    struct DirectView {
+        BWindow* window { nullptr };
+        BRect frame;
+        bool visible { false };
+    } directView;
+    // The last frame went into the screen directly, so the view's bitmap is
+    // older than the screen and must not be drawn over it.
+    std::atomic<bool> presentedDirectly { false };
+    // Frames presented directly so far: a frame app_server draws while one
+    // goes into the screen may land on top of it.
+    std::atomic<uint32_t> directFrames { 0 };
+    // A viewDirectExposedHaiku is on its way to the view.
+    std::atomic<bool> directExposurePending { false };
+    // This reference is read, assigned and released only on the WebKit main
+    // thread. Native windows retain the state without touching the client.
+    RefPtr<WebView> client;
+    // Browser-owned persistent inspection world. Created, used and cleared
+    // only on the WebKit main thread, independently for each native view.
+    RefPtr<API::ContentWorld> inspectionWorld;
+    bool softwareRendering { false }; // WebKit main thread only.
+    // Read, invoked and cleared only on the WebKit main thread.
+    RefPtr<SharedTask<void(const WebCore::IntSize&)>> contentSizeChanged;
+    // Main-thread load bookkeeping, separate from the close-handshake
+    // generation: policy/start/commit can all describe the same navigation.
+    struct LoadState {
+        uint64_t navigationIdentifier { 0 };
+        uint64_t generation { 0 };
+        bool identified { false };
+        bool pending { false };
+        bool stopped { false };
+        bool committed { false };
+        std::optional<WebCore::ScriptExecutionContextIdentifier> sameDocumentIdentifier;
+        String sameDocumentURL;
+        const char* outcome { "idle" };
+        String errorDescription;
+        String errorDomain;
+        String errorURL;
+        int errorCode { 0 };
+        bool errorProvisional { false };
+        // The server certificate that failed verification, when that is why
+        // the load failed: what the user needs to decide whether to trust it.
+        struct Certificate {
+            String host;
+            String sha256; // hex, of the DER leaf certificate
+            String subject;
+            String issuer;
+            String problem;
+            String names; // DNS names and addresses it is valid for, comma-separated
+            double validFrom { 0 }; // seconds since the epoch
+            double validUntil { 0 };
+        };
+        std::optional<Certificate> errorCertificate;
+        std::optional<WebCore::ResourceRequest> errorRequest;
+        // Keep the last successful load in every snapshot so a dropped
+        // progress notification cannot turn a failed load into a visit.
+        uint64_t successSequence { 0 };
+        String successURL;
+        String successTitle;
+    } load;
+    // Certificates this view's requests rejected lately (main thread): the
+    // challenge carries the certificate, the failed load only an error code.
+    std::vector<LoadState::Certificate> rejectedCertificates;
+    // These close-handshake flags are also confined to the WebKit main thread.
+    bool closeRequestPending { false };
+    bool closeRequestApproved { false };
+    bool closeDecisionInFlight { false };
+    uint64_t closeRequestGeneration { 0 };
+    uint64_t navigationGeneration { 0 };
+    uint64_t usbGeneration { 0 };
+    uint64_t bluetoothGeneration { 0 };
+    uint64_t closeNavigationGeneration { 0 };
+    // The policy callback for a native request is asynchronous. Its matching
+    // identifier describes the request we already observed, not a new one.
+    std::optional<WebCore::NavigationIdentifier> nativeNavigationIdentifier;
+    std::optional<WebCore::ScriptExecutionContextIdentifier> documentIdentifier;
+    std::optional<WebCore::ScriptExecutionContextIdentifier> closeDocumentIdentifier;
+    bool closeApprovalInvalidated { false };
+};
+
+// The density app_server draws the screen at: 2 on 4K monitors at 200%.
+// Pages render at this device scale so that their frames reach the screen
+// pixel for pixel instead of being enlarged. Cached; safe on any thread.
+float displayScaleFactorHaiku();
+
+void commitViewCloseHaiku(std::vector<std::shared_ptr<WebViewStateHaiku>>, BMessenger, uint64_t);
+
+void dispatchViewMessageHaiku(std::shared_ptr<WebViewStateHaiku>, BMessage&&);
+
+// Main thread only. Starts a spare web process for the next new site, at once
+// or a second later (WebView.cpp); nothing when one is ready.
+void prewarmWebProcessHaiku(WebPageProxy&, bool now);
+
+// Main thread only. Answer a B_WEBKIT_NEW_PAGE_REQUESTED identifier with this
+// view's state, or decline it.
+void openNewPageHaiku(std::shared_ptr<WebViewStateHaiku>, uint64_t identifier, const BMessage& initialSettings);
+status_t validatePageSettingsHaiku(const BMessage&);
+void applyPageSettingsHaiku(WebPageProxy&, const BMessage&);
+void declineNewPageHaiku(uint64_t identifier);
+// Main thread only. Answers a B_WEBKIT_AUTHENTICATION_REQUESTED identifier:
+// sign in with user and password (for the session, or this request only),
+// continue without (the page gets the server's own response), or cancel the
+// request.
+enum class AuthenticationAnswerHaiku : uint8_t { SignIn, Continue, Cancel };
+void answerAuthenticationHaiku(uint64_t identifier, AuthenticationAnswerHaiku, const String& user, const String& password, bool forSession);
+// Main thread only. Runs an extension item of the last B_WEBKIT_CONTEXT_MENU.
+void performExtensionMenuItemHaiku(uint64_t token);
+#if ENABLE(WK_WEB_EXTENSIONS)
+class WebExtensionContext;
+// menus.refresh: sends the open context menu's extension items again
+// (B_WEBKIT_CONTEXT_MENU_EXTENSIONS); menus.onHidden when the host closes it.
+void refreshExtensionMenusHaiku(WebExtensionContext&);
+void contextMenuClosedHaiku(WebPageProxy&);
+#endif
+// Main thread only. BWebKitView::PerformSpellingCommand for page's last
+// context menu on a misspelt word.
+void performSpellingCommandHaiku(WebPageProxy&, uint32_t command, const String& word);
+
+} // namespace WebKit
