+class HaikuSampleData final : public ThreadSafeRefCounted<HaikuSampleData> {
+public:
+    static Ref<HaikuSampleData> create(std::vector<uint8_t>&& bytes, std::optional<SummitMP4::CencSample>&& encryption = std::nullopt,
+        std::vector<SummitMP4::Sample>&& preroll = { })
+    { return adoptRef(*new HaikuSampleData(WTF::move(bytes), WTF::move(encryption), WTF::move(preroll))); }
+    const std::vector<uint8_t> bytes;
+    const std::optional<SummitMP4::CencSample> encryption;
+    const std::vector<SummitMP4::Sample> preroll;
+    size_t sizeInBytes() const
+    {
+        size_t size = bytes.size();
+        for (auto& packet : preroll)
+            size += sizeof(packet) + packet.data.size();
+        return size;
+    }
+
+private:
+    explicit HaikuSampleData(std::vector<uint8_t>&& bytes, std::optional<SummitMP4::CencSample>&& encryption, std::vector<SummitMP4::Sample>&& preroll)
+        : bytes(WTF::move(bytes))
+        , encryption(WTF::move(encryption))
+        , preroll(WTF::move(preroll))
+    {
+    }
+};
