+
+void WebView::close()
+{
+    ASSERT(RunLoop::isMain());
+    Ref protectedThis { *this };
+#if ENABLE(WEBUSB)
+    ++m_state->usbGeneration;
+    if (m_page && m_state->context)
+        m_state->context->usb()->cancelPage(m_page->identifier().toUInt64());
+#endif
+#if ENABLE(WEB_BLUETOOTH)
+    ++m_state->bluetoothGeneration;
+    if (m_page && m_state->context)
+        m_state->context->bluetooth()->cancelPage(m_page->identifier().toUInt64());
+#endif
+    m_state->contentSizeChanged = nullptr;
+    m_state->inspectionWorld = nullptr;
+    m_state->dialogs->cancelAll(true);
+    withdrawAuthenticationsHaiku(*m_state);
+    BMessage dismissDialogs(javaScriptDialogsCancelHaiku);
+    sendToView(dismissDialogs);
+    m_state->presenter.close();
+    if (m_presentationCallback)
+        std::exchange(m_presentationCallback, { })();
+    if (m_page) {
+        WKPageSetPageStateClient(toAPI(m_page.get()), nullptr);
+        if (m_state->context)
+            m_state->context->browserTabs()->removePage(m_page->identifier());
+        m_page->close();
+        m_page = nullptr;
+    }
+    m_undoController.clearAllEditCommands();
+}
