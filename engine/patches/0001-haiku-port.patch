+void WebExtensionContext::sessionsQueryHaiku(const String& method, const String& argumentsJSON, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    auto apiName = makeString("sessions."_s, method, "()"_s);
+    static constexpr std::array methods { "getRecentlyClosed"_s, "restore"_s, "forget"_s };
+    auto message = nativeNamespaceQueryHaiku(*this, B_WEBKIT_BROWSER_SESSIONS, "sessions"_s, methods, method, argumentsJSON, apiName, completion);
+    if (!message)
+        return;
+    sendNativeBrowserQueryHaiku(WTF::move(*message), apiName, [this, protectedThis = Ref { *this }, completion = WTF::move(completion)](std::expected<String, WebExtensionError>&& result) mutable {
+        RefPtr value = result ? JSON::Value::parseJSON(*result) : nullptr;
+        if (!value) {
+            completion(WTF::move(result));
+            return;
+        }
+        if (RefPtr sessions = value->asArray()) {
+            for (auto& session : *sessions)
+                filterSessionHaiku(*this, session);
+        } else
+            filterSessionHaiku(*this, *value);
+        completion(value->toJSONString());
+    });
+}
