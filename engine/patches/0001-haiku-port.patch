+    if (!newSheetComesLast && getenv("SUMMIT_EXTENSION_CSS_TRACE")) {
+        WTFLogAlways("Summit extension css: sheet restyles everything: the injected sheets %s (%u user, %u author sheets made, %u for the page)\n",
