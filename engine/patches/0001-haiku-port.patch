+class BlendModeGuard {
+    BView* m_view;
+    source_alpha m_sa;
+    alpha_function m_af;
+public:
+    BlendModeGuard(BView* view): m_view(view) {
+        m_view->GetBlendingMode(&m_sa, &m_af);
+    }
+    
+    ~BlendModeGuard() {
+        m_view->SetBlendingMode(m_sa, m_af);
+    }
+};
