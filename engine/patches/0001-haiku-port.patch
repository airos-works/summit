diff --git a/Source/WebCore/Modules/pdfjs-extras/haiku/content-script.js b/Source/WebCore/Modules/pdfjs-extras/haiku/content-script.js
new file mode 100644
index 0000000000000000000000000000000000000000..fabe8043823d63e494b0b79c93a04927083b1cf1
--- /dev/null
+++ b/Source/WebCore/Modules/pdfjs-extras/haiku/content-script.js
@@ -0,0 +1,81 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+// PDFJSDocument posts its already-authorized response bytes to this frame.
+// No second fetch, no cross-origin proxy and no PDF-provided JavaScript.
+// Native printing renders only the requested pages, independently of the
+// visible viewer and PDF.js's synchronous print-service lifetime.
+(() => {
+    const jobs = new Map();
+    Object.defineProperty(window, 'summitPDFPrint', {value: Object.freeze({
+        async begin(token) {
+            const pdf = PDFViewerApplication.pdfDocument;
+            if (!pdf || !PDFViewerApplication.pdfViewer.printingAllowed || jobs.has(token))
+                throw new Error('This PDF is not ready for printing.');
+            const canvas = document.createElement('canvas');
+            canvas.id = token;
+            canvas.hidden = true;
+            document.body.append(canvas);
+            jobs.set(token, {pdf, canvas, task: null});
+            return pdf.numPages;
+        },
+        async render(token, number, maxWidth, maxHeight) {
+            const job = jobs.get(token);
+            if (!job || job.pdf !== PDFViewerApplication.pdfDocument || job.task)
+                throw new Error('The PDF changed while printing.');
+            const page = await job.pdf.getPage(number);
+            if (jobs.get(token) !== job)
+                throw new Error('Printing was cancelled.');
+            const natural = page.getViewport({scale: 1});
+            const viewport = page.getViewport({scale: Math.min(maxWidth / natural.width, maxHeight / natural.height)});
+            job.canvas.width = Math.max(1, Math.ceil(viewport.width));
+            job.canvas.height = Math.max(1, Math.ceil(viewport.height));
+            const context = job.canvas.getContext('2d', {alpha: false, willReadFrequently: true});
+            if (!context) throw new Error('The PDF print canvas could not be created.');
+            job.task = page.render({canvasContext: context, viewport, intent: 'print', annotationMode: 1});
+            try { await job.task.promise; }
+            finally { job.task = null; }
+            if (jobs.get(token) !== job || job.pdf !== PDFViewerApplication.pdfDocument)
+                throw new Error('The PDF changed while printing.');
+            return true;
+        },
+        release(token) {
+            const job = jobs.get(token);
+            if (!job) return;
+            jobs.delete(token);
+            job.task?.cancel();
+            job.canvas.width = job.canvas.height = 0;
+            job.canvas.remove();
+        }
+    })});
+    PDFViewerApplication.initializedPromise.then(() => {
+        window.print = window.summitNativePDFPrint;
+    });
+})();
+
+window.addEventListener('message', event => {
+    if (event.source !== window || !event.data || event.data.message !== 'open-pdf'
+        || !(event.data.data instanceof ArrayBuffer)) return;
+    const {data, sourceURL, filename} = event.data;
+    PDFViewerApplication.initializedPromise.then(async () => {
+        const showError = message => {
+            let notice = document.getElementById('summit-pdf-error');
+            if (!notice) {
+                notice = document.createElement('section');
+                notice.id = 'summit-pdf-error';
+                notice.setAttribute('role', 'alert');
+                document.getElementById('viewerContainer').append(notice);
+            }
+            notice.textContent = message || 'This PDF could not be opened.';
+        };
+        PDFViewerApplication.eventBus.on('documenterror', event => showError(event.message));
+        PDFViewerApplication.setTitleUsingUrl(sourceURL || 'document.pdf');
+        PDFViewerApplication.eventBus.on('pagesinit', () => {
+            PDFViewerApplication.pdfViewer.currentScaleValue = 'page-width';
+        });
+        try {
+            await PDFViewerApplication.open({data, docBaseUrl: sourceURL, filename: filename || 'document.pdf', isEvalSupported: false});
+        } catch {
+            if (!document.getElementById('summit-pdf-error'))
+                showError('This PDF could not be opened.');
+        }
+    });
+});
