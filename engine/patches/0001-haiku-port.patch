+static JSValueRef rejectedTestPromise(JSContextRef context, JSValueRef reason)
+{
+    return transformWebExtensionPromise(context, nullptr, reason,
+        [](JSContextRef context, bool, JSValueRef, JSValueRef reason, JSValueRef& exception) -> JSValueRef {
+            exception = reason;
+            return JSValueMakeUndefined(context);
+        });
+}
+
+JSValueRef WebExtensionAPITest::addTest(JSContextRef context, JSValueRef testFunction, String callingAPIName)
+{
+    auto reject = [&](const String& message) {
+        auto reason = toJSString(toErrorString(callingAPIName, nullString(), message));
+        return rejectedTestPromise(context, JSValueMakeString(context, reason.get()));
+    };
+    if (!isFunction(context, testFunction))
+        return reject("Error creating a new test."_s);
+
+    JSValueRef exception = nullptr;
+    auto functionObject = JSValueToObject(context, testFunction, &exception);
+    if (exception)
+        return rejectedTestPromise(context, exception);
+    auto rawName = JSObjectGetProperty(context, functionObject, toJSString("name"_s).get(), &exception);
+    if (exception)
+        return rejectedTestPromise(context, exception);
+    Protected<JSValueRef> nameValue(JSContextGetGlobalContext(context), rawName);
+    JSRetainPtr nameString(Adopt, JSValueToStringCopy(context, nameValue.get(), &exception));
+    if (exception)
+        return rejectedTestPromise(context, exception);
+    auto testName = toString(nameString.get());
+    if (testName.isEmpty())
+        return reject("The supplied test function must be named."_s);
+
+    RefPtr page = toWebPage(context);
+    if (!page)
+        return reject("Error creating a new test."_s);
+    RefPtr controller = page->webExtensionControllerProxy();
+    if (!controller)
+        return reject("Error creating a new test."_s);
+
+    JSObjectRef resolve = nullptr;
+    JSObjectRef rejectCallback = nullptr;
+    JSObjectRef result = JSObjectMakeDeferredPromise(context, &resolve, &rejectCallback, &exception);
+    if (exception)
+        return rejectedTestPromise(context, exception);
+    if (!result)
+        return nullptr;
+    auto globalContext = JSContextGetGlobalContext(context);
+    Protected<JSValueRef> protectedResult(globalContext, result);
+    Protected<JSValueRef> protectedResolve(globalContext, resolve);
+    Protected<JSValueRef> protectedReject(globalContext, rejectCallback);
+    auto location = scriptLocation(context);
+    auto identifier = controller->identifier();
+    m_testQueue.append({ testName, location, identifier, Protected(globalContext, testFunction), WTF::move(protectedResolve), WTF::move(protectedReject) });
+    WebProcess::singleton().send(Messages::WebExtensionController::TestAdded(testName, location.first, location.second), identifier);
+
+    if (!m_runningTest) {
+        m_runningTest = true;
+        WorkQueue::mainSingleton().dispatch([this, protectedThis = Ref { *this }] { startNextTest(); });
+    }
+    return result;
+}
+
+void WebExtensionAPITest::startNextTest()
+{
+    if (m_testQueue.isEmpty()) {
+        m_runningTest = false;
+        return;
+    }
+    auto test = m_testQueue.takeFirst();
+    auto context = test.testFunction.context().get();
+    m_hitAssertion = false;
+    m_assertionMessage = nullString();
+    WebProcess::singleton().send(Messages::WebExtensionController::TestStarted(test.testName, test.location.first, test.location.second), test.webExtensionControllerIdentifier);
+
+    JSValueRef exception = nullptr;
+    auto rawValue = callObjectWithArguments<0>(test.testFunction.get(), context, { }, &exception);
+    if (!rawValue && !exception) {
+        WebProcess::singleton().send(Messages::WebExtensionController::TestFinished(test.testName, false, "Test execution context is unavailable."_s, test.location.first, test.location.second), test.webExtensionControllerIdentifier);
+        if (m_testQueue.isEmpty())
+            m_runningTest = false;
+        else
+            WorkQueue::mainSingleton().dispatch([this, protectedThis = Ref { *this }] { startNextTest(); });
+        return;
+    }
+    Protected<JSValueRef> value(context, rawValue ? rawValue : JSValueMakeUndefined(context));
+    Protected<JSValueRef> thrown(context, exception ? exception : JSValueMakeUndefined(context));
+    Protected<JSValueRef> execution(context, exception ? rejectedTestPromise(context, thrown.get()) : value.get());
+    JSValueRef callbacks[] { test.resolveCallback.get(), test.rejectCallback.get() };
+    Protected<JSValueRef> callbackValues(context, JSObjectMakeArray(context, 2, callbacks, nullptr));
+
+    // Trace the running test's completion functions through the promise graph;
+    // only queued tests need the Protected values held by m_testQueue.
+    transformWebExtensionPromise(context, execution.get(), callbackValues.get(),
+        [this, protectedThis = Ref { *this }, testName = test.testName, location = test.location, identifier = test.webExtensionControllerIdentifier]
+        (JSContextRef context, bool fulfilled, JSValueRef value, JSValueRef callbacks, JSValueRef&) -> JSValueRef {
+            bool success = fulfilled && !m_hitAssertion;
+            String message;
+            if (success)
+                message = "Promise resolved without an error."_s;
+            else {
+                String errorMessage;
+                if (!fulfilled) {
+                    JSValueRef exception = nullptr;
+                    Protected<JSValueRef> reason(JSContextGetGlobalContext(context), webExtensionPromiseErrorMessage(context, value, exception));
+                    errorMessage = debugString(context, exception ? exception : reason.get());
+                } else if (!m_assertionMessage.isNull())
+                    errorMessage = m_assertionMessage;
+                message = errorMessage.isNull() ? "Promise rejected without an error"_s : combineMessages("Promise rejected with an error: "_s, errorMessage);
+            }
+            WebProcess::singleton().send(Messages::WebExtensionController::TestFinished(testName, success, message, location.first, location.second), identifier);
+            auto callbackArray = JSValueToObject(context, callbacks, nullptr);
+            auto callback = JSObjectGetPropertyAtIndex(context, callbackArray, success ? 0 : 1, nullptr);
+            if (success)
+                callObjectWithArguments<1>(callback, context, { value });
+            else
+                callObjectWithArguments<0>(callback, context, { });
+            m_hitAssertion = false;
+            m_assertionMessage = nullString();
+            if (m_testQueue.isEmpty())
+                m_runningTest = false;
+            else
+                WorkQueue::mainSingleton().dispatch([this, protectedThis = Ref { *this }] { startNextTest(); });
+            return JSValueMakeUndefined(context);
+        });
+}
+
 JSValueRef WebExtensionAPITest::addTest(JSContextRef context, JSValueRef testFunction)
 {
     return addTest(context, testFunction, "test.addTest()"_s);
diff --git a/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIUserScripts.cpp b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIUserScripts.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..740e403f93a8000eaf8b577ec072952a02b458e2
--- /dev/null
+++ b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPIUserScripts.cpp
@@ -0,0 +1,216 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPIUserScripts.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionRegisteredScriptParameters.h"
+#include "WebExtensionRegisteredScriptParser.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+#include <wtf/text/MakeString.h>
+
+namespace WebKit {
+
+static std::expected<Vector<Ref<JSON::Object>>, String> objects(const JSON::Value* input)
+{
+    // JSON::Value only offers a mutable array view; nothing here modifies it.
+    RefPtr array = input ? const_cast<JSON::Value*>(input)->asArray() : nullptr;
+    if (!array)
+        return makeUnexpected(toErrorString(nullString(), "scripts"_s, "an array of objects is expected"_s));
+    if (array->length() > 1024)
+        return makeUnexpected(toErrorString(nullString(), "scripts"_s, "it names too many scripts"_s));
+    Vector<Ref<JSON::Object>> result;
+    for (auto& item : *array) {
+        RefPtr object = item->asObject();
+        if (!object)
+            return makeUnexpected(toErrorString(nullString(), "scripts"_s, "an array of objects is expected"_s));
+        result.append(object.releaseNonNull());
+    }
+    return result;
+}
+
+// The filter's ids as stored, or nullopt for every user script.
+static std::expected<std::optional<Vector<String>>, String> filterIdentifiers(const JSON::Value* input)
+{
+    if (!input || input->isNull())
+        return std::optional<Vector<String>> { };
+    RefPtr filter = const_cast<JSON::Value*>(input)->asObject();
+    if (!filter)
+        return makeUnexpected(toErrorString(nullString(), "filter"_s, "an object is expected"_s));
+    RefPtr ids = filter->getValue("ids"_s);
+    if (!ids || ids->isNull())
+        return std::optional<Vector<String>> { };
+    RefPtr array = ids->asArray();
+    if (!array)
+        return makeUnexpected(toErrorString(nullString(), "ids"_s, "an array of strings is expected"_s));
+    Vector<String> result;
+    for (auto& item : *array) {
+        if (item->type() != JSON::Value::Type::String)
+            return makeUnexpected(toErrorString(nullString(), "ids"_s, "an array of strings is expected"_s));
+        result.append(makeString(webExtensionUserScriptPrefix, item->asString()));
+    }
+    return std::optional { WTF::move(result) };
+}
+
+static void completeVoid(Ref<WebExtensionCallbackHandler>&& callback, std::expected<void, WebExtensionError>&& result)
+{
+    if (!result) {
+        callback->reportError(result.error());
+        return;
+    }
+    callback->call();
+}
+
+void WebExtensionAPIUserScripts::registerScripts(RefPtr<JSON::Value> scripts, Ref<WebExtensionCallbackHandler>&& callback, String& outExceptionString)
+{
+    auto list = objects(scripts.get());
+    if (!list) {
+        outExceptionString = list.error();
+        return;
+    }
+    auto parameters = parseWebExtensionUserScripts(*list, WebExtensionRegisteredScriptParseMode::Registration, WebExtensionUserScriptIdentifiers::FromAPI);
+    if (!parameters) {
+        outExceptionString = parameters.error();
+        return;
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::ScriptingRegisterContentScripts(WTF::move(*parameters)),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<void, WebExtensionError>&& result) mutable {
+            completeVoid(WTF::move(callback), WTF::move(result));
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPIUserScripts::updateScripts(RefPtr<JSON::Value> scripts, Ref<WebExtensionCallbackHandler>&& callback, String& outExceptionString)
+{
+    auto list = objects(scripts.get());
+    if (!list) {
+        outExceptionString = list.error();
+        return;
+    }
+    auto parameters = parseWebExtensionUserScripts(*list, WebExtensionRegisteredScriptParseMode::Update, WebExtensionUserScriptIdentifiers::FromAPI);
+    if (!parameters) {
+        outExceptionString = parameters.error();
+        return;
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::ScriptingUpdateRegisteredScripts(WTF::move(*parameters)),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<void, WebExtensionError>&& result) mutable {
+            completeVoid(WTF::move(callback), WTF::move(result));
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPIUserScripts::unregisterScripts(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&& callback, String& outExceptionString)
+{
+    auto identifiers = filterIdentifiers(filter.get());
+    if (!identifiers) {
+        outExceptionString = identifiers.error();
+        return;
+    }
+    auto unregister = [protectedThis = Ref { *this }, callback = WTF::move(callback)](Vector<String>&& identifiers) mutable {
+        // An empty list would mean every content script to the browser process.
+        if (identifiers.isEmpty()) {
+            callback->call();
+            return;
+        }
+        auto contextIdentifier = protectedThis->extensionContext().identifier();
+        WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::ScriptingUnregisterContentScripts(WTF::move(identifiers)),
+            [protectedThis = protectedThis.copyRef(), callback = WTF::move(callback)](std::expected<void, WebExtensionError>&& result) mutable {
+                completeVoid(WTF::move(callback), WTF::move(result));
+            }, contextIdentifier);
+    };
+    if (*identifiers) {
+        unregister(WTF::move(**identifiers));
+        return;
+    }
+    // Every user script: find their identifiers first.
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::ScriptingGetRegisteredScripts({ }),
+        [unregister = WTF::move(unregister)](std::expected<Vector<WebExtensionRegisteredScriptParameters>, WebExtensionError>&& result) mutable {
+            Vector<String> identifiers;
+            if (result) {
+                for (auto& parameters : *result) {
+                    if (isWebExtensionUserScriptIdentifier(parameters.identifier))
+                        identifiers.append(parameters.identifier);
+                }
+            }
+            unregister(WTF::move(identifiers));
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPIUserScripts::getScripts(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&& callback, String& outExceptionString)
+{
+    auto identifiers = filterIdentifiers(filter.get());
+    if (!identifiers) {
+        outExceptionString = identifiers.error();
+        return;
+    }
+    // An empty list asks for every registered script.
+    auto requested = identifiers->value_or(Vector<String> { });
+    bool filtered = !!*identifiers;
+    if (filtered && requested.isEmpty()) {
+        Ref empty = JSON::Array::create();
+        auto context = callback->globalContext();
+        Protected<JSValueRef> value(context, fromJSON(context, RefPtr<JSON::Value> { WTF::move(empty) }));
+        callback->call(value.get());
+        return;
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::ScriptingGetRegisteredScripts(WTF::move(requested)),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<Vector<WebExtensionRegisteredScriptParameters>, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            Ref scripts = JSON::Array::create();
+            for (auto& parameters : *result) {
+                if (isWebExtensionUserScriptIdentifier(parameters.identifier))
+                    scripts->pushObject(webExtensionUserScriptJSON(parameters, WebExtensionUserScriptIdentifiers::FromAPI));
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, RefPtr<JSON::Value> { WTF::move(scripts) }));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPIUserScripts::configureWorld(RefPtr<JSON::Value> properties, Ref<WebExtensionCallbackHandler>&& callback, String& outExceptionString)
+{
+    RefPtr object = properties ? properties->asObject() : nullptr;
+    if (!object) {
+        outExceptionString = toErrorString(nullString(), "properties"_s, "an object is expected"_s);
+        return;
+    }
+    for (auto key : { "csp"_s, "worldId"_s }) {
+        if (RefPtr value = object->getValue(key); value && value->type() != JSON::Value::Type::String) {
+            outExceptionString = toErrorString(nullString(), key, "a string is expected"_s);
+            return;
+        }
+    }
+    if (RefPtr value = object->getValue("messaging"_s); value && value->type() != JSON::Value::Type::Boolean) {
+        outExceptionString = toErrorString(nullString(), "messaging"_s, "a boolean is expected"_s);
+        return;
+    }
+    // The default world has no worldId.
+    auto worldId = object->getString("worldId"_s);
+    m_worldConfigurations.set(worldId.isNull() ? emptyString() : worldId, object.releaseNonNull());
+    callback->call();
+}
+
+void WebExtensionAPIUserScripts::resetWorldConfiguration(const String& worldId, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    m_worldConfigurations.remove(worldId.isNull() ? emptyString() : worldId);
+    callback->call();
+}
+
+void WebExtensionAPIUserScripts::getWorldConfigurations(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    Ref configurations = JSON::Array::create();
+    for (auto& configuration : m_worldConfigurations.values())
+        configurations->pushObject(configuration.copyRef());
+    auto context = callback->globalContext();
+    Protected<JSValueRef> value(context, fromJSON(context, RefPtr<JSON::Value> { WTF::move(configurations) }));
+    callback->call(value.get());
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
