+void WebView::sendToView(BMessage& message) const
+{
+    BMessenger view;
+    {
+        std::lock_guard guard(m_state->mutex);
+        view = m_state->view;
+    }
+    view.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+}
