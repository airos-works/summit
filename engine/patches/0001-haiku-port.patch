+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if ENABLE(WEBUSB)
+#include "USBDeviceSessionHaiku.h"
+#include <Messenger.h>
+#include <functional>
+#include <memory>
+#include <wtf/CompletionHandler.h>
+#include <wtf/HashMap.h>
+#include <wtf/JSONValues.h>
+#include <wtf/WorkQueue.h>
+#include <wtf/text/StringHash.h>
+
+namespace WebKit {
+class SitePermissionsHaiku;
+class WebHIDBrokerHaiku;
+
+// The browser process owns all device capabilities. Paths, serial identifiers
+// of unapproved devices and native USB handles never reach the web process.
+// Grants last for this browsing context; private contexts get their own broker.
+class WebUSBBrokerHaiku final : public std::enable_shared_from_this<WebUSBBrokerHaiku> {
+public:
+    using Completion = CompletionHandler<void(String&&, Vector<uint8_t>&&)>;
+    static std::shared_ptr<WebUSBBrokerHaiku> create(std::shared_ptr<SitePermissionsHaiku>);
+    ~WebUSBBrokerHaiku();
+    void request(uint64_t page, const String& owner, const String& origin, const BMessenger&,
+        const String& arguments, Vector<uint8_t>&&, std::function<bool()>&& isCurrent, Completion&&);
+    void cancelPage(uint64_t page);
+    void shutdown();
+private:
+    explicit WebUSBBrokerHaiku(std::shared_ptr<SitePermissionsHaiku>);
+    struct Grant {
+        String origin;
+        USBHaiku::Device device;
+        String owner;
+        uint64_t page { 0 };
+        std::shared_ptr<USBHaiku::Session> session;
+        unsigned pending { 0 };
+        bool closing { false };
+    };
+    void enumerate(uint64_t, const String&, const String&, const BMessenger&, Ref<JSON::Object>&&,
+        std::function<bool()>&&, Completion&&);
+    void closeGrant(Grant&);
+    const std::shared_ptr<SitePermissionsHaiku> m_permissions;
+    const Ref<WorkQueue> m_queue;
+    const std::shared_ptr<WebHIDBrokerHaiku> m_hid;
+    HashMap<String, Grant> m_grants;
+    bool m_shutdown { false };
+    unsigned m_enumerations { 0 };
+};
+}
+#endif
