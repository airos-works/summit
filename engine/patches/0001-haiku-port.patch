@@ -0,0 +1,264 @@
+/* Copyright (C) 2026 air/OS contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "DashPlaybackHaiku.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace SummitDASH {
+Player::Player(Hooks hooks) : m_hooks(std::move(hooks))
+{
+    for (unsigned index = 0; index < m_tracks.size(); ++index) {
+        auto& track = m_tracks[index];
+        track.parser.onProtectionSystemHeaders = [this](std::vector<uint8_t>&& headers) {
+            if (m_hooks.protectionSystemHeaders) m_hooks.protectionSystemHeaders(std::move(headers));
+        };
+        track.parser.onInitSegment = [this, index](SummitMP4::InitSegment&& initialization) {
+            if (m_hooks.protectionSystemHeaders && !initialization.protectionSystemHeaders.empty())
+                m_hooks.protectionSystemHeaders(std::move(initialization.protectionSystemHeaders));
+            auto& track = m_tracks[index];
+            auto kind = index ? SummitMP4::TrackInfo::Kind::Audio : SummitMP4::TrackInfo::Kind::Video;
+            track.configuration.reset();
+            for (auto& info : initialization.tracks) if (info.kind == kind && info.timescale) {
+                track.configuration = std::make_shared<SummitMP4::TrackInfo>(std::move(info)); break;
+            }
+            track.parseFailed = !track.configuration;
+        };
+        track.parser.onSample = [this, index](SummitMP4::Sample&& sample) {
+            auto& track = m_tracks[index];
+            if (!track.configuration || sample.trackID != track.configuration->id) return;
+            if (track.packets.size() >= 200000) { track.parseFailed = true; return; }
+            const auto& rep = *track.representation;
+            track.packets.push_back({track.configuration, std::move(sample), rep.periodStart - rep.presentationTimeOffset});
+        };
+    }
+}
+Player::~Player() { stop(); }
+void Player::start(const std::string& url, double nowUTC, double monotonicTime)
+{
+    stop(); m_manifest.reset(); m_url = url; m_startUTC = nowUTC;
+    m_startMono = m_now = monotonicTime; m_bandwidth = 0; m_position = m_initialTime = 0;
+    m_stopped = false; loadManifest();
+}
+void Player::stop()
+{
+    m_stopped = true;
+    auto requests = std::move(m_requests); m_requests.clear(); m_manifestRequest = 0;
+    for (const auto& [id, request] : requests) m_hooks.cancel(id);
+    for (auto& track : m_tracks) {
+        track.request = 0; track.packets.clear(); track.parser.reset(); track.configuration.reset(); track.representation.reset();
+        track.enabled = track.initialized = track.ended = track.parseFailed = track.haveData = false;
+    }
+}
+void Player::fail(const std::string& message, bool network)
+{
+    if (m_stopped) return;
+    stop(); m_hooks.error(message, network);
+}
+void Player::loadManifest()
+{
+    if (m_stopped || m_manifestRequest) return;
+    const auto id = ++m_identifier; m_manifestRequest = id;
+    m_requests.emplace(id, Request {RequestKind::Manifest, 0, {}, {}});
+    m_hooks.request(id, {m_url, {}}, 4 * 1024 * 1024);
+}
+void Player::resetTracks(double position)
+{
+    for (auto& track : m_tracks) {
+        if (track.request) { auto id = track.request; m_requests.erase(id); track.request = 0; m_hooks.cancel(id); }
+        track.initialized = track.ended = track.parseFailed = track.haveData = false;
+        track.nextTime = track.bufferedStart = track.bufferedEnd = position;
+        if (!isLive() && position >= duration() && duration() > 0)
+            track.nextTime = std::max(0.0, duration() - 0.01);
+        track.representation.reset(); track.configuration.reset(); track.packets.clear(); track.parser.reset();
+    }
+    m_position = position; m_hooks.reset(position); m_hooks.changed();
+}
+void Player::seek(double time)
+{
+    if (!m_manifest || m_stopped || !std::isfinite(time)) return;
+    time = std::clamp(time, seekableStart(), seekableEnd());
+    resetTracks(time); pump();
+}
+void Player::tick(double mediaTime, double monotonicTime)
+{
+    if (m_stopped || !std::isfinite(mediaTime) || !std::isfinite(monotonicTime)) return;
+    m_position = mediaTime; m_now = monotonicTime;
+    if (isLive() && m_now >= m_nextRefresh) loadManifest();
+    pump();
+}
+const Segment* Player::segment(const Representation& rep, double position) const
+{
+    for (const auto& segment : rep.segments) if (segment.start + segment.duration > position + 0.001) return &segment;
+    return nullptr;
+}
+const Representation* Player::select(unsigned track, double position) const
+{
+    if (!m_manifest) return nullptr;
+    for (const auto& period : m_manifest->periods) {
+        if (period.duration && period.start + period.duration <= position + 0.001) continue;
+        const Representation* lowest = nullptr;
+        const Representation* chosen = nullptr;
+        std::string adaptation;
+        const double budget = m_bandwidth * 0.65;
+        for (const auto& rep : period.representations) {
+            if ((track ? !rep.audio : !rep.video) || !m_hooks.supports(rep) || !segment(rep, position)) continue;
+            if (adaptation.empty()) adaptation = rep.adaptationID;
+            if (adaptation != rep.adaptationID) continue;
+            if (!lowest || rep.bandwidth < lowest->bandwidth) lowest = &rep;
+            if (rep.bandwidth <= budget && (!chosen || rep.bandwidth > chosen->bandwidth)) chosen = &rep;
+        }
+        if (lowest) return chosen ? chosen : lowest;
+    }
+    return nullptr;
+}
+void Player::requestTrack(unsigned index, RequestKind kind, const Segment* media)
+{
+    auto& track = m_tracks[index];
+    const auto id = ++m_identifier;
+    Request request {kind, index, track.representation, media ? *media : Segment {}};
+    Resource resource = media ? media->resource : track.representation->initialization;
+    track.request = id; m_requests.emplace(id, std::move(request));
+    m_hooks.request(id, resource, 64 * 1024 * 1024);
+}
+void Player::pump()
+{
+    if (m_stopped || !m_manifest || m_pumping) return;
+    m_pumping = true;
+    for (unsigned index = 0; index < m_tracks.size() && !m_stopped; ++index) {
+        auto& track = m_tracks[index];
+        if (!track.enabled || track.ended) continue;
+        for (unsigned count = 0; count < 64 && !track.packets.empty() && m_hooks.canEnqueue(index); ++count) {
+            auto packet = std::move(track.packets.front()); track.packets.pop_front();
+            m_hooks.enqueue(index, *packet.configuration, std::move(packet.sample), packet.offset);
+        }
+        if (track.request || !track.packets.empty() || track.bufferedEnd - m_position >= 8) continue;
+        auto* desired = select(index, track.nextTime);
+        if (!desired) {
+            if (!isLive()) { track.ended = true; m_hooks.endTrack(index); m_hooks.changed(); }
+            continue;
+        }
+        bool changed = !track.representation || desired->id != track.representation->id
+            || desired->periodStart != track.representation->periodStart
+            || desired->initialization.url != track.representation->initialization.url;
+        if (changed && track.representation && desired->periodStart == track.representation->periodStart) {
+            const auto* next = segment(*desired, track.nextTime);
+            if (next && std::abs(next->start - track.nextTime) > 0.01) {
+                // Quality changes require a shared segment boundary. Keep
+                // the current representation when its timelines differ.
+                desired = track.representation.get(); changed = false;
+            }
+        }
+        if (changed) { track.initialized = false; track.parser.reset(); track.configuration.reset(); }
+        if (changed || track.catalogVersion != m_catalogVersion) {
+            track.representation = std::make_shared<Representation>(*desired);
+            track.catalogVersion = m_catalogVersion;
+        }
+        if (!track.initialized) { requestTrack(index, RequestKind::Initialization); continue; }
+        if (const auto* next = segment(*track.representation, track.nextTime)) requestTrack(index, RequestKind::Media, next);
+    }
+    m_pumping = false;
+}
+void Player::complete(uint64_t identifier, std::vector<uint8_t> data, const std::string& finalURL, double elapsedSeconds)
+{
+    auto found = m_requests.find(identifier); if (found == m_requests.end() || m_stopped) return;
+    auto request = std::move(found->second); m_requests.erase(found);
+    if (request.kind == RequestKind::Manifest) {
+        m_manifestRequest = 0;
+        std::string error;
+        auto manifest = parseManifest({reinterpret_cast<const char*>(data.data()), data.size()}, finalURL,
+            m_startUTC + m_now - m_startMono, error);
+        if (!manifest) { fail(error); return; }
+        // One renderer per kind is retained across periods. Reject changing
+        // track sets explicitly instead of stalling at a disappearing track.
+        std::optional<std::array<bool, 2>> trackSet;
+        for (const auto& period : manifest->periods) {
+            std::array<bool, 2> present {false, false};
+            for (const auto& rep : period.representations) if (m_hooks.supports(rep)) {
+                present[0] = present[0] || rep.video; present[1] = present[1] || rep.audio;
+            }
+            if (trackSet && *trackSet != present) { fail("DASH periods with changing audio/video track sets are not supported"); return; }
+            trackSet = present;
+        }
+        bool first = !m_manifest; m_manifest = std::move(manifest); m_url = finalURL; ++m_catalogVersion;
+        m_nextRefresh = m_now + m_manifest->updatePeriod;
+        if (first) {
+            m_initialTime = isLive() ? std::max(seekableStart(), seekableEnd() - 6) : seekableStart();
+            m_tracks[0].enabled = select(0, m_initialTime); m_tracks[1].enabled = select(1, m_initialTime);
+            if (!hasVideo() && !hasAudio()) { fail("The DASH presentation has no playable audio or video"); return; }
+            resetTracks(m_initialTime);
+        }
+        m_hooks.changed(); pump(); return;
+    }
+    auto& track = m_tracks[request.track]; track.request = 0;
+    if (data.empty() || data.size() > 64 * 1024 * 1024) { fail("DASH segment size is invalid"); return; }
+    if (!track.parser.append(data.data(), data.size()) || track.parseFailed) { fail("DASH MP4 segment could not be parsed"); return; }
+    if (request.kind == RequestKind::Initialization) {
+        if (!track.configuration) { fail("DASH initialization segment has no playable track"); return; }
+        track.initialized = true;
+    } else {
+        if (track.packets.empty()) { fail("DASH media segment has no samples"); return; }
+        if (std::isfinite(elapsedSeconds) && elapsedSeconds > 0) {
+            double bandwidth = data.size() * 8.0 / std::max(elapsedSeconds, 0.005);
+            // A sudden slowdown must take effect immediately; averaging a
+            // fast local/CDN burst for several segments causes long stalls.
+            // Increase conservatively after capacity improves again.
+            m_bandwidth = !m_bandwidth || bandwidth < m_bandwidth ? bandwidth : m_bandwidth * 0.75 + bandwidth * 0.25;
+        }
+        track.nextTime = request.segment.start + request.segment.duration;
+        track.bufferedEnd = track.nextTime;
+        track.haveData = true;
+        m_hooks.changed();
+    }
+    pump();
+}
+void Player::failed(uint64_t identifier)
+{
+    if (!m_requests.contains(identifier)) return;
+    fail("Could not load a DASH resource", true);
+}
+bool Player::hasEnded() const
+{
+    return !m_stopped && m_manifest && !isLive() && (!hasVideo() || m_tracks[0].ended) && (!hasAudio() || m_tracks[1].ended);
+}
+bool Player::hasCurrentData() const
+{
+    if (m_stopped || (!hasVideo() && !hasAudio())) return false;
+    for (const auto& track : m_tracks)
+        if (track.enabled && (!track.haveData || track.bufferedEnd + 0.001 < m_position)) return false;
+    return true;
+}
+double Player::duration() const { return !m_manifest ? 0 : isLive() ? std::numeric_limits<double>::infinity() : m_manifest->duration; }
+double Player::seekableStart() const
+{
+    if (!m_manifest) return 0;
+    std::array<double, 2> starts {std::numeric_limits<double>::infinity(), std::numeric_limits<double>::infinity()};
+    for (const auto& period : m_manifest->periods) for (const auto& rep : period.representations)
+        if (m_hooks.supports(rep) && !rep.segments.empty()) {
+            auto& start = starts[rep.audio ? 1 : 0]; start = std::min(start, rep.segments.front().start);
+        }
+    double result = 0;
+    for (double start : starts) if (std::isfinite(start)) result = std::max(result, start);
+    return result;
+}
+double Player::seekableEnd() const
+{
+    if (!m_manifest) return 0;
+    if (!isLive()) return m_manifest->duration;
+    std::array<double, 2> ends {0, 0};
+    for (const auto& period : m_manifest->periods) for (const auto& rep : period.representations)
+        if (m_hooks.supports(rep) && !rep.segments.empty()) {
+            auto& end = ends[rep.audio ? 1 : 0]; end = std::max(end, rep.segments.back().start + rep.segments.back().duration);
+        }
+    return ends[0] && ends[1] ? std::min(ends[0], ends[1]) : std::max(ends[0], ends[1]);
+}
+double Player::bufferedStart() const
+{
+    return std::max(seekableStart(), m_position);
+}
+double Player::bufferedEnd() const
+{
+    double result = duration();
+    for (const auto& track : m_tracks) if (track.enabled) result = std::min(result, track.bufferedEnd);
+    return result;
+}
+}
diff --git a/Source/WebCore/platform/graphics/haiku/DashPlaybackHaiku.h b/Source/WebCore/platform/graphics/haiku/DashPlaybackHaiku.h
