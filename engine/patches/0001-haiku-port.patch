+MediaSampleHaiku::MediaSampleHaiku(Ref<HaikuSampleData>&& data, Ref<HaikuTrackConfiguration>&& configuration, TrackID trackID,
+    const MediaTime& presentationTime, const MediaTime& decodeTime, const MediaTime& duration, SampleFlags flags, const MediaTime& trimStart, const MediaTime& trimEnd)
+    : m_data(WTF::move(data))
