+// When the network was last seen to go away (0 while it is there), in
+// MonotonicTime seconds. The network process's curl thread reads it to give
+// up on transfers that have been quiet since then (CurlRequest.cpp): Haiku's
+// TCP sends no keepalives, so a connection whose network went away never
+// fails by itself.
+std::atomic<double> networkLostAtHaiku { 0 };
+
+// SUMMIT_NETWORK_IGNORE_INTERFACES_FILE: a file naming interfaces (as
+// ifconfig shows them, separated by commas or lines) to leave out, as if
+// they were not there, read at every check. For testing on a machine
+// reached over its only network: name its interfaces in the file, then make
+// the stack announce a change (ifconfig loop metric 0).
+static Vector<String> ignoredInterfaces()
+{
+    static const char* path = std::getenv("SUMMIT_NETWORK_IGNORE_INTERFACES_FILE");
+    FILE* file = path ? std::fopen(path, "r") : nullptr;
+    if (!file)
+        return { };
+    char text[1024];
+    size_t length = std::fread(text, 1, sizeof(text) - 1, file);
+    std::fclose(file);
+    for (size_t i = 0; i < length; ++i) {
+        if (text[i] == '\n' || text[i] == '\r')
+            text[i] = ',';
+    }
+    Vector<String> names;
+    for (auto name : StringView(std::span { reinterpret_cast<const Latin1Character*>(text), length }).split(',')) {
+        name = name.trim(isASCIIWhitespace<char16_t>);
+        if (!name.isEmpty())
+            names.append(name.toString());
+    }
+    return names;
+}
+
+// An address the interface only has without a network: none, or the
+// self-assigned IPv4 (169.254/16) and IPv6 link-local ones.
+static bool isUsableAddress(const sockaddr& address)
+{
+    if (address.sa_family == AF_INET) {
+        auto value = ntohl(reinterpret_cast<const sockaddr_in&>(address).sin_addr.s_addr);
+        return value != INADDR_ANY && (value >> 16) != 0xa9fe && (value >> 24) != 127;
+    }
+    if (address.sa_family == AF_INET6) {
+        auto& value = reinterpret_cast<const sockaddr_in6&>(address).sin6_addr;
+        return !IN6_IS_ADDR_UNSPECIFIED(&value) && !IN6_IS_ADDR_LOOPBACK(&value) && !IN6_IS_ADDR_LINKLOCAL(&value);
+    }
+    return false;
+}
+
+// Online: an interface other than loopback is up, has a link (IFF_LINK: a
+// cable, or a joined wireless network) and an address.
+static bool isOnLineHaiku()
+{
+    struct ifaddrs* interfaces = nullptr;
+    if (getifaddrs(&interfaces) || !interfaces)
+        return true; // Unknown: do not stop pages that might work.
+    auto ignored = ignoredInterfaces();
+    bool online = false;
+    for (auto* entry = interfaces; entry && !online; entry = entry->ifa_next) {
+        if (!entry->ifa_addr || !entry->ifa_name || (entry->ifa_flags & IFF_LOOPBACK)
+            || (entry->ifa_flags & (IFF_UP | IFF_LINK)) != (IFF_UP | IFF_LINK))
+            continue;
+        if (isUsableAddress(*entry->ifa_addr) && !ignored.contains(String::fromLatin1(entry->ifa_name)))
+            online = true;
+    }
+    freeifaddrs(interfaces);
+    return online;
+}
+
+void NetworkStateNotifier::updateStateWithoutNotifying()
+{
+    bool wasOnLine = m_isOnLine.value_or(true);
+    m_isOnLine = isOnLineHaiku();
+    if (wasOnLine && !*m_isOnLine)
+        networkLostAtHaiku = MonotonicTime::now().secondsSinceEpoch().seconds();
+    else if (*m_isOnLine)
+        networkLostAtHaiku = 0;
+    if (wasOnLine != *m_isOnLine)
+        std::fprintf(stderr, "Summit: the network is %s\n", *m_isOnLine ? "back" : "gone");
+}
+
+// The network stack's notifications (start_watching_network) arrive at this
+// looper. libbnetapi has the function; the engine does not link it, so it is
+// looked up when the first page asks.
+class NetworkWatcherHaiku final : public BLooper {
+public:
+    explicit NetworkWatcherHaiku(Function<void()>&& changed)
+        : BLooper("network state", B_LOW_PRIORITY)
+        , m_changed(WTF::move(changed))
+    {
+    }
+
+    void MessageReceived(BMessage* message) final
+    {
+        if (message->what == B_NETWORK_MONITOR) {
+            m_changed();
+            return;
+        }
+        BLooper::MessageReceived(message);
+    }
+
+private:
+    Function<void()> m_changed;
+};
+
+void NetworkStateNotifier::startObserving()
+{
+    // Interfaces come and go in bursts (link, then an address from DHCP);
+    // updateStateSoon() reads them once things have settled.
+    auto* watcher = new NetworkWatcherHaiku([] {
+        callOnMainThread([] {
+            singleton().updateStateSoon();
+        });
+    });
+    watcher->Run();
+
+    using StartWatching = status_t (*)(uint32, const BMessenger&);
+    StartWatching startWatching = nullptr;
+    if (void* library = dlopen("libbnetapi.so", RTLD_LAZY | RTLD_LOCAL))
+        startWatching = reinterpret_cast<StartWatching>(dlsym(library, "_Z22start_watching_networkjRK10BMessenger"));
+    status_t status = startWatching
+        ? startWatching(B_WATCH_NETWORK_INTERFACE_CHANGES | B_WATCH_NETWORK_LINK_CHANGES | B_WATCH_NETWORK_WLAN_CHANGES, BMessenger(watcher))
+        : B_NOT_SUPPORTED;
+    if (status == B_OK)
+        return;
+
+    // Without notifications, look every five seconds.
+    std::fprintf(stderr, "Summit: cannot watch the network (%s); checking it every 5 s\n", std::strerror(status));
+    watcher->PostMessage(B_QUIT_REQUESTED);
+    auto* timer = new RunLoop::Timer(Ref { RunLoop::mainSingleton() }, "NetworkStateNotifier poll"_s, [] {
+        singleton().updateState();
+    });
+    timer->startRepeating(5_s);
+}
+
+} // namespace WebCore
