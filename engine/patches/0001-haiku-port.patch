+// Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause
+#include "config.h"
+#include "JPEGXRImageDecoder.h"
+#if USE(JPEGXR)
+#include "JPEGXRCodec.h"
+#include "ImageBackingStore.h"
+#if USE(LCMS)
+#include "LCMSUniquePtr.h"
+#endif
+namespace WebCore {
+ScalableImageDecoderFrame* JPEGXRImageDecoder::frameBufferAtIndex(size_t index)
+{
+    assertIsHeld(m_lock);
+    if (index || failed()) return nullptr;
+    if (m_frameBufferCache.isEmpty()) m_frameBufferCache.grow(1);
+    auto& frame = m_frameBufferCache.first();
+    if (!frame.isComplete()) decode(false, isAllDataReceived());
+    return failed() ? nullptr : &frame;
+}
+void JPEGXRImageDecoder::decode(bool onlySize, bool allDataReceived)
+{
+    assertIsHeld(m_lock);
+    if (failed() || !allDataReceived || !m_data) return;
+    auto image = decodeJPEGXR(m_data->span(), onlySize);
+    if (!image) { setFailed(); return; }
+    IntSize decodedSize(image->width, image->height);
+    if (!isSizeAvailable() && !setSize(decodedSize)) return;
+    if (size() != decodedSize) { setFailed(); return; }
+    if (onlySize) return;
+    auto& frame = m_frameBufferCache.first();
+    if (!frame.initialize(size(), m_premultiplyAlpha)) { setFailed(); return; }
+#if USE(LCMS)
+    if (!m_ignoreGammaAndColorProfile && !image->colorProfile.empty()) {
+        LCMSProfilePtr input(cmsOpenProfileFromMem(image->colorProfile.data(), image->colorProfile.size()));
+        LCMSProfilePtr output(cmsCreate_sRGBProfile());
+        if (input && output && cmsGetColorSpace(input.get()) == cmsSigRgbData) {
+            LCMSTransformPtr transform(cmsCreateTransform(input.get(), TYPE_RGBA_8, output.get(), TYPE_RGBA_8,
+                INTENT_PERCEPTUAL, cmsFLAGS_COPY_ALPHA));
+            if (transform) cmsDoTransform(transform.get(), image->pixels.data(), image->pixels.data(), image->width * image->height);
+        }
+    }
+#endif
+    for (unsigned y = 0; y < image->height; ++y)
+        for (unsigned x = 0; x < image->width; ++x) {
+            auto* pixel = image->pixels.data() + (static_cast<size_t>(y) * image->width + x) * 4;
+            frame.backingStore()->setPixel(x, y, pixel[0], pixel[1], pixel[2], pixel[3]);
+        }
+    frame.setHasAlpha(image->hasAlpha);
+    frame.setDecodingStatus(DecodingStatus::Complete);
+}
+}
+#endif
