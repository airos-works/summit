diff --git a/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPISessions.cpp b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPISessions.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0eb11063cbe0aad367dc047443eeea69e31f91b1
--- /dev/null
+++ b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPISessions.cpp
@@ -0,0 +1,197 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPISessions.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionAPINamespace.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionEventListenerType.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+
+namespace WebKit {
+
+// SessionsValueHaiku's operations.
+enum : uint8_t { SessionValueGet, SessionValueSet, SessionValueRemove };
+
+static bool validSessionIdentifier(const String& id, String& exception)
+{
+    if (id.isEmpty() || !id.containsOnly<isASCIIDigit>() || id.length() > 18) {
+        exception = toErrorString(nullString(), "sessionId"_s, "it is not a session identifier"_s);
+        return false;
+    }
+    return true;
+}
+
+void WebExtensionAPISessions::getRecentlyClosed(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    Ref arguments = JSON::Object::create();
+    double maxResults = maxSessionResults();
+    if (filter) {
+        RefPtr object = filter->asObject();
+        if (!object) {
+            exception = toErrorString(nullString(), "filter"_s, "an object is expected"_s);
+            return;
+        }
+        if (RefPtr value = object->getValue("maxResults"_s)) {
+            auto number = value->asDouble();
+            if (!number || *number < 0 || *number > maxSessionResults() || *number != std::floor(*number)) {
+                exception = toErrorString(nullString(), "maxResults"_s, "it must be an integer from 0 to 25"_s);
+                return;
+            }
+            maxResults = *number;
+        }
+    }
+    arguments->setDouble("maxResults"_s, maxResults);
+    query("getRecentlyClosed"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPISessions::restore(const String& sessionId, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    // No identifier: the most recently closed.
+    Ref arguments = JSON::Object::create();
+    if (!sessionId.isNull()) {
+        if (!validSessionIdentifier(sessionId, exception))
+            return;
+        arguments->setString("sessionId"_s, sessionId);
+    }
+    query("restore"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPISessions::getDevices(RefPtr<JSON::Value>, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    // Summit does not sync with other devices.
+    auto context = callback->globalContext();
+    Protected<JSValueRef> value(context, fromJSON(context, JSON::Array::create()));
+    callback->call(value.get());
+}
+
+void WebExtensionAPISessions::forgetClosedTab(double windowId, const String& sessionId, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!isValid(toWebExtensionWindowIdentifier(windowId))) {
+        exception = toErrorString(nullString(), "windowId"_s, "it is not a window identifier"_s);
+        return;
+    }
+    if (!validSessionIdentifier(sessionId, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("sessionId"_s, sessionId);
+    arguments->setBoolean("window"_s, false);
+    query("forget"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPISessions::forgetClosedWindow(const String& sessionId, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    if (!validSessionIdentifier(sessionId, exception))
+        return;
+    Ref arguments = JSON::Object::create();
+    arguments->setString("sessionId"_s, sessionId);
+    arguments->setBoolean("window"_s, true);
+    query("forget"_s, WTF::move(arguments), WTF::move(callback));
+}
+
+void WebExtensionAPISessions::setTabValue(double tabId, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueSet, false, tabId, key, valueJSON.isEmpty() ? "null"_s : valueJSON, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::getTabValue(double tabId, const String& key, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueGet, false, tabId, key, nullString(), WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::removeTabValue(double tabId, const String& key, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueRemove, false, tabId, key, nullString(), WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::setWindowValue(double windowId, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueSet, true, windowId, key, valueJSON.isEmpty() ? "null"_s : valueJSON, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::getWindowValue(double windowId, const String& key, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueGet, true, windowId, key, nullString(), WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::removeWindowValue(double windowId, const String& key, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    value(SessionValueRemove, true, windowId, key, nullString(), WTF::move(callback), exception);
+}
+
+void WebExtensionAPISessions::value(uint8_t operation, bool window, double identifier, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    std::optional<WebExtensionTabIdentifier> tab;
+    std::optional<WebExtensionWindowIdentifier> windowIdentifier;
+    if (window) {
+        windowIdentifier = toWebExtensionWindowIdentifier(identifier);
+        if (!isValid(windowIdentifier)) {
+            exception = toErrorString(nullString(), "windowId"_s, "it is not a window identifier"_s);
+            return;
+        }
+    } else {
+        tab = toWebExtensionTabIdentifier(identifier);
+        if (!isValid(tab)) {
+            exception = toErrorString(nullString(), "tabId"_s, "it is not a tab identifier"_s);
+            return;
+        }
+    }
+    if (key.isEmpty() || key.length() > 1024) {
+        exception = toErrorString(nullString(), "key"_s, "it must be a non-empty string"_s);
+        return;
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::SessionsValueHaiku(operation, tab, windowIdentifier, key, valueJSON),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isNull()) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPISessions::query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::SessionsQueryHaiku(method, arguments->toJSONString()),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isEmpty() || *result == "null"_s) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+WebExtensionAPIEvent& WebExtensionAPISessions::onChanged()
+{
+    if (!m_onChanged)
+        m_onChanged = WebExtensionAPIEvent::create(*this, WebExtensionEventListenerType::SessionsOnChanged);
+    return *m_onChanged;
+}
+
+void WebExtensionContextProxy::dispatchSessionsChangedEventHaiku()
+{
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        namespaceObject.sessions().onChanged().invokeListeners();
+    });
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
diff --git a/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPISessions.h b/Source/WebKit/WebProcess/Extensions/API/WebExtensionAPISessions.h
