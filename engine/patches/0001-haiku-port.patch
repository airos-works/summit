+void WebExtensionContext::tabsDiscardHaiku(std::optional<WebExtensionTabIdentifier> tabIdentifier, CompletionHandler<void(std::expected<std::optional<WebExtensionTabParameters>, WebExtensionError>&&)>&& completionHandler)
+{
+    // The browser unloads the page into a new, unloaded view, so the tab's
+    // identifier changes, as in Chrome.
+    static constexpr auto apiName = "tabs.discard()"_s;
+    BMessage message(B_WEBKIT_BROWSER_COMMAND);
+    bool complete = message.AddUInt32("command", B_WEBKIT_BROWSER_DISCARD_TAB) == B_OK;
+    if (tabIdentifier) {
+        RefPtr tab = getTab(*tabIdentifier);
+        if (!tab || !tab->extensionHasAccess()) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "tab not found"_s));
+            return;
+        }
+        complete = complete && addNativeBrowserCommandTab(message, *tab);
+        if (RefPtr window = complete ? tab->window() : nullptr)
+            complete = addNativeBrowserCommandWindow(message, *window);
+    }
+    if (!complete) {
+        completionHandler(toWebExtensionError(apiName, nullString(), "the tab is not available in the browser"_s));
+        return;
+    }
+    sendNativeBrowserCommand(WTF::move(message), apiName, [this, protectedThis = Ref { *this }, completionHandler = WTF::move(completionHandler)](NativeBrowserCommandResult&& result) mutable {
+        if (!result) {
+            completionHandler(makeUnexpected(result.error()));
+            return;
+        }
+        RefPtr tab = result->isEmpty() ? nullptr : getOrCreateNativeTab(result->first());
+        if (!tab) {
+            completionHandler(toWebExtensionError(apiName, nullString(), "the browser did not report the unloaded tab"_s));
+            return;
+        }
+        completionHandler(tab->extensionHasAccess() ? std::optional(tab->parameters()) : std::nullopt);
+    });
+}
