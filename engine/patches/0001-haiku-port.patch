@@ -0,0 +1,50 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "JSWebExtensionAPISessions.h"
+#include "WebExtensionAPIEvent.h"
+#include "WebExtensionAPIObject.h"
+#include <wtf/JSONValues.h>
+
+namespace WebKit {
+
+// chrome.sessions. Recently closed tabs and windows are the browser's: each
+// call becomes a SessionsQueryHaiku message, forwarded as a SESSIONS browser
+// command. Firefox's tab and window values live in the UI process
+// (SessionsValueHaiku) while Summit runs.
+class WebExtensionAPISessions : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPISessions, sessions, sessions);
+
+public:
+    // Chrome's limit, which is also the most Summit keeps.
+    double maxSessionResults() const { return 25; }
+
+    void getRecentlyClosed(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void restore(const String& sessionId, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getDevices(RefPtr<JSON::Value> filter, Ref<WebExtensionCallbackHandler>&&);
+    void forgetClosedTab(double windowId, const String& sessionId, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void forgetClosedWindow(const String& sessionId, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+
+    void setTabValue(double tabId, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getTabValue(double tabId, const String& key, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void removeTabValue(double tabId, const String& key, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void setWindowValue(double windowId, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void getWindowValue(double windowId, const String& key, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+    void removeWindowValue(double windowId, const String& key, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+
+    WebExtensionAPIEvent& onChanged();
+
+private:
+    void query(const String& method, Ref<JSON::Object>&& arguments, Ref<WebExtensionCallbackHandler>&&);
+    void value(uint8_t operation, bool window, double identifier, const String& key, const String& valueJSON, Ref<WebExtensionCallbackHandler>&&, String& outExceptionString);
+
+    RefPtr<WebExtensionAPIEvent> m_onChanged;
+};
+
+} // namespace WebKit
+
+SPECIALIZE_TYPE_TRAITS_WEB_EXTENSION(WebExtensionAPISessions, sessions);
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
