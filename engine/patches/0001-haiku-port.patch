+// Pages that ask for the screen to stay on: a video with sound playing where
+// it can be seen, or a screen wake lock. The web process sends the requests
+// to the page's proxy (WebSleepDisablerClient), whose own SleepDisabler
+// brings them here. The view's state then says "keepScreenAwake", and the
+// browser keeps the screen on while it shows the page: this process has no
+// way to do it for every embedder, and only the browser knows what is seen.
+class ScreenAwakeRequestsHaiku final : public SleepDisablerClient {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(ScreenAwakeRequestsHaiku);
+public:
+    static ScreenAwakeRequestsHaiku& singleton()
+    {
+        ASSERT(RunLoop::isMain());
+        static ScreenAwakeRequestsHaiku* requests;
+        if (!requests) {
+            auto client = makeUnique<ScreenAwakeRequestsHaiku>();
+            requests = client.get();
+            sleepDisablerClient() = WTF::move(client);
+        }
+        return *requests;
+    }
+
+    bool keepsScreenAwake(const WebPageProxy& page) const
+    {
+        for (auto& requester : m_requests.values()) {
+            if (requester.get() == &page)
+                return true;
+        }
+        return false;
+    }
+
+    void didCreateSleepDisabler(SleepDisablerIdentifier identifier, const String&, bool display, std::optional<PageIdentifier> pageID) final
+    {
+        // Display requests only: a hidden page's video asks for the system
+        // to stay awake, which Haiku does anyway.
+        RefPtr page = display && pageID ? WebProcessProxy::webPage(*pageID) : nullptr;
+        if (!page)
+            return;
+        bool wasAwake = keepsScreenAwake(*page);
+        m_requests.set(identifier, WeakPtr { *page });
+        if (!wasAwake)
+            notify(WeakPtr { *page });
+    }
+
+    void didDestroySleepDisabler(SleepDisablerIdentifier identifier, std::optional<PageIdentifier>) final
+    {
+        // Also called while a closing page lets go of its requests: the
+        // page is looked at only later.
+        if (WeakPtr page = m_requests.take(identifier))
+            notify(WTF::move(page));
+    }
+
+    // A new document in the main frame starts without requests. Those of
+    // the one before end with it, but not always here: after a process
+    // swap the old page's messages go to its suspended page, which drops
+    // them, and the screen would be kept on for good.
+    void forgetPage(WebPageProxy& page)
+    {
+        if (m_requests.removeIf([&](auto& entry) { return entry.value.get() == &page; }))
+            notify(WeakPtr { page });
+    }
+
+private:
+    static void notify(WeakPtr<WebPageProxy>&& page)
+    {
+        RunLoop::mainSingleton().dispatch([page = WTF::move(page)] {
+            if (RefPtr protectedPage = page.get(); protectedPage && protectedPage->pageClient())
+                static_cast<WebView*>(protectedPage->pageClient())->notifyState();
+        });
+    }
+
+    HashMap<SleepDisablerIdentifier, WeakPtr<WebPageProxy>> m_requests;
+};
