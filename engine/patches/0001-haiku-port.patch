+// PCM chunks as AudioData in the nearest sample format: 24-bit as 32-bit,
+// A-law and mu-law expanded to 16-bit.
+class PCMAudioDecoderHaiku final : public AudioDecoder {
+public:
+    static RefPtr<PCMAudioDecoderHaiku> create(PCMCodec codec, const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+    {
+        if (!config.sampleRate || !config.numberOfChannels || config.numberOfChannels > 32)
+            return nullptr;
+        return adoptRef(*new PCMAudioDecoderHaiku(codec, config, WTF::move(outputCallback)));
+    }
+
+private:
+    PCMAudioDecoderHaiku(PCMCodec codec, const AudioDecoder::Config& config, OutputCallback&& outputCallback)
+        : m_codec(codec)
+        , m_sampleRate(config.sampleRate)
+        , m_channels(config.numberOfChannels)
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs PCM decoder"_s))
+    {
+    }
+
+    Ref<DecodePromise> decode(AudioEncodedData&& chunk) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, chunk = WTF::move(chunk).isolatedCopy()] mutable {
+            return protectedThis->decodeOnQueue(WTF::move(chunk));
+        });
+    }
+
+    Ref<DecodePromise> decodeOnQueue(AudioEncodedData&& chunk)
+    {
+        if (m_isClosed)
+            return DecodePromise::createAndReject("The decoder is closed"_s);
+        auto data = chunk.data->span();
+        size_t frameSize = pcmSampleSize(m_codec) * m_channels;
+        if (data.size() % frameSize)
+            return DecodePromise::createAndReject("The chunk does not hold whole frames"_s);
+        size_t frames = data.size() / frameSize;
+        size_t samples = frames * m_channels;
+        if (!frames)
+            return DecodePromise::createAndResolve();
+        Vector<uint8_t> bytes;
+        AudioSampleFormat format;
+        switch (m_codec) {
+        case PCMCodec::U8: format = AudioSampleFormat::U8; bytes = data; break;
+        case PCMCodec::S16: format = AudioSampleFormat::S16; bytes = data; break;
+        case PCMCodec::S32: format = AudioSampleFormat::S32; bytes = data; break;
+        case PCMCodec::F32: format = AudioSampleFormat::F32; bytes = data; break;
+        case PCMCodec::S24:
+            format = AudioSampleFormat::S32;
+            bytes.grow(samples * 4);
+            for (size_t i = 0; i < samples; ++i) {
+                int32_t value = static_cast<int32_t>((data[i * 3] << 8) | (data[i * 3 + 1] << 16) | (static_cast<uint32_t>(data[i * 3 + 2]) << 24));
+                memcpy(bytes.mutableSpan().data() + i * 4, &value, 4);
+            }
+            break;
+        case PCMCodec::ALaw:
+        case PCMCodec::MuLaw:
+            format = AudioSampleFormat::S16;
+            bytes.grow(samples * 2);
+            for (size_t i = 0; i < samples; ++i) {
+                int16_t value = m_codec == PCMCodec::ALaw ? aLawToLinear(data[i]) : muLawToLinear(data[i]);
+                memcpy(bytes.mutableSpan().data() + i * 2, &value, 2);
+            }
+            break;
+        }
+        m_outputCallback(DecodedData { PlatformRawAudioDataHaiku::create(SharedBuffer::create(WTF::move(bytes)), format, m_sampleRate, chunk.timestamp, frames, m_channels) });
+        return DecodePromise::createAndResolve();
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [] { return GenericPromise::createAndResolve(); });
+    }
+
+    void reset() final { }
+    void close() final { m_isClosed = true; }
+
+    const PCMCodec m_codec;
+    const unsigned m_sampleRate;
+    const unsigned m_channels;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    std::atomic<bool> m_isClosed { false };
+};
+
+// AudioData as PCM chunks, one a frame of input.
+class PCMAudioEncoderHaiku final : public AudioEncoder {
+public:
+    static RefPtr<PCMAudioEncoderHaiku> create(PCMCodec codec, const String& codecName, const AudioEncoder::Config& config, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+    {
+        if (!config.sampleRate || !config.numberOfChannels || config.numberOfChannels > 32)
+            return nullptr;
+        return adoptRef(*new PCMAudioEncoderHaiku(codec, codecName, config, WTF::move(descriptionCallback), WTF::move(outputCallback)));
+    }
+
+private:
+    PCMAudioEncoderHaiku(PCMCodec codec, const String& codecName, const AudioEncoder::Config& config, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+        : m_codec(codec)
+        , m_codecName(codecName.isolatedCopy())
+        , m_config(config)
+        , m_descriptionCallback(WTF::move(descriptionCallback))
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs PCM encoder"_s))
+    {
+    }
+
+    Ref<EncodePromise> encode(RawFrame&& frame) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, frame = WTF::move(frame)] mutable {
+            return protectedThis->encodeOnQueue(WTF::move(frame));
+        });
+    }
+
+    Ref<EncodePromise> encodeOnQueue(RawFrame&& frame)
+    {
+        if (m_isClosed)
+            return EncodePromise::createAndReject("The encoder is closed"_s);
+        RefPtr audio = frame.frame;
+        if (!audio || audio->numberOfChannels() != m_config.numberOfChannels || audio->sampleRate() != m_config.sampleRate)
+            return EncodePromise::createAndReject("The audio does not match the encoder's channels and sample rate"_s);
+        size_t frames = audio->numberOfFrames();
+        size_t samples = frames * m_config.numberOfChannels;
+        Vector<uint8_t> data;
+        auto copy = [&](AudioSampleFormat format, size_t size) {
+            data.grow(samples * size);
+            audio->copyTo(data.mutableSpan(), format, 0, 0, frames, samples);
+        };
+        switch (m_codec) {
+        case PCMCodec::U8: copy(AudioSampleFormat::U8, 1); break;
+        case PCMCodec::S16: copy(AudioSampleFormat::S16, 2); break;
+        case PCMCodec::S32: copy(AudioSampleFormat::S32, 4); break;
+        case PCMCodec::F32: copy(AudioSampleFormat::F32, 4); break;
+        case PCMCodec::S24: {
+            Vector<int32_t> wide(samples);
+            audio->copyTo(asMutableByteSpan(wide.mutableSpan()), AudioSampleFormat::S32, 0, 0, frames, samples);
+            data.grow(samples * 3);
+            for (size_t i = 0; i < samples; ++i) {
+                uint32_t value = static_cast<uint32_t>(wide[i]);
+                data[i * 3] = value >> 8;
+                data[i * 3 + 1] = value >> 16;
+                data[i * 3 + 2] = value >> 24;
+            }
+            break;
+        }
+        case PCMCodec::ALaw:
+        case PCMCodec::MuLaw: {
+            Vector<int16_t> linear(samples);
+            audio->copyTo(asMutableByteSpan(linear.mutableSpan()), AudioSampleFormat::S16, 0, 0, frames, samples);
+            data.grow(samples);
+            for (size_t i = 0; i < samples; ++i)
+                data[i] = m_codec == PCMCodec::ALaw ? linearToALaw(linear[i]) : linearToMuLaw(linear[i]);
+            break;
+        }
+        }
+        if (!m_hasDescribed) {
+            m_hasDescribed = true;
+            ActiveConfiguration configuration;
+            configuration.codec = m_codecName;
+            configuration.sampleRate = m_config.sampleRate;
+            configuration.numberOfChannels = m_config.numberOfChannels;
+            m_descriptionCallback(WTF::move(configuration));
+        }
+        uint64_t duration = frames * 1000000 / m_config.sampleRate;
+        m_outputCallback({ WTF::move(data), true, frame.timestamp, duration });
+        return EncodePromise::createAndResolve();
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [] { return GenericPromise::createAndResolve(); });
+    }
+
+    void reset() final { }
+    void close() final { m_isClosed = true; }
+
+    const PCMCodec m_codec;
+    const String m_codecName;
+    const AudioEncoder::Config m_config;
+    DescriptionCallback m_descriptionCallback;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    bool m_hasDescribed { false };
+    std::atomic<bool> m_isClosed { false };
+};
+
+class FFmpegAudioEncoderHaiku final : public AudioEncoder {
+public:
+    static RefPtr<FFmpegAudioEncoderHaiku> create(const String& codec, const AudioEncoder::Config& config, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+    {
+        auto* name = ffmpegEncoderName(codec);
+        auto* ffmpeg = name ? FFmpegAudio::load() : nullptr;
+        if (!ffmpeg || !ffmpeg->canEncode || !config.sampleRate || !config.numberOfChannels || config.numberOfChannels > 8)
+            return nullptr;
+        bool isAAC = isAACCodec(codec);
+        // Their descriptions come from the encoder's extradata.
+        if (needsExtradata(codec) && !ffmpeg->contextExtradataOffset)
+            return nullptr;
+        // ADTS headers can name only the table's rates and up to 7 channels.
+        if (isAAC && config.isAacADTS.value_or(false) && (aacFrequencyIndex(config.sampleRate) == 15 || config.numberOfChannels > 7))
+            return nullptr;
+        // HE-AAC v2 (parametric stereo) is stereo only.
+        if (codec == "mp4a.40.29"_s && config.numberOfChannels != 2)
+            return nullptr;
+        RefPtr encoder = adoptRef(*new FFmpegAudioEncoderHaiku(*ffmpeg, name, codec, isAAC, config, WTF::move(descriptionCallback), WTF::move(outputCallback)));
+        if (!encoder->openContext())
+            return nullptr;
+        return encoder;
+    }
+
+    ~FFmpegAudioEncoderHaiku()
+    {
+        m_ffmpeg.freeFrame(&m_frame);
+        m_ffmpeg.freePacket(&m_packet);
+        m_ffmpeg.freeContext(&m_context);
+    }
+
+private:
+    FFmpegAudioEncoderHaiku(const FFmpegAudio& ffmpeg, const char* name, const String& codec, bool isAAC, const AudioEncoder::Config& config, DescriptionCallback&& descriptionCallback, OutputCallback&& outputCallback)
+        : m_ffmpeg(ffmpeg)
+        , m_name(name)
+        , m_codec(codec == "mp4a.40.02"_s ? "mp4a.40.2"_s : codec == "mp4a.40.05"_s ? "mp4a.40.5"_s : codec.isolatedCopy())
+        , m_isAAC(isAAC)
+        , m_isFLAC(codec == "flac"_s)
+        , m_isFDK(!strcmp(name, "libfdk_aac"))
+        , m_isADTS(isAAC && config.isAacADTS.value_or(false))
+        , m_config(config)
+        , m_packet(ffmpeg.allocPacket())
+        , m_frame(ffmpeg.allocFrame())
+        , m_descriptionCallback(WTF::move(descriptionCallback))
+        , m_outputCallback(WTF::move(outputCallback))
+        , m_queue(WorkQueue::create("WebCodecs FFmpeg audio encoder"_s))
+    {
+    }
+
+    // A context for the configuration: planar float samples (FLAC: 16-bit
+    // interleaved, the only kind it takes besides 32-bit), the default
+    // channel layout for the channel count.
+    bool openContext()
+    {
+        m_ffmpeg.freeContext(&m_context);
+        auto* encoder = m_ffmpeg.findEncoderByName(m_name);
+        if (!encoder || !m_packet || !m_frame || !(m_context = m_ffmpeg.allocContext(encoder)))
+            return false;
+        alignas(8) std::array<uint8_t, 64> layout { };
+        m_ffmpeg.defaultChannelLayout(layout.data(), m_config.numberOfChannels);
+        int sampleFormat = isPackedS16() ? sampleS16 : sampleFloatPlanar;
+        memcpy(static_cast<uint8_t*>(m_context) + m_ffmpeg.contextSampleFormatOffset, &sampleFormat, sizeof(sampleFormat));
+        bool configured = m_ffmpeg.setOptionInt(m_context, "ar", m_config.sampleRate, 0) >= 0
+            && m_ffmpeg.setOptionChannelLayout(m_context, "ch_layout", layout.data(), 0) >= 0
+            && (!m_config.bitRate || m_isFLAC || m_ffmpeg.setOptionInt(m_context, "b", m_config.bitRate, 0) >= 0)
+            && (!m_isFLAC || !m_config.flacConfig || m_ffmpeg.setOptionInt(m_context, "compression_level", std::min<size_t>(m_config.flacConfig->compressLevel, 12), 0) >= 0)
+            // FDK: the HE profile (FF_PROFILE_AAC_HE, _HE_V2); raw frames with
+            // the AudioSpecificConfig as extradata, or its own ADTS frames.
+            && (!m_isFDK || m_ffmpeg.setOptionInt(m_context, "profile", m_codec == "mp4a.40.29"_s ? 28 : 4, 0) >= 0)
+            && (!m_isFDK || m_isADTS || m_ffmpeg.setOption(m_context, "flags", "+global_header", 0) >= 0);
+        m_ffmpeg.uninitChannelLayout(layout.data());
+        int64_t frameSize = 0;
+        if (!configured || m_ffmpeg.open(m_context, encoder, nullptr) < 0
+            || m_ffmpeg.getOptionInt(m_context, "frame_size", 0, &frameSize) < 0 || frameSize <= 0 || frameSize > 65536) {
+            m_ffmpeg.freeContext(&m_context);
+            return false;
+        }
+        m_frameSize = frameSize;
+        m_samplesSent = 0;
+        return true;
+    }
+
+    Ref<EncodePromise> encode(RawFrame&& frame) final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }, frame = WTF::move(frame)] mutable {
+            return protectedThis->encodeOnQueue(WTF::move(frame));
+        });
+    }
+
+    Ref<EncodePromise> encodeOnQueue(RawFrame&& frame)
+    {
+        if (m_isClosed)
+            return EncodePromise::createAndReject("The encoder is closed"_s);
+        if (!m_context && !openContext())
+            return EncodePromise::createAndReject("The encoder could not be started again"_s);
+        RefPtr audio = frame.frame;
+        if (!audio || audio->numberOfChannels() != m_config.numberOfChannels || audio->sampleRate() != m_config.sampleRate)
+            return EncodePromise::createAndReject("The audio does not match the encoder's channels and sample rate"_s);
+        size_t frames = audio->numberOfFrames();
+        size_t channels = m_config.numberOfChannels;
+        if (!m_hasTimestamp) {
+            m_hasTimestamp = true;
+            m_firstTimestamp = frame.timestamp;
+        }
+        size_t start = m_pending.size();
+        m_pending.grow(start + frames * channels);
+        audio->copyTo(asMutableByteSpan(m_pending.mutableSpan().subspan(start)), AudioSampleFormat::F32, 0, 0, frames, frames * channels);
+        while (m_pending.size() >= m_frameSize * channels) {
+            if (auto error = sendFrame(m_frameSize))
+                return EncodePromise::createAndReject(WTF::move(*error));
+        }
+        return EncodePromise::createAndResolve();
+    }
+
+    // The first samples waiting, as one frame (shorter only when finishing).
+    std::optional<String> sendFrame(size_t samples)
+    {
+        size_t channels = m_config.numberOfChannels;
+        auto* frame = static_cast<AVFramePrefix*>(m_frame);
+        auto* bytes = static_cast<uint8_t*>(m_frame);
+        m_ffmpeg.unrefFrame(m_frame);
+        frame->sampleCount = samples;
+        frame->format = isPackedS16() ? sampleS16 : sampleFloatPlanar;
+        m_ffmpeg.defaultChannelLayout(bytes + m_ffmpeg.frameChannelLayoutOffset, channels);
+        int sampleRate = m_config.sampleRate;
+        memcpy(bytes + m_ffmpeg.frameSampleRateOffset, &sampleRate, sizeof(sampleRate));
+        if (m_ffmpeg.frameGetBuffer(m_frame, 0) < 0)
+            return "Out of memory"_s;
+        if (isPackedS16()) {
+            auto* packed = reinterpret_cast<int16_t*>(frame->data[0]);
+            for (size_t i = 0; i < samples * channels; ++i)
+                packed[i] = static_cast<int16_t>(std::lround(std::clamp(m_pending[i], -1.0f, 1.0f) * 32767));
+        } else {
+            for (size_t channel = 0; channel < channels; ++channel) {
+                auto* plane = reinterpret_cast<float*>(frame->data[channel]);
+                for (size_t i = 0; i < samples; ++i)
+                    plane[i] = m_pending[i * channels + channel];
+            }
+        }
+        // pts, in samples (the encoder's time base): the same offset in FFmpeg 6 and 8.
+        int64_t pts = m_samplesSent;
+        memcpy(bytes + 136, &pts, sizeof(pts));
+        int result = m_ffmpeg.sendFrame(m_context, m_frame);
+        m_ffmpeg.unrefFrame(m_frame);
+        if (result < 0)
+            return makeString("Audio encoding failed with error "_s, result);
+        m_samplesSent += samples;
+        m_pending.removeAt(0, std::min(m_pending.size(), samples * channels));
+        receivePackets();
+        return std::nullopt;
+    }
+
+    void receivePackets()
+    {
+        while (m_ffmpeg.receivePacket(m_context, m_packet) >= 0) {
+            auto* packet = static_cast<AVPacketPrefix*>(m_packet);
+            Vector<uint8_t> data(std::span<const uint8_t> { packet->data, static_cast<size_t>(std::max(packet->size, 0)) });
+            int64_t pts = std::max<int64_t>(packet->pts, 0);
+            m_ffmpeg.unrefPacket(m_packet);
+            if (data.isEmpty())
+                continue;
+            describeIfNeeded();
+            if (m_isADTS && !m_isFDK) {
+                ADTSFields fields { 1, aacFrequencyIndex(m_config.sampleRate), static_cast<unsigned>(m_config.numberOfChannels) };
+                data = adtsFrame(fields, data.span());
+            }
+            int64_t timestamp = m_firstTimestamp + pts * 1000000 / static_cast<int64_t>(m_config.sampleRate);
+            uint64_t duration = m_frameSize * 1000000 / m_config.sampleRate;
+            m_outputCallback({ WTF::move(data), true, timestamp, duration });
+        }
+    }
+
+    void describeIfNeeded()
+    {
+        if (m_hasDescribed)
+            return;
+        m_hasDescribed = true;
+        ActiveConfiguration configuration;
+        configuration.codec = m_codec;
+        configuration.sampleRate = m_config.sampleRate;
+        configuration.numberOfChannels = m_config.numberOfChannels;
+        if (m_config.bitRate)
+            configuration.bitrate = m_config.bitRate;
+        if (m_isAAC && !m_isADTS && !m_isFDK)
+            configuration.description = aacAudioSpecificConfig(m_config.sampleRate, m_config.numberOfChannels);
+        else if (m_ffmpeg.contextExtradataOffset && m_context && (!m_isAAC || (m_isFDK && !m_isADTS))) {
+            // The encoder's headers: Vorbis's are already Xiph-laced, FLAC's
+            // is the STREAMINFO block, which the description gives as a
+            // native FLAC stream's start ("fLaC", the last block's header).
+            uint8_t* extradata = nullptr;
+            int size = 0;
+            auto* bytes = static_cast<uint8_t*>(m_context);
+            memcpy(&extradata, bytes + m_ffmpeg.contextExtradataOffset, sizeof(extradata));
+            memcpy(&size, bytes + m_ffmpeg.contextExtradataOffset + sizeof(extradata), sizeof(size));
+            if (extradata && size > 0) {
+                std::span<const uint8_t> headers { extradata, static_cast<size_t>(size) };
+                if (m_isFLAC && size == 34)
+                    configuration.description = Vector<uint8_t> { 'f', 'L', 'a', 'C', 0x80, 0, 0, 34 };
+                if (!m_isFLAC || size == 34) {
+                    configuration.description = configuration.description.value_or(Vector<uint8_t> { });
+                    configuration.description->append(headers);
+                }
+            }
+        }
+        m_descriptionCallback(WTF::move(configuration));
+    }
+
+    Ref<GenericPromise> flush() final
+    {
+        return invokeAsync(m_queue.get(), [protectedThis = Ref { *this }] {
+            // The rest as a short last frame, then the encoder drained: it
+            // takes no more frames, so the next encode starts a new context.
+            auto& encoder = protectedThis.get();
+            if (encoder.m_context && !encoder.m_isClosed) {
+                size_t channels = encoder.m_config.numberOfChannels;
+                if (!encoder.m_pending.isEmpty())
+                    encoder.sendFrame(encoder.m_pending.size() / channels);
+                encoder.m_ffmpeg.sendFrame(encoder.m_context, nullptr);
+                encoder.receivePackets();
+                encoder.m_ffmpeg.freeContext(&encoder.m_context);
+            }
+            encoder.m_pending.clear();
+            encoder.m_hasTimestamp = false;
+            return GenericPromise::createAndResolve();
+        });
+    }
+
+    void reset() final
+    {
+        m_queue->dispatch([protectedThis = Ref { *this }] {
+            protectedThis->m_pending.clear();
+            protectedThis->m_hasTimestamp = false;
+            protectedThis->m_ffmpeg.freeContext(&protectedThis->m_context);
+        });
+    }
+
+    void close() final { m_isClosed = true; }
+
+    const FFmpegAudio& m_ffmpeg;
+    const char* const m_name;
+    const String m_codec;
+    // FLAC's and FDK's samples are 16-bit interleaved.
+    bool isPackedS16() const { return m_isFLAC || m_isFDK; }
+
+    const bool m_isAAC;
+    const bool m_isFLAC;
+    const bool m_isFDK;
+    const bool m_isADTS;
+    const AudioEncoder::Config m_config;
+    void* m_context { nullptr };
+    void* m_packet;
+    void* m_frame;
+    size_t m_frameSize { 0 };
+    int64_t m_samplesSent { 0 };
+    DescriptionCallback m_descriptionCallback;
+    OutputCallback m_outputCallback;
+    const Ref<WorkQueue> m_queue;
+    Vector<float> m_pending;
+    int64_t m_firstTimestamp { 0 };
+    bool m_hasTimestamp { false };
+    bool m_hasDescribed { false };
+    std::atomic<bool> m_isClosed { false };
+};
+
+} // namespace
+
+Ref<AudioDecoder::CreatePromise> createWebCodecsAudioDecoderHaiku(const String& codec, const AudioDecoder::Config& config, AudioDecoder::OutputCallback&& outputCallback)
+{
+    RefPtr<AudioDecoder> decoder;
+    if (codec == "opus"_s)
+        decoder = OpusAudioDecoderHaiku::create(config, WTF::move(outputCallback));
+    else if (auto pcm = pcmCodec(codec))
+        decoder = PCMAudioDecoderHaiku::create(*pcm, config, WTF::move(outputCallback));
+    else
+        decoder = FFmpegAudioDecoderHaiku::create(codec, config, WTF::move(outputCallback));
+    if (!decoder)
+        return AudioDecoder::CreatePromise::createAndReject("Not supported"_s);
+    return AudioDecoder::CreatePromise::createAndResolve(decoder.releaseNonNull());
+}
+
+Ref<AudioEncoder::CreatePromise> createWebCodecsAudioEncoderHaiku(const String& codec, const AudioEncoder::Config& config, AudioEncoder::DescriptionCallback&& descriptionCallback, AudioEncoder::OutputCallback&& outputCallback)
+{
+    RefPtr<AudioEncoder> encoder;
+    if (codec == "opus"_s)
+        encoder = OpusAudioEncoderHaiku::create(config, WTF::move(descriptionCallback), WTF::move(outputCallback));
+    else if (auto pcm = pcmCodec(codec))
+        encoder = PCMAudioEncoderHaiku::create(*pcm, codec, config, WTF::move(descriptionCallback), WTF::move(outputCallback));
+    else
+        encoder = FFmpegAudioEncoderHaiku::create(codec, config, WTF::move(descriptionCallback), WTF::move(outputCallback));
+    if (!encoder)
+        return AudioEncoder::CreatePromise::createAndReject("Not supported"_s);
+    return AudioEncoder::CreatePromise::createAndResolve(encoder.releaseNonNull());
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_CODECS) && PLATFORM(HAIKU) && USE(LIBWEBRTC)
