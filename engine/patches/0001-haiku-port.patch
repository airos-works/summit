+class WebExtensionAPIDownloads final : public WebExtensionAPIObject, public JSWebExtensionWrappable {
+    WEB_EXTENSION_DECLARE_JS_WRAPPER_CLASS(WebExtensionAPIDownloads, downloads, downloads);
+public:
