new file mode 100644
index 0000000000000000000000000000000000000000..8e3d8270ebb7c0f2a475a1e3f9f85c1ef1ebd858
--- /dev/null
+++ b/Source/WebKit/UIProcess/Extensions/haiku/WebExtensionDeclarativeNetRequestURLFilter.cpp
@@ -0,0 +1,372 @@
+/*
+ * Copyright (C) 2026 KunanyiOS contributors.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include "config.h"
+#include "WebExtensionDeclarativeNetRequestURLFilter.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && ENABLE(CONTENT_EXTENSIONS)
+
+#include <WebCore/CombinedURLFilters.h>
+#include <WebCore/URLFilterParser.h>
+#include <functional>
+#include <wtf/ASCIICType.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringBuilder.h>
+#include <wtf/text/StringToIntegerConversion.h>
+
+namespace WebKit {
+
+// WebCore's filter compiler has no alternation and no counted repetition,
+// but a filter may have several patterns (a union). Rewrites a regexFilter
+// into patterns it accepts, matching the same URLs:
+// - each '|' becomes whole patterns: "^a(?:$|\?)" gives "^a$" and "^a\?".
+//   Capturing groups stay; non-capturing ones are inlined, since "(?:$)" is
+//   rejected as a misplaced end of line;
+// - "x{m,n}" becomes m copies of x and n - m of "x?" ("x{m,}": then "x*").
+// Gives up (nullopt) on alternatives inside a quantified group, which are not
+// a union of whole patterns, on repetitions above 32, and past maximumCount
+// patterns. Group numbers may change; only the patterns use the result.
+static std::optional<Vector<String>> rewriteRegexForContentRules(StringView expression, size_t maximumCount)
+{
+    constexpr unsigned maximumRepetition = 32;
+    size_t position = 0;
+    // A counted quantifier at position: {m}, {m,} or {m,n} (nullopt: none).
+    // Anything else, such as a lone '{', is a literal, as in JavaScript.
+    auto countedQuantifier = [&]() -> std::optional<std::pair<unsigned, std::optional<unsigned>>> {
+        if (position >= expression.length() || expression[position] != '{')
+            return std::nullopt;
+        size_t end = expression.find('}', position);
+        if (end == notFound)
+            return std::nullopt;
+        auto body = expression.substring(position + 1, end - position - 1);
+        size_t comma = body.find(',');
+        auto minimum = parseInteger<unsigned>(comma == notFound ? body : body.left(comma));
+        if (!minimum)
+            return std::nullopt;
+        std::optional<unsigned> maximum = *minimum;
+        if (comma != notFound) {
+            auto rest = body.substring(comma + 1);
+            if (rest.isEmpty())
+                maximum = std::nullopt;
+            else if (!(maximum = parseInteger<unsigned>(rest)) || *maximum < *minimum)
+                return std::nullopt;
+        }
+        position = end + 1;
+        if (position < expression.length() && expression[position] == '?')
+            ++position; // lazy: the same URLs match
+        return std::pair { *minimum, maximum };
+    };
+    auto repeat = [&](StringView atom, unsigned minimum, std::optional<unsigned> maximum) -> std::optional<String> {
+        if (minimum > maximumRepetition || (maximum && *maximum > maximumRepetition))
+            return std::nullopt;
+        StringBuilder builder;
+        for (unsigned i = 0; i < minimum; ++i)
+            builder.append(atom);
+        if (!maximum)
+            builder.append(atom, '*');
+        else {
+            for (unsigned i = minimum; i < *maximum; ++i)
+                builder.append(atom, '?');
+        }
+        return builder.toString();
+    };
+
+    std::function<std::optional<Vector<String>>(bool)> alternatives;
+    // One alternative: concatenated items up to '|' or ')' (not consumed).
+    auto sequence = [&](bool inGroup) -> std::optional<Vector<String>> {
+        Vector<String> results { emptyString() };
+        while (position < expression.length()) {
+            auto character = expression[position];
+            if (character == '|' || (character == ')' && inGroup))
+                break;
+            if (character == '(') {
+                // A group: "(", "(?:" or an assertion/named group kept as written.
+                size_t prefixLength = 1;
+                if (expression.substring(position).startsWith("(?:"_s))
+                    prefixLength = 3;
+                else if (expression.substring(position).startsWith("(?"_s))
+                    prefixLength = 2;
+                auto prefix = expression.substring(position, prefixLength);
+                position += prefixLength;
+                auto inner = alternatives(true);
+                if (!inner || position >= expression.length() || expression[position] != ')')
+                    return std::nullopt;
+                ++position;
+                auto counted = countedQuantifier();
+                size_t quantifierStart = position;
+                if (!counted && position < expression.length() && (expression[position] == '*' || expression[position] == '+' || expression[position] == '?')) {
+                    ++position;
+                    if (position < expression.length() && expression[position] == '?')
+                        ++position; // lazy
+                }
+                auto quantifier = expression.substring(quantifierStart, position - quantifierStart);
+                bool quantified = counted || !quantifier.isEmpty();
+                if (inner->size() > 1 && (quantified || prefixLength == 2))
+                    return std::nullopt;
+                Vector<String> combined;
+                for (auto& result : results) {
+                    for (auto& option : *inner) {
+                        if (prefixLength == 3 && !quantified)
+                            combined.append(makeString(result, option));
+                        else if (counted) {
+                            auto repeated = repeat(makeString(prefix, option, ')'), counted->first, counted->second);
+                            if (!repeated)
+                                return std::nullopt;
+                            combined.append(makeString(result, *repeated));
+                        } else
+                            combined.append(makeString(result, prefix, option, ')', quantifier));
+                        if (combined.size() > maximumCount)
+                            return std::nullopt;
+                    }
+                }
+                results = WTF::move(combined);
+                continue;
+            }
+            // A single atom: an escape, a character class or a character.
+            size_t atomStart = position;
+            if (character == '\\')
+                position = std::min<size_t>(position + 2, expression.length());
+            else if (character == '[') {
+                size_t end = position + 1;
+                if (end < expression.length() && expression[end] == '^')
+                    ++end;
+                if (end < expression.length() && expression[end] == ']')
+                    ++end;
+                while (end < expression.length() && expression[end] != ']')
+                    end += expression[end] == '\\' ? 2 : 1;
+                position = std::min<size_t>(end + 1, expression.length());
+            } else
+                ++position;
+            auto atom = expression.substring(atomStart, position - atomStart);
+            String text = atom.toString();
+            // Assertions take no quantifier; a '{' after them stays literal.
+            if (character != '^' && character != '$') {
+                if (auto counted = countedQuantifier()) {
+                    auto repeated = repeat(atom, counted->first, counted->second);
+                    if (!repeated)
+                        return std::nullopt;
+                    text = WTF::move(*repeated);
+                }
+            }
+            for (auto& result : results)
+                result = makeString(result, text);
+        }
+        return results;
+    };
+    alternatives = [&](bool inGroup) -> std::optional<Vector<String>> {
+        Vector<String> results;
+        while (true) {
+            auto options = sequence(inGroup);
+            if (!options)
+                return std::nullopt;
+            results.appendVector(WTF::move(*options));
+            if (results.size() > maximumCount)
+                return std::nullopt;
+            if (position >= expression.length() || expression[position] != '|')
+                return results;
+            ++position;
+        }
+    };
+    auto results = alternatives(false);
+    if (!results || position != expression.length())
+        return std::nullopt;
+    return results;
+}
+
+std::expected<WebExtensionDeclarativeNetRequestURLFilter, String> WebExtensionDeclarativeNetRequestURLFilter::parse(const JSON::Object& condition, WebExtensionDeclarativeNetRequestURLFilterLimits limits)
+{
+    WebExtensionDeclarativeNetRequestURLFilter result;
+    if (auto sensitive = condition.getValue("isUrlFilterCaseSensitive"_s)) {
+        auto boolean = sensitive->asBoolean();
+        if (!boolean)
+            return makeUnexpected("isUrlFilterCaseSensitive must be a boolean."_s);
+        result.caseSensitive = *boolean;
+    }
+
+    auto urlFilter = condition.getValue("urlFilter"_s);
+    auto regexFilter = condition.getValue("regexFilter"_s);
+    if (urlFilter && regexFilter)
+        return makeUnexpected("Only one of urlFilter and regexFilter may be specified."_s);
+
+    String input;
+    if (urlFilter || regexFilter) {
+        input = (urlFilter ? urlFilter : regexFilter)->asString();
+        if (input.isEmpty())
+            return makeUnexpected("URL filters must be non-empty strings."_s);
+        if (input.length() > limits.maximumInputLength)
+            return makeUnexpected("URL filter exceeds the native input limit."_s);
+        for (auto character : StringView(input).codeUnits()) {
+            if (!isASCII(character) || !character)
+                return makeUnexpected("URL filters must contain ASCII characters without NUL."_s);
+        }
+    }
+
+    size_t outputLength = 0;
+    auto append = [&](String pattern) -> bool {
+        if (result.patterns.size() >= limits.maximumPatternCount || pattern.length() > limits.maximumOutputLength - outputLength)
+            return false;
+        outputLength += pattern.length();
+        result.patterns.append(WTF::move(pattern));
+        return true;
+    };
+    constexpr auto limitError = "URL filter exceeds the native translation limit."_s;
+
+    if (!urlFilter || regexFilter) {
+        result.regularExpression = !!regexFilter;
+        if (regexFilter) {
+            // URLFilterParser uses Yarr's legacy mode with backreferences
+            // disabled. It otherwise accepts \1 as octal and \k as literal k,
+            // silently changing expressions supplied by an extension.
+            for (size_t index = 0; index < input.length(); ++index) {
+                if (input[index] != '\\' || index + 1 == input.length())
+                    continue;
+                auto escaped = input[++index];
+                if (isASCIIDigit(escaped) || escaped == 'k' || escaped == 'g')
+                    return makeUnexpected("Backreferences and numeric escapes are not supported in regexFilter."_s);
+                if (isASCIIAlpha(escaped) && !StringView("fnrtvdDsSwWbBx"_s).contains(escaped))
+                    return makeUnexpected("Unsupported escape in regexFilter."_s);
+                if (escaped == 'x') {
+                    if (index + 2 >= input.length() || !isASCIIHexDigit(input[index + 1]) || !isASCIIHexDigit(input[index + 2]))
+                        return makeUnexpected("Hex escapes in regexFilter require two hexadecimal digits."_s);
+                    if (input[index + 1] == '0' && input[index + 2] == '0')
+                        return makeUnexpected("NUL escapes are not supported in regexFilter."_s);
+                    index += 2;
+                }
+            }
+        }
+        if (regexFilter && (StringView(input).contains('|') || StringView(input).contains('{'))) {
+            auto expanded = rewriteRegexForContentRules(input, limits.maximumPatternCount);
+            if (!expanded)
+                return makeUnexpected("regexFilter supports alternatives ('|') only outside quantified groups, and repetition counts up to 32."_s);
+            for (auto& pattern : *expanded) {
+                if (!append(WTF::move(pattern)))
+                    return makeUnexpected(limitError);
+            }
+        } else if (!append(regexFilter ? WTF::move(input) : String(".*"_s)))
+            return makeUnexpected(limitError);
+    } else {
+        if (input.startsWith("||*"_s))
+            return makeUnexpected("A urlFilter must not begin with ||*."_s);
+
+        StringView body(input);
+        bool domainAnchor = body.startsWith("||"_s);
+        bool startAnchor = !domainAnchor && body.startsWith('|');
+        if (domainAnchor)
+            body = body.substring(2);
+        else if (startAnchor)
+            body = body.substring(1);
+        bool endAnchor = body.endsWith('|');
+        if (endAnchor)
+            body = body.substring(0, body.length() - 1);
+
+        // A separator can consume no character only if the rest of the pattern
+        // can also finish at end-of-URL. Only '*' and '^' permit that. Emitting
+        // these suffix cases avoids unsupported disjunctions/lookarounds.
+        size_t nullableSuffix = body.length();
+        while (nullableSuffix && (body[nullableSuffix - 1] == '*' || body[nullableSuffix - 1] == '^'))
+            --nullableSuffix;
+
+        auto appendLiteral = [](StringBuilder& builder, char16_t character) {
+            if (StringView("?+[(){}$|\\."_s).contains(character))
+                builder.append('\\');
+            builder.append(character);
+        };
+        auto translateSuffix = [&](const String& prefix, size_t start) -> bool {
+            StringBuilder expression;
+            expression.append(prefix);
+            bool previousWasWildcard = false;
+            for (size_t index = start; index < body.length(); ++index) {
+                auto character = body[index];
+                if (character == '^') {
+                    if (index >= nullableSuffix && !append(makeString(expression.toString(), '$')))
+                        return false;
+                    expression.append("[^a-zA-Z0-9_.%\\-]"_s);
+                } else if (character == '*') {
+                    if (!previousWasWildcard)
+                        expression.append(".*"_s);
+                } else
+                    appendLiteral(expression, character);
+                previousWasWildcard = character == '*';
+                if (expression.length() > limits.maximumOutputLength - outputLength)
+                    return false;
+            }
+            if (endAnchor)
+                expression.append('$');
+            if (expression.isEmpty())
+                expression.append(".*"_s);
+            return append(expression.toString());
+        };
+
+        if (!domainAnchor) {
+            if (!translateSuffix(startAnchor ? String("^"_s) : emptyString(), 0))
+                return makeUnexpected(limitError);
+        } else {
+            // The start must be in the host, not in credentials. Merely making
+            // userinfo optional is insufficient: a regex can choose the branch
+            // without userinfo and match a credential prefix. Until the first
+            // '/', '?' or '#', prohibit '@' in both the pattern and the rest of
+            // the authority. Enumerate the points where a wildcard/separator
+            // could cross that boundary, then translate the suffix normally.
+            StringBuilder authority;
+            authority.append("^[a-zA-Z][a-zA-Z0-9+.-]*://([^/?#@]*@)?([^/?#@:.]+\\.)*"_s);
+            bool finished = false;
+            bool previousWasWildcard = false;
+            for (size_t index = 0; index < body.length(); ++index) {
+                auto character = body[index];
+                if (character == '/' || character == '?' || character == '#') {
+                    appendLiteral(authority, character);
+                    if (!translateSuffix(authority.toString(), index + 1))
+                        return makeUnexpected(limitError);
+                    finished = true;
+                    break;
+                }
+                if (character == '@') {
+                    // Earlier wildcard branches may still match '@' in a path.
+                    finished = true;
+                    break;
+                }
+                if (character == '*') {
+                    if (!previousWasWildcard) {
+                        if (!translateSuffix(makeString(authority.toString(), "[^/?#@]*[/?#].*"_s), index + 1))
+                            return makeUnexpected(limitError);
+                        authority.append("[^/?#@]*"_s);
+                    }
+                } else if (character == '^') {
+                    if (index >= nullableSuffix && !append(makeString(authority.toString(), '$')))
+                        return makeUnexpected(limitError);
+                    if (!translateSuffix(makeString(authority.toString(), "[/?#]"_s), index + 1))
+                        return makeUnexpected(limitError);
+                    authority.append("[^a-zA-Z0-9_.%\\-@/?#]"_s);
+                } else
+                    appendLiteral(authority, character);
+                previousWasWildcard = character == '*';
+                if (authority.length() > limits.maximumOutputLength - outputLength)
+                    return makeUnexpected(limitError);
+            }
+            if (!finished) {
+                authority.append(endAnchor ? "$"_s : "[^/?#@]*([/?#].*)?$"_s);
+                if (!append(authority.toString()))
+                    return makeUnexpected(limitError);
+            }
+        }
+    }
+
+    // Use the same parser as content-rule compilation. A valid JavaScript/RE2
+    // expression need not belong to WebCore's supported regular-expression
+    // subset. Failure must not turn a restricted rule into a match-all rule.
+    using namespace WebCore::ContentExtensions;
+    for (auto& pattern : result.patterns) {
+        CombinedURLFilters filters;
+        URLFilterParser parser(filters);
+        auto status = parser.addPattern(pattern, result.caseSensitive, 1);
+        if (status != URLFilterParser::Ok && status != URLFilterParser::MatchesEverything)
+            return makeUnexpected(makeString("Unsupported content-rule URL filter: "_s, URLFilterParser::statusString(status)));
+    }
+    return result;
+}
+
+} // namespace WebKit
+
+#endif
