+void WebView::notifyWebAuthnUnhandled(bool create)
+{
+    BMessage message(B_WEBKIT_WEBAUTHN_UNHANDLED);
+    message.AddMessenger("view", nativeView());
+    message.AddBool("create", create);
+    m_state->target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+}
+
+#if ENABLE(FULLSCREEN_API)
+void WebView::requestFullScreen(bool enter, CompletionHandler<void(bool)>&& completion)
+{
+    if (m_fullScreenCompletion || (enter && (!geometry().visible || !geometry().active)))
+        return completion(false);
+    m_fullScreenRequested = enter;
+    m_fullScreenCompletion = WTF::move(completion);
+    auto request = ++m_fullScreenRequest;
+    BMessage message(B_WEBKIT_FULLSCREEN_REQUESTED);
+    message.AddMessenger("view", nativeView());
+    message.AddBool("fullscreen", enter);
+    message.AddUInt64("request", request);
+    if (m_state->target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0) != B_OK) {
+        finishFullScreenRequest(request, false);
+        return;
+    }
+    RunLoop::mainSingleton().dispatchAfter(5_s, [weakThis = WeakPtr { *this }, request] {
+        if (weakThis)
+            weakThis->finishFullScreenRequest(request, false);
+    });
+}
+
+void WebView::finishFullScreenRequest(uint64_t request, bool accepted)
+{
+    if (request != m_fullScreenRequest || !m_fullScreenCompletion)
+        return;
+    if (accepted)
+        m_fullScreen = m_fullScreenRequested;
+    auto completion = std::exchange(m_fullScreenCompletion, { });
+    if (!accepted)
+        closeFullScreenManager();
+    completion(accepted);
+}
+
+void WebView::enterFullScreen(WebCore::FloatSize, CompletionHandler<void(bool)>&& completion)
+{
+    requestFullScreen(true, WTF::move(completion));
+}
+
+void WebView::exitFullScreen(CompletionHandler<void()>&& completion)
+{
+    requestFullScreen(false, [completion = WTF::move(completion)](bool) mutable { completion(); });
+}
+
+void WebView::closeFullScreenManager()
+{
+    bool restore = m_fullScreen || m_fullScreenCompletion || m_fullScreenRequested;
+    m_fullScreen = false;
+    m_fullScreenRequested = false;
+    ++m_fullScreenRequest;
+    if (restore) {
+        BMessage message(B_WEBKIT_FULLSCREEN_REQUESTED);
+        message.AddMessenger("view", nativeView());
+        message.AddBool("fullscreen", false);
+        message.AddUInt64("request", 0);
+        m_state->target.SendMessage(&message, static_cast<BHandler*>(nullptr), 0);
+    }
+    if (auto completion = std::exchange(m_fullScreenCompletion, { }))
+        completion(false);
+}
+#endif
+
+} // namespace WebKit
