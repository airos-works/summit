+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "config.h"
+#include "WebExtensionAPISidebarActionHaiku.h"
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+
+#include "MessageSenderInlines.h"
+#include "WebExtensionContextMessages.h"
+#include "WebExtensionContextProxy.h"
+#include "WebExtensionUtilities.h"
+#include "WebProcess.h"
+
+namespace WebKit {
+
+// details: tabId, windowId (Firefox), and the method's own member. The
+// answer is JSON: null, a boolean or a string.
+void WebExtensionAPISidebarActionHaiku::send(const String& method, RefPtr<JSON::Value> details, bool detailsRequired, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    RefPtr object = details ? details->asObject() : nullptr;
+    if ((details && details->type() != JSON::Value::Type::Null && !object) || (detailsRequired && !object)) {
+        exception = toErrorString(nullString(), "details"_s, "an object is expected"_s);
+        return;
+    }
+    Ref arguments = object ? object.releaseNonNull() : JSON::Object::create();
+    for (auto key : { "tabId"_s, "windowId"_s }) {
+        if (RefPtr value = arguments->getValue(key); value && value->type() != JSON::Value::Type::Null && !value->asDouble()) {
+            exception = toErrorString(nullString(), key, "a number is expected"_s);
+            return;
+        }
+    }
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::SidebarActionHaiku(method, arguments->toJSONString()),
+        [protectedThis = Ref { *this }, callback = WTF::move(callback)](std::expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error());
+                return;
+            }
+            if (result->isEmpty() || *result == "null"_s) {
+                callback->call();
+                return;
+            }
+            auto context = callback->globalContext();
+            Protected<JSValueRef> value(context, fromJSON(context, JSON::Value::parseJSON(*result)));
+            callback->call(value.get());
+        }, extensionContext().identifier());
+}
+
+void WebExtensionAPISidebarActionHaiku::open(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    String ignored;
+    send("open"_s, nullptr, false, WTF::move(callback), ignored);
+}
+
+void WebExtensionAPISidebarActionHaiku::close(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    String ignored;
+    send("close"_s, nullptr, false, WTF::move(callback), ignored);
+}
+
+void WebExtensionAPISidebarActionHaiku::toggle(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    String ignored;
+    send("toggle"_s, nullptr, false, WTF::move(callback), ignored);
+}
+
+void WebExtensionAPISidebarActionHaiku::isOpen(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("isOpen"_s, details, false, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISidebarActionHaiku::setPanel(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("setPanel"_s, details, true, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISidebarActionHaiku::getPanel(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("getPanel"_s, details, false, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISidebarActionHaiku::setTitle(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("setTitle"_s, details, true, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISidebarActionHaiku::getTitle(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    send("getTitle"_s, details, false, WTF::move(callback), exception);
+}
+
+void WebExtensionAPISidebarActionHaiku::setIcon(RefPtr<JSON::Value> details, Ref<WebExtensionCallbackHandler>&& callback, String& exception)
+{
+    // The sidebar shows no icon; the call is accepted, as a no-op.
+    RefPtr object = details ? details->asObject() : nullptr;
+    if (!object) {
+        exception = toErrorString(nullString(), "details"_s, "an object is expected"_s);
+        return;
+    }
+    callback->call();
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
