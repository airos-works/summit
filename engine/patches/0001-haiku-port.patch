+void BWebKitView::SetUserStyleSheet(const char* source)
+{
+    if (m_status != B_OK)
+        return;
+    WTF::RunLoop::mainSingleton().dispatch([state = m_state, source = copyTextHaiku(source ? source : "")] {
+        auto* page = pageHaiku(state);
