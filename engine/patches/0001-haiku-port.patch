+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <array>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace WebCore::BluetoothHaiku {
+struct UUID {
+    std::array<uint8_t, 16> bytes {};
+    auto operator<=>(const UUID&) const = default;
+    static UUID alias(uint32_t);
+    static std::optional<UUID> parse(std::string_view);
+    static std::optional<UUID> fromWire(std::span<const uint8_t>);
+    std::string string() const;
+};
+enum class UUIDKind { Service, Characteristic, Descriptor };
+std::optional<UUID> namedUUID(UUIDKind, std::string_view);
+enum class Access { Discover, Read, Write };
+bool blocked(const UUID&, Access = Access::Discover);
+struct Advertisement {
+    std::string name;
+    bool completeName { false };
+    bool connectable { false };
+    int8_t rssi { -127 };
+    std::set<UUID> services;
+    std::map<uint16_t, std::vector<uint8_t>> manufacturerData;
+    std::map<UUID, std::vector<uint8_t>> serviceData;
+    bool append(std::span<const uint8_t>);
+};
+struct DataFilter {
+    std::vector<uint8_t> prefix, mask;
+    bool valid() const;
+    bool matches(std::span<const uint8_t>) const;
+};
+struct Filter {
+    std::optional<std::string> name, namePrefix;
+    std::vector<UUID> services;
+    std::map<uint16_t, DataFilter> manufacturerData;
+    std::map<UUID, DataFilter> serviceData;
+    bool valid() const;
+    bool matches(const Advertisement&) const;
+};
+bool matches(const Advertisement&, const std::vector<Filter>&, const std::vector<Filter>&);
+struct Service { uint16_t start {0}, end {0}; UUID uuid; bool primary {true}; };
+struct Characteristic { uint16_t declaration {0}, value {0}, end {0}; uint8_t properties {0}; UUID uuid; };
+struct Descriptor { uint16_t handle {0}; UUID uuid; };
+}
