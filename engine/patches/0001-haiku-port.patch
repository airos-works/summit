+#if ENABLE(CANVAS_HIT_REGIONS)
+ExceptionOr<void> CanvasRenderingContext2D::addHitRegion(const CanvasHitRegionOptions& options)
+{
+    if (options.id.isEmpty() && !options.control)
+        return Exception { ExceptionCode::NotSupportedError };
+    auto path = clippedHitRegionPath(options.path ? options.path->path() : m_path, options.fillRule);
+    if (!path || path->isEmpty() || path->boundingRect().isEmpty())
+        return Exception { ExceptionCode::NotSupportedError };
+    // Validate first, so a failed replacement leaves the previous region intact.
+    m_hitRegions.removeAllMatching([&](auto& region) {
+        bool matches = (!options.id.isEmpty() && region.id == options.id) || (options.control && region.control.get() == options.control.get());
+        if (matches)
+            updateHitRegionControlBounds(region, true);
+        return matches;
+    });
+    didClearHitRegionPixels(*path);
+    m_hitRegions.append({ options.id, options.control, WTF::move(*path) });
+    updateHitRegionControlBounds(m_hitRegions.last());
+    return { };
+}
+
+void CanvasRenderingContext2D::removeHitRegion(const String& id)
+{
+    if (id.isEmpty())
+        return;
+    m_hitRegions.removeAllMatching([&](auto& region) {
+        if (region.id != id)
+            return false;
+        updateHitRegionControlBounds(region, true);
+        return true;
+    });
+}
+
+void CanvasRenderingContext2D::clearHitRegions()
+{
+    for (auto& region : m_hitRegions)
+        updateHitRegionControlBounds(region, true);
+    m_hitRegions.clear();
+}
+
+void CanvasRenderingContext2D::didClearHitRegionPixels(const Path& cleared)
+{
+    if (cleared.isEmpty())
+        return;
+    auto bounds = cleared.fastBoundingRect();
+    m_hitRegions.removeAllMatching([&](auto& region) {
+        if (!region.path.fastBoundingRect().intersects(bounds))
+            return false;
+        auto remainder = Op(*region.path.platformPath(), *cleared.platformPath(), kDifference_SkPathOp);
+        // A pathological path-operation failure must never leave false hits.
+        region.path = remainder ? Path { PathSkia::create(WTF::move(*remainder)) } : Path { };
+        bool removed = region.path.isEmpty() || region.path.boundingRect().isEmpty();
+        updateHitRegionControlBounds(region, removed);
+        return removed;
+    });
+}
+
+String CanvasRenderingContext2D::hitRegionAtPoint(const FloatPoint& point) const
+{
+    if (!std::isfinite(point.x()) || !std::isfinite(point.y()))
+        return { };
+    // Skia includes path boundaries, so coincident edges belong to the newest
+    // region even after its area has been subtracted from older regions.
+    for (size_t index = m_hitRegions.size(); index; --index) {
+        auto& region = m_hitRegions[index - 1];
+        // PathOps retains the resulting winding rule on its native path.
+        if (region.path.platformPath()->contains(point.x(), point.y()))
+            return region.id.isEmpty() ? String { } : region.id;
+    }
+    return { };
+}
+
+void CanvasRenderingContext2D::updateHitRegionControlBounds(const HitRegion& region, bool removed)
+{
+    Ref canvas = this->canvas();
+    RefPtr control = region.control.get();
+    if (!control || !control->isDescendantOf(canvas.get()))
+        return;
+    CheckedPtr cache = canvas->document().existingAXObjectCache();
+    CheckedPtr renderer = dynamicDowncast<RenderReplaced>(canvas->renderer());
+    if (!cache || !renderer || !canvas->width() || !canvas->height())
+        return;
+    FloatRect bounds;
+    if (!removed) {
+        auto pixels = region.path.boundingRect();
+        FloatRect content { renderer->replacedContentRect() };
+        bounds = { content.x() + pixels.x() * content.width() / canvas->width(),
+            content.y() + pixels.y() * content.height() / canvas->height(),
+            pixels.width() * content.width() / canvas->width(), pixels.height() * content.height() / canvas->height() };
+    }
+    cache->deferCanvasFocusPathBoundsUpdate(*control, canvas.get(), bounds);
+}
