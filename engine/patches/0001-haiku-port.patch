new file mode 100644
index 0000000000000000000000000000000000000000..c636fc375a83e9c5214a69608f19dfe8338dd6ad
--- /dev/null
+++ b/Source/WebKit/WebProcess/haiku/WebProcessDiagnosticsHaiku.cpp
@@ -0,0 +1,219 @@
+/* Copyright (C) 2026 KunanyiOS contributors. SPDX-License-Identifier: BSD-2-Clause */
+
+// What a web process tells the browser's debugging tools about itself
+// (ProcessDiagnosticsHaiku.h): its pages, memory, media players and
+// compositors.
+
+#include "config.h"
+#include "WebProcessDiagnosticsHaiku.h"
+
+#include "ProcessDiagnosticsHaiku.h"
+#include "WebPage.h"
+#include <JavaScriptCore/JSLock.h>
+#include <JavaScriptCore/MemoryStatistics.h>
+#include <JavaScriptCore/VM.h>
+#include <WebCore/BackForwardCache.h>
+#include <WebCore/CommonVM.h>
+#include <WebCore/Document.h>
+#include <WebCore/FontCache.h>
+#include <WebCore/GarbageCollectionController.h>
+#include <WebCore/HTMLMediaElement.h>
+#include <WebCore/LocalFrameView.h>
+#include <WebCore/MediaPlayer.h>
+#include <WebCore/MemoryCache.h>
+#include <WebCore/MemoryRelease.h>
+#include <WebCore/NodeDocument.h>
+#include <WebCore/Page.h>
+#include <WebCore/TimeRanges.h>
+#include <wtf/MemoryPressureHandler.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+
+double megabytes(double bytes)
+{
+    return std::round(bytes / 10485.76) / 100;
+}
+
+Ref<JSON::Object> cacheStatistic(const MemoryCache::TypeStatistic& statistic)
+{
+    auto object = JSON::Object::create();
+    object->setInteger("count"_s, statistic.count);
+    object->setDouble("sizeMiB"_s, megabytes(statistic.size));
+    object->setDouble("liveMiB"_s, megabytes(statistic.liveSize));
+    object->setDouble("decodedMiB"_s, megabytes(statistic.decodedSize));
+    return object;
+}
+
+Ref<JSON::Object> pagesReport()
+{
+    auto report = JSON::Object::create();
+    auto pages = JSON::Array::create();
+    Page::forEachPage([&](Page& page) {
+        auto entry = JSON::Object::create();
+        if (auto* webPage = WebPage::fromCorePage(page)) {
+            entry->setDouble("pageIdentifier"_s, webPage->identifier().toUInt64());
+            entry->setDouble("webPageProxyIdentifier"_s, webPage->webPageProxyIdentifier().toUInt64());
+        }
+        entry->setString("url"_s, page.mainFrameURL().string());
+        entry->setBoolean("visible"_s, page.isVisible());
+        entry->setBoolean("inWindow"_s, page.isInWindow());
+        entry->setInteger("renderingUpdates"_s, page.renderingUpdateCount());
+        unsigned frames = 0;
+        for (RefPtr<Frame> frame = &page.mainFrame(); frame; frame = frame->tree().traverseNext())
+            ++frames;
+        entry->setInteger("frames"_s, frames);
+        pages->pushObject(WTF::move(entry));
+    });
+    report->setArray("pages"_s, WTF::move(pages));
+    report->setInteger("documents"_s, Document::allDocumentsMap().size());
+    return report;
+}
+
+Ref<JSON::Object> memoryReport()
+{
+    auto report = JSON::Object::create();
+    {
+        auto& vm = commonVM();
+        JSC::JSLockHolder lock(vm);
+        auto heap = JSON::Object::create();
+        heap->setDouble("sizeMiB"_s, megabytes(vm.heap.size()));
+        heap->setDouble("capacityMiB"_s, megabytes(vm.heap.capacity()));
+        heap->setDouble("extraMemoryMiB"_s, megabytes(vm.heap.extraMemorySize()));
+        heap->setDouble("objects"_s, vm.heap.objectCount());
+        heap->setDouble("protectedObjects"_s, vm.heap.protectedObjectCount());
+        heap->setDouble("globalObjects"_s, vm.heap.globalObjectCount());
+        heap->setDouble("sizeAfterLastFullCollectionMiB"_s, megabytes(vm.heap.sizeAfterLastFullCollection()));
+        report->setObject("javaScriptHeap"_s, WTF::move(heap));
+    }
+    auto statistics = JSC::globalMemoryStatistics();
+    report->setDouble("jitMiB"_s, megabytes(statistics.JITBytes));
+    report->setDouble("javaScriptStacksMiB"_s, megabytes(statistics.stackBytes));
+    auto cache = MemoryCache::singleton().getStatistics();
+    auto memoryCache = JSON::Object::create();
+    memoryCache->setObject("images"_s, cacheStatistic(cache.images));
+    memoryCache->setObject("styleSheets"_s, cacheStatistic(cache.cssStyleSheets));
+    memoryCache->setObject("scripts"_s, cacheStatistic(cache.scripts));
+    memoryCache->setObject("fonts"_s, cacheStatistic(cache.fonts));
+    report->setObject("memoryCache"_s, WTF::move(memoryCache));
+    report->setInteger("backForwardCachePages"_s, BackForwardCache::singleton().pageCount());
+    auto& fonts = FontCache::forCurrentThread();
+    report->setInteger("fonts"_s, static_cast<int>(fonts.fontCount()));
+    report->setInteger("inactiveFonts"_s, static_cast<int>(fonts.inactiveFontCount()));
+    report->setInteger("documents"_s, Document::allDocumentsMap().size());
+    auto& pressure = MemoryPressureHandler::singleton();
+    report->setString("memoryPressure"_s, pressure.isUnderMemoryPressure() ? "critical"_s : pressure.isUnderMemoryWarning() ? "warning"_s : "normal"_s);
+    return report;
+}
+
+Ref<JSON::Object> mediaReport()
+{
+    auto report = JSON::Object::create();
+    auto elements = JSON::Array::create();
+    for (auto& weakElement : HTMLMediaElement::allMediaElements()) {
+        Ref element = weakElement.get();
+        auto entry = JSON::Object::create();
+        entry->setString("kind"_s, element->isVideo() ? "video"_s : "audio"_s);
+        entry->setString("document"_s, element->document().url().string());
+        entry->setString("src"_s, element->currentSrc().string().left(300));
+        entry->setInteger("readyState"_s, static_cast<int>(element->readyState()));
+        entry->setInteger("networkState"_s, static_cast<int>(element->networkState()));
+        entry->setBoolean("paused"_s, element->paused());
+        entry->setDouble("currentTime"_s, element->currentTime());
+        double duration = element->duration();
+        if (std::isfinite(duration))
+            entry->setDouble("duration"_s, duration);
+        entry->setBoolean("muted"_s, element->muted());
+        entry->setDouble("volume"_s, element->volume());
+        Ref buffered = element->buffered();
+        if (buffered->length())
+            entry->setDouble("bufferedEnd"_s, buffered->ranges().maximumBufferedTime().toDouble());
+        entry->setBoolean("connected"_s, element->isConnected());
+        if (RefPtr player = element->player()) {
+            auto description = player->engineDescription();
+            auto parsed = JSON::Value::parseJSON(description);
+            if (parsed && parsed->asObject())
+                entry->setObject("player"_s, parsed->asObject().releaseNonNull());
+            else
+                entry->setString("player"_s, description);
+            auto size = player->naturalSize();
+            entry->setInteger("naturalWidth"_s, static_cast<int>(size.width()));
+            entry->setInteger("naturalHeight"_s, static_cast<int>(size.height()));
+            if (auto metrics = player->videoPlaybackQualityMetrics()) {
+                auto quality = JSON::Object::create();
+                quality->setInteger("totalVideoFrames"_s, metrics->totalVideoFrames);
+                quality->setInteger("droppedVideoFrames"_s, metrics->droppedVideoFrames);
+                quality->setInteger("corruptedVideoFrames"_s, metrics->corruptedVideoFrames);
+                quality->setInteger("displayCompositedVideoFrames"_s, metrics->displayCompositedVideoFrames);
+                entry->setObject("quality"_s, WTF::move(quality));
+            }
+        } else
+            entry->setString("player"_s, "none"_s);
+        elements->pushObject(WTF::move(entry));
+    }
+    report->setArray("elements"_s, WTF::move(elements));
+    return report;
+}
+
+Ref<JSON::Object> graphicsReport()
+{
+    auto report = ProcessDiagnosticsHaiku::compositorReport();
+    auto pages = JSON::Array::create();
+    Page::forEachPage([&](Page& page) {
+        auto entry = JSON::Object::create();
+        if (auto* webPage = WebPage::fromCorePage(page))
+            entry->setDouble("pageIdentifier"_s, webPage->identifier().toUInt64());
+        entry->setString("url"_s, page.mainFrameURL().string());
+        if (RefPtr view = page.mainFrame().virtualView()) {
+            entry->setInteger("contentsWidth"_s, view->contentsWidth());
+            entry->setInteger("contentsHeight"_s, view->contentsHeight());
+        }
+        entry->setDouble("deviceScaleFactor"_s, page.deviceScaleFactor());
+        entry->setDouble("pageScaleFactor"_s, page.pageScaleFactor());
+        entry->setInteger("renderingUpdates"_s, page.renderingUpdateCount());
+        pages->pushObject(WTF::move(entry));
+    });
+    report->setArray("pages"_s, WTF::move(pages));
+    return report;
+}
+
+} // namespace
+
+void startWebProcessDiagnosticsHaiku()
+{
+    ProcessDiagnosticsHaiku::addTopic("pages", true, pagesReport);
+    ProcessDiagnosticsHaiku::addTopic("memory", true, memoryReport);
+    ProcessDiagnosticsHaiku::addTopic("media", true, mediaReport);
+    ProcessDiagnosticsHaiku::addTopic("graphics", true, graphicsReport);
+    ProcessDiagnosticsHaiku::addTopic("compositor", false, [] { return ProcessDiagnosticsHaiku::compositorReport(); });
+    ProcessDiagnosticsHaiku::addAction("gc", [] {
+        auto report = JSON::Object::create();
+        auto& vm = commonVM();
+        double before;
+        {
+            JSC::JSLockHolder lock(vm);
+            before = vm.heap.size();
+        }
+        auto started = MonotonicTime::now();
+        GarbageCollectionController::singleton().garbageCollectNow();
+        report->setDouble("gcMs"_s, (MonotonicTime::now() - started).milliseconds());
+        JSC::JSLockHolder lock(vm);
+        report->setDouble("heapBeforeMiB"_s, megabytes(before));
+        report->setDouble("heapAfterMiB"_s, megabytes(vm.heap.size()));
+        return report;
+    });
+    ProcessDiagnosticsHaiku::addAction("release-memory", [] {
+        auto report = JSON::Object::create();
+        auto started = MonotonicTime::now();
+        WebCore::releaseMemory(Critical::Yes, Synchronous::Yes);
+        report->setDouble("releaseMs"_s, (MonotonicTime::now() - started).milliseconds());
+        report->setObject("after"_s, memoryReport());
+        return report;
+    });
+    ProcessDiagnosticsHaiku::start("web");
+}
+
+} // namespace WebKit
