+void WebExtensionContext::searchQueryHaiku(const String& method, const String& argumentsJSON, std::optional<WebExtensionTabIdentifier> tabIdentifier, CompletionHandler<void(std::expected<String, WebExtensionError>&&)>&& completion)
+{
+    auto apiName = makeString("search."_s, method, "()"_s);
+    static constexpr std::array methods { "query"_s, "search"_s, "get"_s };
+    auto message = nativeNamespaceQueryHaiku(*this, B_WEBKIT_BROWSER_SEARCH, "search"_s, methods, method, argumentsJSON, apiName, completion);
+    if (!message)
+        return;
+    if (tabIdentifier) {
+        RefPtr tab = getTab(*tabIdentifier);
+        if (!tab || !tab->isOpen() || !tab->extensionHasAccess()) {
+            completion(toWebExtensionError(apiName, "tabId"_s, "tab not found"_s));
+            return;
+        }
+        if (!addNativeBrowserCommandTab(*message, *tab)) {
+            completion(toWebExtensionError(apiName, "tabId"_s, "the tab is not available in the browser"_s));
+            return;
+        }
+    }
+    sendNativeBrowserQueryHaiku(WTF::move(*message), apiName, WTF::move(completion));
+}
