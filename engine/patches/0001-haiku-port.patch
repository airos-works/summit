index 0000000000000000000000000000000000000000..e6a859137fd50649d794d42518d8433fba5254e3
--- /dev/null
+++ b/Source/WebCore/platform/bluetooth/haiku/BluetoothGATTHaiku.h
@@ -0,0 +1,47 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include "BluetoothATTClientHaiku.h"
+
+namespace WebCore::BluetoothHaiku {
+enum class GATTError { None, Security, NotFound, InvalidState, NotSupported, ATT };
+struct GATTResult {
+    GATTError error { GATTError::None };
+    ATTResult att;
+    explicit operator bool() const { return error == GATTError::None; }
+};
+struct GATTCharacteristic { Characteristic attribute; uint16_t service; uint16_t extendedProperties { 0 }; };
+struct GATTDescriptor { Descriptor attribute; uint16_t characteristic; };
+
+// Browser-process capability boundary, also usable with a scripted ATT peer.
+// Untrusted requests never supply native ranges or UUIDs for raw operations:
+// handles must have been discovered beneath a granted, exported service.
+class GATTConnection {
+public:
+    GATTConnection(ATTClient& client, std::set<UUID> grants) : m_client(client), m_grants(std::move(grants)) { }
+    GATTResult initialize();
+    GATTResult services(std::optional<UUID>, std::vector<Service>&);
+    GATTResult includedServices(uint16_t service, std::optional<UUID>, std::vector<Service>&);
+    GATTResult characteristics(uint16_t service, std::optional<UUID>, std::vector<GATTCharacteristic>&);
+    GATTResult descriptors(uint16_t characteristic, std::optional<UUID>, std::vector<GATTDescriptor>&);
+    GATTResult read(uint16_t handle, bool descriptor, std::vector<uint8_t>&);
+    GATTResult write(uint16_t handle, bool descriptor, std::span<const uint8_t>, bool response);
+    GATTResult notifications(uint16_t characteristic, bool enable);
+    GATTResult poll(std::vector<Notification>&);
+    void invalidate();
+    void addGrants(const std::set<UUID>&);
+private:
+    GATTResult checkServiceQuery(const std::optional<UUID>&) const;
+    GATTResult rememberDescriptors(uint16_t characteristic);
+    GATTResult checked(ATTResult);
+    bool allowed(const UUID& uuid) const { return m_grants.contains(uuid) && !blocked(uuid); }
+    ATTClient& m_client;
+    std::set<UUID> m_grants;
+    std::vector<Service> m_catalog;
+    std::map<uint16_t, Service> m_services;
+    std::map<uint16_t, GATTCharacteristic> m_characteristics;
+    std::map<uint16_t, GATTDescriptor> m_descriptors;
+    std::set<uint16_t> m_discoveredCharacteristics, m_discoveredDescriptors, m_subscribed;
+    uint16_t m_serviceChanged { 0 };
+    bool m_valid { false };
+};
+}
