diff --git a/Source/WebKit/Shared/Extensions/WebExtensionCookiePartitionKey.h b/Source/WebKit/Shared/Extensions/WebExtensionCookiePartitionKey.h
new file mode 100644
index 0000000000000000000000000000000000000000..d4b1b1012cf671056a10cd3eefa2b317d5e4d5ac
--- /dev/null
+++ b/Source/WebKit/Shared/Extensions/WebExtensionCookiePartitionKey.h
@@ -0,0 +1,51 @@
+/* Copyright (C) 2026 Summit contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#if ENABLE(WK_WEB_EXTENSIONS) && PLATFORM(HAIKU)
+#include <WebCore/Site.h>
+#include <expected>
+#include <wtf/JSONValues.h>
+
+namespace WebKit {
+
+// nullopt is a wildcard for getAll only; an empty string is the unpartitioned
+// jar. Nonempty keys are canonical schemeful sites, without paths or ports.
+inline bool isValidWebExtensionCookiePartitionKey(const String& key)
+{
+    if (key.isEmpty())
+        return true;
+    URL url { key };
+    return url.isValid() && url.protocolIsInHTTPFamily() && !url.host().isEmpty()
+        && WebCore::Site { url }.toString() == key;
+}
+
+inline std::expected<std::optional<String>, String> parseWebExtensionCookiePartitionKey(const JSON::Value& value, bool allowWildcard)
+{
+    RefPtr object = value.asObject();
+    if (!object)
+        return std::unexpected("partitionKey must be an object"_s);
+    for (auto& key : object->keys()) {
+        // This backend keys CHIPS by top-level site. Do not silently accept an
+        // ancestor-bit filter that it cannot distinguish.
+        if (key != "topLevelSite"_s)
+            return std::unexpected("unsupported cookie partitionKey field"_s);
+    }
+    RefPtr site = object->getValue("topLevelSite"_s);
+    if (!site) {
+        if (allowWildcard)
+            return std::optional<String> { };
+        return std::unexpected("partitionKey requires topLevelSite"_s);
+    }
+    if (site->type() != JSON::Value::Type::String)
+        return std::unexpected("partitionKey topLevelSite must be a string"_s);
+    auto text = site->asString();
+    if (text.isEmpty())
+        return std::optional<String> { emptyString() };
+    URL url { text };
+    if (text.contains('\0') || !url.isValid() || !url.protocolIsInHTTPFamily() || url.host().isEmpty())
+        return std::unexpected("partitionKey topLevelSite must be an HTTP or HTTPS site"_s);
+    return std::optional<String> { WebCore::Site { url }.toString() };
+}
+
+} // namespace WebKit
+#endif
diff --git a/Source/WebKit/Shared/Extensions/WebExtensionCookieQueryParser.cpp b/Source/WebKit/Shared/Extensions/WebExtensionCookieQueryParser.cpp
