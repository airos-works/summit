<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: WebDriver for automated tests (Interop, WPT), as on air/OS.
     Release builds have neither the activity nor the WebDriver process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="works.airos.summit.automation.AutomationActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <service
            android:name="org.wpewebkit.wpe.services.WebDriverProcessService"
            android:process=":WPEWebDriverProcess" />
    </application>
</manifest>
