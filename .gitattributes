# Unified diffs require a space marker on empty and tab-indented context lines.
engine/patches/*.patch whitespace=-blank-at-eol,-space-before-tab
# Keep pinned CLD2 sources byte-for-byte, including generated padding/CRLF.
vendor/cld2/internal/* whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
vendor/cld2/public/* whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
vendor/cld2/*.patch whitespace=-blank-at-eol,-space-before-tab
# Preserve the pinned worker and upstream notices, including padding/CRLF.
resources/translation/bergamot/* whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/translation-runtime-notices.txt whitespace=-blank-at-eol,cr-at-eol
