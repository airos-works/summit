{
  "manifest_version": 2,
  "name": "Summit DNR matched rules fixture",
  "version": "1.0",
  "description": "declarativeNetRequest.getMatchedRules: which rules matched a tab's loads (#106).",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "matches",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
