{
  "manifest_version": 2,
  "name": "Summit ext106 fixture (cloneInto, exportFunction, onRuleMatchedDebug)",
  "version": "1.0",
  "description": "Firefox content-script helpers and declarativeNetRequest.onRuleMatchedDebug (#106).",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "<all_urls>"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [
    { "matches": ["http://192.168.1.200/ext106/*"], "js": ["content.js"], "run_at": "document_end" }
