{
 "manifest_version": 2,
 "name": "Summit side panel fixture",
 "version": "1.0",
 "browser_specific_settings": {
  "gecko": {
   "id": "side-panel@summit.test"
  }
 },
 "permissions": [
  "sidePanel",
  "tabs"
 ],
 "side_panel": {
  "default_path": "panel.html"
 },
 "browser_action": {
  "default_title": "Side panel fixture"
 },
 "background": {
  "scripts": [
   "bg.js"
  ],
  "persistent": true
 },
 "commands": {
  "_execute_browser_action": {
   "suggested_key": {
    "default": "Ctrl+Shift+Y"
   }
  }
 }
}