#!/bin/bash
# The "WebDriver binary" wptrunner starts: runs summitdriver on the test
# machine over SSH and forwards 127.0.0.1:PORT here to it.
#
# Each start kills what an earlier run left (driver, test Summit, its engine
# processes) and gives the test profile a fresh copy of the seed profile.
#
# SUMMIT_SSH         ssh command reaching the test machine
#                    (default: ssh -F /mnt/HaikuWork/x399/ssh/config ws-haiku)
# SUMMIT_REMOTE_DIR  folder there (default /boot/home/interop): profile.json.seed
#                    is the seed profile
# SUMMIT_REMOTE_BUILD  the folder in it with the Summit to test (default xh: the
#                    extracted packages)
# SUMMIT_REMOTE_ENV  extra NAME=VALUE settings for that Summit (e.g.
#                    SUMMIT_WEBTRANSPORT_TRACE=1; its stderr is in the wpt log)
# SUMMIT_TEST_ENV    settings every run gets (default SUMMIT_OVERLAY_SCROLLBARS=0:
#                    classic scroll bars, as GTK's and Safari's wpt runs have;
#                    overlay ones fade, and references captured right after a
#                    scroll show them while the test's later picture does not)
port=4444
for a in "$@"; do case $a in --port=*) port=${a#--port=};; esac; done
case $port in
  ''|*[!0-9]*)
    echo 'WebDriver needs a numeric port' >&2
    exit 2
    ;;
esac
if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo 'WebDriver port must be between 1 and 65535' >&2
  exit 2
fi
SSH=${SUMMIT_SSH:-ssh -F /mnt/HaikuWork/x399/ssh/config ws-haiku}
SSH="$SSH -o ConnectTimeout=10 -o ServerAliveInterval=15"
DIR=${SUMMIT_REMOTE_DIR:-/boot/home/interop}
X=$DIR/${SUMMIT_REMOTE_BUILD:-xh}
printf -v quotedBuild %q "$X"
# Haiku's ps truncates the command line. Match the executable image so long
# staging paths work and another installation of Summit can keep running.
$SSH "bash -s -- $quotedBuild $(printf '%q' "$DIR")" <<'REMOTE' || exit 1
build=$(cd -- "$1" && pwd -P) || exit 1
dir=$2
for binary in "$build/apps/Summit" "$build"/lib/summit-webkit/{WebKitWebDriver,WebProcess,NetworkProcess}; do
  for team in $(pidof "${binary##*/}"); do
    image=$(listimage "$team" | awk '$2 ~ /^0x/ { print substr($0, index($0, "/")); exit }')
    if [ "$image" = "$binary" ]; then
      kill "$team" 2>/dev/null
    fi
  done
done
rm -rf "$dir/profile" && mkdir -p "$dir/profile" && cp "$dir/profile.json.seed" "$dir/profile/profile.json"
REMOTE
exec $SSH -o ExitOnForwardFailure=yes -L 127.0.0.1:$port:127.0.0.1:$port \
  "cd $quotedBuild && exec env WEBKIT_EXEC_PATH=$quotedBuild/lib/summit-webkit SUMMIT_WEBDRIVER_BROWSER=$quotedBuild/apps/Summit ${SUMMIT_TEST_ENV-SUMMIT_OVERLAY_SCROLLBARS=0} ${SUMMIT_REMOTE_ENV:-} $quotedBuild/lib/summit-webkit/WebKitWebDriver --port=$port --host=127.0.0.1" </dev/null
